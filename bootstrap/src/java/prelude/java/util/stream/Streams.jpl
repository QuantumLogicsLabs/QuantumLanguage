    public LongStream peek(LongConsumer action) { return new LongStreamImpl(new StreamSupport.Peek<Long>(take(), x -> action.accept(x))); }
    public LongStream limit(long maxSize) { return new LongStreamImpl(new StreamSupport.Limit<Long>(take(), maxSize)); }
    public LongStream skip(long n) { return new LongStreamImpl(new StreamSupport.Skip<Long>(take(), n)); }

    public void forEach(LongConsumer action) {
