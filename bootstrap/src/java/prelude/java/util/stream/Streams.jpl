        while (it.hasNext())
            if (!predicate.test(it.next()))
                return false;
        return true;
    }

    public boolean noneMatch(LongPredicate predicate) { return !anyMatch(predicate); }

    public OptionalLong findFirst() {
        Iterator<Long> it = take();
        return it.hasNext() ? OptionalLong.of(it.next()) : OptionalLong.empty();
    }

    public DoubleStream asDoubleStream() { return new DoubleStreamImpl(new StreamSupport.Map<Long, Double>(take(), x -> (double) (long) x)); }
    public Stream<Long> boxed() { return new RefStream<Long>(take()); }
}

final class DoubleStreamImpl extends AbstractPipeline<Double> implements DoubleStream {
    DoubleStreamImpl(Iterator<Double> source) { super(source); }

    public Iterator<Double> iterator() { return take(); }
    public DoubleStream sequential() { return this; }
    public DoubleStream parallel() { return this; }
    public DoubleStream unordered() { return this; }
    public DoubleStream onClose(Runnable closeHandler) { return this; }

    public DoubleStream filter(DoublePredicate predicate) { return new DoubleStreamImpl(new StreamSupport.Filter<Double>(take(), x -> predicate.test(x))); }
    public DoubleStream map(DoubleUnaryOperator mapper) { return new DoubleStreamImpl(new StreamSupport.Map<Double, Double>(take(), x -> mapper.applyAsDouble(x))); }
    public <U> Stream<U> mapToObj(DoubleFunction<? extends U> mapper) { return new RefStream<U>(new StreamSupport.Map<Double, U>(take(), x -> mapper.apply(x))); }
    public IntStream mapToInt(DoubleToIntFunction mapper) { return new IntStreamImpl(new StreamSupport.Map<Double, Integer>(take(), x -> mapper.applyAsInt(x))); }
    public LongStream mapToLong(DoubleToLongFunction mapper) { return new LongStreamImpl(new StreamSupport.Map<Double, Long>(take(), x -> mapper.applyAsLong(x))); }
    public DoubleStream distinct() { return new DoubleStreamImpl(new StreamSupport.Distinct<Double>(take())); }

    public DoubleStream sorted() {
        ArrayList<Double> all = StreamSupport.drain(take());
        double[] a = new double[all.size()];
        for (int k = 0; k < a.length; k++)
            a[k] = all.get(k);
        Arrays.sort(a);
        return DoubleStream.of(a);
    }

    public DoubleStream peek(DoubleConsumer action) { return new DoubleStreamImpl(new StreamSupport.Peek<Double>(take(), x -> action.accept(x))); }
    public DoubleStream limit(long maxSize) { return new DoubleStreamImpl(new StreamSupport.Limit<Double>(take(), maxSize)); }
    public DoubleStream skip(long n) { return new DoubleStreamImpl(new StreamSupport.Skip<Double>(take(), n)); }

    public void forEach(DoubleConsumer action) {
        Iterator<Double> it = take();
        while (it.hasNext())
            action.accept(it.next());
    }

    public double[] toArray() {
        ArrayList<Double> all = StreamSupport.drain(take());
        double[] a = new double[all.size()];
        for (int i = 0; i < a.length; i++)
            a[i] = all.get(i);
        return a;
    }

    public double reduce(double identity, DoubleBinaryOperator op) {
        double result = identity;
        Iterator<Double> it = take();
        while (it.hasNext())
            result = op.applyAsDouble(result, it.next());
        return result;
    }

    public OptionalDouble reduce(DoubleBinaryOperator op) {
        Iterator<Double> it = take();
        if (!it.hasNext())
            return OptionalDouble.empty();
        double result = it.next();
        while (it.hasNext())
            result = op.applyAsDouble(result, it.next());
        return OptionalDouble.of(result);
    }

    public double sum() {
        double[] summation = new double[3];
        Iterator<Double> it = take();
        while (it.hasNext()) {
            double d = it.next();
            StreamSupport.sumWithCompensation(summation, d);
            summation[2] += d;
        }
        return StreamSupport.computeFinalSum(summation);
    }

    public OptionalDouble min() { return reduce((a, b) -> Math.min(a, b)); }
    public OptionalDouble max() { return reduce((a, b) -> Math.max(a, b)); }

    public long count() {
        long n = 0;
        Iterator<Double> it = take();
        while (it.hasNext()) {
            it.next();
            n++;
        }
        return n;
    }

    public OptionalDouble average() {
        double[] avg = new double[4];
        Iterator<Double> it = take();
        while (it.hasNext()) {
            double d = it.next();
            avg[2]++;
            StreamSupport.sumWithCompensation(avg, d);
            avg[3] += d;
        }
        return avg[2] > 0 ? OptionalDouble.of(StreamSupport.computeFinalSum(avg) / avg[2]) : OptionalDouble.empty();
    }

    public DoubleSummaryStatistics summaryStatistics() {
        DoubleSummaryStatistics s = new DoubleSummaryStatistics();
        forEach(s);
        return s;
    }

    public boolean anyMatch(DoublePredicate predicate) {
        Iterator<Double> it = take();
        while (it.hasNext())
            if (predicate.test(it.next()))
                return true;
        return false;
    }

    public boolean allMatch(DoublePredicate predicate) {
        Iterator<Double> it = take();
        while (it.hasNext())
            if (!predicate.test(it.next()))
                return false;
        return true;
    }

    public boolean noneMatch(DoublePredicate predicate) { return !anyMatch(predicate); }

    public OptionalDouble findFirst() {
        Iterator<Double> it = take();
        return it.hasNext() ? OptionalDouble.of(it.next()) : OptionalDouble.empty();
    }

    public Stream<Double> boxed() { return new RefStream<Double>(take()); }
}

// ─── collectors ─────────────────────────────────────────────────────────────

public interface Collector<T, A, R> {
    Supplier<A> supplier();
    BiConsumer<A, T> accumulator();
    BinaryOperator<A> combiner();
    Function<A, R> finisher();
    Set<Characteristics> characteristics();

    enum Characteristics {
        CONCURRENT,
        UNORDERED,
        IDENTITY_FINISH
    }

    @SuppressWarnings("unchecked")
    public static <T, R> Collector<T, R, R> of(Supplier<R> supplier, BiConsumer<R, T> accumulator, BinaryOperator<R> combiner,
                                               Characteristics... characteristics) {
        return new Collectors.CollectorImpl<T, R, R>(supplier, accumulator, combiner, x -> x);
    }

    public static <T, A, R> Collector<T, A, R> of(Supplier<A> supplier, BiConsumer<A, T> accumulator, BinaryOperator<A> combiner,
                                                  Function<A, R> finisher, Characteristics... characteristics) {
        return new Collectors.CollectorImpl<T, A, R>(supplier, accumulator, combiner, finisher);
    }
}

@SuppressWarnings({"unchecked", "rawtypes"})
public final class Collectors {
    private Collectors() {}

    static final class CollectorImpl<T, A, R> implements Collector<T, A, R> {
        private final Supplier<A> supplier;
        private final BiConsumer<A, T> accumulator;
        private final BinaryOperator<A> combiner;
        private final Function<A, R> finisher;

        CollectorImpl(Supplier<A> supplier, BiConsumer<A, T> accumulator, BinaryOperator<A> combiner, Function<A, R> finisher) {
            this.supplier = supplier;
            this.accumulator = accumulator;
            this.combiner = combiner;
            this.finisher = finisher;
        }

        public BiConsumer<A, T> accumulator() { return accumulator; }
        public Supplier<A> supplier() { return supplier; }
        public BinaryOperator<A> combiner() { return combiner; }
        public Function<A, R> finisher() { return finisher; }
        public Set<Characteristics> characteristics() { return Collections.emptySet(); }
    }

    // a collector from raw parts: (supplier, accumulator, finisher)
    private static Collector make(Supplier supplier, BiConsumer accumulator, Function finisher) {
        return new CollectorImpl(supplier, accumulator, (a, b) -> a, finisher);
    }

    private static final Function IDENTITY = x -> x;

    public static <T, C extends Collection<T>> Collector<T, ?, C> toCollection(Supplier<C> collectionFactory) {
        return make(collectionFactory, (BiConsumer<Collection, Object>) (c, t) -> c.add(t), IDENTITY);
    }

    public static <T> Collector<T, ?, List<T>> toList() {
        return make((Supplier) ArrayList::new, (BiConsumer<List, Object>) (l, t) -> l.add(t), IDENTITY);
    }

    public static <T> Collector<T, ?, List<T>> toUnmodifiableList() {
        return make((Supplier) ArrayList::new, (BiConsumer<List, Object>) (l, t) -> l.add(t), (Function<List, Object>) l -> List.copyOf(l));
    }

    public static <T> Collector<T, ?, Set<T>> toSet() {
        return make((Supplier) HashSet::new, (BiConsumer<Set, Object>) (s, t) -> s.add(t), IDENTITY);
    }

    public static <T> Collector<T, ?, Set<T>> toUnmodifiableSet() {
        return make((Supplier) HashSet::new, (BiConsumer<Set, Object>) (s, t) -> s.add(t), (Function<Set, Object>) s -> Set.copyOf(s));
    }

    public static Collector<CharSequence, ?, String> joining() {
        return make((Supplier) StringBuilder::new, (BiConsumer<StringBuilder, Object>) (sb, t) -> sb.append((CharSequence) t),
                (Function<StringBuilder, Object>) sb -> sb.toString());
    }

    public static Collector<CharSequence, ?, String> joining(CharSequence delimiter) { return joining(delimiter, "", ""); }

    public static Collector<CharSequence, ?, String> joining(CharSequence delimiter, CharSequence prefix, CharSequence suffix) {
        return make(() -> new StringJoiner(delimiter, prefix, suffix), (BiConsumer<StringJoiner, Object>) (j, t) -> j.add((CharSequence) t),
                (Function<StringJoiner, Object>) j -> j.toString());
    }

    public static <T, U, A, R> Collector<T, ?, R> mapping(Function<? super T, ? extends U> mapper, Collector<? super U, A, R> downstream) {
        BiConsumer acc = downstream.accumulator();
        return make(downstream.supplier(), (a, t) -> acc.accept(a, mapper.apply((T) t)), downstream.finisher());
    }

    public static <T, U, A, R> Collector<T, ?, R> flatMapping(Function<? super T, ? extends Stream<? extends U>> mapper,
                                                              Collector<? super U, A, R> downstream) {
        BiConsumer acc = downstream.accumulator();
        return make(downstream.supplier(), (a, t) -> {
            Stream<? extends U> s = mapper.apply((T) t);
            if (s != null)
                s.forEach(u -> acc.accept(a, u));
        }, downstream.finisher());
    }

    public static <T, A, R> Collector<T, ?, R> filtering(Predicate<? super T> predicate, Collector<? super T, A, R> downstream) {
        BiConsumer acc = downstream.accumulator();
        return make(downstream.supplier(), (a, t) -> {
            if (predicate.test((T) t))
                acc.accept(a, t);
        }, downstream.finisher());
    }

    public static <T, A, R, RR> Collector<T, A, RR> collectingAndThen(Collector<T, A, R> downstream, Function<R, RR> finisher) {
        return make(downstream.supplier(), downstream.accumulator(), downstream.finisher().andThen(finisher));
    }

    public static <T> Collector<T, ?, Long> counting() {
        return make(() -> new long[1], (BiConsumer<long[], Object>) (a, t) -> a[0]++, (Function<long[], Object>) a -> a[0]);
    }

    public static <T> Collector<T, ?, Optional<T>> minBy(Comparator<? super T> comparator) {
        return reducing(BinaryOperator.minBy(comparator));
    }

    public static <T> Collector<T, ?, Optional<T>> maxBy(Comparator<? super T> comparator) {
        return reducing(BinaryOperator.maxBy(comparator));
    }

    public static <T> Collector<T, ?, Integer> summingInt(ToIntFunction<? super T> mapper) {
        return make(() -> new int[1], (BiConsumer<int[], Object>) (a, t) -> a[0] += mapper.applyAsInt((T) t), (Function<int[], Object>) a -> a[0]);
    }

    public static <T> Collector<T, ?, Long> summingLong(ToLongFunction<? super T> mapper) {
        return make(() -> new long[1], (BiConsumer<long[], Object>) (a, t) -> a[0] += mapper.applyAsLong((T) t), (Function<long[], Object>) a -> a[0]);
    }

    public static <T> Collector<T, ?, Double> summingDouble(ToDoubleFunction<? super T> mapper) {
        return make(() -> new double[3], (BiConsumer<double[], Object>) (a, t) -> {
            double val = mapper.applyAsDouble((T) t);
            StreamSupport.sumWithCompensation(a, val);
            a[2] += val;
        }, (Function<double[], Object>) a -> StreamSupport.computeFinalSum(a));
    }

    public static <T> Collector<T, ?, Double> averagingInt(ToIntFunction<? super T> mapper) {
        return make(() -> new long[2], (BiConsumer<long[], Object>) (a, t) -> {
            a[0] += mapper.applyAsInt((T) t);
            a[1]++;
        }, (Function<long[], Object>) a -> (a[1] == 0) ? 0.0d : (double) a[0] / a[1]);
    }

    public static <T> Collector<T, ?, Double> averagingLong(ToLongFunction<? super T> mapper) {
        return make(() -> new long[2], (BiConsumer<long[], Object>) (a, t) -> {
            a[0] += mapper.applyAsLong((T) t);
            a[1]++;
        }, (Function<long[], Object>) a -> (a[1] == 0) ? 0.0d : (double) a[0] / a[1]);
    }

    public static <T> Collector<T, ?, Double> averagingDouble(ToDoubleFunction<? super T> mapper) {
        return make(() -> new double[4], (BiConsumer<double[], Object>) (a, t) -> {
            double val = mapper.applyAsDouble((T) t);
            StreamSupport.sumWithCompensation(a, val);
            a[2]++;
            a[3] += val;
        }, (Function<double[], Object>) a -> (a[2] == 0) ? 0.0d : (StreamSupport.computeFinalSum(a) / a[2]));
    }

    public static <T> Collector<T, ?, T> reducing(T identity, BinaryOperator<T> op) {
        return make(() -> new Object[] {identity}, (BiConsumer<Object[], Object>) (a, t) -> a[0] = op.apply((T) a[0], (T) t),
                (Function<Object[], Object>) a -> a[0]);
    }

    public static <T> Collector<T, ?, Optional<T>> reducing(BinaryOperator<T> op) {
        return make(() -> new Object[2], (BiConsumer<Object[], Object>) (a, t) -> {
            if (a[1] == null) {
                a[0] = t;
                a[1] = Boolean.TRUE;
            } else
                a[0] = op.apply((T) a[0], (T) t);
        }, (Function<Object[], Object>) a -> a[1] == null ? Optional.empty() : Optional.of(a[0]));
    }

    public static <T, U> Collector<T, ?, U> reducing(U identity, Function<? super T, ? extends U> mapper, BinaryOperator<U> op) {
        return make(() -> new Object[] {identity}, (BiConsumer<Object[], Object>) (a, t) -> a[0] = op.apply((U) a[0], mapper.apply((T) t)),
                (Function<Object[], Object>) a -> a[0]);
    }

    public static <T, K> Collector<T, ?, Map<K, List<T>>> groupingBy(Function<? super T, ? extends K> classifier) {
        return groupingBy(classifier, HashMap::new, toList());
    }

    public static <T, K, A, D> Collector<T, ?, Map<K, D>> groupingBy(Function<? super T, ? extends K> classifier,
                                                                     Collector<? super T, A, D> downstream) {
        return groupingBy(classifier, HashMap::new, downstream);
    }

    public static <T, K, D, A, M extends Map<K, D>> Collector<T, ?, M> groupingBy(Function<? super T, ? extends K> classifier,
                                                                                  Supplier<M> mapFactory,
                                                                                  Collector<? super T, A, D> downstream) {
        Supplier ds = downstream.supplier();
        BiConsumer da = downstream.accumulator();
        Function df = downstream.finisher();
        return make(mapFactory, (BiConsumer<Map, Object>) (m, t) -> {
            Object key = Objects.requireNonNull(classifier.apply((T) t), "element cannot be mapped to a null key");
            Object container = m.computeIfAbsent(key, k -> ds.get());
            da.accept(container, t);
        }, (Function<Map, Object>) m -> {
            if (df != IDENTITY)
                m.replaceAll((k, v) -> df.apply(v));
            return m;
        });
    }

    public static <T, K> Collector<T, ?, Map<K, List<T>>> groupingByConcurrent(Function<? super T, ? extends K> classifier) {
        return groupingBy(classifier);
    }

    public static <T> Collector<T, ?, Map<Boolean, List<T>>> partitioningBy(Predicate<? super T> predicate) {
        return partitioningBy(predicate, toList());
    }

    public static <T, D, A> Collector<T, ?, Map<Boolean, D>> partitioningBy(Predicate<? super T> predicate,
                                                                            Collector<? super T, A, D> downstream) {
        Supplier ds = downstream.supplier();
        BiConsumer da = downstream.accumulator();
        Function df = downstream.finisher();
        return make(() -> new Object[] {ds.get(), ds.get()}, (BiConsumer<Object[], Object>) (a, t) -> {
            da.accept(predicate.test((T) t) ? a[1] : a[0], t);
        }, (Function<Object[], Object>) a -> new Partition<Object>(df.apply(a[1]), df.apply(a[0])));
    }

    private static final class Partition<T> extends AbstractMap<Boolean, T> {
        final T forTrue;
        final T forFalse;

        Partition(T forTrue, T forFalse) {
            this.forTrue = forTrue;
            this.forFalse = forFalse;
        }

        public Set<Map.Entry<Boolean, T>> entrySet() {
            return new AbstractSet<Map.Entry<Boolean, T>>() {
                public Iterator<Map.Entry<Boolean, T>> iterator() {
                    ArrayList<Map.Entry<Boolean, T>> l = new ArrayList<>();
                    l.add(new AbstractMap.SimpleImmutableEntry<>(false, forFalse));
                    l.add(new AbstractMap.SimpleImmutableEntry<>(true, forTrue));
                    return l.iterator();
                }
                public int size() { return 2; }
            };
        }

        public boolean containsKey(Object key) { return key instanceof Boolean; }

        public T get(Object key) {
            if (key instanceof Boolean b)
                return b ? forTrue : forFalse;
            return null;
        }
    }

    public static <T, K, U> Collector<T, ?, Map<K, U>> toMap(Function<? super T, ? extends K> keyMapper,
                                                            Function<? super T, ? extends U> valueMapper) {
        return make((Supplier) HashMap::new, (BiConsumer<Map, Object>) (m, t) -> {
            Object k = keyMapper.apply((T) t);
            Object v = Objects.requireNonNull(valueMapper.apply((T) t));
            Object u = m.putIfAbsent(k, v);
            if (u != null)
                throw new IllegalStateException(String.format("Duplicate key %s (attempted merging values %s and %s)", k, u, v));
        }, IDENTITY);
    }

    public static <T, K, U> Collector<T, ?, Map<K, U>> toMap(Function<? super T, ? extends K> keyMapper,
                                                            Function<? super T, ? extends U> valueMapper,
                                                            BinaryOperator<U> mergeFunction) {
        return toMap(keyMapper, valueMapper, mergeFunction, HashMap::new);
    }

    public static <T, K, U, M extends Map<K, U>> Collector<T, ?, M> toMap(Function<? super T, ? extends K> keyMapper,
                                                                         Function<? super T, ? extends U> valueMapper,
                                                                         BinaryOperator<U> mergeFunction, Supplier<M> mapFactory) {
        return make(mapFactory, (BiConsumer<Map, Object>) (m, t) -> m.merge(keyMapper.apply((T) t), valueMapper.apply((T) t), mergeFunction), IDENTITY);
    }

    public static <T, K, U> Collector<T, ?, Map<K, U>> toUnmodifiableMap(Function<? super T, ? extends K> keyMapper,
                                                                        Function<? super T, ? extends U> valueMapper) {
        return collectingAndThen(toMap(keyMapper, valueMapper), m -> Map.copyOf(m));
    }

    public static <T> Collector<T, ?, IntSummaryStatistics> summarizingInt(ToIntFunction<? super T> mapper) {
        return make((Supplier) IntSummaryStatistics::new, (BiConsumer<IntSummaryStatistics, Object>) (s, t) -> s.accept(mapper.applyAsInt((T) t)), IDENTITY);
    }

    public static <T> Collector<T, ?, LongSummaryStatistics> summarizingLong(ToLongFunction<? super T> mapper) {
        return make((Supplier) LongSummaryStatistics::new, (BiConsumer<LongSummaryStatistics, Object>) (s, t) -> s.accept(mapper.applyAsLong((T) t)), IDENTITY);
    }

    public static <T> Collector<T, ?, DoubleSummaryStatistics> summarizingDouble(ToDoubleFunction<? super T> mapper) {
        return make((Supplier) DoubleSummaryStatistics::new, (BiConsumer<DoubleSummaryStatistics, Object>) (s, t) -> s.accept(mapper.applyAsDouble((T) t)), IDENTITY);
    }

    public static <T, R1, R2, R> Collector<T, ?, R> teeing(Collector<? super T, ?, R1> downstream1, Collector<? super T, ?, R2> downstream2,
                                                         BiFunction<? super R1, ? super R2, R> merger) {
        Supplier s1 = downstream1.supplier(), s2 = downstream2.supplier();
        BiConsumer a1 = downstream1.accumulator(), a2 = downstream2.accumulator();
        Function f1 = downstream1.finisher(), f2 = downstream2.finisher();
        return make(() -> new Object[] {s1.get(), s2.get()}, (BiConsumer<Object[], Object>) (a, t) -> {
            a1.accept(a[0], t);
            a2.accept(a[1], t);
        }, (Function<Object[], Object>) a -> merger.apply((R1) f1.apply(a[0]), (R2) f2.apply(a[1])));
    }
}
