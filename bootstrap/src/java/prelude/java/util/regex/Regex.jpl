// java.util.regex over the VM's regular-expression engine (ECMAScript syntax
// with Java's \p{...} classes; inline flags other than a leading (?i) and
// named groups are not supported).
package java.util.regex;

import java.util.*;
import java.util.function.*;

public final class Pattern implements java.io.Serializable {
    public static final int UNIX_LINES = 0x01;
    public static final int CASE_INSENSITIVE = 0x02;
    public static final int COMMENTS = 0x04;
    public static final int MULTILINE = 0x08;
    public static final int LITERAL = 0x10;
    public static final int DOTALL = 0x20;
    public static final int UNICODE_CASE = 0x40;
    public static final int UNICODE_CHARACTER_CLASS = 0x100;

    private final String pattern;
    private final int flags;
    private final String effective; // what the engine matches (LITERAL quoted)

    private Pattern(String p, int f) {
        pattern = p;
        flags = f;
        effective = (f & LITERAL) != 0 ? quote(p) : p;
        $check(effective, f);
    }

    static native int[] $match(String regex, int flags, String input, int from, int mode);
    private static native void $check(String regex, int flags);
    static native int $groupCount(String regex);

    public static Pattern compile(String regex) { return new Pattern(regex, 0); }
    public static Pattern compile(String regex, int flags) { return new Pattern(regex, flags); }

    public String pattern() { return pattern; }
    public int flags() { return flags; }
    public String toString() { return pattern; }
    String effective() { return effective; }

    public Matcher matcher(CharSequence input) { return new Matcher(this, input.toString()); }

    public static boolean matches(String regex, CharSequence input) { return compile(regex).matcher(input).matches(); }

    public static String quote(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ("\\^$.|?*+()[]{}".indexOf(c) >= 0)
                sb.append('\\');
            sb.append(c);
        }
        return sb.toString();
    }

    public String[] split(CharSequence input) { return split(input, 0); }

    public String[] split(CharSequence input, int limit) {
        String s = input.toString();
        ArrayList<String> out = new ArrayList<>();
        Matcher m = matcher(s);
        int index = 0;
        boolean matchLimited = limit > 0;
        while (m.find()) {
            if (!matchLimited || out.size() < limit - 1) {
                if (index == 0 && index == m.start() && m.start() == m.end())
                    continue; // no empty leading substring for a zero-width match at the start
                out.add(s.substring(index, m.start()));
                index = m.end();
            } else
                break;
        }
        if (index == 0 && out.isEmpty())
            return new String[] {s};
        out.add(s.substring(index));
        int resultSize = out.size();
        if (limit == 0)
            while (resultSize > 0 && out.get(resultSize - 1).isEmpty())
                resultSize--;
        String[] result = new String[resultSize];
        for (int i = 0; i < resultSize; i++)
            result[i] = out.get(i);
        return result;
    }

    public java.util.stream.Stream<String> splitAsStream(CharSequence input) { return Arrays.stream(split(input)); }
    public Predicate<String> asPredicate() { return s -> matcher(s).find(); }
    public Predicate<String> asMatchPredicate() { return s -> matcher(s).matches(); }
}

public interface MatchResult {
    int start();
    int start(int group);
    int end();
    int end(int group);
    String group();
    String group(int group);
    int groupCount();
}

public final class Matcher implements MatchResult {
    private Pattern pattern;
    private String text;
    private int[] groups;    // [start0, end0, start1, end1, ...] of the last match, or null
    private int searchFrom;  // where the next find() starts
    private int appendPos;

    Matcher(Pattern pattern, String text) {
        this.pattern = pattern;
        this.text = text;
    }

    public Pattern pattern() { return pattern; }

    public boolean matches() {
        groups = Pattern.$match(pattern.effective(), pattern.flags(), text, 0, 1);
        if (groups != null)
            searchFrom = groups[1];
        return groups != null;
    }

    public boolean lookingAt() {
        groups = Pattern.$match(pattern.effective(), pattern.flags(), text, 0, 2);
        if (groups != null)
            searchFrom = groups[1];
        return groups != null;
    }

    public boolean find() {
        if (searchFrom > text.length()) {
            groups = null;
            return false;
        }
        groups = Pattern.$match(pattern.effective(), pattern.flags(), text, searchFrom, 0);
        if (groups == null) {
            searchFrom = text.length() + 1;
            return false;
        }
        searchFrom = groups[1] == groups[0] ? groups[1] + 1 : groups[1];
        return true;
    }

    public boolean find(int start) {
        if (start < 0 || start > text.length())
            throw new IndexOutOfBoundsException("Illegal start index");
        reset();
        searchFrom = start;
        return find();
    }

    private void checkMatch() {
        if (groups == null)
            throw new IllegalStateException("No match found");
    }

    private void checkGroup(int group) {
        if (group < 0 || group > groupCount())
            throw new IndexOutOfBoundsException("No group " + group);
    }

    public String group() { return group(0); }

    public String group(int group) {
        checkMatch();
        checkGroup(group);
        if (groups[2 * group] < 0)
            return null;
        return text.substring(groups[2 * group], groups[2 * group + 1]);
    }

    public String group(String name) { throw new IllegalArgumentException("No group with name <" + name + ">"); }

    public int groupCount() { return groups != null ? groups.length / 2 - 1 : Pattern.$groupCount(pattern.effective()); }

    public int start() { return start(0); }

    public int start(int group) {
        checkMatch();
        checkGroup(group);
        return groups[2 * group];
    }

    public int end() { return end(0); }

    public int end(int group) {
        checkMatch();
        checkGroup(group);
        return groups[2 * group + 1];
    }

    public boolean hasMatch() { return groups != null; }
    public boolean hitEnd() { return groups == null || groups[1] == text.length(); }

    public Matcher reset() {
        groups = null;
        searchFrom = 0;
        appendPos = 0;
        return this;
    }

    public Matcher reset(CharSequence input) {
        text = input.toString();
        return reset();
    }

    public Matcher usePattern(Pattern newPattern) {
        pattern = Objects.requireNonNull(newPattern);
        groups = null;
        return this;
    }

    // $n and \x in a replacement string
    private String expand(String replacement) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < replacement.length(); i++) {
            char c = replacement.charAt(i);
            if (c == '\\' && i + 1 < replacement.length()) {
                sb.append(replacement.charAt(++i));
            } else if (c == '$' && i + 1 < replacement.length() && Character.isDigit(replacement.charAt(i + 1))) {
                int g = replacement.charAt(++i) - '0';
                while (i + 1 < replacement.length() && Character.isDigit(replacement.charAt(i + 1))
                        && g * 10 + (replacement.charAt(i + 1) - '0') <= groupCount())
                    g = g * 10 + (replacement.charAt(++i) - '0');
                String v = group(g);
                if (v != null)
                    sb.append(v);
            } else if (c == '$') {
                throw new IllegalArgumentException("Illegal group reference");
            } else
                sb.append(c);
        }
        return sb.toString();
    }

    public Matcher appendReplacement(StringBuilder sb, String replacement) {
        checkMatch();
        sb.append(text, appendPos, start());
        sb.append(expand(replacement));
        appendPos = end();
        return this;
    }

    public Matcher appendReplacement(StringBuffer sb, String replacement) {
        checkMatch();
        sb.append(text, appendPos, start());
        sb.append(expand(replacement));
        appendPos = end();
        return this;
    }

    public StringBuilder appendTail(StringBuilder sb) {
        sb.append(text, appendPos, text.length());
        return sb;
    }

    public StringBuffer appendTail(StringBuffer sb) {
        sb.append(text, appendPos, text.length());
        return sb;
    }

    public String replaceAll(String replacement) {
        reset();
        StringBuilder sb = new StringBuilder();
        while (find())
            appendReplacement(sb, replacement);
        return appendTail(sb).toString();
    }

    public String replaceAll(Function<MatchResult, String> replacer) {
        reset();
        StringBuilder sb = new StringBuilder();
        while (find())
            appendReplacement(sb, replacer.apply(toMatchResult()));
        return appendTail(sb).toString();
    }

    public String replaceFirst(String replacement) {
        reset();
        StringBuilder sb = new StringBuilder();
        if (find())
            appendReplacement(sb, replacement);
        return appendTail(sb).toString();
    }

    public MatchResult toMatchResult() {
        checkMatch();
        final int[] g = groups.clone();
        final String t = text;
        return new MatchResult() {
            public int start() { return g[0]; }
            public int start(int group) { return g[2 * group]; }
            public int end() { return g[1]; }
            public int end(int group) { return g[2 * group + 1]; }
            public String group() { return t.substring(g[0], g[1]); }
            public String group(int group) { return g[2 * group] < 0 ? null : t.substring(g[2 * group], g[2 * group + 1]); }
            public int groupCount() { return g.length / 2 - 1; }
        };
    }

    public java.util.stream.Stream<MatchResult> results() {
        ArrayList<MatchResult> out = new ArrayList<>();
        reset();
        while (find())
            out.add(toMatchResult());
        return out.stream();
    }

    public static String quoteReplacement(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '\\' || c == '$')
                sb.append('\\');
            sb.append(c);
        }
        return sb.toString();
    }

    public String toString() {
        return "java.util.regex.Matcher[pattern=" + pattern + " region=0," + text.length() + " lastmatch="
                + (groups != null ? group() : "") + "]";
    }
}

public class PatternSyntaxException extends IllegalArgumentException {
    private final String desc;
    private final String pattern;
    private final int index;

    public PatternSyntaxException(String desc, String regex, int index) {
        super(desc);
        this.desc = desc;
        this.pattern = regex;
        this.index = index;
    }

    public PatternSyntaxException(String message) {
        super(message);
        this.desc = message;
        this.pattern = null;
        this.index = -1;
    }

    public int getIndex() { return index; }
    public String getDescription() { return desc; }
    public String getPattern() { return pattern; }
}
