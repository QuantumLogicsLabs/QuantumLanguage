// java.io: console streams, readers and writers. System.in, System.out and
// System.err are the process's standard streams; buffered writers keep their
// text until flushed, as on a JVM.
package java.io;

public interface Serializable {}

public interface Closeable extends AutoCloseable {
    void close() throws IOException;
}

public interface Flushable {
    void flush() throws IOException;
}

public class IOException extends Exception {
    public IOException() { super(); }
    public IOException(String message) { super(message); }
    public IOException(String message, Throwable cause) { super(message, cause); }
    public IOException(Throwable cause) { super(cause); }
}

public class FileNotFoundException extends IOException {
    public FileNotFoundException() { super(); }
    public FileNotFoundException(String s) { super(s); }
}

public class EOFException extends IOException {
    public EOFException() { super(); }
    public EOFException(String s) { super(s); }
}

public class UnsupportedEncodingException extends IOException {
    public UnsupportedEncodingException() { super(); }
    public UnsupportedEncodingException(String s) { super(s); }
}

public class UncheckedIOException extends RuntimeException {
    public UncheckedIOException(String message, IOException cause) { super(message, java.util.Objects.requireNonNull(cause)); }
    public UncheckedIOException(IOException cause) { super(java.util.Objects.requireNonNull(cause)); }
    public IOException getCause() { return (IOException) super.getCause(); }
}

// ─── byte streams ───────────────────────────────────────────────────────────

public abstract class InputStream implements Closeable {
    public InputStream() {}

    public abstract int read() throws IOException;

    public int read(byte[] b) throws IOException { return read(b, 0, b.length); }

    public int read(byte[] b, int off, int len) throws IOException {
        java.util.Objects.checkFromIndexSize(off, len, b.length);
        if (len == 0)
            return 0;
        int c = read();
        if (c == -1)
            return -1;
        b[off] = (byte) c;
        int i = 1;
        for (; i < len; i++) {
            if (available() <= 0)
                break;
            c = read();
            if (c == -1)
                break;
            b[off + i] = (byte) c;
        }
        return i;
    }

    public long skip(long n) throws IOException {
        long k = 0;
        while (k < n && read() != -1)
            k++;
        return k;
    }

    public int available() throws IOException { return 0; }
    public void close() throws IOException {}

    public byte[] readAllBytes() throws IOException {
        java.util.ArrayList<Integer> out = new java.util.ArrayList<>();
        int c;
        while ((c = read()) != -1)
            out.add(c);
        byte[] b = new byte[out.size()];
        for (int i = 0; i < b.length; i++)
            b[i] = (byte) (int) out.get(i);
        return b;
    }

    boolean $isStdin() { return false; }
}

// System.in
public final class $StdIn extends InputStream {
    public int read() { return $In.read(); }
    public int available() { return $In.available(); }
    boolean $isStdin() { return true; }
}

public abstract class OutputStream implements Closeable, Flushable {
    public OutputStream() {}

    public abstract void write(int b) throws IOException;

    public void write(byte[] b) throws IOException { write(b, 0, b.length); }

    public void write(byte[] b, int off, int len) throws IOException {
        for (int i = 0; i < len; i++)
            write(b[off + i]);
    }

    public void flush() throws IOException {}
    public void close() throws IOException {}

    // text written through a writer: encoded as UTF-8 bytes
    void $text(String s) throws IOException {
        byte[] b = s.getBytes();
        write(b, 0, b.length);
    }
}

public class ByteArrayOutputStream extends OutputStream {
    protected byte[] buf = new byte[32];
    protected int count;

    public ByteArrayOutputStream() {}
    public ByteArrayOutputStream(int size) { buf = new byte[Math.max(size, 1)]; }

    public void write(int b) {
        if (count == buf.length)
            buf = java.util.Arrays.copyOf(buf, buf.length * 2);
        buf[count++] = (byte) b;
    }

    public void reset() { count = 0; }
    public int size() { return count; }
    public byte[] toByteArray() { return java.util.Arrays.copyOf(buf, count); }

    public String toString() {
        // decode UTF-8
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < count; ) {
            int b = buf[i] & 0xff;
            int cp, n;
            if (b < 0x80) { cp = b; n = 1; }
            else if (b < 0xE0) { cp = b & 0x1F; n = 2; }
            else if (b < 0xF0) { cp = b & 0x0F; n = 3; }
            else { cp = b & 0x07; n = 4; }
            for (int k = 1; k < n && i + k < count; k++)
                cp = (cp << 6) | (buf[i + k] & 0x3F);
            sb.appendCodePoint(cp);
            i += n;
        }
        return sb.toString();
    }
}

// System.out / System.err, or a PrintStream over another stream.
public class PrintStream extends OutputStream implements Appendable, Closeable {
    private final OutputStream out; // null: the console
    private final boolean err;
    private final boolean autoFlush;
    private boolean trouble;

    private PrintStream(boolean err, int dummy) {
        this.out = null;
        this.err = err;
        this.autoFlush = true;
    }

    public static PrintStream $console(boolean err) { return new PrintStream(err, 0); }

    public PrintStream(OutputStream out) { this(out, false); }

    public PrintStream(OutputStream out, boolean autoFlush) {
        this.out = java.util.Objects.requireNonNull(out, "Null output stream");
        this.err = false;
        this.autoFlush = autoFlush;
    }

    public PrintStream(OutputStream out, boolean autoFlush, String encoding) { this(out, autoFlush); }

    private void text(String s) {
        if (out == null) {
            if (err)
                System.err.print(s);
            else
                System.out.print(s);
            return;
        }
        try {
            out.$text(s);
        } catch (IOException e) {
            trouble = true;
        }
    }

    public void write(int b) {
        if (out == null) {
            $Console.write(err, b);
            return;
        }
        try {
            out.write(b);
        } catch (IOException e) {
            trouble = true;
        }
    }

    public void write(byte[] buf, int off, int len) {
        for (int i = 0; i < len; i++)
            write(buf[off + i]);
    }

    public void flush() {
        if (out == null) {
            System.out.flush();
            return;
        }
        try {
            out.flush();
        } catch (IOException e) {
            trouble = true;
        }
    }

    public void close() { flush(); }
    public boolean checkError() {
        flush();
        return trouble;
    }

    public void print(boolean b) { text(String.valueOf(b)); }
    public void print(char c) { text(String.valueOf(c)); }
    public void print(int i) { text(String.valueOf(i)); }
    public void print(long l) { text(String.valueOf(l)); }
    public void print(float f) { text(String.valueOf(f)); }
    public void print(double d) { text(String.valueOf(d)); }
    public void print(char[] s) { text(new String(s)); }
    public void print(String s) { text(String.valueOf(s)); }
    public void print(Object obj) { text(String.valueOf(obj)); }

    public void println() { text("\n"); }
    public void println(boolean x) { text(String.valueOf(x) + "\n"); }
    public void println(char x) { text(String.valueOf(x) + "\n"); }
    public void println(int x) { text(String.valueOf(x) + "\n"); }
    public void println(long x) { text(String.valueOf(x) + "\n"); }
    public void println(float x) { text(String.valueOf(x) + "\n"); }
    public void println(double x) { text(String.valueOf(x) + "\n"); }
    public void println(char[] x) { text(new String(x) + "\n"); }
    public void println(String x) { text(String.valueOf(x) + "\n"); }
    public void println(Object x) { text(String.valueOf(x) + "\n"); }

    public PrintStream printf(String format, Object... args) {
        text(String.format(format, args));
        return this;
    }

    public PrintStream printf(java.util.Locale l, String format, Object... args) {
        text(String.format(format, args));
        return this;
    }

    public PrintStream format(String format, Object... args) { return printf(format, args); }
    public PrintStream format(java.util.Locale l, String format, Object... args) { return printf(format, args); }

    public PrintStream append(CharSequence csq) {
        print(String.valueOf(csq));
        return this;
    }

    public PrintStream append(CharSequence csq, int start, int end) {
        if (csq == null)
            csq = "null";
        return append(csq.subSequence(start, end));
    }

    public PrintStream append(char c) {
        print(c);
        return this;
    }
}

public final class $Console {
    private $Console() {}
    public static native void write(boolean err, int b); // one raw byte to stdout / stderr
}

// ─── character streams ──────────────────────────────────────────────────────

public abstract class Reader implements Readable, Closeable {
    protected Reader() {}

    public int read() throws IOException {
        char[] cb = new char[1];
        if (read(cb, 0, 1) == -1)
            return -1;
        else
            return cb[0];
    }

    public int read(char[] cbuf) throws IOException { return read(cbuf, 0, cbuf.length); }
    public abstract int read(char[] cbuf, int off, int len) throws IOException;

    public long skip(long n) throws IOException {
        long k = 0;
        while (k < n && read() != -1)
            k++;
        return k;
    }

    public boolean ready() throws IOException { return false; }
    public abstract void close() throws IOException;

    boolean $isStdin() { return false; }

    public long transferTo(Writer out) throws IOException {
        long n = 0;
        int c;
        while ((c = read()) != -1) {
            out.write(c);
            n++;
        }
        return n;
    }
}

public interface Readable {}

public class InputStreamReader extends Reader {
    private final InputStream in;

    public InputStreamReader(InputStream in) { this.in = java.util.Objects.requireNonNull(in); }
    public InputStreamReader(InputStream in, String charsetName) { this(in); }

    public int read() throws IOException {
        int b = in.read();
        if (b < 0x80)
            return b;
        // UTF-8: a multi-byte character
        int n = b >= 0xF0 ? 3 : b >= 0xE0 ? 2 : 1;
        int cp = b & (0x3F >> n);
        for (int k = 0; k < n; k++) {
            int c = in.read();
            if (c < 0)
                break;
            cp = (cp << 6) | (c & 0x3F);
        }
        return cp;
    }

    public int read(char[] cbuf, int off, int len) throws IOException {
        if (len == 0)
            return 0;
        int c = read();
        if (c == -1)
            return -1;
        cbuf[off] = (char) c;
        int i = 1;
        while (i < len && in.available() > 0) {
            c = read();
            if (c == -1)
                break;
            cbuf[off + i++] = (char) c;
        }
        return i;
    }

    public boolean ready() throws IOException { return in.available() > 0; }
    public void close() throws IOException { in.close(); }
    boolean $isStdin() { return in.$isStdin(); }
}

public class StringReader extends Reader {
    private String str;
    private int next = 0;

    public StringReader(String s) { this.str = s; }

    public int read() throws IOException {
        if (next >= str.length())
            return -1;
        return str.charAt(next++);
    }

    public int read(char[] cbuf, int off, int len) throws IOException {
        if (len == 0)
            return 0;
        if (next >= str.length())
            return -1;
        int n = Math.min(str.length() - next, len);
        for (int i = 0; i < n; i++)
            cbuf[off + i] = str.charAt(next + i);
        next += n;
        return n;
    }

    public boolean ready() throws IOException { return true; }
    public void close() {}
}

public class BufferedReader extends Reader {
    private final Reader in;
    private int pushedBack = -2;

    public BufferedReader(Reader in) { this.in = java.util.Objects.requireNonNull(in); }
    public BufferedReader(Reader in, int sz) { this(in); }

    public int read() throws IOException {
        if (pushedBack != -2) {
            int c = pushedBack;
            pushedBack = -2;
            return c;
        }
        return in.read();
    }

    public int read(char[] cbuf, int off, int len) throws IOException {
        if (len == 0)
            return 0;
        int c = read();
        if (c == -1)
            return -1;
        cbuf[off] = (char) c;
        int i = 1;
        while (i < len && in.ready()) {
            c = read();
            if (c == -1)
                break;
            cbuf[off + i++] = (char) c;
        }
        return i;
    }

    public String readLine() throws IOException {
        if (in.$isStdin() && pushedBack == -2)
            return $In.line();
        StringBuilder sb = null;
        while (true) {
            int c = read();
            if (c == -1)
                return sb == null ? null : sb.toString();
            if (sb == null)
                sb = new StringBuilder();
            if (c == '\n')
                return sb.toString();
            if (c == '\r') {
                int d = read();
                if (d != '\n' && d != -1)
                    pushedBack = d;
                return sb.toString();
            }
            sb.append((char) c);
        }
    }

    public boolean ready() throws IOException { return pushedBack != -2 || in.ready(); }
    public void close() throws IOException { in.close(); }
    boolean $isStdin() { return in.$isStdin(); }

    public java.util.stream.Stream<String> lines() {
        java.util.ArrayList<String> out = new java.util.ArrayList<>();
        try {
            String line;
            while ((line = readLine()) != null)
                out.add(line);
        } catch (IOException e) {
            throw new UncheckedIOException(e);
        }
        return out.stream();
    }
}

public abstract class Writer implements Appendable, Closeable, Flushable {
    protected Writer() {}

    public void write(int c) throws IOException { write(String.valueOf((char) c)); }
    public void write(char[] cbuf) throws IOException { write(cbuf, 0, cbuf.length); }
    public abstract void write(char[] cbuf, int off, int len) throws IOException;
    public void write(String str) throws IOException { write(str, 0, str.length()); }
    public void write(String str, int off, int len) throws IOException { write(str.substring(off, off + len).toCharArray(), 0, len); }

    public Writer append(CharSequence csq) throws IOException {
        write(String.valueOf(csq));
        return this;
    }

    public Writer append(CharSequence csq, int start, int end) throws IOException {
        if (csq == null)
            csq = "null";
        return append(csq.subSequence(start, end));
    }

    public Writer append(char c) throws IOException {
        write(c);
        return this;
    }

    public abstract void flush() throws IOException;
    public abstract void close() throws IOException;
}

public class OutputStreamWriter extends Writer {
    private final OutputStream out;

    public OutputStreamWriter(OutputStream out) { this.out = java.util.Objects.requireNonNull(out); }
    public OutputStreamWriter(OutputStream out, String charsetName) { this(out); }

    public void write(char[] cbuf, int off, int len) throws IOException { write(new String(cbuf, off, len)); }

    public void write(String str, int off, int len) throws IOException {
        String s = str.substring(off, off + len);
        if (out instanceof PrintStream ps)
            ps.print(s);
        else
            out.$text(s);
    }

    public void write(int c) throws IOException { write(String.valueOf((char) c)); }
    public void flush() throws IOException { out.flush(); }
    public void close() throws IOException { out.close(); }
}

public class BufferedWriter extends Writer {
    private final Writer out;
    private final StringBuilder buf = new StringBuilder();

    public BufferedWriter(Writer out) { this.out = java.util.Objects.requireNonNull(out); }
    public BufferedWriter(Writer out, int sz) { this(out); }

    private void flushBuffer() throws IOException {
        if (buf.length() > 0) {
            out.write(buf.toString());
            buf.setLength(0);
        }
    }

    public void write(int c) throws IOException {
        buf.append((char) c);
        if (buf.length() >= 8192)
            flushBuffer();
    }

    public void write(char[] cbuf, int off, int len) throws IOException {
        buf.append(cbuf, off, len);
        if (buf.length() >= 8192)
            flushBuffer();
    }

    public void write(String s, int off, int len) throws IOException {
        buf.append(s, off, off + len);
        if (buf.length() >= 8192)
            flushBuffer();
    }

    public void newLine() throws IOException { write("\n"); }

    public void flush() throws IOException {
        flushBuffer();
        out.flush();
    }

    public void close() throws IOException {
        flushBuffer();
        out.close();
    }
}

public class StringWriter extends Writer {
    private final StringBuffer buf = new StringBuffer();

    public StringWriter() {}
    public StringWriter(int initialSize) {}

    public void write(int c) { buf.append((char) c); }
    public void write(char[] cbuf, int off, int len) { buf.append(cbuf, off, len); }
    public void write(String str) { buf.append(str); }
    public void write(String str, int off, int len) { buf.append(str, off, off + len); }

    public StringWriter append(CharSequence csq) {
        write(String.valueOf(csq));
        return this;
    }

    public StringWriter append(char c) {
        write(c);
        return this;
    }

    public String toString() { return buf.toString(); }
    public StringBuffer getBuffer() { return buf; }
    public void flush() {}
    public void close() throws IOException {}
}

public class PrintWriter extends Writer {
    protected Writer out;
    private final boolean autoFlush;
    private boolean trouble = false;

    public PrintWriter(Writer out) { this(out, false); }

    public PrintWriter(Writer out, boolean autoFlush) {
        this.out = java.util.Objects.requireNonNull(out);
        this.autoFlush = autoFlush;
    }

    public PrintWriter(OutputStream out) { this(out, false); }
    public PrintWriter(OutputStream out, boolean autoFlush) { this(new BufferedWriter(new OutputStreamWriter(out)), autoFlush); }

    public void flush() {
        try {
            out.flush();
        } catch (IOException x) {
            trouble = true;
        }
    }

    public void close() {
        try {
            out.close();
        } catch (IOException x) {
            trouble = true;
        }
    }

    public boolean checkError() {
        flush();
        return trouble;
    }

    public void write(int c) {
        try {
            out.write(c);
        } catch (IOException x) {
            trouble = true;
        }
    }

    public void write(char[] buf, int off, int len) {
        try {
            out.write(buf, off, len);
        } catch (IOException x) {
            trouble = true;
        }
    }

    public void write(char[] buf) { write(buf, 0, buf.length); }

    public void write(String s, int off, int len) {
        try {
            out.write(s, off, len);
        } catch (IOException x) {
            trouble = true;
        }
    }

    public void write(String s) { write(s, 0, s.length()); }

    private void newLine() {
        write("\n");
        if (autoFlush)
            flush();
    }

    public void print(boolean b) { write(String.valueOf(b)); }
    public void print(char c) { write(String.valueOf(c)); }
    public void print(int i) { write(String.valueOf(i)); }
    public void print(long l) { write(String.valueOf(l)); }
    public void print(float f) { write(String.valueOf(f)); }
    public void print(double d) { write(String.valueOf(d)); }
    public void print(char[] s) { write(s); }
    public void print(String s) { write(String.valueOf(s)); }
    public void print(Object obj) { write(String.valueOf(obj)); }

    public void println() { newLine(); }

    public void println(boolean x) {
        print(x);
        newLine();
    }

    public void println(char x) {
        print(x);
        newLine();
    }

    public void println(int x) {
        print(x);
        newLine();
    }

    public void println(long x) {
        print(x);
        newLine();
    }

    public void println(float x) {
        print(x);
        newLine();
    }

    public void println(double x) {
        print(x);
        newLine();
    }

    public void println(char[] x) {
        print(x);
        newLine();
    }

    public void println(String x) {
        print(x);
        newLine();
    }

    public void println(Object x) {
        print(String.valueOf(x));
        newLine();
    }

    public PrintWriter printf(String format, Object... args) {
        write(String.format(format, args));
        if (autoFlush)
            flush();
        return this;
    }

    public PrintWriter printf(java.util.Locale l, String format, Object... args) { return printf(format, args); }
    public PrintWriter format(String format, Object... args) { return printf(format, args); }
    public PrintWriter format(java.util.Locale l, String format, Object... args) { return printf(format, args); }

    public PrintWriter append(CharSequence csq) {
        write(String.valueOf(csq));
        return this;
    }

    public PrintWriter append(CharSequence csq, int start, int end) {
        if (csq == null)
            csq = "null";
        return append(csq.subSequence(start, end));
    }

    public PrintWriter append(char c) {
        write(c);
        return this;
    }
}

// Reads numbers and words from a stream (the usual fast-input idiom).
public class StreamTokenizer {
    public static final int TT_EOF = -1;
    public static final int TT_EOL = '\n';
    public static final int TT_NUMBER = -2;
    public static final int TT_WORD = -3;
    public int ttype = -4;
    public String sval;
    public double nval;
    private final Reader reader;
    private boolean pushedBack;
    private int lineno = 1;
    private int peekc = -2;

    public StreamTokenizer(Reader r) { reader = java.util.Objects.requireNonNull(r); }
    public StreamTokenizer(InputStream is) { reader = new InputStreamReader(is); }

    public void resetSyntax() {}
    public void wordChars(int low, int hi) {}
    public void whitespaceChars(int low, int hi) {}
    public void ordinaryChars(int low, int hi) {}
    public void ordinaryChar(int ch) {}
    public void commentChar(int ch) {}
    public void quoteChar(int ch) {}
    public void parseNumbers() {}
    public void eolIsSignificant(boolean flag) {}
    public void slashStarComments(boolean flag) {}
    public void slashSlashComments(boolean flag) {}
    public void lowerCaseMode(boolean fl) {}
    public void pushBack() {
        if (ttype != -4)
            pushedBack = true;
    }
    public int lineno() { return lineno; }

    private int readChar() throws IOException {
        if (peekc != -2) {
            int c = peekc;
            peekc = -2;
            return c;
        }
        return reader.read();
    }

    public int nextToken() throws IOException {
        if (pushedBack) {
            pushedBack = false;
            return ttype;
        }
        sval = null;
        String t;
        if (reader.$isStdin() && peekc == -2) {
            t = $In.token();
        } else {
            int c = readChar();
            while (c != -1 && c <= ' ') {
                if (c == '\n')
                    lineno++;
                c = readChar();
            }
            if (c == -1) {
                t = null;
            } else {
                StringBuilder sb = new StringBuilder();
                while (c != -1 && c > ' ') {
                    sb.append((char) c);
                    c = readChar();
                }
                peekc = c;
                t = sb.toString();
            }
        }
        if (t == null)
            return ttype = TT_EOF;
        if (isNumber(t)) {
            nval = Double.parseDouble(t);
            return ttype = TT_NUMBER;
        }
        sval = t;
        return ttype = TT_WORD;
    }

    private static boolean isNumber(String t) {
        int i = 0, n = t.length();
        if (i < n && t.charAt(i) == '-')
            i++;
        boolean digits = false, dot = false;
        for (; i < n; i++) {
            char c = t.charAt(i);
            if (c >= '0' && c <= '9')
                digits = true;
            else if (c == '.' && !dot)
                dot = true;
            else
                return false;
        }
        return digits;
    }

    public String toString() {
        String ret;
        switch (ttype) {
            case TT_EOF: ret = "EOF"; break;
            case TT_NUMBER: ret = "n=" + nval; break;
            case TT_WORD: ret = sval; break;
            default: ret = "NOTHING"; break;
        }
        return "Token[" + ret + "], line " + lineno;
    }
}
