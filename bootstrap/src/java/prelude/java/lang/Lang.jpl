// java.lang for the Quantum VM.
//
// Runtime representation (include/JavaOps.h): String values are VM strings,
// boxed Integer / Long / Short / Byte are the integer itself, Double / Float
// the double, Boolean the bool, Character a one-character string. Methods of
// those classes therefore treat `this` as the value (unboxing it).
// A `native` method is implemented by the VM native __jn_<Class>_<method>.
package java.lang;

public class Object {
    public Object() {}

    public boolean equals(Object obj) { return this == obj; }

    public int hashCode() { return System.identityHashCode(this); }

    public String toString() { return getClass().getName() + "@" + Integer.toHexString(hashCode()); }

    public final Class<?> getClass() { return Class.$of(this); }

    protected Object clone() throws CloneNotSupportedException {
        if (!(this instanceof Cloneable))
            throw new CloneNotSupportedException(getClass().getName());
        return $clone(this);
    }

    private static native Object $clone(Object o);

    public final void notify() {}
    public final void notifyAll() {}
    public final void wait() throws InterruptedException {}
    public final void wait(long timeoutMillis) throws InterruptedException {}
}

public final class Class<T> {
    private final String name;
    private final String simple;
    private static Class<?>[] cache = new Class<?>[16];
    private static int cached;

    private Class(String name, String simple) {
        this.name = name;
        this.simple = simple;
    }

    static Class<?> $of(Object o) {
        if (o == null)
            throw new NullPointerException();
        return $named($className(o), $simpleName(o));
    }

    static Class<?> $named(String name, String simple) {
        for (int i = 0; i < cached; i++)
            if (cache[i].name.equals(name))
                return cache[i];
        if (cached == cache.length) {
            Class<?>[] bigger = new Class<?>[cached * 2];
            for (int i = 0; i < cached; i++)
                bigger[i] = cache[i];
            cache = bigger;
        }
        Class<?> c = new Class<>(name, simple);
        cache[cached++] = c;
        return c;
    }

    private static native String $className(Object o);
    private static native String $simpleName(Object o);
    private static native boolean $isInstance(Object o, String descriptor);

    public String getName() { return name; }
    public String getSimpleName() { return simple; }
    public String getTypeName() { return name.replace('$', '.'); }
    public String getCanonicalName() { return name.replace('$', '.'); }

    public boolean isPrimitive() {
        switch (name) {
            case "int": case "long": case "short": case "byte": case "char":
            case "float": case "double": case "boolean": case "void":
                return true;
            default:
                return false;
        }
    }

    public boolean isArray() { return name.startsWith("["); }

    public boolean isInstance(Object obj) { return obj != null && $isInstance(obj, "C:" + name); }

    @SuppressWarnings("unchecked")
    public T cast(Object obj) { return (T) obj; }

    public String toString() { return (isPrimitive() ? "" : "class ") + name; }

    public int hashCode() { return name.hashCode(); }
}

public interface Comparable<T> {
    int compareTo(T o);
}

public interface Iterable<T> {
    java.util.Iterator<T> iterator();

    default void forEach(java.util.function.Consumer<? super T> action) {
        java.util.Objects.requireNonNull(action);
        for (T t : this)
            action.accept(t);
    }
}

public interface CharSequence {
    int length();
    char charAt(int index);
    CharSequence subSequence(int start, int end);
    String toString();

    default boolean isEmpty() { return length() == 0; }

    default java.util.stream.IntStream chars() { return toString().chars(); }

    static int compare(CharSequence cs1, CharSequence cs2) { return cs1.toString().compareTo(cs2.toString()); }
}

public interface Runnable {
    void run();
}

public interface AutoCloseable {
    void close() throws Exception;
}

public interface Cloneable {}

public interface Appendable {
    Appendable append(CharSequence csq) throws java.io.IOException;
    Appendable append(char c) throws java.io.IOException;
}

public final class Void {
    private Void() {}
}

// ─── Strings ────────────────────────────────────────────────────────────────

public final class String implements java.io.Serializable, Comparable<String>, CharSequence {
    public static final java.util.Comparator<String> CASE_INSENSITIVE_ORDER = (a, b) -> a.compareToIgnoreCase(b);

    // `new String(...)` is lowered to __jn_String_new: these bodies never run
    public String() {}
    public String(String original) {}
    public String(char[] value) {}
    public String(char[] value, int offset, int count) {}
    public String(byte[] bytes) {}
    public String(StringBuilder builder) {}
    public String(StringBuffer buffer) {}

    public native int length();
    public native char charAt(int index);
    public native boolean isEmpty();
    public native String substring(int beginIndex);
    public native String substring(int beginIndex, int endIndex);
    public native CharSequence subSequence(int beginIndex, int endIndex);
    public native int indexOf(int ch);
    public native int indexOf(int ch, int fromIndex);
    public native int indexOf(String str);
    public native int indexOf(String str, int fromIndex);
    public native int lastIndexOf(int ch);
    public native int lastIndexOf(int ch, int fromIndex);
    public native int lastIndexOf(String str);
    public native int lastIndexOf(String str, int fromIndex);
    public native boolean contains(CharSequence s);
    public native boolean startsWith(String prefix);
    public native boolean startsWith(String prefix, int toffset);
    public native boolean endsWith(String suffix);
    public native boolean equals(Object anObject);
    public native boolean equalsIgnoreCase(String anotherString);
    public native int compareTo(String anotherString);
    public native int compareToIgnoreCase(String str);
    public native String toUpperCase();
    public native String toLowerCase();
    public native String trim();
    public native String strip();
    public native String stripLeading();
    public native String stripTrailing();
    public native boolean isBlank();
    public native String replace(char oldChar, char newChar);
    public native String replace(CharSequence target, CharSequence replacement);
    public native String replaceAll(String regex, String replacement);
    public native String replaceFirst(String regex, String replacement);
    public native boolean matches(String regex);
    public native String[] split(String regex);
    public native String[] split(String regex, int limit);
    public native char[] toCharArray();
    public native int hashCode();
    public native String repeat(int count);
    public native String concat(String str);
    public native int codePointAt(int index);

    public String toString() { return this; }
    public String intern() { return this; }
    public String toUpperCase(java.util.Locale locale) { return toUpperCase(); }
    public String toLowerCase(java.util.Locale locale) { return toLowerCase(); }
    public boolean contentEquals(CharSequence cs) { return equals(cs.toString()); }

    public boolean regionMatches(int toffset, String other, int ooffset, int len) {
        return regionMatches(false, toffset, other, ooffset, len);
    }

    public boolean regionMatches(boolean ignoreCase, int toffset, String other, int ooffset, int len) {
        if (ooffset < 0 || toffset < 0 || toffset > (long) length() - len || ooffset > (long) other.length() - len)
            return false;
        for (int i = 0; i < len; i++) {
            char c1 = charAt(toffset + i), c2 = other.charAt(ooffset + i);
            if (c1 == c2)
                continue;
            if (ignoreCase && (Character.toUpperCase(c1) == Character.toUpperCase(c2)
                    || Character.toLowerCase(c1) == Character.toLowerCase(c2)))
                continue;
            return false;
        }
        return true;
    }

    public int codePointCount(int beginIndex, int endIndex) {
        int n = 0;
        for (int i = beginIndex; i < endIndex; i++, n++)
            if (Character.isHighSurrogate(charAt(i)) && i + 1 < endIndex && Character.isLowSurrogate(charAt(i + 1)))
                i++;
        return n;
    }

    public byte[] getBytes() {
        java.util.ArrayList<Integer> out = new java.util.ArrayList<>();
        for (int i = 0; i < length(); i++) {
            int c = charAt(i);
            if (Character.isHighSurrogate((char) c) && i + 1 < length()) {
                c = 0x10000 + ((c - 0xD800) << 10) + (charAt(i + 1) - 0xDC00);
                i++;
            }
            if (c < 0x80) {
                out.add(c);
            } else if (c < 0x800) {
                out.add(0xC0 | (c >> 6));
                out.add(0x80 | (c & 0x3F));
            } else if (c < 0x10000) {
                out.add(0xE0 | (c >> 12));
                out.add(0x80 | ((c >> 6) & 0x3F));
                out.add(0x80 | (c & 0x3F));
            } else {
                out.add(0xF0 | (c >> 18));
                out.add(0x80 | ((c >> 12) & 0x3F));
                out.add(0x80 | ((c >> 6) & 0x3F));
                out.add(0x80 | (c & 0x3F));
            }
        }
        byte[] b = new byte[out.size()];
        for (int i = 0; i < b.length; i++)
            b[i] = (byte) (int) out.get(i);
        return b;
    }

    public java.util.stream.IntStream chars() {
        int n = length();
        int[] a = new int[n];
        for (int i = 0; i < n; i++)
            a[i] = charAt(i);
        return java.util.Arrays.stream(a);
    }

    public java.util.stream.Stream<String> lines() {
        java.util.ArrayList<String> out = new java.util.ArrayList<>();
        int start = 0, n = length();
        for (int i = 0; i < n; i++) {
            char c = charAt(i);
            if (c == '\n' || c == '\r') {
                out.add(substring(start, i));
                if (c == '\r' && i + 1 < n && charAt(i + 1) == '\n')
                    i++;
                start = i + 1;
            }
        }
        if (start < n)
            out.add(substring(start));
        return out.stream();
    }

    public String indent(int n) {
        if (isEmpty())
            return "";
        StringBuilder sb = new StringBuilder();
        for (String line : lines().toList()) {
            if (n > 0)
                sb.append(" ".repeat(n)).append(line);
            else if (n < 0) {
                int k = 0;
                while (k < -n && k < line.length() && Character.isWhitespace(line.charAt(k)))
                    k++;
                sb.append(line.substring(k));
            } else
                sb.append(line);
            sb.append('\n');
        }
        return sb.toString();
    }

    public static String valueOf(Object obj) { return obj == null ? "null" : obj.toString(); }
    public static String valueOf(char[] data) { return new String(data); }
    public static String valueOf(char[] data, int offset, int count) { return new String(data, offset, count); }
    public static String copyValueOf(char[] data) { return new String(data); }
    public static String copyValueOf(char[] data, int offset, int count) { return new String(data, offset, count); }
    public static String valueOf(boolean b) { return b ? "true" : "false"; }
    public static String valueOf(char c) { return "" + c; }
    public static String valueOf(int i) { return "" + i; }
    public static String valueOf(long l) { return "" + l; }
    public static String valueOf(float f) { return "" + f; }
    public static String valueOf(double d) { return "" + d; }

    public static String join(CharSequence delimiter, CharSequence... elements) {
        StringBuilder sb = new StringBuilder();
        String d = delimiter.toString();
        for (int i = 0; i < elements.length; i++) {
            if (i > 0)
                sb.append(d);
            sb.append(String.valueOf(elements[i]));
        }
        return sb.toString();
    }

    public static String join(CharSequence delimiter, Iterable<? extends CharSequence> elements) {
        StringBuilder sb = new StringBuilder();
        String d = delimiter.toString();
        boolean first = true;
        for (CharSequence cs : elements) {
            if (!first)
                sb.append(d);
            sb.append(String.valueOf(cs));
            first = false;
        }
        return sb.toString();
    }

    public static String format(String format, Object... args) { return $format(format, args); }
    public static String format(java.util.Locale l, String format, Object... args) { return $format(format, args); }
    public String formatted(Object... args) { return $format(this, args); }
    private static native String $format(String format, Object[] args);
}

public final class StringBuilder implements CharSequence, Comparable<StringBuilder>, java.io.Serializable {
    private String $s = "";   // the text: read and written by the natives

    public StringBuilder() {}

    public StringBuilder(int capacity) {
        if (capacity < 0)
            throw new NegativeArraySizeException(String.valueOf(capacity));
    }

    public StringBuilder(String str) { $s = str.toString(); }
    public StringBuilder(CharSequence seq) { $s = seq.toString(); }

    public native StringBuilder append(String str);
    public StringBuilder append(Object obj) { return append(String.valueOf(obj)); }
    public StringBuilder append(StringBuilder sb) { return append(String.valueOf(sb)); }
    public StringBuilder append(StringBuffer sb) { return append(String.valueOf(sb)); }
    public StringBuilder append(CharSequence s) { return append(String.valueOf(s)); }
    public StringBuilder append(CharSequence s, int start, int end) {
        return append((s == null ? "null" : s).subSequence(start, end).toString());
    }
    public StringBuilder append(char[] str) { return append(new String(str)); }
    public StringBuilder append(char[] str, int offset, int len) { return append(new String(str, offset, len)); }
    public StringBuilder append(boolean b) { return append(String.valueOf(b)); }
    public StringBuilder append(char c) { return append(String.valueOf(c)); }
    public StringBuilder append(int i) { return append(String.valueOf(i)); }
    public StringBuilder append(long lng) { return append(String.valueOf(lng)); }
    public StringBuilder append(float f) { return append(String.valueOf(f)); }
    public StringBuilder append(double d) { return append(String.valueOf(d)); }
    public StringBuilder appendCodePoint(int codePoint) { return append(Character.toString(codePoint)); }

    public native int length();
    public native char charAt(int index);
    public native String toString();
    public native StringBuilder reverse();
    public native StringBuilder insert(int offset, String str);
    public StringBuilder insert(int offset, Object obj) { return insert(offset, String.valueOf(obj)); }
    public StringBuilder insert(int offset, char[] str) { return insert(offset, new String(str)); }
    public StringBuilder insert(int offset, CharSequence s) { return insert(offset, String.valueOf(s)); }
    public StringBuilder insert(int offset, boolean b) { return insert(offset, String.valueOf(b)); }
    public StringBuilder insert(int offset, char c) { return insert(offset, String.valueOf(c)); }
    public StringBuilder insert(int offset, int i) { return insert(offset, String.valueOf(i)); }
    public StringBuilder insert(int offset, long l) { return insert(offset, String.valueOf(l)); }
    public StringBuilder insert(int offset, float f) { return insert(offset, String.valueOf(f)); }
    public StringBuilder insert(int offset, double d) { return insert(offset, String.valueOf(d)); }
    public native StringBuilder delete(int start, int end);
    public native StringBuilder deleteCharAt(int index);
    public native void setCharAt(int index, char ch);
    public native void setLength(int newLength);
    public native StringBuilder replace(int start, int end, String str);

    public int indexOf(String str) { return toString().indexOf(str); }
    public int indexOf(String str, int fromIndex) { return toString().indexOf(str, fromIndex); }
    public int lastIndexOf(String str) { return toString().lastIndexOf(str); }
    public int lastIndexOf(String str, int fromIndex) { return toString().lastIndexOf(str, fromIndex); }
    public String substring(int start) { return toString().substring(start); }
    public String substring(int start, int end) { return toString().substring(start, end); }
    public CharSequence subSequence(int start, int end) { return substring(start, end); }
    public boolean isEmpty() { return length() == 0; }
    public int capacity() { return Math.max(16, length()); }
    public void ensureCapacity(int minimumCapacity) {}
    public void trimToSize() {}
    public int compareTo(StringBuilder another) { return toString().compareTo(another.toString()); }
    public java.util.stream.IntStream chars() { return toString().chars(); }

    public void getChars(int srcBegin, int srcEnd, char[] dst, int dstBegin) {
        for (int i = srcBegin; i < srcEnd; i++)
            dst[dstBegin + i - srcBegin] = charAt(i);
    }
}

