    try:
        return len(obj)
    except TypeError:
        pass
    hint = getattr(type(obj), "__length_hint__", None)
    if hint is None:
        return default
    val = hint(obj)
    return default if val is NotImplemented else val


def call(obj, /, *args, **kwargs): return obj(*args, **kwargs)


