    if typing is not None and (_is_classvar(a_type, typing) or _is_type(a_type, "ClassVar") or _is_type(a_type, "typing.ClassVar")):
        f._field_type = _FIELD_CLASSVAR
    if isinstance(a_type, InitVar) or a_type is InitVar or _is_type(a_type, "InitVar"):
        f._field_type = _FIELD_INITVAR
    if f._field_type in (_FIELD_CLASSVAR, _FIELD_INITVAR):
        if f.default_factory is not MISSING:
