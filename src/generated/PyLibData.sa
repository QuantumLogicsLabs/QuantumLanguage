    if eq and frozen:
        return _hash_fn(fields, globals)
    if eq and not frozen:
        if has_explicit_hash:
            return "keep"
        return None
    return "keep"


def _process_class(cls, init, repr, eq, order, unsafe_hash, frozen, match_args, kw_only, slots, weakref_slot):
    fields = {}
    import sys
