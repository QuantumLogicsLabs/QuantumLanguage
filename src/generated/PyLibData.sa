    for order, it in enumerate(map(iter, iterables)):
        try:
            value = next(it)
        except StopIteration:
            continue
        h.append([key(value), order * direction, value, it])
    _heapify(h)
    while len(h) > 1:
        try:
            while True:
                s = h[0]
