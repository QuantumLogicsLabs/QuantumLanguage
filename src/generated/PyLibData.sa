    # ── rounding ──

    def _fix(self, context):
        if self._is_special:
            return self
        Etiny = context.Etiny()
        Etop = context.Etop()
        if self._int == "0":
            exp_max = [context.Emax, Etop][context.clamp]
            new_exp = min(max(self._exp, Etiny), exp_max)
            if new_exp != self._exp:
                return _dec(self._sign, "0", new_exp)
            return self
        exp_min = len(self._int) + self._exp - context.prec
        if exp_min > Etop:
            context._raise_error(Overflow, "above Emax")
            return _dec(self._sign, "", "F", True)
        self_is_subnormal = exp_min < Etiny
        if self_is_subnormal:
            exp_min = Etiny
        if self._exp < exp_min:
            digits = len(self._int) + self._exp - exp_min
            if digits < 0:
                self = _dec(self._sign, "1", exp_min - 1)
                digits = 0
            changed = _rounders[context.rounding](self, digits)
            coeff = self._int[:digits] or "0"
            if changed > 0:
                coeff = str(int(coeff) + 1)
                if len(coeff) > context.prec:
                    coeff = coeff[:-1]
                    exp_min += 1
            if exp_min > Etop:
                context._raise_error(Overflow, "above Emax")
                return _dec(self._sign, "", "F", True)
            if changed:
                context.flags[Inexact] = True
                context.flags[Rounded] = True
                if context.traps.get(Inexact):
