class Context:
    def __init__(self, prec=None, rounding=None, Emin=None, Emax=None, capitals=None, clamp=None, flags=None,
                 traps=None):
        dc = DefaultContext if "DefaultContext" in globals() else None
        self.prec = prec if prec is not None else (dc.prec if dc else 28)
        self.rounding = rounding if rounding is not None else (dc.rounding if dc else ROUND_HALF_EVEN)
        self.Emin = Emin if Emin is not None else (dc.Emin if dc else -999999)
        self.Emax = Emax if Emax is not None else (dc.Emax if dc else 999999)
        self.capitals = capitals if capitals is not None else 1
        self.clamp = clamp if clamp is not None else 0
        self.traps = dict(traps) if isinstance(traps, dict) else {InvalidOperation: True, DivisionByZero: True, Overflow: True}
        self.flags = {}

    def copy(self):
        c = Context(self.prec, self.rounding, self.Emin, self.Emax, self.capitals, self.clamp, None, self.traps)
        return c

    __copy__ = copy

    def __repr__(self):
        traps = [t.__name__ for t, v in self.traps.items() if v]
        flags = [t.__name__ for t, v in self.flags.items() if v]
        return ("Context(prec=%d, rounding=%s, Emin=%d, Emax=%d, capitals=%d, clamp=%d, flags=[%s], traps=[%s])"
                % (self.prec, self.rounding, self.Emin, self.Emax, self.capitals, self.clamp, ", ".join(flags),
                   ", ".join(traps)))

    def Etiny(self):
        return self.Emin - self.prec + 1

    def Etop(self):
        return self.Emax - self.prec + 1

    def _raise_error(self, condition, explanation=None):
        self.flags[condition] = True
        if self.traps.get(condition) or any(self.traps.get(b) for b in condition.__mro__ if b is not condition and isinstance(b, type) and issubclass(b, DecimalException)):
            raise condition([condition]) if explanation is None else condition(explanation)
        if condition in (InvalidOperation, ConversionSyntax, DivisionUndefined, DivisionImpossible):
            return _NaN
        return None

    def create_decimal(self, num="0"):
        return Decimal(num)._fix(self)

    def create_decimal_from_float(self, f):
        return Decimal.from_float(f)._fix(self)

    def clear_flags(self):
        self.flags = {}

    def clear_traps(self):
        self.traps = {}

    def add(self, a, b):
        return _convert(a).__add__(b, context=self)

    def subtract(self, a, b):
        return _convert(a).__sub__(b, context=self)

    def multiply(self, a, b):
        return _convert(a).__mul__(b, context=self)

    def divide(self, a, b):
        return _convert(a).__truediv__(b, context=self)

    def sqrt(self, a):
        return _convert(a).sqrt(context=self)

    def power(self, a, b, modulo=None):
        return _convert(a).__pow__(b, modulo, context=self)

    def quantize(self, a, b):
        return _convert(a).quantize(b, context=self)

    def to_sci_string(self, a):
        return str(_convert(a))


_current_context = None


def getcontext():
    global _current_context
    if _current_context is None:
        _current_context = DefaultContext.copy()
    return _current_context


def setcontext(context):
    global _current_context
    if context in (DefaultContext, BasicContext, ExtendedContext):
        context = context.copy()
        context.clear_flags()
    _current_context = context


class _ContextManager:
    def __init__(self, new_context):
        self.new_context = new_context.copy()

    def __enter__(self):
        self.saved_context = getcontext()
        setcontext(self.new_context)
        return self.new_context

    def __exit__(self, t, v, tb):
        setcontext(self.saved_context)


def localcontext(ctx=None, **kwargs):
    if ctx is None:
        ctx = getcontext()
    manager = _ContextManager(ctx)
    for key, value in kwargs.items():
        if key not in ("prec", "rounding", "Emin", "Emax", "capitals", "clamp", "flags", "traps"):
            raise TypeError(f"'{key}' is an invalid keyword argument for this function")
        setattr(manager.new_context, key, value)
    return manager


def _convert(other, raiseit=True, allow_float=False):
    if isinstance(other, Decimal):
        return other
    if isinstance(other, int):
        return Decimal(other)
    if allow_float and isinstance(other, float):
        return Decimal.from_float(other)
    if raiseit:
        raise TypeError("Unable to convert %s to Decimal" % other)
    return NotImplemented


def _dec(sign, coefficient, exponent, special=False):
    self = object.__new__(Decimal)
    self._sign = sign
    self._int = coefficient
    self._exp = exponent
    self._is_special = special
    return self


class Decimal:
    __slots__ = ("_exp", "_int", "_sign", "_is_special")

    def __new__(cls, value="0", context=None):
        self = object.__new__(cls)
        if isinstance(value, str):
            s = value.strip().replace("_", "")
            m = _parse(s)
            if m is None:
                if context is None:
                    context = getcontext()
                if context.traps.get(InvalidOperation, True):
                    raise InvalidOperation([ConversionSyntax])
                return _NaN
            sign, intpart, fracpart, exp, special = m
            self._sign = sign
            if special:
                self._is_special = True
                self._int = ""
                self._exp = special
                return self
            self._int = str(int((intpart + fracpart) or "0"))
            self._exp = exp - len(fracpart)
            self._is_special = False
            return self
        if isinstance(value, int):
            self._sign = 1 if value < 0 else 0
            self._int = str(abs(value))
            self._exp = 0
            self._is_special = False
            return self
        if isinstance(value, Decimal):
            self._sign = value._sign
            self._int = value._int
            self._exp = value._exp
            self._is_special = value._is_special
            return self
        if isinstance(value, float):
            d = Decimal.from_float(value)
            self._sign, self._int, self._exp, self._is_special = d._sign, d._int, d._exp, d._is_special
            return self
        if isinstance(value, (list, tuple)):
            sign, digits, exp = value
            self._sign = sign
            if exp == "F":
                self._int = ""
                self._exp = "F"
                self._is_special = True
            elif exp in ("n", "N"):
                self._int = "".join(map(str, digits))
                self._exp = exp
                self._is_special = True
            else:
                self._int = str(int("".join(map(str, digits)) or "0"))
                self._exp = exp
                self._is_special = False
            return self
