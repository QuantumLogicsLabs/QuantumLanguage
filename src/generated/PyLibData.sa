class iinfo:
    def __init__(self, int_type):
        dt = _dtype_of(int_type) if not isinstance(int_type, (ndarray, generic)) else int_type.dtype
        if dt.kind not in "iub":
            raise ValueError(f"Invalid integer data type '{dt.kind}'.")
        self.dtype = dt
        self.kind = dt.kind
        self.bits = dt.itemsize * 8
        self.min, self.max = _INT_RANGE[dt.name] if dt.kind != "b" else (0, 1)

    def __repr__(self):
        return f"iinfo(min={self.min}, max={self.max}, dtype={self.dtype.name})"

    def __str__(self):
        line = "-" * 63
        return (f"Machine parameters for {self.dtype.name}\n{line}\nmin = {self.min}\nmax = {self.max}\n{line}\n")


