def fix(x, out=None):
    return trunc(x, out=out) if out is not None else trunc(x)


def divmod_(x1, x2):
    return floor_divide(x1, x2), remainder(x1, x2)


divmod = divmod_
_UFUNCS["divmod"] = divmod_


def around(a, decimals=0, out=None):
    """np.round: scale, round half to even, scale back (NumPy's algorithm)."""
    arr, k = _as_operand(a)
    dt = arr.dtype
    decimals = _bi.int(decimals)
    vals = arr._values()
    if dt.kind in "iub":
        if decimals >= 0:
            res_vals = list(vals)
        else:
            f = 10 ** (-decimals)
            res_vals = []
            for v in vals:
                q, r = _bi.divmod(_bi.int(v), f)
                if 2 * r > f or (2 * r == f and q % 2 == 1):
                    q += 1
                res_vals.append(q * f)
        rdt = _int64_dt if dt.kind == "b" else dt
    else:
        res_vals = []
        if decimals >= 0:
            f = 10.0 ** decimals
            for v in vals:
                if v != v or v in (inf, -inf):
                    res_vals.append(v)
                    continue
                y = v * f
                r = _rint(y) / f
                res_vals.append(r)
        else:
            f = 10.0 ** (-decimals)
            for v in vals:
                if v != v or v in (inf, -inf):
                    res_vals.append(v)
                    continue
                res_vals.append(_rint(v / f) * f)
        rdt = dt
        fixer = _wrapper_for(rdt)
        if fixer:
            res_vals = [fixer(v) for v in res_vals]
    if out is not None:
        _assign(out, _make(res_vals, arr.shape, rdt))
        return out
    if not isinstance(a, ndarray):
        return _scalar(res_vals[0], rdt)
    return _make(res_vals, arr.shape, rdt)


round = around
round_ = around


def clip(a, a_min=None, a_max=None, out=None, *, min=None, max=None, **kw):
    if min is not None:
        a_min = min
    if max is not None:
        a_max = max
    r = a
    if a_min is not None:
        r = maximum(r, a_min)
    if a_max is not None:
        r = minimum(r, a_max)
    if out is not None:
        _assign(out, asarray(r))
        return out
    return r


def nan_to_num(x, copy=True, nan=0.0, posinf=None, neginf=None):
    a = asarray(x)
    if a.dtype.kind != "f":
        return a.copy() if isinstance(x, ndarray) else x
    big = 1.7976931348623157e308 if a.dtype.itemsize == 8 else 3.4028234663852886e38
    pi_ = big if posinf is None else posinf
    ni_ = -big if neginf is None else neginf
    vals = [nan if False else (nan_val if v != v else pi_ if v == inf else ni_ if v == -inf else v) for v in a._values() for nan_val in (nan,)]
    r = _make(vals, a.shape, a.dtype)
    if not copy and isinstance(x, ndarray):
        x[...] = r
        return x
    if not isinstance(x, ndarray):
        return _scalar(vals[0], a.dtype)
    return r


def real_if_close(a, tol=100):
    return asarray(a)


def isclose(a, b, rtol=1e-05, atol=1e-08, equal_nan=False):
    a2 = asarray(a)
    b2 = asarray(b)
    shape = _broadcast_shapes(a2.shape, b2.shape)
    av = _bvalues(a2, shape)
    bv = _bvalues(b2, shape)
    out = []
    for x, y in zip(av, bv):
        x = _bi.float(x)
        y = _bi.float(y)
        if x != x or y != y:
            out.append(equal_nan and x != x and y != y)
        elif x in (inf, -inf) or y in (inf, -inf):
            out.append(x == y)
        else:
            out.append(_bi.abs(x - y) <= atol + rtol * _bi.abs(y))
    if shape == () and not isinstance(a, ndarray) and not isinstance(b, ndarray):
        return bool_(out[0])
    return _make(out, shape, _bool_dt)


def allclose(a, b, rtol=1e-05, atol=1e-08, equal_nan=False):
    return _bi.bool(isclose(a, b, rtol, atol, equal_nan).all() if isinstance(isclose(a, b, rtol, atol, equal_nan), ndarray) else isclose(a, b, rtol, atol, equal_nan))


def array_equal(a1, a2, equal_nan=False):
    try:
        a = asarray(a1)
        b = asarray(a2)
    except Exception:
        return False
    if a.shape != b.shape:
        return False
    av = a._values()
    bv = b._values()
    for x, y in zip(av, bv):
        if x == y:
            continue
        if equal_nan and x != x and y != y:
            continue
        return False
    return True


def array_equiv(a1, a2):
    try:
        a = asarray(a1)
        b = asarray(a2)
        shape = _broadcast_shapes(a.shape, b.shape)
    except Exception:
        return False
    return _bvalues(a, shape) == _bvalues(b, shape)


# ═══════════════════════════════ assignment ═══════════════════════════════════

def _assign(dst, src):
    """dst[...] = src with broadcasting and casting."""
    if not dst._writeable:
        raise ValueError("assignment destination is read-only")
    src = asarray(src) if not isinstance(src, ndarray) else src
    vals = _bvalues(src, dst._shape)
    conv = _caster(dst._dtype)
    if src._dtype.kind == "f" and dst._dtype.kind in "iu":
        vals = [conv(_math.trunc(v)) if v == v and v not in (inf, -inf) else _INT_RANGE[dst._dtype.name][0] for v in vals]
    elif src._dtype is not dst._dtype:
        vals = [conv(v) for v in vals]
    buf = dst._buf
    for i, v in zip(dst._indices(), vals):
        buf[i] = v


# ═══════════════════════════════ indexing ═════════════════════════════════════

def _is_int_index(k):
    return isinstance(k, (_bi.int, integer)) and not isinstance(k, (_bi.bool, bool_))


def _expand_key(a, key):
    if not isinstance(key, tuple):
        key = (key,)
    # lists of ints and arrays are advanced indices
    out = []
    for k in key:
        if isinstance(k, list):
            k = array(k) if k else array([], dtype=int64)
        elif isinstance(k, (bool_, _bi.bool)):
            k = array(_bi.bool(k))
        out.append(k)
    key = out
    n_ell = _bi.sum(1 for k in key if k is Ellipsis)
    if n_ell > 1:
        raise IndexError("an index can only have a single ellipsis ('...')")
    used = _bi.sum(k.ndim if isinstance(k, ndarray) and k.dtype.kind == "b" else 1 for k in key if k is not None and k is not Ellipsis)
    if used > a.ndim:
        raise IndexError(f"too many indices for array: array is {a.ndim}-dimensional, but {used} were indexed")
    if n_ell:
        i = [j for j, x in enumerate(key) if x is Ellipsis][0]
        key = key[:i] + [slice(None)] * (a.ndim - used) + key[i + 1:]
    else:
        key = key + [slice(None)] * (a.ndim - used)
    return key


def _basic_index(a, key):
    """A view for an index of ints, slices and None; key is expanded."""
    off = a._off
    shape = []
    strides = []
    dim = 0
    for k in key:
        if k is None:
            shape.append(1)
            strides.append(0)
            continue
        n = a._shape[dim]
        st = a._strides[dim]
        if isinstance(k, slice):
            start, stop, step = k.indices(n)
            cnt = len(range(start, stop, step))
            off += start * st
            shape.append(cnt)
            strides.append(st * step)
        else:
            i = _bi.int(k)
            if i < -n or i >= n:
                raise IndexError(f"index {k} is out of bounds for axis {dim} with size {n}")
            if i < 0:
                i += n
            off += i * st
        dim += 1
    return _view_of(a, off, tuple(shape), tuple(strides))


def _getitem(a, key):
    if isinstance(key, (_bi.int, integer)) and not isinstance(key, (_bi.bool, bool_)) and a.ndim >= 1:
        n = a._shape[0]
        i = _bi.int(key)
        if i < -n or i >= n:
            raise IndexError(f"index {key} is out of bounds for axis 0 with size {n}")
        if i < 0:
            i += n
        if a.ndim == 1:
            return _scalar(a._buf[a._off + i * a._strides[0]], a._dtype)
        return _view_of(a, a._off + i * a._strides[0], a._shape[1:], a._strides[1:])
    if isinstance(key, tuple) and len(key) == a.ndim and _bi.all(_is_int_index(k) for k in key):
        off = a._off
        for d, k in enumerate(key):
            n = a._shape[d]
            i = _bi.int(k)
            if i < -n or i >= n:
                raise IndexError(f"index {k} is out of bounds for axis {d} with size {n}")
            if i < 0:
                i += n
            off += i * a._strides[d]
        return _scalar(a._buf[off], a._dtype)
    if isinstance(key, tuple) and len(key) == 0 and a.ndim == 0:
        return _scalar(a._buf[a._off], a._dtype)
    k = _expand_key(a, key)
    if not _bi.any(isinstance(x, ndarray) for x in k):
        v = _basic_index(a, k)
        if v.ndim == 0 and not _bi.any(x is None for x in k) and not (isinstance(key, tuple) and _bi.any(x is Ellipsis for x in key)) and key is not Ellipsis:
            return _scalar(v._buf[v._off], v._dtype)
        return v
    return _advanced(a, k)


def _advanced_plan(a, key):
    """(result shape, list of buffer positions) for an advanced index."""
    # boolean arrays become their nonzero coordinates
    k2 = []
    for x in key:
        if isinstance(x, ndarray) and x.dtype.kind == "b":
            if x.ndim == 0:
                k2.append(x)
                continue
            nz = nonzero(x)
            k2.extend(nz)
        else:
            k2.append(x)
    key = k2
    # first apply the basic parts, keeping advanced axes
    adv_pos = [i for i, x in enumerate(key) if isinstance(x, ndarray)]
    arrs = [key[i] for i in adv_pos]
    for x in arrs:
        if x.dtype.kind not in "iub":
            raise IndexError("arrays used as indices must be of integer (or boolean) type")
    bshape = _broadcast_shapes(*[x.shape for x in arrs])
    idx_vals = [_bvalues(x, bshape) for x in arrs]
    # dims of a for each key element
    dims = []
    d = 0
    for x in key:
        if x is None:
            dims.append(None)
        else:
            dims.append(d)
            d += 1
    contiguous = adv_pos == list(range(adv_pos[0], adv_pos[-1] + 1))
    # build the other (basic) axes
    basic = []  # (kind, info) in key order for non-advanced items
    for i, x in enumerate(key):
        if i in adv_pos:
            continue
        if x is None:
            basic.append((i, "new", None))
        elif isinstance(x, slice):
            n = a._shape[dims[i]]
            basic.append((i, "slice", list(range(*x.indices(n)))))
        else:
            n = a._shape[dims[i]]
            j = _bi.int(x)
            if j < -n or j >= n:
                raise IndexError(f"index {x} is out of bounds for axis {dims[i]} with size {n}")
            basic.append((i, "int", j + n if j < 0 else j))
    # result axes
    before = [b for b in basic if b[0] < adv_pos[0] and b[1] != "int"]
    after = [b for b in basic if b[0] > adv_pos[0] and b[1] != "int"]
    if contiguous:
        axes_order = before + [("adv",)] + after
    else:
        axes_order = [("adv",)] + [b for b in basic if b[1] != "int"]
    out_shape = []
    for ax in axes_order:
        if ax[0] == "adv":
            out_shape.extend(bshape)
        elif ax[1] == "new":
            out_shape.append(1)
        else:
            out_shape.append(len(ax[2]))
    # positions
    nb = _prod(bshape)
    positions = []
    ranges = []
    for ax in axes_order:
        if ax[0] == "adv":
            ranges.append(("adv", range(nb)))
        elif ax[1] == "new":
            ranges.append(("new", [0]))
        else:
            ranges.append((ax[0], ax[2]))
    fixed_off = a._off
    for b in basic:
        if b[1] == "int":
            fixed_off += b[2] * a._strides[dims[b[0]]]
    combos = [fixed_off]
    for kind, rng in ranges:
        if kind == "adv":
            offs = []
            for t in range(nb):
                o = 0
                for p, vals in zip(adv_pos, idx_vals):
                    n = a._shape[dims[p]]
                    j = _bi.int(vals[t])
                    if j < -n or j >= n:
                        raise IndexError(f"index {j} is out of bounds for axis {dims[p]} with size {n}")
                    if j < 0:
                        j += n
                    o += j * a._strides[dims[p]]
                offs.append(o)
            combos = [c + o for c in combos for o in offs]
        elif kind == "new":
            pass
        else:
            st = a._strides[dims[kind]]
            combos = [c + j * st for c in combos for j in rng]
    return tuple(out_shape), combos


def _advanced(a, key):
    if len(key) == 1 and isinstance(key[0], ndarray) and key[0].dtype.kind == "b" and key[0].shape == a.shape:
        # mask indexing: the selected elements in order
        m = key[0]._values()
        idx = a._indices()
        vals = [a._buf[i] for i, keep in zip(idx, m) if keep]
        return _make(vals, (len(vals),), a._dtype)
    shape, positions = _advanced_plan(a, key)
    buf = a._buf
    return _make([buf[p] for p in positions], shape, a._dtype)


def _setitem(a, key, value):
    if not a._writeable:
        raise ValueError("assignment destination is read-only")
    conv = _caster(a._dtype)
    if isinstance(key, (_bi.int, integer)) and not isinstance(key, (_bi.bool, bool_)) and a.ndim == 1 and not isinstance(value, (ndarray, list, tuple)):
        n = a._shape[0]
        i = _bi.int(key)
        if i < -n or i >= n:
            raise IndexError(f"index {key} is out of bounds for axis 0 with size {n}")
        if i < 0:
            i += n
        v = _py(value)
        if a._dtype.kind in "iu" and isinstance(v, _bi.float):
            if v != v:
                raise ValueError("cannot convert float NaN to integer")
            v = _math.trunc(v)
        a._buf[a._off + i * a._strides[0]] = conv(v)
        return
    k = _expand_key(a, key)
    if not _bi.any(isinstance(x, ndarray) for x in k):
        view = _basic_index(a, k)
        _assign(view, value)
        return
    if len(k) == 1 and isinstance(k[0], ndarray) and k[0].dtype.kind == "b" and k[0].shape == a.shape:
        m = k[0]._values()
        idx = [i for i, keep in zip(a._indices(), m) if keep]
        src = asarray(value)
        if src.size == 1:
            vals = [src._values()[0]] * len(idx)
        else:
            if src.size != len(idx):
                raise ValueError(f"NumPy boolean array indexing assignment cannot assign {src.size} input values to the {len(idx)} output values where the mask is true")
            vals = src.ravel()._values()
        if src.dtype.kind == "f" and a._dtype.kind in "iu":
            vals = [_math.trunc(v) for v in vals]
        for i, v in zip(idx, vals):
            a._buf[i] = conv(v)
        return
    shape, positions = _advanced_plan(a, k)
    src = asarray(value)
    vals = _bvalues(src, shape)
    if src.dtype.kind == "f" and a._dtype.kind in "iu":
        vals = [_math.trunc(v) for v in vals]
    for p, v in zip(positions, vals):
        a._buf[p] = conv(v)


def ndindex(*shape):
    if len(shape) == 1 and isinstance(shape[0], tuple):
        shape = shape[0]
    idx = [()]
    for d in shape:
        idx = [i + (k,) for i in idx for k in range(d)]
    return iter(idx)


def ndenumerate(a):
    a = asarray(a)
    for idx, v in zip(ndindex(*a.shape), a._values()):
        yield idx, _scalar(v, a.dtype)


# the printing engine, reductions, and the rest of the library live in
# _numpy_part2 (which sees this module's names); its names join these
import _numpy_part2 as _part2
globals().update({_k: _v for _k, _v in vars(_part2).items() if not _k.startswith("__") and _k not in globals()})
import numpy.linalg as linalg
)QPYLIB"},
        {"numpy_linalg.sa", R"QPYLIB("""numpy.linalg: LU-based det/inv/solve the way NumPy's LAPACK calls do them."""

import math as _math
import builtins as _bi
import numpy as _np


class LinAlgError(ValueError):
    pass


LinAlgError.__module__ = "numpy.linalg"


def _as_float_matrix(a, name="array"):
    a = _np.asarray(a)
    if a.ndim < 2:
        raise LinAlgError(f"{a.ndim}-dimensional array given. Array must be at least two-dimensional")
    if a.shape[-1] != a.shape[-2]:
        raise LinAlgError("Last 2 dimensions of the array must be square")
    return a


def _lu(rows):
    """In-place LU with partial pivoting (dgetrf): (rows, perm, sign, singular)."""
    n = len(rows)
    perm = list(range(n))
    sign = 1.0
    singular = False
    for k in range(n):
        p = k
        best = _bi.abs(rows[k][k])
        for i in range(k + 1, n):
            v = _bi.abs(rows[i][k])
            if v > best:
                best = v
                p = i
        if p != k:
            rows[k], rows[p] = rows[p], rows[k]
            perm[k], perm[p] = perm[p], perm[k]
            sign = -sign
        piv = rows[k][k]
        if piv == 0:
            singular = True
            continue
        inv = 1.0 / piv
        rk = rows[k]
        for i in range(k + 1, n):
            ri = rows[i]
            f = ri[k] * inv
            ri[k] = f
            if f != 0:
                for j in range(k + 1, n):
                    ri[j] -= f * rk[j]
    return rows, perm, sign, singular


def _rows_of(m):
    n = m.shape[-1]
    vals = [_bi.float(v) for v in m._values()]
    return [vals[i * n:(i + 1) * n] for i in range(m.shape[-2])]


def _batched(a, fn):
    if a.ndim == 2:
        return fn(a)
    parts = [fn(a[idx]) for idx in _np.ndindex(*a.shape[:-2])]
    if isinstance(parts[0], _np.ndarray):
        return _np.stack(parts).reshape(a.shape[:-2] + parts[0].shape)
    return _np.array(parts).reshape(a.shape[:-2])


def det(a):
    a = _as_float_matrix(a)

    def one(m):
        rows, perm, sign, singular = _lu(_rows_of(m))
        n = len(rows)
        if singular:
            return _np.float64(0.0)
        logdet = 0.0
        s = sign
        for i in range(n):
            u = rows[i][i]
            if u < 0:
                s = -s
            logdet += _math.log(_bi.abs(u))
        return _np.float64(s * _math.exp(logdet))
    return _batched(a, one)


def slogdet(a):
    a = _as_float_matrix(a)
    rows, perm, sign, singular = _lu(_rows_of(a))
    from collections import namedtuple
    SR = namedtuple("SlogdetResult", ["sign", "logabsdet"])
    if singular:
        return SR(_np.float64(0.0), _np.float64(-_math.inf))
    logdet = 0.0
    s = sign
    for i in range(len(rows)):
        u = rows[i][i]
        if u < 0:
            s = -s
        logdet += _math.log(_bi.abs(u))
    return SR(_np.float64(s), _np.float64(logdet))


def _lu_solve(rows, perm, bcols):
    n = len(rows)
    out = []
    for b in bcols:
        x = [b[perm[i]] for i in range(n)]
        for i in range(n):
            s = x[i]
            ri = rows[i]
            for j in range(i):
                s -= ri[j] * x[j]
            x[i] = s
        for i in range(n - 1, -1, -1):
            s = x[i]
            ri = rows[i]
            for j in range(i + 1, n):
                s -= ri[j] * x[j]
            x[i] = s / ri[i]
        out.append(x)
    return out


def solve(a, b):
    a = _as_float_matrix(a)
    b = _np.asarray(b)
    rows, perm, sign, singular = _lu(_rows_of(a))
    if singular:
        raise LinAlgError("Singular matrix")
    n = len(rows)
    if b.ndim == 1:
        if b.shape[0] != n:
            raise ValueError(f"solve1: Input operand 1 has a mismatch in its core dimension 0, with gufunc signature (m,m),(m)->(m) (size {b.shape[0]} is different from {n})")
        x = _lu_solve(rows, perm, [[_bi.float(v) for v in b._values()]])[0]
        return _np.array(x)
    if b.shape[0] != n:
        raise ValueError(f"solve: Input operand 1 has a mismatch in its core dimension 0, with gufunc signature (m,m),(m,n)->(m,n) (size {b.shape[0]} is different from {n})")
    bt = b.T
    cols = [[_bi.float(v) for v in bt[j]._values()] for j in range(b.shape[1])]
    xs = _lu_solve(rows, perm, cols)
    return _np.array(xs).T.copy()


def inv(a):
    a = _as_float_matrix(a)

    def one(m):
        rows, perm, sign, singular = _lu(_rows_of(m))
        if singular:
            raise LinAlgError("Singular matrix")
        n = len(rows)
