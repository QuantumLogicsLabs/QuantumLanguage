    return True


def may_share_memory(a, b, max_work=None):
    return isinstance(a, ndarray) and isinstance(b, ndarray) and a._buf is b._buf


def shares_memory(a, b, max_work=None):
    if not (isinstance(a, ndarray) and isinstance(b, ndarray)) or a._buf is not b._buf:
        return False
    return bool(set(a._indices()) & set(b._indices()))


