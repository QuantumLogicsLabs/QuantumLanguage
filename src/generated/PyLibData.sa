            return _dec(self._sign, coeff, exp_min)
        if context.clamp == 1 and self._exp > Etop:
            self_padded = self._int + "0" * (self._exp - Etop)
            return _dec(self._sign, self_padded, Etop)
        return self

    def _rescale(self, exp, rounding):
        if self._is_special:
            return self
        if self._int == "0":
            return _dec(self._sign, "0", exp)
        if self._exp >= exp:
            return _dec(self._sign, self._int + "0" * (self._exp - exp), exp)
        digits = len(self._int) + self._exp - exp
        if digits < 0:
            self = _dec(self._sign, "1", exp - 1)
            digits = 0
        this_function = _rounders[rounding]
        changed = this_function(self, digits)
        coeff = self._int[:digits] or "0"
        if changed == 1:
            coeff = str(int(coeff) + 1)
        return _dec(self._sign, coeff, exp)

    def quantize(self, exp, rounding=None, context=None):
        exp = _convert(exp, raiseit=True)
        if context is None:
            context = getcontext()
        if rounding is None:
            rounding = context.rounding
        if self._is_special or exp._is_special:
            if self._isinfinity() and exp._isinfinity():
                return Decimal(self)
            return context._raise_error(InvalidOperation, "quantize with one INF")
        if not (context.Etiny() <= exp._exp <= context.Emax):
            return context._raise_error(InvalidOperation, "target exponent out of bounds in quantize")
        if not self:
            ans = _dec(self._sign, "0", exp._exp)
            return ans._fix(context)
        self_adjusted = self.adjusted()
        if self_adjusted > context.Emax:
            return context._raise_error(InvalidOperation, "exponent of quantize result too large for current context")
        if self_adjusted - exp._exp + 1 > context.prec:
            return context._raise_error(InvalidOperation, "quantize result has too many digits for current context")
        ans = self._rescale(exp._exp, rounding)
        if ans.adjusted() > context.Emax:
            return context._raise_error(InvalidOperation, "exponent of quantize result too large for current context")
        if len(ans._int) > context.prec:
            return context._raise_error(InvalidOperation, "quantize result has too many digits for current context")
        return ans

    def same_quantum(self, other, context=None):
        other = _convert(other)
        return self._exp == other._exp

    def to_integral_value(self, rounding=None, context=None):
        if context is None:
            context = getcontext()
        if rounding is None:
            rounding = context.rounding
        if self._is_special or self._exp >= 0:
            return Decimal(self)
        return self._rescale(0, rounding)

    to_integral = to_integral_value

    def to_integral_exact(self, rounding=None, context=None):
        return self.to_integral_value(rounding, context)

    def normalize(self, context=None):
        if context is None:
            context = getcontext()
        if self._is_special:
            return self
        dup = self._fix(context)
        if dup._is_special:
            return dup
        if not dup:
            return _dec(dup._sign, "0", 0)
        exp_max = [context.Emax, context.Etop()][context.clamp]
        end = len(dup._int)
        exp = dup._exp
        while dup._int[end - 1] == "0" and exp < exp_max:
            exp += 1
            end -= 1
        return _dec(dup._sign, dup._int[:end], exp)

    def __round__(self, n=None):
        if n is not None:
            if not isinstance(n, int):
                raise TypeError("Second argument to round should be integral")
            exp = _dec(0, "1", -n)
            return self.quantize(exp)
        if self._is_special:
            if self.is_nan():
                raise ValueError("cannot round a NaN")
            raise OverflowError("cannot round an infinity")
        return int(self._rescale(0, ROUND_HALF_EVEN))

    def __floor__(self):
        if self._is_special:
            raise OverflowError("cannot round an infinity")
        return int(self._rescale(0, ROUND_FLOOR))

    def __ceil__(self):
        if self._is_special:
            raise OverflowError("cannot round an infinity")
        return int(self._rescale(0, ROUND_CEILING))

    # ── arithmetic ──

    def __neg__(self, context=None):
        if context is None:
            context = getcontext()
        if not self and context.rounding != ROUND_FLOOR:
            ans = self.copy_abs()
        else:
            ans = self.copy_negate()
        return ans._fix(context)

    def __pos__(self, context=None):
        if context is None:
            context = getcontext()
        if not self and context.rounding != ROUND_FLOOR:
            ans = self.copy_abs()
        else:
            ans = Decimal(self)
        return ans._fix(context)

    def __abs__(self, round=True, context=None):
        if not round:
            return self.copy_abs()
        if self._sign:
            return self.__neg__(context=context)
        return self.__pos__(context=context)

    def __add__(self, other, context=None):
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        if context is None:
            context = getcontext()
        if self._is_special or other._is_special:
            if self._isinfinity():
                if self._sign != other._sign and other._isinfinity():
                    return context._raise_error(InvalidOperation, "-INF + INF")
                return Decimal(self)
            if other._isinfinity():
                return Decimal(other)
            return _NaN
        exp = min(self._exp, other._exp)
        negativezero = 0
        if context.rounding == ROUND_FLOOR and self._sign != other._sign:
            negativezero = 1
        if not self and not other:
            sign = min(self._sign, other._sign)
            if negativezero:
                sign = 1
            return _dec(sign, "0", exp)._fix(context)
        if not self:
            exp = max(exp, other._exp - context.prec - 1)
            return other._rescale(exp, context.rounding)._fix(context)
        if not other:
            exp = max(exp, self._exp - context.prec - 1)
            return self._rescale(exp, context.rounding)._fix(context)
        a = int(self._int) * 10 ** (self._exp - exp)
        b = int(other._int) * 10 ** (other._exp - exp)
        if self._sign:
            a = -a
        if other._sign:
            b = -b
        total = a + b
        if total == 0:
            return _dec(negativezero, "0", exp)._fix(context)
        return _dec(1 if total < 0 else 0, str(abs(total)), exp)._fix(context)

    __radd__ = __add__

    def __sub__(self, other, context=None):
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        return self.__add__(other.copy_negate(), context=context)

    def __rsub__(self, other, context=None):
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        return other.__sub__(self, context=context)

    def __mul__(self, other, context=None):
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        if context is None:
            context = getcontext()
        resultsign = self._sign ^ other._sign
        if self._is_special or other._is_special:
            if self._isinfinity() or other._isinfinity():
                if not self or not other:
                    return context._raise_error(InvalidOperation, "(+-)INF * 0")
                return _dec(resultsign, "", "F", True)
            return _NaN
        resultexp = self._exp + other._exp
        if not self or not other:
            return _dec(resultsign, "0", resultexp)._fix(context)
        return _dec(resultsign, str(int(self._int) * int(other._int)), resultexp)._fix(context)

    __rmul__ = __mul__

    def __truediv__(self, other, context=None):
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        if context is None:
            context = getcontext()
        sign = self._sign ^ other._sign
        if self._is_special or other._is_special:
            if self._isinfinity() and other._isinfinity():
                return context._raise_error(InvalidOperation, "(+-)INF/(+-)INF")
            if self._isinfinity():
                return _dec(sign, "", "F", True)
            if other._isinfinity():
                return _dec(sign, "0", context.Etiny())
            return _NaN
        if not other:
            if not self:
                return context._raise_error(DivisionUndefined, "0 / 0")
            return context._raise_error(DivisionByZero, "x / 0")
        if not self:
            exp = self._exp - other._exp
            coeff = 0
        else:
            shift = len(other._int) - len(self._int) + context.prec + 1
            exp = self._exp - other._exp - shift
            if shift >= 0:
                coeff, remainder = divmod(int(self._int) * 10 ** shift, int(other._int))
            else:
                coeff, remainder = divmod(int(self._int), int(other._int) * 10 ** -shift)
            if remainder:
                if coeff % 5 == 0:
                    coeff += 1
            else:
                ideal_exp = self._exp - other._exp
                while exp < ideal_exp and coeff % 10 == 0:
                    coeff //= 10
                    exp += 1
        return _dec(sign, str(coeff), exp)._fix(context)

    def __rtruediv__(self, other, context=None):
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        return other.__truediv__(self, context=context)

    def _divide(self, other, context):
        sign = self._sign ^ other._sign
        if other._isinfinity():
            ideal_exp = self._exp
        else:
            ideal_exp = min(self._exp, other._exp)
        expdiff = self.adjusted() - other.adjusted()
        if not self or other._isinfinity() or expdiff <= -2:
            return (_dec(sign, "0", 0), self._rescale(ideal_exp, context.rounding))
        if expdiff <= context.prec:
            a = int(self._int)
            b = int(other._int)
            if self._exp >= other._exp:
                a *= 10 ** (self._exp - other._exp)
            else:
                b *= 10 ** (other._exp - self._exp)
            q, r = divmod(a, b)
            if q < 10 ** context.prec:
                return (_dec(sign, str(q), 0), _dec(self._sign, str(r), ideal_exp))
        ans = context._raise_error(DivisionImpossible, "quotient too large in //, % or divmod")
        return ans, ans

    def __divmod__(self, other, context=None):
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        if context is None:
            context = getcontext()
        if not other:
            if not self:
                return context._raise_error(DivisionUndefined, "divmod(0, 0)"), None
            return (context._raise_error(DivisionByZero, "x // 0"), context._raise_error(InvalidOperation, "x % 0"))
        quotient, remainder = self._divide(other, context)
        remainder = remainder._fix(context)
        return quotient, remainder

    def __rdivmod__(self, other, context=None):
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        return other.__divmod__(self, context=context)

    def __mod__(self, other, context=None):
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        if context is None:
            context = getcontext()
        if not other:
            if not self:
                return context._raise_error(DivisionUndefined, "0 % 0")
            return context._raise_error(InvalidOperation, "x % 0")
        remainder = self._divide(other, context)[1]
        return remainder._fix(context)

    def __rmod__(self, other, context=None):
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        return other.__mod__(self, context=context)

    def __floordiv__(self, other, context=None):
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        if context is None:
            context = getcontext()
        if not other:
            if not self:
                return context._raise_error(DivisionUndefined, "0 // 0")
            return context._raise_error(DivisionByZero, "x // 0")
        return self._divide(other, context)[0]

    def __rfloordiv__(self, other, context=None):
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        return other.__floordiv__(self, context=context)

    def __pow__(self, other, modulo=None, context=None):
        if context is None:
            context = getcontext()
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        if modulo is not None:
            m = int(_convert(modulo))
            return Decimal(pow(int(self), int(other), m))
        if not other:
            if not self:
                return context._raise_error(InvalidOperation, "0 ** 0")
            return Decimal(1)
        if other.is_integer():
            n = int(other)
            # exact power with guard digits, then round once
            extra = len(str(abs(n))) + 3
            ctx = context.copy()
            ctx.prec = context.prec + extra
            ctx.traps = {}
            result = Decimal(1)
            base = self
            k = abs(n)
            while k:
                if k & 1:
                    result = result.__mul__(base, context=ctx)
                base = base.__mul__(base, context=ctx)
                k >>= 1
            if n < 0:
                result = Decimal(1).__truediv__(result, context=ctx)
            return result._fix(context)
        # non-integral exponent: through floats with the context's precision
        if self._sign:
            return context._raise_error(InvalidOperation, "x ** y with x negative and y not an integer")
        return Decimal(repr(float(self) ** float(other)))._fix(context)

    def __rpow__(self, other, modulo=None, context=None):
        other = _convert(other, raiseit=False)
        if other is NotImplemented:
            return other
        return other.__pow__(self, modulo, context=context)

    def sqrt(self, context=None):
        if context is None:
            context = getcontext()
        if self._is_special:
            if self._isinfinity() and self._sign == 0:
                return Decimal(self)
            return _NaN
        if not self:
            ans = _dec(self._sign, "0", self._exp // 2)
            return ans._fix(context)
        if self._sign == 1:
            return context._raise_error(InvalidOperation, "sqrt(-x), x > 0")
        prec = context.prec + 1
        e = self._exp >> 1
        c = int(self._int)
        if self._exp & 1:
            l = (len(self._int) >> 1) + 1
            c *= 10
        else:
            l = len(self._int) + 1 >> 1
        shift = prec - l
        if shift >= 0:
            c *= 100 ** shift
            exact = True
        else:
            c, remainder = divmod(c, 100 ** -shift)
            exact = not remainder
        e -= shift
        n = 10 ** prec
        while True:
            q = c // n
            if n <= q:
                break
            else:
                n = n + q >> 1
        exact = exact and n * n == c
        if exact:
            if shift >= 0:
                n //= 10 ** shift
            else:
                n *= 10 ** -shift
            e += shift
        else:
            if n % 5 == 0:
                n += 1
        ans = _dec(0, str(n), e)
        ctx = context.copy()
        ctx.rounding = ROUND_HALF_EVEN
        ans = ans._fix(ctx)
        return ans

    def exp(self, context=None):
        if context is None:
            context = getcontext()
        return Decimal(repr(_math.exp(float(self))))._fix(context)

    def ln(self, context=None):
        if context is None:
            context = getcontext()
        return Decimal(repr(_math.log(float(self))))._fix(context)

    def log10(self, context=None):
        if context is None:
            context = getcontext()
        return Decimal(repr(_math.log10(float(self))))._fix(context)

    def fma(self, other, third, context=None):
        product = self.__mul__(other, context=Context(prec=MAX_PREC if False else 10 ** 6))
        return product.__add__(third, context=context)

    # ── comparison ──

    def _cmp(self, other):
        if self._is_special or other._is_special:
            self_inf = self._isinfinity()
            other_inf = other._isinfinity()
            if self_inf == other_inf:
                return 0
            elif self_inf < other_inf:
                return -1
            return 1
        if not self:
            if not other:
                return 0
            return -((-1) ** other._sign)
        if not other:
            return (-1) ** self._sign
        if other._sign < self._sign:
            return -1
        if self._sign < other._sign:
            return 1
        self_adjusted = self.adjusted()
        other_adjusted = other.adjusted()
        if self_adjusted == other_adjusted:
            self_padded = self._int + "0" * (self._exp - other._exp)
            other_padded = other._int + "0" * (other._exp - self._exp)
            if self_padded == other_padded:
                return 0
            elif self_padded < other_padded:
                return -((-1) ** self._sign)
            return (-1) ** self._sign
        elif self_adjusted > other_adjusted:
            return (-1) ** self._sign
        return -((-1) ** self._sign)

    def _compare_other(self, other):
        if isinstance(other, float):
            return Decimal.from_float(other)
        if isinstance(other, int):
            return Decimal(other)
        if isinstance(other, Decimal):
            return other
        try:
            from fractions import Fraction
        except ImportError:
            return NotImplemented
        if isinstance(other, Fraction):
            return other
        return NotImplemented

    def __eq__(self, other, context=None):
        o = self._compare_other(other)
        if o is NotImplemented:
            return o
        if not isinstance(o, Decimal):
            return self.as_integer_ratio() == (o.numerator, o.denominator)
        if self._isnan() or o._isnan():
            return False
        return self._cmp(o) == 0

    def __lt__(self, other, context=None):
        o = self._compare_other(other)
        if o is NotImplemented:
            return o
        if not isinstance(o, Decimal):
            n, d = self.as_integer_ratio()
            return n * o.denominator < o.numerator * d
        if self._isnan() or o._isnan():
            raise InvalidOperation([InvalidOperation])
        return self._cmp(o) < 0

    def __le__(self, other, context=None):
        o = self._compare_other(other)
        if o is NotImplemented:
            return o
        if not isinstance(o, Decimal):
            n, d = self.as_integer_ratio()
            return n * o.denominator <= o.numerator * d
        return self._cmp(o) <= 0

    def __gt__(self, other, context=None):
        o = self._compare_other(other)
        if o is NotImplemented:
            return o
        if not isinstance(o, Decimal):
            n, d = self.as_integer_ratio()
            return n * o.denominator > o.numerator * d
        return self._cmp(o) > 0

    def __ge__(self, other, context=None):
        o = self._compare_other(other)
        if o is NotImplemented:
            return o
        if not isinstance(o, Decimal):
            n, d = self.as_integer_ratio()
            return n * o.denominator >= o.numerator * d
        return self._cmp(o) >= 0

    def compare(self, other, context=None):
        other = _convert(other)
        return Decimal(self._cmp(other))

    def max(self, other, context=None):
        other = _convert(other)
        if context is None:
            context = getcontext()
        c = self._cmp(other)
        ans = other if c < 0 else self
        return ans._fix(context)

    def min(self, other, context=None):
        other = _convert(other)
        if context is None:
            context = getcontext()
        c = self._cmp(other)
        ans = self if c <= 0 else other
        return ans._fix(context)

    def __reduce__(self):
        return (self.__class__, (str(self),))

    def __copy__(self):
        return self

    def __deepcopy__(self, memo):
        return self

    # ── format() ──

    def __format__(self, specifier, context=None):
        if context is None:
            context = getcontext()
        spec = _parse_format_specifier(specifier)
        if self._is_special:
            body = str(self.copy_abs())
            if spec["type"] == "%":
                body += "%"
            return _format_align(self._sign, body, spec)
        if spec["type"] is None:
            spec["type"] = ["g", "G"][context.capitals]
        if spec["type"] == "%":
            self = _dec(self._sign, self._int, self._exp + 2)
        rounding = context.rounding
        precision = spec["precision"]
        if precision is not None:
            if spec["type"] in "eE":
                self = self._round(precision + 1, rounding)
            elif spec["type"] in "fF%":
                self = self._rescale(-precision, rounding)
            elif spec["type"] in "gG" and len(self._int) > precision:
                self = self._round(precision, rounding)
        if not self and self._exp > 0 and spec["type"] in "fF%":
            self = self._rescale(0, rounding)
        if not self and spec["no_neg_0"] and self._sign:
            adjusted_sign = 0
        else:
            adjusted_sign = self._sign
        leftdigits = self._exp + len(self._int)
        if spec["type"] in "eE":
            if not self and precision is not None:
                dotplace = 1 - precision
            else:
                dotplace = 1
        elif spec["type"] in "fF%":
            dotplace = leftdigits
        elif spec["type"] in "gG":
            if self._exp <= 0 and leftdigits > -6:
                dotplace = leftdigits
            else:
                dotplace = 1
        if dotplace < 0:
            intpart = "0"
            fracpart = "0" * (-dotplace) + self._int
        elif dotplace > len(self._int):
            intpart = self._int + "0" * (dotplace - len(self._int))
            fracpart = ""
        else:
            intpart = self._int[:dotplace] or "0"
            fracpart = self._int[dotplace:]
        exp = leftdigits - dotplace
        return _format_number(adjusted_sign, intpart, fracpart, exp, spec)

    def _round(self, places, rounding):
        if places <= 0:
            raise ValueError("argument should be at least 1 in _round")
        if self._is_special or not self:
            return Decimal(self)
        ans = self._rescale(self.adjusted() + 1 - places, rounding)
        if ans.adjusted() != self.adjusted():
            ans = ans._rescale(ans.adjusted() + 1 - places, rounding)
        return ans


def _parse(s):
    s0 = s
    sign = 0
    if s[:1] in "+-" and s:
        sign = 1 if s[0] == "-" else 0
        s = s[1:]
    low = s.lower()
    if low in ("inf", "infinity"):
        return sign, "", "", 0, "F"
    if low.startswith("nan") and low[3:].isdigit() or low == "nan":
        return sign, "", "", 0, "n"
    if low.startswith("snan"):
        return sign, "", "", 0, "N"
    mant, sep, exp = low.partition("e")
    if sep:
        e = exp
        if e[:1] in "+-":
            e = e[1:]
        if not e or not e.isdigit():
            return None
        exp = int(exp)
    else:
        exp = 0
    intpart, dot, fracpart = mant.partition(".")
    if not intpart and not fracpart:
        return None
    if (intpart and not intpart.isdigit()) or (fracpart and not fracpart.isdigit()):
        return None
    if not s0.isascii():
        return None
    return sign, intpart, fracpart, exp, None


def _all_zeros(s, i):
    return s[i:].strip("0") == ""


def _exact_half(s, i):
    return s[i:i + 1] == "5" and _all_zeros(s, i + 1)


def _round_down(self, prec):
    if _all_zeros(self._int, prec):
        return 0
    return -1


def _round_up(self, prec):
    return -_round_down(self, prec)


def _round_half_up(self, prec):
    if self._int[prec:prec + 1] in ("5", "6", "7", "8", "9"):
        return 1
    elif _all_zeros(self._int, prec):
        return 0
    return -1


def _round_half_down(self, prec):
    if _exact_half(self._int, prec):
        return -1
    return _round_half_up(self, prec)


def _round_half_even(self, prec):
    if _exact_half(self._int, prec) and (prec == 0 or self._int[prec - 1] in ("0", "2", "4", "6", "8")):
        return -1
    return _round_half_up(self, prec)


def _round_ceiling(self, prec):
    if self._sign:
        return _round_down(self, prec)
    return -_round_down(self, prec)


def _round_floor(self, prec):
    if not self._sign:
        return _round_down(self, prec)
    return -_round_down(self, prec)


def _round_05up(self, prec):
    if prec and self._int[prec - 1] not in "05":
        return _round_down(self, prec)
    return -_round_down(self, prec)


_rounders = {ROUND_DOWN: _round_down, ROUND_UP: _round_up, ROUND_HALF_UP: _round_half_up,
             ROUND_HALF_DOWN: _round_half_down, ROUND_HALF_EVEN: _round_half_even, ROUND_CEILING: _round_ceiling,
             ROUND_FLOOR: _round_floor, ROUND_05UP: _round_05up}


def _parse_format_specifier(spec):
    import re
    m = re.fullmatch(r"(?:(?P<fill>.)?(?P<align>[<>=^]))?(?P<sign>[-+ ])?(?P<no_neg_0>z)?(?P<alt>\#)?(?P<zeropad>0)?(?P<minimumwidth>\d+)?(?P<thousands_sep>[,_])?(?:\.(?P<precision>\d+))?(?P<type>[eEfFgGn%])?", spec, re.DOTALL)
    if m is None:
        raise ValueError("Invalid format specifier: " + spec)
    d = m.groupdict()
    fill = d["fill"]
    align = d["align"]
    d["zeropad"] = d["zeropad"] is not None
    if d["zeropad"]:
        if fill is None:
            fill = "0"
        if align is None:
            align = "="
    d["fill"] = fill or " "
    d["align"] = align or ">"
    d["sign"] = d["sign"] or "-"
    d["minimumwidth"] = int(d["minimumwidth"] or "0")
    if d["precision"] is not None:
        d["precision"] = int(d["precision"])
    if d["precision"] == 0 and d["type"] in ("g", "G"):
        d["precision"] = 1
    d["no_neg_0"] = d["no_neg_0"] is not None
    d["alt"] = d["alt"] is not None
    if d["type"] == "n":
        d["type"] = "g"
    return d


def _format_align(sign, body, spec):
    minimumwidth = spec["minimumwidth"]
    fill = spec["fill"]
    padding = fill * (minimumwidth - len(sign) - len(body))
    align = spec["align"]
    if align == "<":
        result = sign + body + padding
    elif align == ">":
        result = padding + sign + body
    elif align == "=":
        result = sign + padding + body
    else:
        half = len(padding) // 2
        result = padding[:half] + sign + body + padding[half:]
    return result


def _format_sign(is_negative, spec):
    if is_negative:
        return "-"
    elif spec["sign"] in " +":
        return spec["sign"]
    return ""


def _insert_thousands_sep(digits, spec, min_width=1):
    sep = spec["thousands_sep"]
    if not sep:
        return digits
    groups = []
    while digits:
        groups.append(digits[-3:])
        digits = digits[:-3]
    return sep.join(reversed(groups))


def _format_number(is_negative, intpart, fracpart, exp, spec):
    sign = _format_sign(is_negative, spec)
    if fracpart or spec["alt"]:
        fracpart = "." + fracpart
    if exp != 0 or spec["type"] in "eE":
        echar = {"E": "E", "e": "e", "G": "E", "g": "e"}[spec["type"]]
        fracpart += "{0}{1:+}".format(echar, exp)
    if spec["type"] == "%":
        fracpart += "%"
    if spec["zeropad"] and spec["thousands_sep"]:
        min_width = spec["minimumwidth"] - len(fracpart) - len(sign)
        while len(_insert_thousands_sep(intpart, spec)) < min_width:
            intpart = "0" + intpart
        intpart = _insert_thousands_sep(intpart, spec)
        return sign + intpart + fracpart
    intpart = _insert_thousands_sep(intpart, spec)
    return _format_align(sign, intpart + fracpart, spec)


_NaN = _dec(0, "", "n", True)

DefaultContext = Context(prec=28, rounding=ROUND_HALF_EVEN, Emin=-999999, Emax=999999, capitals=1, clamp=0,
                         traps={DivisionByZero: True, Overflow: True, InvalidOperation: True})
BasicContext = Context(prec=9, rounding=ROUND_HALF_UP, traps={DivisionByZero: True, Overflow: True,
                                                             InvalidOperation: True, Clamped: True,
                                                             Underflow: True})
ExtendedContext = Context(prec=9, rounding=ROUND_HALF_EVEN, traps={})

Decimal.__module__ = "decimal"
Context.__module__ = "decimal"
)QPYLIB"},
        {"enum.sa", R"QPYLIB("""Enumerations, with CPython 3.13's behaviour and reprs."""

__all__ = ["EnumType", "EnumMeta", "Enum", "IntEnum", "StrEnum", "Flag", "IntFlag", "ReprEnum", "auto", "unique",
           "property", "verify", "member", "nonmember", "FlagBoundary", "STRICT", "CONFORM", "EJECT", "KEEP",
           "global_flag_repr", "global_enum_repr", "global_str", "global_enum", "EnumCheck", "CONTINUOUS",
           "NAMED_FLAGS", "UNIQUE", "pickle_by_global_name", "pickle_by_enum_name", "show_flag_values"]

_auto_null = object()
_builtin_property = property


class auto:
    def __init__(self, value=_auto_null):
        self.value = value

    def __repr__(self):
        return "auto(%r)" % self.value


class nonmember:
    def __init__(self, value):
        self.value = value


class member:
    def __init__(self, value):
        self.value = value


class property:
    """A property that works on the class (members) and the instance."""

    def __init__(self, fget=None, fset=None, fdel=None, doc=None):
        self.fget = fget
        self.fset = fset
        self.fdel = fdel
        self.__doc__ = doc
        self.name = None

    def __set_name__(self, owner, name):
        self.name = name

    def __get__(self, instance, ownerclass=None):
        if instance is None:
            if self.name in ownerclass._member_map_:
                return ownerclass._member_map_[self.name]
            return self
        if self.fget is not None:
            return self.fget(instance)
        try:
            return instance.__dict__["_%s_" % self.name] if False else getattr(instance, "_" + self.name + "_")
        except AttributeError:
            raise AttributeError(f"{ownerclass.__name__!r} object has no attribute {self.name!r}")

    def __set__(self, instance, value):
        if self.fset is not None:
            return self.fset(instance, value)
        raise AttributeError(f"<enum {type(instance).__name__!r}> cannot set attribute {self.name!r}")

    def __delete__(self, instance):
        if self.fdel is not None:
            return self.fdel(instance)
        raise AttributeError(f"<enum {type(instance).__name__!r}> cannot delete attribute {self.name!r}")

    def getter(self, fget):
        return type(self)(fget, self.fset, self.fdel, self.__doc__)

    def setter(self, fset):
        return type(self)(self.fget, fset, self.fdel, self.__doc__)

    def deleter(self, fdel):
        return type(self)(self.fget, self.fset, fdel, self.__doc__)


def _is_descriptor(obj):
    return hasattr(obj, "__get__") or hasattr(obj, "__set__") or hasattr(obj, "__delete__")


def _is_dunder(name):
    return len(name) > 4 and name[:2] == name[-2:] == "__" and name[2] != "_" and name[-3] != "_"


def _is_sunder(name):
    return len(name) > 2 and name[0] == name[-1] == "_" and name[1] != "_" and name[-2] != "_"


def _is_private(cls_name, name):
    pattern = "_%s__" % (cls_name,)
    pat_len = len(pattern)
    return len(name) > pat_len and name.startswith(pattern) and (name[-1] != "_" or name[-2] != "_")


def _is_single_bit(num):
    if num == 0:
        return False
    num &= num - 1
    return num == 0


def _bit_count(num):
    return bin(num).count("1")


def _iter_bits_lsb(num):
    while num:
        b = num & (~num + 1)
        yield b
        num ^= b


class _EnumDict(dict):
    def __init__(self):
        super().__init__()
        self._member_names = {}
        self._last_values = []
        self._ignore = []
        self._auto_called = False
        self._cls_name = None

    def __setitem__(self, key, value):
        if self._cls_name is not None and _is_private(self._cls_name, key):
            pass
        elif _is_sunder(key):
            if key == "_ignore_":
                if isinstance(value, str):
                    value = value.replace(",", " ").split()
                else:
                    value = list(value)
                self._ignore = value
            elif key == "_generate_next_value_":
                if self._auto_called:
                    raise TypeError("_generate_next_value_ must be defined before members")
                setattr(self, "_generate_next_value", value)
        elif _is_dunder(key):
            if key == "__order__":
                key = "_order_"
        elif key in self._member_names:
            raise TypeError(f"{key!r} already defined as {self[key]!r}")
        elif key in self._ignore:
            pass
        elif isinstance(value, nonmember):
            value = value.value
        elif _is_descriptor(value):
            pass
        else:
            if key in self:
                raise TypeError(f"{key!r} already defined as {self[key]!r}")
            if isinstance(value, member):
                value = value.value
            non_auto_store = True
            single = False
            if isinstance(value, auto):
                single = True
                value = (value,)
            if isinstance(value, tuple) and any(isinstance(v, auto) for v in value):
                auto_valued = []
                t = type(value)
                for v in value:
                    if isinstance(v, auto):
                        non_auto_store = False
                        if v.value == _auto_null:
                            v.value = self._generate_next_value(key, 1, len(self._member_names), self._last_values[:])
                            self._auto_called = True
                        v = v.value
                        self._last_values.append(v)
                    auto_valued.append(v)
                if single:
                    value = auto_valued[0]
                else:
                    value = t(auto_valued)
            self._member_names[key] = None
            if non_auto_store:
                self._last_values.append(value)
        super().__setitem__(key, value)

    def update(self, members, **more_members):
        for name, value in (members.items() if hasattr(members, "items") else members):
            self[name] = value
        for name, value in more_members.items():
            self[name] = value


class EnumType(type):
    @classmethod
    def __prepare__(metacls, cls, bases, **kwds):
        enum_dict = _EnumDict()
        enum_dict._cls_name = cls
        member_type, first_enum = metacls._get_mixins_(cls, bases)
        if first_enum is not None:
            enum_dict._generate_next_value = getattr(first_enum, "_generate_next_value_", None)
        return enum_dict

    def __new__(metacls, cls, bases, classdict, *, boundary=None, _simple=False, **kwds):
        member_type, first_enum = metacls._get_mixins_(cls, bases)
        member_names = list(classdict._member_names) if isinstance(classdict, _EnumDict) else []
        ns = dict(classdict)
        members = {name: ns.pop(name) for name in member_names}
        invalid = set(members) & {"mro", ""}
        if invalid:
            raise ValueError(f"invalid enum member name(s) {','.join(sorted(invalid))}")
        ns.pop("_generate_next_value", None)
        ns["_member_names_"] = []
        ns["_member_map_"] = {}
        ns["_value2member_map_"] = {}
        ns["_unhashable_values_"] = []
        ns["_member_type_"] = member_type
        ns["_value_repr_"] = metacls._find_data_repr_(cls, bases)
        ns["_new_member_"] = metacls._find_new_(ns, member_type, first_enum)
        ns["_use_args_"] = ns["_new_member_"] is not object.__new__ and member_type is not object
        if boundary is not None:
            ns["_boundary_"] = boundary
        enum_class = type.__new__(metacls, cls, bases, ns, **kwds)
        if Flag is not None and issubclass(enum_class, Flag):
            enum_class._flag_mask_ = 0
            enum_class._singles_mask_ = 0
            enum_class._all_bits_ = 0
            enum_class._inverted_ = None
        for name, value in members.items():
            enum_class._add_member_(name, value)
        if Flag is not None and issubclass(enum_class, Flag):
            mask = 0
            singles = 0
            for m in enum_class._member_map_.values():
                mask |= m._value_
                if _is_single_bit(m._value_):
                    singles |= m._value_
            enum_class._flag_mask_ = mask
            enum_class._singles_mask_ = singles
            enum_class._all_bits_ = 2 ** mask.bit_length() - 1 if mask else 0
        # str() and format() of a ReprEnum come from the mixed-in type
        if ReprEnum is not None and ReprEnum in bases:
            if "__format__" not in classdict:
                type.__setattr__(enum_class, "__format__", member_type.__format__)
            if "__str__" not in classdict:
                method = member_type.__str__
                if method is object.__str__:
                    method = member_type.__repr__
                type.__setattr__(enum_class, "__str__", method)
        # repr() and friends are the enum's unless a mixin overrides them
        for name in ("__repr__", "__str__", "__format__", "__reduce_ex__"):
            if name not in classdict and first_enum is not None:
                if ReprEnum is not None and ReprEnum in bases and name in ("__str__", "__format__"):
                    continue
                enum_method = getattr(first_enum, name)
                found_method = getattr(enum_class, name)
                object_method = getattr(object, name)
                data_type_method = getattr(member_type, name)
                if found_method is data_type_method or found_method is object_method:
                    type.__setattr__(enum_class, name, enum_method)
        # members are made; from now on calling the class looks them up
        if Enum is not None:
            if "__new__" in classdict:
                type.__setattr__(enum_class, "__new_member__", classdict["__new__"])
            type.__setattr__(enum_class, "__new__", Enum.__new__)
        return enum_class

    def _add_member_(cls, name, value):
        if isinstance(value, tuple) and cls._use_args_:
            args = value
        elif isinstance(value, tuple) and cls._member_type_ is object and "__init__" in _mro_dict(cls):
            args = value
        else:
            args = (value,)
        if cls._member_type_ is tuple and not isinstance(value, tuple):
            args = (args,)
        if not cls._use_args_:
            enum_member = cls._new_member_(cls)
        else:
            enum_member = cls._new_member_(cls, *args)
        if not hasattr(enum_member, "_value_"):
            if cls._member_type_ is object:
                enum_member._value_ = value
            else:
                try:
                    enum_member._value_ = cls._member_type_(*args)
                except Exception:
                    enum_member._value_ = value
        value = enum_member._value_
        enum_member._name_ = name
        enum_member.__objclass__ = cls
        enum_member._sort_order_ = len(cls._member_names_)
        init = _mro_dict(cls).get("__init__")
        if init is not None and init is not object.__init__ and getattr(init, "__module__", None) != "builtins":
            if cls._member_type_ is object or "__init__" in cls.__dict__ or any("__init__" in b.__dict__ for b in cls.__mro__ if isinstance(b, EnumType)):
                init(enum_member, *args)
        # an alias of an existing member?
        canonical = None
        try:
            canonical = cls._value2member_map_.get(value)
        except TypeError:
            for m in cls._member_map_.values():
                if m._value_ == value:
                    canonical = m
                    break
        if canonical is None:
            for m in cls._member_map_.values():
                if m._value_ == value:
                    canonical = m
                    break
        if canonical is not None:
            enum_member = canonical
        else:
            if Flag is None or not issubclass(cls, Flag) or _is_single_bit(value) or value == 0 or True:
                cls._member_names_.append(name)
        cls._member_map_[name] = enum_member
        try:
            cls._value2member_map_.setdefault(value, enum_member)
        except TypeError:
            cls._unhashable_values_.append(value)
        type.__setattr__(cls, name, enum_member)

    def __bool__(cls):
        return True

    def __call__(cls, value, names=None, *values, module=None, qualname=None, type=None, start=1, boundary=None):
        if names is None:
            return cls.__new__(cls, value)
        return cls._create_(value, names, module=module, qualname=qualname, type=type, start=start, boundary=boundary)

    def __contains__(cls, value):
        if isinstance(value, cls):
            return True
        try:
            return value in cls._value2member_map_
        except TypeError:
            return value in cls._unhashable_values_

    def __delattr__(cls, attr):
        if attr in cls._member_map_:
            raise AttributeError(f"{cls.__name__!r} cannot delete member {attr!r}.")
        super().__delattr__(attr)

    def __dir__(cls):
        return sorted(set(cls._member_names_) | {"__class__", "__doc__", "__members__", "__module__"})

    def __getitem__(cls, name):
        return cls._member_map_[name]

    def __iter__(cls):
        return (cls._member_map_[name] for name in cls._member_names_)

    def __len__(cls):
        return len(cls._member_names_)

    @_builtin_property
    def __members__(cls):
        return dict(cls._member_map_)

    def __repr__(cls):
        if Flag is not None and issubclass(cls, Flag):
            return "<flag %r>" % cls.__name__
        return "<enum %r>" % cls.__name__

    def __reversed__(cls):
        return (cls._member_map_[name] for name in reversed(cls._member_names_))

    def __setattr__(cls, name, value):
        member_map = cls.__dict__.get("_member_map_", {})
        if name in member_map:
            raise AttributeError(f"cannot reassign member {name!r}")
        super().__setattr__(name, value)

    def _create_(cls, class_name, names, *, module=None, qualname=None, type=None, start=1, boundary=None):
        metacls = cls.__class__
        bases = (cls,) if type is None else (type, cls)
        classdict = metacls.__prepare__(class_name, bases)
        if isinstance(names, str):
            names = names.replace(",", " ").split()
        if isinstance(names, (tuple, list)) and names and isinstance(names[0], str):
            original_names, names = names, []
            last_values = []
            for count, name in enumerate(original_names):
                value = cls._generate_next_value_(name, start, count, last_values[:])
                last_values.append(value)
                names.append((name, value))
        if isinstance(names, dict):
            names = names.items()
        for item in names:
            if isinstance(item, str):
                member_name, member_value = item, names[item]
            else:
                member_name, member_value = item
            classdict[member_name] = member_value
        classdict["__module__"] = module or "__main__"
        if qualname is not None:
            classdict["__qualname__"] = qualname
        return metacls.__new__(metacls, class_name, bases, classdict, boundary=boundary)

    @classmethod
    def _get_mixins_(mcls, class_name, bases):
        if not bases:
            return object, Enum
        first_enum = bases[-1]
        if not isinstance(first_enum, EnumType):
            raise TypeError("new enumerations should be created as `EnumName([mixin_type, ...] [data_type,] enum_type)`")
        member_type = mcls._find_data_type_(class_name, bases) or object
        return member_type, first_enum

    @classmethod
    def _find_data_repr_(mcls, class_name, bases):
        for chain in bases:
            for base in chain.__mro__:
                if base is object:
                    continue
                elif isinstance(base, EnumType):
                    return base.__dict__.get("_value_repr_", None) if "_value_repr_" in base.__dict__ else None
                elif "__repr__" in base.__dict__:
                    if "__dataclass_fields__" in base.__dict__:
                        return None
                    return base.__dict__["__repr__"]
        return None

    @classmethod
    def _find_data_type_(mcls, class_name, bases):
        data_types = set()
        for chain in bases:
            candidate = None
            for base in chain.__mro__:
                if base is object:
                    continue
                elif isinstance(base, EnumType):
                    if base._member_type_ is not object:
                        data_types.add(base._member_type_)
                        break
                elif "__new__" in base.__dict__ or "__dataclass_fields__" in base.__dict__ or base in (int, str, float, tuple, bytes, complex):
                    data_types.add(candidate or base)
                    break
                else:
                    candidate = candidate or base
        if len(data_types) > 1:
            raise TypeError(f"too many data types for {class_name!r}: {data_types!r}")
        elif data_types:
            return data_types.pop()
        return None

    @classmethod
    def _find_new_(mcls, classdict, member_type, first_enum):
        __new__ = classdict.get("__new__", None)
        if __new__ is not None:
            classdict["_new_member_"] = __new__
            return __new__
        for method in ("__new_member__", "__new__"):
            for possible in (member_type, first_enum):
                target = getattr(possible, method, None)
                if target not in {None, None.__new__, object.__new__, Enum.__new__ if Enum is not None else None}:
                    return target
        return object.__new__ if member_type is object else member_type.__new__


EnumMeta = EnumType


def _mro_dict(cls):
    d = {}
    for base in reversed(cls.__mro__):
        d.update(base.__dict__)
    return d


Enum = None
Flag = None
ReprEnum = None


class Enum(metaclass=EnumType):
    def __new__(cls, value):
        if type(value) is cls:
            return value
        try:
            return cls._value2member_map_[value]
        except KeyError:
            pass
        except TypeError:
            for member in cls._member_map_.values():
                if member._value_ == value:
                    return member
        for member in cls._member_map_.values():
            if member._value_ == value:
                return member
        result = cls._missing_(value)
        if isinstance(result, cls):
            return result
        if Flag is not None and issubclass(cls, Flag) and result is None:
            pass
        ve_exc = ValueError(f"{value!r} is not a valid {cls.__qualname__}")
        if result is None:
            raise ve_exc
        raise TypeError(f"error in {cls.__name__}._missing_: returned {result!r} instead of None or a valid member")

    def __init__(self, *args, **kwds):
        pass

    @staticmethod
    def _generate_next_value_(name, start, count, last_values):
        if not last_values:
            return start
        try:
            last_value = sorted(last_values).pop()
        except TypeError:
            raise TypeError(f"unable to sort non-numeric values") from None
        try:
            return last_value + 1
        except TypeError:
            raise TypeError(f"unable to increment {last_value!r}") from None

    @classmethod
    def _missing_(cls, value):
        return None

    def __repr__(self):
        v_repr = self.__class__._value_repr_ or repr
        return "<%s.%s: %s>" % (self.__class__.__name__, self._name_, v_repr(self._value_))

    def __str__(self):
        return "%s.%s" % (self.__class__.__name__, self._name_)

    def __dir__(self):
        return sorted({"__class__", "__doc__", "__eq__", "__hash__", "__module__", "name", "value"})

    def __format__(self, format_spec):
        return str.__format__(str(self), format_spec)

    def __hash__(self):
        return hash(self._name_)

    def __reduce_ex__(self, proto):
        return self.__class__, (self._value_,)

    def __copy__(self):
        return self

    def __deepcopy__(self, memo):
        return self

    @property
    def name(self):
        return self._name_

    @property
    def value(self):
        return self._value_


Enum.__new_member__ = object.__new__


class ReprEnum(Enum):
    """Only changes the repr(), leaving str() and format() to the mixed-in type."""


class IntEnum(int, ReprEnum):
    def __str__(self):
        return int.__repr__(self)

    def __format__(self, format_spec):
        return int.__format__(int(self), format_spec)


class StrEnum(str, ReprEnum):
    def __new__(cls, *values):
        if len(values) > 3:
            raise TypeError("too many arguments for str(): %r" % (values,))
        if len(values) == 1 and not isinstance(values[0], str):
            raise TypeError("%r is not a string" % (values[0],))
        value = str(*values)
        member = str.__new__(cls, value)
        member._value_ = value
        return member

    @staticmethod
    def _generate_next_value_(name, start, count, last_values):
        return name.lower()

    def __str__(self):
        return str.__str__(self)

    def __format__(self, format_spec):
        return str.__format__(str.__str__(self), format_spec)


def _str_new_member(cls, *values):
    return StrEnum.__new__(cls, *values)


class FlagBoundary(StrEnum):
    STRICT = auto()
    CONFORM = auto()
    EJECT = auto()
    KEEP = auto()


STRICT, CONFORM, EJECT, KEEP = FlagBoundary.STRICT, FlagBoundary.CONFORM, FlagBoundary.EJECT, FlagBoundary.KEEP


class Flag(Enum, boundary=STRICT):
    _numeric_repr_ = repr

    @staticmethod
    def _generate_next_value_(name, start, count, last_values):
        if not count:
            return start if start is not None else 1
        last_value = max(last_values)
        try:
            high_bit = last_value.bit_length() - 1
        except Exception:
            raise TypeError("invalid flag value %r" % last_value) from None
        return 2 ** (high_bit + 1)

    @classmethod
    def _iter_member_by_value_(cls, value):
        for val in _iter_bits_lsb(value & cls._flag_mask_):
            m = cls._value2member_map_.get(val)
            if m is not None:
                yield m

    _iter_member_ = _iter_member_by_value_

    @classmethod
    def _iter_member_by_def_(cls, value):
        yield from sorted(cls._iter_member_by_value_(value), key=lambda m: m._sort_order_)

    @classmethod
    def _missing_(cls, value):
        if not isinstance(value, int):
            raise ValueError("%r is not a valid %s" % (value, cls.__qualname__))
        flag_mask = cls._flag_mask_
        singles_mask = cls._singles_mask_
        all_bits = cls._all_bits_
        neg_value = None
        if (not ~all_bits <= value <= all_bits or value & (all_bits ^ flag_mask)):
            boundary = getattr(cls, "_boundary_", STRICT)
            if boundary is STRICT:
                max_bits = max(value.bit_length(), flag_mask.bit_length())
                raise ValueError("%r invalid value %r\n    given %s\n  allowed %s" % (
                    cls, value, bin(value)[2:].zfill(max_bits), bin(flag_mask)[2:].zfill(max_bits)))
            elif boundary is CONFORM:
                value = value & flag_mask
            elif boundary is EJECT:
                return value
            elif boundary is KEEP:
                if value < 0:
                    value = (max(all_bits + 1, 2 ** (value.bit_length())) + value)
        if value < 0:
            neg_value = value
            value = all_bits + 1 + value
        unknown = value & ~flag_mask
        aliases = value & ~singles_mask
        member_value = value & singles_mask
        if cls._member_type_ is object:
            pseudo_member = object.__new__(cls)
        else:
            pseudo_member = cls._member_type_.__new__(cls, value)
        if not hasattr(pseudo_member, "_value_"):
            pseudo_member._value_ = value
        if member_value or aliases:
            members = []
            combined_value = 0
            for m in cls._iter_member_(member_value):
                members.append(m)
                combined_value |= m._value_
            if aliases:
                value = member_value | aliases
                for n, pv in cls._member_map_.items():
                    if pv not in members and pv._value_ and pv._value_ & value == pv._value_:
                        members.append(pv)
                        combined_value |= pv._value_
            unknown = value ^ combined_value
            pseudo_member._name_ = "|".join([m._name_ for m in members])
            if not combined_value:
                pseudo_member._name_ = None
            elif unknown and getattr(cls, "_boundary_", STRICT) is STRICT:
                raise ValueError("%r: no members with value %r" % (cls, unknown))
            elif unknown:
                pseudo_member._name_ += "|%s" % cls._numeric_repr_(unknown)
        else:
            pseudo_member._name_ = None
        pseudo_member = cls._value2member_map_.setdefault(value, pseudo_member)
        if neg_value is not None:
            cls._value2member_map_[neg_value] = pseudo_member
        return pseudo_member

    def __contains__(self, other):
        if not isinstance(other, self.__class__):
            raise TypeError("unsupported operand type(s) for 'in': %r and %r" % (type(other).__qualname__, self.__class__.__qualname__))
        return other._value_ & self._value_ == other._value_

    def __iter__(self):
        yield from self._iter_member_(self._value_)

    def __len__(self):
        return _bit_count(self._value_)

    def __repr__(self):
        cls_name = self.__class__.__name__
        v_repr = self.__class__._value_repr_ or repr
        if self._name_ is None:
            return "<%s: %s>" % (cls_name, v_repr(self._value_))
        return "<%s.%s: %s>" % (cls_name, self._name_, v_repr(self._value_))

    def __str__(self):
        cls_name = self.__class__.__name__
        if self._name_ is None:
            return "%s(%r)" % (cls_name, self._value_)
        return "%s.%s" % (cls_name, self._name_)

    def __bool__(self):
        return bool(self._value_)

    def _get_value(self, flag):
        if isinstance(flag, self.__class__):
            return flag._value_
        elif self._member_type_ is not object and isinstance(flag, self._member_type_):
            return flag
        return NotImplemented

    def __or__(self, other):
        other_value = self._get_value(other)
        if other_value is NotImplemented:
            return NotImplemented
        for flag in self, other:
            if self._get_value(flag) is None:
                raise TypeError(f"'{flag}' cannot be combined with other flags with |")
        value = self._value_
        return self.__class__(value | other_value)

    def __and__(self, other):
        other_value = self._get_value(other)
        if other_value is NotImplemented:
            return NotImplemented
        return self.__class__(self._value_ & other_value)

    def __xor__(self, other):
        other_value = self._get_value(other)
        if other_value is NotImplemented:
            return NotImplemented
        return self.__class__(self._value_ ^ other_value)

    def __invert__(self):
        if self._get_value(self) is None:
            raise TypeError(f"'{self}' cannot be inverted")
        if self._inverted_ is None:
            if getattr(self.__class__, "_boundary_", STRICT) in (EJECT, KEEP):
                self._inverted_ = self.__class__(~self._value_)
            else:
                self._inverted_ = self.__class__(self._singles_mask_ & ~self._value_)
        return self._inverted_

    __rand__ = __and__
    __ror__ = __or__
    __rxor__ = __xor__


class IntFlag(int, ReprEnum, Flag, boundary=KEEP):
    def __str__(self):
        return int.__repr__(self)

    def __format__(self, format_spec):
        return int.__format__(int(self), format_spec)

    def __or__(self, other):
        if isinstance(other, self.__class__):
            other = other._value_
        elif isinstance(other, int):
            other = other
        else:
            return NotImplemented
        return self.__class__(self._value_ | other)

    def __and__(self, other):
        if isinstance(other, self.__class__):
            other = other._value_
        elif isinstance(other, int):
            other = other
        else:
            return NotImplemented
        return self.__class__(self._value_ & other)

    def __xor__(self, other):
        if isinstance(other, self.__class__):
            other = other._value_
        elif isinstance(other, int):
            other = other
        else:
            return NotImplemented
