        {"Map.java", R"JAVA(package java.util;

import java.util.function.*;
import java.util.stream.*;

public interface Map<K, V> {
    int size();
    boolean isEmpty();
    boolean containsKey(Object key);
    boolean containsValue(Object value);
    V get(Object key);
    V put(K key, V value);
    V remove(Object key);
