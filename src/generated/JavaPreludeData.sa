import java.util.function.*;
import java.util.stream.*;

public final class Arrays {
    private Arrays() {}

    private static native void sortPrim(Object a);
    private static native void sortPrim(Object a, int fromIndex, int toIndex);
    private static native boolean sortNatural(Object[] a, int fromIndex, int toIndex);
    private static native void sortCmp(Object[] a, int fromIndex, int toIndex, Comparator<?> c);
    private static native String toStringPrim(Object a, String kind);
    private static native void fill(Object a, Object val);
    private static native void fill(Object a, int fromIndex, int toIndex, Object val);
    private static native boolean equalsPrim(Object a, Object b);
    private static native Object copyOfPrim(Object original, int newLength, Object pad);
    private static native Object copyOfRangePrim(Object original, int from, int to, Object pad);
    private static native int binarySearchPrim(Object a, Object key);

    private static void rangeCheck(int arrayLength, int fromIndex, int toIndex) {
        if (fromIndex > toIndex)
            throw new IllegalArgumentException("fromIndex(" + fromIndex + ") > toIndex(" + toIndex + ")");
        if (fromIndex < 0)
            throw new ArrayIndexOutOfBoundsException("Array index out of range: " + fromIndex);
        if (toIndex > arrayLength)
            throw new ArrayIndexOutOfBoundsException("Array index out of range: " + toIndex);
    }

    // ── sorting ──
    public static void sort(int[] a) { sortPrim(a); }
    public static void sort(long[] a) { sortPrim(a); }
    public static void sort(short[] a) { sortPrim(a); }
    public static void sort(char[] a) { sortPrim(a); }
    public static void sort(byte[] a) { sortPrim(a); }
    public static void sort(float[] a) { sortPrim(a); }
    public static void sort(double[] a) { sortPrim(a); }

    public static void sort(int[] a, int fromIndex, int toIndex) { rangeCheck(a.length, fromIndex, toIndex); sortPrim(a, fromIndex, toIndex); }
    public static void sort(long[] a, int fromIndex, int toIndex) { rangeCheck(a.length, fromIndex, toIndex); sortPrim(a, fromIndex, toIndex); }
    public static void sort(short[] a, int fromIndex, int toIndex) { rangeCheck(a.length, fromIndex, toIndex); sortPrim(a, fromIndex, toIndex); }
    public static void sort(char[] a, int fromIndex, int toIndex) { rangeCheck(a.length, fromIndex, toIndex); sortPrim(a, fromIndex, toIndex); }
    public static void sort(byte[] a, int fromIndex, int toIndex) { rangeCheck(a.length, fromIndex, toIndex); sortPrim(a, fromIndex, toIndex); }
    public static void sort(float[] a, int fromIndex, int toIndex) { rangeCheck(a.length, fromIndex, toIndex); sortPrim(a, fromIndex, toIndex); }
    public static void sort(double[] a, int fromIndex, int toIndex) { rangeCheck(a.length, fromIndex, toIndex); sortPrim(a, fromIndex, toIndex); }

    public static void sort(Object[] a) { sort(a, 0, a.length); }

    public static void sort(Object[] a, int fromIndex, int toIndex) {
        rangeCheck(a.length, fromIndex, toIndex);
        if (!sortNatural(a, fromIndex, toIndex))
            sortCmp(a, fromIndex, toIndex, null);
    }

    public static <T> void sort(T[] a, Comparator<? super T> c) { sort(a, 0, a.length, c); }

    public static <T> void sort(T[] a, int fromIndex, int toIndex, Comparator<? super T> c) {
        rangeCheck(a.length, fromIndex, toIndex);
        if (c == null)
            sort(a, fromIndex, toIndex);
        else
            sortCmp(a, fromIndex, toIndex, c);
    }

    public static void parallelSort(int[] a) { sort(a); }
    public static void parallelSort(long[] a) { sort(a); }
    public static void parallelSort(double[] a) { sort(a); }
    public static <T extends Comparable<? super T>> void parallelSort(T[] a) { sort(a); }
    public static <T> void parallelSort(T[] a, Comparator<? super T> cmp) { sort(a, cmp); }

    // ── searching ──
    public static int binarySearch(int[] a, int key) { return binarySearchPrim(a, key); }
    public static int binarySearch(long[] a, long key) { return binarySearchPrim(a, key); }
    public static int binarySearch(char[] a, char key) { return binarySearchPrim(a, (int) key); }
    public static int binarySearch(short[] a, short key) { return binarySearchPrim(a, (int) key); }
    public static int binarySearch(byte[] a, byte key) { return binarySearchPrim(a, (int) key); }
    public static int binarySearch(double[] a, double key) { return binarySearchPrim(a, key); }
    public static int binarySearch(float[] a, float key) { return binarySearchPrim(a, (double) key); }

    public static int binarySearch(int[] a, int fromIndex, int toIndex, int key) {
        rangeCheck(a.length, fromIndex, toIndex);
        int low = fromIndex, high = toIndex - 1;
        while (low <= high) {
            int mid = (low + high) >>> 1;
            int midVal = a[mid];
            if (midVal < key)
                low = mid + 1;
            else if (midVal > key)
                high = mid - 1;
            else
                return mid;
        }
        return -(low + 1);
    }

    public static int binarySearch(long[] a, int fromIndex, int toIndex, long key) {
        rangeCheck(a.length, fromIndex, toIndex);
        int low = fromIndex, high = toIndex - 1;
        while (low <= high) {
            int mid = (low + high) >>> 1;
            long midVal = a[mid];
            if (midVal < key)
                low = mid + 1;
            else if (midVal > key)
                high = mid - 1;
            else
                return mid;
        }
        return -(low + 1);
    }

    @SuppressWarnings({"unchecked", "rawtypes"})
    public static int binarySearch(Object[] a, Object key) {
        int low = 0, high = a.length - 1;
        while (low <= high) {
            int mid = (low + high) >>> 1;
            Comparable midVal = (Comparable) a[mid];
            int cmp = midVal.compareTo(key);
            if (cmp < 0)
                low = mid + 1;
            else if (cmp > 0)
                high = mid - 1;
            else
                return mid;
        }
        return -(low + 1);
    }

    public static <T> int binarySearch(T[] a, T key, Comparator<? super T> c) {
        if (c == null)
            return binarySearch(a, key);
        int low = 0, high = a.length - 1;
        while (low <= high) {
            int mid = (low + high) >>> 1;
            T midVal = a[mid];
            int cmp = c.compare(midVal, key);
            if (cmp < 0)
                low = mid + 1;
            else if (cmp > 0)
                high = mid - 1;
            else
                return mid;
        }
        return -(low + 1);
    }

