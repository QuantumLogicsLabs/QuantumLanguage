        {"LongStreamImpl.java", R"JAVA(package java.util.stream;

import java.util.*;
import java.util.function.*;

final class LongStreamImpl extends AbstractPipeline<Long> implements LongStream {
    LongStreamImpl(Iterator<Long> source) { super(source); }

    public Iterator<Long> iterator() { return take(); }
    public LongStream sequential() { return this; }
    public LongStream parallel() { return this; }
    public LongStream unordered() { return this; }
    public LongStream onClose(Runnable closeHandler) { return this; }

    public LongStream filter(LongPredicate predicate) { return new LongStreamImpl(new StreamSupport.Filter<Long>(take(), x -> predicate.test(x))); }
    public LongStream map(LongUnaryOperator mapper) { return new LongStreamImpl(new StreamSupport.Map<Long, Long>(take(), x -> mapper.applyAsLong(x))); }
    public <U> Stream<U> mapToObj(LongFunction<? extends U> mapper) { return new RefStream<U>(new StreamSupport.Map<Long, U>(take(), x -> mapper.apply(x))); }
    public IntStream mapToInt(LongToIntFunction mapper) { return new IntStreamImpl(new StreamSupport.Map<Long, Integer>(take(), x -> mapper.applyAsInt(x))); }
    public DoubleStream mapToDouble(LongToDoubleFunction mapper) { return new DoubleStreamImpl(new StreamSupport.Map<Long, Double>(take(), x -> mapper.applyAsDouble(x))); }
    public LongStream distinct() { return new LongStreamImpl(new StreamSupport.Distinct<Long>(take())); }

    public LongStream sorted() {
        ArrayList<Long> all = StreamSupport.drain(take());
        long[] a = new long[all.size()];
        for (int k = 0; k < a.length; k++)
            a[k] = all.get(k);
        Arrays.sort(a);
        return LongStream.of(a);
    }

    public LongStream peek(LongConsumer action) { return new LongStreamImpl(new StreamSupport.Peek<Long>(take(), x -> action.accept(x))); }
    public LongStream limit(long maxSize) { return new LongStreamImpl(new StreamSupport.Limit<Long>(take(), maxSize)); }
    public LongStream skip(long n) { return new LongStreamImpl(new StreamSupport.Skip<Long>(take(), n)); }

    public void forEach(LongConsumer action) {
        Iterator<Long> it = take();
        while (it.hasNext())
            action.accept(it.next());
    }

    public long[] toArray() {
        ArrayList<Long> all = StreamSupport.drain(take());
        long[] a = new long[all.size()];
        for (int i = 0; i < a.length; i++)
            a[i] = all.get(i);
        return a;
    }

    public long reduce(long identity, LongBinaryOperator op) {
        long result = identity;
        Iterator<Long> it = take();
        while (it.hasNext())
            result = op.applyAsLong(result, it.next());
        return result;
    }

    public OptionalLong reduce(LongBinaryOperator op) {
        Iterator<Long> it = take();
        if (!it.hasNext())
            return OptionalLong.empty();
        long result = it.next();
        while (it.hasNext())
            result = op.applyAsLong(result, it.next());
        return OptionalLong.of(result);
    }

    public long sum() { return reduce(0L, (a, b) -> a + b); }
    public OptionalLong min() { return reduce((a, b) -> Math.min(a, b)); }
    public OptionalLong max() { return reduce((a, b) -> Math.max(a, b)); }

    public long count() {
        long n = 0;
        Iterator<Long> it = take();
        while (it.hasNext()) {
            it.next();
            n++;
        }
        return n;
    }

    public OptionalDouble average() {
        long count = 0, sum = 0;
        Iterator<Long> it = take();
        while (it.hasNext()) {
            count++;
            sum += it.next();
        }
        return count > 0 ? OptionalDouble.of((double) sum / count) : OptionalDouble.empty();
    }

    public LongSummaryStatistics summaryStatistics() {
        LongSummaryStatistics s = new LongSummaryStatistics();
        Iterator<Long> it = take();
        while (it.hasNext())
            s.accept((long) it.next());
        return s;
    }

    public boolean anyMatch(LongPredicate predicate) {
        Iterator<Long> it = take();
        while (it.hasNext())
            if (predicate.test(it.next()))
                return true;
        return false;
    }

    public boolean allMatch(LongPredicate predicate) {
        Iterator<Long> it = take();
        while (it.hasNext())
            if (!predicate.test(it.next()))
                return false;
        return true;
    }

    public boolean noneMatch(LongPredicate predicate) { return !anyMatch(predicate); }

    public OptionalLong findFirst() {
        Iterator<Long> it = take();
        return it.hasNext() ? OptionalLong.of(it.next()) : OptionalLong.empty();
    }

    public DoubleStream asDoubleStream() { return new DoubleStreamImpl(new StreamSupport.Map<Long, Double>(take(), x -> (double) (long) x)); }
    public Stream<Long> boxed() { return new RefStream<Long>(take()); }
}
)JAVA"},
        {"RefStream.java", R"JAVA(package java.util.stream;

import java.util.*;
import java.util.function.*;

final class RefStream<T> extends AbstractPipeline<T> implements Stream<T> {
    RefStream(Iterator<T> source) { super(source); }

    public Iterator<T> iterator() { return take(); }
    public Stream<T> sequential() { return this; }
    public Stream<T> parallel() { return this; }
    public Stream<T> unordered() { return this; }
    public Stream<T> onClose(Runnable closeHandler) { return this; }

    public Stream<T> filter(Predicate<? super T> predicate) {
        Objects.requireNonNull(predicate);
        return new RefStream<T>(new StreamSupport.Filter<T>(take(), predicate));
    }

    public <R> Stream<R> map(Function<? super T, ? extends R> mapper) {
        Objects.requireNonNull(mapper);
        return new RefStream<R>(new StreamSupport.Map<T, R>(take(), mapper));
    }

    public IntStream mapToInt(ToIntFunction<? super T> mapper) {
        Objects.requireNonNull(mapper);
        return new IntStreamImpl(new StreamSupport.Map<T, Integer>(take(), t -> mapper.applyAsInt(t)));
    }

    public LongStream mapToLong(ToLongFunction<? super T> mapper) {
        Objects.requireNonNull(mapper);
        return new LongStreamImpl(new StreamSupport.Map<T, Long>(take(), t -> mapper.applyAsLong(t)));
    }

    public DoubleStream mapToDouble(ToDoubleFunction<? super T> mapper) {
        Objects.requireNonNull(mapper);
        return new DoubleStreamImpl(new StreamSupport.Map<T, Double>(take(), t -> mapper.applyAsDouble(t)));
    }

    public <R> Stream<R> flatMap(Function<? super T, ? extends Stream<? extends R>> mapper) {
        Objects.requireNonNull(mapper);
        return new RefStream<R>(new StreamSupport.FlatMap<T, R>(take(), t -> {
            Stream<? extends R> s = mapper.apply(t);
            return s == null ? Collections.<R>emptyIterator() : s.iterator();
        }));
    }

    public IntStream flatMapToInt(Function<? super T, ? extends IntStream> mapper) {
        Objects.requireNonNull(mapper);
        return new IntStreamImpl(new StreamSupport.FlatMap<T, Integer>(take(), t -> {
            IntStream s = mapper.apply(t);
            return s == null ? Collections.<Integer>emptyIterator() : s.boxed().iterator();
        }));
    }

    public <R> Stream<R> mapMulti(BiConsumer<? super T, ? super Consumer<R>> mapper) {
        Objects.requireNonNull(mapper);
        return new RefStream<R>(new StreamSupport.FlatMap<T, R>(take(), t -> {
            ArrayList<R> buffer = new ArrayList<>();
            Consumer<R> sink = buffer::add;
            mapper.accept(t, sink);
            return buffer.iterator();
        }));
    }

    public Stream<T> distinct() { return new RefStream<T>(new StreamSupport.Distinct<T>(take())); }

    public Stream<T> sorted() { return sorted(null); }

    public Stream<T> sorted(Comparator<? super T> comparator) {
        Iterator<T> src = take();
        return new RefStream<T>(new Iterator<T>() {
            Iterator<T> sortedIt;
            private Iterator<T> it() {
                if (sortedIt == null) {
                    ArrayList<T> all = StreamSupport.drain(src);
                    all.sort(comparator);
                    sortedIt = all.iterator();
                }
                return sortedIt;
            }
            public boolean hasNext() { return it().hasNext(); }
            public T next() { return it().next(); }
        });
    }

    public Stream<T> peek(Consumer<? super T> action) {
        Objects.requireNonNull(action);
        return new RefStream<T>(new StreamSupport.Peek<T>(take(), action));
    }

    public Stream<T> limit(long maxSize) { return new RefStream<T>(new StreamSupport.Limit<T>(take(), maxSize)); }
    public Stream<T> skip(long n) { return new RefStream<T>(new StreamSupport.Skip<T>(take(), n)); }
    public Stream<T> takeWhile(Predicate<? super T> predicate) { return new RefStream<T>(new StreamSupport.TakeWhile<T>(take(), predicate)); }
    public Stream<T> dropWhile(Predicate<? super T> predicate) { return new RefStream<T>(new StreamSupport.DropWhile<T>(take(), predicate)); }

    public void forEach(Consumer<? super T> action) {
        Objects.requireNonNull(action);
        Iterator<T> it = take();
        while (it.hasNext())
            action.accept(it.next());
    }

    public void forEachOrdered(Consumer<? super T> action) { forEach(action); }

    public Object[] toArray() { return StreamSupport.drain(take()).toArray(); }

    public <A> A[] toArray(IntFunction<A[]> generator) {
        ArrayList<T> all = StreamSupport.drain(take());
        A[] arr = generator.apply(all.size());
        if (arr.length != all.size())
            throw new IllegalStateException("Begin size " + all.size() + " is not equal to fixed size " + arr.length);
        for (int i = 0; i < arr.length; i++) {
            @SuppressWarnings("unchecked")
            A a = (A) all.get(i);
            arr[i] = a;
        }
        return arr;
    }

    public T reduce(T identity, BinaryOperator<T> accumulator) {
        T result = identity;
        Iterator<T> it = take();
        while (it.hasNext())
            result = accumulator.apply(result, it.next());
        return result;
    }

    public Optional<T> reduce(BinaryOperator<T> accumulator) {
        Iterator<T> it = take();
        if (!it.hasNext())
            return Optional.empty();
        T result = it.next();
        while (it.hasNext())
            result = accumulator.apply(result, it.next());
        return Optional.of(result);
    }

    public <U> U reduce(U identity, BiFunction<U, ? super T, U> accumulator, BinaryOperator<U> combiner) {
        U result = identity;
        Iterator<T> it = take();
        while (it.hasNext())
            result = accumulator.apply(result, it.next());
        return result;
    }

    public <R> R collect(Supplier<R> supplier, BiConsumer<R, ? super T> accumulator, BiConsumer<R, R> combiner) {
        R container = supplier.get();
        Iterator<T> it = take();
        while (it.hasNext())
            accumulator.accept(container, it.next());
        return container;
    }

    public <R, A> R collect(Collector<? super T, A, R> collector) {
        A container = collector.supplier().get();
        BiConsumer<A, ? super T> accumulator = collector.accumulator();
        Iterator<T> it = take();
        while (it.hasNext())
            accumulator.accept(container, it.next());
        return collector.finisher().apply(container);
    }

    public List<T> toList() { return Collections.unmodifiableList(StreamSupport.drain(take())); }

    public Optional<T> min(Comparator<? super T> comparator) {
        return reduce((a, b) -> comparator.compare(a, b) <= 0 ? a : b);
    }

    public Optional<T> max(Comparator<? super T> comparator) {
        return reduce((a, b) -> comparator.compare(a, b) >= 0 ? a : b);
    }

    public long count() {
        long n = 0;
        Iterator<T> it = take();
        while (it.hasNext()) {
            it.next();
            n++;
        }
        return n;
    }

    public boolean anyMatch(Predicate<? super T> predicate) {
        Iterator<T> it = take();
        while (it.hasNext())
            if (predicate.test(it.next()))
                return true;
        return false;
    }

    public boolean allMatch(Predicate<? super T> predicate) {
        Iterator<T> it = take();
        while (it.hasNext())
            if (!predicate.test(it.next()))
                return false;
        return true;
    }

    public boolean noneMatch(Predicate<? super T> predicate) { return !anyMatch(predicate); }

    public Optional<T> findFirst() {
        Iterator<T> it = take();
        return it.hasNext() ? Optional.of(it.next()) : Optional.empty();
    }

    public Optional<T> findAny() { return findFirst(); }
}
)JAVA"},
        {"Stream.java", R"JAVA(package java.util.stream;

import java.util.*;
import java.util.function.*;

public interface Stream<T> extends BaseStream<T, Stream<T>> {
    Stream<T> filter(Predicate<? super T> predicate);
    <R> Stream<R> map(Function<? super T, ? extends R> mapper);
    IntStream mapToInt(ToIntFunction<? super T> mapper);
    LongStream mapToLong(ToLongFunction<? super T> mapper);
    DoubleStream mapToDouble(ToDoubleFunction<? super T> mapper);
    <R> Stream<R> flatMap(Function<? super T, ? extends Stream<? extends R>> mapper);
    IntStream flatMapToInt(Function<? super T, ? extends IntStream> mapper);
    <R> Stream<R> mapMulti(BiConsumer<? super T, ? super Consumer<R>> mapper);
    Stream<T> distinct();
    Stream<T> sorted();
    Stream<T> sorted(Comparator<? super T> comparator);
    Stream<T> peek(Consumer<? super T> action);
    Stream<T> limit(long maxSize);
    Stream<T> skip(long n);
    Stream<T> takeWhile(Predicate<? super T> predicate);
    Stream<T> dropWhile(Predicate<? super T> predicate);
    void forEach(Consumer<? super T> action);
    void forEachOrdered(Consumer<? super T> action);
    Object[] toArray();
    <A> A[] toArray(IntFunction<A[]> generator);
    T reduce(T identity, BinaryOperator<T> accumulator);
    Optional<T> reduce(BinaryOperator<T> accumulator);
    <U> U reduce(U identity, BiFunction<U, ? super T, U> accumulator, BinaryOperator<U> combiner);
    <R> R collect(Supplier<R> supplier, BiConsumer<R, ? super T> accumulator, BiConsumer<R, R> combiner);
    <R, A> R collect(Collector<? super T, A, R> collector);
    List<T> toList();
    Optional<T> min(Comparator<? super T> comparator);
    Optional<T> max(Comparator<? super T> comparator);
    long count();
    boolean anyMatch(Predicate<? super T> predicate);
    boolean allMatch(Predicate<? super T> predicate);
    boolean noneMatch(Predicate<? super T> predicate);
    Optional<T> findFirst();
    Optional<T> findAny();

    public static <T> Stream<T> empty() { return new RefStream<T>(Collections.<T>emptyIterator()); }
    public static <T> Stream<T> of(T t) { return StreamSupport.$ofArray(new Object[] {t}, 0, 1); }
    public static <T> Stream<T> ofNullable(T t) { return t == null ? Stream.empty() : Stream.of(t); }

    @SafeVarargs
    @SuppressWarnings("varargs")
    public static <T> Stream<T> of(T... values) { return StreamSupport.$ofArray(values, 0, values.length); }

    public static <T> Stream<T> iterate(final T seed, final UnaryOperator<T> f) {
        Objects.requireNonNull(f);
        return new RefStream<T>(new Iterator<T>() {
            T prev;
            boolean started;
            public boolean hasNext() { return true; }
            public T next() {
                prev = started ? f.apply(prev) : seed;
                started = true;
                return prev;
            }
        });
    }

    public static <T> Stream<T> iterate(T seed, Predicate<? super T> hasNext, UnaryOperator<T> next) {
        Objects.requireNonNull(next);
        Objects.requireNonNull(hasNext);
        return new RefStream<T>(new Iterator<T>() {
            T current;
            boolean started, finished, ready;
            public boolean hasNext() {
                if (ready)
                    return true;
                if (finished)
                    return false;
                T t = started ? next.apply(current) : seed;
                started = true;
                if (!hasNext.test(t)) {
                    finished = true;
                    current = null;
                    return false;
                }
                current = t;
                ready = true;
                return true;
            }
            public T next() {
                if (!hasNext())
                    throw new NoSuchElementException();
                ready = false;
                return current;
            }
        });
    }

    public static <T> Stream<T> generate(Supplier<? extends T> s) {
        Objects.requireNonNull(s);
        return new RefStream<T>(new Iterator<T>() {
            public boolean hasNext() { return true; }
            public T next() { return s.get(); }
        });
    }

    @SuppressWarnings("unchecked")
    public static <T> Stream<T> concat(Stream<? extends T> a, Stream<? extends T> b) {
        Objects.requireNonNull(a);
        Objects.requireNonNull(b);
        Iterator<T> ia = (Iterator<T>) a.iterator(), ib = (Iterator<T>) b.iterator();
        return new RefStream<T>(new Iterator<T>() {
            public boolean hasNext() { return ia.hasNext() || ib.hasNext(); }
            public T next() { return ia.hasNext() ? ia.next() : ib.next(); }
        });
    }

    public static <T> Builder<T> builder() { return new StreamSupport.BuilderImpl<T>(); }

    public interface Builder<T> extends Consumer<T> {
        void accept(T t);

        default Builder<T> add(T t) {
            accept(t);
            return this;
        }

        Stream<T> build();
    }
}
)JAVA"},
        {"StreamSupport.java", R"JAVA(package java.util.stream;

import java.util.*;
import java.util.function.*;

// ─── implementation ─────────────────────────────────────────────────────────

public final class StreamSupport {
    private StreamSupport() {}

    // a stream over a collection: its iterator is taken when the pipeline first pulls
    public static <T> Stream<T> $of(Iterable<T> source) {
        return new RefStream<T>(new Iterator<T>() {
            Iterator<T> it;
            public boolean hasNext() {
                if (it == null)
                    it = source.iterator();
                return it.hasNext();
            }
            public T next() {
                if (it == null)
                    it = source.iterator();
                return it.next();
            }
        });
    }

    @SuppressWarnings("unchecked")
    public static <T> Stream<T> $ofArray(Object[] a, int from, int to) {
        return new RefStream<T>(new Iterator<T>() {
            int i = from;
            public boolean hasNext() { return i < to; }
            public T next() {
                if (i >= to)
                    throw new NoSuchElementException();
                return (T) a[i++];
            }
        });
    }

    public static IntStream $intsOfArray(int[] a, int from, int to) {
        return new IntStreamImpl(new Iterator<Integer>() {
            int i = from;
            public boolean hasNext() { return i < to; }
            public Integer next() {
                if (i >= to)
                    throw new NoSuchElementException();
                return a[i++];
            }
        });
    }

    public static LongStream $longsOfArray(long[] a, int from, int to) {
        return new LongStreamImpl(new Iterator<Long>() {
            int i = from;
            public boolean hasNext() { return i < to; }
            public Long next() {
                if (i >= to)
                    throw new NoSuchElementException();
                return a[i++];
            }
        });
    }

    public static DoubleStream $doublesOfArray(double[] a, int from, int to) {
        return new DoubleStreamImpl(new Iterator<Double>() {
            int i = from;
            public boolean hasNext() { return i < to; }
            public Double next() {
                if (i >= to)
                    throw new NoSuchElementException();
                return a[i++];
            }
        });
    }

    public static <T> Stream<T> stream(Iterable<T> source, boolean parallel) { return $of(source); }

    static final class BuilderImpl<T> implements Stream.Builder<T> {
        private final ArrayList<T> items = new ArrayList<>();
        private boolean built;

        public void accept(T t) {
            if (built)
                throw new IllegalStateException();
            items.add(t);
        }

        public Stream<T> build() {
            if (built)
                throw new IllegalStateException();
            built = true;
            return items.stream();
        }
    }

    // ── shared stages ──

    static final class Filter<T> implements Iterator<T> {
        private final Iterator<T> src;
        private final Predicate<? super T> p;
        private T nextVal;
        private boolean ready;

        Filter(Iterator<T> src, Predicate<? super T> p) {
            this.src = src;
            this.p = p;
        }

        public boolean hasNext() {
            while (!ready && src.hasNext()) {
                T t = src.next();
                if (p.test(t)) {
                    nextVal = t;
                    ready = true;
                }
            }
            return ready;
        }

        public T next() {
            if (!hasNext())
                throw new NoSuchElementException();
            ready = false;
            T t = nextVal;
            nextVal = null;
            return t;
        }
    }

    static final class Map<T, R> implements Iterator<R> {
        private final Iterator<T> src;
        private final Function<? super T, ? extends R> f;

        Map(Iterator<T> src, Function<? super T, ? extends R> f) {
            this.src = src;
            this.f = f;
        }

        public boolean hasNext() { return src.hasNext(); }
        public R next() { return f.apply(src.next()); }
    }

    static final class Peek<T> implements Iterator<T> {
        private final Iterator<T> src;
        private final Consumer<? super T> action;

        Peek(Iterator<T> src, Consumer<? super T> action) {
            this.src = src;
            this.action = action;
        }

        public boolean hasNext() { return src.hasNext(); }

        public T next() {
            T t = src.next();
            action.accept(t);
            return t;
        }
    }

    static final class Limit<T> implements Iterator<T> {
        private final Iterator<T> src;
        private final long max;
        private long count;

        Limit(Iterator<T> src, long max) {
            if (max < 0)
                throw new IllegalArgumentException(Long.toString(max));
            this.src = src;
            this.max = max;
        }

        public boolean hasNext() { return count < max && src.hasNext(); }

        public T next() {
            if (count >= max)
                throw new NoSuchElementException();
            count++;
            return src.next();
        }
    }

    static final class Skip<T> implements Iterator<T> {
        private final Iterator<T> src;
        private long n;

        Skip(Iterator<T> src, long n) {
            if (n < 0)
                throw new IllegalArgumentException(Long.toString(n));
            this.src = src;
            this.n = n;
        }

        private void skip() {
            while (n > 0 && src.hasNext()) {
                src.next();
                n--;
            }
            n = 0;
        }

        public boolean hasNext() {
            skip();
            return src.hasNext();
        }

        public T next() {
            skip();
            return src.next();
        }
    }

    static final class Distinct<T> implements Iterator<T> {
        private final Iterator<T> src;
        private final HashSet<T> seen = new HashSet<>();
        private T nextVal;
        private boolean ready;

        Distinct(Iterator<T> src) { this.src = src; }

        public boolean hasNext() {
            while (!ready && src.hasNext()) {
                T t = src.next();
                if (seen.add(t)) {
                    nextVal = t;
                    ready = true;
                }
            }
            return ready;
        }

        public T next() {
            if (!hasNext())
                throw new NoSuchElementException();
            ready = false;
            return nextVal;
        }
    }

    static final class TakeWhile<T> implements Iterator<T> {
        private final Iterator<T> src;
        private final Predicate<? super T> p;
        private T nextVal;
        private boolean ready, done;

        TakeWhile(Iterator<T> src, Predicate<? super T> p) {
            this.src = src;
            this.p = p;
        }

        public boolean hasNext() {
            if (ready)
                return true;
            if (done || !src.hasNext())
                return false;
            T t = src.next();
            if (!p.test(t)) {
                done = true;
                return false;
            }
            nextVal = t;
            ready = true;
            return true;
        }

        public T next() {
            if (!hasNext())
                throw new NoSuchElementException();
            ready = false;
            return nextVal;
        }
    }

    static final class DropWhile<T> implements Iterator<T> {
        private final Iterator<T> src;
        private final Predicate<? super T> p;
        private T nextVal;
        private boolean ready, dropping = true;

        DropWhile(Iterator<T> src, Predicate<? super T> p) {
            this.src = src;
            this.p = p;
        }

        public boolean hasNext() {
            if (ready)
                return true;
            while (src.hasNext()) {
                T t = src.next();
                if (dropping && p.test(t))
                    continue;
                dropping = false;
                nextVal = t;
                ready = true;
                return true;
            }
            return false;
        }

        public T next() {
            if (!hasNext())
                throw new NoSuchElementException();
            ready = false;
            return nextVal;
        }
    }

    static final class FlatMap<T, R> implements Iterator<R> {
        private final Iterator<T> src;
        private final Function<? super T, ? extends Iterator<? extends R>> f;
        private Iterator<? extends R> current;

        FlatMap(Iterator<T> src, Function<? super T, ? extends Iterator<? extends R>> f) {
            this.src = src;
            this.f = f;
        }

        public boolean hasNext() {
            while (current == null || !current.hasNext()) {
                if (!src.hasNext())
                    return false;
                current = f.apply(src.next());
            }
            return true;
        }

        public R next() {
            if (!hasNext())
                throw new NoSuchElementException();
            return current.next();
        }
    }

    // ── shared terminal helpers ──

    static <T> ArrayList<T> drain(Iterator<T> it) {
        ArrayList<T> out = new ArrayList<>();
        while (it.hasNext())
            out.add(it.next());
        return out;
    }

    static double[] sumWithCompensation(double[] intermediateSum, double value) {
        double tmp = value - intermediateSum[1];
        double sum = intermediateSum[0];
        double velvel = sum + tmp;
        intermediateSum[1] = (velvel - sum) - tmp;
        intermediateSum[0] = velvel;
        return intermediateSum;
    }

    static double computeFinalSum(double[] summands) {
        double tmp = summands[0] - summands[1];
        double simpleSum = summands[summands.length - 1];
        if (Double.isNaN(tmp) && Double.isInfinite(simpleSum))
            return simpleSum;
        else
            return tmp;
    }
}
)JAVA"},
    };
    return items;
}
} // namespace java
