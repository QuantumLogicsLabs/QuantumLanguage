    public HashMap(int initialCapacity) { this(initialCapacity, DEFAULT_LOAD_FACTOR); }

    public HashMap() { this.loadFactor = DEFAULT_LOAD_FACTOR; }

    public HashMap(Map<? extends K, ? extends V> m) {
