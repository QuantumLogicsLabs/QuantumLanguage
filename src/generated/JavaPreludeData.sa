            case '¢': case '£': case '¤': case '¥': return CURRENCY_SYMBOL;
            case '¬': case '±': case '×': case '÷': return MATH_SYMBOL;
            case '¨': case '¯': case '´': case '¸': return MODIFIER_SYMBOL;
            case '²': case '³': case '¹': case '¼': case '½': case '¾': return OTHER_NUMBER;
        }
