            for (int i = 0; i < size; i++)
                if (es[i] == null)
                    return i;
        } else {
            for (int i = 0; i < size; i++)
                if (o.equals(es[i]))
                    return i;
        }
        return -1;
    }

    public int lastIndexOf(Object o) {
        Object[] es = elementData;
        if (o == null) {
            for (int i = size - 1; i >= 0; i--)
                if (es[i] == null)
                    return i;
        } else {
            for (int i = size - 1; i >= 0; i--)
                if (o.equals(es[i]))
                    return i;
        }
        return -1;
    }

    public Object clone() {
        ArrayList<E> v = new ArrayList<>(this);
        return v;
    }

    public Object[] toArray() { return java.util.Arrays.copyOf(elementData, size); }

