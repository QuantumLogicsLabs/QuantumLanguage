    public static void fill(char[] a, int fromIndex, int toIndex, char val) { fill((Object) a, fromIndex, toIndex, (int) val); }
    public static void fill(boolean[] a, int fromIndex, int toIndex, boolean val) { fill((Object) a, fromIndex, toIndex, val); }
    public static void fill(double[] a, int fromIndex, int toIndex, double val) { fill((Object) a, fromIndex, toIndex, val); }
    public static void fill(Object[] a, int fromIndex, int toIndex, Object val) { fill((Object) a, fromIndex, toIndex, val); }

    public static <T> void setAll(T[] array, IntFunction<? extends T> generator) {
        for (int i = 0; i < array.length; i++)
