  def self.dirname(p, *)
    s = __path(p).tr("\\", "/").sub(%r{/+\z}, "")
    i = s.rindex("/")
    return s.empty? ? "/" : "." unless i
    i == 0 ? "/" : s[0...i].sub(%r{/+\z}, "")
  end

  def self.extname(p)
    b = basename(p)
    i = b.rindex(".")
    i && i > 0 && i < b.size - 1 ? b[i..] : ""
  end

  def self.split(p) = [dirname(p), basename(p)]

  def self.join(*parts)
    list = parts.flatten.map { |x| __path(x) }
    out = +""
    list.each_with_index do |x, i|
      if i == 0
        out << x
      else
        out = out.sub(%r{/+\z}, "") << "/" << x.sub(%r{\A/+}, "")
      end
    end
    out
  end

  def self.absolute_path?(p) = __path(p) =~ %r{\A([A-Za-z]:)?[/\\]} ? true : false

  def self.expand_path(p, dir = nil)
    s = __path(p).tr("\\", "/")
    s = s.sub(/\A~/, ENV["HOME"] || ENV["USERPROFILE"] || "~")
    unless absolute_path?(s)
      s = "#{dir ? expand_path(dir) : Dir.pwd.tr("\\", "/")}/#{s}"
    end
    drive = s[%r{\A[A-Za-z]:}] || ""
    out = []
    s.delete_prefix(drive).split("/").each do |seg|
      next if seg.empty? || seg == "."
      seg == ".." ? out.pop : out << seg
    end
    "#{drive}/#{out.join("/")}"
  end
  singleton_class.alias_method(:absolute_path, :expand_path)
  singleton_class.alias_method(:realpath, :expand_path)

  def self.open(path, mode = nil, *rest, **kw)
