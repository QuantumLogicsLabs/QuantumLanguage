class Dir
  include Enumerable

  attr_reader :path
  alias to_path path

  def self.open(p)
    d = new(p)
    return d unless block_given?
    yield d
  end

  def self.home(*) = ENV["HOME"] || ENV["USERPROFILE"] || "/"
  def self.tmpdir = ENV["TEMP"] || ENV["TMP"] || "/tmp"

  def self.chdir(p = home)
    old = pwd
    __dir_change(File.__path(p))
    return 0 unless block_given?
    begin
      yield p
    ensure
      __dir_change(old)
    end
  end

  def initialize(p)
    raise Errno::ENOENT, "@ dir_initialize - #{p}" unless Dir.exist?(p)
    @path = p
    @names = Dir.entries(p)
    @pos = 0
  end

  def read
    n = @names[@pos]
    @pos += 1 if n
    n
  end

