      elsif v.include?("'") && !v.include?("\"") && !v.include?("\\")
        "\"#{v}\""
      else
        "'#{v.gsub("'", "''")}'"
      end
    else
      __scalar(v.to_s)
    end
  end

  # the entries of a collection; `inline`: the first one continues the current line
  def self.__emit(v, ind, out, inline)
