      else
        out << " " << __scalar(x) << "\n"
      end
    when nil
      out << "\n"
    else
      out << " " << __scalar(x) << "\n"
    end
  end

  def self.dump(v, *)
    out = +"---"
    if (v.is_a?(Hash) || v.is_a?(Array)) && !v.empty?
      out << "\n"
      __emit(v, 0, out, false)
    else
      __value(v, 0, out)
    end
    out
  end
end
YAML = Psych

class Object
  def to_yaml(*) = Psych.dump(self)
end
