    def flow_or_scalar(s)
      return scalar(s) unless flow_start?(s)
      @f = s
      @p = 0
      flow_value
    end

    def fws
      @p += 1 while @p < @f.size && @f[@p] == " "
    end

    def flow_value
      fws
      c = @f[@p]
      if c == "["
        @p += 1
        out = []
        loop do
          fws
          if @f[@p] == "]"
            @p += 1
            return out
          end
          out << flow_value
          fws
          @p += 1 if @f[@p] == ","
          raise SyntaxError, "did not find expected ',' or ']'" if @p >= @f.size
        end
      elsif c == "{"
        @p += 1
        out = {}
        loop do
          fws
          if @f[@p] == "}"
            @p += 1
            return out
          end
          key = scalar(flow_token(":"))
          key = key.to_sym if @sym && key.is_a?(String)
          fws
          @p += 1 if @f[@p] == ":"
          out[key] = flow_value
          fws
          @p += 1 if @f[@p] == ","
          raise SyntaxError, "did not find expected ',' or '}'" if @p >= @f.size
        end
      else
        scalar(flow_token(nil))
      end
    end

    def flow_token(stop)
      fws
      c = @f[@p]
      if c == '"' || c == "'"
        e = @p + 1
        e += 1 while e < @f.size && @f[e] != c
        t = @f[@p..e]
        @p = e + 1
        return t
      end
      st = @p
      while @p < @f.size
        ch = @f[@p]
        break if ch == "," || ch == "]" || ch == "}"
        break if ch == ":" && stop && (@f[@p + 1] == " " || @f[@p + 1].nil?)
        @p += 1
      end
      @f[st...@p].strip
    end

    def scalar(s)
      return unquote_d(s[1...-1]) if s.start_with?('"') && s.end_with?('"') && s.size >= 2
      return s[1...-1].gsub("''", "'") if s.start_with?("'") && s.end_with?("'") && s.size >= 2
      case s
      when "", "~", "null", "Null", "NULL" then nil
      when "true", "True", "TRUE", "yes", "Yes", "YES", "on", "On", "ON" then true
      when "false", "False", "FALSE", "no", "No", "NO", "off", "Off", "OFF" then false
      when /\A[-+]?(0|[1-9][0-9_,]*)\z/ then s.delete("_,").to_i
      when /\A0[0-7_,]+\z/ then s.delete("_,").to_i(8)
      when /\A0x[0-9a-fA-F_,]+\z/ then s.delete("_,").to_i(16)
      when /\A[-+]?([0-9][0-9_,]*)?\.[0-9]*([eE][-+][0-9]+)?\z/
        s == "." ? s : s.delete("_,").to_f
      when /\A[-+]?[0-9][0-9_,]*(\.[0-9]*)?[eE][-+]?[0-9]+\z/ then s.delete("_,").to_f
      when /\A\+?\.(inf|Inf|INF)\z/ then Float::INFINITY
      when /\A-\.(inf|Inf|INF)\z/ then -Float::INFINITY
      when /\A\.(nan|NaN|NAN)\z/ then Float::NAN
