        {"yaml.sa", R"QRUBYLIB(# A YAML subset: block and flow collections, plain and quoted scalars.
module Psych
  class Exception < ::RuntimeError; end
  class SyntaxError < Exception; end
  class DisallowedClass < Exception; end
  class BadAlias < Exception; end

  class Loader
    def initialize(src, sym)
      @sym = sym
      @lines = []
      src.each_line do |raw|
        l = raw.chomp
        st = l.strip
        next if st.empty? || st.start_with?("#") || st == "---" || st == "..."
        @lines << l.sub(/\A---\s+/, "")
      end
      @i = 0
    end

    def indent_of(l) = l[/\A */].size

    def load
      return nil if @lines.empty?
      block(indent_of(@lines[0]))
    end

    def strip_comment(s)
      q = nil
      s.each_char.with_index do |c, i|
        if q
          q = nil if c == q
        elsif c == "'" || c == '"'
          q = c if i == 0 || " :[,{".include?(s[i - 1])
        elsif c == "#" && i > 0 && s[i - 1] == " "
          return s[0...i].rstrip
        end
      end
      s.rstrip
    end

    def block(ind)
      body = @lines[@i].strip
      if body.start_with?("- ") || body == "-"
        sequence(ind)
      elsif key_split(strip_comment(body))
        mapping(ind)
      else
        @i += 1
        flow_or_scalar(strip_comment(body))
      end
    end

    def sequence(ind)
      out = []
      while @i < @lines.size
        l = @lines[@i]
        break if indent_of(l) != ind
        body = l.strip
        break unless body.start_with?("- ") || body == "-"
        rest = body == "-" ? "" : strip_comment(body[2..].strip)
        if rest.empty?
          @i += 1
          if @i < @lines.size && indent_of(@lines[@i]) > ind
            out << block(indent_of(@lines[@i]))
          else
            out << nil
          end
        elsif (rest.start_with?("- ") || key_split(rest)) && !flow_start?(rest)
          # an inline collection: its column is where the content starts
          col = l.index(rest, ind + 1)
          @lines[@i] = " " * col + rest
          out << block(col)
        else
          @i += 1
          out << value_text(rest, ind)
        end
      end
      out
    end

    def flow_start?(s) = s.start_with?("[") || s.start_with?("{")

    def key_split(s)
      return nil if s.start_with?("[") || s.start_with?("{")
      if s.start_with?('"') || s.start_with?("'")
        e = s.index(s[0], 1)
        return nil unless e
        rest = s[(e + 1)..].lstrip
        return nil unless rest.start_with?(":")
        return [s[0..e], rest[1..].strip]
      end
      i = s.index(": ")
      return [s[0...i], s[(i + 2)..].strip] if i
      return [s[0...-1], ""] if s.end_with?(":")
      nil
    end

    def mapping(ind)
      out = {}
      while @i < @lines.size
        l = @lines[@i]
        break if indent_of(l) != ind
        body = strip_comment(l.strip)
        break if body.start_with?("- ")
        kv = key_split(body)
        raise SyntaxError, "could not find expected ':' at line #{@i + 1}" unless kv
        key = scalar(kv[0])
        key = key.to_sym if @sym && key.is_a?(String)
        rest = kv[1]
        @i += 1
        if !rest.empty?
          out[key] = value_text(rest, ind)
        elsif @i < @lines.size
          nxt = @lines[@i]
          ni = indent_of(nxt)
          if ni > ind
            out[key] = block(ni)
          elsif ni == ind && (nxt.strip.start_with?("- ") || nxt.strip == "-")
            out[key] = sequence(ind)
          else
            out[key] = nil
          end
        else
          out[key] = nil
        end
      end
      out
    end

    def value_text(rest, ind)
      if %w[| |- |+ > >-].include?(rest)
        block_scalar(rest, ind)
      else
        flow_or_scalar(rest)
      end
    end

    def block_scalar(style, ind)
      parts = []
      bi = nil
      while @i < @lines.size
        l = @lines[@i]
        cur = indent_of(l)
        break if cur <= ind
        bi ||= cur
        parts << l[bi..]
        @i += 1
      end
      text = style.start_with?("|") ? parts.join("\n") : parts.join(" ")
      style.end_with?("-") ? text : text + "\n"
