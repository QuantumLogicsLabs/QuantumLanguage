  def self.__missing(p, what = "rb_sysopen") = raise(Errno::ENOENT, "@ #{what} - #{p}")

  def self.size(p)
    q = __path(p)
    __missing(q, "rb_file_s_size") unless exist?(q)
    __file_read(q).bytesize
  end

  def self.size?(p)
    return nil unless exist?(p)
    s = size(p)
    s == 0 ? nil : s
