      n = v.size
      "{" + v.each_with_index.map do |(k, x), i|
        key = __key(k)
        t = i == n - 1 ? tail + 1 : 1
        one = x.inspect
        if inner + key.size + 1 + one.size + t <= @width
          "#{key} #{one}"
        else
          "#{key}\n#{' ' * (inner + 1)}#{layout(x, inner + 1, t)}"
        end
      end.join(",\n" + " " * inner) + "}"
    when Struct
      __fields("#<struct #{v.class.name}", v.members.zip(v.to_a), col, tail)
    else
      if defined?(Set) && v.is_a?(Set)
        return flat if v.empty?
        body = "{" + v.to_a.map(&:inspect).join(", ") + "}"
        return "#<Set:\n #{' ' * col}#{body}>" if col + 1 + body.size + tail + 1 <= @width
