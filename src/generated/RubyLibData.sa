      when /\A:([a-zA-Z_][a-zA-Z0-9_]*[?!]?)\z/ then $1.to_sym
      else s
      end
    end

    def unquote_d(s)
      s.gsub(/\\(.)/) do
        case $1
        when "n" then "\n"
        when "t" then "\t"
        when "r" then "\r"
        when "e" then "\e"
        when "0" then "\0"
        else $1
        end
      end
    end
  end

  def self.safe_load(src, permitted_classes: [], permitted_symbols: [], aliases: false, symbolize_names: false, **)
    Loader.new(src, symbolize_names).load
  end

  def self.load(src, symbolize_names: false, **) = Loader.new(src, symbolize_names).load
  def self.unsafe_load(src, **o) = load(src, **o)
  def self.parse(src) = load(src)

  def self.__plain?(s)
    return false if s.empty?
    return false if s =~ /\A\s|\s\z/
    return false if s =~ /\A[-?:](\s|\z)/
    return false if s =~ /\A[!&*\[\]{}|>@`"'%#,]/
    return false if s =~ /: |:\z| #/
    return false if s =~ /\A(~|null|Null|NULL|true|True|TRUE|false|False|FALSE|yes|Yes|YES|no|No|NO|on|On|ON|off|Off|OFF|y|Y|n|N)\z/
    return false if s =~ /\A[-+]?[0-9][0-9_,]*(\.[0-9_]*)?([eE][-+]?[0-9]+)?\z/
    return false if s =~ /\A[-+]?\.[0-9]+/
    return false if s =~ /\A0[xob]/
    return false if s =~ /\A:/
    true
  end

  def self.__scalar(v)
