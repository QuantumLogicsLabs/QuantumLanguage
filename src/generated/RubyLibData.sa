      elsif defined?(Data) && v.is_a?(Data)
        name = v.class.name
        __fields("#<data #{name}".rstrip, v.class.members.map { |m| [m, v.public_send(m)] }, col, tail)
      else
        ivs = v.instance_variables
        return flat if ivs.empty? || v.method(:inspect).owner != Kernel
        head = Kernel.instance_method(:to_s).bind_call(v).chomp(">")
        __fields(head, ivs.sort.map { |iv| [iv, v.instance_variable_get(iv)] }, col, tail)
      end
    end
