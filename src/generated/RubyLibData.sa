    when Hash
      if x.empty?
        out << " {}\n"
      else
        out << "\n"
        __emit(x, ind + 1, out, false)
      end
    when Array
      if x.empty?
        out << " []\n"
      else
        out << "\n"
        __emit(x, ind, out, false)
      end
    when String
