        {"thread.sa", R"QRUBYLIB(# Thread's synchronisation classes, over Thread.__wait (RubyThread.sa).
Thread = __thread_class

class Thread
  class Mutex
    def initialize
      @owner = nil
    end

    def locked? = !@owner.nil?
    def owned? = @owner.equal?(Thread.current)

    def try_lock
      return false if @owner
      @owner = Thread.current
      true
    end

    def lock
      raise ThreadError, "deadlock; recursive locking" if owned?
      Thread.__wait { @owner.nil? } if @owner
      @owner = Thread.current
      self
    end

    def unlock
      raise ThreadError, "Attempt to unlock a mutex which is not locked" unless @owner
      raise ThreadError, "Attempt to unlock a mutex which is locked by another thread/fiber" unless owned?
      @owner = nil
      self
    end

    def synchronize
      lock
      begin
        yield
      ensure
        unlock if owned?
      end
    end

    def sleep(timeout = nil)
      unlock
      begin
        Kernel.sleep(*[timeout].compact)
      ensure
        lock
      end
    end
  end

  class ConditionVariable
    def initialize
      @waiters = []
    end

    def wait(mutex, timeout = nil)
      token = [false]
      @waiters << token
      mutex.unlock
      begin
        Thread.__wait(timeout) { token[0] }
      ensure
        @waiters.delete_if { |t| t.equal?(token) }
        mutex.lock
      end
      self
    end

    def signal
      t = @waiters.shift
      t[0] = true if t
      self
    end

    def broadcast
      @waiters.each { |t| t[0] = true }
      @waiters.clear
      self
    end
  end

  class Queue
    def initialize(items = nil)
      @items = items ? items.to_a.dup : []
      @closed = false
      @waiting = 0
    end

    def size = @items.size
    alias length size
    def empty? = @items.empty?
    def num_waiting = @waiting
    def closed? = @closed

    def clear
      @items.clear
      self
    end

    def close
      @closed = true
      self
    end

    def push(x)
      raise ClosedQueueError, "queue closed" if @closed
      @items.push(x)
      self
    end
    alias << push
    alias enq push

    def pop(non_block = false, timeout: nil)
      if @items.empty?
        raise ThreadError, "queue empty" if non_block
        return nil if @closed
        @waiting += 1
        begin
          Thread.__wait(timeout) { !@items.empty? || @closed }
        ensure
          @waiting -= 1
        end
      end
      @items.shift
    end
    alias shift pop
    alias deq pop

    def freeze = raise(TypeError, "cannot freeze #<Thread::Queue>")
  end

  class SizedQueue < Queue
    attr_reader :max

    def initialize(max)
      raise ArgumentError, "queue size must be positive" unless max > 0
      super()
      @max = max
    end

    def max=(n)
      @max = n
    end

    def push(x, non_block = false, timeout: nil)
      raise ClosedQueueError, "queue closed" if @closed
      if @items.size >= @max
        raise ThreadError, "queue full" if non_block
        @waiting += 1
        ok = begin
          Thread.__wait(timeout) { @items.size < @max || @closed }
        ensure
          @waiting -= 1
        end
        return nil unless ok
        raise ClosedQueueError, "queue closed" if @closed
      end
      @items.push(x)
      self
    end
    alias << push
    alias enq push
  end
end

Mutex = Thread::Mutex
Queue = Thread::Queue
SizedQueue = Thread::SizedQueue
ConditionVariable = Thread::ConditionVariable

class Monitor
  def initialize
    @mon_owner = nil
    @mon_count = 0
  end

  def enter
    me = Thread.current
    if @mon_owner.equal?(me)
      @mon_count += 1
    else
      Thread.__wait { @mon_owner.nil? } if @mon_owner
      @mon_owner = me
      @mon_count = 1
    end
    nil
  end
  alias mon_enter enter

  def try_enter
    return false if @mon_owner && !@mon_owner.equal?(Thread.current)
    enter
    true
  end
  alias mon_try_enter try_enter
  alias try_mon_enter try_enter

  def exit
    raise ThreadError, "current thread not owner" unless @mon_owner.equal?(Thread.current)
    @mon_count -= 1
    @mon_owner = nil if @mon_count == 0
    nil
  end
  alias mon_exit exit

  def mon_locked? = !@mon_owner.nil?
  def mon_owned? = @mon_owner.equal?(Thread.current)

  def synchronize
    enter
    begin
      yield
    ensure
      self.exit
    end
  end
  alias mon_synchronize synchronize

  def new_cond = MonitorMixin::ConditionVariable.new(self)

  def __release
    c = @mon_count
    @mon_owner = nil
    @mon_count = 0
    c
  end

  def __reacquire(count)
    Thread.__wait { @mon_owner.nil? } if @mon_owner
    @mon_owner = Thread.current
    @mon_count = count
  end
end

module MonitorMixin
  class ConditionVariable
    def initialize(monitor)
      @monitor = monitor
      @waiters = []
    end

    def wait(timeout = nil)
      token = [false]
      @waiters << token
      count = @monitor.__release
      begin
        Thread.__wait(timeout) { token[0] }
      ensure
        @waiters.delete_if { |t| t.equal?(token) }
        @monitor.__reacquire(count)
      end
      true
    end

    def wait_while
      wait while yield
    end

    def wait_until
      wait until yield
    end

    def signal
      t = @waiters.shift
      t[0] = true if t
      self
    end

    def broadcast
      @waiters.each { |t| t[0] = true }
      @waiters.clear
      self
    end
  end

  def __monitor = (@__monitor ||= Monitor.new)
  def mon_enter = __monitor.enter
  def mon_exit = __monitor.exit
  def mon_try_enter = __monitor.try_enter
  def mon_synchronize(&b) = __monitor.synchronize(&b)
  alias synchronize mon_synchronize
  def new_cond = __monitor.new_cond
  def mon_initialize = @__monitor = Monitor.new
end

# Ractors, as threads: one interpreter lock, the same message passing
class Ractor
  class Error < StandardError; end
  class ClosedError < StopIteration; end
  class RemoteError < Error
    attr_reader :ractor
    def initialize(msg = nil, ractor: nil)
      super(msg)
      @ractor = ractor
    end
  end
  class IsolationError < Error; end
  class MovedError < Error; end

  attr_reader :name

  def self.current = Thread.current[:__ractor] || (@main ||= allocate.__setup_main)
  def self.main = @main ||= allocate.__setup_main
  def self.count = (@live ||= 1)
  def self.receive = current.__receive
  def self.recv = receive
  def self.yield(v)
    current.__out.push(v)
    nil
  end

  def self.make_shareable(x, copy: false)
    case x
    when Array then x.each { |e| make_shareable(e) }
    when Hash then x.each { |k, v| make_shareable(k); make_shareable(v) }
    when Struct then x.to_a.each { |e| make_shareable(e) }
    end
    x.instance_variables.each { |iv| make_shareable(x.instance_variable_get(iv)) }
    x.freeze
  end

  def self.shareable?(x)
    return false unless x.frozen?
    case x
    when Array then x.all? { |e| shareable?(e) }
    when Hash then x.all? { |k, v| shareable?(k) && shareable?(v) }
    else true
    end
  end

  def __setup_main
    @in = Queue.new
    @out = Queue.new
    self
  end

  def initialize(*args, name: nil, &blk)
    raise ArgumentError, "must be called with a block" unless blk
    @name = name
    @in = Queue.new
    @out = Queue.new
    me = self
    @thread = Thread.new do
      Thread.current[:__ractor] = me
      Thread.current.report_on_exception = false
      me.instance_exec(*args, &blk)
    end
  end

  def __receive = @in.pop
  def __out = @out
  def send(v, move: false)
    @in.push(v)
    self
  end
  alias << send

  def take
    return @out.pop unless @out.empty?
    Thread.__wait { !@out.empty? || !@thread.alive? }
    return @out.pop unless @out.empty?
    if @taken
      raise ClosedError, "The outgoing-port is already closed"
    end
    @taken = true
    begin
      @thread.value
    rescue StandardError => e
      err = RemoteError.new("thrown by remote Ractor.", ractor: self)
      raise err, cause: e
    end
  end
  alias value take

  def join
    @thread.join
    self
  end

  def inspect = "#<Ractor:##{__id__}#{@name ? " #{@name}" : ""}>"
  alias to_s inspect
end
)QRUBYLIB"},
        {"time.sa", R"QRUBYLIB(# Time, in Ruby, over native clock and time-zone helpers.
class Time
  include Comparable

  MONTHS = %w[January February March April May June July August September October November December].freeze
  DAYS = %w[Sunday Monday Tuesday Wednesday Thursday Friday Saturday].freeze

  def self.__days(y, m, d)
    a = (14 - m) / 12
    yy = y + 4800 - a
    mm = m + 12 * a - 3
    d + (153 * mm + 2) / 5 + 365 * yy + yy / 4 - yy / 100 + yy / 400 - 32045 - 2440588
  end

  def self.__civil(days)
    a = days + 2440588 + 32044
    b = (4 * a + 3) / 146097
    c = a - 146097 * b / 4
    d = (4 * c + 3) / 1461
    e = c - 1461 * d / 4
    m = (5 * e + 2) / 153
    [100 * b + d - 4800 + m / 10, m + 3 - 12 * (m / 10), e - (153 * m + 2) / 5 + 1]
  end

  def self.now(**) = allocate.__init(Kernel.__wall_clock, nil)
  def self.at(t, *, **) = allocate.__init(t.is_a?(Time) ? t.to_r : t, nil)

  def self.__build(utc, y, m, d, h, mi, s)
    m = MONTHS.index { |n| n[0, 3].downcase == m.downcase } + 1 if m.is_a?(String) && m !~ /\A\d+\z/
    raise ArgumentError, "mon out of range" unless m.to_i.between?(1, 12)
    raise ArgumentError, "mday out of range" unless d.to_i.between?(1, 31)
    raise ArgumentError, "hour out of range" unless h.to_i.between?(0, 24)
    raise ArgumentError, "min out of range" unless mi.to_i.between?(0, 59)
    raise ArgumentError, "sec out of range" unless s.to_f >= 0 && s.to_f < 61
    secs = __days(y.to_i, m.to_i, d.to_i) * 86400 + h.to_i * 3600 + mi.to_i * 60 + s
    return allocate.__init(secs, 0) if utc
    # the offset in force at that wall-clock moment
    off = Kernel.__utc_offset(secs)
    allocate.__init(secs - off, nil)
  end

  def self.new(y = nil, m = 1, d = 1, h = 0, mi = 0, s = 0, zone = nil, **)
    return now if y.nil?
    __build(zone == "UTC" || zone == "Z", y, m, d, h, mi, s)
  end
  def self.local(y, m = 1, d = 1, h = 0, mi = 0, s = 0, *) = __build(false, y, m, d, h, mi, s)
  def self.mktime(*a) = local(*a)
  def self.utc(y, m = 1, d = 1, h = 0, mi = 0, s = 0, *) = __build(true, y, m, d, h, mi, s)
  def self.gm(*a) = utc(*a)

  # offset: nil for local time, else seconds east of UTC
  def __init(secs, offset)
    @t = secs
    @fixed = offset
    @off = offset || Kernel.__utc_offset(secs.floor)
    wall = secs.floor + @off
    days = wall.div(86400)
    rem = wall % 86400
    @year, @month, @day = Time.__civil(days)
    @hour = rem / 3600
    @min = rem % 3600 / 60
    @sec = rem % 60
    @wday = (days + 4) % 7
    @yday = days - Time.__days(@year, 1, 1) + 1
    self
  end

  attr_reader :year, :month, :day, :hour, :min, :sec, :wday, :yday
  alias mon month
  alias mday day

  def to_i = @t.floor
  alias tv_sec to_i
  def to_f = @t.to_f
  def to_r = @t.to_r
  def subsec = @t.to_r - @t.floor
  def usec = (subsec * 1_000_000).floor
  alias tv_usec usec
  def nsec = (subsec * 1_000_000_000).floor
  alias tv_nsec nsec
  def utc_offset = @off
  alias gmt_offset utc_offset
  alias gmtoff utc_offset
  def utc? = @fixed == 0
  alias gmt? utc?
  def zone = utc? ? "UTC" : Kernel.__zone_name
  def dst? = false
  alias isdst dst?
  def utc = __init(@t, 0)
  alias gmtime utc
  def getutc = Time.allocate.__init(@t, 0)
  alias getgm getutc
  def localtime(*) = __init(@t, nil)
  def getlocal(*) = Time.allocate.__init(@t, nil)
  def to_time = self
  def to_a = [sec, min, hour, day, month, year, wday, yday, dst?, zone]

  def sunday? = @wday == 0
  def monday? = @wday == 1
  def tuesday? = @wday == 2
  def wednesday? = @wday == 3
  def thursday? = @wday == 4
  def friday? = @wday == 5
  def saturday? = @wday == 6

  def +(n)
    raise TypeError, "time + time?" if n.is_a?(Time)
    Time.allocate.__init(@t + n, @fixed)
  end

  def -(o)
    return (to_r - o.to_r).to_f if o.is_a?(Time)
    Time.allocate.__init(@t - o, @fixed)
  end

  def <=>(o) = o.is_a?(Time) ? to_r <=> o.to_r : nil
  def ==(o) = o.is_a?(Time) && to_r == o.to_r
  def eql?(o) = self == o
  def hash = to_r.hash

  def round(n = 0) = Time.allocate.__init(@t.to_r.round(n), @fixed)

  def __zone_str(colon = false)
    a = @off.abs
    format("%s%02d%s%02d", @off < 0 ? "-" : "+", a / 3600, colon ? ":" : "", a % 3600 / 60)
  end

  def to_s = utc? ? strftime("%Y-%m-%d %H:%M:%S UTC") : strftime("%Y-%m-%d %H:%M:%S %z")

  def inspect
    s = strftime("%Y-%m-%d %H:%M:%S")
    if subsec != 0
      digits = format("%09d", nsec).sub(/0+\z/, "")
      s += ".#{digits}"
    end
    s + (utc? ? " UTC" : " #{__zone_str}")
  end

  def iso8601(n = 0)
    s = strftime("%Y-%m-%dT%H:%M:%S")
    s += "." + format("%09d", nsec)[0, n] if n > 0
    s + (utc? ? "Z" : __zone_str(true))
  end
  alias xmlschema iso8601

  def __field(c, flags)
    case c
    when "Y" then [@year, "0", 1]
    when "C" then [@year / 100, "0", 2]
    when "y" then [@year % 100, "0", 2]
    when "m" then [@month, "0", 2]
    when "d" then [@day, "0", 2]
    when "e" then [@day, " ", 2]
    when "j" then [@yday, "0", 3]
    when "H" then [@hour, "0", 2]
    when "k" then [@hour, " ", 2]
    when "I" then [(@hour + 11) % 12 + 1, "0", 2]
    when "l" then [(@hour + 11) % 12 + 1, " ", 2]
    when "M" then [@min, "0", 2]
    when "S" then [@sec, "0", 2]
    when "L" then [(subsec * 1000).floor, "0", 3]
    when "N" then [nsec, "0", 9]
    when "u" then [@wday == 0 ? 7 : @wday, "0", 1]
    when "w" then [@wday, "0", 1]
    when "s" then [to_i, "0", 1]
    when "U" then [(@yday + 6 - @wday) / 7, "0", 2]
    when "W" then [(@yday + 6 - (@wday - 1) % 7) / 7, "0", 2]
    when "B" then [MONTHS[@month - 1], " ", 0]
    when "b", "h" then [MONTHS[@month - 1][0, 3], " ", 0]
    when "A" then [DAYS[@wday], " ", 0]
    when "a" then [DAYS[@wday][0, 3], " ", 0]
    when "p" then [@hour < 12 ? "AM" : "PM", " ", 0]
    when "P" then [@hour < 12 ? "am" : "pm", " ", 0]
    when "Z" then [zone.to_s, " ", 0]
    when "z" then [__zone_str(flags.include?(":")), " ", 0]
    when "F" then [strftime("%Y-%m-%d"), " ", 0]
    when "D", "x" then [strftime("%m/%d/%y"), " ", 0]
    when "T", "X" then [strftime("%H:%M:%S"), " ", 0]
    when "R" then [strftime("%H:%M"), " ", 0]
    when "r" then [strftime("%I:%M:%S %p"), " ", 0]
    when "c" then [strftime("%a %b %e %T %Y"), " ", 0]
    when "n" then ["\n", " ", 0]
    when "t" then ["\t", " ", 0]
    when "%" then ["%", " ", 0]
    end
  end

  def strftime(fmt)
    fmt.gsub(/%([-0^#_:]*)(\d*)([A-Za-z%])/) do
      whole, flags, width, c = $&, $1, $2, $3
      f = __field(c, flags)
      next whole unless f
      v, pad, w = f
      s = v.to_s
      s = s.upcase if flags.include?("^")
      s = s.swapcase if flags.include?("#")
      pad = "0" if flags.include?("0")
      pad = " " if flags.include?("_")
      w = width.to_i unless width.empty?
      flags.include?("-") ? s : s.rjust(w, pad)
    end
  end
end
)QRUBYLIB"},
        {"timeout.sa", R"QRUBYLIB(module Timeout
  class ExitException < Exception; end
  class Error < RuntimeError; end

  # The block runs on the clock of the program's own (virtual) time: it is
  # interrupted only where it would wait past the limit.
  def self.timeout(sec, klass = nil, message = nil)
    return yield(sec) if sec.nil? || sec == 0
    caller_thread = Thread.current
    done = false
    watcher = Thread.new do
      Thread.current.report_on_exception = false
      unless Thread.__wait(sec) { done }
        caller_thread.raise(klass || Error, message || "execution expired")
      end
    end
    begin
      yield(sec)
    ensure
      done = true
      watcher.kill
    end
  end

  def timeout(*a, &b) = Timeout.timeout(*a, &b)
end
)QRUBYLIB"},
        {"uri.sa", R"QRUBYLIB(module URI
  class Error < StandardError; end
  class InvalidURIError < Error; end
  class BadURIError < Error; end

  PORTS = { "http" => 80, "https" => 443, "ftp" => 21, "ws" => 80, "wss" => 443, "ldap" => 389, "ldaps" => 636 }.freeze

  class Generic
    include URI
    attr_accessor :scheme, :userinfo, :host, :port, :path, :query, :fragment, :opaque

    def self.default_port = nil

    def initialize(scheme, userinfo, host, port, path, query, fragment, opaque = nil)
      @scheme = scheme
      @userinfo = userinfo
      @host = host
      @port = port
      @path = path || ""
      @query = query
      @fragment = fragment
      @opaque = opaque
    end

    def default_port = URI::PORTS[@scheme&.downcase]
    def user = @userinfo&.split(":", 2)&.first
    def password = @userinfo&.split(":", 2)&.[](1)
    def hostname = @host&.delete_prefix("[")&.delete_suffix("]")
    def absolute? = !@scheme.nil?
    alias absolute absolute?
    def relative? = @scheme.nil?
    def hierarchical? = @opaque.nil?

    def request_uri
      p = @path.empty? ? "/" : @path
      @query ? "#{p}?#{@query}" : p
    end

    def authority
      return nil unless @host
      s = +""
      s << @userinfo << "@" if @userinfo
      s << @host
      s << ":#{@port}" if @port && @port != default_port
      s
    end

    def to_s
      s = +""
      s << @scheme << ":" if @scheme
      if @opaque
        s << @opaque
      else
        s << "//" << authority if @host
        s << @path
        s << "?" << @query if @query
      end
      s << "#" << @fragment if @fragment
      s
    end
    alias to_str to_s

    def ==(o) = o.is_a?(Generic) && to_s == o.to_s
    alias eql? ==
    def hash = to_s.hash
    def inspect = "#<#{self.class} #{self}>"

    def merge(rel)
      r = rel.is_a?(Generic) ? rel : URI.parse(rel.to_s)
      return r if r.absolute?
      raise BadURIError, "both URI are relative" unless absolute?
      return self.class.new(@scheme, r.userinfo, r.host, r.port || default_port, r.path, r.query, r.fragment) if r.host
      path = r.path
      query = r.query
      if path.empty?
        path = @path
        query ||= @query
      elsif !path.start_with?("/")
        base = @path.sub(%r{[^/]*\z}, "")
        base = "/" if base.empty?
        path = base + path
      end
      self.class.new(@scheme, @userinfo, @host, @port, URI.__normalize(path), query, r.fragment)
    end
    alias + merge

    def normalize
      self.class.new(@scheme&.downcase, @userinfo, @host&.downcase, @port, @path.empty? ? "/" : @path, @query, @fragment)
    end
  end

  class HTTP < Generic; end
  class HTTPS < HTTP; end
  class WS < Generic; end
  class WSS < WS; end
  class File < Generic; end

  # an FTP path is relative to the login directory: no leading slash
  class FTP < Generic
    def initialize(scheme, userinfo, host, port, path, query, fragment, opaque = nil)
      super
      @path = @path.delete_prefix("/")
    end

    def to_s
      s = +"#{@scheme}://#{authority}/#{@path}"
      s << "?" << @query if @query
      s << "#" << @fragment if @fragment
      s
    end
  end

  class MailTo < Generic
    def to = @opaque&.split("?")&.first
  end

  def self.__normalize(path)
    out = []
    parts = path.split("/", -1)
    parts.each_with_index do |seg, i|
      if seg == "."
        out << "" if i == parts.size - 1
      elsif seg == ".."
        out.pop if out.size > 1
        out << "" if i == parts.size - 1
      else
        out << seg
      end
    end
    out.join("/")
  end

  def self.parse(str)
    s = str.to_s
    if s =~ /[\s<>"\\^`{|}]/ || s.count("#") > 1
      raise InvalidURIError, "bad URI (is not URI?): #{s.inspect}"
    end
    m = s.match(%r{\A(?:([A-Za-z][A-Za-z0-9+.\-]*):)?(?://([^/?#]*))?([^?#]*)(?:\?([^#]*))?(?:#(.*))?\z})
    raise InvalidURIError, "bad URI (is not URI?): #{s.inspect}" unless m
    scheme, auth, path, query, frag = m[1], m[2], m[3], m[4], m[5]
    k = case scheme&.downcase
        when "http" then HTTP
        when "https" then HTTPS
        when "ftp" then FTP
        when "ws" then WS
        when "wss" then WSS
        when "file" then File
        when "mailto" then MailTo
        else Generic
        end
    if scheme && auth.nil? && !path.start_with?("/") && !path.empty?
      return k.new(scheme, nil, nil, nil, nil, nil, frag, query ? "#{path}?#{query}" : path)
    end
    userinfo = host = port = nil
    if auth
      userinfo, auth = auth.split("@", 2) if auth.include?("@")
      if auth =~ /\A(\[[^\]]*\]|[^:]*)(?::(\d*))?\z/
        host = $1
        port = $2 && !$2.empty? ? $2.to_i : nil
      else
        raise InvalidURIError, "bad URI (is not URI?): #{s.inspect}"
      end
    end
    port ||= PORTS[scheme&.downcase] if host
    k.new(scheme, userinfo, host, port, path, query, frag)
  end

  def self.join(*parts)
    u = parse(parts[0].to_s)
    parts[1..].each { |p| u = u.merge(p) }
    u
  end

  def self.encode_www_form_component(str, *)
    out = +""
    str.to_s.each_byte do |b|
      if (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 42 || b == 45 || b == 46 || b == 95
        out << b
      elsif b == 32
        out << "+"
      else
        out << format("%%%02X", b)
      end
    end
    out
  end

  def self.decode_www_form_component(str, *)
    s = str.to_s
    out = +""
    i = 0
    n = s.bytesize
    while i < n
      b = s.getbyte(i)
      if b == 43
        out.__append_byte(32)
        i += 1
      elsif b == 37
        h = s.byteslice(i + 1, 2)
        raise ArgumentError, "invalid %-encoding (#{s})" unless h =~ /\A\h\h\z/
        out.__append_byte(h.to_i(16))
        i += 3
      else
        out.__append_byte(b)
        i += 1
      end
    end
    out
  end

  def self.encode_uri_component(str, *) = encode_www_form_component(str).gsub("+", "%20")
  def self.decode_uri_component(str, *) = decode_www_form_component(str.gsub("+", "%2B"))

  def self.encode_www_form(enum, *)
    pairs = []
    enum.each do |k, v|
      if v.nil?
        pairs << encode_www_form_component(k)
      elsif v.respond_to?(:to_ary)
        v.to_ary.each do |w|
          pairs << (w.nil? ? encode_www_form_component(k) : "#{encode_www_form_component(k)}=#{encode_www_form_component(w)}")
        end
      else
        pairs << "#{encode_www_form_component(k)}=#{encode_www_form_component(v)}"
      end
    end
    pairs.join("&")
  end

  def self.decode_www_form(str, *)
    return [] if str.empty?
    str.split(/[&;]/).map do |pair|
      k, v = pair.split("=", 2)
      [decode_www_form_component(k), decode_www_form_component(v || "")]
    end
  end

  def self.extract(str) = str.scan(%r{[a-z][a-z0-9+.\-]*://[^\s<>"]+}i)
end

module Kernel
  def URI(s) = s.is_a?(URI::Generic) ? s : URI.parse(s)
end
