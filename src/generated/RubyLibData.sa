    first = true
    if v.is_a?(Hash)
      v.each do |k, x|
        out << pad unless first && inline
        first = false
        out << __scalar(k) << ":"
        __value(x, ind, out)
      end
    else
      v.each do |x|
        out << pad unless first && inline
        first = false
        out << "-"
