  def self.__list(items, inner, tail)
    last = items.size - 1
    items.each_with_index.map { |x, i| layout(x, inner, i == last ? tail + 1 : 1) }.join(",\n" + " " * inner)
  end

  # name=value lines; a value that does not fit goes on its own line
  def self.__fields(head, fields, col, tail)
    inner = col + 1
    n = fields.size
    body = fields.each_with_index.map do |(name, x), i|
      t = i == n - 1 ? tail + 1 : 1
      one = x.inspect
      if inner + name.to_s.size + 1 + one.size + t <= @width
        "#{name}=#{one}"
      else
        "#{name}=\n#{' ' * (inner + 1)}#{layout(x, inner + 1, t)}"
      end
    end
    "#{head}\n#{' ' * inner}" + body.join(",\n" + " " * inner) + ">"
  end

  def self.__key(k)
    return "#{k.inspect} =>" unless k.is_a?(Symbol)
    s = { k => 0 }.inspect
    s[1...-3]
  end

  def self.__format(v) = layout(v, 0, 0)

  def self.pp(obj, out = $stdout, width = 79)
    saved = @width
    @width = width
    out << __format(obj) << "\n"
    out
  ensure
    @width = saved
  end

  def self.singleline_pp(obj, out = $stdout)
    out << obj.inspect
    out
  end
end

module Kernel
  def pretty_inspect = PP.__format(self) + "\n"
end
