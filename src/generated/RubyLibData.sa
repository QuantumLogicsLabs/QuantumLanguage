        {"stringio.sa", R"QRUBYLIB(class StringIO
  include Enumerable

  attr_accessor :string, :lineno

  def self.open(*a)
    io = new(*a)
    return io unless block_given?
    yield io
  end

  def initialize(str = +"", mode = nil)
    @string = str
    @pos = mode.to_s.start_with?("a") ? str.bytesize : 0
    @lineno = 0
    @closed = false
    @append = mode.to_s.start_with?("a")
    @string.clear if mode.to_s.start_with?("w") && !str.frozen?
  end

  def write(*items)
    raise IOError, "not opened for writing" if @closed || @string.frozen?
    n = 0
    items.each do |x|
      s = x.to_s
      @pos = @string.bytesize if @append
      if @pos >= @string.bytesize
        @string << s
      else
        @string.replace(@string.byteslice(0, @pos) + s + (@string.byteslice(@pos + s.bytesize, @string.bytesize) || ""))
      end
      @pos += s.bytesize
      n += s.bytesize
    end
    n
  end

  def <<(x)
    write(x)
    self
  end

  def print(*items)
    write(*items)
    nil
  end

  def puts(*items)
    if items.empty?
      write("\n")
      return nil
    end
    items.flatten.each do |x|
      s = x.nil? ? "" : x.to_s
      write(s.end_with?("\n") ? s : s + "\n")
    end
    nil
  end

  def printf(fmt, *a)
    write(format(fmt, *a))
    nil
  end

  def putc(c)
    write(c.is_a?(Integer) ? c.chr : c.to_s[0])
    c
  end

  def read(n = nil, *)
    if n.nil?
      s = @string.byteslice(@pos, @string.bytesize) || ""
      @pos = @string.bytesize
      return s
    end
    return nil if @pos >= @string.bytesize && n > 0
    s = @string.byteslice(@pos, n) || ""
    @pos += s.bytesize
