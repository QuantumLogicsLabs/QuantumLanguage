        {"string", R"QNATIVELIB(// <string> for Quantum's native backend: std::string over a heap buffer
// (always NUL-terminated, so c_str() is the buffer itself).
#pragma once

namespace std
{

template <typename C>
inline size_t __strlen(const C *s)
{
    size_t n = 0;
    while (s[n])
        ++n;
    return n;
}

inline unsigned __cu(char c) { return (unsigned char)c; }
inline unsigned __cu(char16_t c) { return (unsigned)c; }

// a reverse iterator over contiguous elements: p_ is one past the current one
template <typename T>
class __rptr
{
  public:
    __rptr() : p_(nullptr) {}
    explicit __rptr(T *p) : p_(p) {}
    T &operator*() const { return *(p_ - 1); }
    T *operator->() const { return p_ - 1; }
    __rptr &operator++()
    {
        --p_;
        return *this;
    }
    __rptr operator++(int)
    {
        __rptr old = *this;
        --p_;
        return old;
    }
    __rptr &operator--()
    {
        ++p_;
        return *this;
    }
    __rptr operator+(long long k) const { return __rptr(p_ - k); }
    long long operator-(const __rptr &o) const { return o.p_ - p_; }
    bool operator==(const __rptr &o) const { return p_ == o.p_; }
    bool operator!=(const __rptr &o) const { return p_ != o.p_; }
    T *base() const { return p_; }
    T *p_;
};

template <typename C>
class basic_string
{
  public:
    static const size_t npos = (size_t)-1;

    basic_string() { init(0); }
    basic_string(const C *s)
    {
        size_t n = __strlen(s);
        init(n);
        for (size_t i = 0; i < n; ++i)
            data_[i] = s[i];
    }
    basic_string(const C *s, size_t n)
    {
        init(n);
        for (size_t i = 0; i < n; ++i)
            data_[i] = s[i];
    }
    basic_string(size_t n, C c)
    {
        init(n);
        for (size_t i = 0; i < n; ++i)
            data_[i] = c;
    }
    basic_string(const basic_string &o)
    {
        init(o.size_);
        for (size_t i = 0; i < o.size_; ++i)
            data_[i] = o.data_[i];
    }
    basic_string(basic_string &&o)
    {
        data_ = o.data_;
        size_ = o.size_;
        cap_ = o.cap_;
        o.init(0);
    }
    ~basic_string() { delete[] data_; }

    basic_string &operator=(const basic_string &o)
    {
        if (this != &o)
        {
            resize(0);
            append(o.data_, o.size_);
        }
        return *this;
    }
    basic_string &operator=(basic_string &&o)
    {
        if (this != &o)
        {
            delete[] data_;
            data_ = o.data_;
            size_ = o.size_;
            cap_ = o.cap_;
            o.init(0);
        }
        return *this;
    }
    basic_string &operator=(const C *s)
    {
        resize(0);
        append(s, __strlen(s));
        return *this;
    }

    size_t size() const { return size_; }
    size_t length() const { return size_; }
    size_t capacity() const { return cap_; }
    bool empty() const { return size_ == 0; }
    const C *c_str() const { return data_; }
    const C *data() const { return data_; }
    C *begin() { return data_; }
    C *end() { return data_ + size_; }
    const C *begin() const { return data_; }
    const C *end() const { return data_ + size_; }
    __rptr<C> rbegin() const { return __rptr<C>(data_ + size_); }
    __rptr<C> rend() const { return __rptr<C>(data_); }
    const C *cbegin() const { return data_; }
    const C *cend() const { return data_ + size_; }
    C &operator[](size_t i) { return data_[i]; }
    const C &operator[](size_t i) const { return data_[i]; }
    C &at(size_t i) { return data_[i]; }
    C &front() { return data_[0]; }
    C &back() { return data_[size_ - 1]; }

    void reserve(size_t n)
    {
        if (n <= cap_)
            return;
        C *d = new C[n + 1];
        for (size_t i = 0; i < size_; ++i)
            d[i] = data_[i];
        d[size_] = 0;
        delete[] data_;
        data_ = d;
        cap_ = n;
    }
    void resize(size_t n, C c = 0)
    {
        if (n > cap_)
            reserve(n > cap_ * 2 ? n : cap_ * 2);
        for (size_t i = size_; i < n; ++i)
            data_[i] = c;
        size_ = n;
        data_[size_] = 0;
    }
    void clear() { resize(0); }
    void push_back(C c)
    {
        if (size_ == cap_)
            reserve(cap_ < 8 ? 16 : cap_ * 2);
        data_[size_++] = c;
        data_[size_] = 0;
    }
    void pop_back()
    {
        if (size_)
            data_[--size_] = 0;
    }
    basic_string &append(const C *s, size_t n)
    {
        if (size_ + n > cap_)
            reserve(size_ + n > cap_ * 2 ? size_ + n : cap_ * 2);
        for (size_t i = 0; i < n; ++i)
            data_[size_ + i] = s[i];
        size_ += n;
        data_[size_] = 0;
        return *this;
    }
    basic_string &append(const basic_string &s) { return append(s.data_, s.size_); }
    basic_string &append(const basic_string &s, size_t pos, size_t n = npos)
    {
        if (pos > s.size_)
            pos = s.size_;
        if (n > s.size_ - pos)
            n = s.size_ - pos;
        return append(s.data_ + pos, n);
    }
    template <typename __InputIt>
    basic_string &append(__InputIt first, __InputIt last)
    {
        for (; first != last; ++first)
            push_back((C)*first);
        return *this;
    }
    template <typename __InputIt>
    basic_string &assign(__InputIt first, __InputIt last)
    {
        resize(0);
        return append(first, last);
    }
    basic_string &append(const C *s) { return append(s, __strlen(s)); }
    basic_string &append(size_t n, C c)
    {
        for (size_t i = 0; i < n; ++i)
            push_back(c);
        return *this;
    }
    basic_string &operator+=(const basic_string &s) { return append(s.data_, s.size_); }
    basic_string &operator+=(const C *s) { return append(s, __strlen(s)); }
    basic_string &operator+=(C c)
    {
        push_back(c);
        return *this;
    }

    basic_string substr(size_t pos, size_t n = npos) const
    {
        if (pos > size_)
            pos = size_;
        if (n > size_ - pos)
            n = size_ - pos;
        return basic_string(data_ + pos, n);
    }
    int compare(const basic_string &o) const { return compareBytes(o.data_, o.size_); }
    int compare(const C *s) const { return compareBytes(s, __strlen(s)); }

    size_t find(const C *s, size_t pos, size_t n) const
    {
        if (n == 0)
            return pos <= size_ ? pos : npos;
        for (size_t i = pos; i + n <= size_; ++i)
        {
            size_t k = 0;
            while (k < n && data_[i + k] == s[k])
                ++k;
            if (k == n)
                return i;
        }
        return npos;
    }
    size_t find(const basic_string &s, size_t pos = 0) const { return find(s.data_, pos, s.size_); }
    size_t find(const C *s, size_t pos = 0) const { return find(s, pos, __strlen(s)); }
    size_t find(C c, size_t pos = 0) const
    {
        for (size_t i = pos; i < size_; ++i)
            if (data_[i] == c)
                return i;
        return npos;
    }
    size_t rfind(C c, size_t pos = npos) const
    {
        if (size_ == 0)
            return npos;
        size_t i = pos < size_ ? pos : size_ - 1;
        while (true)
        {
            if (data_[i] == c)
                return i;
            if (i == 0)
                return npos;
            --i;
        }
    }
    size_t rfind(const basic_string &s, size_t pos = npos) const
    {
        if (s.size_ > size_)
            return npos;
        size_t i = size_ - s.size_;
        if (pos < i)
            i = pos;
        while (true)
        {
            size_t k = 0;
            while (k < s.size_ && data_[i + k] == s.data_[k])
                ++k;
            if (k == s.size_)
                return i;
            if (i == 0)
                return npos;
            --i;
        }
    }

    // ── editing ──
    basic_string &erase(size_t pos = 0, size_t n = npos)
    {
        if (pos > size_)
            pos = size_;
        if (n > size_ - pos)
            n = size_ - pos;
        for (size_t i = pos; i + n < size_; ++i)
            data_[i] = data_[i + n];
        size_ -= n;
        data_[size_] = 0;
        return *this;
    }
    C *erase(C *p)
    {
        size_t i = (size_t)(p - data_);
        erase(i, 1);
        return data_ + i;
    }
    C *erase(C *first, C *last)
    {
        size_t i = (size_t)(first - data_);
        erase(i, (size_t)(last - first));
        return data_ + i;
    }
    basic_string &insert(size_t pos, const C *s, size_t n)
    {
        if (pos > size_)
            pos = size_;
        basic_string tail(data_ + pos, size_ - pos);
        resize(pos);
        append(s, n);
        append(tail.data_, tail.size_);
        return *this;
    }
    basic_string &insert(size_t pos, const basic_string &s) { return insert(pos, s.data_, s.size_); }
    basic_string &insert(size_t pos, const C *s) { return insert(pos, s, __strlen(s)); }
    basic_string &insert(size_t pos, size_t n, C c)
    {
        basic_string fill(n, c);
        return insert(pos, fill.data_, n);
    }
    C *insert(C *p, C c)
    {
        size_t i = (size_t)(p - data_);
        insert(i, &c, 1);
        return data_ + i;
    }
    basic_string &replace(size_t pos, size_t n, const C *s, size_t m)
    {
        if (pos > size_)
            pos = size_;
        if (n > size_ - pos)
            n = size_ - pos;
        basic_string tail(data_ + pos + n, size_ - pos - n);
        resize(pos);
        append(s, m);
        append(tail.data_, tail.size_);
        return *this;
    }
    basic_string &replace(size_t pos, size_t n, const basic_string &s) { return replace(pos, n, s.data_, s.size_); }
    basic_string &replace(size_t pos, size_t n, const C *s) { return replace(pos, n, s, __strlen(s)); }
    basic_string &replace(size_t pos, size_t n, size_t count, C c)
    {
        basic_string fill(count, c);
        return replace(pos, n, fill.data_, count);
    }
    basic_string &replace(C *first, C *last, const basic_string &s)
    {
        return replace((size_t)(first - data_), (size_t)(last - first), s.data_, s.size_);
    }
    basic_string &assign(const basic_string &s)
    {
        *this = s;
        return *this;
    }
    basic_string &assign(const C *s, size_t n)
    {
        resize(0);
        return append(s, n);
    }
    basic_string &assign(const C *s) { return assign(s, __strlen(s)); }
    basic_string &assign(size_t n, C c)
    {
        resize(0);
        return append(n, c);
    }
    template <typename __InputIt>
    basic_string(__InputIt first, __InputIt last)
    {
        init(0);
        for (; first != last; ++first)
            push_back((C)*first);
    }
    basic_string(const basic_string &o, size_t pos, size_t n = npos)
    {
        if (pos > o.size_)
            pos = o.size_;
        if (n > o.size_ - pos)
            n = o.size_ - pos;
        init(n);
        for (size_t i = 0; i < n; ++i)
            data_[i] = o.data_[pos + i];
    }
    void swap(basic_string &o)
    {
        C *d = data_;
        size_t s = size_, c = cap_;
        data_ = o.data_;
        size_ = o.size_;
        cap_ = o.cap_;
        o.data_ = d;
        o.size_ = s;
        o.cap_ = c;
    }
    void shrink_to_fit() {}
    size_t max_size() const { return 0x7FFFFFFFFFFFFFFFULL; }
    const C &back() const { return data_[size_ - 1]; }
    const C &front() const { return data_[0]; }
    size_t copy(C *out, size_t n, size_t pos = 0) const
    {
        if (pos > size_)
            pos = size_;
        if (n > size_ - pos)
            n = size_ - pos;
        for (size_t i = 0; i < n; ++i)
            out[i] = data_[pos + i];
        return n;
    }

    // ── searching ──
    bool __in(const C *set, size_t n, C c) const
    {
        for (size_t k = 0; k < n; ++k)
            if (set[k] == c)
                return true;
        return false;
    }
    size_t __firstOf(const C *set, size_t n, size_t pos, bool in) const
    {
        for (size_t i = pos; i < size_; ++i)
            if (__in(set, n, data_[i]) == in)
                return i;
        return npos;
    }
    size_t __lastOf(const C *set, size_t n, size_t pos, bool in) const
    {
        if (size_ == 0)
            return npos;
        size_t i = pos < size_ ? pos : size_ - 1;
        while (true)
        {
            if (__in(set, n, data_[i]) == in)
                return i;
            if (i == 0)
                return npos;
            --i;
        }
    }
    size_t find_first_of(const basic_string &s, size_t pos = 0) const { return __firstOf(s.data_, s.size_, pos, true); }
    size_t find_first_of(const C *s, size_t pos = 0) const { return __firstOf(s, __strlen(s), pos, true); }
    size_t find_first_of(C c, size_t pos = 0) const { return __firstOf(&c, 1, pos, true); }
    size_t find_first_not_of(const basic_string &s, size_t pos = 0) const { return __firstOf(s.data_, s.size_, pos, false); }
    size_t find_first_not_of(const C *s, size_t pos = 0) const { return __firstOf(s, __strlen(s), pos, false); }
    size_t find_first_not_of(C c, size_t pos = 0) const { return __firstOf(&c, 1, pos, false); }
    size_t find_last_of(const basic_string &s, size_t pos = npos) const { return __lastOf(s.data_, s.size_, pos, true); }
    size_t find_last_of(const C *s, size_t pos = npos) const { return __lastOf(s, __strlen(s), pos, true); }
    size_t find_last_of(C c, size_t pos = npos) const { return __lastOf(&c, 1, pos, true); }
    size_t find_last_not_of(const basic_string &s, size_t pos = npos) const { return __lastOf(s.data_, s.size_, pos, false); }
    size_t find_last_not_of(const C *s, size_t pos = npos) const { return __lastOf(s, __strlen(s), pos, false); }
    size_t find_last_not_of(C c, size_t pos = npos) const { return __lastOf(&c, 1, pos, false); }
    size_t rfind(const C *s, size_t pos = npos) const { return rfind(basic_string(s), pos); }
    int compare(size_t pos, size_t n, const basic_string &o) const { return substr(pos, n).compare(o); }
    int compare(size_t pos, size_t n, const C *o) const { return substr(pos, n).compare(o); }
    int compare(size_t pos, size_t n, const basic_string &o, size_t pos2, size_t n2 = npos) const
    {
        return substr(pos, n).compare(o.substr(pos2, n2));
    }
    bool starts_with(const basic_string &p) const { return size_ >= p.size_ && compare(0, p.size_, p) == 0; }
    bool starts_with(const C *p) const { return starts_with(basic_string(p)); }
    bool starts_with(C c) const { return size_ && data_[0] == c; }
    bool ends_with(const basic_string &p) const { return size_ >= p.size_ && compare(size_ - p.size_, p.size_, p) == 0; }
    bool ends_with(const C *p) const { return ends_with(basic_string(p)); }
    bool ends_with(C c) const { return size_ && data_[size_ - 1] == c; }

    int compareBytes(const C *s, size_t n) const
    {
        size_t m = size_ < n ? size_ : n;
        for (size_t i = 0; i < m; ++i)
        {
            unsigned a = __cu(data_[i]), b = __cu(s[i]);
            if (a != b)
                return a < b ? -1 : 1;
        }
        if (size_ == n)
            return 0;
        return size_ < n ? -1 : 1;
    }

  private:
    C *data_;
    size_t size_;
    size_t cap_;

    void init(size_t n)
    {
        cap_ = n < 15 ? 15 : n;
        data_ = new C[cap_ + 1];
        size_ = n;
        data_[n] = 0;
    }
};

template <typename C>
struct char_traits
{
    static size_t length(const C *s) { return __strlen(s); }
    static int compare(const C *a, const C *b, size_t n)
    {
        for (size_t i = 0; i < n; ++i)
            if (a[i] != b[i])
                return __cu(a[i]) < __cu(b[i]) ? -1 : 1;
        return 0;
    }
    static bool eq(C a, C b) { return a == b; }
    static bool lt(C a, C b) { return __cu(a) < __cu(b); }
};

typedef basic_string<char> string;
typedef basic_string<char16_t> u16string;
typedef basic_string<wchar_t> wstring;

template <typename C>
bool operator==(const basic_string<C> &a, const basic_string<C> &b) { return a.compare(b) == 0; }
template <typename C>
bool operator==(const basic_string<C> &a, const C *b) { return a.compare(b) == 0; }
template <typename C>
bool operator==(const C *a, const basic_string<C> &b) { return b.compare(a) == 0; }
template <typename C>
bool operator!=(const basic_string<C> &a, const basic_string<C> &b) { return a.compare(b) != 0; }
template <typename C>
bool operator!=(const basic_string<C> &a, const C *b) { return a.compare(b) != 0; }
template <typename C>
bool operator!=(const C *a, const basic_string<C> &b) { return b.compare(a) != 0; }
template <typename C>
bool operator<(const basic_string<C> &a, const basic_string<C> &b) { return a.compare(b) < 0; }
template <typename C>
bool operator<(const basic_string<C> &a, const C *b) { return a.compare(b) < 0; }
template <typename C>
bool operator<(const C *a, const basic_string<C> &b) { return b.compare(a) > 0; }
template <typename C>
bool operator>(const basic_string<C> &a, const basic_string<C> &b) { return a.compare(b) > 0; }
template <typename C>
bool operator>(const basic_string<C> &a, const C *b) { return a.compare(b) > 0; }
template <typename C>
bool operator>(const C *a, const basic_string<C> &b) { return b.compare(a) < 0; }
template <typename C>
bool operator<=(const basic_string<C> &a, const basic_string<C> &b) { return a.compare(b) <= 0; }
template <typename C>
bool operator<=(const basic_string<C> &a, const C *b) { return a.compare(b) <= 0; }
template <typename C>
bool operator>=(const basic_string<C> &a, const basic_string<C> &b) { return a.compare(b) >= 0; }
template <typename C>
bool operator>=(const basic_string<C> &a, const C *b) { return a.compare(b) >= 0; }
template <typename C>
void swap(basic_string<C> &a, basic_string<C> &b) { a.swap(b); }

template <typename C>
basic_string<C> operator+(const basic_string<C> &a, const basic_string<C> &b)
{
    basic_string<C> r(a);
    r += b;
    return r;
}
template <typename C>
basic_string<C> operator+(const basic_string<C> &a, const C *b)
{
    basic_string<C> r(a);
    r += b;
    return r;
}
template <typename C>
basic_string<C> operator+(const C *a, const basic_string<C> &b)
{
    basic_string<C> r(a);
    r += b;
    return r;
}
template <typename C>
basic_string<C> operator+(const basic_string<C> &a, C c)
{
    basic_string<C> r(a);
    r += c;
    return r;
}
template <typename C>
basic_string<C> operator+(C c, const basic_string<C> &b)
{
    basic_string<C> r(1, c);
    r += b;
    return r;
}

inline string to_string(long long v)
{
    char buf[24];
    int n = 0;
    unsigned long long u = v < 0 ? (unsigned long long)0 - (unsigned long long)v : (unsigned long long)v;
    do
    {
        buf[n++] = (char)('0' + (int)(u % 10));
        u /= 10;
    } while (u);
    string r;
    if (v < 0)
        r += '-';
    while (n > 0)
        r += buf[--n];
    return r;
}
inline string to_string(int v) { return to_string((long long)v); }
inline string to_string(unsigned long long v)
{
    char buf[24];
    int n = 0;
    do
    {
        buf[n++] = (char)('0' + (int)(v % 10));
        v /= 10;
    } while (v);
    string r;
    while (n > 0)
        r += buf[--n];
    return r;
}
inline string to_string(unsigned v) { return to_string((unsigned long long)v); }

} // namespace std

