        {"ctime", R"QNATIVELIB(// <ctime> for Quantum's native backend: Windows' own C runtime (ucrtbase.dll)
// time functions — the ones a g++ (UCRT) build calls, time zones and all.
// time_t is 64-bit, struct tm the C runtime's layout.
#pragma once

typedef long long time_t;
typedef long clock_t;
#define CLOCKS_PER_SEC 1000

struct tm
{
    int tm_sec;
    int tm_min;
    int tm_hour;
    int tm_mday;
    int tm_mon;
    int tm_year;
    int tm_wday;
    int tm_yday;
    int tm_isdst;
};

namespace __dll_ucrtbase
{
long long _time64(long long *out);
int _localtime64_s(struct tm *out, const long long *t);
int _gmtime64_s(struct tm *out, const long long *t);
long long _mktime64(struct tm *t);
long long _mkgmtime64(struct tm *t);
size_t strftime(char *buf, size_t size, const char *fmt, const struct tm *t);
long clock();
double _difftime64(long long a, long long b);
} // namespace __dll_ucrtbase

inline time_t time(time_t *out) { return __dll_ucrtbase::_time64(out); }
inline int localtime_s(struct tm *out, const time_t *t) { return __dll_ucrtbase::_localtime64_s(out, t); }
inline int gmtime_s(struct tm *out, const time_t *t) { return __dll_ucrtbase::_gmtime64_s(out, t); }
inline time_t mktime(struct tm *t) { return __dll_ucrtbase::_mktime64(t); }
inline time_t _mkgmtime(struct tm *t) { return __dll_ucrtbase::_mkgmtime64(t); }
inline double difftime(time_t a, time_t b) { return __dll_ucrtbase::_difftime64(a, b); }
inline size_t strftime(char *buf, size_t size, const char *fmt, const struct tm *t)
{
    return __dll_ucrtbase::strftime(buf, size, fmt, t);
}
inline clock_t clock() { return __dll_ucrtbase::clock(); }
inline struct tm __tm_buf;
inline struct tm *localtime(const time_t *t)
{
    __dll_ucrtbase::_localtime64_s(&__tm_buf, t);
    return &__tm_buf;
}
inline struct tm *gmtime(const time_t *t)
{
    __dll_ucrtbase::_gmtime64_s(&__tm_buf, t);
    return &__tm_buf;
}

