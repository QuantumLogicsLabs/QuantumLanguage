        {"sstream", R"QNATIVELIB(// <sstream> for Quantum's native backend: streams over a string.
#pragma once
#include <iostream>

namespace std
{

class stringstream : public __stream
{
  public:
    stringstream() : pos_(0) {}
    explicit stringstream(const string &s) : buf_(s), pos_(0) {}
    explicit stringstream(int) : pos_(0) {}
    void write(const char *s, long long n) override { buf_.append(s, (size_t)n); }
    int __getc() override { return pos_ < buf_.size() ? (unsigned char)buf_[pos_++] : -1; }
    int __peekc() override { return pos_ < buf_.size() ? (unsigned char)buf_[pos_] : -1; }
    string __rest() override
    {
        string r = buf_.substr(pos_);
        pos_ = buf_.size();
        return r;
    }
    long long __tell(bool put) override { return put ? (long long)buf_.size() : (long long)pos_; }
    bool __seek(bool put, long long off, int dir) override
    {
        if (put)
            return false;
        long long base = dir == beg ? 0 : dir == cur ? (long long)pos_ : (long long)buf_.size();
        if (base + off < 0 || base + off > (long long)buf_.size())
            return false;
        pos_ = (size_t)(base + off);
        return true;
    }
    string str() const { return buf_; }
    void str(const string &s)
    {
        buf_ = s;
        pos_ = 0;
    }

  private:
    string buf_;
    size_t pos_;
};

typedef stringstream ostringstream;
typedef stringstream istringstream;

} // namespace std
)QNATIVELIB"},
        {"stdexcept", R"QNATIVELIB(// <stdexcept> (and <exception>) for Quantum's native backend.
#pragma once
#include <string>

namespace std
{

class exception
{
  public:
    exception() {}
    virtual ~exception() {}
    virtual const char *what() const { return "std::exception"; }
};

class runtime_error : public exception
{
  public:
    explicit runtime_error(const string &message) : message_(message) {}
    explicit runtime_error(const char *message) : message_(message) {}
    const char *what() const override { return message_.c_str(); }

  private:
    string message_;
};

class logic_error : public exception
{
  public:
    explicit logic_error(const string &message) : message_(message) {}
    explicit logic_error(const char *message) : message_(message) {}
    const char *what() const override { return message_.c_str(); }

  private:
    string message_;
};

class out_of_range : public logic_error
{
  public:
    explicit out_of_range(const string &message) : logic_error(message) {}
    explicit out_of_range(const char *message) : logic_error(message) {}
};

class invalid_argument : public logic_error
{
  public:
    explicit invalid_argument(const string &message) : logic_error(message) {}
    explicit invalid_argument(const char *message) : logic_error(message) {}
};

class length_error : public logic_error
{
  public:
    explicit length_error(const string &message) : logic_error(message) {}
    explicit length_error(const char *message) : logic_error(message) {}
};

class domain_error : public logic_error
{
  public:
    explicit domain_error(const string &message) : logic_error(message) {}
    explicit domain_error(const char *message) : logic_error(message) {}
};

class overflow_error : public runtime_error
{
  public:
    explicit overflow_error(const string &message) : runtime_error(message) {}
    explicit overflow_error(const char *message) : runtime_error(message) {}
};

class underflow_error : public runtime_error
{
  public:
    explicit underflow_error(const string &message) : runtime_error(message) {}
    explicit underflow_error(const char *message) : runtime_error(message) {}
};

class range_error : public runtime_error
{
  public:
    explicit range_error(const string &message) : runtime_error(message) {}
    explicit range_error(const char *message) : runtime_error(message) {}
};

class bad_alloc : public exception
{
  public:
    const char *what() const override { return "std::bad_alloc"; }
};

} // namespace std
