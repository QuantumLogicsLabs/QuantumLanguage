        {"__hash", R"QNATIVELIB(// Hashing for Quantum's native backend, as libstdc++ hashes: integers and
// pointers are their own hash, strings go through _Hash_bytes (MurmurHash2,
// 64-bit, seed 0xc70f6907) — so std::hash<std::string> gives g++'s values.
#pragma once
#include <string>

namespace std
{

inline size_t __shift_mix(size_t v) { return v ^ (v >> 47); }

inline size_t _Hash_bytes(const void *ptr, size_t len, size_t seed)
{
    const size_t mul = (((size_t)0xc6a4a793UL) << 32) + (size_t)0x5bd1e995UL;
    const unsigned char *buf = (const unsigned char *)ptr;
    size_t aligned = len & ~(size_t)7;
    size_t hash = seed ^ (len * mul);
    for (size_t i = 0; i < aligned; i += 8)
    {
        size_t word = 0;
        for (int k = 7; k >= 0; --k)
            word = (word << 8) | buf[i + k];
        size_t data = __shift_mix(word * mul) * mul;
        hash ^= data;
        hash *= mul;
    }
    size_t rest = len & 7;
    if (rest)
    {
        size_t data = 0;
        for (size_t k = rest; k > 0; --k)
            data = (data << 8) + buf[aligned + k - 1];
        hash ^= data;
        hash *= mul;
    }
    hash = __shift_mix(hash) * mul;
    hash = __shift_mix(hash);
    return hash;
}

inline size_t __hash(const string &s) { return _Hash_bytes(s.data(), s.size(), 0xc70f6907UL); }
inline size_t __hash(long long v) { return (size_t)v; }
inline size_t __hash(unsigned long long v) { return v; }
inline size_t __hash(int v) { return (size_t)(long long)v; }
inline size_t __hash(unsigned v) { return v; }
inline size_t __hash(char v) { return (size_t)(long long)v; }
inline size_t __hash(bool v) { return v ? 1 : 0; }
inline size_t __hash(double v) { return v == 0.0 ? 0 : _Hash_bytes(&v, 8, 0xc70f6907UL); }
inline size_t __hash(const void *p) { return (size_t)p; }

template <typename T>
struct hash
{
    size_t operator()(const T &v) const { return __hash(v); }
};

} // namespace std
