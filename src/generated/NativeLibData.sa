namespace std
{

class mt19937_64
{
  public:
    typedef unsigned long long result_type;
    explicit mt19937_64(unsigned long long s = 5489ULL) { seed(s); }
    void seed(unsigned long long s)
    {
        x_[0] = s;
        for (int i = 1; i < 312; ++i)
            x_[i] = 6364136223846793005ULL * (x_[i - 1] ^ (x_[i - 1] >> 62)) + (unsigned long long)i;
        i_ = 312;
    }
    static unsigned long long min() { return 0; }
    static unsigned long long max() { return 0xFFFFFFFFFFFFFFFFULL; }
    unsigned long long operator()()
    {
        if (i_ >= 312)
            twist();
        unsigned long long z = x_[i_++];
        z ^= (z >> 29) & 0x5555555555555555ULL;
        z ^= (z << 17) & 0x71D67FFFEDA60000ULL;
        z ^= (z << 37) & 0xFFF7EEE000000000ULL;
        z ^= z >> 43;
        return z;
    }
    void discard(unsigned long long n)
    {
        while (n--)
            (*this)();
    }

  private:
    unsigned long long x_[312];
    int i_;
    void twist()
    {
        const unsigned long long upper = 0xFFFFFFFF80000000ULL, lower = 0x7FFFFFFFULL;
        for (int k = 0; k < 312; ++k)
        {
            unsigned long long y = (x_[k] & upper) | (x_[(k + 1) % 312] & lower);
            x_[k] = x_[(k + 156) % 312] ^ (y >> 1) ^ ((y & 1) ? 0xB5026F5AA96619E9ULL : 0ULL);
        }
        i_ = 0;
    }
};

class mt19937
{
  public:
    typedef unsigned result_type;
    explicit mt19937(unsigned long long s = 5489U) { seed(s); }
    void seed(unsigned long long s)
    {
        x_[0] = (unsigned)s;
        for (int i = 1; i < 624; ++i)
            x_[i] = 1812433253U * (x_[i - 1] ^ (x_[i - 1] >> 30)) + (unsigned)i;
        i_ = 624;
    }
    static unsigned long long min() { return 0; }
    static unsigned long long max() { return 0xFFFFFFFFULL; }
    unsigned long long operator()()
    {
        if (i_ >= 624)
            twist();
        unsigned z = x_[i_++];
        z ^= z >> 11;
        z ^= (z << 7) & 0x9D2C5680U;
        z ^= (z << 15) & 0xEFC60000U;
        z ^= z >> 18;
        return z;
    }

  private:
    unsigned x_[624];
    int i_;
    void twist()
    {
        for (int k = 0; k < 624; ++k)
        {
            unsigned y = (x_[k] & 0x80000000U) | (x_[(k + 1) % 624] & 0x7FFFFFFFU);
            x_[k] = x_[(k + 397) % 624] ^ (y >> 1) ^ ((y & 1) ? 0x9908B0DFU : 0U);
        }
        i_ = 0;
    }
};
typedef mt19937 default_random_engine;

class random_device
{
  public:
    typedef unsigned result_type;
    random_device() {}
    unsigned operator()()
    {
        unsigned v = 0;
        __dll_advapi32::SystemFunction036(&v, 4);
        return v;
    }
    static unsigned long long min() { return 0; }
    static unsigned long long max() { return 0xFFFFFFFFULL; }
};

// the high and low 64 bits of a * b
inline unsigned long long __mul_hi(unsigned long long a, unsigned long long b, unsigned long long &lo)
{
    unsigned long long a0 = a & 0xFFFFFFFFULL, a1 = a >> 32, b0 = b & 0xFFFFFFFFULL, b1 = b >> 32;
    unsigned long long p00 = a0 * b0, p01 = a0 * b1, p10 = a1 * b0, p11 = a1 * b1;
    unsigned long long mid = (p00 >> 32) + (p01 & 0xFFFFFFFFULL) + (p10 & 0xFFFFFFFFULL);
    lo = (mid << 32) | (p00 & 0xFFFFFFFFULL);
    return p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32);
}

// a value in [0, range] from g, as libstdc++'s uniform_int_distribution::operator()
template <typename G>
unsigned long long __uniform_u64(G &g, unsigned long long urange)
{
    unsigned long long urngrange = G::max() - G::min();
    if (urngrange > urange)
    {
        unsigned long long uerange = urange + 1;
        if (urngrange == 0xFFFFFFFFFFFFFFFFULL)
        {
            unsigned long long low = 0;
            unsigned long long high = __mul_hi(g() - G::min(), uerange, low);
            if (low < uerange)
            {
                unsigned long long threshold = (0ULL - uerange) % uerange;
                while (low < threshold)
                    high = __mul_hi(g() - G::min(), uerange, low);
            }
            return high;
        }
        if (urngrange == 0xFFFFFFFFULL)
        {
            unsigned long long product = (g() - G::min()) * uerange;
            unsigned long long low = product & 0xFFFFFFFFULL;
            if (low < uerange)
            {
                unsigned long long threshold = ((0ULL - uerange) & 0xFFFFFFFFULL) % uerange;
                while (low < threshold)
                {
                    product = (g() - G::min()) * uerange;
                    low = product & 0xFFFFFFFFULL;
                }
            }
            return product >> 32;
        }
        unsigned long long scaling = urngrange / uerange, past = uerange * scaling, ret;
        do
            ret = g() - G::min();
        while (ret >= past);
        return ret / scaling;
    }
    if (urngrange < urange)
    {
        // upscaling: (urange+1) needs more than one draw
        unsigned long long ret, tmp;
        do
        {
            unsigned long long uerngrange = urngrange + 1;
            tmp = uerngrange * __uniform_u64(g, urange / uerngrange);
            ret = tmp + (g() - G::min());
        } while (ret > urange || ret < tmp);
        return ret;
    }
    return g() - G::min();
}

template <typename T>
class uniform_int_distribution
{
  public:
    uniform_int_distribution(T a = 0, T b = (T)0x7FFFFFFF) : a_(a), b_(b) {}
    template <typename G>
    T operator()(G &g)
    {
        unsigned long long urange = (unsigned long long)b_ - (unsigned long long)a_;
        return (T)(__uniform_u64(g, urange) + (unsigned long long)a_);
    }
    T a() const { return a_; }
    T b() const { return b_; }

  private:
    T a_, b_;
};

// generate_canonical<double, 53>: one draw over the generator's range
template <typename G>
double __canonical(G &g)
{
    double ret;
    if (G::max() - G::min() == 0xFFFFFFFFULL)
    {
        // 32-bit draws: two of them, (lo + hi * 2^32) / 2^64
        unsigned long long lo = g() - G::min();
        unsigned long long hi = g() - G::min();
        ret = (double)(lo + (hi << 32)) / 18446744073709551616.0;
    }
    else
        ret = (double)(g() - G::min()) / 18446744073709551616.0;
    if (ret >= 1.0)
        ret = 0.99999999999999989; // nextafter(1.0, 0.0)
    return ret;
}

template <typename T>
class uniform_real_distribution
{
  public:
    uniform_real_distribution(T a = 0, T b = 1) : a_(a), b_(b) {}
    template <typename G>
    T operator()(G &g)
    {
        return (T)(__canonical(g) * (b_ - a_) + a_);
    }

  private:
    T a_, b_;
};

} // namespace std
)QNATIVELIB"},
        {"regex", R"QNATIVELIB(// <regex> for Quantum's native backend: ECMAScript regular expressions as
// libstdc++ runs them. A pattern compiles to a small program run by a
// backtracking matcher with its own stack (no recursion per character):
// alternatives in order, greedy and lazy quantifiers, groups, lookahead,
// back-references, classes, anchors and word boundaries; icase, multiline,
// nosubs. regex_search / regex_match / regex_replace, match_results,
// regex_iterator follow the standard (and libstdc++'s choices: `.` stops at
// \n and \r, \s \w \d are the C locale's).
#pragma once
#include <string>
#include <vector>
#include <stdexcept>
#include <memory>

namespace std
{

namespace regex_constants
{
typedef unsigned syntax_option_type;
const unsigned icase = 1;
const unsigned nosubs = 2;
const unsigned optimize = 4;
const unsigned collate = 8;
const unsigned ECMAScript = 16;
const unsigned basic = 32;
const unsigned extended = 64;
const unsigned awk = 128;
const unsigned grep = 256;
const unsigned egrep = 512;
const unsigned multiline = 1024;

typedef unsigned match_flag_type;
const unsigned match_default = 0;
const unsigned match_not_bol = 1;
const unsigned match_not_eol = 2;
const unsigned match_not_bow = 4;
const unsigned match_not_eow = 8;
const unsigned match_any = 16;
const unsigned match_not_null = 32;
const unsigned match_continuous = 64;
const unsigned match_prev_avail = 128;
const unsigned format_default = 0;
const unsigned format_sed = 256;
const unsigned format_no_copy = 512;
const unsigned format_first_only = 1024;

typedef int error_type;
} // namespace regex_constants

class regex_error : public runtime_error
{
  public:
    explicit regex_error(const string &what) : runtime_error(what), code_(0) {}
    regex_error(int code, const string &what) : runtime_error(what), code_(code) {}
    int code() const { return code_; }

  private:
    int code_;
};

// the program
enum
{
    __RX_CHAR,     // a: the byte
    __RX_ANY,      // . (not \n \r)
    __RX_CLASS,    // a: class index
    __RX_SPLIT,    // try a, then b
    __RX_JMP,      // a
    __RX_SAVE,     // a: capture slot
    __RX_BOL,      // ^
    __RX_EOL,      // $
    __RX_WORDB,    // \b (b: 1 for \B)
    __RX_BACKREF,  // a: group
    __RX_LOOK,     // a: sub-program start, b: 1 negative; continues after its MATCH at c
    __RX_MARK,     // a: loop counter slot: the position now
    __RX_CHECK,    // a: loop counter slot: no progress: on to b (the loop's exit)
    __RX_MATCH,
};

struct __rx_ins
{
    int op;
    int a;
    int b;
    int c;
};

struct __rx_class
{
    bool neg = false;
    vector<pair<int, int>> ranges; // byte ranges
    bool digit = false, ndigit = false, word = false, nword = false, space = false, nspace = false;
};

inline bool __rx_isword(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}
inline bool __rx_isspace(int c) { return c == ' ' || (c >= 9 && c <= 13); }
inline bool __rx_isdigit(int c) { return c >= '0' && c <= '9'; }
inline int __rx_lower(int c) { return c >= 'A' && c <= 'Z' ? c + 32 : c; }
inline int __rx_upper(int c) { return c >= 'a' && c <= 'z' ? c - 32 : c; }

// pattern -> program (recursive descent over the ECMAScript grammar)
class __rx_compiler
{
  public:
    __rx_compiler(const string &p, unsigned flags) : p_(p), i_(0), flags_(flags), groups_(0), counters_(0) {}
    vector<__rx_ins> prog;
    vector<__rx_class> classes;
    int groups() const { return groups_; }
    int counters() const { return counters_; }

    void compile()
    {
        emit(__RX_SAVE, 0);
        alternation();
        if (i_ < p_.size())
            throw regex_error(5, "Unexpected character in regular expression.");
        emit(__RX_SAVE, 1);
        emit(__RX_MATCH);
    }

  private:
    const string &p_;
    size_t i_;
    unsigned flags_;
    int groups_;
    int counters_;

    int emit(int op, int a = 0, int b = 0, int c = 0)
    {
        __rx_ins x;
        x.op = op;
        x.a = a;
        x.b = b;
        x.c = c;
        prog.push_back(x);
        return (int)prog.size() - 1;
    }
    bool more() const { return i_ < p_.size(); }
    char peek() const { return p_[i_]; }

    void alternation()
    {
        int start = (int)prog.size();
        sequence();
        if (!more() || peek() != '|')
            return;
        // a | b | c:  SPLIT(a, rest) a JMP(end) ...
        vector<int> jumps;
        while (more() && peek() == '|')
        {
            ++i_;
            // put a SPLIT before what was compiled from `start`
            __rx_ins split;
            split.op = __RX_SPLIT;
            split.a = start + 1;
            split.b = 0;
            split.c = 0;
            insertAt(start, split);
            jumps.push_back(emit(__RX_JMP));
            prog[start].b = (int)prog.size();
            start = (int)prog.size();
            sequence();
        }
        for (size_t k = 0; k < jumps.size(); ++k)
            prog[jumps[k]].a = (int)prog.size();
    }

    // shifts the program from `at` on by one, fixing jump targets: a jump
    // from before `at` to `at` now reaches the inserted instruction, one from
    // the moved part follows its target
    static void shift(int &t, int at, bool inside)
    {
        if (t > at || (t == at && inside))
            ++t;
    }
    void insertAt(int at, const __rx_ins &x)
    {
        prog.insert(prog.begin() + at, x);
        for (size_t k = 0; k < prog.size(); ++k)
        {
            if ((int)k == at)
                continue;
            bool inside = (int)k > at;
            __rx_ins &y = prog[k];
            if (y.op == __RX_SPLIT)
            {
                shift(y.a, at, inside);
                shift(y.b, at, inside);
            }
            else if (y.op == __RX_JMP)
                shift(y.a, at, inside);
            else if (y.op == __RX_CHECK)
                shift(y.b, at, inside);
            else if (y.op == __RX_LOOK)
            {
                shift(y.a, at, inside);
                shift(y.c, at, inside);
            }
        }
    }

    void sequence()
    {
        while (more() && peek() != '|' && peek() != ')')
            quantified();
    }

    // an atom and its quantifier
    void quantified()
    {
        int start = (int)prog.size();
        bool canRepeat = atom();
        if (!more())
            return;
        char q = peek();
        int lo = -1, hi = -1;
        if (q == '*')
        {
            lo = 0;
            hi = -1;
            ++i_;
        }
        else if (q == '+')
        {
            lo = 1;
            hi = -1;
            ++i_;
        }
        else if (q == '?')
        {
            lo = 0;
            hi = 1;
            ++i_;
        }
        else if (q == '{' && braceAhead())
        {
            ++i_;
            lo = number();
            hi = lo;
            if (more() && peek() == ',')
            {
                ++i_;
                hi = more() && peek() == '}' ? -1 : number();
            }
            if (!more() || peek() != '}')
                throw regex_error(7, "Unexpected character in brace expression.");
            ++i_;
            if (hi >= 0 && hi < lo)
                throw regex_error(7, "Invalid range in brace expression.");
        }
        else
            return;
        if (!canRepeat)
            throw regex_error(10, "Nothing to repeat.");
        bool lazy = false;
        if (more() && peek() == '?')
        {
            lazy = true;
            ++i_;
        }
        vector<__rx_ins> body(prog.begin() + start, prog.end());
        prog.resize((size_t)start);
        for (int k = 0; k < lo; ++k)
            append(body);
        if (hi < 0)
        {
            // L: SPLIT(B, out); B: MARK c; body; CHECK c; JMP L
            int c = counters_++;
            int loop = emit(__RX_SPLIT);
            emit(__RX_MARK, c);
            append(body);
            int check = emit(__RX_CHECK, c);
            emit(__RX_JMP, loop);
            int out = (int)prog.size();
            prog[check].b = out;
            prog[loop].a = lazy ? out : loop + 1;
            prog[loop].b = lazy ? loop + 1 : out;
        }
        else
        {
            // up to hi - lo optional copies, each needing the one before
            vector<int> splits;
            for (int k = lo; k < hi; ++k)
            {
                splits.push_back(emit(__RX_SPLIT));
                append(body);
            }
            int out = (int)prog.size();
            for (size_t k = 0; k < splits.size(); ++k)
            {
                prog[splits[k]].a = lazy ? out : splits[k] + 1;
                prog[splits[k]].b = lazy ? splits[k] + 1 : out;
            }
        }
    }

    // a copy of a compiled piece at the end, its targets moved along (the
    // piece was compiled at pieceStart_)
    void append(const vector<__rx_ins> &body)
    {
        if (body.empty())
            return;
        int base = (int)prog.size();
        for (size_t k = 0; k < body.size(); ++k)
            prog.push_back(body[k]);
        relocate(base, (int)body.size());
    }
    void relocate(int base, int n)
    {
        int delta = base - pieceStart_;
        for (int k = base; k < base + n; ++k)
        {
            __rx_ins &y = prog[k];
            if (y.op == __RX_SPLIT)
            {
                y.a += delta;
                y.b += delta;
            }
            else if (y.op == __RX_JMP)
                y.a += delta;
            else if (y.op == __RX_CHECK)
                y.b += delta;
            else if (y.op == __RX_LOOK)
            {
                y.a += delta;
                y.c += delta;
            }
        }
    }
    int pieceStart_ = 0;

    bool braceAhead() const
    {
        size_t k = i_ + 1;
        if (k >= p_.size() || !__rx_isdigit(p_[k]))
            return false;
        while (k < p_.size() && (__rx_isdigit(p_[k]) || p_[k] == ','))
            ++k;
        return k < p_.size() && p_[k] == '}';
    }
    int number()
    {
        if (!more() || !__rx_isdigit(peek()))
            throw regex_error(7, "Unexpected character in brace expression.");
        int v = 0;
        while (more() && __rx_isdigit(peek()))
            v = v * 10 + (p_[i_++] - '0');
        return v;
    }

    void literal(int c)
    {
        if ((flags_ & regex_constants::icase) && __rx_lower(c) != __rx_upper(c))
        {
            __rx_class k;
            k.ranges.push_back(pair<int, int>(__rx_lower(c), __rx_lower(c)));
            k.ranges.push_back(pair<int, int>(__rx_upper(c), __rx_upper(c)));
            classes.push_back(k);
            emit(__RX_CLASS, (int)classes.size() - 1);
        }
        else
            emit(__RX_CHAR, c);
    }

    int hexDigits(int n)
    {
        int v = 0;
        for (int k = 0; k < n; ++k)
        {
            if (!more())
                throw regex_error(2, "Unexpected end of regex when escaping.");
            char c = p_[i_++];
            int d = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
            if (d < 0)
                throw regex_error(2, "Unexpected character in escape.");
            v = v * 16 + d;
        }
        return v;
    }

    // an escape's single character (-1: a class escape, set in k)
    int escapeChar(__rx_class &k, bool inClass)
    {
        if (!more())
            throw regex_error(2, "Unexpected end of regex when escaping.");
        char c = p_[i_++];
        switch (c)
        {
        case 'n': return '\n';
        case 't': return '\t';
        case 'r': return '\r';
        case 'f': return '\f';
        case 'v': return '\v';
        case '0': return 0;
        case 'x': return hexDigits(2);
        case 'u':
        {
            int u = hexDigits(4);
            return u < 256 ? u : '?';
        }
        case 'c':
        {
            if (!more())
                throw regex_error(2, "Unexpected end of regex when escaping.");
            return p_[i_++] % 32;
        }
        case 'd': k.digit = true; return -1;
        case 'D': k.ndigit = true; return -1;
        case 'w': k.word = true; return -1;
        case 'W': k.nword = true; return -1;
        case 's': k.space = true; return -1;
        case 'S': k.nspace = true; return -1;
        case 'b':
            if (inClass)
                return '\b';
            return -2;
        default: return (unsigned char)c;
        }
    }

    // compiles one atom; false for an assertion (nothing to repeat)
    bool atom()
    {
        pieceStart_ = (int)prog.size();
        char c = p_[i_++];
        if (c == '^')
        {
            emit(__RX_BOL);
            return false;
        }
        if (c == '$')
        {
            emit(__RX_EOL);
            return false;
        }
        if (c == '.')
        {
            emit(__RX_ANY);
            return true;
        }
        if (c == '(')
        {
            if (more() && peek() == '?')
            {
                ++i_;
                char kind = more() ? p_[i_++] : 0;
                if (kind == ':')
                {
                    int start = (int)prog.size();
                    alternation();
                    closeParen();
                    pieceStart_ = start;
                    return true;
                }
                if (kind == '=' || kind == '!')
                {
                    int look = emit(__RX_LOOK, 0, kind == '!' ? 1 : 0);
                    int start = (int)prog.size();
                    alternation();
                    closeParen();
                    emit(__RX_MATCH);
                    prog[look].a = start;
                    prog[look].c = (int)prog.size();
                    pieceStart_ = look;
                    return false;
                }
                throw regex_error(5, "Invalid special open parenthesis.");
            }
            int g = ++groups_;
            int start = (int)prog.size();
            bool subs = !(flags_ & regex_constants::nosubs);
            if (subs)
                emit(__RX_SAVE, 2 * g);
            alternation();
            closeParen();
            if (subs)
                emit(__RX_SAVE, 2 * g + 1);
            pieceStart_ = start;
            return true;
        }
        if (c == '[')
        {
            charClass();
            return true;
        }
        if (c == '\\')
        {
            if (more() && __rx_isdigit(peek()) && peek() != '0')
            {
                int g = 0;
                while (more() && __rx_isdigit(peek()))
                    g = g * 10 + (p_[i_++] - '0');
                emit(__RX_BACKREF, g);
                return true;
            }
            if (more() && (peek() == 'b' || peek() == 'B'))
            {
                emit(__RX_WORDB, 0, p_[i_++] == 'B' ? 1 : 0);
                return false;
            }
            __rx_class k;
            int e = escapeChar(k, false);
            if (e == -1)
            {
                classes.push_back(k);
                emit(__RX_CLASS, (int)classes.size() - 1);
            }
            else
                literal(e);
            return true;
        }
        if (c == '*' || c == '+' || c == '?')
            throw regex_error(10, "Nothing to repeat.");
        if (c == ')')
            throw regex_error(5, "Unexpected ) in regular expression.");
        literal((unsigned char)c);
        return true;
    }

    void closeParen()
    {
        if (!more() || peek() != ')')
            throw regex_error(5, "Parenthesis is not closed.");
        ++i_;
    }

    void charClass()
    {
        __rx_class k;
        if (more() && peek() == '^')
        {
            k.neg = true;
            ++i_;
        }
        bool first = true;
        while (true)
        {
            if (!more())
                throw regex_error(4, "Unexpected end of character class.");
            char c = peek();
            if (c == ']' && !first)
            {
                ++i_;
                break;
            }
            first = false;
            if (c == '[' && i_ + 1 < p_.size() && p_[i_ + 1] == ':')
            {
                size_t close = p_.find(":]", i_ + 2);
                if (close == string::npos)
                    throw regex_error(4, "Unexpected character class open bracket.");
                string name = p_.substr(i_ + 2, close - i_ - 2);
                i_ = close + 2;
                posixClass(k, name);
                continue;
            }
            int lo;
            ++i_;
            if (c == '\\')
            {
                lo = escapeChar(k, true);
                if (lo == -1)
                    continue;
            }
            else
                lo = (unsigned char)c;
            if (more() && peek() == '-' && i_ + 1 < p_.size() && p_[i_ + 1] != ']')
            {
                ++i_;
                char d = p_[i_++];
                int hi;
                if (d == '\\')
                {
                    __rx_class dummy;
                    hi = escapeChar(dummy, true);
                    if (hi == -1)
                        throw regex_error(4, "Invalid range in bracket expression.");
                }
                else
                    hi = (unsigned char)d;
                if (hi < lo)
                    throw regex_error(4, "Invalid range in bracket expression.");
                addRange(k, lo, hi);
            }
            else
                addRange(k, lo, lo);
        }
        classes.push_back(k);
        emit(__RX_CLASS, (int)classes.size() - 1);
    }
    void posixClass(__rx_class &k, const string &name)
    {
        if (name == "alpha")
        {
            addRange(k, 'a', 'z');
            addRange(k, 'A', 'Z');
        }
        else if (name == "digit")
            k.digit = true;
        else if (name == "alnum")
        {
            addRange(k, 'a', 'z');
            addRange(k, 'A', 'Z');
            addRange(k, '0', '9');
        }
        else if (name == "space")
            k.space = true;
        else if (name == "upper")
            addRange(k, 'A', 'Z');
        else if (name == "lower")
            addRange(k, 'a', 'z');
        else if (name == "punct")
        {
            addRange(k, 33, 47);
            addRange(k, 58, 64);
            addRange(k, 91, 96);
            addRange(k, 123, 126);
        }
        else if (name == "xdigit")
        {
            addRange(k, '0', '9');
            addRange(k, 'a', 'f');
            addRange(k, 'A', 'F');
        }
        else if (name == "w")
            k.word = true;
        else if (name == "blank")
        {
            addRange(k, ' ', ' ');
            addRange(k, 9, 9);
        }
        else if (name == "cntrl")
        {
            addRange(k, 0, 31);
            addRange(k, 127, 127);
        }
        else if (name == "print")
            addRange(k, 32, 126);
        else if (name == "graph")
            addRange(k, 33, 126);
        else
            throw regex_error(1, "Invalid character class.");
    }
    void addRange(__rx_class &k, int lo, int hi)
    {
        k.ranges.push_back(pair<int, int>(lo, hi));
        if (flags_ & regex_constants::icase)
            for (int c = lo; c <= hi; ++c)
            {
                int o = __rx_lower(c) == c ? __rx_upper(c) : __rx_lower(c);
                if (o != c)
                    k.ranges.push_back(pair<int, int>(o, o));
            }
    }
};

class basic_regex
{
  public:
    typedef unsigned flag_type;
    static const unsigned icase = regex_constants::icase;
    static const unsigned nosubs = regex_constants::nosubs;
    static const unsigned optimize = regex_constants::optimize;
    static const unsigned collate = regex_constants::collate;
    static const unsigned ECMAScript = regex_constants::ECMAScript;
    static const unsigned multiline = regex_constants::multiline;
    static const unsigned extended = regex_constants::extended;

    basic_regex() : flags_(0), groups_(0), counters_(0) {}
    basic_regex(const string &p, unsigned flags = regex_constants::ECMAScript) { assign(p, flags); }
    basic_regex(const char *p, unsigned flags = regex_constants::ECMAScript) { assign(string(p), flags); }
    basic_regex &assign(const string &p, unsigned flags = regex_constants::ECMAScript)
    {
        __rx_compiler c(p, flags);
        c.compile();
        prog_ = make_shared<vector<__rx_ins>>(c.prog);
        classes_ = make_shared<vector<__rx_class>>(c.classes);
        flags_ = flags;
        groups_ = c.groups();
        counters_ = c.counters();
        return *this;
    }
    unsigned mark_count() const { return (unsigned)groups_; }
    unsigned flags() const { return flags_; }

    shared_ptr<vector<__rx_ins>> prog_;
    shared_ptr<vector<__rx_class>> classes_;
    unsigned flags_;
    int groups_;
    int counters_;
};
typedef basic_regex regex;

// one run of the program at `at`: true with the capture slots filled
class __rx_matcher
{
  public:
    __rx_matcher(const regex &re, const char *begin, const char *end, const char *base, unsigned mflags)
        : re_(re), prog_(*re.prog_), classes_(*re.classes_), b_(begin), e_(end), base_(base), mflags_(mflags)
    {
    }
    vector<long long> caps; // slot -> offset from b_ (-1: unset)

    // mode: 0 any end, 1 must end at e_; notNull: an empty match fails
    bool run(long long at, int mode, bool notNull)
    {
        caps.assign((size_t)(2 * re_.groups_ + 2), -1);
        counters_.assign((size_t)(re_.counters_ + 1), -1);
        return exec(0, at, mode, notNull, caps);
    }

  private:
    const regex &re_;
    const vector<__rx_ins> &prog_;
    const vector<__rx_class> &classes_;
    const char *b_;
    const char *e_;
    const char *base_; // where characters before b_ may be looked at (prev_avail)
    unsigned mflags_;
    vector<long long> counters_;

    struct Frame
    {
        int kind; // 0: a branch to try, 1: a slot to restore, 2: a counter to restore
        int pc;
        long long pos;
        int slot;
        long long old;
    };

    int charAt(long long pos) const { return (unsigned char)b_[pos]; }
    bool inClass(const __rx_class &k, int c) const
    {
        bool in = false;
        for (size_t r = 0; r < k.ranges.size() && !in; ++r)
            if (c >= k.ranges[r].first && c <= k.ranges[r].second)
                in = true;
        if (!in && ((k.digit && __rx_isdigit(c)) || (k.ndigit && !__rx_isdigit(c)) || (k.word && __rx_isword(c)) ||
                    (k.nword && !__rx_isword(c)) || (k.space && __rx_isspace(c)) || (k.nspace && !__rx_isspace(c))))
            in = true;
        return in != k.neg;
    }
    bool isWordAt(long long pos) const
    {
        if (pos < 0)
            return b_ + pos >= base_ && __rx_isword((unsigned char)b_[pos]);
        if (b_ + pos >= e_)
            return false;
        return __rx_isword(charAt(pos));
    }

    bool exec(int startPc, long long startPos, int mode, bool notNull, vector<long long> &cap)
    {
        vector<Frame> stack;
        int pc = startPc;
        long long pos = startPos;
        long long n = e_ - b_;
        bool icase = (re_.flags_ & regex_constants::icase) != 0;
        bool multi = (re_.flags_ & regex_constants::multiline) != 0;
        while (true)
        {
            bool fail = false;
            const __rx_ins &x = prog_[pc];
            switch (x.op)
            {
            case __RX_CHAR:
                if (pos < n && charAt(pos) == x.a)
                {
                    ++pos;
                    ++pc;
                }
                else
                    fail = true;
                break;
            case __RX_ANY:
                if (pos < n && charAt(pos) != '\n' && charAt(pos) != '\r')
                {
                    ++pos;
                    ++pc;
                }
                else
                    fail = true;
                break;
            case __RX_CLASS:
                if (pos < n && inClass(classes_[x.a], charAt(pos)))
                {
                    ++pos;
                    ++pc;
                }
                else
                    fail = true;
                break;
            case __RX_SPLIT:
            {
                Frame f;
                f.kind = 0;
                f.pc = x.b;
                f.pos = pos;
                f.slot = 0;
                f.old = 0;
                stack.push_back(f);
                pc = x.a;
                break;
            }
            case __RX_JMP:
                pc = x.a;
                break;
            case __RX_SAVE:
            {
                Frame f;
                f.kind = 1;
                f.pc = 0;
                f.pos = 0;
                f.slot = x.a;
                f.old = cap[x.a];
                stack.push_back(f);
                cap[x.a] = pos;
                ++pc;
                break;
            }
            case __RX_BOL:
            {
                bool ok;
                if (pos == 0 && !(mflags_ & regex_constants::match_prev_avail))
                    ok = !(mflags_ & regex_constants::match_not_bol);
                else
                {
                    int prev = (unsigned char)b_[pos - 1];
                    ok = multi && (prev == '\n' || prev == '\r');
                }
                if (ok)
                    ++pc;
                else
                    fail = true;
                break;
            }
            case __RX_EOL:
            {
                bool ok;
                if (pos == n)
                    ok = !(mflags_ & regex_constants::match_not_eol);
                else
                    ok = multi && (charAt(pos) == '\n' || charAt(pos) == '\r');
                if (ok)
                    ++pc;
                else
                    fail = true;
                break;
            }
            case __RX_WORDB:
            {
                bool before = pos > 0 ? __rx_isword(charAt(pos - 1))
                                      : ((mflags_ & regex_constants::match_prev_avail) != 0 &&
                                         __rx_isword((unsigned char)b_[-1]));
                bool after = pos < n && __rx_isword(charAt(pos));
                bool atB = before != after;
                if (pos == 0 && !before && (mflags_ & regex_constants::match_not_bow))
                    atB = false;
                if (pos == n && (mflags_ & regex_constants::match_not_eow) && before)
                    atB = false;
                if (atB != (x.b == 1))
                    ++pc;
                else
                    fail = true;
                break;
            }
            case __RX_BACKREF:
            {
                long long s = 2 * x.a < (long long)cap.size() ? cap[2 * x.a] : -1;
                long long t = 2 * x.a + 1 < (long long)cap.size() ? cap[2 * x.a + 1] : -1;
                if (s < 0 || t < 0)
                {
                    ++pc;
                    break;
                }
                long long len = t - s;
                bool ok = pos + len <= n;
                for (long long k = 0; ok && k < len; ++k)
                {
                    int a = charAt(s + k), b = charAt(pos + k);
                    if (icase ? __rx_lower(a) != __rx_lower(b) : a != b)
                        ok = false;
                }
                if (ok)
                {
                    pos += len;
                    ++pc;
                }
                else
                    fail = true;
                break;
            }
            case __RX_LOOK:
            {
                vector<long long> sub = cap;
                bool found = exec(x.a, pos, 0, false, sub);
                if (found != (x.b == 1))
                {
                    if (!x.b)
                        for (size_t k = 0; k < cap.size(); ++k)
                            if (sub[k] != cap[k])
                            {
                                Frame f;
                                f.kind = 1;
                                f.pc = 0;
                                f.pos = 0;
                                f.slot = (int)k;
                                f.old = cap[k];
                                stack.push_back(f);
                                cap[k] = sub[k];
                            }
                    pc = x.c;
                }
                else
                    fail = true;
                break;
            }
            case __RX_MARK:
            {
                Frame f;
                f.kind = 2;
                f.pc = 0;
                f.pos = 0;
                f.slot = x.a;
                f.old = counters_[x.a];
                stack.push_back(f);
                counters_[x.a] = pos;
                ++pc;
                break;
            }
            case __RX_CHECK:
                if (counters_[x.a] == pos)
                    pc = x.b; // an empty iteration ends the loop (it still counts)
                else
                    ++pc;
                break;
            case __RX_MATCH:
                if (pc != (int)prog_.size() - 1)
                    return true; // the end of a lookahead's body
                if ((mode == 1 && pos != n) || (notNull && pos == startPos))
                    fail = true;
                else
                    return true;
                break;
            }
            if (!fail)
                continue;
            // back to the newest untried branch, undoing what came after it
            while (true)
            {
                if (stack.empty())
                    return false;
                Frame f = stack.back();
                stack.pop_back();
                if (f.kind == 1)
                    cap[f.slot] = f.old;
                else if (f.kind == 2)
                    counters_[f.slot] = f.old;
                else
                {
                    pc = f.pc;
                    pos = f.pos;
                    break;
                }
            }
        }
    }
};

class sub_match
{
  public:
    sub_match() : first(nullptr), second(nullptr), matched(false) {}
    const char *first;
    const char *second;
    bool matched;
    string str() const { return matched ? string(first, (size_t)(second - first)) : string(); }
    long long length() const { return matched ? second - first : 0; }
    operator string() const { return str(); }
    int compare(const string &s) const { return str().compare(s); }
    bool operator==(const string &s) const { return str() == s; }
    bool operator!=(const string &s) const { return str() != s; }
    bool operator==(const char *s) const { return str() == s; }
    bool operator!=(const char *s) const { return str() != s; }
};
inline string operator+(const string &a, const sub_match &b) { return a + b.str(); }
inline string operator+(const sub_match &a, const string &b) { return a.str() + b; }
inline string operator+(const char *a, const sub_match &b) { return string(a) + b.str(); }
inline string operator+(const sub_match &a, const char *b) { return a.str() + b; }

class match_results
{
  public:
    match_results() : ready_(false), begin_(nullptr) {}
    size_t size() const { return subs_.size(); }
    bool empty() const { return subs_.empty(); }
    bool ready() const { return ready_; }
    const sub_match &operator[](size_t i) const { return i < subs_.size() ? subs_[i] : none_; }
    string str(size_t i = 0) const { return (*this)[i].str(); }
    long long position(size_t i = 0) const { return (*this)[i].matched ? (*this)[i].first - begin_ : -1; }
    long long length(size_t i = 0) const { return (*this)[i].length(); }
    const sub_match &prefix() const { return prefix_; }
    const sub_match &suffix() const { return suffix_; }
    const sub_match *begin() const { return subs_.data(); }
    const sub_match *end() const { return subs_.data() + subs_.size(); }
    string format(const string &fmt) const
    {
        string out;
        for (size_t k = 0; k < fmt.size(); ++k)
        {
            char c = fmt[k];
            if (c != '$' || k + 1 >= fmt.size())
            {
                out += c;
                continue;
            }
            char d = fmt[k + 1];
            if (d == '$')
            {
                out += '$';
                ++k;
            }
            else if (d == '&')
            {
                out += str(0);
                ++k;
            }
            else if (d == '`')
            {
                out += prefix_.str();
                ++k;
            }
            else if (d == '\'')
            {
                out += suffix_.str();
                ++k;
            }
            else if (d >= '0' && d <= '9')
            {
                long long num = d - '0';
                k += 2;
                if (k < fmt.size() && fmt[k] >= '0' && fmt[k] <= '9')
                {
                    num = num * 10 + (fmt[k] - '0');
                    ++k;
                }
                if (num >= 0 && num < (long long)size())
                    out += str((size_t)num);
                --k;
            }
            else
                out += '$';
        }
        return out;
    }

    // filled by the search functions
    vector<sub_match> subs_;
    sub_match prefix_, suffix_, none_;
    bool ready_;
    const char *begin_;
};
typedef match_results smatch;
typedef match_results cmatch;
typedef sub_match ssub_match;
typedef sub_match csub_match;

// a search of [first, last) from `from` (or only at `from` with continuous)
inline bool __rx_search(const char *first, const char *last, const char *from, match_results *m, const regex &re,
                        unsigned flags, int mode)
{
    if (!re.prog_)
        return false;
    const char *base = (flags & regex_constants::match_prev_avail) ? nullptr : first;
    __rx_matcher mt(re, first, last, base ? base : (const char *)0, flags);
    long long n = last - first;
    long long startAt = from - first;
    bool notNull = (flags & regex_constants::match_not_null) != 0;
    for (long long at = startAt; at <= n; ++at)
    {
        if (mt.run(at, mode, notNull))
        {
            if (m)
            {
                m->subs_.assign((size_t)(re.groups_ + 1), sub_match());
                for (int g = 0; g <= re.groups_; ++g)
                {
                    long long s = mt.caps[(size_t)(2 * g)], e = mt.caps[(size_t)(2 * g + 1)];
                    if (s >= 0 && e >= 0)
                    {
                        m->subs_[(size_t)g].first = first + s;
                        m->subs_[(size_t)g].second = first + e;
                        m->subs_[(size_t)g].matched = true;
                    }
                }
                m->prefix_.first = from;
                m->prefix_.second = m->subs_[0].first;
                m->prefix_.matched = m->prefix_.first != m->prefix_.second;
                m->suffix_.first = m->subs_[0].second;
                m->suffix_.second = last;
                m->suffix_.matched = m->suffix_.first != m->suffix_.second;
                m->ready_ = true;
                m->begin_ = from;
            }
            return true;
        }
        if (mode == 1 || (flags & regex_constants::match_continuous))
            break;
    }
    if (m)
    {
        m->subs_.clear();
        m->ready_ = true;
    }
    return false;
}

inline bool regex_search(const char *first, const char *last, match_results &m, const regex &re,
                         unsigned flags = regex_constants::match_default)
{
    return __rx_search(first, last, first, &m, re, flags, 0);
}
inline bool regex_search(const char *first, const char *last, const regex &re,
                         unsigned flags = regex_constants::match_default)
{
    return __rx_search(first, last, first, nullptr, re, flags, 0);
}
inline bool regex_search(const string &s, match_results &m, const regex &re,
                         unsigned flags = regex_constants::match_default)
{
    return __rx_search(s.data(), s.data() + s.size(), s.data(), &m, re, flags, 0);
}
inline bool regex_search(const string &s, const regex &re, unsigned flags = regex_constants::match_default)
{
    return __rx_search(s.data(), s.data() + s.size(), s.data(), nullptr, re, flags, 0);
}
inline bool regex_search(const char *s, const regex &re, unsigned flags = regex_constants::match_default)
{
    return __rx_search(s, s + __strlen(s), s, nullptr, re, flags, 0);
}
inline bool regex_match(const char *first, const char *last, match_results &m, const regex &re,
                        unsigned flags = regex_constants::match_default)
{
    return __rx_search(first, last, first, &m, re, flags, 1);
}
inline bool regex_match(const string &s, match_results &m, const regex &re,
                        unsigned flags = regex_constants::match_default)
{
    return __rx_search(s.data(), s.data() + s.size(), s.data(), &m, re, flags, 1);
}
inline bool regex_match(const string &s, const regex &re, unsigned flags = regex_constants::match_default)
{
    return __rx_search(s.data(), s.data() + s.size(), s.data(), nullptr, re, flags, 1);
}
inline bool regex_match(const char *s, const regex &re, unsigned flags = regex_constants::match_default)
{
    return __rx_search(s, s + __strlen(s), s, nullptr, re, flags, 1);
}

// successive matches, as the standard's regex_iterator steps
class sregex_iterator
{
  public:
    sregex_iterator() : first_(nullptr), last_(nullptr), re_(nullptr), flags_(0), done_(true) {}
    sregex_iterator(const char *first, const char *last, const regex &re,
                    unsigned flags = regex_constants::match_default)
        : first_(first), last_(last), re_(&re), flags_(flags), done_(false)
    {
        if (!__rx_search(first_, last_, first_, &m_, *re_, flags_, 0))
            done_ = true;
    }
    const match_results &operator*() const { return m_; }
    const match_results *operator->() const { return &m_; }
    sregex_iterator &operator++()
    {
        const char *start = m_[0].second;
        unsigned fl = flags_ | regex_constants::match_prev_avail;
        if (m_[0].first == m_[0].second)
        {
            if (start == last_)
            {
                done_ = true;
                return *this;
            }
            if (__rx_search(first_, last_, start, &m_, *re_,
                            fl | regex_constants::match_not_null | regex_constants::match_continuous, 0))
            {
                m_.begin_ = first_;
                return *this;
            }
            ++start;
        }
        if (!__rx_search(first_, last_, start, &m_, *re_, fl, 0))
            done_ = true;
        else
            m_.begin_ = first_;
        return *this;
    }
    bool operator==(const sregex_iterator &o) const
    {
        if (done_ || o.done_)
            return done_ == o.done_;
        return m_[0].first == o.m_[0].first && m_[0].second == o.m_[0].second;
    }
    bool operator!=(const sregex_iterator &o) const { return !(*this == o); }

  private:
    const char *first_;
    const char *last_;
    const regex *re_;
    unsigned flags_;
    bool done_;
    match_results m_;
};
typedef sregex_iterator cregex_iterator;

// one piece a token iterator gives (as a sub_match would)
struct __rx_token
{
    string s;
    bool matched = true;
    string str() const { return s; }
    long long length() const { return (long long)s.size(); }
    operator string() const { return s; }
    bool operator==(const string &o) const { return s == o; }
    bool operator!=(const string &o) const { return s != o; }
};

// the pieces between matches (submatch -1) or one group of each match
class sregex_token_iterator
{
  public:
    sregex_token_iterator() : i_(0) {}
    sregex_token_iterator(const char *first, const char *last, const regex &re, int sub = 0) : i_(0)
    {
        const char *pos = first;
        for (sregex_iterator it(first, last, re), end; it != end; ++it)
        {
            if (sub == -1)
                parts_.push_back(__rx_token{string(pos, (size_t)((*it)[0].first - pos))});
            else
                parts_.push_back(__rx_token{(*it)[(size_t)sub].str()});
            pos = (*it)[0].second;
        }
        if (sub == -1 && (pos != last || !parts_.empty() || first == last))
            parts_.push_back(__rx_token{string(pos, (size_t)(last - pos))});
        if (sub == -1 && first == last)
            parts_.clear();
    }
    const __rx_token &operator*() const { return parts_[i_]; }
    const __rx_token *operator->() const { return &parts_[i_]; }
    sregex_token_iterator &operator++()
    {
        ++i_;
        return *this;
    }
    bool operator==(const sregex_token_iterator &o) const { return i_ >= parts_.size() && o.i_ >= o.parts_.size(); }
    bool operator!=(const sregex_token_iterator &o) const { return !(*this == o); }

  private:
    vector<__rx_token> parts_;
    size_t i_;
};

inline string regex_replace(const string &s, const regex &re, const string &fmt,
                            unsigned flags = regex_constants::format_default)
{
    string out;
    const char *first = s.data(), *last = s.data() + s.size();
    const char *pos = first;
    bool any = false;
    for (sregex_iterator it(first, last, re, flags & 255), end; it != end; ++it)
    {
        any = true;
        if (!(flags & regex_constants::format_no_copy))
            out.append(pos, (size_t)((*it)[0].first - pos));
        out += it->format(fmt);
        pos = (*it)[0].second;
        if (flags & regex_constants::format_first_only)
            break;
    }
    if (!(flags & regex_constants::format_no_copy))
        out.append(pos, (size_t)(last - pos));
    (void)any;
    return out;
}
inline string regex_replace(const string &s, const regex &re, const char *fmt,
                            unsigned flags = regex_constants::format_default)
{
    return regex_replace(s, re, string(fmt), flags);
}

} // namespace std
)QNATIVELIB"},
        {"set", R"QNATIVELIB(// <set> for Quantum's native backend: std::set over the AVL tree in <__tree>
// (keys ordered by <).
#pragma once
#include <__tree>
#include <initializer_list>

namespace std
{

template <typename K>
class set
{
  public:
    typedef __tsiter<K> iterator;
    typedef __tsiter<K> const_iterator;
    typedef K value_type;
    typedef K key_type;

    set() {}
    set(initializer_list<K> items)
    {
        for (const K &k : items)
            insert(k);
    }
    set(const set &o) { t_.copyFrom(o.t_); }
    set(set &&o) { t_.takeFrom(o.t_); }
    template <typename __InputIt>
    set(__InputIt first, __InputIt last)
    {
        for (; first != last; ++first)
            insert(*first);
    }
    set &operator=(const set &o)
    {
        if (this != &o)
        {
            t_.clear();
            t_.copyFrom(o.t_);
        }
        return *this;
    }
    set &operator=(set &&o)
    {
        if (this != &o)
        {
            t_.clear();
            t_.takeFrom(o.t_);
        }
        return *this;
    }

    size_t size() const { return t_.size_; }
    bool empty() const { return t_.size_ == 0; }
    iterator begin() const { return iterator(t_.first(), &t_); }
    iterator end() const { return iterator(nullptr, &t_); }
    iterator find(const K &k) const { return iterator(t_.find(k), &t_); }
    size_t count(const K &k) const { return t_.find(k) ? 1 : 0; }
    bool contains(const K &k) const { return t_.find(k) != nullptr; }
    iterator lower_bound(const K &k) const { return iterator(t_.lowerBound(k), &t_); }
    iterator upper_bound(const K &k) const { return iterator(t_.upperBound(k), &t_); }

    pair<iterator, bool> insert(const K &k)
    {
        bool added = false;
        __tnode<K, char> *n = t_.insert(pair<K, char>(k, 0), added);
        return pair<iterator, bool>(iterator(n, &t_), added);
    }
    template <typename __InputIt>
    void insert(__InputIt first, __InputIt last)
    {
        for (; first != last; ++first)
            insert(*first);
    }
    pair<iterator, bool> emplace(const K &k) { return insert(k); }
    size_t erase(const K &k)
    {
        __tnode<K, char> *n = t_.find(k);
        if (!n)
            return 0;
        t_.erase(n);
        return 1;
    }
    iterator erase(iterator it)
    {
        __tnode<K, char> *next = __tree<K, char>::next(it.n_);
        t_.erase(it.n_);
        return iterator(next, &t_);
    }
    void clear() { t_.clear(); }
    void swap(set &o) { t_.swap(o.t_); }
    iterator erase(iterator first, iterator last)
    {
        while (first != last)
            first = erase(first);
        return last;
    }
    bool operator==(const set &o) const
    {
        if (size() != o.size())
            return false;
        for (__tnode<K, char> *a = t_.first(), *b = o.t_.first(); a; a = __tree<K, char>::next(a), b = __tree<K, char>::next(b))
            if (!(a->kv.first == b->kv.first))
                return false;
        return true;
    }
    bool operator!=(const set &o) const { return !(*this == o); }

  private:
    __tree<K, char> t_;
};

} // namespace std
