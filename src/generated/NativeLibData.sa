template <typename R, typename A0, typename A1, typename A2, typename A3, typename A4, typename A5>
struct __fn_base6
{
    virtual ~__fn_base6() {}
    virtual R __call(A0 a0, A1 a1, A2 a2, A3 a3, A4 a4, A5 a5) = 0;
    virtual __fn_base6 *__clone() const = 0;
};

template <typename F, typename R, typename A0, typename A1, typename A2, typename A3, typename A4, typename A5>
struct __fn_impl6 : __fn_base6<R, A0, A1, A2, A3, A4, A5>
{
    F f;
    explicit __fn_impl6(const F &g) : f(g) {}
    R __call(A0 a0, A1 a1, A2 a2, A3 a3, A4 a4, A5 a5) override { return f(a0, a1, a2, a3, a4, a5); }
    __fn_base6<R, A0, A1, A2, A3, A4, A5> *__clone() const override { return new __fn_impl6(f); }
};

template <typename R, typename A0, typename A1, typename A2, typename A3, typename A4, typename A5>
class __function6
{
  public:
    __function6() : h_(nullptr) {}
    __function6(void *null) : h_(nullptr) {}
    template <typename F>
    __function6(F f) : h_(new __fn_impl6<F, R, A0, A1, A2, A3, A4, A5>(f))
    {
    }
    __function6(const __function6 &o) : h_(o.h_ ? o.h_->__clone() : nullptr) {}
    __function6(__function6 &&o) : h_(o.h_) { o.h_ = nullptr; }
    ~__function6() { delete h_; }
    __function6 &operator=(const __function6 &o)
    {
        if (this != &o)
        {
            delete h_;
            h_ = o.h_ ? o.h_->__clone() : nullptr;
        }
        return *this;
    }
    __function6 &operator=(__function6 &&o)
    {
        if (this != &o)
        {
            delete h_;
            h_ = o.h_;
            o.h_ = nullptr;
        }
        return *this;
    }
    __function6 &operator=(void *null)
    {
        delete h_;
        h_ = nullptr;
        return *this;
    }
    template <typename F>
    __function6 &operator=(F f)
    {
        __fn_base6<R, A0, A1, A2, A3, A4, A5> *h = new __fn_impl6<F, R, A0, A1, A2, A3, A4, A5>(f);
        delete h_;
        h_ = h;
        return *this;
    }
    R operator()(A0 a0, A1 a1, A2 a2, A3 a3, A4 a4, A5 a5) const { return h_->__call(a0, a1, a2, a3, a4, a5); }
    explicit operator bool() const { return h_ != nullptr; }
    bool operator!() const { return h_ == nullptr; }
    __fn_base6<R, A0, A1, A2, A3, A4, A5> *h_;
};

