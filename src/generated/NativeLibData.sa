        {"memory", R"QNATIVELIB(// <memory> for Quantum's native backend: unique_ptr, shared_ptr, weak_ptr,
// enable_shared_from_this. std::make_unique<T>(args) and
// std::make_shared<T>(args) are built in (the pointer made from new T(args)).
#pragma once
#include <utility>

namespace std
{

template <typename T>
class unique_ptr
{
  public:
    unique_ptr() : p_(nullptr) {}
    unique_ptr(void *null) : p_(nullptr) {}
    explicit unique_ptr(T *p) : p_(p) {}
    unique_ptr(unique_ptr &&o) : p_(o.p_) { o.p_ = nullptr; }
    template <typename U>
    unique_ptr(unique_ptr<U> &&o) : p_(o.release())
    {
    }
    unique_ptr(const unique_ptr &) = delete;
    ~unique_ptr() { delete p_; }

    unique_ptr &operator=(unique_ptr &&o)
    {
        reset(o.release());
        return *this;
    }
    template <typename U>
    unique_ptr &operator=(unique_ptr<U> &&o)
    {
        reset(o.release());
        return *this;
    }
    unique_ptr &operator=(const unique_ptr &) = delete;
    unique_ptr &operator=(void *null)
    {
        reset();
        return *this;
    }

    T *get() const { return p_; }
    T &operator*() const { return *p_; }
    T *operator->() const { return p_; }
    explicit operator bool() const { return p_ != nullptr; }
    bool operator!() const { return p_ == nullptr; }
    bool operator==(const T *o) const { return p_ == o; }
    bool operator!=(const T *o) const { return p_ != o; }
    bool operator==(const unique_ptr &o) const { return p_ == o.p_; }
    bool operator!=(const unique_ptr &o) const { return p_ != o.p_; }
    T *release()
    {
        T *p = p_;
        p_ = nullptr;
        return p;
    }
    void reset(T *p = nullptr)
    {
        T *old = p_;
        p_ = p;
        delete old;
    }

  private:
    T *p_;
};

// shared ownership: one count block per object, which deletes it (as the
// type it was made with) when the last owner lets go
struct __sp_count
{
    long long refs = 1;
    long long weak = 1; // the owners together hold one
    virtual void __dispose() {}
    virtual ~__sp_count() {}
    void __addRef() { ++refs; }
    void __release()
    {
        if (--refs == 0)
        {
            __dispose();
            __releaseWeak();
        }
    }
    void __releaseWeak()
    {
        if (--weak == 0)
            delete this;
    }
};

template <typename U>
struct __sp_owned : __sp_count
{
    U *p;
    explicit __sp_owned(U *q) : p(q) {}
    void __dispose() override { delete p; }
};

template <typename T>
class shared_ptr
{
  public:
    shared_ptr() : p_(nullptr), c_(nullptr) {}
    shared_ptr(void *null) : p_(nullptr), c_(nullptr) {}
    template <typename U>
    explicit shared_ptr(U *p) : p_(p), c_(nullptr)
    {
        if (p)
        {
            c_ = new __sp_owned<U>(p);
            __shared_hook(p, c_); // enable_shared_from_this
        }
    }
    // aliasing: a pointer owned by c (shared_from_this, weak_ptr::lock)
    shared_ptr(T *p, __sp_count *c) : p_(p), c_(c)
    {
        if (c_)
            c_->__addRef();
    }
    // aliasing: shares r's ownership, points at p
    template <typename U>
    shared_ptr(const shared_ptr<U> &r, T *p) : p_(p), c_(r.__count())
    {
        if (c_)
            c_->__addRef();
    }
    shared_ptr(const shared_ptr &o) : p_(o.p_), c_(o.c_)
    {
        if (c_)
            c_->__addRef();
    }
    shared_ptr(shared_ptr &&o) : p_(o.p_), c_(o.c_)
    {
        o.p_ = nullptr;
        o.c_ = nullptr;
    }
    template <typename U>
    shared_ptr(const shared_ptr<U> &o) : p_(o.__ptr()), c_(o.__count())
    {
        if (c_)
            c_->__addRef();
    }
    template <typename U>
    shared_ptr(shared_ptr<U> &&o) : p_(o.__ptr()), c_(o.__count())
    {
        o.__forget();
    }
    template <typename U>
    shared_ptr(unique_ptr<U> &&o) : p_(nullptr), c_(nullptr)
    {
        U *p = o.release();
        p_ = p;
        if (p)
        {
            c_ = new __sp_owned<U>(p);
            __shared_hook(p, c_);
        }
    }
    ~shared_ptr()
    {
        if (c_)
            c_->__release();
    }

    shared_ptr &operator=(const shared_ptr &o)
    {
        if (o.c_)
            o.c_->__addRef();
        if (c_)
            c_->__release();
        p_ = o.p_;
        c_ = o.c_;
        return *this;
    }
    shared_ptr &operator=(shared_ptr &&o)
    {
        if (this != &o)
        {
            if (c_)
                c_->__release();
            p_ = o.p_;
            c_ = o.c_;
            o.p_ = nullptr;
            o.c_ = nullptr;
        }
        return *this;
    }
    template <typename U>
    shared_ptr &operator=(const shared_ptr<U> &o)
    {
        shared_ptr t(o);
        swap(t);
        return *this;
    }
    template <typename U>
    shared_ptr &operator=(shared_ptr<U> &&o)
    {
        shared_ptr t(std::move(o));
        swap(t);
        return *this;
    }

    T *get() const { return p_; }
    T &operator*() const { return *p_; }
    T *operator->() const { return p_; }
    explicit operator bool() const { return p_ != nullptr; }
    bool operator!() const { return p_ == nullptr; }
    long long use_count() const { return c_ ? c_->refs : 0; }
    void reset()
    {
        if (c_)
            c_->__release();
        p_ = nullptr;
        c_ = nullptr;
    }
    template <typename U>
    void reset(U *p)
    {
        shared_ptr t(p);
        swap(t);
    }
    void swap(shared_ptr &o)
    {
        T *p = p_;
        __sp_count *c = c_;
        p_ = o.p_;
        c_ = o.c_;
        o.p_ = p;
        o.c_ = c;
    }
    template <typename U>
    bool operator==(const shared_ptr<U> &o) const
    {
        return (const void *)p_ == (const void *)o.get();
    }
    template <typename U>
    bool operator!=(const shared_ptr<U> &o) const
    {
        return (const void *)p_ != (const void *)o.get();
    }
    template <typename U>
    bool operator<(const shared_ptr<U> &o) const
    {
        return (const void *)p_ < (const void *)o.get();
    }
    bool operator==(const T *o) const { return p_ == o; }
    bool operator!=(const T *o) const { return p_ != o; }

    T *__ptr() const { return p_; }
    __sp_count *__count() const { return c_; }
    void __forget()
    {
        p_ = nullptr;
        c_ = nullptr;
    }

  private:
    T *p_;
    __sp_count *c_;
};

template <typename T>
class weak_ptr
{
  public:
    weak_ptr() : p_(nullptr), c_(nullptr) {}
    template <typename U>
    weak_ptr(const shared_ptr<U> &s) : p_(s.__ptr()), c_(s.__count())
    {
        if (c_)
            ++c_->weak;
    }
    weak_ptr(const weak_ptr &o) : p_(o.p_), c_(o.c_)
    {
        if (c_)
            ++c_->weak;
    }
    weak_ptr(weak_ptr &&o) : p_(o.p_), c_(o.c_)
    {
        o.p_ = nullptr;
        o.c_ = nullptr;
    }
    ~weak_ptr()
    {
        if (c_)
            c_->__releaseWeak();
    }
    weak_ptr &operator=(const weak_ptr &o)
    {
        if (o.c_)
            ++o.c_->weak;
        if (c_)
            c_->__releaseWeak();
        p_ = o.p_;
        c_ = o.c_;
        return *this;
    }
    weak_ptr &operator=(weak_ptr &&o)
    {
        if (this != &o)
        {
            if (c_)
                c_->__releaseWeak();
            p_ = o.p_;
            c_ = o.c_;
            o.p_ = nullptr;
            o.c_ = nullptr;
        }
        return *this;
    }
    template <typename U>
    weak_ptr &operator=(const shared_ptr<U> &s)
    {
        weak_ptr t(s);
        *this = std::move(t);
        return *this;
    }
    bool expired() const { return !c_ || c_->refs == 0; }
    long long use_count() const { return c_ ? c_->refs : 0; }
    shared_ptr<T> lock() const
    {
        if (expired())
            return shared_ptr<T>();
        return shared_ptr<T>(p_, c_);
    }
    void reset()
    {
        if (c_)
            c_->__releaseWeak();
        p_ = nullptr;
        c_ = nullptr;
    }

  private:
    T *p_;
    __sp_count *c_;
};

// the object knows its count block (set when a shared_ptr first owns it)
template <typename T>
class enable_shared_from_this
{
  public:
    shared_ptr<T> shared_from_this() { return shared_ptr<T>(static_cast<T *>(this), __self_count); }
    weak_ptr<T> weak_from_this() { return weak_ptr<T>(shared_from_this()); }
    __sp_count *__self_count = nullptr;
};

