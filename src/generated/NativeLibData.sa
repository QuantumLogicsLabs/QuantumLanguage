        {"string_view", R"QNATIVELIB(// <string_view> for Quantum's native backend: a view as (pointer, length).
#pragma once
#include <string>

namespace std
{

class string_view
{
  public:
    static const size_t npos = (size_t)-1;
    string_view() : p_(""), n_(0) {}
    string_view(const char *s) : p_(s), n_(strlen(s)) {}
    string_view(const char *s, size_t n) : p_(s), n_(n) {}
    string_view(const string &s) : p_(s.data()), n_(s.size()) {}
    size_t size() const { return n_; }
    size_t length() const { return n_; }
    bool empty() const { return n_ == 0; }
    const char *data() const { return p_; }
    char operator[](size_t i) const { return p_[i]; }
    const char *begin() const { return p_; }
    const char *end() const { return p_ + n_; }
    string_view substr(size_t pos, size_t n = (size_t)-1) const
    {
        if (pos > n_)
            pos = n_;
        if (n > n_ - pos)
            n = n_ - pos;
        return string_view(p_ + pos, n);
    }
    size_t find(char c, size_t from = 0) const
    {
        for (size_t i = from; i < n_; ++i)
            if (p_[i] == c)
                return i;
        return (size_t)-1;
    }
    bool operator==(const string_view &o) const
    {
        if (n_ != o.n_)
            return false;
        for (size_t i = 0; i < n_; ++i)
            if (p_[i] != o.p_[i])
                return false;
        return true;
    }
    bool operator!=(const string_view &o) const { return !(*this == o); }
    operator string() const { return string(p_, n_); }

  private:
    const char *p_;
    size_t n_;
};

