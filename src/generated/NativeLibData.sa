        {"cstdlib", R"QNATIVELIB(// <cstdlib> for Quantum's native backend. malloc / free are built in.
#pragma once
#include <string>
#include <__format>
#include <stdexcept>
#include <windows.h>

inline long long strtoll(const char *s, char **end, int base)
{
    const char *p = s;
    while (*p == ' ' || (*p >= 9 && *p <= 13))
        ++p;
    bool neg = false;
    if (*p == '+' || *p == '-')
        neg = *p++ == '-';
    if ((base == 0 || base == 16) && p[0] == '0' && (p[1] == 'x' || p[1] == 'X'))
    {
        p += 2;
        base = 16;
    }
    else if (base == 0 && p[0] == '0')
        base = 8;
    else if (base == 0)
        base = 10;
    unsigned long long v = 0;
    const char *start = p;
    while (true)
    {
        int d = *p >= '0' && *p <= '9' ? *p - '0' : *p >= 'a' && *p <= 'z' ? *p - 'a' + 10 : *p >= 'A' && *p <= 'Z' ? *p - 'A' + 10 : 99;
        if (d >= base)
            break;
        v = v * (unsigned)base + (unsigned)d;
        ++p;
    }
    if (end)
        *end = (char *)(p == start ? s : p);
    return neg ? -(long long)v : (long long)v;
}
inline unsigned long long strtoull(const char *s, char **end, int base) { return (unsigned long long)strtoll(s, end, base); }
inline long strtol(const char *s, char **end, int base) { return (long)strtoll(s, end, base); }
inline unsigned long strtoul(const char *s, char **end, int base) { return (unsigned long)strtoll(s, end, base); }
inline int atoi(const char *s) { return (int)strtoll(s, nullptr, 10); }
inline long atol(const char *s) { return (long)strtoll(s, nullptr, 10); }
inline long long atoll(const char *s) { return strtoll(s, nullptr, 10); }
inline double strtod(const char *s, char **end)
{
    size_t used = 0;
    double v = std::__parseDouble(std::string(s), used);
    if (end)
        *end = (char *)(s + used);
    return v;
}
inline double atof(const char *s) { return strtod(s, nullptr); }
