        {"thread", R"QNATIVELIB(// <thread> for Quantum's native backend: std::thread over CreateThread. A new
// thread starts in the compiler's entry thunk (__native_thread_entry()),
// which keeps the registers Windows expects kept and calls std::__thread_main.
#pragma once
#include <windows.h>
#include <functional>
#include <chrono>

namespace std
{

// a new thread's body: the std::function it was made with
inline unsigned long long __thread_main(void *arg)
{
    function<void()> *f = (function<void()> *)arg;
    (*f)();
    delete f;
    return 0;
}

class thread
{
  public:
    thread() : h_(nullptr) {}
    template <typename F>
    explicit thread(F f) : h_(nullptr)
    {
        function<void()> *body = new function<void()>(f);
        h_ = CreateThread(nullptr, 0, __native_thread_entry(), body, 0, nullptr);
    }
    thread(thread &&o) : h_(o.h_) { o.h_ = nullptr; }
    void join()
    {
        if (h_)
        {
            WaitForSingleObject(h_, 0xFFFFFFFF);
            CloseHandle(h_);
            h_ = nullptr;
        }
    }
    void detach()
    {
        if (h_)
            CloseHandle(h_);
        h_ = nullptr;
    }
    bool joinable() const { return h_ != nullptr; }
    static unsigned hardware_concurrency()
    {
        SYSTEM_INFO info;
        GetSystemInfo(&info);
        return info.dwNumberOfProcessors;
    }

  private:
    HANDLE h_;
};

namespace this_thread
{
template <typename R, long long N, long long D>
void sleep_for(const chrono::duration<R, N, D> &d)
{
    Sleep((DWORD)(d.__ns() / 1000000));
}
inline void yield() { Sleep(0); }
} // namespace this_thread

} // namespace std
