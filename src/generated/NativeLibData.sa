inline void abort() { ExitProcess(3); }

namespace std
{
inline long long abs(long long v) { return v < 0 ? -v : v; }
inline double abs(double x) { return x < 0 ? -x : x; }
using ::abort;
using ::abs;
using ::atof;
using ::atoi;
using ::atol;
using ::atoll;
using ::exit;
using ::llabs;
using ::strtod;
using ::strtol;
using ::strtoll;
using ::strtoul;
using ::strtoull;
using ::_Exit;
using ::getenv;
using ::rand;
using ::srand;
using ::system;

// the string conversions: invalid_argument when nothing converts
inline long long __sto(const string &s, size_t *idx, int base, const char *what)
{
    char *end = nullptr;
    long long v = strtoll(s.c_str(), &end, base);
    if (end == s.c_str())
        throw invalid_argument(what);
    if (idx)
        *idx = (size_t)(end - s.c_str());
    return v;
}
inline int stoi(const string &s, size_t *idx = nullptr, int base = 10) { return (int)__sto(s, idx, base, "stoi"); }
inline long stol(const string &s, size_t *idx = nullptr, int base = 10) { return (long)__sto(s, idx, base, "stol"); }
inline long long stoll(const string &s, size_t *idx = nullptr, int base = 10) { return __sto(s, idx, base, "stoll"); }
inline unsigned long stoul(const string &s, size_t *idx = nullptr, int base = 10)
{
    return (unsigned long)__sto(s, idx, base, "stoul");
}
inline unsigned long long stoull(const string &s, size_t *idx = nullptr, int base = 10)
{
    return (unsigned long long)__sto(s, idx, base, "stoull");
}
inline double stod(const string &s, size_t *idx = nullptr)
{
    char *end = nullptr;
    double v = strtod(s.c_str(), &end);
    if (end == s.c_str())
        throw invalid_argument("stod");
    if (idx)
        *idx = (size_t)(end - s.c_str());
    return v;
}
inline float stof(const string &s, size_t *idx = nullptr) { return (float)stod(s, idx); }
inline string to_string(double v) { return __fmtDouble(v, 'f', 6, false, false, false); }
} // namespace std
