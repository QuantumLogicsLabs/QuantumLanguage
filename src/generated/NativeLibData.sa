        {"unordered_map", R"QNATIVELIB(// <unordered_map> for Quantum's native backend: a hash table with chained
// buckets. Its nodes are also linked in insertion order, which is the order
// iteration visits them.
#pragma once
#include <string>
#include <utility>
#include <initializer_list>
#include <__hash>

namespace std
{

template <typename K, typename V>
struct __hnode
{
    pair<K, V> kv;
    __hnode *next;  // in insertion order
    __hnode *prev;
    __hnode *chain; // in its bucket
    size_t hash;
};

template <typename K, typename V>
class __hiter
{
  public:
    __hiter() : n_(nullptr) {}
    explicit __hiter(__hnode<K, V> *n) : n_(n) {}
    pair<K, V> &operator*() const { return n_->kv; }
    pair<K, V> *operator->() const { return &n_->kv; }
    __hiter &operator++()
    {
        n_ = n_->next;
        return *this;
    }
    bool operator==(const __hiter &o) const { return n_ == o.n_; }
    bool operator!=(const __hiter &o) const { return n_ != o.n_; }
    __hnode<K, V> *n_;
};

template <typename K, typename V>
class unordered_map
{
  public:
    typedef __hiter<K, V> iterator;
    typedef __hiter<K, V> const_iterator;
    typedef pair<K, V> value_type;

    unordered_map() : buckets_(nullptr), nbuckets_(0), size_(0), head_(nullptr), tail_(nullptr) {}
    unordered_map(initializer_list<pair<K, V>> items)
        : buckets_(nullptr), nbuckets_(0), size_(0), head_(nullptr), tail_(nullptr)
    {
        for (const pair<K, V> &kv : items)
            (*this)[kv.first] = kv.second;
    }
    unordered_map(const unordered_map &o)
        : buckets_(nullptr), nbuckets_(0), size_(0), head_(nullptr), tail_(nullptr)
    {
        for (__hnode<K, V> *n = o.head_; n; n = n->next)
            (*this)[n->kv.first] = n->kv.second;
    }
    unordered_map(unordered_map &&o)
        : buckets_(o.buckets_), nbuckets_(o.nbuckets_), size_(o.size_), head_(o.head_), tail_(o.tail_)
    {
        o.buckets_ = nullptr;
        o.nbuckets_ = 0;
        o.size_ = 0;
        o.head_ = nullptr;
        o.tail_ = nullptr;
    }
    ~unordered_map()
    {
        clear();
        delete[] buckets_;
    }
    unordered_map &operator=(const unordered_map &o)
    {
        if (this != &o)
        {
            clear();
            for (__hnode<K, V> *n = o.head_; n; n = n->next)
                (*this)[n->kv.first] = n->kv.second;
        }
        return *this;
    }
    unordered_map &operator=(unordered_map &&o)
    {
        if (this != &o)
        {
            clear();
            delete[] buckets_;
            buckets_ = o.buckets_;
            nbuckets_ = o.nbuckets_;
            size_ = o.size_;
            head_ = o.head_;
            tail_ = o.tail_;
            o.buckets_ = nullptr;
            o.nbuckets_ = 0;
            o.size_ = 0;
            o.head_ = nullptr;
            o.tail_ = nullptr;
        }
        return *this;
    }

    size_t size() const { return size_; }
    bool empty() const { return size_ == 0; }
    iterator begin() const { return iterator(head_); }
    iterator end() const { return iterator(nullptr); }
    void reserve(size_t) {}
    void rehash(size_t) {}

    iterator find(const K &key) const { return iterator(lookup(key)); }
    size_t count(const K &key) const { return lookup(key) ? 1 : 0; }
    bool contains(const K &key) const { return lookup(key) != nullptr; }
    V &operator[](const K &key)
    {
        __hnode<K, V> *n = lookup(key);
        if (!n)
            n = add(key);
        return n->kv.second;
    }
    V &at(const K &key) { return lookup(key)->kv.second; }
    const V &at(const K &key) const { return lookup(key)->kv.second; }
    pair<iterator, bool> insert(const pair<K, V> &kv)
    {
        __hnode<K, V> *n = lookup(kv.first);
        if (n)
            return pair<iterator, bool>(iterator(n), false);
        n = add(kv.first);
        n->kv.second = kv.second;
        return pair<iterator, bool>(iterator(n), true);
    }
    pair<iterator, bool> insert(pair<K, V> &&kv)
    {
        __hnode<K, V> *n = lookup(kv.first);
        if (n)
            return pair<iterator, bool>(iterator(n), false);
        n = add(kv.first);
        n->kv.second = std::move(kv.second);
        return pair<iterator, bool>(iterator(n), true);
    }
    template <typename A, typename B>
    pair<iterator, bool> emplace(A &&key, B &&value)
    {
        K k(std::forward<A>(key));
        __hnode<K, V> *n = lookup(k);
        if (n)
            return pair<iterator, bool>(iterator(n), false);
        n = add(k);
        n->kv.second = V(std::forward<B>(value));
        return pair<iterator, bool>(iterator(n), true);
    }
    template <typename A>
    pair<iterator, bool> try_emplace(const K &key, A &&value)
    {
        __hnode<K, V> *n = lookup(key);
        if (n)
            return pair<iterator, bool>(iterator(n), false);
        n = add(key);
        n->kv.second = V(std::forward<A>(value));
        return pair<iterator, bool>(iterator(n), true);
    }
    pair<iterator, bool> insert_or_assign(const K &key, const V &value)
    {
        __hnode<K, V> *n = lookup(key);
        bool added = !n;
        if (!n)
            n = add(key);
        n->kv.second = value;
        return pair<iterator, bool>(iterator(n), added);
    }
    void swap(unordered_map &o)
    {
        std::swap(buckets_, o.buckets_);
        std::swap(nbuckets_, o.nbuckets_);
        std::swap(size_, o.size_);
        std::swap(head_, o.head_);
        std::swap(tail_, o.tail_);
    }
    template <typename __InputIt>
    void insert(__InputIt first, __InputIt last)
    {
        for (; first != last; ++first)
            insert(*first);
    }
    size_t erase(const K &key)
    {
        __hnode<K, V> *n = lookup(key);
        if (!n)
            return 0;
        unlink(n);
        return 1;
    }
    iterator erase(iterator it)
    {
        __hnode<K, V> *next = it.n_->next;
        unlink(it.n_);
        return iterator(next);
    }
    void clear()
    {
        __hnode<K, V> *n = head_;
        while (n)
        {
            __hnode<K, V> *next = n->next;
            delete n;
            n = next;
        }
        head_ = nullptr;
        tail_ = nullptr;
        size_ = 0;
        for (size_t i = 0; i < nbuckets_; ++i)
            buckets_[i] = nullptr;
    }

  private:
    __hnode<K, V> **buckets_;
    size_t nbuckets_;
    size_t size_;
    __hnode<K, V> *head_;
    __hnode<K, V> *tail_;

    __hnode<K, V> *lookup(const K &key) const
    {
        if (!nbuckets_)
            return nullptr;
        size_t h = __hash(key);
        for (__hnode<K, V> *n = buckets_[h % nbuckets_]; n; n = n->chain)
            if (n->hash == h && n->kv.first == key)
                return n;
        return nullptr;
    }
    __hnode<K, V> *add(const K &key)
    {
        if (size_ + 1 > nbuckets_)
            grow(nbuckets_ ? nbuckets_ * 2 : 16);
        __hnode<K, V> *n = new __hnode<K, V>();
        n->kv.first = key;
        n->hash = __hash(key);
        n->next = nullptr;
        n->prev = tail_;
        if (tail_)
            tail_->next = n;
        else
            head_ = n;
        tail_ = n;
        size_t b = n->hash % nbuckets_;
        n->chain = buckets_[b];
        buckets_[b] = n;
        ++size_;
        return n;
    }
    void grow(size_t count)
    {
        delete[] buckets_;
        buckets_ = new __hnode<K, V> *[count];
        nbuckets_ = count;
        for (size_t i = 0; i < count; ++i)
            buckets_[i] = nullptr;
        for (__hnode<K, V> *n = head_; n; n = n->next)
        {
            size_t b = n->hash % nbuckets_;
            n->chain = buckets_[b];
            buckets_[b] = n;
        }
    }
    void unlink(__hnode<K, V> *n)
    {
        size_t b = n->hash % nbuckets_;
        __hnode<K, V> **p = &buckets_[b];
        while (*p != n)
            p = &(*p)->chain;
        *p = n->chain;
        if (n->prev)
            n->prev->next = n->next;
        else
            head_ = n->next;
        if (n->next)
            n->next->prev = n->prev;
        else
            tail_ = n->prev;
        --size_;
        delete n;
    }
};

} // namespace std
)QNATIVELIB"},
        {"unordered_set", R"QNATIVELIB(// <unordered_set> for Quantum's native backend: the keys of an
// unordered_map (iterated in insertion order).
#pragma once
#include <unordered_map>

namespace std
{

template <typename K>
class __hsiter
{
  public:
    __hsiter() : n_(nullptr) {}
    explicit __hsiter(__hnode<K, char> *n) : n_(n) {}
    const K &operator*() const { return n_->kv.first; }
    const K *operator->() const { return &n_->kv.first; }
    __hsiter &operator++()
    {
        n_ = n_->next;
        return *this;
    }
    __hsiter operator++(int)
    {
        __hsiter old = *this;
        n_ = n_->next;
        return old;
    }
    bool operator==(const __hsiter &o) const { return n_ == o.n_; }
    bool operator!=(const __hsiter &o) const { return n_ != o.n_; }
    __hnode<K, char> *n_;
};

template <typename K>
class unordered_set
{
  public:
    typedef __hsiter<K> iterator;
    typedef __hsiter<K> const_iterator;
    typedef K value_type;

    unordered_set() {}
    unordered_set(initializer_list<K> items)
    {
        for (const K &k : items)
            m_[k] = 0;
    }
    template <typename __InputIt>
    unordered_set(__InputIt first, __InputIt last)
    {
        for (; first != last; ++first)
            m_[*first] = 0;
    }

    size_t size() const { return m_.size(); }
    bool empty() const { return m_.empty(); }
    iterator begin() const { return iterator(m_.begin().n_); }
    iterator end() const { return iterator(nullptr); }
    void reserve(size_t) {}
    iterator find(const K &k) const { return iterator(m_.find(k).n_); }
    size_t count(const K &k) const { return m_.count(k); }
    bool contains(const K &k) const { return m_.count(k) != 0; }
    pair<iterator, bool> insert(const K &k)
    {
        pair<__hiter<K, char>, bool> r = m_.insert(pair<K, char>(k, 0));
        return pair<iterator, bool>(iterator(r.first.n_), r.second);
    }
    template <typename __InputIt>
    void insert(__InputIt first, __InputIt last)
    {
        for (; first != last; ++first)
            m_[*first] = 0;
    }
    pair<iterator, bool> emplace(const K &k) { return insert(k); }
    size_t erase(const K &k) { return m_.erase(k); }
    iterator erase(iterator it)
    {
        __hnode<K, char> *next = it.n_->next;
        m_.erase(__hiter<K, char>(it.n_));
        return iterator(next);
    }
    void clear() { m_.clear(); }

  private:
    unordered_map<K, char> m_;
};

} // namespace std
)QNATIVELIB"},
        {"utility", R"QNATIVELIB(// <utility> for Quantum's native backend. std::move and std::forward are
// built into the compiler; std::pair and std::swap are here.
#pragma once

namespace std
{

template <typename A, typename B>
struct pair
{
    A first;
    B second;
    pair() : first(), second() {}
    pair(const A &a, const B &b) : first(a), second(b) {}
    template <typename U, typename V>
    pair(U &&a, V &&b) : first(std::forward<U>(a)), second(std::forward<V>(b))
    {
    }
    template <typename U, typename V>
    pair(const pair<U, V> &o) : first(o.first), second(o.second)
    {
    }
    template <typename U, typename V>
    pair(pair<U, V> &&o) : first(std::move(o.first)), second(std::move(o.second))
    {
    }
    bool operator==(const pair &o) const { return first == o.first && second == o.second; }
    bool operator!=(const pair &o) const { return !(*this == o); }
    bool operator<(const pair &o) const { return first < o.first || (!(o.first < first) && second < o.second); }
    bool operator>(const pair &o) const { return o < *this; }
    bool operator<=(const pair &o) const { return !(o < *this); }
    bool operator>=(const pair &o) const { return !(*this < o); }
};

template <typename A, typename B>
pair<A, B> make_pair(const A &a, const B &b)
{
    return pair<A, B>(a, b);
}

// an iterator whose elements are moved from (make_move_iterator)
template <typename T>
class move_iterator
{
  public:
    explicit move_iterator(T *p) : p_(p) {}
    T &&operator*() const { return std::move(*p_); }
    move_iterator &operator++()
    {
        ++p_;
        return *this;
    }
    bool operator==(const move_iterator &o) const { return p_ == o.p_; }
    bool operator!=(const move_iterator &o) const { return p_ != o.p_; }
    long long operator-(const move_iterator &o) const { return p_ - o.p_; }
    T *base() const { return p_; }
    T *p_;
};

template <typename T>
move_iterator<T> make_move_iterator(T *p)
{
    return move_iterator<T>(p);
}

// function objects
template <typename T = void>
struct less
{
    bool operator()(const T &a, const T &b) const { return a < b; }
};
template <typename T = void>
struct greater
{
    bool operator()(const T &a, const T &b) const { return b < a; }
};
template <typename T = void>
struct less_equal
{
    bool operator()(const T &a, const T &b) const { return !(b < a); }
};
template <typename T = void>
struct greater_equal
{
    bool operator()(const T &a, const T &b) const { return !(a < b); }
};
template <typename T = void>
struct equal_to
{
    bool operator()(const T &a, const T &b) const { return a == b; }
};
template <typename T = void>
struct not_equal_to
{
    bool operator()(const T &a, const T &b) const { return !(a == b); }
};
template <typename T = void>
struct plus
{
    T operator()(const T &a, const T &b) const { return a + b; }
};
template <typename T = void>
struct minus
{
    T operator()(const T &a, const T &b) const { return a - b; }
};
template <typename T = void>
struct multiplies
{
    T operator()(const T &a, const T &b) const { return a * b; }
};

template <typename T>
void swap(T &a, T &b)
{
    T t = std::move(a);
    a = std::move(b);
    b = std::move(t);
}

} // namespace std
)QNATIVELIB"},
