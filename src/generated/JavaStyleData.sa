// ── Optional ───────────────────────────────────────────────────────────────

class __JOptional {
    constructor(v) { this.v = v }
    isPresent() { return this.v != nil }
    isEmpty() { return this.v == nil }
    get() {
        if (this.v == nil) { throw new NoSuchElementException("No value present") }
        return this.v
    }
    getAsInt() { return this.get() }
    getAsDouble() { return this.get() }
    getAsLong() { return this.get() }
    orElse(d) { return this.v == nil ? d : this.v }
    orElseGet(f) { return this.v == nil ? f() : this.v }
    orElseThrow(f) {
        if (this.v == nil) {
            if (f == nil) { throw new NoSuchElementException("No value present") }
            throw f()
        }
        return this.v
    }
    ifPresent(f) { if (this.v != nil) { f(this.v) } }
    ifPresentOrElse(f, g) { if (this.v != nil) { f(this.v) } else { g() } }
    map(f) { return this.v == nil ? this : new __JOptional(f(this.v)) }
    flatMap(f) { return this.v == nil ? this : f(this.v) }
    filter(p) { return (this.v != nil && p(this.v)) ? this : new __JOptional(nil) }
    equals(o) { return __jinChain(o, "__JOptional") && __jequals(this.v, o.v) }
    toString() { return this.v == nil ? "Optional.empty" : "Optional[" + __jstr(this.v) + "]" }
}

let Optional = {
    "of": fn(v) {
        if (v == nil) { throw new NullPointerException(nil) }
        return new __JOptional(v)
    },
    "ofNullable": fn(v) { return new __JOptional(v) },
    "empty": fn() { return new __JOptional(nil) }
}
let OptionalInt = Optional
let OptionalDouble = Optional

// ── Comparator / Function ──────────────────────────────────────────────────

let Comparator = {
    "naturalOrder": fn() { return __jcompare },
    "reverseOrder": fn() { return fn(a, b) { return __jcompare(b, a) } },
    "comparing": fn(key, cmp) {
        return fn(a, b) { return cmp == nil ? __jcompare(key(a), key(b)) : cmp(key(a), key(b)) }
    },
    "comparingInt": fn(key) { return fn(a, b) { return __jcompare(key(a), key(b)) } },
    "comparingDouble": fn(key) { return fn(a, b) { return __jcompare(key(a), key(b)) } },
    "comparingLong": fn(key) { return fn(a, b) { return __jcompare(key(a), key(b)) } },
    "nullsFirst": fn(cmp) {
        return fn(a, b) { return a == nil ? (b == nil ? 0 : -1) : (b == nil ? 1 : cmp(a, b)) }
    },
    "nullsLast": fn(cmp) {
        return fn(a, b) { return a == nil ? (b == nil ? 0 : 1) : (b == nil ? -1 : cmp(a, b)) }
    }
}

