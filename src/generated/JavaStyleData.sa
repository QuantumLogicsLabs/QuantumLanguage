        let nv = old == nil ? v : f(old, v)
        if (nv == nil) { this.remove(k) } else { this.put(k, nv) }
        return nv
    }
    compute(k, f) {
        let nv = f(k, this.get(k))
        if (nv == nil) { this.remove(k) } else { this.put(k, nv) }
        return nv
    }
    computeIfAbsent(k, f) {
        let old = this.get(k)
        if (old != nil) { return old }
        let nv = f(k)
        if (nv != nil) { this.put(k, nv) }
        return nv
    }
    computeIfPresent(k, f) {
        let old = this.get(k)
        if (old == nil) { return nil }
        return this.compute(k, fn(key, v) { return f(key, v) })
    }
    keySet() { return new __JSet(false, nil, this.ks) }
    values() { return this.vs.toArray() }
    entrySet() {
        let out = []
        let i = 0
        while (i < len(this.ks)) { out.push([this.ks[i], this.vs[i]]); i += 1 }
        return out
    }
    forEach(f) {
        let i = 0
        while (i < len(this.ks)) { f(this.ks[i], this.vs[i]); i += 1 }
    }
    toArray() { return this.ks.toArray() }
    firstKey() { return this.__end(0) }
    lastKey() { return this.__end(len(this.ks) - 1) }
    __end(i) {
        if (len(this.ks) == 0) { throw new NoSuchElementException(nil) }
        return this.ks[i]
    }
    firstEntry() { return len(this.ks) == 0 ? nil : [this.ks[0], this.vs[0]] }
    lastEntry() { return len(this.ks) == 0 ? nil : [this.ks[len(this.ks) - 1], this.vs[len(this.vs) - 1]] }
    pollFirstEntry() {
        let e = this.firstEntry()
        if (e != nil) { this.remove(e[0]) }
        return e
    }
    // the greatest key <= k (floor), < k (lower), the least >= k (ceiling), > k (higher)
    __search(k, below, inclusive) {
        let best = nil
        for (let x of this.ks) {
            let c = this.__order(x, k)
            if (below && (c < 0 || (inclusive && c == 0))) { best = x }
            if (!below && (c > 0 || (inclusive && c == 0)) && best == nil) { best = x }
        }
        return best
    }
    floorKey(k) { return this.__search(k, true, true) }
    lowerKey(k) { return this.__search(k, true, false) }
    ceilingKey(k) { return this.__search(k, false, true) }
    higherKey(k) { return this.__search(k, false, false) }
    headMap(k) {
        let m = new __JMap(this.sorted, this.cmp, nil)
        let i = 0
        while (i < len(this.ks)) { if (this.__order(this.ks[i], k) < 0) { m.put(this.ks[i], this.vs[i]) } i += 1 }
        return m
    }
    tailMap(k) {
        let m = new __JMap(this.sorted, this.cmp, nil)
        let i = 0
        while (i < len(this.ks)) { if (this.__order(this.ks[i], k) >= 0) { m.put(this.ks[i], this.vs[i]) } i += 1 }
        return m
    }
    equals(o) {
        if (!__jinChain(o, "__JMap") || o.size() != this.size()) { return false }
        let i = 0
        while (i < len(this.ks)) {
            if (!o.containsKey(this.ks[i]) || !__jequals(o.get(this.ks[i]), this.vs[i])) { return false }
            i += 1
