        let i = 0
        while (i < len(this.ks)) {
            if (i > 0) { out += ", " }
            out += __jstr(this.ks[i]) + "=" + __jstr(this.vs[i])
            i += 1
        }
        return out + "}"
    }
}

class __JSet {
    constructor(sorted, cmp, src) {
        this.m = new __JMap(sorted, cmp, nil)
        if (src != nil && type(src) != "number") { this.addAll(src) }
    }
