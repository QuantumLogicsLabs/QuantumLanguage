        this.cmp = cmp
        this.ks = []
        this.vs = []
        this.index = {}
        if (src != nil && type(src) != "number") { this.putAll(src) }
    }
    __find(k) {
        let p = this.index[__jkey(k)]
        return p == nil ? -1 : p
    }
    __reindex() {
        this.index = {}
        let i = 0
        while (i < len(this.ks)) { this.index[__jkey(this.ks[i])] = i; i += 1 }
    }
    __order(a, b) { return this.cmp == nil ? __jcompare(a, b) : this.cmp(a, b) }
    size() { return len(this.ks) }
    isEmpty() { return len(this.ks) == 0 }
    containsKey(k) { return this.__find(k) >= 0 }
    containsValue(v) {
        for (let x of this.vs) { if (__jequals(x, v)) { return true } }
        return false
    }
    get(k) {
        let p = this.__find(k)
        return p < 0 ? nil : this.vs[p]
    }
    getOrDefault(k, d) {
        let p = this.__find(k)
        return p < 0 ? d : this.vs[p]
    }
    put(k, v) {
        let p = this.__find(k)
        if (p >= 0) {
            let old = this.vs[p]
            this.vs[p] = v
            return old
        }
        if (!this.sorted) {
            this.index[__jkey(k)] = len(this.ks)
            this.ks.push(k)
            this.vs.push(v)
            return nil
        }
        let lo = 0
        let hi = len(this.ks)
        while (lo < hi) {
            let mid = floor((lo + hi) / 2)
            if (this.__order(this.ks[mid], k) < 0) { lo = mid + 1 } else { hi = mid }
        }
        this.ks.add(lo, k)
        this.vs.add(lo, v)
        this.__reindex()
        return nil
    }
    putAll(m) {
        if (__jinChain(m, "__JMap")) {
            let i = 0
            while (i < len(m.ks)) { this.put(m.ks[i], m.vs[i]); i += 1 }
        } else if (type(m) == "dict") {
            for (let k of m.keys()) { this.put(k, m[k]) }
