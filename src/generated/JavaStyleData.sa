// ── collections ────────────────────────────────────────────────────────────

fn __jlistFrom(src) {
    if (src == nil || type(src) == "number") { return [] }
    let out = []
    for (let x of __jit(src)) { out.push(x) }
    return out
}

fn ArrayList(src) { return __jlistFrom(src) }
fn Vector(src) { return __jlistFrom(src) }
fn Stack() { return [] }
fn LinkedList(src) { return new __JDeque(__jlistFrom(src)) }
fn ArrayDeque(src) { return new __JDeque(__jlistFrom(src)) }
fn HashMap(src) { return new __JMap(false, nil, src) }
fn LinkedHashMap(src) { return new __JMap(false, nil, src) }
fn IdentityHashMap(src) { return new __JMap(false, nil, src) }
fn EnumMap(src) { return new __JMap(true, fn(a, b) { return a.ordinal() - b.ordinal() }, nil) }
fn TreeMap(src) {
    if (__jcallable(src)) { return new __JMap(true, src, nil) }
    return new __JMap(true, nil, src)
}
fn HashSet(src) { return new __JSet(false, nil, src) }
fn LinkedHashSet(src) { return new __JSet(false, nil, src) }
fn TreeSet(src) {
    if (__jcallable(src)) { return new __JSet(true, src, nil) }
    return new __JSet(true, nil, src)
}
fn PriorityQueue(a, b) {
    // (), (capacity), (comparator), (capacity, comparator), (collection)
    let cmp = nil
    let src = nil
    if (__jcallable(a)) { cmp = a }
    if (__jcallable(b)) { cmp = b }
    if (a != nil && !__jcallable(a) && type(a) != "number") { src = a }
    let q = new __JPriorityQueue(cmp)
    if (src != nil) { q.addAll(src) }
    return q
}

// a deque / linked list, head first
class __JDeque {
    constructor(items) { this.items = items }
    size() { return len(this.items) }
    isEmpty() { return len(this.items) == 0 }
    push(x) { this.items.addFirst(x) }
    addFirst(x) { this.items.addFirst(x) }
    offerFirst(x) { this.items.addFirst(x); return true }
    add(a, b) {
        if (b == nil) { this.items.push(a); return true }
        this.items.add(a, b)
    }
    addLast(x) { this.items.push(x) }
    offer(x) { this.items.push(x); return true }
    offerLast(x) { this.items.push(x); return true }
    addAll(c) { for (let x of __jit(c)) { this.items.push(x) } return true }
    pop() { return this.removeFirst() }
    remove(x) {
        if (x == nil) { return this.removeFirst() }
        return this.items.remove(x)
    }
    removeFirst() {
        if (len(this.items) == 0) { throw new NoSuchElementException(nil) }
        return this.items.removeFirst()
    }
    removeLast() {
        if (len(this.items) == 0) { throw new NoSuchElementException(nil) }
        return this.items.removeLast()
    }
    poll() { return this.items.pollFirst() }
    pollFirst() { return this.items.pollFirst() }
    pollLast() { return this.items.pollLast() }
    peek() { return this.items.peekFirst() }
    peekFirst() { return this.items.peekFirst() }
    peekLast() { return this.items.peekLast() }
    element() { return this.getFirst() }
    getFirst() {
        if (len(this.items) == 0) { throw new NoSuchElementException(nil) }
        return this.items[0]
    }
    getLast() {
        if (len(this.items) == 0) { throw new NoSuchElementException(nil) }
        return this.items[len(this.items) - 1]
    }
    get(i) { return this.items.get(i) }
    set(i, v) { return this.items.set(i, v) }
    indexOf(x) { return this.items.indexOf(x) }
    contains(x) { return this.items.contains(x) }
    clear() { this.items = [] }
    toArray() { return this.items.toArray() }
    stream() { return this.items.toArray() }
    forEach(f) { for (let x of this.items) { f(x) } }
    descendingIterator() { return new __JIterator(this.items.toArray().reverse()) }
    iterator() { return new __JIterator(this.items) }
    toString() { return __jstr(this.items) }
}

class __JIterator {
    constructor(items) { this.items = items; this.i = 0 }
    hasNext() { return this.i < len(this.items) }
    next() {
        if (this.i >= len(this.items)) { throw new NoSuchElementException(nil) }
        let v = this.items[this.i]
        this.i += 1
        return v
    }
}

// a map: insertion order, or sorted (TreeMap); keys keep their type
class __JMap {
    constructor(sorted, cmp, src) {
