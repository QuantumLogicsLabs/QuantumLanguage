// quantum: cpp
#pragma once
// Rust front-end: what the rest of the compiler sees of it.
#include <string>
#include <vector>

namespace rust
{

// A panic or an error found while the program ran, for the caller to report
struct RunFailure
{
    bool failed = false;
    std::string kind, message;
    int line = 0;
};

// Runs a Rust program to its end; the result is the exit status (101 after
// a panic, as from a program rustc built)
int runProgram(const std::string &source, const std::string &path, RunFailure &failure);

// What rustc prints for a program it cannot compile (qrun reports it as a
// compile error: a .rs file is Rust and nothing else), or "" when the source
// parses and its names resolve. Types are checked as the program runs.
std::string syntaxReport(const std::string &source, const std::string &path);

// The program's command line (std::env::args), and whether the test runner
// is running it (input is then not waited for)
void setArgs(const std::vector<std::string> &args);
void setTestMode(bool on);

} // namespace rust
