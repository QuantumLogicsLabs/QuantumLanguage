bool waitSocket(uint64_t s, bool write, int64_t timeoutNs);

// ─── std::net (RustNet.sa) ─────────────────────────────────────────────────

bool netCall(const std::string &name, std::vector<V> &args, const Node *n, V &out);
bool netMethod(NativeObj *o, V self, const Node *n, std::vector<V> &args, V &out);
bool netMethodNow(NativeObj *o, V self, const Node *n, std::vector<V> &args, V &out); // tokio's, when awaited
V deferredCall(V self, const Node *n, std::vector<V> &args); // a future that runs the method when awaited
bool netFormat(NativeObj *o, bool debug, std::string &out);
bool netNext(IterObj *it, V &out, const Node *at);
void netDropped(NativeObj *o);
void netPoll(const std::vector<uint64_t> &socks, const std::vector<int> &writes, int64_t timeoutNs,
             std::vector<int> &ready);

// ─── serde and serde_json (RustSerde.sa) ───────────────────────────────────

std::string jsonText(V v, bool pretty, const Node *at); // a value as JSON text
V toJsonValue(V v, const Node *at);                     // serde_json::to_value(v).unwrap()
V jsonMacro(Node *j, const Node *at);                   // json!(...)
bool serdeKnown(const std::string &name);
bool serdeCall(const std::string &name, std::vector<V> &args, const Node *n, Ty *hint, const std::vector<Ty *> *targs,
               V &out);
bool serdeFormat(NativeObj *o, bool debug, std::string &out);
bool jsonDebug(V v, bool pretty, const Node *at, std::string &out);
bool jsonEq(V a, V b, bool &result);                    // a Value and a str / number / bool
bool jsonIndex(V bv, Place base, V idx, bool write, Place &out, const Node *n);
bool jsonMethod(V sv, const Node *n, std::vector<V> &args, Ty *hint, V &out);
// env!("CARGO_PKG_VERSION"): the environment, and what Cargo would set from Cargo.toml (RustFs.sa)
bool compileEnv(const std::string &name, std::string &value);

// ─── names (RustResolve.sa) ────────────────────────────────────────────────

void initBuiltins();
void resolveProgram(ModDef *root, std::vector<ModDef *> &all);
Sym *lookupName(ModDef *m, const std::string &name);   // through enclosing blocks
std::string builtinKey(const std::string &full);       // std::mem::swap -> mem::swap
TypeDef *builtinType(const std::string &name);         // the TypeDef user impls for it hang on

} // namespace rust
