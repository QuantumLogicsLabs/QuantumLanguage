// quantum: cpp
#include "Serializer.h.sa"
#include <cmath>
#include <limits>
#include <stdexcept>

// Chunk::javaStyle and Chunk::rubyStyle, stored in the top bits of the
// upvalue count
static const uint32_t kJavaStyleBit = 0x80000000u;
static const uint32_t kRubyStyleBit = 0x40000000u;

enum class ValueType : uint8_t {
    VAL_NIL = 0,
    VAL_BOOL = 1,
    VAL_NUMBER = 2,
    VAL_STRING = 3,
    VAL_ARRAY = 4,
    VAL_CLOSURE = 5,
    VAL_LONG = 6
};

void Serializer::writeU8(std::vector<uint8_t>& out, uint32_t v) {
    out.push_back(static_cast<uint8_t>(v & 0xFF));
}

void Serializer::writeU32(std::vector<uint8_t>& out, uint32_t v) {
    for (int i = 0; i < 4; ++i)
        out.push_back(static_cast<uint8_t>((v >> (8 * i)) & 0xFF));
}

void Serializer::writeU64(std::vector<uint8_t>& out, uint64_t v) {
    for (int i = 0; i < 8; ++i)
        out.push_back(static_cast<uint8_t>((v >> (8 * i)) & 0xFF));
}

// IEEE 754 binary64 bits computed arithmetically: sign, 11-bit biased
// exponent, 52-bit fraction (subnormals, infinities and NaN included).
void Serializer::writeF64(std::vector<uint8_t>& out, double d) {
    uint64_t sign = std::signbit(d) ? 1 : 0;
    uint64_t exp = 0, frac = 0;
    if (std::isnan(d)) {
        exp = 0x7FF;
        frac = 0x8000000000000ULL;
    } else if (std::isinf(d)) {
        exp = 0x7FF;
    } else if (d != 0.0) {
        int e = 0;
        double m = std::frexp(std::fabs(d), &e); // |d| = m * 2^e, m in [0.5, 1)
        int biased = e + 1022;
        if (biased > 0) {
            exp = static_cast<uint64_t>(biased);
            frac = static_cast<uint64_t>(std::ldexp(m * 2.0 - 1.0, 52));
        } else {
            frac = static_cast<uint64_t>(std::ldexp(m, 52 + biased)); // subnormal
        }
    }
    writeU64(out, (sign << 63) | (exp << 52) | frac);
}

uint32_t Serializer::readU8(const std::vector<uint8_t>& data, size_t& offset) {
    if (offset + 1 > data.size())
        throw std::runtime_error("Unexpected end of file while deserializing");
    return data[offset++];
}

uint32_t Serializer::readU32(const std::vector<uint8_t>& data, size_t& offset) {
    if (offset + 4 > data.size())
        throw std::runtime_error("Unexpected end of file while deserializing");
    uint32_t v = 0;
    for (int i = 0; i < 4; ++i)
        v |= static_cast<uint32_t>(data[offset + i]) << (8 * i);
    offset += 4;
    return v;
}

uint64_t Serializer::readU64(const std::vector<uint8_t>& data, size_t& offset) {
    if (offset + 8 > data.size())
        throw std::runtime_error("Unexpected end of file while deserializing");
    uint64_t v = 0;
    for (int i = 0; i < 8; ++i)
        v |= static_cast<uint64_t>(data[offset + i]) << (8 * i);
    offset += 8;
    return v;
}

double Serializer::readF64(const std::vector<uint8_t>& data, size_t& offset) {
    uint64_t bits = readU64(data, offset);
    bool negative = (bits >> 63) != 0;
    int exp = static_cast<int>((bits >> 52) & 0x7FF);
    uint64_t frac = bits & 0xFFFFFFFFFFFFFULL;
    double d;
    if (exp == 0x7FF)
        d = frac ? std::numeric_limits<double>::quiet_NaN() : std::numeric_limits<double>::infinity();
    else if (exp == 0)
        d = std::ldexp(static_cast<double>(frac), -1074);
    else
        d = std::ldexp(static_cast<double>(frac | 0x10000000000000ULL), exp - 1075);
    return negative ? -d : d;
}

void Serializer::writeString(std::vector<uint8_t>& out, const std::string& s) {
    writeU32(out, static_cast<uint32_t>(s.size()));
    out.insert(out.end(), s.begin(), s.end());
}

std::string Serializer::readString(const std::vector<uint8_t>& data, size_t& offset) {
    uint32_t len = readU32(data, offset);
    if (offset + len > data.size()) {
        throw std::runtime_error("Unexpected string length while deserializing");
    }
    std::string s(data.begin() + offset, data.begin() + offset + len);
    offset += len;
    return s;
}

void Serializer::writeValue(std::vector<uint8_t>& out, const QuantumValue& val) {
    if (val.isNil()) {
        writeU8(out, static_cast<uint32_t>(ValueType::VAL_NIL));
    } else if (val.isBool()) {
        writeU8(out, static_cast<uint32_t>(ValueType::VAL_BOOL));
        writeU8(out, val.asBool() ? 1 : 0);
    } else if (val.isNumber()) {
        writeU8(out, static_cast<uint32_t>(ValueType::VAL_NUMBER));
        writeF64(out, val.asNumber());
    } else if (val.isLong()) {
        writeU8(out, static_cast<uint32_t>(ValueType::VAL_LONG));
        writeU64(out, static_cast<uint64_t>(val.asLong()));
    } else if (val.isString()) {
        writeU8(out, static_cast<uint32_t>(ValueType::VAL_STRING));
        writeString(out, val.asString());
    } else if (val.isArray()) {
        writeU8(out, static_cast<uint32_t>(ValueType::VAL_ARRAY));
        auto arr = val.asArray();
        writeU32(out, static_cast<uint32_t>(arr->size()));
        for (const auto& item : *arr) {
            writeValue(out, item);
        }
    } else if (val.isFunction()) {
        writeU8(out, static_cast<uint32_t>(ValueType::VAL_CLOSURE));
        writeChunk(out, val.asFunction()->chunk);
    } else {
        throw std::runtime_error("Cannot serialize value of type " + val.typeName());
    }
}

QuantumValue Serializer::readValue(const std::vector<uint8_t>& data, size_t& offset) {
    ValueType type = static_cast<ValueType>(readU8(data, offset));
    switch (type) {
        case ValueType::VAL_NIL:
            return QuantumValue();
        case ValueType::VAL_BOOL:
            return QuantumValue(readU8(data, offset) != 0);
        case ValueType::VAL_NUMBER:
            return QuantumValue(readF64(data, offset));
        case ValueType::VAL_LONG:
            return QuantumValue::ofLong(static_cast<int64_t>(readU64(data, offset)));
        case ValueType::VAL_STRING:
            return QuantumValue(readString(data, offset));
        case ValueType::VAL_ARRAY: {
            uint32_t size = readU32(data, offset);
            auto arr = std::make_shared<Array>(size);
            for (uint32_t i = 0; i < size; ++i) {
                (*arr)[i] = readValue(data, offset);
            }
            return QuantumValue(arr);
        }
        case ValueType::VAL_CLOSURE: {
            auto chunk = readChunk(data, offset);
            return QuantumValue(std::make_shared<Closure>(chunk));
        }
        default:
            throw std::runtime_error("Unknown value type while deserializing");
    }
}

void Serializer::writeChunk(std::vector<uint8_t>& out, std::shared_ptr<Chunk> chunk) {
    writeString(out, chunk->name);

    // code: op (u8), operand (i32), line (i32)
    writeU32(out, static_cast<uint32_t>(chunk->code.size()));
    for (const auto& instr : chunk->code) {
        writeU8(out, static_cast<uint32_t>(instr.op));
        writeU32(out, static_cast<uint32_t>(instr.operand));
        writeU32(out, static_cast<uint32_t>(instr.line));
    }

    // params
    writeU32(out, static_cast<uint32_t>(chunk->params.size()));
    for (const auto& param : chunk->params) {
        writeString(out, param);
    }

    // paramIsRef
    writeU32(out, static_cast<uint32_t>(chunk->paramIsRef.size()));
    for (bool isRef : chunk->paramIsRef) {
        writeU8(out, isRef ? 1 : 0);
    }

    // upvalueCount (i32), with Chunk::javaStyle / rubyStyle in its top bits
    // (0 in files written before they existed)
    writeU32(out, static_cast<uint32_t>(chunk->upvalueCount) | (chunk->javaStyle ? kJavaStyleBit : 0u) |
                      (chunk->rubyStyle ? kRubyStyleBit : 0u));

    // constants
    writeU32(out, static_cast<uint32_t>(chunk->constants.size()));
    for (const auto& c : chunk->constants) {
        writeValue(out, c);
    }
}

std::shared_ptr<Chunk> Serializer::readChunk(const std::vector<uint8_t>& data, size_t& offset) {
    auto chunk = std::make_shared<Chunk>();
    chunk->name = readString(data, offset);

    // code
    uint32_t codeSize = readU32(data, offset);
    chunk->code.reserve(codeSize);
    for (uint32_t i = 0; i < codeSize; ++i) {
        Instruction instr;
        instr.op = static_cast<Op>(readU8(data, offset));
        instr.operand = static_cast<int32_t>(readU32(data, offset));
        instr.line = static_cast<int>(static_cast<int32_t>(readU32(data, offset)));
        chunk->code.push_back(instr);
    }

    // params
    uint32_t paramsSize = readU32(data, offset);
    chunk->params.reserve(paramsSize);
    for (uint32_t i = 0; i < paramsSize; ++i) {
        chunk->params.push_back(readString(data, offset));
    }

    // paramIsRef
    uint32_t refSize = readU32(data, offset);
    chunk->paramIsRef.reserve(refSize);
    for (uint32_t i = 0; i < refSize; ++i) {
        chunk->paramIsRef.push_back(readU8(data, offset) != 0);
    }

    // upvalueCount, and the javaStyle / rubyStyle bits
    uint32_t upvalues = readU32(data, offset);
    chunk->javaStyle = (upvalues & kJavaStyleBit) != 0;
    chunk->rubyStyle = (upvalues & kRubyStyleBit) != 0;
    chunk->upvalueCount = static_cast<int>(upvalues & ~(kJavaStyleBit | kRubyStyleBit));

    // constants
    uint32_t constSize = readU32(data, offset);
    chunk->constants.reserve(constSize);
    for (uint32_t i = 0; i < constSize; ++i) {
        chunk->constants.push_back(readValue(data, offset));
    }

    return chunk;
}

std::vector<uint8_t> Serializer::serialize(std::shared_ptr<Chunk> chunk) {
    std::vector<uint8_t> out;
    writeChunk(out, chunk);
    return out;
}

std::shared_ptr<Chunk> Serializer::deserialize(const std::vector<uint8_t>& data) {
    size_t offset = 0;
    return readChunk(data, offset);
}
