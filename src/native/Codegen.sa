// quantum: cpp
// The native backend's code generator: the C++ AST (src/cpp/) to x86-64 code
// for Windows.
//
// Types so far: the integer types, pointers, references, arrays, and classes
// with constructors, destructors, single inheritance and virtual functions.
// Every variable lives in memory at its own size: locals in the rbp frame,
// globals, vtables and string literals in the .data section. An expression
// leaves a scalar value in rax, already wrapped to its type (an int
// sign-extended from 32 bits, an unsigned zero-extended, a bool 0 or 1), so
// 64-bit instructions give C++'s results; a class or array value leaves its
// address there. Operands of a binary operator meet on the stack.
//
// Calls use the Microsoft x64 registers and stack layout. Arguments, in
// order: a hidden pointer to the result when a function returns a class,
// `this` for a member function, then the parameters. A class passed by value
// is a pointer to a copy the caller makes; a reference is a pointer.
#include "Native.h.sa"
#include "Pe.h.sa"
#include "X64.h.sa"
#include "../cpp/Cpp.h.sa"

#include <algorithm>
#include <cmath>
#include <cstdlib>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <map>
#include <memory>
#include <set>
#include <sstream>

namespace native
{

namespace
{

enum Kind
{
    K_VOID,
    K_BOOL,
    K_I8,
    K_U8,
    K_I16,
    K_U16,
    K_I32,
    K_U32,
    K_I64,
    K_U64,
    K_F32, // float
    K_F64, // double
};

// the source file of the declaration being compiled (for messages)
std::string g_failFile;

[[noreturn]] void fail(const std::string &msg, int line) { throw cpp::Unsupported("native: " + msg, g_failFile, line); }

bool isUnsigned(Kind k) { return k == K_U8 || k == K_U16 || k == K_U32 || k == K_U64 || k == K_BOOL; }
bool isFloat(Kind k) { return k == K_F32 || k == K_F64; }

int kindSize(Kind k)
{
    switch (k)
    {
    case K_BOOL: case K_I8: case K_U8: return 1;
    case K_I16: case K_U16: return 2;
    case K_I32: case K_U32: case K_F32: return 4;
    case K_VOID: return 0;
    default: return 8;
    }
}

// The type an operand takes in arithmetic (integer promotion)
Kind promote(Kind k) { return isFloat(k) ? k : kindSize(k) < 4 ? K_I32 : k; }

// The usual arithmetic conversions between two operands
Kind common(Kind a, Kind b)
{
    a = promote(a);
    b = promote(b);
    if (a == K_F64 || b == K_F64)
        return K_F64;
    if (a == K_F32 || b == K_F32)
        return K_F32;
    if (a == K_U64 || b == K_U64)
        return K_U64;
    if (a == K_I64 || b == K_I64)
        return K_I64;
    if (a == K_U32 || b == K_U32)
        return K_U32;
    return K_I32;
}

const uint64_t kCodeBase = 0x140001000ULL; // where .text is loaded (Pe.sa: image base + 0x1000)

// ─── Types ─────────────────────────────────────────────────────────────────

enum Cat
{
    C_VOID,
    C_INT,
    C_PTR,
    C_REF,
    C_ARRAY,
    C_CLASS,
    C_FUNC, // a function type: elem is its result, fparams its parameters
};

struct ClassInfo;
struct Method;
struct NType;
using NT = std::shared_ptr<NType>;

// A template instance's arguments: type parameters and value parameters
struct Binding
{
    std::map<std::string, NT> types;
    std::map<std::string, int64_t> values;
};
using BindP = std::shared_ptr<Binding>;

struct NType
{
    Cat cat = C_VOID;
    Kind kind = K_VOID; // C_INT
    NT elem;            // C_PTR / C_REF / C_ARRAY
    int n = 0;          // C_ARRAY
    ClassInfo *cls = nullptr;
    bool isConst = false; // a const reference binds to a temporary
    bool rvalue = false;  // T&& (binds to temporaries and std::move results)
    std::vector<NT> fparams; // C_FUNC
};

struct Field
{
    std::string name;
    NT type;
    int off = 0;
    cpp::ExprP init;  // default member initializer
    bool initBraced = false;
    std::vector<cpp::ExprP> initArgs;
};

struct Method
{
    std::string name;
    ClassInfo *owner = nullptr; // null: a free function
    NT ret;
    std::vector<NT> params;
    std::vector<cpp::ExprP> defaults; // per parameter (null: none)
    cpp::DeclP decl;                  // null: generated (implicit constructor / destructor)
    int label = -1;
    bool isStatic = false, isVirtual = false, isCtor = false, isDtor = false, isPure = false;
    int vslot = -1;
    BindP bind;     // a template instance's arguments (null: not a template)
    std::string ns; // the scope its body's names are looked up from ("geo::", "geo::Point::")
    bool used = false; // called: only called functions are generated (as C++ instantiates templates)
    bool done = false; // generated
    bool fromTemplate = false; // a template's instance (a plain function wins a tie)
    std::string usedBy;        // the function that first called it (QUANTUM_NATIVE_VERBOSE)
    int frame = 0;             // its stack frame's size (QUANTUM_NATIVE_MAP)
    std::string dll;   // declared in namespace __dll_<name>: imported from <name>.dll
};

struct ClassInfo
{
    std::string name;
    std::vector<Field> fields;
    int size = 0;
    int align = 1;
    ClassInfo *base = nullptr;
    bool polymorphic = false;
    int vtableOff = -1;
    std::vector<Method *> vslots;
    std::map<std::string, std::vector<Method *>> methods;
    std::vector<Method *> ctors;
    Method *dtor = nullptr;          // user-declared or generated
    Method *implicitCtor = nullptr;  // generated when there is no user constructor
    bool needsDtor = false;
    std::map<std::string, std::string> statics; // static data member -> global name
    BindP bind;                                 // a class template instance's arguments
    std::string templateName;                   // its template (the injected class name)
    bool complete = false;                      // false: only declared so far (class X;)
    ClassInfo *outer = nullptr;                 // a lambda's closure: the class whose `this` it captured
    // copying: a user copy constructor / operator=, or ones generated member
    // by member when a member (or the base) has its own copy semantics
    bool userCopyCtor = false, userCopyAssign = false;
    bool nontrivialCopy = false;
    bool deletedCopy = false; // T(const T&) = delete / operator=(const T&) = delete
    Method *copyCtor = nullptr;   // generated
    Method *copyAssign = nullptr; // generated
    Method *moveCtor = nullptr;   // generated: members moved
    Method *moveAssign = nullptr; // generated
    // member templates by name ("" for constructors), with the scope their
    // bodies' names are looked up from
    std::map<std::string, std::vector<std::pair<cpp::DeclP, std::string>>> memberTemplates;
    std::string templateKey; // a class template instance's template (qualified)
    int variantN = 0;        // std::variant<...>: how many alternatives
    bool laidOut = false;    // its members placed (false while its definition is read)
    // an instance made while a class argument was still being defined
    // (`using Member = std::pair<std::string, Json>;` inside Json): made
    // again, in place, once the argument is complete, as C++ would only
    // instantiate it then
    bool redo = false;
    BindP redoBind;
};

// a constructor callable with no arguments
bool hasDefaultCtor(const ClassInfo *c)
{
    for (Method *m : c->ctors)
    {
        bool ok = true;
        for (size_t i = 0; i < m->params.size(); ++i)
            if (!m->defaults[i])
                ok = false;
        if (ok)
            return true;
    }
    return false;
}

// no constructor declared (template constructors count)
// a lambda's closure (possibly behind a reference)
bool isClosure(const NT &t)
{
    NT c = t->cat == C_REF ? t->elem : t;
    return c->cat == C_CLASS && c->cls->name.rfind("lambda#", 0) == 0;
}

bool noCtors(const ClassInfo *c) { return c->ctors.size() == 0 && !c->memberTemplates.count(""); }

NT tVoid() { return std::make_shared<NType>(); }
NT tInt(Kind k)
{
    NT t = std::make_shared<NType>();
    t->cat = k == K_VOID ? C_VOID : C_INT;
    t->kind = k;
    return t;
}
NT tPtr(const NT &to)
{
    NT t = std::make_shared<NType>();
    t->cat = C_PTR;
    t->elem = to;
    return t;
}
NT tRef(const NT &to, bool isConst, bool rvalue = false)
{
    NT t = std::make_shared<NType>();
    t->cat = C_REF;
    t->elem = to;
    t->isConst = isConst || rvalue;
    t->rvalue = rvalue;
    return t;
}
NT tArray(const NT &of, int n)
{
    NT t = std::make_shared<NType>();
    t->cat = C_ARRAY;
    t->elem = of;
    t->n = n;
    return t;
}
NT tFunc(const NT &ret, const std::vector<NT> &params)
{
    NT t = std::make_shared<NType>();
    t->cat = C_FUNC;
    t->elem = ret;
    t->fparams = params;
    return t;
}
NT tClass(ClassInfo *c)
{
    NT t = std::make_shared<NType>();
    t->cat = C_CLASS;
    t->cls = c;
    return t;
}

int sizeOf(const NT &t)
{
    switch (t->cat)
    {
    case C_INT: return kindSize(t->kind);
    case C_PTR: case C_REF: return 8;
    case C_ARRAY: return t->n * sizeOf(t->elem);
    case C_CLASS: return t->cls->size;
    default: return 1;
    }
}

int alignOf(const NT &t)
{
    switch (t->cat)
    {
    case C_INT: return kindSize(t->kind);
    case C_PTR: case C_REF: return 8;
    case C_ARRAY: return alignOf(t->elem);
    case C_CLASS: return t->cls->align;
    default: return 1;
    }
}

bool isScalar(const NT &t) { return t->cat == C_INT || t->cat == C_PTR; }

// The integer kind a scalar is handled as (a pointer: an unsigned 64-bit number)
Kind valKind(const NT &t) { return t->cat == C_INT ? t->kind : K_U64; }

int alignUp(int v, int a) { return (v + a - 1) / a * a; }

std::string typeKey(const NT &t)
{
    static const char *const kinds[] = {"void", "bool", "char", "uchar", "short", "ushort",
                                        "int", "uint", "llong", "ullong", "float", "double"};
    switch (t->cat)
    {
    case C_INT: return kinds[t->kind];
    case C_PTR: return typeKey(t->elem) + "*";
    case C_REF: return typeKey(t->elem) + "&";
    case C_ARRAY: return typeKey(t->elem) + "[" + std::to_string(t->n) + "]";
    case C_CLASS: return t->cls->name;
    case C_FUNC:
    {
        std::string k = "fn(";
        for (size_t i = 0; i < t->fparams.size(); ++i)
            k += (i ? "," : "") + typeKey(t->fparams[i]);
        return k + ")->" + typeKey(t->elem);
    }
    default: return "void";
    }
}

bool derivesFrom(ClassInfo *c, ClassInfo *base)
{
    for (; c; c = c->base)
        if (c == base)
            return true;
    return false;
}

bool sameType(const NT &a, const NT &b)
{
    if (a->cat != b->cat)
        return false;
    switch (a->cat)
    {
    case C_INT: return a->kind == b->kind;
    case C_PTR: case C_REF: case C_ARRAY: return sameType(a->elem, b->elem) && a->n == b->n;
    case C_CLASS: return a->cls == b->cls;
    case C_FUNC:
    {
        if (!sameType(a->elem, b->elem) || a->fparams.size() != b->fparams.size())
            return false;
        for (size_t i = 0; i < a->fparams.size(); ++i)
            if (!sameType(a->fparams[i], b->fparams[i]))
                return false;
        return true;
    }
    default: return true;
    }
}

// The IEEE-754 bits of v with `mant` mantissa bits and `bias` (double: 52 /
// 1023, float: 23 / 127), rounded to nearest even. Computed with frexp/ldexp
// so that every build of the compiler writes the same bytes.
uint64_t ieeeBits(double v, int mant, int bias)
{
    uint64_t sign = 0;
    if (v != v)
        return mant == 52 ? 0x7FF8000000000000ULL : 0x7FC00000ULL;
    if (v < 0)
    {
        sign = 1ULL << (mant == 52 ? 63 : 31);
        v = -v;
    }
    int expBits = mant == 52 ? 11 : 8;
    uint64_t expMax = (1ULL << expBits) - 1;
    if (v == 0)
        return sign;
    int e;
    double m = frexp(v, &e); // v = m * 2^e, 0.5 <= m < 1
    int64_t exp = e - 1 + bias;
    double scaled;
    if (exp <= 0)
    {
        scaled = ldexp(v, bias - 1 + mant); // a subnormal: v / 2^(1 - bias - mant)
        exp = 0;
    }
    else
        scaled = ldexp(m * 2 - 1, mant);
    double whole = floor(scaled);
    double frac = scaled - whole;
    uint64_t bits = (uint64_t)whole;
    if (frac > 0.5 || (frac == 0.5 && (bits & 1)))
        ++bits;
    if (bits >> mant)
    {
        bits &= (1ULL << mant) - 1;
        ++exp;
    }
    if (exp >= (int64_t)expMax)
        return sign | (expMax << mant); // infinity
    return sign | ((uint64_t)exp << mant) | bits;
}

// An integer literal's value and type (decimal: int, then long long; hex and
// octal may also be unsigned; suffixes u / l / ll)
int64_t literalValue(const std::string &text, Kind &kind)
{
    std::string s;
    for (char c : text)
        if (c != '\'')
            s += c;
    bool u = false;
    int longs = 0;
    while (!s.empty() && (s.back() == 'u' || s.back() == 'U' || s.back() == 'l' || s.back() == 'L'))
    {
        if (s.back() == 'u' || s.back() == 'U')
            u = true;
        else
            ++longs;
        s.pop_back();
    }
    int base = 10;
    size_t i = 0;
    if (s.size() > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X'))
        base = 16, i = 2;
    else if (s.size() > 2 && s[0] == '0' && (s[1] == 'b' || s[1] == 'B'))
        base = 2, i = 2;
    else if (s.size() > 1 && s[0] == '0')
        base = 8, i = 1;
    uint64_t v = 0;
    for (; i < s.size(); ++i)
    {
        char c = s[i];
        int d = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : 99;
        v = v * base + d;
    }
    if (longs >= 2 || v > 0xFFFFFFFFULL)
        kind = u || (base != 10 && v > 0x7FFFFFFFFFFFFFFFULL) ? K_U64 : K_I64;
    else if (u || (base != 10 && v > 0x7FFFFFFFULL))
        kind = K_U32;
    else
        kind = v > 0x7FFFFFFFULL ? K_I64 : K_I32;
    return (int64_t)v;
}

// synthesized syntax (generated members, range-for, ...)
cpp::ExprP mkName(const std::string &n, int line);
cpp::ExprP mkExpr(cpp::EK k, const std::string &op, std::vector<cpp::ExprP> kids, int line);
bool isRvalue(const cpp::ExprP &e, const NT &t);
void callsNamedLikeTypes(const cpp::DeclP &d, const std::set<std::string> &fs, const std::set<std::string> &ts);

const int kArgRegs[4] = {RCX, RDX, R8, R9};

// Where `this` comes from for a call
enum ThisKind
{
    TH_NONE,
    TH_OBJ,      // the object an lvalue expression designates
    TH_PTR,      // the value of a pointer expression
    TH_CUR,      // the current member function's this
    TH_LOCAL,    // the object at rbp+off
    TH_INDIRECT, // the address stored at rbp+off
    TH_GLOBAL,   // the object at .data+off
    TH_OUTER,    // in a lambda: the enclosing member function's this (captured)
};

struct ThisSrc
{
    ThisKind kind = TH_NONE;
    cpp::ExprP e;
    int off = 0;
};

class Gen
{
  public:
    Asm a;
    std::vector<Import> imports;
    std::string data; // the .data section
    std::vector<std::pair<int, int>> dataPtrs; // pointers within .data (see writePe)
    int entry = 0;

    void program(const cpp::Program &p);
    std::vector<std::string> files_; // the program's source files (Decl::file indexes them)
    bool trace_ = false;             // QUANTUM_NATIVE_TRACE: functions announce themselves
    bool verbose_ = false;           // QUANTUM_NATIVE_VERBOSE: each function generated, and its first caller
    // QUANTUM_NATIVE_MAP: "address name" per generated function (image base
    // 0x140000000, code at +0x1000), sorted by address
    void writeMap(const char *path)
    {
        std::vector<std::pair<long long, std::string>> rows;
        for (const auto &mp : allMethods_)
        {
            Method *m = mp.get();
            if (!m->done || m->label < 0)
                continue;
            std::string where = m->decl && m->decl->file >= 0 && m->decl->file < (int)files_.size()
                                    ? files_[m->decl->file] + ":" + std::to_string(m->decl->line)
                                    : "";
            rows.push_back({0x140001000LL + a.labelPos(m->label),
                            (m->owner ? m->owner->name + "::" : "") + m->name + "  " + where + "  frame=" +
                                std::to_string(m->frame)});
        }
        std::sort(rows.begin(), rows.end(),
                  [](const std::pair<long long, std::string> &x, const std::pair<long long, std::string> &y)
                  { return x.first < y.first; });
        std::ofstream out(path, std::ios::binary);
        for (const auto &r : rows)
        {
            char buf[32];
            snprintf(buf, sizeof(buf), "%llx ", (unsigned long long)r.first);
            out << buf << r.second << "\n";
        }
    }
    void at(const cpp::DeclP &d)
    {
        if (d && d->file >= 0 && d->file < (int)files_.size())
            g_failFile = files_[d->file];
    }

  private:
    struct Var
    {
        NT type;
        bool global = false;
        int off = 0; // rbp offset, or .data offset
    };
    struct Cleanup // an object to destroy when its scope ends
    {
        int off;
        ClassInfo *cls; // null: only a handler record to pop (a try block)
        int ehRec = 0;  // rbp offset of its handler record (0: none)
        int flag = 0;   // a temporary: rbp offset of its "constructed" flag (0: none)
    };
    struct Scope
    {
        std::map<std::string, Var> vars;
        std::vector<Cleanup> cleanups;
    };
    struct Loop
    {
        int breakLabel, continueLabel;
        size_t scopeDepth; // scopes_ size outside the loop body
    };

    std::vector<std::unique_ptr<Method>> allMethods_;
    std::map<std::string, std::vector<Method *>> funcs_;
    std::map<std::string, std::unique_ptr<ClassInfo>> classes_;
    std::map<std::string, Var> globals_;
    std::vector<std::pair<int, ClassInfo *>> globalObjects_; // .data offset, class: constructed before main
    std::vector<std::pair<int, cpp::DeclP>> globalCtorInits_; // .data offset, declaration
    std::vector<std::string> globalCtorNs_;                   // the scope each was declared in
    std::map<std::string, size_t> staticCtor_; // static data member (global name) -> its entry above
    std::map<std::string, int> runtime_; // runtime routine -> label (emitted when used)
    std::map<std::string, cpp::DeclP> classTemplates_;
    std::map<std::string, std::vector<cpp::DeclP>> funcTemplates_;
    std::map<std::string, std::string> templateNs_; // class template (qualified) -> its scope
    std::map<const cpp::Decl *, std::string> declNs_; // function template -> its scope
    // names: the scope names are looked up from, using-directives,
    // using-declarations, type aliases, enums
    std::string curNs_;
    std::vector<ClassInfo *> declaring_; // classes whose members are being declared
    bool forwarding_ = false;            // typing a function template's parameters (T&& forwards)
    std::vector<std::string> usings_;                         // using-directives in headers: everywhere
    std::map<int, std::vector<std::string>> tuUsings_;        // in a .sa file: its TU only
    std::vector<std::string> visibleUsings() const
    {
        std::vector<std::string> all = usings_;
        auto t = tuUsings_.find(curTu_);
        if (t != tuUsings_.end())
            all.insert(all.end(), t->second.begin(), t->second.end());
        return all;
    }
    std::map<std::string, std::string> usingDecls_; // short name -> qualified
    std::map<std::string, std::string> usingAlias_; // ns::name (a using-declaration in ns) -> what it names
    struct Alias
    {
        cpp::TypeNameP type;
        std::string ns;
        BindP bind;
    };
    std::map<std::string, Alias> aliases_;
    struct EnumInfo
    {
        Kind kind;
    };
    std::map<std::string, EnumInfo> enums_;
    std::map<std::string, std::pair<Kind, int64_t>> enumerators_; // qualified name -> (type, value)
    std::map<std::string, Method *> funcInstances_; // name<args> -> instance
    BindP bind_;                                   // template arguments in effect
    // expression -> template binding -> its type (keyed by plain pointers:
    // compared by identity)
    std::map<const cpp::Expr *, std::map<const Binding *, NT>> typeMemo_;
    // lambda expression -> template binding -> its closure class
    std::map<const cpp::Expr *, std::map<const Binding *, ClassInfo *>> closures_;
    int lambdaCount_ = 0;
    bool deducing_ = false; // generating a body only to find its return type
    // exceptions: .data offsets of the handler chain's top, the exception in
    // flight (its object, type record, destructor), and the type records
    int ehTop_ = -1, ehObj_ = -1, ehType_ = -1, ehDtor_ = -1;
    std::map<std::string, int> typeInfo_;
    std::vector<int> catchSaves_; // rbp offsets where the enclosing handlers keep their exception
    NT deducedRet_;

    // the function being generated
    Method *cur_ = nullptr;
    std::vector<Scope> scopes_;
    std::vector<Loop> loops_;
    int nextOff_ = 0; // lowest rbp offset handed out
    int depth_ = 0;   // 8-byte pushes outstanding (stack alignment at calls)
    int retLabel_ = -1;
    NT retType_;
    int retPtrOff_ = 0; // home slot of the hidden result pointer
    int thisOff_ = 0;   // home slot of this
    std::vector<Cleanup> temps_; // temporaries of the current full-expression
    std::string nrvoName_;       // the local every `return` of a class returns (built in place)

    // types
    NT typeOf(const cpp::TypeNameP &t, int line);
    NT baseType(const cpp::TypeNameP &t, int line);
    int64_t constInt(const cpp::ExprP &e);
    void classDecl(const cpp::DeclP &d, const std::string &instName = "");
    void declareAll(const std::vector<cpp::DeclP> &decls, const std::string &ns,
                    std::vector<std::pair<cpp::DeclP, std::string>> &outOfClass);
    void enumDecl(const cpp::DeclP &d, const std::string &ns);
    std::vector<std::string> candidates(const std::vector<std::string> &parts) const;
    ClassInfo *findClass(const std::vector<std::string> &parts);
    std::string findFunc(const std::vector<std::string> &parts);
    ClassInfo *instantiateClass(const std::string &name, const std::vector<cpp::TArg> &targs, int line);
    Method *instantiateFunc(const cpp::DeclP &d, int which, const std::vector<cpp::ExprP> &args,
                            const std::vector<cpp::TArg> &targs, bool explicitArgs, int line,
                            ClassInfo *owner = nullptr, const std::string &ownerNs = "");
    Method *makeFunction(const cpp::DeclP &d, const BindP &bind, const std::string &ns);
    std::vector<Method *> functionCands(const std::string &name, const std::vector<cpp::ExprP> &args,
                                        const cpp::ExprP &callee, int line);
    NT operatorCall(const std::string &op, const std::vector<cpp::ExprP> &kids, int line, bool &found,
                    const ThisSrc *result = nullptr);
    void constructElements(const ThisSrc &base, int off, const NT &arr, int line);
    NT lambda(const cpp::ExprP &e);
    ClassInfo *closureClass(const cpp::ExprP &e, std::vector<std::pair<std::string, bool>> &caps);
    void deduceReturn(Method *m);
    NT autoType(const cpp::TypeNameP &t, const cpp::ExprP &init, int line);
    int typeInfo(const NT &t);
    int pushHandler(int landing);  // a handler record in the frame, made the chain's top
    void popHandler(int rec);      // the chain's top back to the record's predecessor
    void throwExpr(const cpp::ExprP &e);
    void tryStmt(const cpp::StmtP &s);
    void rangeFor(const cpp::StmtP &s);
    int tempCount_ = 0;
    // synthesized trees live as long as the compile: types are memoized by
    // expression address, which a freed node's successor could reuse
    std::vector<cpp::StmtP> keepAlive_;
    std::vector<cpp::ExprP> keepExprs_;
    std::vector<BindP> keepBinds_; // likewise bindings (memo keys)
    std::vector<int> flagSlots_;   // the current function's temporaries' "constructed" flags
    bool frameObjects_ = false;    // the current function keeps objects in its frame
    // translation units: anonymous namespaces and namespace-scope statics of a
    // .sa/.cpp file live in a hidden scope __tuN:: that only its TU sees
    int curTu_ = 0;
    std::vector<int> globalCtorTu_; // per globalCtorInits_ entry
    static std::string tuNs(int tu) { return "__tu" + std::to_string(tu) + "::"; }
    // the TU whose own names a declaration sees (-1: a header's, none)
    int tuOf(const cpp::DeclP &d) const { return tuLocal(d) ? d->tu : -1; }
    bool tuLocal(const cpp::DeclP &d) const
    {
        if (!d || d->file < 0 || d->file >= (int)files_.size())
            return false;
        const std::string &f = files_[d->file];
        if (f.rfind("<lib>/", 0) == 0)
            return false;
        auto ends = [&](const char *x)
        {
            std::string e = x;
            return f.size() >= e.size() && f.compare(f.size() - e.size(), e.size(), e) == 0;
        };
        return !(ends(".h.sa") || ends(".h") || ends(".hpp"));
    }
    std::map<const cpp::Decl *, std::map<std::string, Method *>> memberInstances_;
    int visitCount_ = 0;
    ClassInfo *instantiateBound(const std::string &name, const BindP &bind, const std::string &key, int line);
    ClassInfo *variantClass(const std::vector<cpp::TArg> &targs, int line);
    // the class `owner` (of Owner::member) names: a class, an alias, a
    // template instance, a template parameter (null: none)
    ClassInfo *ownerClass(const std::vector<std::string> &owner, const std::vector<std::vector<cpp::TArg>> &targs,
                          int line)
    {
        bool withTargs = false;
        for (const auto &ta : targs)
            if (!ta.empty())
                withTargs = true;
        if (owner.size() == 1 && bind_ && bind_->types.count(owner[0]))
            return bind_->types[owner[0]]->cat == C_CLASS ? bind_->types[owner[0]]->cls : nullptr;
        if (!withTargs)
            if (ClassInfo *c = findClass(owner))
                return c;
        bool known = withTargs;
        for (const std::string &k : candidates(owner))
            if (aliases_.count(k))
                known = true;
        if (!known)
            return nullptr;
        auto ot = std::make_shared<cpp::TypeName>();
        ot->name = owner;
        ot->targs = targs;
        ot->targs.resize(owner.size());
        ot->hasTargs = withTargs;
        NT o = typeOf(ot, line);
        return o->cat == C_CLASS ? o->cls : nullptr;
    }
    ClassInfo *functionClass(const cpp::TypeNameP &sig, int line);
    NT variantAlt(ClassInfo *vc, int i);
    NT variantCall(const std::string &fn, const cpp::ExprP &callee, const std::vector<cpp::ExprP> &args,
                   ClassInfo *vc, int line, const ThisSrc *result);
    Method *makeMember(ClassInfo *c, const cpp::DeclP &d, const BindP &bind, const std::string &ns);
    // the function a name designates as a value (f, ::f, ns::f): one
    // non-template function of that name (null: none)
    Method *functionValue(const std::vector<std::string> &name, int line)
    {
        std::string k = findFunc(name);
        if (k.empty() || !funcs_.count(k) || funcs_[k].empty())
            return nullptr;
        if (funcs_[k].size() > 1)
            fail("the address of overloaded function " + k + " (not yet)", line);
        Method *m = funcs_[k][0];
        if (!m->dll.empty())
            fail("the address of a Windows API function (not yet)", line);
        if (!m->ret)
            deduceReturn(m);
        m->used = true;
        return m;
    }
    // how specific a template's parameter patterns are (X<T>, T*, int count; bare T not)
    static int specialization(const Method *m)
    {
        int n = 0;
        if (!m->decl)
            return 0;
        for (const cpp::Param &pr : m->decl->params)
        {
            if (!pr.type)
                continue;
            bool bare = pr.type->name.size() == 1 && !pr.type->hasTargs && pr.type->pointers == 0;
            bool param = false;
            for (const std::string &tp : m->decl->templateParams)
                if (!pr.type->name.empty() && pr.type->name[0] == tp)
                    param = true;
            if (!(bare && param))
                ++n;
        }
        return n;
    }
    // whether e is an rvalue (a temporary or an xvalue): c ? a : b is one when
    // either branch is; a call returning a reference is not
    bool rvalueExpr(const cpp::ExprP &e)
    {
        if (e->k == cpp::EK::Cond)
            return rvalueExpr(e->kids[1]) || rvalueExpr(e->kids[2]);
        if (e->k == cpp::EK::Comma)
            return rvalueExpr(e->kids.back());
        return isRvalue(e, rawType(e)) || memberOfTemporary(e);
    }
    // f().member / T(...).member: a member of a temporary object (an rvalue)
    bool memberOfTemporary(const cpp::ExprP &e)
    {
        if (e->k != cpp::EK::Member || e->arrow)
            return false;
        const cpp::ExprP &o = e->kids[0];
        if (o->k == cpp::EK::Construct)
            return true;
        if (o->k != cpp::EK::Call)
            return false;
        NT ot = rawType(o);
        return ot->cat == C_CLASS; // not a reference: a prvalue
    }
    // name(args) parsed as constructing the std type `name` while a local
    // variable of that name is in scope (auto less = ...; less(a, b)): the call
    std::map<const cpp::Expr *, cpp::ExprP> localCalls_;
    cpp::ExprP asLocalCall(const cpp::ExprP &e)
    {
        if (e->k != cpp::EK::Construct || !e->type || e->braced || e->type->name.size() != 1 || e->type->hasTargs ||
            e->type->pointers || e->type->ref || e->type->rref)
            return nullptr;
        bool local = false;
        for (const Scope &sc : scopes_)
            if (sc.vars.count(e->type->name[0]) && !sc.vars.at(e->type->name[0]).global)
                local = true;
        if (!local && !(cur_ && cur_->owner && cur_->owner->name.rfind("lambda#", 0) == 0))
            return nullptr;
        if (!local)
        {
            int off = 0;
            if (!findField(cur_->owner, e->type->name[0], off))
                return nullptr; // a lambda's captured variable
        }
        auto known = localCalls_.find(e.get());
        if (known != localCalls_.end())
            return known->second;
        std::vector<cpp::ExprP> kids = {keepExpr(mkName(e->type->name[0], e->line))};
        kids.insert(kids.end(), e->kids.begin(), e->kids.end());
        cpp::ExprP c = keepExpr(mkExpr(cpp::EK::Call, "", kids, e->line));
        keepExprs_.push_back(e);
        localCalls_[e.get()] = c;
        return c;
    }
    // whether {items} can make an object of class c: an initializer_list
    // (of convertible elements), a constructor taking them, an aggregate
    bool listBuilds(ClassInfo *c, const std::vector<cpp::ExprP> &items)
    {
        auto fits = [&](const NT &t, const cpp::ExprP &x)
        { return x->k == cpp::EK::InitList || argCost(t, x, typeOfExpr(x)) >= 0; };
        if (c->templateName == "initializer_list" && c->bind && !c->bind->types.empty())
        {
            NT el = c->bind->types.begin()->second;
            for (const cpp::ExprP &x : items)
                if (!fits(el, x))
                    return false;
            return true;
        }
        if (items.empty())
            return true;
        for (Method *m : c->ctors)
        {
            if (m->params.size() == 1)
            {
                NT lp = m->params[0]->cat == C_REF ? m->params[0]->elem : m->params[0];
                if (lp->cat == C_CLASS && lp->cls->templateName == "initializer_list" && listBuilds(lp->cls, items))
                    return true;
            }
            if (m->params.size() < items.size())
                continue;
            bool ok = true;
            for (size_t i = 0; ok && i < m->params.size(); ++i)
                ok = i < items.size() ? fits(m->params[i], items[i]) : m->defaults[i] != nullptr;
            if (ok)
                return true;
        }
        if (c->memberTemplates.count(""))
            return true; // a template constructor may take them
        return noCtors(c) && !c->polymorphic && c->fields.size() >= items.size();
    }
    // a user conversion: from's `operator T()` giving `to` (a class)
    Method *convOp(ClassInfo *from, const NT &to)
    {
        for (ClassInfo *k = from; k; k = k->base)
            for (auto &kv : k->methods)
                if (kv.first.rfind("operator ", 0) == 0)
                    for (Method *m : kv.second)
                    {
                        if (!m->ret || !m->params.empty())
                            continue;
                        NT r = m->ret->cat == C_REF ? m->ret->elem : m->ret;
                        if (sameType(r, to))
                            return m;
                    }
        return nullptr;
    }
    // a captureless lambda as a function pointer: a plain function with its body
    std::map<ClassInfo *, Method *> lambdaFns_;
    Method *lambdaFunction(ClassInfo *closure, int line)
    {
        auto known = lambdaFns_.find(closure);
        if (known != lambdaFns_.end())
            return known->second;
        std::vector<Method *> ops;
        if (!findMethod(closure, "operator()", ops) || ops.size() != 1)
            fail("this lambda as a function pointer", line);
        if (!closure->fields.empty())
            fail("a capturing lambda as a function pointer", line);
        Method *op = ops[0];
        if (!op->ret)
            deduceReturn(op);
        Method *f = newMethod();
        f->name = closure->name + "::fn";
        f->ns = op->ns;
        f->decl = op->decl;
        f->bind = op->bind;
        f->params = op->params;
        f->defaults = op->defaults;
        f->ret = op->ret;
        f->used = true;
        lambdaFns_[closure] = f;
        return f;
    }
    // a call through a function pointer (fnExpr: its value)
    NT indirectCall(const cpp::ExprP &fnExpr, const NT &ft, const std::vector<cpp::ExprP> &args, int line,
                    const ThisSrc *result)
    {
        expr(fnExpr);
        int slot = newSlot(tPtr(tVoid()));
        a.store(slot, RAX);
        sigs_.push_back(std::make_unique<Method>());
        Method *sig = sigs_.back().get();
        sig->name = "(function pointer)";
        sig->ret = ft->elem;
        sig->params = ft->fparams;
        sig->defaults.assign(sig->params.size(), nullptr);
        sig->label = -1;
        return callMethod(sig, ThisSrc(), args, false, line, result, slot);
    }
    std::vector<std::unique_ptr<Method>> sigs_;
    void templateMembers(ClassInfo *c, const std::string &name, const std::vector<cpp::ExprP> &args,
                         const std::vector<cpp::TArg> &targs, bool explicitArgs, int line,
                         std::vector<Method *> &out);
    void protect(Cleanup &c);      // destroy c's object if an exception passes
    Method *declareMethod(ClassInfo *c, const cpp::DeclP &m);
    void layoutClass(ClassInfo *c);
    bool incompleteArgs(const BindP &b);
    void runRedos();
    std::vector<ClassInfo *> redoPending_; // instances to make again (ClassInfo::redo)
    bool redoing_ = false;
    void implicitCopies(ClassInfo *c);
    cpp::ExprP keepExpr(cpp::ExprP e)
    {
        keepExprs_.push_back(e);
        return e;
    }
    cpp::ExprP arrowBase(const cpp::ExprP &obj); // obj.operator->()
    cpp::ExprP typeConstruct(const cpp::ExprP &call); // a call of a type name, as a construction (or null)
    // a construction, built in `result` when there is one (a call's result place)
    NT constructInto(const cpp::ExprP &ce, const ThisSrc *result)
    {
        if (result)
        {
            NT t = typeOf(ce->type, ce->line);
            if (t->cat == C_CLASS)
            {
                construct(*result, t->cls, ce->kids, ce->braced, ce->line);
                loadThis(*result);
                return t;
            }
        }
        return expr(ce);
    }
    NT printfCall(const std::string &name, const std::vector<cpp::ExprP> &args, int line);
    cpp::ExprP asCondition(const cpp::ExprP &e); // an object: its operator bool()
    bool initListCtor(const ThisSrc &self, ClassInfo *c, const std::vector<cpp::ExprP> &items, int line);
    void bindNames(const cpp::VarDeclarator &d, int line); // auto [a, b] = ...
    Method *newMethod();

    // program pieces
    int importIndex(const std::string &dll, const std::string &name);
    int routine(const std::string &name);
    void function(Method &m);
    void ctorPrologue(Method &m);
    void dtorEpilogue(Method &m);
    void runtime();
    void globalVar(const cpp::DeclP &d);
    void constInit(int off, const NT &t, const cpp::ExprP &init, int line);
    int stringData(const std::string &bytes);
    void fillVtables();

    // values
    void wrap(Kind k, int r = RAX);
    void convKind(Kind from, Kind to); // rax: a `from` value -> a `to` value
    void truth(const NT &t);           // rax: a value -> 0/1 (floats: != 0.0)
    void arithFloat(const std::string &op, Kind k, int line);
    void compareFloat(const std::string &op, Kind k);
    void convert(const NT &to, const NT &from, int line);
    NT expr(const cpp::ExprP &e);
    NT addr(const cpp::ExprP &e);
    NT valueAt(const NT &t);
    NT typeOfExpr(const cpp::ExprP &e);
    // a call's own result type (a reference stays one: expr() makes it a value)
    NT rawType(const cpp::ExprP &e);
    std::map<const cpp::Expr *, std::map<const Binding *, NT>> rawMemo_;
    NT binary(const cpp::ExprP &e);
    NT assign(const cpp::ExprP &e);
    NT incDec(const cpp::ExprP &e, bool inc, bool post);
    NT call(const cpp::ExprP &e, const ThisSrc *result = nullptr);
    NT callMethod(Method *m, const ThisSrc &self, const std::vector<cpp::ExprP> &args, bool virt, int line,
                  const ThisSrc *result = nullptr, int indirect = 0);
    Method *resolve(const std::vector<Method *> &cands, const std::vector<cpp::ExprP> &args, const std::string &what,
                    int line);
    int argCost(const NT &param, const cpp::ExprP &arg, const NT &argT);
    Method *findMethod(ClassInfo *c, const std::string &name, std::vector<Method *> &out);
    const Field *findField(ClassInfo *c, const std::string &name, int &off);
    void arith(const std::string &op, Kind k, int line);
    Var *lookup(const std::string &name);
    void pushRax();
    void popReg(int r);
    void copyBytes(int size);
    void bindRef(const NT &ref, const cpp::ExprP &e, int line);
    void loadThis(const ThisSrc &s);
    void construct(const ThisSrc &self, ClassInfo *c, const std::vector<cpp::ExprP> &args, bool braced, int line);
    void destroy(const ThisSrc &self, ClassInfo *c);
    void destroyScopes(size_t downTo);
    void endFullExpr();
    // a temporary to destroy at the end of the full-expression, if this code
    // (one branch of a ?: perhaps) ran: its flag is set here
    void addTemp(int off, ClassInfo *cls)
    {
        Cleanup c{off, cls, 0};
        c.flag = newSlot(tInt(K_I64));
        flagSlots_.push_back(c.flag); // cleared by the function's setup
        a.movImm(RAX, 1);
        a.store(c.flag, RAX);
        temps_.push_back(c);
    }
    void callRoutine(int label);

    // statements
    void stmt(const cpp::StmtP &s);
    void cond(const cpp::ExprP &e, int falseLabel);
    int newSlot(const NT &t);
    void localInit(int off, const NT &t, const cpp::ExprP &init, int line);
    void declare(const std::string &name, const NT &t, const cpp::ExprP &init, bool braced,
                 const std::vector<cpp::ExprP> &args, int line);
};

Method *Gen::newMethod()
{
    allMethods_.push_back(std::make_unique<Method>());
    Method *m = allMethods_.back().get();
    m->label = a.newLabel();
    return m;
}

// ─── Names ─────────────────────────────────────────────────────────────────

std::string joinName(const std::vector<std::string> &parts)
{
    std::string j;
    for (size_t i = 0; i < parts.size(); ++i)
    {
        if (i)
            j += "::";
        j += parts[i];
    }
    return j;
}

// The qualified names `parts` may mean, in lookup order: from the current
// scope outward, then through using-directives
std::vector<std::string> Gen::candidates(const std::vector<std::string> &partsIn) const
{
    std::vector<std::string> parts = partsIn;
    std::vector<std::string> out;
    if (!parts.empty() && parts[0].empty())
    {
        parts.erase(parts.begin()); // ::name: the global one
        out.push_back(joinName(parts));
        out.push_back(tuNs(curTu_) + joinName(parts));
        return out;
    }
    if (parts.size() == 1)
    {
        auto u = usingDecls_.find(parts[0]);
        if (u != usingDecls_.end())
            out.push_back(u->second);
    }
    std::string j = joinName(parts);
    std::string ns = curNs_;
    std::string tu = tuNs(curTu_);
    while (true)
    {
        out.push_back(ns + j);
        out.push_back(ns + tu + j);
        if (ns.empty())
            break;
        std::string t = ns.substr(0, ns.size() - 2);
        size_t at = t.rfind("::");
        ns = at == std::string::npos ? "" : t.substr(0, at + 2);
    }
    std::vector<std::string> vis = visibleUsings();
    for (const std::string &u : vis)
        out.push_back(u + "::" + j);
    // a using-declaration (namespace std { using ::isalpha; }) names another entity
    size_t n = out.size();
    for (size_t i = 0; i < n; ++i)
    {
        auto al = usingAlias_.find(out[i]);
        if (al != usingAlias_.end())
        {
            const std::string &t = al->second;
            out.push_back(t);
            // ::name may itself be a using-declaration or come through a using-directive
            auto ud = usingDecls_.find(t);
            if (ud != usingDecls_.end())
                out.push_back(ud->second);
            for (const std::string &u : vis)
                out.push_back(u + "::" + t);
        }
    }
    return out;
}

ClassInfo *Gen::findClass(const std::vector<std::string> &parts)
{
    for (const std::string &k : candidates(parts))
    {
        auto it = classes_.find(k);
        if (it != classes_.end())
            return it->second.get();
    }
    return nullptr;
}

// The qualified name of the functions `parts` names ("" if none)
std::string Gen::findFunc(const std::vector<std::string> &parts)
{
    for (const std::string &k : candidates(parts))
        if (funcs_.count(k) || funcTemplates_.count(k))
            return k;
    return "";
}

// ─── Types ─────────────────────────────────────────────────────────────────

int64_t Gen::constInt(const cpp::ExprP &e)
{
    if (e->k == cpp::EK::Name && e->hasTargs && e->targs.size() == 2 && !e->name.empty() &&
        e->name.back() == "is_same_v" && e->targs[0].type && e->targs[1].type)
        return sameType(typeOf(e->targs[0].type, e->line), typeOf(e->targs[1].type, e->line)) ? 1 : 0;
    if (e->k == cpp::EK::Unary && e->op == "!")
        return !constInt(e->kids[0]);
    if (e->k == cpp::EK::Binary && (e->op == "&&" || e->op == "||"))
    {
        bool l = constInt(e->kids[0]) != 0;
        if (e->op == "&&" ? !l : l)
            return l;
        return constInt(e->kids[1]) != 0;
    }
    if (e->k == cpp::EK::Binary &&
        (e->op == "==" || e->op == "!=" || e->op == "<" || e->op == ">" || e->op == "<=" || e->op == ">="))
    {
        int64_t l = constInt(e->kids[0]), r = constInt(e->kids[1]);
        const std::string &op = e->op;
        return op == "==" ? l == r : op == "!=" ? l != r : op == "<" ? l < r : op == ">" ? l > r : op == "<=" ? l <= r : l >= r;
    }
    switch (e->k)
    {
    case cpp::EK::Int:
    {
        Kind k;
        return literalValue(e->str, k);
    }
    case cpp::EK::Char:
        return (int64_t)e->num;
    case cpp::EK::Bool:
        return e->num != 0;
    case cpp::EK::Unary:
        if (e->op == "-")
            return -constInt(e->kids[0]);
        if (e->op == "+")
            return constInt(e->kids[0]);
        if (e->op == "~")
            return ~constInt(e->kids[0]);
        break;
    case cpp::EK::Binary:
    {
        int64_t l = constInt(e->kids[0]), r = constInt(e->kids[1]);
        const std::string &op = e->op;
        if (op == "+") return l + r;
        if (op == "-") return l - r;
        if (op == "*") return l * r;
        if (op == "/" && r) return l / r;
        if (op == "%" && r) return l % r;
        if (op == "<<") return l << r;
        if (op == ">>") return l >> r;
        if (op == "|") return l | r;
        if (op == "&") return l & r;
        break;
    }
    case cpp::EK::SizeofT:
        return sizeOf(typeOf(e->type, e->line));
    case cpp::EK::Cast:
    case cpp::EK::Construct:
        if (e->kids.size() == 1)
        {
            int64_t v = constInt(e->kids[0]);
            NT t = typeOf(e->type, e->line);
            if (t->cat == C_INT && kindSize(t->kind) == 4)
                v = isUnsigned(t->kind) ? (int64_t)(uint32_t)v : (int64_t)(int32_t)v;
            return v;
        }
        break;
    case cpp::EK::Name:
        if (e->name.size() == 1 && bind_ && bind_->values.count(e->name[0]))
            return bind_->values[e->name[0]];
        for (const std::string &k : candidates(e->name))
        {
            auto en = enumerators_.find(k);
            if (en != enumerators_.end())
                return en->second.second;
        }
        {
            Var *v = e->name.size() == 1 ? lookup(e->name[0]) : nullptr;
            if (!v)
                for (const std::string &k : candidates(e->name))
                {
                    auto g = globals_.find(k);
                    if (g != globals_.end())
                    {
                        v = &g->second;
                        break;
                    }
                }
            if (v && v->global && v->type->cat == C_INT)
            {
                int64_t x = 0; // a constant global: its initial bytes
                int n = kindSize(v->type->kind);
                for (int i = n - 1; i >= 0; --i)
                    x = x * 256 + (unsigned char)data[v->off + i];
                if (n < 8 && !isUnsigned(v->type->kind) && (x >> (8 * n - 1)) & 1)
                    x -= (int64_t)1 << (8 * n); // sign
                return x;
            }
        }
        break;
    default:
        break;
    }
    fail("a constant was expected here", e->line);
}

NT Gen::baseType(const cpp::TypeNameP &t, int line)
{
    std::vector<std::string> n = t->name;
    if (t->isFunction)
    {
        // R(Args): a function type (pointers to it are applied by typeOf)
        std::vector<NT> ps;
        for (const cpp::TypeNameP &x : t->params)
        {
            NT pt = typeOf(x, line);
            if (pt->cat == C_ARRAY)
                pt = tPtr(pt->elem);
            ps.push_back(pt);
        }
        if (ps.size() == 1 && ps[0]->cat == C_VOID)
            ps.clear(); // R(void)
        return tFunc(t->ret ? typeOf(t->ret, line) : tVoid(), ps);
    }
    if (t->decltypeOf)
    {
        const cpp::ExprP &x = t->decltypeOf;
        if (x->k == cpp::EK::Name && x->name.size() == 1)
            if (Var *v = lookup(x->name[0]))
                return v->type; // a variable's declared type (a reference stays one)
        return typeOfExpr(x);
    }
    if (t->hasTargs && !t->targs.empty() && t->targs.back().size() == 1 && t->targs.back()[0].type &&
        (n.size() == 1 || (n.size() == 2 && n[0] == "std")))
    {
        // type traits
        const std::string &w = n.back();
        if (w == "decay_t" || w == "remove_reference_t" || w == "remove_cvref_t" || w == "remove_cv_t" ||
            w == "remove_const_t")
        {
            NT r = typeOf(t->targs.back()[0].type, line);
            if (r->cat == C_REF && w != "remove_cv_t" && w != "remove_const_t")
                r = r->elem;
            if (w == "decay_t" && r->cat == C_ARRAY)
                r = tPtr(r->elem);
            return r;
        }
    }
    if (t->hasTargs && !t->targs.empty() && !t->targs.back().empty())
    {
        for (const std::string &k : candidates(n))
        {
            if (k == "std::variant" && classTemplates_.count("std::__variant"))
                return tClass(variantClass(t->targs.back(), line));
            if (k == "std::function" && t->targs.back().size() == 1 && t->targs.back()[0].type &&
                t->targs.back()[0].type->isFunction)
                return tClass(functionClass(t->targs.back()[0].type, line));
            if (classTemplates_.count(k))
                return tClass(instantiateClass(k, t->targs.back(), line));
        }
        fail("unknown template " + t->str(), line);
    }
    // a class, alias or enum by (qualified) name
    {
        std::vector<std::string> cs = candidates(n);
        if (n.size() == 1 && bind_ && bind_->types.count(n[0]))
            cs.clear(); // a template parameter
        for (const std::string &k : cs)
        {
            auto c = classes_.find(k);
            if (c != classes_.end())
                return tClass(c->second.get());
            auto al = aliases_.find(k);
            if (al != aliases_.end())
            {
                std::string savedNs = curNs_;
                BindP savedBind = bind_;
                curNs_ = al->second.ns;
                bind_ = al->second.bind;
                NT r = typeOf(al->second.type, line);
                curNs_ = savedNs;
                bind_ = savedBind;
                return r;
            }
            auto en = enums_.find(k);
            if (en != enums_.end())
                return tInt(en->second.kind);
        }
    }
    if (n.size() >= 2)
    {
        // Owner::Member with the owner an alias, a template instance or a
        // template parameter (std::regex::flag_type, T::value_type)
        std::vector<std::string> owner(n.begin(), n.end() - 1);
        ClassInfo *oc = nullptr;
        bool ownerTargs = false;
        for (size_t k = 0; k + 1 < t->targs.size(); ++k)
            if (!t->targs[k].empty())
                ownerTargs = true;
        if (owner.size() == 1 && bind_ && bind_->types.count(owner[0]) && bind_->types[owner[0]]->cat == C_CLASS)
            oc = bind_->types[owner[0]]->cls;
        else if (ownerTargs || findClass(owner))
        {
            auto ot = std::make_shared<cpp::TypeName>();
            ot->name = owner;
            ot->targs.assign(t->targs.begin(), t->targs.begin() + (t->targs.size() >= owner.size() ? owner.size() : t->targs.size()));
            ot->hasTargs = ownerTargs;
            NT o = typeOf(ot, line);
            if (o->cat == C_CLASS)
                oc = o->cls;
        }
        else
            for (const std::string &k : candidates(owner))
                if (aliases_.count(k))
                {
                    auto ot = std::make_shared<cpp::TypeName>();
                    ot->name = owner;
                    NT o = typeOf(ot, line);
                    if (o->cat == C_CLASS)
                        oc = o->cls;
                    break;
                }
        for (ClassInfo *k = oc; k; k = k->base)
        {
            std::string key = k->name + "::" + n.back();
            auto c = classes_.find(key);
            if (c != classes_.end())
                return tClass(c->second.get());
            auto al = aliases_.find(key);
            if (al != aliases_.end())
            {
                std::string savedNs = curNs_;
                BindP savedBind = bind_;
                curNs_ = al->second.ns;
                bind_ = al->second.bind;
                NT r = typeOf(al->second.type, line);
                curNs_ = savedNs;
                bind_ = savedBind;
                return r;
            }
            auto en = enums_.find(key);
            if (en != enums_.end())
                return tInt(en->second.kind);
        }
    }
    if (n.size() == 2 && n[0] == "std")
        n.erase(n.begin());
    if (n.size() != 1)
        fail("type " + t->str(), line);
    const std::string &w = n[0];
    if (bind_)
    {
        auto b = bind_->types.find(w);
        if (b != bind_->types.end())
            return b->second;
    }
    if (w == "void")
        return tVoid();
    if (w == "nullptr_t")
        return tPtr(tVoid()); // nullptr's own type
    if (w == "bool")
        return tInt(K_BOOL);
    if (w == "double" || w == "long double")
        return tInt(K_F64);
    if (w == "float")
        return tInt(K_F32);
    if (w == "char" || w == "signed char" || w == "int8_t")
        return tInt(K_I8);
    if (w == "wchar_t" || w == "char16_t")
        return tInt(K_U16);
    if (w == "char32_t")
        return tInt(K_U32);
    if (w == "unsigned char" || w == "uint8_t")
        return tInt(K_U8);
    if (w == "short" || w == "short int" || w == "signed short" || w == "int16_t")
        return tInt(K_I16);
    if (w == "unsigned short" || w == "unsigned short int" || w == "uint16_t")
        return tInt(K_U16);
    if (w == "int" || w == "signed" || w == "signed int" || w == "long" || w == "long int" ||
        w == "signed long" || w == "int32_t")
        return tInt(K_I32); // long is 32 bits on Windows
    if (w == "unsigned" || w == "unsigned int" || w == "unsigned long" || w == "unsigned long int" ||
        w == "uint32_t")
        return tInt(K_U32);
    if (w == "long long" || w == "long long int" || w == "signed long long" || w == "int64_t" ||
        w == "ptrdiff_t" || w == "intptr_t")
        return tInt(K_I64);
    if (w == "unsigned long long" || w == "unsigned long long int" || w == "uint64_t" || w == "size_t" ||
        w == "uintptr_t")
        return tInt(K_U64);
    // inside a class template, its own name means the current instance
    if (cur_ && cur_->owner && cur_->owner->templateName == w)
        return tClass(cur_->owner);
    for (int i = (int)declaring_.size() - 1; i >= 0; --i)
        if (declaring_[i]->templateName == w)
            return tClass(declaring_[i]);
    if (t->elaborated && t->name.size() == 1)
    {
        // `struct X` naming no class yet declares one (defined later) in
        // the enclosing namespace
        std::string ns = curNs_;
        while (ns.size() > 2)
        {
            std::string inner = ns.substr(0, ns.size() - 2);
            if (!classes_.count(inner) && inner.find('$') == std::string::npos)
                break; // a namespace
            size_t at = inner.rfind("::");
            ns = at == std::string::npos ? "" : inner.substr(0, at + 2);
        }
        auto info = std::make_unique<ClassInfo>();
        info->name = ns + t->name[0];
        ClassInfo *c = info.get();
        classes_[c->name] = std::move(info);
        return tClass(c);
    }
    fail("unknown type " + t->str() + " (as " + joinName(t->name) + ", in scope " + (curNs_.empty() ? "::" : curNs_) + ")",
         line);
}

// The type of `auto x = init` (also auto&, const auto&, auto*)
NT Gen::autoType(const cpp::TypeNameP &t, const cpp::ExprP &init, int line)
{
    if (!init)
        fail("auto without an initializer", line);
    cpp::ExprP e = init;
    if (e->k == cpp::EK::InitList)
    {
        if (e->kids.size() != 1)
            fail("auto from a braced list", line);
        e = e->kids[0];
    }
    NT v = typeOfExpr(e);
    if (e->k == cpp::EK::Name && e->name.size() == 1)
        if (Var *var = lookup(e->name[0]))
            v = var->type; // an array named stays an array (auto&& binds it whole)
    if (v->cat == C_REF)
        v = v->elem;
    if (t->ref || t->rref)
        return tRef(v, t->isConst);
    if (v->cat == C_ARRAY)
        v = tPtr(v->elem); // decays
    return v;
}

NT Gen::typeOf(const cpp::TypeNameP &t, int line)
{
    if (!t)
        fail("a declaration without a type", line);
    if (t->isAuto() && !t->decltypeOf)
        fail("auto here (only for variables with an initializer so far)", line);
    NT ty = baseType(t, line);
    for (int i = (int)t->pointeeDims.size() - 1; i >= 0; --i)
        ty = tArray(ty, (int)constInt(t->pointeeDims[i]));
    for (int i = 0; i < t->pointers; ++i)
        ty = tPtr(ty);
    for (int i = (int)t->arrayDims.size() - 1; i >= 0; --i)
        ty = tArray(ty, t->arrayDims[i] ? (int)constInt(t->arrayDims[i]) : 0);
    if (ty->cat == C_REF && (t->ref || t->rref))
        return ty; // X& & / X& && : X&
    if (t->rref && forwarding_ && bind_ && t->name.size() == 1 && bind_->types.count(t->name[0]) &&
        t->pointers == 0)
    {
        // T&& with T a template parameter: a forwarding reference. T was
        // deduced X& for an lvalue (collapsed above); here it takes an rvalue
        return tRef(ty, false, true);
    }
    if (t->ref || t->rref)
        ty = tRef(ty, t->isConst && t->pointers == 0, t->rref);
    return ty;
}

Method *Gen::declareMethod(ClassInfo *c, const cpp::DeclP &m)
{
    Method *f = newMethod();
    f->name = m->isCtor ? c->name : m->isDtor ? "~" + c->name : m->name.back();
    f->owner = c;
    f->bind = c->bind;
    f->ns = c->name + "::";
    f->decl = m;
    f->isStatic = m->isStatic;
    f->isVirtual = m->isVirtual;
    f->isPure = m->isPure;
    f->isCtor = m->isCtor;
    f->isDtor = m->isDtor;
    f->ret = m->isCtor || m->isDtor ? tVoid() : typeOf(m->ret, m->line);
    for (const cpp::Param &pr : m->params)
    {
        NT pt = typeOf(pr.type, m->line);
        if (pt->cat == C_ARRAY)
            pt = tPtr(pt->elem);
        f->params.push_back(pt);
        f->defaults.push_back(pr.def);
    }
    if (m->variadic)
        fail("variadic function " + f->name, m->line);
    if (m->isCtor)
        c->ctors.push_back(f);
    else if (m->isDtor)
        c->dtor = f;
    else
        c->methods[f->name].push_back(f);
    return f;
}

void Gen::classDecl(const cpp::DeclP &d, const std::string &instName)
{
    if (d->isTemplate && instName.empty())
        fail("this class template", d->line);
    if (d->isUnion)
        fail("union (not yet)", d->line);
    std::string cname = instName.empty() ? curNs_ + joinName(d->name) : instName;
    ClassInfo *c;
    auto known = classes_.find(cname);
    if (known != classes_.end() && !known->second->complete)
        c = known->second.get(); // declared before: completed now
    else
    {
        if (known != classes_.end())
            fail("class " + cname + " defined twice", d->line);
        auto info = std::make_unique<ClassInfo>();
        info->name = cname;
        c = info.get();
        classes_[cname] = std::move(info); // visible to its own pointer members
    }
    c->bind = bind_;
    if (!instName.empty())
        c->templateName = d->name.back();
    c->complete = true;
    std::string savedNs = curNs_;
    // the base is named from the enclosing scope, the members from the class's
    if (d->bases.size() > 1)
        fail("multiple inheritance (not yet)", d->line);
    if (d->bases.size() == 1)
    {
        NT b = typeOf(d->bases[0], d->line);
        if (b->cat != C_CLASS)
            fail("base class " + d->bases[0]->str(), d->line);
        c->base = b->cls;
    }
    curNs_ = cname + "::";
    declaring_.push_back(c);
    // nested types first: a member's type may be declared further down
    for (const cpp::DeclP &m : d->members)
    {
        if (m->k == cpp::DK::Class && !m->isTemplate)
        {
            if (m->forwardOnly)
            {
                std::string k = curNs_ + joinName(m->name);
                if (!classes_.count(k))
                {
                    auto info = std::make_unique<ClassInfo>();
                    info->name = k;
                    classes_[k] = std::move(info);
                }
            }
            else
                classDecl(m);
        }
        else if (m->k == cpp::DK::Class && m->isTemplate)
        {
            classTemplates_[curNs_ + joinName(m->name)] = m;
            templateNs_[curNs_ + joinName(m->name)] = curNs_;
        }
        else if (m->k == cpp::DK::Enum)
            enumDecl(m, curNs_);
        else if (m->k == cpp::DK::Alias)
            aliases_[curNs_ + m->name.back()] = Alias{m->aliased, curNs_, bind_};
    }
    if (d->bases.size() > 1)
        fail("multiple inheritance (not yet)", d->line);
    if (d->bases.size() == 1)
    {
        NT b = typeOf(d->bases[0], d->line);
        if (b->cat != C_CLASS)
            fail("base class " + d->bases[0]->str(), d->line);
        c->base = b->cls;
    }
    for (const cpp::DeclP &m : d->members)
    {
        switch (m->k)
        {
        case cpp::DK::Empty:
        case cpp::DK::StaticAssert:
            break;
        case cpp::DK::Var:
            if (m->isStatic)
            {
                // a static data member: a global named Class::member
                std::string g = c->name + "::" + m->var.name;
                c->statics[m->var.name] = g;
                auto copy = std::make_shared<cpp::Decl>(*m);
                copy->isStatic = false;
                globalVar(copy); // named Class::member (curNs_ is the class's), initialized from its scope
                break;
            }
            {
                Field f;
                f.name = m->var.name;
                f.type = typeOf(m->var.type, m->line);
                if (f.type->cat == C_CLASS && f.type->cls == c)
                    fail("class " + c->name + " contains itself", m->line);
                if (m->var.init == cpp::VarDeclarator::Brace)
                {
                    f.initBraced = true;
                    f.initArgs = m->var.args;
                }
                else if (!m->var.args.empty())
                {
                    f.init = m->var.args[0];
                    f.initArgs = m->var.args;
                }
                c->fields.push_back(f);
            }
            break;
        case cpp::DK::Func:
            if (m->isDeleted)
            {
                if (m->isCtor || (!m->name.empty() && m->name.back() == "operator="))
                    c->deletedCopy = true; // copying is not memberwise bytes
                break;
            }
            if (m->isTemplate)
            {
                // instantiated per call, for its arguments
                c->memberTemplates[m->isCtor ? "" : m->name.back()].push_back({m, c->name + "::"});
                break;
            }
            declareMethod(c, m);
            break;
        case cpp::DK::Alias:
        case cpp::DK::Class:
        case cpp::DK::Enum:
            break; // done above
        case cpp::DK::UsingDecl:
            if (m->inheritingCtor && c->base)
            {
                // using Base::Base: a constructor per base constructor, passing its arguments on
                for (Method *bc : c->base->ctors)
                {
                    if (bc->params.size() == 1 && bc->params[0]->cat == C_REF && bc->params[0]->elem->cat == C_CLASS &&
                        bc->params[0]->elem->cls == c->base)
                        continue; // copying and moving are the class's own
                    auto d = std::make_shared<cpp::Decl>();
                    d->k = cpp::DK::Func;
                    d->isCtor = true;
                    d->name = {c->name};
                    d->line = m->line;
                    d->file = m->file;
                    d->tu = m->tu;
                    d->isExplicit = bc->decl && bc->decl->isExplicit;
                    cpp::MemInit mi;
                    mi.name = c->base->name;
                    for (size_t i = 0; i < bc->params.size(); ++i)
                    {
                        cpp::Param pr;
                        pr.name = "__a" + std::to_string(i);
                        d->params.push_back(pr);
                        mi.args.push_back(keepExpr(mkName(pr.name, m->line)));
                    }
                    d->inits.push_back(mi);
                    auto body = std::make_shared<cpp::Stmt>();
                    body->k = cpp::SK::Block;
                    d->body = body;
                    keepAlive_.push_back(body);
                    Method *f = newMethod();
                    f->name = c->name;
                    f->owner = c;
                    f->bind = c->bind;
                    f->ns = c->name + "::";
                    f->isCtor = true;
                    f->ret = tVoid();
                    f->params = bc->params;
                    f->defaults = bc->defaults;
                    f->decl = d;
                    c->ctors.push_back(f);
                }
            }
            break; // using Base::member: the base's members are visible anyway
        default:
            fail("this class member (not yet)", m->line);
        }
    }
    layoutClass(c);
    declaring_.pop_back();
    curNs_ = savedNs;
    if (!redoPending_.empty())
        runRedos();
}

// a template argument whose layout is not final yet
bool Gen::incompleteArgs(const BindP &b)
{
    for (auto &kv : b->types)
    {
        NT t = kv.second;
        while (t && t->cat == C_ARRAY)
            t = t->elem;
        if (t && t->cat == C_CLASS && (!t->cls->laidOut || t->cls->redo))
            return true;
    }
    return false;
}

void Gen::runRedos()
{
    if (redoing_)
        return;
    redoing_ = true;
    for (bool progress = true; progress;)
    {
        progress = false;
        for (size_t i = 0; i < redoPending_.size(); ++i)
        {
            ClassInfo *c = redoPending_[i];
            if (!c->redo || incompleteArgs(c->redoBind))
                continue;
            std::string key = c->name, tmpl = c->templateKey;
            BindP b = c->redoBind;
            int variantN = c->variantN;
            ClassInfo fresh;
            fresh.name = key;
            *c = fresh; // complete = false: classDecl defines it again
            const cpp::DeclP &d = classTemplates_[tmpl];
            BindP saved = bind_;
            Method *savedCur = cur_;
            std::string savedNs = curNs_;
            int savedTu = curTu_;
            bind_ = b;
            cur_ = nullptr;
            curNs_ = templateNs_[tmpl];
            curTu_ = tuOf(d);
            classDecl(d, key);
            bind_ = saved;
            cur_ = savedCur;
            curNs_ = savedNs;
            curTu_ = savedTu;
            c->templateKey = tmpl;
            c->variantN = variantN;
            progress = true;
        }
    }
    std::vector<ClassInfo *> left;
    for (ClassInfo *c : redoPending_)
        if (c->redo)
            left.push_back(c);
    redoPending_ = left;
    redoing_ = false;
}

void Gen::enumDecl(const cpp::DeclP &d, const std::string &ns)
{
    std::string name = d->name.empty() ? "" : ns + joinName(d->name);
    Kind k = K_I32;
    if (d->underlying)
    {
        NT u = typeOf(d->underlying, d->line);
        if (u->cat != C_INT)
            fail("enum base type", d->line);
        k = u->kind;
    }
    if (!name.empty())
        enums_[name] = EnumInfo{k};
    int64_t next = 0;
    for (const auto &en : d->enumerators)
    {
        if (en.second)
            next = constInt(en.second);
        if (!name.empty())
            enumerators_[name + "::" + en.first] = {k, next};
        if (!d->scoped)
            enumerators_[ns + en.first] = {k, next};
        ++next;
    }
}

void Gen::layoutClass(ClassInfo *c)
{
    // virtual functions: the base's table, overriders in their slots, new ones appended
    if (c->base)
        c->vslots = c->base->vslots;
    auto place = [&](Method *f)
    {
        for (size_t i = 0; i < c->vslots.size(); ++i)
            if ((c->vslots[i]->isDtor && f->isDtor) ||
                (c->vslots[i]->name == f->name && c->vslots[i]->params.size() == f->params.size()))
            {
                f->isVirtual = true;
                f->vslot = (int)i;
                c->vslots[i] = f;
                return;
            }
        if (f->isVirtual)
        {
            f->vslot = (int)c->vslots.size();
            c->vslots.push_back(f);
        }
    };
    if (c->dtor)
        place(c->dtor);
    for (auto &kv : c->methods)
        for (Method *f : kv.second)
            place(f);
    c->polymorphic = !c->vslots.empty();
    if (c->polymorphic && c->base && !c->base->polymorphic)
        fail("class " + c->name + " adds virtual functions to a base without any (not yet)", 0);

    int off = 0;
    if (c->base)
    {
        off = c->base->size;
        c->align = c->base->align;
    }
    else if (c->polymorphic)
    {
        off = 8; // the vtable pointer
        c->align = 8;
    }
    for (Field &f : c->fields)
    {
        off = alignUp(off, alignOf(f.type));
        f.off = off;
        off += sizeOf(f.type);
        if (alignOf(f.type) > c->align)
            c->align = alignOf(f.type);
    }
    c->size = alignUp(off == 0 ? 1 : off, c->align);
    c->laidOut = true;
    if (c->polymorphic)
    {
        while (data.size() % 8)
            data.push_back('\0');
        // the 8 bytes before the table: the base class's table (0 for a root),
        // the chain dynamic_cast walks
        data.append(8, '\0');
        c->vtableOff = (int)data.size();
        if (c->base && c->base->polymorphic)
            dataPtrs.push_back({c->vtableOff - 8, c->base->vtableOff});
        data.append(8 * c->vslots.size(), '\0'); // filled once the code is placed
    }
    // destructors: a user one, or one generated to destroy members and the base
    bool memberDtors = c->base && c->base->needsDtor;
    for (const Field &f : c->fields)
        if (f.type->cat == C_CLASS && f.type->cls->needsDtor)
            memberDtors = true;
        else if (f.type->cat == C_ARRAY && f.type->elem->cat == C_CLASS && f.type->elem->cls->needsDtor)
            memberDtors = true;
    if (!c->dtor && (memberDtors || (c->base && c->base->dtor && c->base->dtor->isVirtual)))
    {
        Method *d = newMethod();
        d->name = "~" + c->name;
        d->owner = c;
        d->isDtor = true;
        d->ret = tVoid();
        c->dtor = d;
        place(d);
    }
    c->needsDtor = c->dtor != nullptr;
    implicitCopies(c);
    // the implicit default constructor: needed when there is anything to set
    if (noCtors(c))
    {
        bool work = c->polymorphic || (c->base && (c->base->implicitCtor || !noCtors(c->base)));
        for (const Field &f : c->fields)
        {
            NT el = f.type;
            while (el->cat == C_ARRAY)
                el = el->elem;
            if (f.init || f.initBraced || (el->cat == C_CLASS && (el->cls->implicitCtor || !noCtors(el->cls))))
                work = true;
        }
        if (work)
        {
            Method *m = newMethod();
            m->name = c->name;
            m->owner = c;
            m->isCtor = true;
            m->ret = tVoid();
            m->ns = c->name + "::"; // its member initializers are read in the class
            m->bind = c->bind;
            c->implicitCtor = m;
        }
    }
}

// Copying a class whose members (or base) have their own copy semantics:
// a copy constructor and operator= that copy member by member, unless the
// class declares its own
void Gen::implicitCopies(ClassInfo *c)
{
    auto isSelfRef = [&](Method *m)
    {
        return m->params.size() == 1 && m->params[0]->cat == C_REF && !m->params[0]->rvalue &&
               m->params[0]->elem->cat == C_CLASS && m->params[0]->elem->cls == c;
    };
    for (Method *m : c->ctors)
        if (isSelfRef(m))
            c->userCopyCtor = true;
    auto ops = c->methods.find("operator=");
    if (ops != c->methods.end())
        for (Method *m : ops->second)
            if (isSelfRef(m))
                c->userCopyAssign = true;
    bool members = c->base && c->base->nontrivialCopy;
    for (const Field &f : c->fields)
    {
        NT el = f.type;
        while (el->cat == C_ARRAY)
            el = el->elem;
        if (el->cat == C_CLASS && el->cls->nontrivialCopy)
            members = true;
    }
    bool userMove = false;
    for (Method *m : c->ctors)
        if (m->params.size() == 1 && m->params[0]->cat == C_REF && m->params[0]->rvalue &&
            m->params[0]->elem->cat == C_CLASS && m->params[0]->elem->cls == c)
            userMove = true;
    c->nontrivialCopy = c->userCopyCtor || c->userCopyAssign || members || c->deletedCopy || userMove;
    if (!members)
        return;
    int line = 0;
    auto src = [&]() { return keepExpr(mkName("__o", line)); };
    auto field = [&](const cpp::ExprP &obj, const std::string &name, bool arrow)
    {
        auto m = keepExpr(mkExpr(cpp::EK::Member, name, {obj}, line));
        m->arrow = arrow;
        return m;
    };
    auto thisExpr = [&]()
    {
        auto t = std::make_shared<cpp::Expr>();
        t->k = cpp::EK::This;
        t->line = line;
        return keepExpr(t);
    };
    if (!c->userCopyCtor)
    {
        auto d = std::make_shared<cpp::Decl>();
        d->k = cpp::DK::Func;
        d->isCtor = true;
        d->name = {c->name};
        cpp::Param pr;
        pr.name = "__o";
        d->params.push_back(pr);
        if (c->base)
        {
            cpp::MemInit mi;
            mi.name = c->base->name;
            mi.args = {src()};
            d->inits.push_back(mi);
        }
        for (const Field &f : c->fields)
        {
            cpp::MemInit mi;
            mi.name = f.name;
            mi.args = {field(src(), f.name, false)};
            d->inits.push_back(mi);
        }
        auto body = std::make_shared<cpp::Stmt>();
        body->k = cpp::SK::Block;
        d->body = body;
        keepAlive_.push_back(body);
        Method *m = newMethod();
        m->name = c->name;
        m->owner = c;
        m->bind = c->bind;
        m->ns = c->name + "::";
        m->isCtor = true;
        m->ret = tVoid();
        m->params = {tRef(tClass(c), true)};
        m->defaults = {nullptr};
        m->decl = d;
        c->copyCtor = m;
    }
    if (!c->userCopyAssign)
    {
        auto body = std::make_shared<cpp::Stmt>();
        body->k = cpp::SK::Block;
        keepAlive_.push_back(body);
        auto add = [&](cpp::ExprP e)
        {
            auto st = std::make_shared<cpp::Stmt>();
            st->k = cpp::SK::Expr;
            st->expr = e;
            body->body.push_back(st);
        };
        // the base part: its operator= if it has one, else its members
        for (ClassInfo *k = c; k; k = k->base)
        {
            if (k != c)
            {
                std::vector<Method *> baseOps;
                if (findMethod(k, "operator=", baseOps))
                {
                    auto callee = keepExpr(std::make_shared<cpp::Expr>());
                    callee->k = cpp::EK::Name;
                    callee->line = line;
                    std::string qualified = k->name;
                    callee->name = {qualified, "operator="};
                    add(keepExpr(mkExpr(cpp::EK::Call, "", {callee, src()}, line)));
                    break;
                }
            }
            for (const Field &f : k->fields)
                add(keepExpr(mkExpr(cpp::EK::Assign, "=", {field(thisExpr(), f.name, true), field(src(), f.name, false)}, line)));
        }
        auto ret = std::make_shared<cpp::Stmt>();
        ret->k = cpp::SK::Return;
        ret->expr = keepExpr(mkExpr(cpp::EK::Unary, "*", {thisExpr()}, line));
        body->body.push_back(ret);
        auto d = std::make_shared<cpp::Decl>();
        d->k = cpp::DK::Func;
        d->name = {"operator="};
        cpp::Param pr;
        pr.name = "__o";
        d->params.push_back(pr);
        d->body = body;
        Method *m = newMethod();
        m->name = "operator=";
        m->owner = c;
        m->bind = c->bind;
        m->ns = c->name + "::";
        m->ret = tRef(tClass(c), false);
        m->params = {tRef(tClass(c), true)};
        m->defaults = {nullptr};
        m->decl = d;
        c->copyAssign = m;
        c->methods["operator="].push_back(m);
    }
    // moving: member by member (std::move of each class member), unless the
    // class declares its own copying or moving
    if (c->userCopyCtor || c->userCopyAssign || userMove)
        return;
    auto moved = [&](const cpp::ExprP &x, const NT &t)
    {
        if (t->cat != C_CLASS)
            return x;
        auto mv = keepExpr(mkName("move", line));
        mv->name = {"std", "move"};
        return keepExpr(mkExpr(cpp::EK::Call, "", {mv, x}, line));
    };
    {
        auto d = std::make_shared<cpp::Decl>();
        d->k = cpp::DK::Func;
        d->isCtor = true;
        d->name = {c->name};
        cpp::Param pr;
        pr.name = "__o";
        d->params.push_back(pr);
        if (c->base)
        {
            cpp::MemInit mi;
            mi.name = c->base->name;
            mi.args = {moved(src(), tClass(c->base))};
            d->inits.push_back(mi);
        }
        for (const Field &f : c->fields)
        {
            cpp::MemInit mi;
            mi.name = f.name;
            mi.args = {moved(field(src(), f.name, false), f.type)};
            d->inits.push_back(mi);
        }
        auto body = std::make_shared<cpp::Stmt>();
        body->k = cpp::SK::Block;
        d->body = body;
        keepAlive_.push_back(body);
        Method *m = newMethod();
        m->name = c->name;
        m->owner = c;
        m->bind = c->bind;
        m->ns = c->name + "::";
        m->isCtor = true;
        m->ret = tVoid();
        m->params = {tRef(tClass(c), false, true)};
        m->defaults = {nullptr};
        m->decl = d;
        c->moveCtor = m;
    }
    {
        auto body = std::make_shared<cpp::Stmt>();
        body->k = cpp::SK::Block;
        keepAlive_.push_back(body);
        for (ClassInfo *k = c; k; k = k->base)
            for (const Field &f : k->fields)
            {
                auto st = std::make_shared<cpp::Stmt>();
                st->k = cpp::SK::Expr;
                st->expr = keepExpr(mkExpr(cpp::EK::Assign, "=",
                                           {field(thisExpr(), f.name, true), moved(field(src(), f.name, false), f.type)},
                                           line));
                body->body.push_back(st);
            }
        auto ret = std::make_shared<cpp::Stmt>();
        ret->k = cpp::SK::Return;
        ret->expr = keepExpr(mkExpr(cpp::EK::Unary, "*", {thisExpr()}, line));
        body->body.push_back(ret);
        auto d = std::make_shared<cpp::Decl>();
        d->k = cpp::DK::Func;
        d->name = {"operator="};
        cpp::Param pr;
        pr.name = "__o";
        d->params.push_back(pr);
        d->body = body;
        Method *m = newMethod();
        m->name = "operator=";
        m->owner = c;
        m->bind = c->bind;
        m->ns = c->name + "::";
        m->ret = tRef(tClass(c), false);
        m->params = {tRef(tClass(c), false, true)};
        m->defaults = {nullptr};
        m->decl = d;
        c->moveAssign = m;
        c->methods["operator="].push_back(m);
    }
}

ClassInfo *Gen::instantiateClass(const std::string &name, const std::vector<cpp::TArg> &targs, int line)
{
    const cpp::DeclP &d = classTemplates_[name];
    auto bind = std::make_shared<Binding>();
    std::string key = name + "<";
    for (size_t i = 0; i < d->templateParams.size(); ++i)
    {
        const std::string &p = d->templateParams[i];
        if (i >= targs.size())
        {
            // a default argument, read with the earlier arguments bound
            const cpp::TArg *df = i < d->templateDefaults.size() ? &d->templateDefaults[i] : nullptr;
            if (!df || (!df->type && !df->expr))
                fail("template " + name + " needs " + std::to_string(d->templateParams.size()) + " arguments", line);
            BindP saved = bind_;
            std::string savedNs = curNs_;
            bind_ = bind;
            curNs_ = templateNs_[name];
            if (i)
                key += ",";
            if (df->type)
            {
                bind->types[p] = typeOf(df->type, line);
                key += typeKey(bind->types[p]);
            }
            else
            {
                bind->values[p] = constInt(df->expr);
                key += std::to_string(bind->values[p]);
            }
            bind_ = saved;
            curNs_ = savedNs;
            continue;
        }
        if (i)
            key += ",";
        if (targs[i].type)
        {
            // a name that is a value (a template's own N) parses as a type
            const cpp::TypeNameP &tt = targs[i].type;
            if (bind_ && tt->name.size() == 1 && bind_->values.count(tt->name[0]))
            {
                bind->values[p] = bind_->values[tt->name[0]];
                key += std::to_string(bind->values[p]);
                continue;
            }
            NT t = typeOf(tt, line);
            bind->types[p] = t;
            key += typeKey(t);
        }
        else
        {
            bind->values[p] = constInt(targs[i].expr);
            key += std::to_string(bind->values[p]);
        }
    }
    key += ">";
    return instantiateBound(name, bind, key, line);
}

ClassInfo *Gen::instantiateBound(const std::string &name, const BindP &bind, const std::string &key, int line)
{
    auto it = classes_.find(key);
    if (it != classes_.end())
        return it->second.get();
    const cpp::DeclP &d = classTemplates_[name];
    BindP saved = bind_;
    Method *savedCur = cur_;
    std::string savedNs = curNs_;
    int savedTu = curTu_;
    bind_ = bind;
    cur_ = nullptr;
    curNs_ = templateNs_[name];
    curTu_ = tuOf(d);
    classDecl(d, key);
    bind_ = saved;
    cur_ = savedCur;
    curNs_ = savedNs;
    curTu_ = savedTu;
    ClassInfo *c = classes_[key].get();
    c->templateKey = name;
    if (incompleteArgs(bind))
    {
        c->redo = true;
        c->redoBind = bind;
        redoPending_.push_back(c);
    }
    return c;
}

// std::variant<A, B, ...>: <variant>'s std::__variant with A, B, ... first,
// __none for the rest, and room for the largest
ClassInfo *Gen::variantClass(const std::vector<cpp::TArg> &targs, int line)
{
    const std::string name = "std::__variant";
    const cpp::DeclP &d = classTemplates_[name];
    int maxAlts = (int)d->templateParams.size() - 1;
    if ((int)targs.size() > maxAlts || targs.empty())
        fail("std::variant of " + std::to_string(targs.size()) + " alternatives (at most " +
                 std::to_string(maxAlts) + ")",
             line);
    ClassInfo *none = findClass({"std", "__none"});
    auto bind = std::make_shared<Binding>();
    std::string key = "std::variant<";
    int words = 1;
    for (int i = 0; i < maxAlts; ++i)
    {
        NT t;
        if (i < (int)targs.size())
        {
            if (!targs[i].type)
                fail("a std::variant alternative that is not a type", line);
            t = typeOf(targs[i].type, line);
            key += (i ? "," : "") + typeKey(t);
            int w = (sizeOf(t) + 7) / 8;
            if (w > words)
                words = w;
        }
        else
            t = tClass(none);
        bind->types[d->templateParams[i]] = t;
    }
    bind->values[d->templateParams[maxAlts]] = words;
    key += ">";
    ClassInfo *c = instantiateBound(name, bind, key, line);
    c->variantN = (int)targs.size();
    return c;
}

// std::function<R(A...)>: <functional>'s std::__functionN<R, A...>
ClassInfo *Gen::functionClass(const cpp::TypeNameP &sig, int line)
{
    std::vector<cpp::TypeNameP> ps = sig->params;
    if (ps.size() == 1 && ps[0]->name.size() == 1 && ps[0]->name[0] == "void" && ps[0]->pointers == 0)
        ps.clear(); // R(void)
    std::string name = "std::__function" + std::to_string(ps.size());
    if (!classTemplates_.count(name))
        fail("std::function with " + std::to_string(ps.size()) + " parameters (include <functional>)", line);
    const cpp::DeclP &d = classTemplates_[name];
    auto bind = std::make_shared<Binding>();
    NT r = sig->ret ? typeOf(sig->ret, line) : tVoid();
    bind->types[d->templateParams[0]] = r;
    std::string key = "std::function<" + typeKey(r) + "(";
    for (size_t i = 0; i < ps.size(); ++i)
    {
        NT t = typeOf(ps[i], line);
        bind->types[d->templateParams[i + 1]] = t;
        key += (i ? "," : "") + typeKey(t);
    }
    key += ")>";
    return instantiateBound(name, bind, key, line);
}

NT Gen::variantAlt(ClassInfo *vc, int i)
{
    return vc->bind->types[classTemplates_["std::__variant"]->templateParams[i]];
}

// std::get / get_if / holds_alternative / visit of a variant
NT Gen::variantCall(const std::string &fn, const cpp::ExprP &callee, const std::vector<cpp::ExprP> &args,
                    ClassInfo *vc, int line, const ThisSrc *result)
{
    int iOff = 0, sOff = 0;
    findField(vc, "__i", iOff);
    findField(vc, "__s", sOff);
    int n = vc->variantN;
    if (fn == "visit")
    {
        if (args.size() != 2)
            fail("std::visit of " + std::to_string(args.size() - 1) + " variants (one so far)", line);
        NT ft = typeOfExpr(args[0]);
        if (ft->cat == C_REF)
            ft = ft->elem;
        if (ft->cat != C_CLASS)
            fail("std::visit with a visitor that is not an object", line);
        ClassInfo *fc = ft->cls;
        int fslot = newSlot(tPtr(ft)), vslot = newSlot(tPtr(tClass(vc))), sslot = newSlot(tPtr(tVoid()));
        if (args[0]->k == cpp::EK::Lambda)
            expr(args[0]);
        else
            addr(args[0]);
        a.store(fslot, RAX);
        addr(args[1]);
        a.store(vslot, RAX);
        if (sOff)
            a.addImm(RAX, sOff);
        a.store(sslot, RAX);
        ThisSrc self;
        self.kind = TH_INDIRECT;
        self.off = fslot;
        // each alternative: a hidden reference to the storage, as that type
        scopes_.emplace_back();
        int id = ++visitCount_;
        NT R;
        ThisSrc res;
        int resSlot = 0;
        int end = a.newLabel();
        for (int i = 0; i < n; ++i)
        {
            std::string vn = "__visit" + std::to_string(id) + "_" + std::to_string(i);
            Var v;
            v.type = tRef(variantAlt(vc, i), false);
            v.off = sslot;
            scopes_.back().vars[vn] = v;
            cpp::ExprP argE = keepExpr(mkName(vn, line));
            std::vector<cpp::ExprP> one = {argE};
            std::vector<Method *> cands;
            findMethod(fc, "operator()", cands);
            templateMembers(fc, "operator()", one, {}, false, line, cands);
            if (cands.empty())
                fail("std::visit: the visitor has no operator()", line);
            Method *m = resolve(cands, one, "the visitor", line);
            if (!m->ret)
                deduceReturn(m);
            if (!R)
            {
                R = m->ret;
                if (R->cat == C_CLASS)
                {
                    if (result)
                        res = *result;
                    else
                    {
                        resSlot = newSlot(R);
                        res.kind = TH_LOCAL;
                        res.off = resSlot;
                    }
                }
                else if (R->cat != C_VOID)
                    resSlot = newSlot(tInt(K_I64));
            }
            int next = a.newLabel();
            a.load(RCX, vslot);
            if (iOff)
                a.addImm(RCX, iOff);
            a.loadRcx(8, false);
            a.movImm(RCX, i);
            a.alu(0x39, RAX, RCX);
            a.jcc(CC_NE, next);
            callMethod(m, self, one, false, line, R->cat == C_CLASS ? &res : nullptr);
            if (R->cat != C_CLASS && R->cat != C_VOID)
                a.store(resSlot, RAX);
            a.jmp(end);
            a.bind(next);
        }
        a.bind(end);
        scopes_.pop_back();
        if (R->cat == C_CLASS)
        {
            if (result)
            {
                loadThis(res);
                return R;
            }
            if (R->cls->needsDtor)
                addTemp(resSlot, R->cls);
            a.lea(RAX, resSlot);
            return R;
        }
        if (R->cat != C_VOID)
            a.load(RAX, resSlot);
        return R;
    }
    // the alternative named by the template argument (a type or an index)
    if (!callee->hasTargs || callee->targs.size() != 1)
        fail("std::" + fn + " needs one template argument", line);
    int which = -1;
    const cpp::TArg &ta = callee->targs[0];
    if (ta.type && !(bind_ && ta.type->name.size() == 1 && bind_->values.count(ta.type->name[0])))
    {
        NT want = typeOf(ta.type, line);
        for (int i = 0; i < n; ++i)
            if (sameType(variantAlt(vc, i), want))
                which = i;
    }
    else
        which = ta.type ? (int)bind_->values[ta.type->name[0]] : (int)constInt(ta.expr);
    if (which < 0 || which >= n)
        fail("std::" + fn + ": not one of the variant's alternatives", line);
    NT alt = variantAlt(vc, which);
    if (fn == "get")
    {
        addr(args[0]);
        if (sOff)
            a.addImm(RAX, sOff);
        return tRef(alt, false);
    }
    if (fn == "holds_alternative")
    {
        addr(args[0]);
        a.movRR(RCX, RAX);
        if (iOff)
            a.addImm(RCX, iOff);
        a.loadRcx(8, false);
        a.movImm(RCX, which);
        a.alu(0x39, RAX, RCX);
        a.setcc(CC_E);
        return tInt(K_BOOL);
    }
    // get_if(&v): the alternative's address, or null
    expr(args[0]);
    int zero = a.newLabel(), done = a.newLabel();
    a.test(RAX, RAX);
    a.jcc(CC_E, zero);
    a.movRR(RDX, RAX);
    a.movRR(RCX, RAX);
    if (iOff)
        a.addImm(RCX, iOff);
    a.loadRcx(8, false);
    a.movImm(RCX, which);
    a.alu(0x39, RAX, RCX);
    a.jcc(CC_NE, zero);
    a.movRR(RAX, RDX);
    if (sOff)
        a.addImm(RAX, sOff);
    a.jmp(done);
    a.bind(zero);
    a.movImm(RAX, 0);
    a.bind(done);
    return tPtr(alt);
}

Method *Gen::makeFunction(const cpp::DeclP &d, const BindP &bind, const std::string &ns)
{
    BindP saved = bind_;
    std::string savedNs = curNs_;
    bind_ = bind;
    curNs_ = ns;
    Method *f = newMethod();
    f->name = ns + d->name.back();
    f->ns = ns;
    f->ret = typeOf(d->ret, d->line);
    forwarding_ = true;
    for (const cpp::Param &pr : d->params)
    {
        NT pt = typeOf(pr.type, d->line);
        if (pt->cat == C_ARRAY)
            pt = tPtr(pt->elem);
        f->params.push_back(pt);
        f->defaults.push_back(pr.def);
    }
    forwarding_ = false;
    f->decl = d;
    f->bind = bind;
    bind_ = saved;
    curNs_ = savedNs;
    return f;
}

// A function template's instance for these arguments (null: they don't fit)
Method *Gen::instantiateFunc(const cpp::DeclP &d, int which, const std::vector<cpp::ExprP> &args,
                             const std::vector<cpp::TArg> &targs, bool explicitArgs, int line, ClassInfo *owner,
                             const std::string &ownerNs)
{
    auto bind = std::make_shared<Binding>();
    if (owner && owner->bind)
        *bind = *owner->bind; // a member template also sees its class's arguments
    const std::vector<std::string> &ps = d->templateParams;
    if (explicitArgs)
        for (size_t i = 0; i < targs.size() && i < ps.size(); ++i)
        {
            if (targs[i].type)
                bind->types[ps[i]] = typeOf(targs[i].type, line);
            else
                bind->values[ps[i]] = constInt(targs[i].expr);
        }
    if (args.size() > d->params.size())
        return nullptr;
    // deduction: a parameter written T, T*, const T& ... takes T from its argument
    for (size_t i = 0; i < args.size(); ++i)
    {
        const cpp::TypeNameP &pt = d->params[i].type;
        if (pt && pt->hasTargs && !pt->targs.empty() && pt->pointers == 0 && pt->name.back() == "initializer_list" &&
            args[i]->k == cpp::EK::InitList && !args[i]->kids.empty() && pt->targs.back().size() == 1 &&
            pt->targs.back()[0].type && pt->targs.back()[0].type->name.size() == 1)
        {
            // initializer_list<T> from {a, b, ...}: T is a's type
            const std::string &tn = pt->targs.back()[0].type->name[0];
            if (!bind->types.count(tn))
            {
                NT et = typeOfExpr(args[i]->kids[0]);
                if (et->cat == C_REF)
                    et = et->elem;
                if (et->cat == C_ARRAY)
                    et = tPtr(et->elem);
                bind->types[tn] = et;
            }
            continue;
        }
        if (pt && pt->hasTargs && !pt->targs.empty() && pt->pointers == 0)
        {
            // X<U> from an argument that is an instance of the template X
            NT at = typeOfExpr(args[i]);
            if (at->cat == C_REF)
                at = at->elem;
            if (at->cat != C_CLASS || !at->cls->bind || at->cls->templateName != pt->name.back() ||
                !classTemplates_.count(at->cls->templateKey))
                continue;
            const std::vector<std::string> &tps = classTemplates_[at->cls->templateKey]->templateParams;
            const std::vector<cpp::TArg> &tas = pt->targs.back();
            for (size_t j = 0; j < tas.size() && j < tps.size(); ++j)
            {
                std::string tn;
                if (tas[j].type && tas[j].type->name.size() == 1 && !tas[j].type->hasTargs)
                    tn = tas[j].type->name[0];
                else if (tas[j].expr && tas[j].expr->k == cpp::EK::Name && tas[j].expr->name.size() == 1)
                    tn = tas[j].expr->name[0];
                else
                    continue;
                bool isParam = false;
                for (const std::string &q : ps)
                    if (q == tn)
                        isParam = true;
                if (!isParam || bind->types.count(tn) || bind->values.count(tn))
                    continue;
                if (at->cls->bind->types.count(tps[j]))
                    bind->types[tn] = at->cls->bind->types[tps[j]];
                else if (at->cls->bind->values.count(tps[j]))
                    bind->values[tn] = at->cls->bind->values[tps[j]]; // a value parameter (duration<R, N, D>)
            }
            continue;
        }
        if (!pt || pt->name.size() != 1 || pt->hasTargs)
            continue;
        const std::string &tn = pt->name[0];
        bool isParam = false;
        for (const std::string &p : ps)
            if (p == tn)
                isParam = true;
        if (!isParam || bind->types.count(tn))
            continue;
        NT at = typeOfExpr(args[i]);
        if (at->cat == C_REF)
            at = at->elem;
        for (int k = 0; k < pt->pointers; ++k)
        {
            if (at->cat != C_PTR)
                return nullptr;
            at = at->elem;
        }
        if (at->cat == C_INT && args[i]->k == cpp::EK::Char && pt->pointers == 0)
            at = tInt(K_I8);
        if (pt->rref && pt->pointers == 0 && args[i]->k != cpp::EK::Str && !isRvalue(args[i], typeOfExpr(args[i])))
            at = tRef(at, false); // a forwarding reference given an lvalue: T is X&
        bind->types[tn] = at;
    }
    // _RequireInputIter: a parameter named __InputIt takes no number (the
    // library's (first, last) templates stay out of (count, value) calls)
    for (const std::string &p : ps)
        if (p.rfind("__InputIt", 0) == 0 && bind->types.count(p) && bind->types[p]->cat == C_INT)
            return nullptr;
    std::string key = d->name[0] + "<";
    for (const std::string &p : ps)
    {
        if (bind->types.count(p))
            key += typeKey(bind->types[p]) + ",";
        else if (bind->values.count(p))
            key += std::to_string(bind->values[p]) + ",";
        else
            return nullptr; // not deducible from these arguments
    }
    key += ">#" + d->name.back() + "#" + std::to_string(which); // which template of that name
    if (owner)
    {
        std::map<std::string, Method *> &known = memberInstances_[d.get()];
        auto mi = known.find(owner->name + "|" + key);
        if (mi != known.end())
            return mi->second;
        Method *f = makeMember(owner, d, bind, ownerNs);
        f->fromTemplate = true;
        known[owner->name + "|" + key] = f;
        return f;
    }
    auto it = funcInstances_.find(key);
    if (it != funcInstances_.end())
        return it->second;
    Method *f = makeFunction(d, bind, declNs_[d.get()]);
    f->fromTemplate = true;
    funcInstances_[key] = f;
    return f;
}

// A member template's instance: like declareMethod, with the instance's binding
Method *Gen::makeMember(ClassInfo *c, const cpp::DeclP &d, const BindP &bind, const std::string &ns)
{
    BindP saved = bind_;
    std::string savedNs = curNs_;
    bind_ = bind;
    curNs_ = ns;
    Method *f = newMethod();
    f->name = d->isCtor ? c->name : d->name.back();
    f->owner = c;
    f->bind = bind;
    f->ns = ns;
    f->decl = d;
    f->isStatic = d->isStatic;
    f->isCtor = d->isCtor;
    declaring_.push_back(c); // its own (injected) name means c
    if (d->isCtor)
        f->ret = tVoid();
    else if (d->ret && !(d->ret->isAuto() && !d->ret->decltypeOf))
        f->ret = typeOf(d->ret, d->line); // else deduced from its returns
    forwarding_ = true;
    for (const cpp::Param &pr : d->params)
    {
        NT pt = typeOf(pr.type, d->line);
        if (pt->cat == C_ARRAY)
            pt = tPtr(pt->elem);
        f->params.push_back(pt);
        f->defaults.push_back(pr.def);
    }
    forwarding_ = false;
    declaring_.pop_back();
    bind_ = saved;
    curNs_ = savedNs;
    return f;
}

// The instances of c's (and its bases') member templates named `name` ("":
// constructors) that these arguments fit, added to out
void Gen::templateMembers(ClassInfo *c, const std::string &name, const std::vector<cpp::ExprP> &args,
                          const std::vector<cpp::TArg> &targs, bool explicitArgs, int line,
                          std::vector<Method *> &out)
{
    for (ClassInfo *k = c; k; k = name.empty() ? nullptr : k->base)
    {
        auto it = k->memberTemplates.find(name);
        if (it == k->memberTemplates.end())
            continue;
        for (const auto &mt : it->second)
            if (Method *m = instantiateFunc(mt.first, 0, args, targs, explicitArgs, line, k, mt.second))
                out.push_back(m);
    }
}

// The functions a call by name may mean: the plain ones and template instances
std::vector<Method *> Gen::functionCands(const std::string &nameIn, const std::vector<cpp::ExprP> &args,
                                         const cpp::ExprP &callee, int line)
{
    std::vector<Method *> cands;
    bool explicitArgs = callee && callee->hasTargs;
    // the qualified name it means (callee's parts, or the plain name)
    std::string name;
    if (callee && callee->global)
    {
        // ::f: the global namespace's f only (no enclosing namespace, no ADL)
        std::string full = joinName(callee->name);
        if (funcs_.count(full) || funcTemplates_.count(full))
            name = full;
    }
    else
        name = findFunc(callee ? callee->name : std::vector<std::string>{nameIn});
    // argument-dependent lookup: also the namespaces of class arguments
    std::vector<std::string> extra;
    if (callee == nullptr || (callee->name.size() == 1 && !callee->global))
        for (const cpp::ExprP &x : args)
        {
            NT t = typeOfExpr(x);
            if (t->cat == C_REF || t->cat == C_PTR)
                t = t->elem;
            if (t->cat == C_CLASS)
            {
                const std::string &cn = t->cls->templateName.empty() ? t->cls->name : t->cls->name.substr(0, t->cls->name.find('<'));
                size_t at = cn.rfind("::");
                if (at != std::string::npos)
                    extra.push_back(cn.substr(0, at + 2) + nameIn);
            }
        }
    if (name.empty())
        for (const std::string &k : extra)
            if (funcs_.count(k) || funcTemplates_.count(k))
                name = k;
    if (name.empty())
        return cands;
    // the same scope's TU-local twin (an anonymous namespace / static f
    // overloads the enclosing namespace's f)
    std::vector<std::string> keys = {name};
    {
        std::string tu = tuNs(curTu_);
        size_t at = name.find(tu);
        if (at != std::string::npos)
            keys.push_back(name.substr(0, at) + name.substr(at + tu.size()));
        else
        {
            size_t last = name.rfind("::");
            keys.push_back(last == std::string::npos ? tu + name : name.substr(0, last + 2) + tu + name.substr(last + 2));
        }
    }
    for (const std::string &key : keys)
    {
        if (!explicitArgs)
        {
            auto it = funcs_.find(key);
            if (it != funcs_.end())
                cands.insert(cands.end(), it->second.begin(), it->second.end());
        }
        auto t = funcTemplates_.find(key);
        if (t != funcTemplates_.end())
            for (size_t i = 0; i < t->second.size(); ++i)
            {
                std::vector<cpp::TArg> none;
                Method *m = instantiateFunc(t->second[i], (int)i, args, callee ? callee->targs : none, explicitArgs, line);
                if (m)
                    cands.push_back(m);
            }
    }
    return cands;
}

// ─── Program ───────────────────────────────────────────────────────────────

void Gen::declareAll(const std::vector<cpp::DeclP> &decls, const std::string &ns,
                     std::vector<std::pair<cpp::DeclP, std::string>> &outOfClass)
{
    std::string savedNs = curNs_;
    curNs_ = ns;
    for (const cpp::DeclP &d : decls)
    {
        at(d);
        curTu_ = tuOf(d);
        switch (d->k)
        {
        case cpp::DK::Namespace:
            declareAll(d->decls,
                       d->anonymous ? (tuLocal(d) ? ns + tuNs(d->tu) : ns) : ns + joinName(d->name) + "::",
                       outOfClass);
            curNs_ = ns;
            break;
        case cpp::DK::Class:
        {
            std::string key = ns + joinName(d->name);
            if (d->isTemplate)
            {
                if (!d->forwardOnly)
                {
                    classTemplates_[key] = d;
                    templateNs_[key] = ns;
                }
                break;
            }
            if (d->forwardOnly)
            {
                // `class X;` declares ns::X (an X elsewhere is another class)
                if (!classes_.count(key))
                {
                    auto info = std::make_unique<ClassInfo>();
                    info->name = key;
                    classes_[key] = std::move(info);
                }
                break;
            }
            classDecl(d);
            break;
        }
        case cpp::DK::Enum:
            enumDecl(d, ns);
            break;
        case cpp::DK::Alias:
            aliases_[ns + d->name.back()] = Alias{d->aliased, ns, nullptr};
            break;
        case cpp::DK::UsingDirective:
        {
            std::string u = joinName(d->name);
            bool have = false;
            std::vector<std::string> &into = tuLocal(d) ? tuUsings_[d->tu] : usings_;
            for (const std::string &x : into)
                if (x == u)
                    have = true;
            if (!have)
                into.push_back(u);
            break;
        }
        case cpp::DK::UsingDecl:
            if (!d->name.empty())
            {
                std::vector<std::string> target = d->name;
                if (!target.empty() && target[0].empty())
                    target.erase(target.begin());
                if (ns.empty())
                    usingDecls_[d->name.back()] = joinName(target);
                else
                    usingAlias_[ns + d->name.back()] = joinName(target);
            }
            break;
        case cpp::DK::Func:
        {
            if (d->isTemplate)
            {
                if (d->name.size() != 1)
                    fail("a member template defined outside its class (not yet)", d->line);
                if (d->body)
                {
                    std::string tk = ns + (d->isStatic && tuLocal(d) ? tuNs(d->tu) : std::string()) + d->name[0];
                    funcTemplates_[tk].push_back(d);
                    declNs_[d.get()] = ns;
                }
                break;
            }
            if (d->name.size() >= 2)
            {
                outOfClass.push_back({d, ns}); // Class::member defined outside the class
                break;
            }
            if (d->name[0].rfind("__native_", 0) == 0)
                break; // a builtin (lib/native declares them)
            if (d->variadic)
                fail("variadic function " + d->name[0], d->line);
            // a static function is its TU's own
            std::string key = ns + (d->isStatic && tuLocal(d) ? tuNs(d->tu) : std::string()) + d->name[0];
            Method tmp;
            tmp.ret = typeOf(d->ret, d->line);
            for (const cpp::Param &pr : d->params)
            {
                NT pt = typeOf(pr.type, d->line);
                if (pt->cat == C_ARRAY)
                    pt = tPtr(pt->elem);
                tmp.params.push_back(pt);
                tmp.defaults.push_back(pr.def);
            }
            Method *same = nullptr;
            for (Method *f : funcs_[key])
            {
                bool eq = f->params.size() == tmp.params.size();
                for (size_t i = 0; eq && i < tmp.params.size(); ++i)
                    eq = sameType(f->params[i], tmp.params[i]);
                if (eq)
                    same = f;
            }
            if (same)
            {
                if (d->body)
                {
                    if (same->decl && same->decl->body)
                        fail("function " + key + " defined twice", d->line);
                    same->decl = d;
                    for (size_t i = 0; i < tmp.defaults.size(); ++i)
                        if (tmp.defaults[i])
                            same->defaults[i] = tmp.defaults[i];
                }
                break;
            }
            Method *f = newMethod();
            f->name = key;
            f->ns = ns;
            f->ret = tmp.ret;
            f->params = tmp.params;
            f->defaults = tmp.defaults;
            f->decl = d;
            if (ns.rfind("__dll_", 0) == 0 && !d->body)
                f->dll = ns.substr(6, ns.find("::") - 6) + ".dll"; // a Windows API function
            funcs_[key].push_back(f);
            break;
        }
        case cpp::DK::Var:
            if (d->name.size() >= 2)
            {
                outOfClass.push_back({d, ns}); // int Class::count = 0;
                break;
            }
            if (d->isStatic && tuLocal(d))
            {
                curNs_ = ns + tuNs(d->tu); // a static variable: its TU's own
                globalVar(d);
                curNs_ = ns;
                break;
            }
            globalVar(d);
            break;
        case cpp::DK::Empty:
        case cpp::DK::StaticAssert:
            break;
        default:
            fail("this declaration (not yet)", d->line);
        }
    }
    curNs_ = savedNs;
}

int Gen::importIndex(const std::string &dll, const std::string &name)
{
    for (int i = 0; i < (int)imports.size(); ++i)
        if (imports[i].dll == dll && imports[i].name == name)
            return i;
    imports.push_back({dll, name});
    return (int)imports.size() - 1;
}

int Gen::routine(const std::string &name)
{
    auto it = runtime_.find(name);
    if (it != runtime_.end())
        return it->second;
    int l = a.newLabel();
    runtime_[name] = l;
    if (name == "puts")
        routine("putchar");
    return l;
}

int Gen::stringData(const std::string &bytes)
{
    int off = (int)data.size();
    data += bytes;
    data.push_back('\0');
    return off;
}

void Gen::program(const cpp::Program &p)
{
    // the exception state: four 8-byte globals
    while (data.size() % 8)
        data.push_back('\0');
    ehTop_ = (int)data.size();
    ehObj_ = ehTop_ + 8;
    ehType_ = ehTop_ + 16;
    ehDtor_ = ehTop_ + 24;
    data.append(32, '\0');
    // types and every function first, so a call may come before the definition
    std::vector<std::pair<cpp::DeclP, std::string>> outOfClass;
    declareAll(p.decls, "", outOfClass);
    {
        // `name(args)` with a bare name the parser takes for a std type (list,
        // set, function, ...) but the program declares as a function: a call
        std::set<std::string> funcNames, typeNames;
        auto last = [](const std::string &k)
        {
            size_t lt = k.find('<');
            std::string b = lt == std::string::npos ? k : k.substr(0, lt);
            size_t at = b.rfind("::");
            return at == std::string::npos ? b : b.substr(at + 2);
        };
        for (const auto &f : funcs_)
            funcNames.insert(last(f.first));
        for (const auto &f : funcTemplates_)
            funcNames.insert(last(f.first));
        // types a bare name can mean: the global ones (std::less is written
        // qualified unless a using-directive brings it in)
        auto bare = [](const std::string &k) { return k.find("::") == std::string::npos; };
        for (const auto &c : classes_)
        {
            if (bare(c.first))
                typeNames.insert(last(c.first));
            for (const auto &m : c.second->methods)
                funcNames.insert(m.first);
            for (const auto &m : c.second->memberTemplates)
                funcNames.insert(m.first);
        }
        for (const auto &c : classTemplates_)
            if (bare(c.first))
                typeNames.insert(last(c.first));
        for (const auto &al : aliases_)
            if (bare(al.first))
                typeNames.insert(last(al.first));
        for (const auto &en : enums_)
            if (bare(en.first))
                typeNames.insert(last(en.first));
        for (const cpp::DeclP &d : p.decls)
            callsNamedLikeTypes(d, funcNames, typeNames);
    }
    // out-of-class definitions: the body of a declared member
    for (const auto &oc : outOfClass)
    {
        const cpp::DeclP &d = oc.first;
        curNs_ = oc.second;
        curTu_ = tuOf(d);
        std::vector<std::string> owner(d->name.begin(), d->name.end() - 1);
        ClassInfo *c = findClass(owner);
        if (!c)
        {
            // ns::f defined outside its namespace
            std::string key = findFunc(d->name);
            if (d->k == cpp::DK::Func && !key.empty())
            {
                for (Method *f : funcs_[key])
                    if (f->params.size() == d->params.size() && (!f->decl || !f->decl->body))
                    {
                        f->decl = d;
                        break;
                    }
                continue;
            }
            fail("unknown class " + joinName(owner), d->line);
        }
        const std::string member = d->name.back();
        curNs_ = c->name + "::"; // the rest of a member's declaration is in the class's scope
        if (d->k == cpp::DK::Var)
        {
            auto st = c->statics.find(member);
            if (st == c->statics.end())
                fail(member + " is not a static member of " + c->name, d->line);
            Var &g = globals_[st->second];
            const cpp::VarDeclarator &v = d->var;
            auto queued = staticCtor_.find(st->second);
            if (queued != staticCtor_.end())
            {
                // an object built at startup: the definition gives its arguments
                globalCtorInits_[queued->second].second = d;
                globalCtorNs_[queued->second] = c->name + "::";
                continue;
            }
            if (!v.args.empty())
            {
                cpp::ExprP init = v.args[0];
                if (v.init == cpp::VarDeclarator::Brace || v.args.size() > 1)
                {
                    auto list = std::make_shared<cpp::Expr>();
                    keepExprs_.push_back(list);
                    list->k = cpp::EK::InitList;
                    list->kids = v.args;
                    init = list;
                }
                constInit(g.off, g.type, init, d->line);
            }
            continue;
        }
        std::vector<Method *> cands;
        std::string plain = c->templateName.empty() ? c->name.substr(c->name.rfind("::") == std::string::npos ? 0 : c->name.rfind("::") + 2) : c->templateName;
        if (d->isCtor || member == plain)
            cands = c->ctors;
        else if (d->isDtor || member[0] == '~')
            cands = {c->dtor};
        else
            cands = c->methods[member];
        Method *target = nullptr;
        for (Method *f : cands)
        {
            if (!f || f->params.size() != d->params.size())
                continue;
            bool eq = true;
            for (size_t i = 0; eq && i < d->params.size(); ++i)
            {
                NT pt = typeOf(d->params[i].type, d->line);
                if (pt->cat == C_ARRAY)
                    pt = tPtr(pt->elem);
                eq = sameType(pt, f->params[i]);
            }
            if (eq && !(f->decl && f->decl->body))
                target = f;
        }
        if (!target)
            fail(c->name + "::" + member + " was not declared in the class", d->line);
        auto merged = std::make_shared<cpp::Decl>(*target->decl);
        merged->body = d->body;
        merged->inits = d->inits;
        merged->params = d->params; // the definition's parameter names
        merged->file = d->file;     // its body is the definition's (that TU's names)
        merged->tu = d->tu;
        merged->line = d->line;
        target->decl = merged;
    }
    curNs_ = "";

    Method *mainFn = nullptr;
    for (Method *f : funcs_["main"])
        mainFn = f;
    if (!mainFn || !mainFn->decl->body)
        fail("no main()", 0);
    Method *argsFn = nullptr;
    if (!mainFn->params.empty())
    {
        if (mainFn->params.size() != 2)
            fail("main with " + std::to_string(mainFn->params.size()) + " parameters", mainFn->decl->line);
        for (Method *f : funcs_["__startup_args"])
            argsFn = f;
        if (!argsFn)
            fail("main(argc, argv) needs the startup library", mainFn->decl->line);
        argsFn->used = true;
    }

    // entry: global objects are constructed, main runs, they are destroyed in
    // reverse, and main's result is the exit code
    entry = a.size();
    a.push(RBP);
    a.movRR(RBP, RSP);
    a.subRsp(0); // the frame: patched below, once its temporaries are known
    int entryFrame = a.size() - 4;
    scopes_.assign(1, Scope());
    depth_ = 0;
    nextOff_ = -16; // [rbp-8] main's result, [rbp-16] argc
    for (size_t gi = 0; gi < globalCtorInits_.size(); ++gi)
    {
        const auto &g = globalCtorInits_[gi];
        const cpp::DeclP &d = g.second;
        curNs_ = globalCtorNs_[gi];
        curTu_ = gi < globalCtorTu_.size() ? globalCtorTu_[gi] : 0;
        ThisSrc self;
        self.kind = TH_GLOBAL;
        self.off = g.first;
        NT t = d->var.type && d->var.type->isAuto() ? autoType(d->var.type, d->var.args[0], d->line)
                                                     : typeOf(d->var.type, d->line);
        if (t->cat != C_CLASS)
        {
            // a scalar from an expression
            NT v = expr(d->var.args[0]);
            if (v->cat == C_REF)
                v = valueAt(v->elem);
            if (!(t->cat == C_PTR && (v->cat == C_PTR || v->cat == C_INT)))
                convert(t, v, d->line);
            a.leaData(RCX, g.first);
            a.storeRcx(sizeOf(t));
            endFullExpr();
            continue;
        }
        construct(self, t->cls, d->var.args, d->var.init == cpp::VarDeclarator::Brace, d->line);
    }
    curNs_ = "";
    if (argsFn)
    {
        a.lea(RCX, -16); // argc
        a.subRsp(32);
        a.call(argsFn->label);
        a.addRsp(32);
        a.movRR(RDX, RAX); // argv
        a.load(RCX, -16);
        a.movsxd(RCX);
    }
    a.subRsp(32);
    a.call(mainFn->label);
    a.addRsp(32);
    a.store(-8, RAX);
    for (int i = (int)globalObjects_.size() - 1; i >= 0; --i)
    {
        ThisSrc self;
        self.kind = TH_GLOBAL;
        self.off = globalObjects_[i].first;
        destroy(self, globalObjects_[i].second);
    }
    a.load(RCX, -8);
    a.callImport(importIndex("kernel32.dll", "ExitProcess"));
    a.patch32(entryFrame, alignUp(-nextOff_, 16));

    // the functions called (and every virtual one: a vtable holds it), until
    // generating them calls no new ones
    mainFn->used = true;
    for (bool more = true; more;)
    {
        more = false;
        for (size_t mi = 0; mi < allMethods_.size(); ++mi)
        {
            Method *m = allMethods_[mi].get();
            if (m->done || !m->dll.empty() || !(m->used || m->isVirtual))
                continue;
            m->done = true;
            more = true;
            if (!m->ret)
                deduceReturn(m);
            if (m->isPure && (!m->decl || !m->decl->body))
                continue;
            if (m->decl && !m->decl->body && !(m->owner && (m->isCtor || m->isDtor) && m->decl->isDefault))
                fail("function " + m->name + " is declared but not defined", m->decl->line);
            if (verbose_)
                std::cerr << "gen " << (m->owner ? m->owner->name + "::" : "") << m->name << " @"
                          << (m->decl && m->decl->file >= 0 && m->decl->file < (int)files_.size() ? files_[m->decl->file] : "?")
                          << ":" << (m->decl ? m->decl->line : 0) << "  <- " << m->usedBy
                          << "\n";
            function(*m);
        }
    }
    runtime();
    a.resolve();
    fillVtables();
}

void Gen::fillVtables()
{
    for (auto &kv : classes_)
    {
        ClassInfo *c = kv.second.get();
        for (size_t i = 0; i < c->vslots.size(); ++i)
        {
            Method *m = c->vslots[i];
            uint64_t v = m->isPure && (!m->decl || !m->decl->body) ? 0 : kCodeBase + (uint64_t)a.labelPos(m->label);
            for (int b = 0; b < 8; ++b)
                data[c->vtableOff + 8 * i + b] = (char)((v >> (8 * b)) & 255);
        }
    }
}

void Gen::globalVar(const cpp::DeclP &d)
{
    if (d->isExtern)
        return; // only declared: the definition (in this program) makes it
    NT t = typeOf(d->var.type, d->line);
    const cpp::VarDeclarator &v = d->var;
    if (t->cat == C_REF)
        fail("a global reference (not yet)", d->line);
    cpp::ExprP init;
    if (v.args.size() == 1 && v.init != cpp::VarDeclarator::Brace)
        init = v.args[0];
    else if (!v.args.empty() || v.init == cpp::VarDeclarator::Brace)
    {
        auto list = std::make_shared<cpp::Expr>();
        keepExprs_.push_back(list);
        list->k = cpp::EK::InitList;
        list->line = d->line;
        list->kids = v.args;
        if (v.args.size() == 1 && v.args[0]->k == cpp::EK::InitList)
            list = v.args[0];
        init = list;
    }
    if (t->cat == C_ARRAY && t->n == 0 && init)
        t = tArray(t->elem, init->k == cpp::EK::Str ? (int)init->str.size() + 1 : (int)init->kids.size());
    int align = alignOf(t);
    while (data.size() % align)
        data.push_back('\0');
    int off = (int)data.size();
    data.append(sizeOf(t), '\0');
    globals_[curNs_ + v.name] = Var{t, true, off};
    if (t->cat == C_CLASS && (!noCtors(t->cls) || t->cls->implicitCtor || t->cls->polymorphic))
    {
        globalCtorInits_.push_back({off, d}); // constructed by code before main
        globalCtorNs_.push_back(curNs_);
        globalCtorTu_.push_back(curTu_);
        staticCtor_[curNs_ + v.name] = globalCtorInits_.size() - 1;
        if (t->cls->needsDtor)
            globalObjects_.push_back({off, t->cls});
        return;
    }
    if (t->cat == C_CLASS && t->cls->needsDtor)
        globalObjects_.push_back({off, t->cls});
    if (init && isScalar(t) && init->k != cpp::EK::InitList)
    {
        try
        {
            constInit(off, t, init, d->line);
        }
        catch (const cpp::Unsupported &)
        {
            // not a constant (a call, another global): computed before main
            globalCtorInits_.push_back({off, d});
            globalCtorNs_.push_back(curNs_);
        globalCtorTu_.push_back(curTu_);
        }
        return;
    }
    if (init)
        constInit(off, t, init, d->line);
}

// a global's initial bytes, from constants
void Gen::constInit(int off, const NT &t, const cpp::ExprP &init, int line)
{
    if (t->cat == C_ARRAY && t->elem->cat == C_INT && t->elem->kind == K_I8 && init->k == cpp::EK::Str)
    {
        for (size_t i = 0; i < init->str.size() && (int)i < t->n; ++i)
            data[off + i] = init->str[i];
        return;
    }
    if (t->cat == C_ARRAY || t->cat == C_CLASS)
    {
        if (init->k != cpp::EK::InitList)
            fail("initializer of an array or class", line);
        for (size_t i = 0; i < init->kids.size(); ++i)
        {
            if (t->cat == C_ARRAY)
            {
                if ((int)i >= t->n)
                    fail("too many initializers", line);
                constInit(off + (int)i * sizeOf(t->elem), t->elem, init->kids[i], line);
            }
            else
            {
                if (i >= t->cls->fields.size())
                    fail("too many initializers", line);
                const Field &f = t->cls->fields[i];
                constInit(off + f.off, f.type, init->kids[i], line);
            }
        }
        return;
    }
    if (t->cat == C_PTR)
    {
        cpp::ExprP pe = init;
        if (pe->k == cpp::EK::InitList && pe->kids.size() == 1)
            pe = pe->kids[0];
        if (pe->k == cpp::EK::Str)
        {
            dataPtrs.push_back({off, stringData(pe->str)}); // the literal's bytes
            return;
        }
        if (pe->k == cpp::EK::Nullptr || (pe->k == cpp::EK::Int && constInt(pe) == 0))
            return;
        if (pe->k == cpp::EK::Unary && pe->op == "&" && pe->kids[0]->k == cpp::EK::Name)
        {
            Var *v = lookup(pe->kids[0]->name.back());
            if (v && v->global)
            {
                dataPtrs.push_back({off, v->off});
                return;
            }
        }
        fail("this global pointer's initial value (not yet)", line);
    }
    cpp::ExprP e = init;
    if (e->k == cpp::EK::InitList && e->kids.size() == 1)
        e = e->kids[0];
    if (e->k == cpp::EK::InitList && e->kids.empty())
        return;
    if (isFloat(t->kind))
    {
        double dv;
        if (e->k == cpp::EK::Float)
            dv = e->num;
        else if (e->k == cpp::EK::Unary && e->op == "-" && e->kids[0]->k == cpp::EK::Float)
            dv = -e->kids[0]->num;
        else
            dv = (double)constInt(e);
        uint64_t bits = t->kind == K_F64 ? ieeeBits(dv, 52, 1023) : ieeeBits(dv, 23, 127);
        for (int i = 0; i < kindSize(t->kind); ++i)
            data[off + i] = (char)((bits >> (8 * i)) & 255);
        return;
    }
    int64_t v = constInt(e);
    if (t->kind == K_BOOL)
        v = v != 0;
    for (int i = 0; i < kindSize(t->kind); ++i)
        data[off + i] = (char)((v >> (8 * i)) & 255);
}

void Gen::function(Method &m)
{
    at(m.decl);
    if (m.decl)
        curTu_ = tuOf(m.decl);
    BindP savedBind = bind_;
    std::string savedNs = curNs_;
    bind_ = m.bind;
    // the body's own scope (local classes, enums, aliases), inside the function's
    curNs_ = m.ns + "$" + std::to_string(m.label) + "::";
    a.bind(m.label);
    a.push(RBP);
    a.movRR(RBP, RSP);
    a.subRsp(0);
    int framePos = a.size() - 4;
    cur_ = &m;
    scopes_.assign(1, Scope());
    loops_.clear();
    temps_.clear();
    nextOff_ = 0;
    depth_ = 0;
    retLabel_ = a.newLabel();
    retType_ = m.ret;
    nrvoName_.clear();
    if (m.ret->cat == C_CLASS && m.decl && m.decl->body)
    {
        std::vector<cpp::ExprP> rets;
        std::vector<std::string> locals; // names declared in the body
        bool other = false;
        std::vector<cpp::StmtP> todo = {m.decl->body};
        while (!todo.empty())
        {
            cpp::StmtP x = todo.back();
            todo.pop_back();
            if (!x)
                continue;
            if (x->k == cpp::SK::Return)
            {
                if (x->expr && x->expr->k == cpp::EK::Name && x->expr->name.size() == 1)
                    rets.push_back(x->expr);
                else
                    other = true;
            }
            if (x->k == cpp::SK::Decl)
                for (const cpp::VarDeclarator &v : x->decls)
                    locals.push_back(v.name);
            for (const cpp::StmtP &y : x->body)
                todo.push_back(y);
            todo.push_back(x->then);
            todo.push_back(x->els);
            todo.push_back(x->init);
        }
        bool same = !rets.empty() && !other;
        for (const cpp::ExprP &r : rets)
            if (r->name[0] != rets[0]->name[0])
                same = false;
        for (const cpp::Param &pr : m.decl->params)
            if (!rets.empty() && pr.name == rets[0]->name[0])
                same = false;
        int local = 0; // a member or global returned is copied, never built in place
        for (const std::string &n : locals)
            if (!rets.empty() && n == rets[0]->name[0])
                ++local;
        if (same && local == 1) // one declaration: another of that name would shadow it
            nrvoName_ = rets[0]->name[0];
    }
    // arguments: the first four arrive in registers and go to their home
    // slots above the return address; the rest are already there
    int slot = 0;
    auto home = [&](int i) { return 16 + 8 * i; };
    if (m.ret->cat == C_CLASS)
        retPtrOff_ = home(slot++);
    if (m.owner && !m.isStatic)
        thisOff_ = home(slot++);
    int nargs = slot + (int)m.params.size();
    for (int i = 0; i < nargs && i < 4; ++i)
        a.store(home(i), kArgRegs[i]);
    if (trace_)
    {
        // QUANTUM_NATIVE_TRACE: the function's name to stderr on entry
        std::string msg = "[enter] " + m.name + "\n";
        a.movImm(RCX, 2);
        a.leaData(RDX, stringData(msg));
        a.movImm(R8, (int64_t)msg.size());
        a.subRsp(32);
        a.call(routine("write"));
        a.addRsp(32);
    }
    // the frame's setup, emitted after the body once its size is known: a
    // large frame's pages touched from the top down (Windows grows the stack
    // only in order), the temporaries' "constructed" flags cleared
    int setupLabel = a.newLabel(), setupDone = a.newLabel();
    a.jmp(setupLabel);
    a.bind(setupDone);
    flagSlots_.clear();
    frameObjects_ = false;
    if (m.decl)
        for (size_t i = 0; i < m.params.size(); ++i)
        {
            NT pt = m.params[i];
            if (pt->cat == C_CLASS)
                pt = tRef(pt, false); // by value: a pointer to the caller's copy
            if (i < m.decl->params.size() && !m.decl->params[i].name.empty())
                scopes_.back().vars[m.decl->params[i].name] = Var{pt, false, home(slot + (int)i)};
        }
    if (m.isCtor)
        ctorPrologue(m);
    if (m.decl && m.decl->body)
        for (const cpp::StmtP &s : m.decl->body->body)
            stmt(s);
    destroyScopes(0);
    a.movImm(RAX, 0); // falling off the end (main returns 0)
    a.bind(retLabel_);
    if (m.isDtor)
        dtorEpilogue(m);
    if (m.ret->cat == C_CLASS)
        a.load(RAX, retPtrOff_);
    a.leave();
    a.ret();
    int frameSize = alignUp(-nextOff_, 16);
    a.patch32(framePos, frameSize);
    m.frame = frameSize;
    a.bind(setupLabel);
    if (frameSize > 4096)
    {
        a.movImm(RDX, 0);
        a.movRR(RAX, RBP);
        for (int touched = 4096; touched <= frameSize; touched += 4096)
        {
            a.addImm(RAX, -4096);
            a.storeInd(RAX, RDX);
        }
    }
    if (frameObjects_)
    {
        // all of it zeroed (rep stosq over [rbp - frame, rbp))
        a.movImm(RCX, frameSize / 8);
        a.lea(RDI, -frameSize);
        a.movImm(RAX, 0);
        a.byte(0xF3);
        a.byte(0x48);
        a.byte(0xAB);
    }
    else if (!flagSlots_.empty())
    {
        a.movImm(RAX, 0);
        for (int f : flagSlots_)
            a.store(f, RAX);
    }
    a.jmp(setupDone);
    cur_ = nullptr;
    bind_ = savedBind;
    curNs_ = savedNs;
}

// A constructor's work before its body: the base, the vtable pointer, the members
void Gen::ctorPrologue(Method &m)
{
    ClassInfo *c = m.owner;
    std::vector<cpp::MemInit> inits;
    if (m.decl)
        inits = m.decl->inits;
    auto initFor = [&](const std::string &name) -> const cpp::MemInit *
    {
        for (const cpp::MemInit &mi : inits)
            if (mi.name == name)
                return &mi;
        return nullptr;
    };
    ThisSrc self;
    self.kind = TH_CUR;
    if (c->base)
    {
        // the base as written in the init list: qualified, plain, or its template's name
        const cpp::MemInit *bi = initFor(c->base->name);
        std::string plain = c->base->name.substr(c->base->name.rfind("::") == std::string::npos ? 0 : c->base->name.rfind("::") + 2);
        if (!bi && plain.find('<') == std::string::npos)
            bi = initFor(plain);
        if (!bi && !c->base->templateName.empty())
            bi = initFor(c->base->templateName);
        std::vector<cpp::ExprP> none;
        construct(self, c->base, bi ? bi->args : none, bi && bi->braced, m.decl ? m.decl->line : 0);
    }
    if (c->polymorphic)
    {
        a.load(RCX, thisOff_);
        a.leaData(RAX, c->vtableOff);
        a.storeRcx(8);
    }
    for (const Field &f : c->fields)
    {
        const cpp::MemInit *mi = initFor(f.name);
        std::vector<cpp::ExprP> args;
        bool braced = false;
        if (mi)
        {
            args = mi->args;
            braced = mi->braced;
        }
        else if (f.init || f.initBraced)
        {
            args = f.initArgs;
            braced = f.initBraced;
        }
        int line = m.decl ? m.decl->line : 0;
        if (f.type->cat == C_ARRAY && args.empty())
        {
            ThisSrc ts;
            ts.kind = TH_CUR;
            constructElements(ts, f.off, f.type, line);
            continue;
        }
        if (f.type->cat == C_CLASS)
        {
            if (args.size() == 1 && !braced)
            {
                NT at = typeOfExpr(args[0]);
                if (at->cat == C_REF)
                    at = at->elem;
                if (at->cat == C_CLASS && at->cls == f.type->cls && noCtors(f.type->cls) &&
                    !f.type->cls->copyCtor)
                {
                    // a copy: memberwise
                    expr(args[0]);
                    a.movRR(RSI, RAX);
                    a.load(RDI, thisOff_);
                    if (f.off)
                        a.addImm(RDI, f.off);
                    copyBytes(sizeOf(f.type));
                    endFullExpr();
                    continue;
                }
            }
            a.load(RAX, thisOff_);
            if (f.off)
                a.addImm(RAX, f.off);
            int tmp = newSlot(tPtr(tVoid()));
            a.store(tmp, RAX);
            ThisSrc fs;
            fs.kind = TH_INDIRECT;
            fs.off = tmp;
            construct(fs, f.type->cls, args, braced, line);
            continue;
        }
        if (args.empty())
            continue; // zeroed memory
        if (f.type->cat == C_REF)
        {
            bindRef(f.type, args[0], line);
            a.movRR(RDX, RAX);
            a.load(RCX, thisOff_);
            if (f.off)
                a.addImm(RCX, f.off);
            a.movRR(RAX, RDX);
            a.storeRcx(8);
            endFullExpr();
            continue;
        }
        if (f.type->cat == C_ARRAY)
        {
            if (!braced && args.size() == 1)
            {
                NT at = typeOfExpr(args[0]);
                if (at->cat == C_REF)
                    at = at->elem;
                NT el = f.type;
                while (el->cat == C_ARRAY)
                    el = el->elem;
                if ((at->cat == C_ARRAY || (at->cat == C_PTR && args[0]->k == cpp::EK::Member)) && el->cat != C_CLASS)
                {
                    // an array copied (a generated copy constructor)
                    addr(args[0]);
                    a.movRR(RSI, RAX);
                    a.load(RDI, thisOff_);
                    if (f.off)
                        a.addImm(RDI, f.off);
                    copyBytes(sizeOf(f.type));
                    continue;
                }
            }
            if (!braced)
                fail("initializing an array member", line);
            fail("an array member's initializer list (not yet)", line);
        }
        if (args.size() != 1)
            fail("initializer of member " + f.name, line);
        NT vt = expr(args[0]);
        if (f.type->cat == C_PTR && (vt->cat == C_PTR || vt->cat == C_INT))
            ;
        else
            convert(f.type, vt, line);
        a.movRR(RDX, RAX);
        a.load(RCX, thisOff_);
        if (f.off)
            a.addImm(RCX, f.off);
        a.movRR(RAX, RDX);
        a.storeRcx(sizeOf(f.type));
        endFullExpr();
    }
}

// Default-constructs the class elements of the array at `off` in base's object
void Gen::constructElements(const ThisSrc &base, int off, const NT &arr, int line)
{
    NT el = arr;
    int count = 1;
    while (el->cat == C_ARRAY)
    {
        count *= el->n;
        el = el->elem;
    }
    if (el->cat != C_CLASS || (noCtors(el->cls) && !el->cls->implicitCtor))
        return;
    if (count > 64)
        fail("an array of more than 64 objects with constructors (not yet)", line);
    for (int i = 0; i < count; ++i)
    {
        loadThis(base);
        a.addImm(RAX, off + i * el->cls->size);
        int tmp = newSlot(tPtr(tVoid()));
        a.store(tmp, RAX);
        ThisSrc es;
        es.kind = TH_INDIRECT;
        es.off = tmp;
        std::vector<cpp::ExprP> none;
        construct(es, el->cls, none, false, line);
    }
}

// A destructor's work after its body: the members in reverse, then the base
void Gen::dtorEpilogue(Method &m)
{
    ClassInfo *c = m.owner;
    for (int i = (int)c->fields.size() - 1; i >= 0; --i)
    {
        const Field &f = c->fields[i];
        if (f.type->cat == C_ARRAY && f.type->elem->cat == C_CLASS && f.type->elem->cls->needsDtor)
        {
            // an array member: its elements, last first
            ClassInfo *ec = f.type->elem->cls;
            if (f.type->n > 64)
                fail("an array member of more than 64 objects with destructors (not yet)", 0);
            for (int k = f.type->n - 1; k >= 0; --k)
            {
                a.load(RAX, thisOff_);
                if (f.off + k * ec->size)
                    a.addImm(RAX, f.off + k * ec->size);
                int tmp = newSlot(tPtr(tVoid()));
                a.store(tmp, RAX);
                ThisSrc es;
                es.kind = TH_INDIRECT;
                es.off = tmp;
                destroy(es, ec);
            }
            continue;
        }
        if (f.type->cat != C_CLASS || !f.type->cls->needsDtor)
            continue;
        a.load(RAX, thisOff_);
        if (f.off)
            a.addImm(RAX, f.off);
        int tmp = newSlot(tPtr(tVoid()));
        a.store(tmp, RAX);
        ThisSrc fs;
        fs.kind = TH_INDIRECT;
        fs.off = tmp;
        destroy(fs, f.type->cls);
    }
    if (c->base && c->base->needsDtor)
    {
        a.load(RAX, thisOff_);
        int tmp = newSlot(tPtr(tVoid()));
        a.store(tmp, RAX);
        ThisSrc bs;
        bs.kind = TH_INDIRECT;
        bs.off = tmp;
        // the base part only: no virtual dispatch
        a.load(RCX, tmp);
        int pad = (depth_ + 4) % 2;
        if (pad)
            a.subRsp(8);
        a.subRsp(32);
        c->base->dtor->used = true;
        a.call(c->base->dtor->label);
        a.addRsp(32 + 8 * pad);
    }
}

// The runtime: routines the program uses, in machine code
void Gen::runtime()
{
    for (auto &kv : runtime_)
    {
        const std::string &name = kv.first;
        a.bind(kv.second);
        a.push(RBP);
        a.movRR(RBP, RSP);
        a.subRsp(64);
        if (name == "putchar")
        {
            // one byte to standard output; '\n' is written as "\r\n", as the
            // C runtime's text-mode stdout does
            a.movzx8(RCX);
            a.store(-24, RCX); // the result
            a.store(16, RCX);  // the bytes to write, in the home slot
            a.movImm(RAX, 1);
            a.store(-16, RAX); // how many
            int plain = a.newLabel();
            a.movImm(RAX, 10);
            a.alu(0x39, RCX, RAX);
            a.jcc(CC_NE, plain);
            a.movImm(RAX, 0x0A0D);
            a.store(16, RAX);
            a.movImm(RAX, 2);
            a.store(-16, RAX);
            a.bind(plain);
            a.movImm(RCX, -11); // STD_OUTPUT_HANDLE
            a.callImport(importIndex("kernel32.dll", "GetStdHandle"));
            a.movRR(RCX, RAX);
            a.lea(RDX, 16);
            a.load(R8, -16);
            a.lea(R9, -8); // bytes written
            a.movImm(RAX, 0);
            a.storeRsp(32, RAX); // no OVERLAPPED
            a.callImport(importIndex("kernel32.dll", "WriteFile"));
            a.load(RAX, -24);
        }
        else if (name == "puts")
        {
            // the string's bytes, then a newline
            a.store(16, RCX);
            int top = a.newLabel(), done = a.newLabel();
            a.bind(top);
            a.load(RCX, 16);
            a.loadRcx(1, false);
            a.test(RAX, RAX);
            a.jcc(CC_E, done);
            a.movRR(RCX, RAX);
            a.call(runtime_["putchar"]);
            a.load(RAX, 16);
            a.addImm(RAX, 1);
            a.store(16, RAX);
            a.jmp(top);
            a.bind(done);
            a.movImm(RCX, 10);
            a.call(runtime_["putchar"]);
            a.movImm(RAX, 0);
        }
        else if (name == "alloc")
        {
            // zeroed memory from the process heap
            a.store(16, RCX);
            a.callImport(importIndex("kernel32.dll", "GetProcessHeap"));
            a.movRR(RCX, RAX);
            a.movImm(RDX, 8); // HEAP_ZERO_MEMORY
            a.load(R8, 16);
            a.callImport(importIndex("kernel32.dll", "HeapAlloc"));
        }
        else if (name == "free")
        {
            a.store(16, RCX);
            int skip = a.newLabel();
            a.test(RCX, RCX);
            a.jcc(CC_E, skip);
            a.callImport(importIndex("kernel32.dll", "GetProcessHeap"));
            a.movRR(RCX, RAX);
            a.movImm(RDX, 0);
            a.load(R8, 16);
            a.callImport(importIndex("kernel32.dll", "HeapFree"));
            a.bind(skip);
            a.movImm(RAX, 0);
        }
        else if (name == "write")
        {
            // write(fd, bytes, count) to standard output (1) or error (2), as is
            a.store(16, RCX);
            a.store(24, RDX);
            a.store(32, R8);
            int out = a.newLabel(), got = a.newLabel();
            a.movImm(RAX, 2);
            a.alu(0x39, RCX, RAX);
            a.jcc(CC_NE, out);
            a.movImm(RCX, -12); // STD_ERROR_HANDLE
            a.jmp(got);
            a.bind(out);
            a.movImm(RCX, -11); // STD_OUTPUT_HANDLE
            a.bind(got);
            a.callImport(importIndex("kernel32.dll", "GetStdHandle"));
            a.movRR(RCX, RAX);
            a.load(RDX, 24);
            a.load(R8, 32);
            a.lea(R9, -8);
            a.movImm(RAX, 0);
            a.storeRsp(32, RAX);
            a.callImport(importIndex("kernel32.dll", "WriteFile"));
            a.load(RAX, 32);
        }
        else if (name == "read")
        {
            // read(fd, bytes, count) from standard input: the bytes read (0: end)
            a.store(24, RDX);
            a.store(32, R8);
            a.movImm(RCX, -10); // STD_INPUT_HANDLE
            a.callImport(importIndex("kernel32.dll", "GetStdHandle"));
            a.movRR(RCX, RAX);
            a.load(RDX, 24);
            a.load(R8, 32);
            a.lea(R9, -8);
            a.movImm(RAX, 0);
            a.store(-8, RAX);
            a.storeRsp(32, RAX);
            a.callImport(importIndex("kernel32.dll", "ReadFile"));
            a.load(RAX, -8);
            a.movzx32(RAX);
        }
        else if (name == "throw")
        {
            // the newest handler record: popped, its frame restored, its landing pad run
            int none = a.newLabel();
            a.leaData(RCX, ehTop_);
            a.loadRcx(8, false);
            a.test(RAX, RAX);
            a.jcc(CC_E, none);
            a.loadInd(RCX, RAX); // the record before it
            a.leaData(RDX, ehTop_);
            a.storeInd(RDX, RCX);
            a.loadDisp(RBP, RAX, 8);
            a.loadDisp(RSP, RAX, 16);
            a.loadDisp(RAX, RAX, 24);
            a.jmpReg(RAX);
            a.bind(none);
            // nothing catches it: abort's exit code
            a.movImm(RCX, 3);
            a.callImport(importIndex("kernel32.dll", "ExitProcess"));
        }
        else if (name == "pure")
        {
            // a pure virtual function called: exit code 3, as abort() gives
            a.movImm(RCX, 3);
            a.callImport(importIndex("kernel32.dll", "ExitProcess"));
        }
        a.leave();
        a.ret();
    }
}

// ─── Values ────────────────────────────────────────────────────────────────

Gen::Var *Gen::lookup(const std::string &name)
{
    for (int i = (int)scopes_.size() - 1; i >= 0; --i)
    {
        auto it = scopes_[i].vars.find(name);
        if (it != scopes_[i].vars.end())
            return &it->second;
    }
    for (const std::string &k : candidates({name}))
    {
        auto g = globals_.find(k);
        if (g != globals_.end())
            return &g->second;
    }
    return nullptr;
}

int Gen::newSlot(const NT &t)
{
    nextOff_ -= alignUp(sizeOf(t), 8);
    NT el = t;
    while (el->cat == C_ARRAY)
        el = el->elem;
    if (el->cat == C_CLASS)
        frameObjects_ = true; // an object may be destroyed without having been built: the frame starts zeroed
    return nextOff_;
}

void Gen::pushRax()
{
    a.push(RAX);
    ++depth_;
}

void Gen::popReg(int r)
{
    a.pop(r);
    --depth_;
}

// a call of a routine with its arguments in registers already
void Gen::callRoutine(int label)
{
    int pad = (depth_ + 4) % 2;
    if (pad)
        a.subRsp(8);
    a.subRsp(32);
    a.call(label);
    a.addRsp(32 + 8 * pad);
}

void Gen::wrap(Kind k, int r)
{
    switch (k)
    {
    case K_BOOL:
        if (r != RAX)
            a.movRR(RAX, r);
        a.test(RAX, RAX);
        a.setcc(CC_NE);
        if (r != RAX)
            a.movRR(r, RAX);
        break;
    case K_I8: a.movsx8(r); break;
    case K_U8: a.movzx8(r); break;
    case K_I16: a.movsx16(r); break;
    case K_U16: a.movzx16(r); break;
    case K_I32: a.movsxd(r); break;
    case K_U32: a.movzx32(r); break;
    default: break;
    }
}

void Gen::convKind(Kind from, Kind to)
{
    if (from == to)
        return;
    if (!isFloat(from) && !isFloat(to))
    {
        wrap(to);
        return;
    }
    if (isFloat(from) && isFloat(to))
    {
        a.toXmm(0, RAX, from == K_F64);
        a.sse(from == K_F64 ? 0xF2 : 0xF3, 0x5A, 0, 0); // cvtsd2ss / cvtss2sd
        a.fromXmm(RAX, 0, to == K_F64);
        return;
    }
    if (isFloat(to))
    {
        int pre = to == K_F64 ? 0xF2 : 0xF3;
        if (from == K_U64)
        {
            // an unsigned value from 2^63 up: halve it (keeping the low bit), convert, double
            int big = a.newLabel(), done = a.newLabel();
            a.test(RAX, RAX);
            a.jcc(0x8, big); // js
            a.sse(pre, 0x2A, 0, RAX, true);
            a.jmp(done);
            a.bind(big);
            a.movRR(RDX, RAX);
            a.movImm(RCX, 1);
            a.shiftCl(5, RDX);       // rdx = rax >> 1
            a.alu(0x21, RAX, RCX);   // rax &= 1
            a.alu(0x09, RDX, RAX);   // rdx |= rax
            a.sse(pre, 0x2A, 0, RDX, true);
            a.sse(pre, 0x58, 0, 0);  // x + x
            a.bind(done);
            a.fromXmm(RAX, 0, to == K_F64);
            return;
        }
        a.sse(pre, 0x2A, 0, RAX, true); // cvtsi2sd/ss xmm0, rax
        a.fromXmm(RAX, 0, to == K_F64);
        return;
    }
    // float -> integer: truncation toward zero
    if (to == K_BOOL)
    {
        truth(tInt(from));
        return;
    }
    a.toXmm(0, RAX, from == K_F64);
    a.sse(from == K_F64 ? 0xF2 : 0xF3, 0x2C, RAX, 0, true); // cvttsd2si / cvttss2si rax, xmm0
    wrap(to);
}

void Gen::truth(const NT &t)
{
    if (t->cat != C_INT || !isFloat(t->kind))
        return;
    bool d = t->kind == K_F64;
    a.toXmm(0, RAX, d);
    a.sse(0x66, 0x57, 1, 1);          // xorpd xmm1, xmm1
    a.sse(d ? 0x66 : 0, 0x2E, 0, 1);  // ucomisd/ss xmm0, xmm1
    a.byte(0x0F);
    a.byte(0x95);
    a.byte(0xC0); // setne al
    a.byte(0x0F);
    a.byte(0x9A);
    a.byte(0xC1); // setp cl (NaN is true)
    a.byte(0x08);
    a.byte(0xC8); // or al, cl
    a.movzx8(RAX);
}

void Gen::arithFloat(const std::string &op, Kind k, int line)
{
    bool d = k == K_F64;
    int pre = d ? 0xF2 : 0xF3;
    a.toXmm(0, RAX, d);
    a.toXmm(1, RCX, d);
    if (op == "+")
        a.sse(pre, 0x58, 0, 1);
    else if (op == "-")
        a.sse(pre, 0x5C, 0, 1);
    else if (op == "*")
        a.sse(pre, 0x59, 0, 1);
    else if (op == "/")
        a.sse(pre, 0x5E, 0, 1);
    else
        fail("operator " + op + " on floating point", line);
    a.fromXmm(RAX, 0, d);
}

// rax = (rax op rcx) for two floating-point values; NaN compares unequal
void Gen::compareFloat(const std::string &op, Kind k)
{
    bool d = k == K_F64;
    a.toXmm(0, RAX, d);
    a.toXmm(1, RCX, d);
    int pre = d ? 0x66 : 0;
    if (op == "<" || op == "<=")
        a.sse(pre, 0x2E, 1, 0); // ucomis b, a: a < b is b above a
    else
        a.sse(pre, 0x2E, 0, 1);
    if (op == "==" || op == "!=")
    {
        bool eq = op == "==";
        a.byte(0x0F);
        a.byte(eq ? 0x94 : 0x95);
        a.byte(0xC0); // sete / setne al
        a.byte(0x0F);
        a.byte(eq ? 0x9B : 0x9A);
        a.byte(0xC1); // setnp / setp cl
        a.byte(eq ? 0x20 : 0x08);
        a.byte(0xC8); // and / or al, cl
        a.movzx8(RAX);
        return;
    }
    a.setcc(op == "<" || op == ">" ? CC_A : CC_AE);
}

void Gen::convert(const NT &to, const NT &from, int line)
{
    if (to->cat == C_VOID)
        return;
    if (to->cat == C_PTR && from->cat == C_FUNC)
        return; // a function decays to its address (in rax already)
    if (to->cat == C_PTR && from->cat == C_PTR)
    {
        bool ok = to->elem->cat == C_VOID || sameType(to->elem, from->elem) ||
                  (to->elem->cat == C_CLASS && from->elem->cat == C_CLASS && derivesFrom(from->elem->cls, to->elem->cls)) ||
                  from->elem->cat == C_VOID;
        if (!ok)
            fail("converting between unrelated pointer types", line);
        return;
    }
    if (!isScalar(to) || !isScalar(from))
    {
        if (to->cat == C_CLASS && from->cat == C_CLASS && derivesFrom(from->cls, to->cls))
            return;
        fail("this conversion (" + typeKey(from) + " to " + typeKey(to) + ")", line);
    }
    if (to->cat == C_PTR)
        fail("converting an integer to a pointer", line);
    if (to->cat == C_INT)
        convKind(from->cat == C_INT ? from->kind : K_U64, to->kind);
}

NT Gen::valueAt(const NT &t)
{
    if (t->cat == C_ARRAY)
        return tPtr(t->elem); // decays to its first element's address
    if (t->cat == C_FUNC)
        return tPtr(t); // a function: its address
    if (t->cat == C_CLASS)
        return t;
    int disp;
    if (a.takeLeaRax(disp))
    {
        if (t->cat == C_PTR)
            a.loadRbp(RAX, disp, 8, false);
        else
            a.loadRbp(RAX, disp, kindSize(t->kind), !isUnsigned(t->kind) && !isFloat(t->kind));
        return t;
    }
    a.movRR(RCX, RAX);
    if (t->cat == C_PTR)
        a.loadRcx(8, false);
    else
        a.loadRcx(kindSize(t->kind), !isUnsigned(t->kind) && !isFloat(t->kind));
    return t;
}

// The type an expression would have: its code is generated and dropped
NT Gen::typeOfExpr(const cpp::ExprP &e)
{
    if (e->k == cpp::EK::InitList)
        return tVoid(); // typed by what it initializes
    std::map<const Binding *, NT> &memo = typeMemo_[e.get()];
    auto known = memo.find(bind_.get());
    if (known != memo.end() && cur_ && !scopes_.empty())
        return known->second;
    Asm::Mark m = a.mark();
    int depth = depth_, next = nextOff_;
    size_t temps = temps_.size();
    NT t = expr(e);
    a.rewind(m);
    depth_ = depth;
    nextOff_ = next;
    temps_.resize(temps);
    if (!memo.count(bind_.get()))
    {
        keepExprs_.push_back(e);
        if (bind_)
            keepBinds_.push_back(bind_);
    }
    memo[bind_.get()] = t;
    return t;
}

NT Gen::rawType(const cpp::ExprP &e)
{
    if (e->k != cpp::EK::Call)
        return typeOfExpr(e);
    std::map<const Binding *, NT> &memo = rawMemo_[e.get()];
    auto known = memo.find(bind_.get());
    if (known != memo.end() && cur_ && !scopes_.empty())
        return known->second;
    Asm::Mark m = a.mark();
    int depth = depth_, next = nextOff_;
    size_t temps = temps_.size();
    NT t = call(e);
    a.rewind(m);
    depth_ = depth;
    nextOff_ = next;
    temps_.resize(temps);
    if (!memo.count(bind_.get()))
    {
        keepExprs_.push_back(e);
        if (bind_)
            keepBinds_.push_back(bind_);
    }
    memo[bind_.get()] = t;
    return t;
}

const Field *Gen::findField(ClassInfo *c, const std::string &name, int &off)
{
    for (ClassInfo *k = c; k; k = k->base)
        for (const Field &f : k->fields)
            if (f.name == name)
            {
                off = f.off;
                return &f;
            }
    return nullptr;
}

Method *Gen::findMethod(ClassInfo *c, const std::string &name, std::vector<Method *> &out)
{
    for (ClassInfo *k = c; k; k = k->base)
    {
        auto it = k->methods.find(name);
        if (it != k->methods.end())
        {
            out = it->second;
            return out.front();
        }
    }
    return nullptr;
}

void Gen::loadThis(const ThisSrc &s)
{
    switch (s.kind)
    {
    case TH_OBJ:
    {
        NT t = addr(s.e);
        if (t->cat != C_CLASS)
            fail("a member call on a non-object", s.e->line);
        break;
    }
    case TH_PTR:
    {
        NT t = expr(s.e);
        if (t->cat != C_PTR || t->elem->cat != C_CLASS)
            fail("-> on a non-object pointer", s.e->line);
        break;
    }
    case TH_CUR:
        a.load(RAX, thisOff_);
        break;
    case TH_LOCAL:
        a.lea(RAX, s.off);
        break;
    case TH_INDIRECT:
        a.load(RAX, s.off);
        break;
    case TH_GLOBAL:
        a.leaData(RAX, s.off);
        break;
    case TH_OUTER:
    {
        int off = 0;
        findField(cur_->owner, "__this", off);
        a.load(RCX, thisOff_);
        if (off)
            a.addImm(RCX, off);
        a.loadRcx(8, false);
        break;
    }
    default:
        break;
    }
}

NT Gen::addr(const cpp::ExprP &e)
{
    switch (e->k)
    {
    case cpp::EK::Name:
    {
        // an enumerator as an object (bound to a reference): a temporary holding it
        {
            bool local = false;
            if (e->name.size() == 1)
                for (const Scope &sc : scopes_)
                    if (sc.vars.count(e->name[0]))
                        local = true;
            if (!local && !(e->name.size() == 1 && lookup(e->name[0])))
                for (const std::string &k : candidates(e->name))
                {
                    auto en = enumerators_.find(k);
                    if (en != enumerators_.end())
                    {
                        NT t = tInt(en->second.first);
                        int slot = newSlot(t);
                        a.movImm(RAX, en->second.second);
                        a.store(slot, RAX);
                        a.lea(RAX, slot);
                        return t;
                    }
                }
        }
        if (e->name.size() >= 2)
        {
            std::vector<std::string> owner(e->name.begin(), e->name.end() - 1);
            std::vector<std::vector<cpp::TArg>> ownerTargs;
            if (e->scopeTargs.size() >= owner.size())
                ownerTargs.assign(e->scopeTargs.begin(), e->scopeTargs.begin() + owner.size());
            ClassInfo *c = ownerClass(owner, ownerTargs, e->line);
            for (ClassInfo *k = c; k; k = k->base)
            {
                auto st = k->statics.find(e->name.back());
                if (st != k->statics.end())
                {
                    Var &g = globals_[st->second];
                    a.leaData(RAX, g.off);
                    return g.type;
                }
            }
            for (const std::string &k : candidates(e->name))
            {
                auto g = globals_.find(k);
                if (g != globals_.end())
                {
                    a.leaData(RAX, g->second.off);
                    return g->second.type;
                }
            }
            if (Method *fm = functionValue(e->name, e->line))
            {
                a.leaLabel(RAX, fm->label);
                return tFunc(fm->ret, fm->params);
            }
            fail("name " + joinName(e->name), e->line);
        }
        if (e->name.size() != 1)
            fail("name " + e->name.back(), e->line);
        const std::string &n = e->name[0];
        Var *v = lookup(n);
        // a member of the current class, through this
        if (cur_ && cur_->owner && !cur_->isStatic && (!v || v->global))
        {
            bool local = false;
            for (int i = (int)scopes_.size() - 1; i >= 0; --i)
                if (scopes_[i].vars.count(n))
                    local = true;
            int off = 0;
            const Field *f = local ? nullptr : findField(cur_->owner, n, off);
            if (!f && !local && cur_->owner->outer)
            {
                // in a lambda: a member of the object whose this it captured
                f = findField(cur_->owner->outer, n, off);
                if (f)
                {
                    ThisSrc o;
                    o.kind = TH_OUTER;
                    loadThis(o);
                    if (off)
                        a.addImm(RAX, off);
                    if (f->type->cat == C_REF)
                    {
                        a.movRR(RCX, RAX);
                        a.loadRcx(8, false);
                        return f->type->elem;
                    }
                    return f->type;
                }
            }
            if (f)
            {
                a.load(RAX, thisOff_);
                if (off)
                    a.addImm(RAX, off);
                if (f->type->cat == C_REF)
                {
                    a.movRR(RCX, RAX);
                    a.loadRcx(8, false);
                    return f->type->elem;
                }
                return f->type;
            }
        }
        if (!v && cur_ && cur_->owner)
            for (ClassInfo *k = cur_->owner; k; k = k->base)
            {
                auto s = k->statics.find(n);
                if (s != k->statics.end())
                    v = &globals_[s->second];
            }
        if (!v)
        {
            // the scope may be a class (a default argument): its statics and its bases'
            std::string sc = curNs_;
            while (!v && sc.size() > 2)
            {
                auto ci = classes_.find(sc.substr(0, sc.size() - 2));
                for (ClassInfo *k = ci == classes_.end() ? nullptr : ci->second.get(); k && !v; k = k->base)
                {
                    auto st = k->statics.find(n);
                    if (st != k->statics.end())
                        v = &globals_[st->second];
                }
                std::string t = sc.substr(0, sc.size() - 2);
                size_t at = t.rfind("::");
                sc = at == std::string::npos ? "" : t.substr(0, at + 2);
            }
        }
        if (!v)
        {
            if (Method *fm = functionValue(e->name, e->line))
            {
                a.leaLabel(RAX, fm->label);
                return tFunc(fm->ret, fm->params);
            }
            fail("unknown name " + n, e->line);
        }
        if (v->global)
            a.leaData(RAX, v->off);
        else
            a.lea(RAX, v->off);
        if (v->type->cat == C_REF)
        {
            a.movRR(RCX, RAX);
            a.loadRcx(8, false);
            return v->type->elem;
        }
        return v->type;
    }
    case cpp::EK::This:
        fail("this is not an object (use *this)", e->line);
    case cpp::EK::Unary:
        if (e->op == "*")
        {
            {
                bool found = false;
                NT r = operatorCall("*", e->kids, e->line, found); // an iterator's operator*
                if (found)
                {
                    if (r->cat == C_REF)
                        return r->elem;
                    if (r->cat == C_CLASS)
                        return r;
                    fail("operator* returning a value, used as an object", e->line);
                }
            }
            NT p = expr(e->kids[0]);
            if (p->cat == C_REF)
                p = p->elem;
            if (p->cat != C_PTR)
                fail("* of a non-pointer", e->line);
            if (p->elem->cat == C_VOID)
                fail("* of a void pointer", e->line);
            return p->elem;
        }
        break;
    case cpp::EK::Index:
    {
        {
            bool found = false;
            NT r = operatorCall("[]", e->kids, e->line, found);
            if (found)
            {
                if (r->cat == C_REF)
                    return r->elem;
                if (r->cat == C_CLASS)
                    return r;
                fail("operator[] returning a value, used as an object", e->line);
            }
        }
        NT b = expr(e->kids[0]);
        if (b->cat == C_REF)
            b = b->elem;
        if (b->cat != C_PTR)
            fail("[] of a non-pointer", e->line);
        pushRax();
        NT i = expr(e->kids[1]);
        if (i->cat != C_INT)
            fail("a non-integer index", e->line);
        a.imulImm(RAX, sizeOf(b->elem));
        a.movRR(RCX, RAX);
        popReg(RAX);
        a.alu(0x01, RAX, RCX);
        return b->elem;
    }
    case cpp::EK::Member:
    {
        NT s;
        if (e->arrow)
        {
            NT ot = typeOfExpr(e->kids[0]);
            if (ot->cat == C_REF)
                ot = ot->elem;
            NT p = ot->cat == C_CLASS ? expr(arrowBase(e->kids[0])) : expr(e->kids[0]);
            if (p->cat != C_PTR || p->elem->cat != C_CLASS)
                fail("-> on a non-object pointer", e->line);
            s = p->elem;
        }
        else
        {
            s = addr(e->kids[0]);
            if (s->cat != C_CLASS)
                fail(". on a non-object", e->line);
        }
        int off = 0;
        const Field *f = findField(s->cls, e->op, off);
        if (!f)
        {
            // obj.staticMember: the class's static
            for (ClassInfo *k = s->cls; k; k = k->base)
            {
                auto st = k->statics.find(e->op);
                if (st != k->statics.end())
                {
                    Var &g = globals_[st->second];
                    a.leaData(RAX, g.off);
                    return g.type;
                }
            }
            fail("class " + s->cls->name + " has no data member " + e->op, e->line);
        }
        if (off)
            a.addImm(RAX, off);
        if (f->type->cat == C_REF)
        {
            a.movRR(RCX, RAX);
            a.loadRcx(8, false);
            return f->type->elem;
        }
        return f->type;
    }
    case cpp::EK::Str:
        if (e->op == "u" || e->op == "L" || e->op == "U")
        {
            // a wide literal: the UTF-8 text as UTF-16 (u, L) or UTF-32 (U) units
            bool w32 = e->op == "U";
            std::string bytes;
            int units = 0;
            const std::string &t8 = e->str;
            for (size_t i = 0; i < t8.size();)
            {
                unsigned c = (unsigned char)t8[i];
                unsigned cp;
                int n = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
                cp = n == 1 ? c : n == 2 ? c & 0x1F : n == 3 ? c & 0x0F : c & 0x07;
                for (int k = 1; k < n && i + k < t8.size(); ++k)
                    cp = (cp << 6) | ((unsigned char)t8[i + k] & 0x3F);
                i += n;
                auto put = [&](unsigned u, int size)
                {
                    for (int k = 0; k < size; ++k)
                        bytes += (char)((u >> (8 * k)) & 255);
                    ++units;
                };
                if (w32)
                    put(cp, 4);
                else if (cp >= 0x10000)
                {
                    cp -= 0x10000;
                    put(0xD800 + (cp >> 10), 2);
                    put(0xDC00 + (cp & 0x3FF), 2);
                }
                else
                    put(cp, 2);
            }
            // stringData adds one zero byte; the rest of the terminator here
            bytes.append(w32 ? 3 : 1, '\0');
            a.leaData(RAX, stringData(bytes));
            return tArray(tInt(w32 ? K_U32 : K_U16), units + 1);
        }
        a.leaData(RAX, stringData(e->str));
        return tArray(tInt(K_I8), (int)e->str.size() + 1);
    case cpp::EK::Call:
    {
        NT t = call(e);
        if (t->cat == C_REF)
            return t->elem;
        if (t->cat == C_CLASS)
            return t; // a temporary object
        break;
    }
    case cpp::EK::Assign:
    {
        NT t = assign(e);
        if (t->cat == C_CLASS)
            return t;
        break;
    }
    case cpp::EK::Construct:
    case cpp::EK::Cast:
    {
        NT t = expr(e);
        if (t->cat == C_CLASS)
            return t; // a temporary object
        break;
    }
    case cpp::EK::Lambda:
        return lambda(e); // its closure, a temporary
    case cpp::EK::Comma:
    {
        // (a, b): a for its effects, b's place
        for (size_t i = 0; i + 1 < e->kids.size(); ++i)
            expr(e->kids[i]);
        return addr(e->kids.back());
    }
    case cpp::EK::Cond:
    {
        NT b1 = typeOfExpr(e->kids[1]), b2 = typeOfExpr(e->kids[2]);
        if (b1->cat == C_REF)
            b1 = b1->elem;
        if (b2->cat == C_REF)
            b2 = b2->elem;
        if ((b1->cat == C_CLASS || b2->cat == C_CLASS) &&
            (!(b1->cat == C_CLASS && b2->cat == C_CLASS && b1->cls == b2->cls) ||
             rvalueExpr(e->kids[1]) != rvalueExpr(e->kids[2])))
            return expr(e); // converted to the class (or an lvalue / prvalue mix): a temporary
        int other = a.newLabel(), end = a.newLabel();
        truth(expr(asCondition(e->kids[0])));
        a.test(RAX, RAX);
        a.jcc(CC_E, other);
        NT t1 = addr(e->kids[1]);
        a.jmp(end);
        a.bind(other);
        addr(e->kids[2]);
        a.bind(end);
        return t1;
    }
    default:
        break;
    }
    // an operator on objects yields an object (or a reference to one)
    {
        NT t = typeOfExpr(e);
        if (t->cat == C_CLASS || t->cat == C_REF)
        {
            if (e->k == cpp::EK::Binary || e->k == cpp::EK::Unary)
            {
                bool found = false;
                NT r = operatorCall(e->op, e->kids, e->line, found);
                if (found)
                    return r->cat == C_REF ? r->elem : r;
            }
        }
    }
    fail("this expression is not an object", e->line);
}

void Gen::arith(const std::string &op, Kind k, int line)
{
    if (isFloat(k))
    {
        arithFloat(op, k, line);
        return;
    }
    bool u = isUnsigned(k);
    if (op == "+")
        a.alu(0x01, RAX, RCX);
    else if (op == "-")
        a.alu(0x29, RAX, RCX);
    else if (op == "*")
        a.imul(RAX, RCX);
    else if (op == "&")
        a.alu(0x21, RAX, RCX);
    else if (op == "|")
        a.alu(0x09, RAX, RCX);
    else if (op == "^")
        a.alu(0x31, RAX, RCX);
    else if (op == "/" || op == "%")
    {
        if (u)
        {
            a.alu(0x31, RDX, RDX);
            a.div(RCX);
        }
        else
        {
            a.cqo();
            a.idiv(RCX);
        }
        if (op == "%")
            a.movRR(RAX, RDX);
    }
    else if (op == "<<")
        a.shiftCl(4, RAX);
    else if (op == ">>")
        a.shiftCl(u ? 5 : 7, RAX);
    else
        fail("operator " + op, line);
    wrap(k);
}

NT Gen::binary(const cpp::ExprP &e)
{
    const std::string &op = e->op;
    if (op == "&&" || op == "||")
    {
        int shortCut = a.newLabel(), end = a.newLabel();
        truth(expr(asCondition(e->kids[0])));
        a.test(RAX, RAX);
        a.jcc(op == "&&" ? CC_E : CC_NE, shortCut);
        truth(expr(asCondition(e->kids[1])));
        a.test(RAX, RAX);
        a.setcc(CC_NE);
        a.jmp(end);
        a.bind(shortCut);
        a.movImm(RAX, op == "&&" ? 0 : 1);
        a.bind(end);
        return tInt(K_BOOL);
    }
    {
        bool found = false;
        NT r = operatorCall(op, e->kids, e->line, found);
        if (found)
            return r->cat == C_REF ? valueAt(r->elem) : r;
    }
    NT lt = expr(e->kids[0]);
    pushRax();
    NT rt = expr(e->kids[1]);
    a.movRR(RCX, RAX);
    popReg(RAX);
    if (lt->cat == C_REF)
        lt = lt->elem;
    if (rt->cat == C_REF)
        rt = rt->elem;
    if (!isScalar(lt) || !isScalar(rt))
        fail("operator " + op + " on an object without operator" + op, e->line);
    if ((op == "+" || op == "-") && (lt->cat == C_PTR || rt->cat == C_PTR))
    {
        if (lt->cat == C_PTR && rt->cat == C_INT)
        {
            a.imulImm(RCX, sizeOf(lt->elem));
            a.alu(op == "+" ? 0x01 : 0x29, RAX, RCX);
            return lt;
        }
        if (lt->cat == C_INT && rt->cat == C_PTR && op == "+")
        {
            a.imulImm(RAX, sizeOf(rt->elem));
            a.alu(0x01, RAX, RCX);
            return rt;
        }
        if (lt->cat == C_PTR && rt->cat == C_PTR && op == "-")
        {
            a.alu(0x29, RAX, RCX);
            a.cqo();
            a.movImm(RCX, sizeOf(lt->elem));
            a.idiv(RCX);
            return tInt(K_I64);
        }
        fail("this pointer arithmetic", e->line);
    }
    Kind lk = valKind(lt), rk = valKind(rt);
    if (op == "<<" || op == ">>")
    {
        Kind k = promote(lk);
        arith(op, k, e->line);
        return tInt(k);
    }
    Kind k = common(lk, rk);
    if (isFloat(k))
    {
        // both operands to k: rcx through rax
        convKind(lk, k);
        a.movRR(RDX, RAX);
        a.movRR(RAX, RCX);
        convKind(rk, k);
        a.movRR(RCX, RAX);
        a.movRR(RAX, RDX);
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=")
        {
            compareFloat(op, k);
            return tInt(K_BOOL);
        }
        arithFloat(op, k, e->line);
        return tInt(k);
    }
    if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=")
    {
        wrap(k, RAX);
        wrap(k, RCX);
        bool u = isUnsigned(k);
        int cc = op == "==" ? CC_E : op == "!=" ? CC_NE : op == "<" ? (u ? CC_B : CC_L)
               : op == ">" ? (u ? CC_A : CC_G) : op == "<=" ? (u ? CC_BE : CC_LE) : (u ? CC_AE : CC_GE);
        a.alu(0x39, RAX, RCX);
        a.setcc(cc);
        return tInt(K_BOOL);
    }
    if (lt->cat == C_PTR || rt->cat == C_PTR)
        fail("operator " + op + " on a pointer", e->line);
    wrap(k, RAX);
    wrap(k, RCX);
    arith(op, k, e->line);
    return tInt(k);
}

// [rdi] = [rsi], `size` bytes (rep movsb)
void Gen::copyBytes(int size)
{
    a.movImm(RCX, size);
    a.byte(0xF3);
    a.byte(0xA4);
}

NT Gen::assign(const cpp::ExprP &e)
{
    if (e->op == "=" && e->kids[1]->k == cpp::EK::InitList)
    {
        // x = {a, b}: an object of x's class built from the list, moved in
        NT lt = typeOfExpr(e->kids[0]);
        if (lt->cat == C_REF)
            lt = lt->elem;
        if (lt->cat == C_CLASS)
        {
            int slot = newSlot(lt);
            a.movImm(RAX, 0);
            for (int k = 0; k < alignUp(sizeOf(lt), 8); k += 8)
                a.store(slot + k, RAX);
            ThisSrc ts;
            ts.kind = TH_LOCAL;
            ts.off = slot;
            construct(ts, lt->cls, {e->kids[1]}, true, e->line);
            if (lt->cls->needsDtor)
                addTemp(slot, lt->cls);
            std::string name = "__assign" + std::to_string(++tempCount_);
            scopes_.back().vars[name] = Var{lt, false, slot};
            auto mv = keepExpr(mkName("move", e->line));
            mv->name = {"std", "move"};
            auto moved = keepExpr(mkExpr(cpp::EK::Call, "", {mv, keepExpr(mkName(name, e->line))}, e->line));
            return assign(keepExpr(mkExpr(cpp::EK::Assign, "=", {e->kids[0], moved}, e->line)));
        }
        if (e->kids[1]->kids.size() == 1)
            return assign(keepExpr(mkExpr(cpp::EK::Assign, "=", {e->kids[0], e->kids[1]->kids[0]}, e->line)));
    }
    {
        NT lt0 = typeOfExpr(e->kids[0]);
        if (lt0->cat == C_REF)
            lt0 = lt0->elem;
        if (lt0->cat == C_CLASS)
        {
            std::vector<Method *> ops;
            if (e->op != "=" || findMethod(lt0->cls, "operator=", ops))
            {
                bool found = false;
                NT r = operatorCall(e->op, e->kids, e->line, found);
                if (!found)
                    fail("no operator" + e->op + " for " + lt0->cls->name, e->line);
                return r->cat == C_REF ? r->elem : r;
            }
        }
    }
    if (e->op == "=")
    {
        NT rt = expr(e->kids[1]);
        pushRax();
        NT lt = addr(e->kids[0]);
        if (lt->cat == C_ARRAY && rt->cat == C_PTR)
        {
            // an array member copied whole (a generated operator=)
            a.movRR(RDI, RAX);
            popReg(RSI);
            pushRax();
            copyBytes(sizeOf(lt));
            popReg(RAX);
            return lt;
        }
        if (lt->cat == C_CLASS)
        {
            if (rt->cat != C_CLASS || !derivesFrom(rt->cls, lt->cls))
                fail("assigning a different type to an object", e->line);
            a.movRR(RDI, RAX);
            popReg(RSI);
            pushRax();
            int skip = lt->cls->polymorphic ? 8 : 0; // the target keeps its own vtable
            if (skip)
            {
                a.addImm(RDI, 8);
                a.addImm(RSI, 8);
            }
            copyBytes(sizeOf(lt) - skip);
            popReg(RAX);
            return lt;
        }
        if (!isScalar(lt))
            fail("assignment to an array", e->line);
        a.movRR(RCX, RAX);
        popReg(RAX);
        a.push(RCX);
        ++depth_;
        if (lt->cat == C_PTR && rt->cat == C_INT && e->kids[1]->k == cpp::EK::Int)
            ; // p = 0
        else
            convert(lt, rt, e->line);
        popReg(RCX);
        a.storeRcx(sizeOf(lt));
        return lt;
    }
    std::string op = e->op.substr(0, e->op.size() - 1);
    NT lt = addr(e->kids[0]);
    if (!isScalar(lt))
        fail("compound assignment to an object or array", e->line);
    pushRax(); // the address
    valueAt(lt);
    pushRax(); // the old value
    NT rt = expr(e->kids[1]);
    a.movRR(RCX, RAX);
    popReg(RAX);
    if (lt->cat == C_PTR)
    {
        if (rt->cat != C_INT || (op != "+" && op != "-"))
            fail("this pointer arithmetic", e->line);
        a.imulImm(RCX, sizeOf(lt->elem));
        a.alu(op == "+" ? 0x01 : 0x29, RAX, RCX);
    }
    else
    {
        Kind vk = lt->kind, rk = valKind(rt);
        Kind k = op == "<<" || op == ">>" ? promote(vk) : common(vk, rk);
        if (isFloat(k))
        {
            convKind(vk, k);
            a.movRR(RDX, RAX);
            a.movRR(RAX, RCX);
            convKind(rk, k);
            a.movRR(RCX, RAX);
            a.movRR(RAX, RDX);
            arithFloat(op, k, e->line);
            convKind(k, vk);
        }
        else
        {
            wrap(k, RAX);
            if (op != "<<" && op != ">>")
                wrap(k, RCX);
            arith(op, k, e->line);
            wrap(vk);
        }
    }
    popReg(RCX);
    a.storeRcx(sizeOf(lt));
    return lt;
}

NT Gen::incDec(const cpp::ExprP &e, bool inc, bool post)
{
    NT t = addr(e->kids[0]);
    if (!isScalar(t))
        fail("++/-- of an object or array", e->line);
    pushRax();
    valueAt(t);
    a.movRR(RDX, RAX); // the old value
    if (t->cat == C_INT && isFloat(t->kind))
    {
        a.movImm(RCX, (int64_t)ieeeBits(1.0, t->kind == K_F64 ? 52 : 23, t->kind == K_F64 ? 1023 : 127));
        arithFloat(inc ? "+" : "-", t->kind, e->line);
    }
    else
    {
        a.movImm(RCX, t->cat == C_PTR ? sizeOf(t->elem) : 1);
        a.alu(inc ? 0x01 : 0x29, RAX, RCX);
        if (t->cat == C_INT)
            wrap(t->kind);
    }
    popReg(RCX);
    a.storeRcx(sizeOf(t));
    if (post)
        a.movRR(RAX, RDX);
    return t;
}

// rax = the address a reference of type `ref` binds to: the object itself, or
// (a const reference to a value) a temporary holding the value
void Gen::bindRef(const NT &ref, const cpp::ExprP &e, int line)
{
    const NT &to = ref->elem;
    if (e->k == cpp::EK::InitList)
    {
        // {a, b} for a const T&: a temporary T built from the list
        int slot = newSlot(to);
        a.movImm(RAX, 0);
        for (int k = 0; k < alignUp(sizeOf(to), 8); k += 8)
            a.store(slot + k, RAX);
        localInit(slot, to, e, line);
        if (to->cat == C_CLASS && to->cls->needsDtor)
            addTemp(slot, to->cls);
        a.lea(RAX, slot);
        return;
    }
    NT t = rawType(e); // a call returning a reference is an lvalue
    if (e->k == cpp::EK::Name && e->name.size() == 1)
        if (Var *var = lookup(e->name[0]))
            t = var->type; // an array variable binds as the array
    bool lvalue = e->k == cpp::EK::Name || e->k == cpp::EK::Member || e->k == cpp::EK::Index ||
                  (e->k == cpp::EK::Unary && e->op == "*") || t->cat == C_REF || t->cat == C_CLASS;
    if (e->k == cpp::EK::Call && t->cat != C_REF && t->cat != C_CLASS)
        lvalue = false;
    NT bare = t->cat == C_REF ? t->elem : t;
    if (to->cat == C_CLASS && bare->cat == C_CLASS && !derivesFrom(bare->cls, to->cls))
    {
        // another class: a temporary T converted from it (a constructor)
        int slot = newSlot(to);
        a.movImm(RAX, 0);
        for (int k = 0; k < alignUp(sizeOf(to), 8); k += 8)
            a.store(slot + k, RAX);
        ThisSrc ts;
        ts.kind = TH_LOCAL;
        ts.off = slot;
        construct(ts, to->cls, {e}, false, line);
        if (to->cls->needsDtor)
            addTemp(slot, to->cls);
        a.lea(RAX, slot);
        return;
    }
    if (lvalue && (t->cat == C_CLASS || sameType(t->cat == C_REF ? t->elem : t, to)))
    {
        NT got = addr(e);
        if (to->cat == C_CLASS && (got->cat != C_CLASS || !derivesFrom(got->cls, to->cls)))
            fail("binding a reference to a different type", line);
        return;
    }
    if (to->cat == C_CLASS && t->cat != C_CLASS && (t->cat != C_REF || t->elem->cat != C_CLASS))
    {
        int slot = newSlot(to);
        a.movImm(RAX, 0);
        for (int k = 0; k < alignUp(sizeOf(to), 8); k += 8)
            a.store(slot + k, RAX);
        ThisSrc ts;
        ts.kind = TH_LOCAL;
        ts.off = slot;
        construct(ts, to->cls, {e}, false, line);
        if (to->cls->needsDtor)
            addTemp(slot, to->cls);
        a.lea(RAX, slot);
        return;
    }
    if (!ref->isConst && to->cat != C_CLASS)
        fail("binding a non-const reference to a value", line);
    // a temporary holding the converted value
    NT v = expr(e);
    if (to->cat == C_CLASS)
    {
        if (v->cat != C_CLASS || !derivesFrom(v->cls, to->cls))
            fail("binding a reference to a different type", line);
        return; // a temporary object already
    }
    if (to->cat == C_PTR && v->cat == C_PTR)
        ;
    else
        convert(to, v, line);
    int slot = newSlot(to);
    a.lea(RCX, slot);
    a.storeRcx(sizeOf(to));
    a.lea(RAX, slot);
}

// Overload resolution: the cost of passing `arg` (of type argT) to `param`
// An rvalue: a temporary, or a std::move result (an lvalue names an object)
bool isRvalue(const cpp::ExprP &e, const NT &t)
{
    if (t->cat == C_REF)
        return t->rvalue;
    switch (e->k)
    {
    case cpp::EK::Name:
    case cpp::EK::Member:
    case cpp::EK::Index:
    case cpp::EK::Str:
        return false;
    case cpp::EK::Unary:
        return e->op != "*" && e->op != "++" && e->op != "--";
    case cpp::EK::Assign:
        return false;
    default:
        return true;
    }
}

int Gen::argCost(const NT &param, const cpp::ExprP &arg, const NT &argT)
{
    if (arg->k == cpp::EK::InitList)
    {
        NT p = param->cat == C_REF ? param->elem : param;
        if (p->cat == C_CLASS)
        {
            if (!listBuilds(p->cls, arg->kids))
                return -1;
            if (p->cls->templateName == "initializer_list")
                return 0; // an initializer_list parameter takes a braced list as it is
            return param->cat == C_REF && !param->rvalue ? 5 : 4; // built from the list (a temporary: T&& binds it best)
        }
        return arg->kids.size() <= 1 ? 2 : -1;
    }
    if (param->cat == C_REF)
    {
        bool rv = rvalueExpr(arg);
        if (param->rvalue && !rv)
            return -1; // T&& takes no lvalue
        if (!param->rvalue && !param->isConst && rv && param->elem->cat == C_CLASS)
            return -1; // T& takes no temporary
        int c = argCost(param->elem, arg, argT->cat == C_REF ? argT->elem : argT);
        if (c < 0)
            return c;
        return c + (rv && !param->rvalue ? 1 : 0);
    }
    NT p = param->cat == C_REF ? param->elem : param;
    NT t = argT->cat == C_REF ? argT->elem : argT;
    if (sameType(p, t))
        return 0;
    if (p->cat == C_INT && t->cat == C_INT)
        return promote(t->kind) == p->kind || (t->kind == K_F32 && p->kind == K_F64) ? 1 : 2;
    if (p->cat == C_PTR && p->elem->cat == C_FUNC && isClosure(t))
        return 5; // a captureless lambda converts
    if (p->cat == C_PTR && t->cat == C_PTR)
    {
        if (p->elem->cat == C_VOID)
            return 3;
        if (p->elem->cat == C_CLASS && t->elem->cat == C_CLASS && derivesFrom(t->elem->cls, p->elem->cls))
            return 2;
        if (t->elem->cat == C_VOID && arg->k == cpp::EK::Nullptr)
            return 1;
        return -1;
    }
    if (p->cat == C_PTR && t->cat == C_INT && arg->k == cpp::EK::Int && arg->str == "0")
        return 3;
    if (p->cat == C_CLASS && t->cat == C_CLASS && derivesFrom(t->cls, p->cls))
        return 2;
    if (p->cat == C_CLASS && t->cat == C_CLASS && convOp(t->cls, p))
        return 5; // its operator P()
    if (p->cat == C_CLASS)
    {
        // a converting constructor taking it
        for (Method *c : p->cls->ctors)
            if (c->params.size() == 1 && !(c->decl && c->decl->isExplicit))
            {
                NT cp = c->params[0]->cat == C_REF ? c->params[0]->elem : c->params[0];
                if (sameType(cp, t) || (cp->cat == C_INT && t->cat == C_INT))
                    return 5;
            }
        // a converting constructor template that fits it
        if (p->cls->memberTemplates.count("") && t->cat == C_CLASS && t->cls != p->cls)
        {
            std::vector<Method *> inst;
            std::vector<cpp::ExprP> one = {arg};
            templateMembers(p->cls, "", one, {}, false, arg->line, inst);
            for (Method *c : inst)
                if (c->params.size() == 1 && !(c->decl && c->decl->isExplicit) && argCost(c->params[0], arg, argT) >= 0)
                    return 6;
        }
    }
    return -1;
}

Method *Gen::resolve(const std::vector<Method *> &cands, const std::vector<cpp::ExprP> &args, const std::string &what,
                     int line)
{
    if (cands.size() == 1 && cands[0]->params.size() == args.size())
        return cands[0];
    std::vector<NT> types;
    for (const cpp::ExprP &x : args)
        types.push_back(rawType(x));
    Method *best = nullptr;
    int bestCost = 1 << 30;
    bool tie = false;
    for (Method *m : cands)
    {
        if (args.size() > m->params.size())
            continue;
        bool ok = true;
        for (size_t i = args.size(); i < m->params.size(); ++i)
            if (!m->defaults[i])
                ok = false;
        int cost = 0;
        for (size_t i = 0; ok && i < args.size(); ++i)
        {
            int c = argCost(m->params[i], args[i], types[i]);
            if (c < 0)
                ok = false;
            cost += c;
        }
        if (!ok)
            continue;
        if (cost < bestCost)
        {
            best = m;
            bestCost = cost;
            tie = false;
        }
        else if (cost == bestCost)
        {
            // f() and f() const: the same call either way (constness is not
            // tracked), so the non-const one
            bool sameParams = best->params.size() == m->params.size();
            for (size_t i = 0; sameParams && i < m->params.size(); ++i)
                sameParams = sameType(best->params[i], m->params[i]);
            bool bestConst = best->decl && best->decl->isConst, mConst = m->decl && m->decl->isConst;
            if (sameParams && bestConst != mConst)
            {
                if (bestConst)
                    best = m;
            }
            else if (best->fromTemplate != m->fromTemplate)
            {
                if (best->fromTemplate)
                    best = m;
            }
            else if (sameParams && best->fromTemplate && specialization(m) != specialization(best))
            {
                // partial ordering, roughly: swap(basic_string<C>&, ...) over swap(T&, T&)
                if (specialization(m) > specialization(best))
                    best = m;
            }
            else
                tie = true;
        }
    }
    if (!best)
    {
        std::string msg = "no " + what + " matches these arguments (";
        for (size_t i = 0; i < types.size(); ++i)
            msg += (i ? ", " : "") + typeKey(types[i]);
        msg += "); candidates:";
        for (Method *m : cands)
        {
            msg += " (";
            for (size_t i = 0; i < m->params.size(); ++i)
                msg += (i ? ", " : "") + typeKey(m->params[i]);
            msg += ")";
        }
        fail(msg, line);
    }
    if (tie)
        fail("ambiguous call of " + what, line);
    return best;
}

// A call: the result's place, this, then the arguments, in the argument
// registers / stack slots. Returns the result type (a class result: its
// address in rax).
NT Gen::callMethod(Method *m, const ThisSrc &self, const std::vector<cpp::ExprP> &argsIn, bool virt, int line,
                   const ThisSrc *result, int indirect)
{
    if (!m->ret)
        deduceReturn(m);
    if (!m->used && cur_)
        m->usedBy = (cur_->owner ? cur_->owner->name + "::" : "") + cur_->name + " (line " + std::to_string(line) + ")";
    m->used = true;
    std::vector<cpp::ExprP> args = argsIn;
    for (size_t i = args.size(); i < m->params.size(); ++i)
        args.push_back(m->defaults[i]);
    bool hasThis = m->owner && !m->isStatic && self.kind != TH_NONE;
    if (m->owner && !m->isStatic && !hasThis)
        fail("calling member function " + m->name + " without an object", line);
    bool classRet = m->ret->cat == C_CLASS;
    ThisSrc place; // where the result is built
    if (classRet && result)
        place = *result;
    else if (classRet)
    {
        place.kind = TH_LOCAL; // a temporary
        place.off = newSlot(m->ret);
        if (m->ret->cls->needsDtor)
            addTemp(place.off, m->ret->cls);
    }
    int n = (classRet ? 1 : 0) + (hasThis ? 1 : 0) + (int)args.size();
    int onStack = n > 4 ? n - 4 : 0;
    int pad = (depth_ + onStack + 4) % 2;
    if (pad)
    {
        a.subRsp(8);
        ++depth_;
    }
    for (int i = (int)args.size() - 1; i >= 0; --i)
    {
        NT pt = m->params[i];
        // a default argument: named from the callee's scope, never the caller's locals
        bool dflt = i >= (int)argsIn.size();
        std::string callerNs = curNs_;
        std::vector<Scope> callerScopes;
        if (dflt)
        {
            curNs_ = m->ns;
            std::swap(callerScopes, scopes_);
            scopes_.emplace_back();
        }
        if (pt->cat == C_REF)
            bindRef(pt, args[i], line);
        else if (pt->cat == C_CLASS)
        {
            // by value: a copy in the caller's frame, passed by address
            int slot = newSlot(pt);
            std::vector<cpp::ExprP> one = {args[i]};
            ThisSrc cs;
            cs.kind = TH_LOCAL;
            cs.off = slot;
            if (args[i]->k == cpp::EK::InitList)
                construct(cs, pt->cls, one, true, line); // the list whole: construct takes one level off
            else
                construct(cs, pt->cls, one, false, line);
            if (pt->cls->needsDtor)
                addTemp(slot, pt->cls);
            a.lea(RAX, slot);
        }
        else if (pt->cat == C_PTR && pt->elem->cat == C_FUNC && isClosure(typeOfExpr(args[i])))
        {
            NT ct = typeOfExpr(args[i]);
            a.leaLabel(RAX, lambdaFunction(ct->cat == C_REF ? ct->elem->cls : ct->cls, line)->label);
        }
        else
        {
            NT at = expr(args[i]);
            if (at->cat == C_REF)
                at = valueAt(at->elem);
            if (pt->cat == C_PTR && at->cat == C_INT && args[i]->k == cpp::EK::Int)
                ; // 0 as a null pointer
            else
                convert(pt, at, line);
        }
        if (dflt)
        {
            std::swap(callerScopes, scopes_);
            curNs_ = callerNs;
        }
        pushRax();
    }
    if (hasThis)
    {
        loadThis(self);
        pushRax();
    }
    if (classRet)
    {
        loadThis(place);
        pushRax();
    }
    for (int i = 0; i < n && i < 4; ++i)
        popReg(kArgRegs[i]);
    a.subRsp(32);
    if (!m->dll.empty())
    {
        // the Windows ABI: floating-point arguments in xmm0-3, the result in xmm0
        for (int i = 0; i < n && i < 4 && i < (int)m->params.size(); ++i)
        {
            const NT &pt = m->params[i];
            if (pt->cat == C_INT && isFloat(pt->kind))
                a.toXmm(i, kArgRegs[i], pt->kind == K_F64);
        }
        a.callImport(importIndex(m->dll, m->decl->name.back()));
        a.addRsp(32 + 8 * (onStack + pad));
        depth_ -= onStack + pad;
        if (m->ret->cat == C_INT && isFloat(m->ret->kind))
            a.fromXmm(RAX, 0, m->ret->kind == K_F64);
        else if (m->ret->cat == C_INT)
            wrap(m->ret->kind); // its result's upper bits are not defined
        return m->ret;
    }
    if (indirect)
    {
        a.load(RAX, indirect); // through a function pointer
        a.callReg(RAX);
    }
    else if (virt && m->isVirtual)
    {
        int thisReg = kArgRegs[classRet ? 1 : 0];
        a.loadInd(RAX, thisReg);     // the vtable
        a.addImm(RAX, 8 * m->vslot);
        a.loadInd(RAX, RAX);
        a.callReg(RAX);
    }
    else
        a.call(m->label);
    a.addRsp(32 + 8 * (onStack + pad));
    depth_ -= onStack + pad;
    if (classRet)
        loadThis(place);
    return m->ret;
}

NT Gen::call(const cpp::ExprP &e, const ThisSrc *result)
{
    const cpp::ExprP &callee = e->kids[0];
    std::vector<cpp::ExprP> args(e->kids.begin() + 1, e->kids.end());
    // obj.f(...) / p->f(...)
    if (callee->k == cpp::EK::Member)
    {
        cpp::ExprP objExpr = callee->kids[0];
        NT ot = typeOfExpr(objExpr);
        if (ot->cat == C_REF)
            ot = ot->elem;
        if (callee->arrow && ot->cat == C_CLASS)
        {
            objExpr = arrowBase(objExpr); // it->f(): it.operator->()->f()
            ot = typeOfExpr(objExpr);
        }
        if (callee->arrow)
            ot = ot->cat == C_PTR ? ot->elem : ot;
        if (ot->cat != C_CLASS)
            fail("a member call on a non-object", e->line);
        std::vector<Method *> cands;
        if ((callee->op == "emplace_back" || callee->op == "emplace_front") && !findMethod(ot->cls, callee->op, cands))
        {
            std::vector<Method *> slotFns;
            if (findMethod(ot->cls, "__emplace_raw", slotFns))
            {
                // the new element's raw storage, the element built there from args
                auto slotMember = keepExpr(mkExpr(cpp::EK::Member, "__emplace_raw", {objExpr}, e->line));
                slotMember->arrow = callee->arrow;
                cpp::ExprP slotCall = keepExpr(mkExpr(cpp::EK::Call, "", {slotMember}, e->line));
                NT st = call(slotCall);
                NT el = st->cat == C_PTR ? st->elem : st;
                int ptr = newSlot(tPtr(el));
                a.store(ptr, RAX);
                if (el->cat == C_CLASS)
                {
                    ThisSrc es;
                    es.kind = TH_INDIRECT;
                    es.off = ptr;
                    construct(es, el->cls, args, false, e->line);
                }
                else
                {
                    if (args.size() != 1)
                        fail("emplace_back of a scalar with " + std::to_string(args.size()) + " values", e->line);
                    NT v = expr(args[0]);
                    if (v->cat == C_REF)
                        v = valueAt(v->elem);
                    if (!(el->cat == C_PTR && v->cat == C_PTR))
                        convert(el, v, e->line);
                    a.load(RCX, ptr);
                    a.storeRcx(sizeOf(el));
                }
                a.load(RAX, ptr);
                return tRef(el, false);
            }
        }
        findMethod(ot->cls, callee->op, cands);
        templateMembers(ot->cls, callee->op, args, callee->targs, callee->hasTargs, e->line, cands);
        int foff = 0;
        if (cands.empty() && findField(ot->cls, callee->op, foff))
        {
            // a data member called: a function pointer, or an object's operator()
            NT ft = typeOfExpr(callee);
            if (ft->cat == C_REF)
                ft = ft->elem;
            if (ft->cat == C_PTR && ft->elem->cat == C_FUNC)
                return indirectCall(callee, ft->elem, args, e->line, result);
            std::vector<cpp::ExprP> kids = {callee};
            kids.insert(kids.end(), args.begin(), args.end());
            bool found = false;
            NT r = operatorCall("()", kids, e->line, found, result);
            if (found)
                return r;
        }
        if (cands.empty())
            fail("class " + ot->cls->name + " has no member function " + callee->op, e->line);
        Method *m = resolve(cands, args, ot->cls->name + "::" + callee->op, e->line);
        ThisSrc self;
        self.kind = callee->arrow ? TH_PTR : TH_OBJ;
        self.e = objExpr;
        return callMethod(m, self, args, true, e->line, result);
    }
    if (callee->k != cpp::EK::Name)
    {
        // an object expression (T{}(x), f()(x), (*p)(x)): its operator()
        NT ct = typeOfExpr(callee);
        if (ct->cat == C_REF)
            ct = ct->elem;
        if (ct->cat == C_PTR && ct->elem->cat == C_FUNC)
            return indirectCall(callee, ct->elem, args, e->line, result);
        if (ct->cat == C_FUNC)
            return indirectCall(callee, ct, args, e->line, result);
        if (ct->cat == C_CLASS)
        {
            std::vector<cpp::ExprP> kids = {callee};
            kids.insert(kids.end(), args.begin(), args.end());
            bool found = false;
            NT r = operatorCall("()", kids, e->line, found, result);
            if (found)
                return r;
        }
        fail("this call (not yet: function pointers)", e->line);
    }
    // std::move(x) / std::forward<T>(x): x itself, as an rvalue
    if ((callee->name.size() == 2 && callee->name[0] == "std" &&
         (callee->name[1] == "move" || callee->name[1] == "forward")) ||
        (callee->name.size() == 1 && (callee->name[0] == "move" || callee->name[0] == "forward") &&
         findFunc(callee->name).empty()))
    {
        if (args.size() != 1)
            fail("std::move takes 1 argument", e->line);
        if (callee->name.back() == "forward" && callee->hasTargs && callee->targs.size() == 1)
        {
            // the argument may have parsed as an expression (a template parameter's name)
            const cpp::TArg &ta = callee->targs[0];
            NT ft;
            if (ta.type)
                ft = typeOf(ta.type, e->line);
            else if (ta.expr && ta.expr->k == cpp::EK::Name && ta.expr->name.size() == 1 && bind_ &&
                     bind_->types.count(ta.expr->name[0]))
                ft = bind_->types[ta.expr->name[0]];
            else
                ft = tVoid();
            if (ft->cat == C_REF && !ft->rvalue)
            {
                NT got = addr(args[0]); // forwarding an lvalue
                return tRef(got, false);
            }
        }
        NT t = typeOfExpr(args[0]);
        if (t->cat == C_REF)
            t = t->elem;
        if (t->cat == C_CLASS || e->k == cpp::EK::Name || true)
        {
            NT got = addr(args[0]);
            return tRef(got, false, true);
        }
    }
    if (callee->name.size() == 2 && callee->name[0] == "std" &&
        (callee->name[1] == "printf" || callee->name[1] == "fprintf" || callee->name[1] == "sprintf" ||
         callee->name[1] == "snprintf"))
        return printfCall(callee->name[1], args, e->line);
    {
        const std::string &fn = callee->name.back();
        bool stdName = (callee->name.size() == 2 && callee->name[0] == "std") ||
                       (callee->name.size() == 1 && findFunc(callee->name).empty());
        if (stdName && !args.empty() &&
            (fn == "get" || fn == "get_if" || fn == "holds_alternative" || fn == "visit"))
        {
            NT vt = typeOfExpr(args.back());
            if (vt->cat == C_REF)
                vt = vt->elem;
            if (fn == "get_if" && vt->cat == C_PTR)
                vt = vt->elem;
            if (vt->cat == C_CLASS && vt->cls->variantN)
                return variantCall(fn, callee, args, vt->cls, e->line, result);
        }
        if (stdName && (fn == "make_unique" || fn == "make_shared") && callee->hasTargs &&
            callee->targs.size() == 1 && callee->targs[0].type)
        {
            // std::unique_ptr<T>(new T(args)) / std::shared_ptr<T>(new T(args))
            cpp::ExprP nw = keepExpr(mkExpr(cpp::EK::New, "", args, e->line));
            nw->type = callee->targs[0].type;
            auto tn = std::make_shared<cpp::TypeName>();
            tn->name = {"std", fn == "make_unique" ? "unique_ptr" : "shared_ptr"};
            tn->targs.assign(2, std::vector<cpp::TArg>());
            tn->targs.back().push_back(callee->targs[0]);
            tn->hasTargs = true;
            NT pt = typeOf(tn, e->line);
            if (result)
            {
                construct(*result, pt->cls, {nw}, false, e->line);
                loadThis(*result);
                return pt;
            }
            cpp::ExprP ce = keepExpr(mkExpr(cpp::EK::Construct, "", {nw}, e->line));
            ce->type = tn;
            return expr(ce);
        }
        if ((fn == "__atomic_xchg" || fn == "__atomic_add") && args.size() == 2)
        {
            // the old 64-bit value at p; it becomes v (xchg) or old + v (lock xadd)
            expr(args[0]);
            pushRax();
            NT vt = expr(args[1]);
            if (vt->cat == C_REF)
                vt = vt->elem;
            a.movRR(RDX, RAX);
            popReg(RCX);
            if (fn == "__atomic_add")
                a.byte(0xF0); // lock
            a.byte(0x48);
            if (fn == "__atomic_xchg")
                a.byte(0x87); // xchg [rcx], rdx
            else
            {
                a.byte(0x0F);
                a.byte(0xC1); // xadd [rcx], rdx
            }
            a.byte(0x11);
            a.movRR(RAX, RDX);
            return tInt(K_I64);
        }
        if (fn == "__atomic_cas" && args.size() == 3)
        {
            // the old 64-bit value at p; it becomes desired when it was expected
            expr(args[0]);
            pushRax();
            expr(args[1]);
            pushRax();
            expr(args[2]);
            a.movRR(RDX, RAX);
            popReg(RAX);
            popReg(RCX);
            a.byte(0xF0); // lock cmpxchg [rcx], rdx
            a.byte(0x48);
            a.byte(0x0F);
            a.byte(0xB1);
            a.byte(0x11);
            return tInt(K_I64);
        }
        if (fn == "__native_thread_entry" && args.empty())
        {
            // a thread's start address: a thunk keeping the registers Windows
            // expects kept, calling std::__thread_main(its argument)
            auto tm = funcs_.find("std::__thread_main");
            if (tm == funcs_.end() || tm->second.empty())
                fail("__native_thread_entry needs <thread>", e->line);
            Method *main = tm->second[0];
            main->used = true;
            int skip = a.newLabel(), thunk = a.newLabel();
            a.jmp(skip);
            a.bind(thunk);
            a.push(RBX);
            a.push(RSI);
            a.push(RDI);
            a.push(RBP);
            a.subRsp(40);
            a.call(main->label);
            a.addRsp(40);
            a.pop(RBP);
            a.pop(RDI);
            a.pop(RSI);
            a.pop(RBX);
            a.ret();
            a.bind(skip);
            a.leaLabel(RAX, thunk);
            return tPtr(tVoid());
        }
        if (fn == "__shared_hook" && callee->name.size() == 1 && args.size() == 2)
        {
            // shared_ptr's new owner: an enable_shared_from_this object learns its count block
            NT pt = typeOfExpr(args[0]);
            if (pt->cat == C_REF)
                pt = pt->elem;
            int off = 0;
            if (pt->cat == C_PTR && pt->elem->cat == C_CLASS && findField(pt->elem->cls, "__self_count", off))
            {
                expr(args[1]);
                pushRax();
                expr(args[0]);
                popReg(RCX);
                if (off)
                    a.addImm(RAX, off);
                a.storeInd(RAX, RCX);
            }
            return tVoid();
        }
    }
    // Class::f(...): a static member, or a base class's version
    if (callee->name.size() >= 2 && findFunc(callee->name).empty())
        if (cpp::ExprP ce = typeConstruct(e))
            return constructInto(ce, result); // ns::Type(args)
    if (callee->name.size() >= 2)
    {
        std::vector<std::string> owner(callee->name.begin(), callee->name.end() - 1);
        ClassInfo *c = nullptr;
        bool ownerTargs = false;
        for (size_t k = 0; k + 1 < callee->scopeTargs.size() && k < owner.size(); ++k)
            if (!callee->scopeTargs[k].empty())
                ownerTargs = true;
        if (ownerTargs)
        {
            // X<T>::f(...): the instance X<T>
            auto ot = std::make_shared<cpp::TypeName>();
            ot->name = owner;
            ot->targs.assign(callee->scopeTargs.begin(), callee->scopeTargs.begin() + owner.size());
            ot->hasTargs = true;
            NT t = typeOf(ot, e->line);
            if (t->cat == C_CLASS)
                c = t->cls;
        }
        else
            c = findClass(owner);
        if (!c && owner.size() == 1 && bind_ && bind_->types.count(owner[0]) &&
            bind_->types[owner[0]]->cat == C_CLASS)
            c = bind_->types[owner[0]]->cls; // T::f() with T a template parameter
        if (!c)
            for (const std::string &k : candidates(owner))
                if (aliases_.count(k))
                {
                    // Alias::f(): through the type it names
                    auto ot = std::make_shared<cpp::TypeName>();
                    ot->name = owner;
                    NT t = typeOf(ot, e->line);
                    if (t->cat == C_CLASS)
                        c = t->cls;
                    break;
                }
        if (c)
        {
            std::vector<Method *> cands;
            if (!findMethod(c, callee->name.back(), cands))
                fail("unknown member function " + joinName(callee->name), e->line);
            Method *m = resolve(cands, args, joinName(callee->name), e->line);
            ThisSrc self;
            if (!m->isStatic)
                self.kind = TH_CUR;
            return callMethod(m, self, args, false, e->line, result);
        }
        // ns::f(...)
        std::vector<Method *> cands = functionCands(callee->name.back(), args, callee, e->line);
        if (cands.empty())
            fail("unknown function " + joinName(callee->name), e->line);
        Method *m = resolve(cands, args, joinName(callee->name), e->line);
        return callMethod(m, ThisSrc(), args, false, e->line, result);
    }
    const std::string &name = callee->name[0];
    // ::f with no global f: the runtime's (std::floor calling ::floor)
    bool runtimeOnly = callee->global && !funcs_.count(name) && !funcTemplates_.count(name);
    // a local variable hides the class's members: its operator() / the function it points to
    if (!runtimeOnly)
    {
        bool local = false;
        for (const Scope &sc : scopes_)
            if (sc.vars.count(name) && !sc.vars.at(name).global)
                local = true;
        if (local)
        {
            NT vt = typeOfExpr(callee);
            if (vt->cat == C_REF)
                vt = vt->elem;
            if (vt->cat == C_PTR && vt->elem->cat == C_FUNC)
                return indirectCall(callee, vt->elem, args, e->line, result);
            if (vt->cat == C_CLASS)
            {
                std::vector<cpp::ExprP> kids = {callee};
                kids.insert(kids.end(), args.begin(), args.end());
                bool found = false;
                NT r = operatorCall("()", kids, e->line, found, result);
                if (found)
                    return r;
            }
        }
    }
    // a member function of the current class
    if (cur_ && cur_->owner && !runtimeOnly)
    {
        std::vector<Method *> cands;
        findMethod(cur_->owner, name, cands);
        templateMembers(cur_->owner, name, args, callee->targs, callee->hasTargs, e->line, cands);
        if (!cands.empty())
        {
            Method *m = resolve(cands, args, name, e->line);
            ThisSrc self;
            if (!m->isStatic)
                self.kind = TH_CUR;
            return callMethod(m, self, args, true, e->line, result);
        }
        if (cur_->owner->outer && findMethod(cur_->owner->outer, name, cands))
        {
            // in a lambda: the captured object's member function
            Method *m = resolve(cands, args, name, e->line);
            ThisSrc self;
            if (!m->isStatic)
                self.kind = TH_OUTER;
            return callMethod(m, self, args, true, e->line, result);
        }
    }
    // a variable of class type: its operator()
    if (!runtimeOnly && (lookup(name) || (cur_ && cur_->owner && !cur_->isStatic)))
    {
        int off = 0;
        Var *v = lookup(name);
        bool field = !v && cur_ && cur_->owner && findField(cur_->owner, name, off);
        if (v || field)
        {
            NT vt = typeOfExpr(callee);
            if (vt->cat == C_REF)
                vt = vt->elem;
            if (vt->cat == C_PTR && vt->elem->cat == C_FUNC)
                return indirectCall(callee, vt->elem, args, e->line, result);
            if (vt->cat == C_FUNC)
                return indirectCall(callee, vt, args, e->line, result);
            std::vector<cpp::ExprP> kids = {callee};
            kids.insert(kids.end(), args.begin(), args.end());
            bool found = false;
            NT r = operatorCall("()", kids, e->line, found, result);
            if (found)
                return r;
            fail(name + " is not a function", e->line);
        }
    }
    std::vector<Method *> cands;
    if (!runtimeOnly)
        cands = functionCands(name, args, callee, e->line);
    if (!cands.empty())
    {
        Method *m = resolve(cands, args, name, e->line);
        return callMethod(m, ThisSrc(), args, false, e->line, result);
    }
    // T(args) where T names a type (an alias, a template instance): a temporary
    if (cpp::ExprP ce = typeConstruct(e))
        return constructInto(ce, result);
    if (name == "printf" || name == "fprintf" || name == "sprintf" || name == "snprintf")
        return printfCall(name, args, e->line);
    // the C library routines the runtime provides
    int label = -1;
    std::vector<NT> params;
    NT ret;
    if (name == "sqrt" || name == "fabs" || name == "floor" || name == "ceil" || name == "trunc")
    {
        if (args.size() != 1)
            fail(name + " takes 1 argument", e->line);
        NT at = expr(args[0]);
        convert(tInt(K_F64), at, e->line);
        if (name == "fabs")
        {
            a.movImm(RCX, 0x7FFFFFFFFFFFFFFFLL);
            a.alu(0x21, RAX, RCX);
            return tInt(K_F64);
        }
        a.toXmm(0, RAX, true);
        if (name == "sqrt")
            a.sse(0xF2, 0x51, 0, 0);
        else
        {
            // roundsd xmm0, xmm0, mode (SSE4.1): 1 down, 2 up, 3 toward zero
            a.byte(0x66);
            a.byte(0x0F);
            a.byte(0x3A);
            a.byte(0x0B);
            a.byte(0xC0);
            a.byte(name == "floor" ? 1 : name == "ceil" ? 2 : 3);
        }
        a.fromXmm(RAX, 0, true);
        return tInt(K_F64);
    }
    if (name == "__native_construct" || name == "__native_construct_move" || name == "__native_destroy")
    {
        // (T *p, value): a T built at p from the value (copied, or moved);
        // (T *p): the T at p destroyed. p is raw storage (vector's).
        NT pt = typeOfExpr(args[0]);
        if (pt->cat == C_REF)
            pt = pt->elem;
        if (pt->cat != C_PTR)
            fail(name + " needs a pointer", e->line);
        NT el = pt->elem;
        expr(args[0]);
        int ptr = newSlot(tPtr(el));
        a.store(ptr, RAX);
        ThisSrc ps;
        ps.kind = TH_INDIRECT;
        ps.off = ptr;
        if (name == "__native_destroy")
        {
            if (el->cat == C_CLASS && el->cls->needsDtor)
                destroy(ps, el->cls);
            return tVoid();
        }
        if (args.size() != 2)
            fail(name + " takes 2 arguments", e->line);
        if (el->cat == C_CLASS)
        {
            cpp::ExprP v = args[1];
            if (name == "__native_construct_move")
            {
                // std::move(value): the move constructor when there is one
                auto mv = keepExpr(mkName("move", e->line));
                mv->name = {"std", "move"};
                v = keepExpr(mkExpr(cpp::EK::Call, "", {mv, args[1]}, e->line));
            }
            construct(ps, el->cls, {v}, false, e->line);
        }
        else
        {
            NT v = expr(args[1]);
            if (v->cat == C_REF)
                v = valueAt(v->elem);
            if (!(el->cat == C_PTR && (v->cat == C_PTR || v->cat == C_INT)))
                convert(el, v, e->line);
            a.load(RCX, ptr);
            a.storeRcx(sizeOf(el));
        }
        return tVoid();
    }
    if (name == "__native_read")
    {
        if (args.size() != 3)
            fail("__native_read takes 3 arguments", e->line);
        for (int i = 2; i >= 0; --i)
        {
            NT at = expr(args[i]);
            if (at->cat == C_REF)
                at = at->elem;
            if (at->cat == C_INT)
                convKind(at->kind, K_I64);
            pushRax();
        }
        popReg(RCX);
        popReg(RDX);
        popReg(R8);
        callRoutine(routine("read"));
        return tInt(K_I64);
    }
    if (name == "__native_write")
    {
        // (fd, const char *bytes, long long count): the library's output
        if (args.size() != 3)
            fail("__native_write takes 3 arguments", e->line);
        for (int i = 2; i >= 0; --i)
        {
            NT at = expr(args[i]);
            if (at->cat == C_REF)
                at = at->elem;
            if (at->cat == C_INT)
                convKind(at->kind, K_I64);
            pushRax();
        }
        popReg(RCX);
        popReg(RDX);
        popReg(R8);
        callRoutine(routine("write"));
        return tInt(K_I64);
    }
    if (name == "putchar")
    {
        label = routine("putchar");
        params = {tInt(K_I32)};
        ret = tInt(K_I32);
    }
    else if (name == "puts")
    {
        label = routine("puts");
        params = {tPtr(tInt(K_I8))};
        ret = tInt(K_I32);
    }
    else if (name == "malloc")
    {
        label = routine("alloc");
        params = {tInt(K_U64)};
        ret = tPtr(tVoid());
    }
    else if (name == "free")
    {
        label = routine("free");
        params = {tPtr(tVoid())};
        ret = tVoid();
    }
    else
        fail("unknown function " + name, e->line);
    if (args.size() != params.size())
        fail(name + " takes " + std::to_string(params.size()) + " arguments", e->line);
    NT at = expr(args[0]);
    if (!(params[0]->cat == C_PTR && at->cat == C_PTR))
        convert(params[0], at, e->line);
    a.movRR(RCX, RAX);
    callRoutine(label);
    return ret;
}

// An operator on an object: a member operator<op> of the first operand's
// class, or a free operator<op> function. `found` is false when neither
// exists (the built-in operator applies).
NT Gen::operatorCall(const std::string &op, const std::vector<cpp::ExprP> &kids, int line, bool &found,
                     const ThisSrc *result)
{
    found = false;
    std::vector<NT> types;
    bool anyClass = false;
    for (const cpp::ExprP &k : kids)
    {
        NT t = typeOfExpr(k);
        if (t->cat == C_REF)
            t = t->elem;
        types.push_back(t);
        if (t->cat == C_CLASS)
            anyClass = true;
    }
    if (!anyClass)
        return tVoid();
    std::string name = "operator" + op;
    if (types[0]->cat == C_CLASS)
    {
        std::vector<Method *> all, cands;
        findMethod(types[0]->cls, name, all);
        {
            std::vector<cpp::ExprP> rest(kids.begin() + 1, kids.end());
            templateMembers(types[0]->cls, name, rest, {}, false, line, all);
        }
        for (Method *m : all)
            if (m->params.size() + 1 == kids.size() ||
                (op == "()" || op == "[]"))
                cands.push_back(m);
        if (!cands.empty())
        {
            std::vector<cpp::ExprP> args(kids.begin() + 1, kids.end());
            Method *m = resolve(cands, args, types[0]->cls->name + "::" + name, line);
            ThisSrc self;
            self.kind = TH_OBJ;
            self.e = kids[0];
            found = true;
            return callMethod(m, self, args, false, line, result);
        }
    }
    std::vector<Method *> cands = functionCands(name, kids, nullptr, line);
    std::vector<Method *> fit;
    for (Method *m : cands)
        if (m->params.size() == kids.size())
            fit.push_back(m);
    if (fit.empty())
        return tVoid();
    Method *m = resolve(fit, kids, name, line);
    found = true;
    return callMethod(m, ThisSrc(), kids, false, line, result);
}

// `f(args)` parsed as a construction of the std type named f (see program())
void callsNamedLikeTypes(const cpp::ExprP &e, const std::set<std::string> &fs, const std::set<std::string> &ts);
void callsNamedLikeTypes(const cpp::StmtP &s, const std::set<std::string> &fs, const std::set<std::string> &ts);
void callsNamedLikeTypes(const cpp::DeclP &d, const std::set<std::string> &fs, const std::set<std::string> &ts)
{
    if (!d)
        return;
    for (const cpp::Param &pr : d->params)
        callsNamedLikeTypes(pr.def, fs, ts);
    for (const cpp::MemInit &mi : d->inits)
        for (const cpp::ExprP &x : mi.args)
            callsNamedLikeTypes(x, fs, ts);
    callsNamedLikeTypes(d->body, fs, ts);
    for (const cpp::ExprP &x : d->var.args)
        callsNamedLikeTypes(x, fs, ts);
    for (const cpp::DeclP &m : d->members)
        callsNamedLikeTypes(m, fs, ts);
    for (const cpp::DeclP &m : d->decls)
        callsNamedLikeTypes(m, fs, ts);
}
void callsNamedLikeTypes(const cpp::StmtP &s, const std::set<std::string> &fs, const std::set<std::string> &ts)
{
    if (!s)
        return;
    callsNamedLikeTypes(s->expr, fs, ts);
    callsNamedLikeTypes(s->cond2, fs, ts);
    callsNamedLikeTypes(s->step, fs, ts);
    for (const cpp::VarDeclarator &d : s->decls)
        for (const cpp::ExprP &x : d.args)
            callsNamedLikeTypes(x, fs, ts);
    for (const cpp::StmtP &x : s->body)
        callsNamedLikeTypes(x, fs, ts);
    callsNamedLikeTypes(s->init, fs, ts);
    callsNamedLikeTypes(s->then, fs, ts);
    callsNamedLikeTypes(s->els, fs, ts);
    callsNamedLikeTypes(s->condDecl, fs, ts);
    for (const cpp::Catch &c : s->catches)
        callsNamedLikeTypes(c.body, fs, ts);
    callsNamedLikeTypes(s->local, fs, ts);
}
void callsNamedLikeTypes(const cpp::ExprP &e, const std::set<std::string> &fs, const std::set<std::string> &ts)
{
    if (!e)
        return;
    for (const cpp::ExprP &k : e->kids)
        callsNamedLikeTypes(k, fs, ts);
    if (e->lambda)
    {
        for (const cpp::Param &pr : e->lambda->params)
            callsNamedLikeTypes(pr.def, fs, ts);
        callsNamedLikeTypes(e->lambda->body, fs, ts);
    }
    if (e->k == cpp::EK::Construct && e->type && !e->braced && e->type->name.size() == 1 && !e->type->hasTargs &&
        e->type->pointers == 0 && !e->type->ref && !e->type->rref && fs.count(e->type->name[0]) &&
        !ts.count(e->type->name[0]))
    {
        cpp::ExprP callee = mkName(e->type->name[0], e->line);
        e->k = cpp::EK::Call;
        e->kids.insert(e->kids.begin(), callee);
        e->type = nullptr;
    }
}

// The names an expression or statement uses (free-variable candidates)
void collectNames(const cpp::ExprP &e, std::vector<std::string> &out);
void collectNames(const cpp::StmtP &s, std::vector<std::string> &out)
{
    if (!s)
        return;
    collectNames(s->expr, out);
    collectNames(s->cond2, out);
    collectNames(s->step, out);
    for (const cpp::VarDeclarator &d : s->decls)
        for (const cpp::ExprP &x : d.args)
            collectNames(x, out);
    for (const cpp::StmtP &x : s->body)
        collectNames(x, out);
    collectNames(s->init, out);
    collectNames(s->then, out);
    collectNames(s->els, out);
    collectNames(s->condDecl, out);
    for (const cpp::Catch &c : s->catches)
        collectNames(c.body, out);
}
void collectNames(const cpp::ExprP &e, std::vector<std::string> &out)
{
    if (!e)
        return;
    if (e->k == cpp::EK::Name && e->name.size() == 1)
        out.push_back(e->name[0]);
    if (e->k == cpp::EK::Construct && e->type && e->type->name.size() == 1 && !e->type->hasTargs)
        out.push_back(e->type->name[0]); // less(a, b) parsed as a construction may call a variable
    for (const cpp::ExprP &k : e->kids)
        collectNames(k, out);
    if (e->lambda)
        collectNames(e->lambda->body, out);
}

// A type's record for catch matching: 8 bytes in .data holding the .data
// offset of its base class's record (-1: none)
int Gen::typeInfo(const NT &tIn)
{
    NT t = tIn->cat == C_REF ? tIn->elem : tIn;
    std::string key = typeKey(t);
    auto it = typeInfo_.find(key);
    if (it != typeInfo_.end())
        return it->second;
    int64_t base = -1;
    if (t->cat == C_CLASS && t->cls->base)
        base = typeInfo(tClass(t->cls->base));
    while (data.size() % 8)
        data.push_back('\0');
    int off = (int)data.size();
    for (int i = 0; i < 8; ++i)
        data.push_back((char)((base >> (8 * i)) & 255));
    typeInfo_[key] = off;
    return off;
}

int Gen::pushHandler(int landing)
{
    int rec = newSlot(tArray(tInt(K_I64), 4)); // prev, rbp, rsp, landing address
    a.leaData(RCX, ehTop_);
    a.loadRcx(8, false);
    a.store(rec, RAX);
    a.store(rec + 8, RBP);
    a.store(rec + 16, RSP);
    a.leaLabel(RAX, landing);
    a.store(rec + 24, RAX);
    a.lea(RAX, rec);
    a.leaData(RCX, ehTop_);
    a.storeRcx(8);
    return rec;
}

void Gen::popHandler(int rec)
{
    a.load(RAX, rec);
    a.leaData(RCX, ehTop_);
    a.storeRcx(8);
}

// An object with a destructor gets a handler that destroys it when an
// exception passes, then lets the exception go on
void Gen::protect(Cleanup &c)
{
    int landing = a.newLabel(), skip = a.newLabel();
    c.ehRec = pushHandler(landing);
    a.jmp(skip);
    a.bind(landing);
    ThisSrc s;
    s.kind = TH_LOCAL;
    s.off = c.off;
    destroy(s, c.cls);
    a.call(routine("throw"));
    a.bind(skip);
}

void Gen::throwExpr(const cpp::ExprP &e)
{
    if (e->kids.empty())
    {
        // throw; : the exception the innermost handler is handling, again
        if (catchSaves_.empty())
            fail("throw; outside a catch", e->line);
        int save = catchSaves_.back();
        for (int i = 0; i < 3; ++i)
        {
            a.load(RAX, save + 8 * i);
            a.leaData(RCX, ehObj_ + 8 * i);
            a.storeRcx(8);
        }
        a.call(routine("throw"));
        return;
    }
    NT t = typeOfExpr(e->kids[0]);
    if (t->cat == C_REF)
        t = t->elem;
    if (t->cat == C_ARRAY)
        t = tPtr(t->elem);
    // the exception object, on the heap
    a.movImm(RCX, sizeOf(t));
    callRoutine(routine("alloc"));
    int slot = newSlot(tPtr(tVoid()));
    a.store(slot, RAX);
    if (t->cat == C_CLASS)
    {
        ThisSrc s;
        s.kind = TH_INDIRECT;
        s.off = slot;
        construct(s, t->cls, {e->kids[0]}, false, e->line);
    }
    else
    {
        NT v = expr(e->kids[0]);
        if (!(t->cat == C_PTR && v->cat == C_PTR))
            convert(t, v, e->line);
        a.load(RCX, slot);
        a.storeRcx(sizeOf(t));
    }
    endFullExpr();
    a.load(RAX, slot);
    a.leaData(RCX, ehObj_);
    a.storeRcx(8);
    a.movImm(RAX, typeInfo(t));
    a.leaData(RCX, ehType_);
    a.storeRcx(8);
    if (t->cat == C_CLASS && t->cls->needsDtor)
    {
        t->cls->dtor->used = true;
        a.leaLabel(RAX, t->cls->dtor->label);
    }
    else
        a.movImm(RAX, 0);
    a.leaData(RCX, ehDtor_);
    a.storeRcx(8);
    a.call(routine("throw"));
}

void Gen::tryStmt(const cpp::StmtP &s)
{
    int landing = a.newLabel(), end = a.newLabel();
    int rec = pushHandler(landing);
    scopes_.emplace_back();
    scopes_.back().cleanups.push_back(Cleanup{rec, nullptr, rec});
    stmt(s->then);
    scopes_.back().cleanups.clear();
    scopes_.pop_back();
    popHandler(rec);
    a.jmp(end);

    // an exception arrived (the throw popped the record): find its handler
    a.bind(landing);
    int save = newSlot(tArray(tInt(K_I64), 3)); // object, type, destructor
    for (int i = 0; i < 3; ++i)
    {
        a.leaData(RCX, ehObj_ + 8 * i);
        a.loadRcx(8, false);
        a.store(save + 8 * i, RAX);
    }
    for (const cpp::Catch &c : s->catches)
    {
        int next = a.newLabel();
        NT ct;
        if (c.type)
        {
            ct = typeOf(c.type, s->line);
            NT want = ct->cat == C_REF ? ct->elem : ct;
            // does the thrown type (or one of its bases) match?
            int top = a.newLabel(), match = a.newLabel();
            a.load(RAX, save + 8);
            a.bind(top);
            a.movImm(RCX, typeInfo(want));
            a.alu(0x39, RAX, RCX);
            a.jcc(CC_E, match);
            a.leaData(RCX, 0);
            a.alu(0x01, RCX, RAX);
            a.loadInd(RAX, RCX); // the base's record
            a.movImm(RCX, -1);
            a.alu(0x39, RAX, RCX);
            a.jcc(CC_E, next);
            a.jmp(top);
            a.bind(match);
        }
        scopes_.emplace_back();
        if (c.type && !c.name.empty())
        {
            NT want = ct->cat == C_REF ? ct->elem : ct;
            if (want->cat == C_CLASS || ct->cat == C_REF)
            {
                // the variable refers to the exception object itself
                a.load(RAX, save);
                int off = newSlot(tPtr(tVoid()));
                a.store(off, RAX);
                scopes_.back().vars[c.name] = Var{tRef(want, false), false, off};
            }
            else
            {
                int off = newSlot(want);
                a.load(RCX, save);
                a.loadRcx(sizeOf(want), want->cat == C_INT && !isUnsigned(want->kind) && !isFloat(want->kind));
                a.lea(RCX, off);
                a.storeRcx(sizeOf(want));
                scopes_.back().vars[c.name] = Var{want, false, off};
            }
        }
        catchSaves_.push_back(save);
        stmt(c.body);
        catchSaves_.pop_back();
        destroyScopes(scopes_.size() - 1);
        scopes_.pop_back();
        // the exception is over: destroyed and freed
        int noDtor = a.newLabel();
        a.load(RAX, save + 16);
        a.test(RAX, RAX);
        a.jcc(CC_E, noDtor);
        a.load(RCX, save);
        int pad = (depth_ + 4) % 2;
        if (pad)
            a.subRsp(8);
        a.subRsp(32);
        a.callReg(RAX);
        a.addRsp(32 + 8 * pad);
        a.bind(noDtor);
        a.load(RCX, save);
        callRoutine(routine("free"));
        a.jmp(end);
        a.bind(next);
    }
    // no handler here: on to the next one out
    for (int i = 0; i < 3; ++i)
    {
        a.load(RAX, save + 8 * i);
        a.leaData(RCX, ehObj_ + 8 * i);
        a.storeRcx(8);
    }
    a.call(routine("throw"));
    a.bind(end);
}

cpp::ExprP mkName(const std::string &n, int line);
cpp::ExprP mkExpr(cpp::EK k, const std::string &op, std::vector<cpp::ExprP> kids, int line);

// A condition that is an object: its `operator bool()` (or another conversion
// to a scalar) called
cpp::ExprP Gen::asCondition(const cpp::ExprP &e)
{
    NT t = typeOfExpr(e);
    if (t->cat == C_REF)
        t = t->elem;
    if (t->cat != C_CLASS)
        return e;
    std::vector<Method *> ops;
    if (!findMethod(t->cls, "operator bool", ops))
    {
        for (ClassInfo *k = t->cls; k && ops.empty(); k = k->base)
            for (auto &kv : k->methods)
                if (kv.first.rfind("operator ", 0) == 0 && !kv.second.empty() && isScalar(kv.second[0]->ret))
                    ops = kv.second;
        if (ops.empty())
            fail("an object of class " + t->cls->name + " as a condition", e->line);
    }
    auto member = keepExpr(mkExpr(cpp::EK::Member, ops[0]->name, {e}, e->line));
    return keepExpr(mkExpr(cpp::EK::Call, "", {member}, e->line));
}

// printf and its family: the variable arguments as 8-byte slots with their
// kinds ('d' signed, 'u' unsigned, 'f' double, 'p' pointer), then the
// library's __printf_to / __snprintf_to (lib/native/cstdio)
NT Gen::printfCall(const std::string &name, const std::vector<cpp::ExprP> &args, int line)
{
    size_t fixed = name == "printf" ? 1 : name == "snprintf" ? 3 : 2;
    if (args.size() < fixed)
        fail(name + " with too few arguments", line);
    size_t n = args.size() - fixed;
    std::string arr = "__va" + std::to_string(++tempCount_);
    NT at = tArray(tInt(K_U64), n ? (int)n : 1);
    int off = newSlot(at);
    scopes_.back().vars[arr] = Var{at, false, off};
    // the arguments last first, as g++ evaluates them
    std::string kinds(n, 'p');
    for (size_t i = n; i-- > 0;)
    {
        NT t = expr(args[fixed + i]);
        if (t->cat == C_REF)
            t = valueAt(t->elem);
        char k = 'p';
        if (t->cat == C_INT)
        {
            if (isFloat(t->kind))
            {
                convKind(t->kind, K_F64);
                k = 'f';
            }
            else if (isUnsigned(t->kind) && kindSize(t->kind) >= 4)
            {
                convKind(t->kind, K_U64);
                k = 'u';
            }
            else
            {
                convKind(t->kind, K_I64);
                k = 'd';
            }
        }
        else if (t->cat != C_PTR)
            fail(name + ": this argument type", line);
        kinds[i] = k;
        a.lea(RCX, off + 8 * (int)i);
        a.storeRcx(8);
    }
    auto kindsExpr = std::make_shared<cpp::Expr>();
    kindsExpr->k = cpp::EK::Str;
    kindsExpr->str = kinds;
    kindsExpr->line = line;
    keepExpr(kindsExpr);
    auto callee = std::make_shared<cpp::Expr>();
    callee->k = cpp::EK::Name;
    callee->line = line;
    std::vector<cpp::ExprP> callArgs;
    if (name == "printf" || name == "fprintf")
    {
        callee->name = {"std", "__printf_to"};
        if (name == "printf")
            callArgs.push_back(keepExpr(mkName("stdout", line)));
        else
            callArgs.push_back(args[0]);
        callArgs.push_back(args[fixed - 1]);
    }
    else
    {
        callee->name = {"std", "__snprintf_to"};
        callArgs.push_back(args[0]);
        if (name == "snprintf")
            callArgs.push_back(args[1]);
        else
        {
            auto big = std::make_shared<cpp::Expr>();
            big->k = cpp::EK::Int;
            big->str = "9223372036854775807";
            big->line = line;
            callArgs.push_back(keepExpr(big));
        }
        callArgs.push_back(args[fixed - 1]);
    }
    keepExpr(callee);
    callArgs.push_back(keepExpr(mkName(arr, line)));
    callArgs.push_back(kindsExpr);
    std::vector<cpp::ExprP> kids = {callee};
    kids.insert(kids.end(), callArgs.begin(), callArgs.end());
    return call(keepExpr(mkExpr(cpp::EK::Call, "", kids, line)));
}

// `T(args)` that the parser took for a call: T a class, alias or template
// instance. The same as a construction expression, if T is a type.
cpp::ExprP Gen::typeConstruct(const cpp::ExprP &call)
{
    const cpp::ExprP &callee = call->kids[0];
    if (callee->k != cpp::EK::Name)
        return nullptr;
    auto ty = std::make_shared<cpp::TypeName>();
    ty->name = callee->name;
    ty->targs.assign(callee->name.size(), std::vector<cpp::TArg>());
    if (callee->hasTargs)
    {
        ty->targs.back() = callee->targs;
        ty->hasTargs = true;
    }
    bool isType = false;
    for (const std::string &k : candidates(callee->name))
        if (classes_.count(k) || aliases_.count(k) || (callee->hasTargs && classTemplates_.count(k)))
            isType = true;
    if (!isType)
        return nullptr;
    auto ce = std::make_shared<cpp::Expr>();
    ce->k = cpp::EK::Construct;
    ce->line = call->line;
    ce->type = ty;
    ce->kids.assign(call->kids.begin() + 1, call->kids.end());
    return keepExpr(ce);
}

cpp::ExprP Gen::arrowBase(const cpp::ExprP &obj)
{
    auto member = keepExpr(mkExpr(cpp::EK::Member, "operator->", {obj}, obj->line));
    return keepExpr(mkExpr(cpp::EK::Call, "", {member}, obj->line));
}

cpp::ExprP mkName(const std::string &n, int line)
{
    auto e = std::make_shared<cpp::Expr>();
    e->k = cpp::EK::Name;
    e->line = line;
    e->name = {n};
    return e;
}

cpp::ExprP mkExpr(cpp::EK k, const std::string &op, std::vector<cpp::ExprP> kids, int line)
{
    auto e = std::make_shared<cpp::Expr>();
    e->k = k;
    e->op = op;
    e->line = line;
    e->kids = kids;
    return e;
}

cpp::TypeNameP autoTypeName(bool ref, bool rref)
{
    auto t = std::make_shared<cpp::TypeName>();
    t->name = {"auto"};
    t->targs.emplace_back();
    t->ref = ref;
    t->rref = rref;
    return t;
}

cpp::StmtP mkDecl(const std::string &name, const cpp::TypeNameP &type, const cpp::ExprP &init, int line)
{
    auto st = std::make_shared<cpp::Stmt>();
    st->k = cpp::SK::Decl;
    st->line = line;
    cpp::VarDeclarator v;
    v.name = name;
    v.type = type;
    v.init = cpp::VarDeclarator::Copy;
    v.args = {init};
    v.line = line;
    st->decls.push_back(v);
    return st;
}

// auto [a, b] = e;  (auto &[a, b] = e;): a hidden variable holding e (or
// referring to it), and each name a reference to its member in order
void Gen::bindNames(const cpp::VarDeclarator &d, int line)
{
    if (d.args.size() != 1)
        fail("structured binding without one initializer", line);
    std::string hidden = "__bind" + std::to_string(++tempCount_);
    NT t = autoType(d.type, d.args[0], line);
    declare(hidden, t, d.args[0], false, d.args, line);
    NT obj = t->cat == C_REF ? t->elem : t;
    if (obj->cat != C_CLASS)
        fail("structured binding of a non-class (not yet)", line);
    std::vector<const Field *> fields;
    for (const Field &f : obj->cls->fields)
        fields.push_back(&f);
    if (fields.size() != d.bindings.size())
        fail("structured binding: " + std::to_string(d.bindings.size()) + " names for " +
                 std::to_string(fields.size()) + " members",
             line);
    for (size_t i = 0; i < fields.size(); ++i)
    {
        addr(keepExpr(mkName(hidden, line)));
        if (fields[i]->off)
            a.addImm(RAX, fields[i]->off);
        NT ft = fields[i]->type;
        if (ft->cat == C_REF)
        {
            a.movRR(RCX, RAX);
            a.loadRcx(8, false);
            ft = ft->elem;
        }
        int off = newSlot(tPtr(tVoid()));
        a.store(off, RAX);
        scopes_.back().vars[d.bindings[i]] = Var{tRef(ft, false), false, off};
    }
}

// for (decl : range) body  as
//   { auto &&r = range; for (auto b = begin, e = end; b != e; ++b) { decl = *b; body } }
void Gen::rangeFor(const cpp::StmtP &s)
{
    int line = s->line;
    if (s->decls.size() != 1)
        fail("this range-for", line);
    if (s->expr && s->expr->k == cpp::EK::InitList)
    {
        // for (x : {a, b, c}): the list as a local array
        const cpp::VarDeclarator &dv = s->decls[0];
        NT el;
        if (dv.type && !dv.type->isAuto())
            el = typeOf(dv.type, line);
        else
            el = typeOfExpr(s->expr->kids.at(0));
        if (el->cat == C_REF)
            el = el->elem;
        if (el->cat == C_ARRAY)
            el = tPtr(el->elem);
        std::string arr = "__list" + std::to_string(++tempCount_);
        scopes_.emplace_back();
        declare(arr, tArray(el, (int)s->expr->kids.size()), s->expr, true, s->expr->kids, line);
        auto s2 = std::make_shared<cpp::Stmt>(*s);
        s2->expr = keepExpr(mkName(arr, line));
        keepAlive_.push_back(s2);
        rangeFor(s2);
        destroyScopes(scopes_.size() - 1);
        scopes_.pop_back();
        return;
    }
    std::string n = std::to_string(++tempCount_);
    std::string r = "__range" + n, b = "__begin" + n, e = "__end" + n;
    NT rt = typeOfExpr(s->expr);
    if (s->expr->k == cpp::EK::Name && s->expr->name.size() == 1)
        if (Var *v = lookup(s->expr->name[0]))
            rt = v->type; // an array stays one (its value would decay)
    NT obj = rt->cat == C_REF ? rt->elem : rt;
    auto block = std::make_shared<cpp::Stmt>();
    block->k = cpp::SK::Block;
    block->line = line;
    block->body.push_back(mkDecl(r, autoTypeName(false, true), s->expr, line));
    cpp::ExprP first, last;
    if (obj->cat == C_ARRAY)
    {
        first = mkName(r, line); // decays to its first element
        auto count = std::make_shared<cpp::Expr>();
        keepExprs_.push_back(count);
        count->k = cpp::EK::Int;
        count->str = std::to_string(obj->n);
        count->line = line;
        last = mkExpr(cpp::EK::Binary, "+", {mkName(r, line), count}, line);
    }
    else if (obj->cat == C_CLASS)
    {
        auto member = [&](const std::string &m)
        {
            auto me = mkExpr(cpp::EK::Member, m, {mkName(r, line)}, line);
            return mkExpr(cpp::EK::Call, "", {me}, line);
        };
        first = member("begin");
        last = member("end");
    }
    else
        fail("range-for over this type", line);
    auto loop = std::make_shared<cpp::Stmt>();
    loop->k = cpp::SK::For;
    loop->line = line;
    auto inits = std::make_shared<cpp::Stmt>();
    inits->k = cpp::SK::Block;
    inits->line = line;
    loop->init = mkDecl(b, autoTypeName(false, false), first, line);
    loop->init->decls.push_back(mkDecl(e, autoTypeName(false, false), last, line)->decls[0]);
    loop->cond2 = mkExpr(cpp::EK::Binary, "!=", {mkName(b, line), mkName(e, line)}, line);
    loop->step = mkExpr(cpp::EK::Unary, "++", {mkName(b, line)}, line);
    auto body = std::make_shared<cpp::Stmt>();
    body->k = cpp::SK::Block;
    body->line = line;
    auto item = std::make_shared<cpp::Stmt>();
    item->k = cpp::SK::Decl;
    item->line = line;
    cpp::VarDeclarator v = s->decls[0];
    v.init = cpp::VarDeclarator::Copy;
    v.args = {mkExpr(cpp::EK::Unary, "*", {mkName(b, line)}, line)};
    item->decls.push_back(v);
    body->body.push_back(item);
    body->body.push_back(s->then);
    loop->then = body;
    block->body.push_back(loop);
    keepAlive_.push_back(block);
    stmt(block);
}

// The closure class of a lambda: a field per capture, operator() for the body
ClassInfo *Gen::closureClass(const cpp::ExprP &e, std::vector<std::pair<std::string, bool>> &caps)
{
    const cpp::Lambda &l = *e->lambda;
    // what it captures: the explicit list, then (with = or &) every name its
    // body uses that is a local of the enclosing function
    bool thisCap = false;
    for (const std::string &c : l.captures)
    {
        if (c == "this")
        {
            thisCap = true;
            continue;
        }
        bool byRef = c[0] == '&';
        caps.push_back({byRef ? c.substr(1) : c, byRef});
    }
    bool inMember = cur_ && cur_->owner && !cur_->isStatic;
    if (inMember && (l.captureAllByRef || l.captureAllByValue))
        thisCap = true;
    if (l.captureAllByRef || l.captureAllByValue)
    {
        std::vector<std::string> used;
        collectNames(l.body, used);
        std::vector<std::string> own;
        for (const cpp::Param &pr : l.params)
            own.push_back(pr.name);
        for (const std::string &n : used)
        {
            bool skip = false;
            for (const std::string &o : own)
                if (o == n)
                    skip = true;
            for (const auto &c : caps)
                if (c.first == n)
                    skip = true;
            if (skip)
                continue;
            bool local = false;
            for (const Scope &sc : scopes_)
                if (sc.vars.count(n))
                    local = true;
            int off = 0;
            if (!local && n != "__this" && cur_ && cur_->owner && cur_->owner->name.rfind("lambda#", 0) == 0 &&
                findField(cur_->owner, n, off))
                local = true; // in a lambda: what the enclosing lambda captured
            if (local)
                caps.push_back({n, l.captureAllByRef});
        }
    }
    std::map<const Binding *, ClassInfo *> &known = closures_[e.get()];
    auto it = known.find(bind_.get());
    if (it != known.end())
        return it->second;

    auto info = std::make_unique<ClassInfo>();
    info->name = "lambda#" + std::to_string(++lambdaCount_);
    info->bind = bind_;
    ClassInfo *c = info.get();
    classes_[c->name] = std::move(info);
    for (const auto &cap : caps)
    {
        Var *v = lookup(cap.first);
        NT vt;
        int foff = 0;
        if (v && !v->global)
            vt = v->type;
        else if (const Field *ef = cur_ && cur_->owner && cur_->owner->name.rfind("lambda#", 0) == 0
                                       ? findField(cur_->owner, cap.first, foff)
                                       : nullptr)
            vt = ef->type; // captured by the enclosing lambda
        else
            fail("capturing " + cap.first + " (not a local variable)", e->line);
        NT t = vt->cat == C_REF ? vt->elem : vt;
        Field f;
        f.name = cap.first;
        f.type = cap.second ? tRef(t, false) : t;
        if (!cap.second && t->cat == C_ARRAY)
            fail("capturing an array by value (not yet)", e->line);
        c->fields.push_back(f);
    }
    if (thisCap && inMember)
    {
        // the enclosing object, for its members named in the body
        ClassInfo *outer = cur_->owner->outer ? cur_->owner->outer : cur_->owner;
        Field f;
        f.name = "__this";
        f.type = tPtr(tClass(outer));
        c->fields.push_back(f);
        c->outer = outer;
    }
    // operator(): the body, with its parameters
    auto d = std::make_shared<cpp::Decl>();
    d->k = cpp::DK::Func;
    d->line = e->line;
    d->file = cur_ && cur_->decl ? cur_->decl->file : 0; // the enclosing function's file and TU
    d->tu = curTu_;
    d->name = {"operator()"};
    d->params = l.params;
    d->body = l.body;
    d->ret = l.ret;
    bool generic = false;
    for (const cpp::Param &pr : l.params)
        if (pr.type && pr.type->isAuto() && !pr.type->decltypeOf)
            generic = true;
    if (generic)
    {
        // each auto parameter: a template parameter of its own
        d->isTemplate = true;
        int k = 0;
        for (cpp::Param &pr : d->params)
            if (pr.type && pr.type->isAuto() && !pr.type->decltypeOf)
            {
                std::string tn = "__auto" + std::to_string(k++);
                auto t2 = std::make_shared<cpp::TypeName>(*pr.type);
                t2->name = {tn};
                pr.type = t2;
                d->templateParams.push_back(tn);
            }
        c->memberTemplates["operator()"].push_back({d, curNs_});
        layoutClass(c);
        known[bind_.get()] = c;
        keepExprs_.push_back(e);
        if (bind_)
            keepBinds_.push_back(bind_);
        return c;
    }
    Method *m = newMethod();
    m->name = "operator()";
    m->owner = c;
    m->decl = d;
    m->bind = bind_;
    m->ns = curNs_;
    for (const cpp::Param &pr : l.params)
    {
        if (pr.type && pr.type->isAuto())
            fail("a generic lambda (auto parameter: not yet)", e->line);
        NT pt = typeOf(pr.type, e->line);
        if (pt->cat == C_ARRAY)
            pt = tPtr(pt->elem);
        m->params.push_back(pt);
        m->defaults.push_back(pr.def);
    }
    if (l.ret)
        m->ret = typeOf(l.ret, e->line); // else deduced from its returns when first called
    c->methods["operator()"].push_back(m);
    layoutClass(c);
    known[bind_.get()] = c;
    keepExprs_.push_back(e);
    if (bind_)
        keepBinds_.push_back(bind_);
    return c;
}

// A lambda expression: its closure object, a temporary
NT Gen::lambda(const cpp::ExprP &e)
{
    std::vector<std::pair<std::string, bool>> caps;
    ClassInfo *c = closureClass(e, caps);
    NT t = tClass(c);
    int slot = newSlot(t);
    a.movImm(RAX, 0);
    for (int k = 0; k < alignUp(sizeOf(t), 8); k += 8)
        a.store(slot + k, RAX);
    if (c->outer)
    {
        int thisField = 0;
        findField(c, "__this", thisField);
        if (cur_->owner->outer)
        {
            // a lambda in a lambda: the enclosing closure's captured this
            a.load(RAX, thisOff_);
            int inner = 0;
            findField(cur_->owner, "__this", inner);
            a.movRR(RCX, RAX);
            if (inner)
                a.addImm(RCX, inner);
            a.loadRcx(8, false);
        }
        else
            a.load(RAX, thisOff_);
        a.lea(RCX, slot + thisField);
        a.storeRcx(8);
    }
    for (size_t i = 0; i < caps.size() && i < c->fields.size(); ++i)
    {
        const Field &f = c->fields[i];
        auto name = std::make_shared<cpp::Expr>();
        keepExprs_.push_back(name);
        name->k = cpp::EK::Name;
        name->line = e->line;
        name->name = {caps[i].first};
        if (f.type->cat == C_REF)
        {
            addr(name); // the variable's address
            a.lea(RCX, slot + f.off);
            a.storeRcx(8);
            continue;
        }
        if (f.type->cat == C_CLASS)
        {
            ThisSrc fs;
            fs.kind = TH_LOCAL;
            fs.off = slot + f.off;
            construct(fs, f.type->cls, {name}, false, e->line);
            continue;
        }
        expr(name);
        a.lea(RCX, slot + f.off);
        a.storeRcx(sizeOf(f.type));
    }
    if (c->needsDtor)
        addTemp(slot, c);
    a.lea(RAX, slot);
    return t;
}

// A function whose return type comes from its return statements (a lambda
// without `-> T`): its body is generated once only to see them
void Gen::deduceReturn(Method *m)
{
    Method *savedCur = cur_;
    std::vector<Scope> savedScopes;
    std::vector<Loop> savedLoops;
    std::vector<Cleanup> savedTemps; // swapped out, not copied (a copy may share storage on the VM)
    savedScopes.swap(scopes_);
    savedLoops.swap(loops_);
    savedTemps.swap(temps_);
    int savedNext = nextOff_, savedDepth = depth_, savedRet = retLabel_, savedRetPtr = retPtrOff_,
        savedThis = thisOff_;
    NT savedRetType = retType_;
    std::string savedNrvo = nrvoName_;
    BindP savedBind = bind_;
    bool savedDeducing = deducing_;
    NT savedDeduced = deducedRet_;
    int savedTu = curTu_;
    Asm::Mark mark = a.mark();

    deducing_ = true;
    deducedRet_ = nullptr;
    m->ret = tVoid();
    function(*m);
    NT found = deducedRet_ ? deducedRet_ : tVoid();

    a.rewind(mark);
    cur_ = savedCur;
    scopes_.swap(savedScopes);
    loops_.swap(savedLoops);
    temps_.swap(savedTemps);
    nextOff_ = savedNext;
    depth_ = savedDepth;
    retLabel_ = savedRet;
    retPtrOff_ = savedRetPtr;
    thisOff_ = savedThis;
    retType_ = savedRetType;
    nrvoName_ = savedNrvo;
    bind_ = savedBind;
    deducing_ = savedDeducing;
    deducedRet_ = savedDeduced;
    curTu_ = savedTu;
    m->ret = found;
}

// Constructs an object of class c where `self` says
// T{a, b, c} where T has a constructor taking std::initializer_list<E>: the
// elements in a temporary array, a list viewing it, that constructor called
bool Gen::initListCtor(const ThisSrc &self, ClassInfo *c, const std::vector<cpp::ExprP> &items, int line)
{
    Method *target = nullptr;
    ClassInfo *listCls = nullptr;
    for (Method *m : c->ctors)
    {
        if (m->params.size() != 1)
            continue;
        NT p = m->params[0]->cat == C_REF ? m->params[0]->elem : m->params[0];
        if (p->cat == C_CLASS && p->cls->templateName == "initializer_list")
        {
            target = m;
            listCls = p->cls;
        }
    }
    if (!target)
        return false;
    NT el = listCls->bind->types.begin()->second;
    // only when every item converts to the element type ({first, last} of
    // iterators is a range for another constructor)
    for (const cpp::ExprP &x : items)
        if (x->k != cpp::EK::InitList && argCost(el, x, typeOfExpr(x)) < 0)
            return false;
    int n = (int)items.size();
    int arr = n ? newSlot(tArray(el, n)) : 0;
    for (int i = 0; i < n; ++i)
    {
        int off = arr + i * sizeOf(el);
        a.movImm(RAX, 0);
        for (int k = 0; k < alignUp(sizeOf(el), 8); k += 8)
            a.store(off + k, RAX);
        localInit(off, el, items[i], line);
        if (el->cat == C_CLASS && el->cls->needsDtor)
            addTemp(off, el->cls);
    }
    // the list: (data, size)
    NT lt = tClass(listCls);
    int list = newSlot(lt);
    int dataOff = 0, sizeOff = 8;
    findField(listCls, "data_", dataOff);
    findField(listCls, "size_", sizeOff);
    if (n)
        a.lea(RAX, arr);
    else
        a.movImm(RAX, 0);
    a.store(list + dataOff, RAX);
    a.movImm(RAX, n);
    a.store(list + sizeOff, RAX);
    std::string name = "__ilist" + std::to_string(++tempCount_);
    scopes_.back().vars[name] = Var{lt, false, list};
    callMethod(target, self, {keepExpr(mkName(name, line))}, false, line);
    return true;
}

void Gen::construct(const ThisSrc &self, ClassInfo *c, const std::vector<cpp::ExprP> &argsIn, bool braced, int line)
{
    std::vector<cpp::ExprP> args = argsIn;
    if (args.size() == 1 && !braced && args[0]->k != cpp::EK::InitList)
    {
        NT at = typeOfExpr(args[0]);
        NT bt = at->cat == C_REF ? at->elem : at;
        if (bt->cat == C_CLASS && bt->cls != c && !derivesFrom(bt->cls, c))
            if (Method *op = convOp(bt->cls, tClass(c)))
            {
                // T from an object with operator T(): that call's result
                auto member = keepExpr(mkExpr(cpp::EK::Member, op->name, {args[0]}, line));
                args[0] = keepExpr(mkExpr(cpp::EK::Call, "", {member}, line));
            }
    }
    if (braced && c->templateName == "initializer_list" && c->bind && !c->bind->types.empty())
    {
        // an initializer_list itself from a braced list: the elements in a
        // temporary array, the list viewing it
        std::vector<cpp::ExprP> items = args;
        if (items.size() == 1 && items[0]->k == cpp::EK::InitList)
            items = items[0]->kids;
        NT el = c->bind->types.begin()->second;
        int n = (int)items.size();
        int arr = n ? newSlot(tArray(el, n)) : 0;
        for (int i = 0; i < n; ++i)
        {
            int off = arr + i * sizeOf(el);
            a.movImm(RAX, 0);
            for (int k = 0; k < alignUp(sizeOf(el), 8); k += 8)
                a.store(off + k, RAX);
            localInit(off, el, items[(size_t)i], line);
            if (el->cat == C_CLASS && el->cls->needsDtor)
                addTemp(off, el->cls);
        }
        int dataOff = 0, sizeOff = 8;
        findField(c, "data_", dataOff);
        findField(c, "size_", sizeOff);
        loadThis(self);
        a.movRR(RCX, RAX);
        if (n)
            a.lea(RAX, arr);
        else
            a.movImm(RAX, 0);
        if (dataOff)
            a.addImm(RCX, dataOff);
        a.storeRcx(8);
        loadThis(self);
        a.movRR(RCX, RAX);
        if (sizeOff)
            a.addImm(RCX, sizeOff);
        a.movImm(RAX, n);
        a.storeRcx(8);
        return;
    }
    if (braced)
    {
        // T{{a, b}}: a list of one element when the inner list makes one
        // (vector<pair<K, V>>{{k, v}}); otherwise the inner list's items, as
        // for vector<int>{{1, 2, 3}}
        if (args.size() == 1 && args[0]->k == cpp::EK::InitList)
            for (Method *m : c->ctors)
            {
                if (m->params.size() != 1)
                    continue;
                NT p = m->params[0]->cat == C_REF ? m->params[0]->elem : m->params[0];
                if (p->cat != C_CLASS || p->cls->templateName != "initializer_list" || !p->cls->bind ||
                    p->cls->bind->types.empty())
                    continue;
                NT el = p->cls->bind->types.begin()->second;
                const std::vector<cpp::ExprP> &inner = args[0]->kids;
                bool itemsAreElements = true;
                for (const cpp::ExprP &x : inner)
                    if (x->k != cpp::EK::InitList && argCost(el, x, typeOfExpr(x)) < 0)
                        itemsAreElements = false;
                // the element from the inner list: an aggregate or a constructor
                // that is not a template ({first, last} is an iterator range for
                // the container's own constructor)
                bool buildsElement = false;
                if (el->cat == C_CLASS && !itemsAreElements)
                {
                    ClassInfo *ec = el->cls;
                    if (noCtors(ec) && !ec->polymorphic)
                        buildsElement = ec->fields.size() >= inner.size();
                    for (Method *k : ec->ctors)
                    {
                        if (k->params.size() == 1)
                        {
                            NT lp = k->params[0]->cat == C_REF ? k->params[0]->elem : k->params[0];
                            if (lp->cat == C_CLASS && lp->cls->templateName == "initializer_list" &&
                                listBuilds(lp->cls, inner))
                                buildsElement = true;
                        }
                        if (k->params.size() < inner.size())
                            continue;
                        bool ok = true;
                        for (size_t i = 0; ok && i < k->params.size(); ++i)
                            ok = i < inner.size() ? (inner[i]->k == cpp::EK::InitList ||
                                                     argCost(k->params[i], inner[i], typeOfExpr(inner[i])) >= 0)
                                                  : k->defaults[i] != nullptr;
                        if (ok)
                            buildsElement = true;
                    }
                }
                if (buildsElement && initListCtor(self, c, args, line))
                    return;
                break;
            }
        std::vector<cpp::ExprP> items = args;
        if (items.size() == 1 && items[0]->k == cpp::EK::InitList)
            items = items[0]->kids;
        // T{}: value-initialized (the default constructor), not from an empty list
        if (!(items.empty() && (c->implicitCtor || noCtors(c) || hasDefaultCtor(c))) &&
            initListCtor(self, c, items, line))
            return;
    }
    // a prvalue of the class (T(...), or a call returning T) is built in place
    if (args.size() == 1 && !(braced && args[0]->k == cpp::EK::InitList))
    {
        const cpp::ExprP &x = args[0];
        if ((x->k == cpp::EK::Construct || x->k == cpp::EK::Cast) && x->type && !asLocalCall(x))
        {
            NT t = typeOf(x->type, line);
            if (t->cat == C_CLASS && t->cls == c)
            {
                construct(self, c, x->kids, x->braced, line);
                return;
            }
        }
        if (x->k == cpp::EK::Call && (self.kind == TH_LOCAL || self.kind == TH_INDIRECT || self.kind == TH_GLOBAL))
        {
            // the call's own result type (a reference is not a prvalue)
            Asm::Mark mk = a.mark();
            int depth = depth_, next = nextOff_;
            size_t temps = temps_.size();
            NT t = call(x);
            a.rewind(mk);
            depth_ = depth;
            nextOff_ = next;
            temps_.resize(temps);
            if (t->cat == C_CLASS && t->cls == c)
            {
                call(x, &self);
                return;
            }
        }
    }
    if (!noCtors(c))
    {
        std::vector<cpp::ExprP> as = args;
        if (braced && as.size() == 1 && as[0]->k == cpp::EK::InitList)
            as = as[0]->kids;
        // copying an object of the class with no user copy constructor: memberwise
        if (as.size() == 1)
        {
            NT at = typeOfExpr(as[0]);
            NT bt = at->cat == C_REF ? at->elem : at;
            bool userCopy = false;
            for (Method *k : c->ctors)
                if (k->params.size() == 1 && k->params[0]->cat == C_REF && k->params[0]->elem->cat == C_CLASS &&
                    k->params[0]->elem->cls == c)
                    userCopy = true;
            if (bt->cat == C_CLASS && derivesFrom(bt->cls, c) && !userCopy)
            {
                if (c->moveCtor && bt->cls == c && rvalueExpr(as[0]))
                {
                    callMethod(c->moveCtor, self, as, false, line);
                    return;
                }
                if (c->copyCtor)
                {
                    callMethod(c->copyCtor, self, as, false, line);
                    return;
                }
                addr(as[0]);
                a.movRR(RSI, RAX);
                pushRax();
                loadThis(self);
                a.movRR(RDI, RAX);
                popReg(RSI);
                copyBytes(c->size);
                return;
            }
        }
        std::vector<Method *> cands = c->ctors;
        templateMembers(c, "", as, {}, false, line, cands);
        Method *m = resolve(cands, as, c->name + " constructor", line);
        if (verbose_)
        {
            std::cerr << "  ctor " << c->name << "(";
            for (const cpp::ExprP &x : as)
            {
                NT xt = typeOfExpr(x);
                std::cerr << typeKey(xt) << (xt->cat == C_REF && xt->rvalue ? "&" : "") << ",";
            }
            std::cerr << ") -> (";
            for (const NT &pt : m->params)
                std::cerr << typeKey(pt) << (pt->cat == C_REF && pt->rvalue ? "&" : "") << ",";
            std::cerr << ")" << std::endl;
        }
        callMethod(m, self, as, false, line);
        return;
    }
    if (args.empty() || (braced && args.size() == 1 && args[0]->k == cpp::EK::InitList && args[0]->kids.empty()))
    {
        if (c->implicitCtor)
            callMethod(c->implicitCtor, self, {}, false, line);
        return; // zeroed memory
    }
    // copy, or aggregate initialization {a, b, ...}
    if (args.size() == 1 && !(braced && args[0]->k == cpp::EK::InitList))
    {
        NT at = typeOfExpr(args[0]);
        NT bt = at->cat == C_REF ? at->elem : at;
        if (bt->cat == C_CLASS && derivesFrom(bt->cls, c))
        {
            if (c->moveCtor && bt->cls == c && rvalueExpr(args[0]))
            {
                callMethod(c->moveCtor, self, args, false, line);
                return;
            }
            if (c->copyCtor)
            {
                callMethod(c->copyCtor, self, args, false, line);
                return;
            }
            addr(args[0]);
            pushRax();
            loadThis(self);
            a.movRR(RDI, RAX);
            popReg(RSI);
            copyBytes(c->size);
            return;
        }
    }
    if (c->polymorphic || c->base)
        fail("aggregate initialization of " + c->name + " (it has a base or virtual functions)", line);
    std::vector<cpp::ExprP> items = args;
    if (items.size() == 1 && items[0]->k == cpp::EK::InitList)
        items = items[0]->kids;
    if (items.size() > c->fields.size())
        fail("too many initializers for " + c->name, line);
    for (size_t i = 0; i < items.size(); ++i)
    {
        const Field &f = c->fields[i];
        if (f.type->cat == C_CLASS)
        {
            loadThis(self);
            if (f.off)
                a.addImm(RAX, f.off);
            int tmp = newSlot(tPtr(tVoid()));
            a.store(tmp, RAX);
            ThisSrc fs;
            fs.kind = TH_INDIRECT;
            fs.off = tmp;
            std::vector<cpp::ExprP> one = {items[i]};
            construct(fs, f.type->cls, one, items[i]->k == cpp::EK::InitList, line);
            continue;
        }
        if (f.type->cat == C_REF)
        {
            // a reference member: bound to the item, its address stored
            bindRef(f.type, items[i], line);
            pushRax();
            loadThis(self);
            if (f.off)
                a.addImm(RAX, f.off);
            a.movRR(RCX, RAX);
            popReg(RAX);
            a.storeRcx(8);
            continue;
        }
        if (!isScalar(f.type))
            fail("initializing member " + f.name, line);
        NT vt = expr(items[i]);
        if (f.type->cat == C_PTR && (vt->cat == C_PTR || vt->cat == C_INT))
            ;
        else
            convert(f.type, vt, line);
        pushRax();
        loadThis(self);
        if (f.off)
            a.addImm(RAX, f.off);
        a.movRR(RCX, RAX);
        popReg(RAX);
        a.storeRcx(sizeOf(f.type));
    }
    // the members not listed: their default member initializers (read in the
    // class's scope), or built empty
    std::string callerNs = curNs_;
    BindP callerBind = bind_;
    curNs_ = c->name + "::";
    bind_ = c->bind;
    struct Restore
    {
        std::string &ns;
        BindP &b;
        std::string savedNs;
        BindP savedB;
        ~Restore()
        {
            ns = savedNs;
            b = savedB;
        }
    } restore{curNs_, bind_, callerNs, callerBind};
    for (size_t i = items.size(); i < c->fields.size(); ++i)
    {
        const Field &f = c->fields[i];
        bool hasInit = f.init || f.initBraced;
        if (f.type->cat == C_CLASS)
        {
            loadThis(self);
            if (f.off)
                a.addImm(RAX, f.off);
            int tmp = newSlot(tPtr(tVoid()));
            a.store(tmp, RAX);
            ThisSrc fs;
            fs.kind = TH_INDIRECT;
            fs.off = tmp;
            construct(fs, f.type->cls, hasInit ? f.initArgs : std::vector<cpp::ExprP>(), f.initBraced, line);
            continue;
        }
        if (!hasInit || !isScalar(f.type) || f.initArgs.empty())
            continue; // zeroed already
        NT vt = expr(f.initArgs[0]);
        if (vt->cat == C_REF)
            vt = valueAt(vt->elem);
        if (!(f.type->cat == C_PTR && (vt->cat == C_PTR || vt->cat == C_INT)))
            convert(f.type, vt, line);
        pushRax();
        loadThis(self);
        if (f.off)
            a.addImm(RAX, f.off);
        a.movRR(RCX, RAX);
        popReg(RAX);
        a.storeRcx(sizeOf(f.type));
    }
}

void Gen::destroy(const ThisSrc &self, ClassInfo *c)
{
    if (!c->needsDtor)
        return;
    loadThis(self);
    a.movRR(RCX, RAX);
    c->dtor->used = true;
    callRoutine(c->dtor->label);
}

// destructors of the scopes above `downTo`, innermost first (rax is kept)
void Gen::destroyScopes(size_t downTo)
{
    bool any = false;
    for (size_t i = downTo; i < scopes_.size(); ++i)
        if (!scopes_[i].cleanups.empty())
            any = true;
    if (!any)
        return;
    pushRax();
    for (size_t i = scopes_.size(); i-- > downTo;)
        for (size_t k = scopes_[i].cleanups.size(); k-- > 0;)
        {
            const Cleanup &c = scopes_[i].cleanups[k];
            if (c.ehRec)
                popHandler(c.ehRec);
            if (!c.cls)
                continue;
            ThisSrc s;
            s.kind = TH_LOCAL;
            s.off = c.off;
            destroy(s, c.cls);
        }
    popReg(RAX);
}

// the temporaries of a full-expression die at its end (rax is kept)
void Gen::endFullExpr()
{
    if (temps_.empty())
        return;
    std::vector<Cleanup> t;
    t.swap(temps_);
    pushRax();
    for (size_t k = t.size(); k-- > 0;)
    {
        int skip = a.newLabel();
        if (t[k].flag)
        {
            a.load(RAX, t[k].flag);
            a.test(RAX, RAX);
            a.jcc(CC_E, skip);
            a.movImm(RAX, 0);
            a.store(t[k].flag, RAX);
        }
        ThisSrc s;
        s.kind = TH_LOCAL;
        s.off = t[k].off;
        destroy(s, t[k].cls);
        a.bind(skip);
    }
    popReg(RAX);
}

NT Gen::expr(const cpp::ExprP &e)
{
    switch (e->k)
    {
    case cpp::EK::Int:
    {
        Kind k;
        int64_t v = literalValue(e->str, k);
        a.movImm(RAX, v);
        return tInt(k);
    }
    case cpp::EK::Char:
        a.movImm(RAX, (int64_t)(signed char)(int)e->num);
        return tInt(K_I8);
    case cpp::EK::Float:
        if (e->isFloatSuffix)
        {
            a.movImm(RAX, (int64_t)ieeeBits(e->num, 23, 127));
            return tInt(K_F32);
        }
        a.movImm(RAX, (int64_t)ieeeBits(e->num, 52, 1023));
        return tInt(K_F64);
    case cpp::EK::Bool:
        a.movImm(RAX, e->num != 0 ? 1 : 0);
        return tInt(K_BOOL);
    case cpp::EK::Nullptr:
        a.movImm(RAX, 0);
        return tPtr(tVoid());
    case cpp::EK::This:
        if (!cur_ || !cur_->owner || cur_->isStatic)
            fail("this outside a member function", e->line);
        if (cur_->owner->outer)
        {
            ThisSrc o;
            o.kind = TH_OUTER;
            loadThis(o);
            return tPtr(tClass(cur_->owner->outer));
        }
        a.load(RAX, thisOff_);
        return tPtr(tClass(cur_->owner));
    case cpp::EK::Name:
        if (e->name.size() == 1 && bind_ && bind_->values.count(e->name[0]) && !lookup(e->name[0]))
        {
            a.movImm(RAX, bind_->values[e->name[0]]); // a template's value parameter
            return tInt(K_I32);
        }
        {
            bool local = false;
            if (e->name.size() == 1)
                for (const Scope &sc : scopes_)
                    if (sc.vars.count(e->name[0]))
                        local = true;
            if (!local)
                for (const std::string &k : candidates(e->name))
                {
                    auto en = enumerators_.find(k);
                    if (en != enumerators_.end())
                    {
                        a.movImm(RAX, en->second.second);
                        return tInt(en->second.first);
                    }
                }
        }
        return valueAt(addr(e));
    case cpp::EK::Index:
    case cpp::EK::Member:
    case cpp::EK::Str:
        return valueAt(addr(e));
    case cpp::EK::Binary:
        return binary(e);
    case cpp::EK::Comma:
    {
        NT t = tVoid();
        for (const cpp::ExprP &x : e->kids)
            t = expr(x);
        return t;
    }
    case cpp::EK::Assign:
        return assign(e);
    case cpp::EK::Unary:
    {
        const std::string &op = e->op;
        if (op != "&")
        {
            bool found = false;
            NT r = operatorCall(op, e->kids, e->line, found);
            if (found)
                return r->cat == C_REF && !r->rvalue ? valueAt(r->elem) : r; // T&& stays one (a move)
        }
        if (op == "++" || op == "--")
            return incDec(e, op == "++", false);
        if (op == "&")
            return tPtr(addr(e->kids[0]));
        if (op == "*")
            return valueAt(addr(e));
        NT t = expr(op == "!" ? asCondition(e->kids[0]) : e->kids[0]);
        if (op == "!")
        {
            truth(t);
            a.test(RAX, RAX);
            a.setcc(CC_E);
            return tInt(K_BOOL);
        }
        if (t->cat != C_INT)
            fail("operator " + op + " on a non-integer", e->line);
        if (isFloat(t->kind))
        {
            if (op == "-")
            {
                // flip the sign bit
                a.movImm(RCX, t->kind == K_F64 ? (int64_t)0x8000000000000000ULL : 0x80000000LL);
                a.alu(0x31, RAX, RCX);
            }
            else if (op != "+")
                fail("operator " + op + " on floating point", e->line);
            return t;
        }
        Kind pk = promote(t->kind);
        if (op == "-")
            a.neg(RAX);
        else if (op == "~")
            a.notr(RAX);
        else if (op != "+")
            fail("operator " + op, e->line);
        wrap(pk);
        return tInt(pk);
    }
    case cpp::EK::Postfix:
        return incDec(e, e->op == "++", true);
    case cpp::EK::Cond:
    {
        NT s1 = typeOfExpr(e->kids[1]), s2 = typeOfExpr(e->kids[2]);
        if (s1->cat == C_REF)
            s1 = s1->elem;
        if (s2->cat == C_REF)
            s2 = s2->elem;
        bool ints = s1->cat == C_INT && s2->cat == C_INT;
        Kind k = ints ? (s1->kind == s2->kind ? s1->kind : common(s1->kind, s2->kind)) : K_VOID;
        ClassInfo *cc = s1->cat == C_CLASS ? s1->cls : s2->cat == C_CLASS ? s2->cls : nullptr;
        bool sameCls = s1->cat == C_CLASS && s2->cat == C_CLASS && s1->cls == s2->cls;
        if (cc && (!sameCls || rvalueExpr(e->kids[1]) != rvalueExpr(e->kids[2])))
        {
            // c ? "text" : str: both made the class (a temporary of it)
            NT ct = tClass(cc);
            int slot = newSlot(ct);
            a.movImm(RAX, 0);
            for (int q = 0; q < alignUp(sizeOf(ct), 8); q += 8)
                a.store(slot + q, RAX);
            ThisSrc ts;
            ts.kind = TH_LOCAL;
            ts.off = slot;
            int other = a.newLabel(), end = a.newLabel();
            truth(expr(asCondition(e->kids[0])));
            a.test(RAX, RAX);
            a.jcc(CC_E, other);
            construct(ts, cc, {e->kids[1]}, false, e->line);
            a.jmp(end);
            a.bind(other);
            construct(ts, cc, {e->kids[2]}, false, e->line);
            a.bind(end);
            if (cc->needsDtor)
                addTemp(slot, cc);
            a.lea(RAX, slot);
            return ct;
        }
        int other = a.newLabel(), end = a.newLabel();
        truth(expr(asCondition(e->kids[0])));
        a.test(RAX, RAX);
        a.jcc(CC_E, other);
        NT t1 = expr(e->kids[1]);
        if (ints)
            convKind(valKind(t1->cat == C_REF ? t1->elem : t1), k);
        a.jmp(end);
        a.bind(other);
        NT t2 = expr(e->kids[2]);
        if (ints)
            convKind(valKind(t2->cat == C_REF ? t2->elem : t2), k);
        a.bind(end);
        if (ints)
            return tInt(k);
        return t1->cat == C_PTR ? t1 : t2;
    }
    case cpp::EK::Call:
    {
        NT t = call(e);
        if (t->cat == C_REF)
            return valueAt(t->elem);
        return t;
    }
    case cpp::EK::Cast:
    case cpp::EK::Construct:
    {
        if (cpp::ExprP lc = asLocalCall(e))
            return expr(lc);
        NT t = typeOf(e->type, e->line);
        if (t->cat == C_CLASS)
        {
            // T(args) / T{args}: a temporary object
            int slot = newSlot(t);
            a.movImm(RAX, 0);
            for (int k = 0; k < alignUp(sizeOf(t), 8); k += 8)
                a.store(slot + k, RAX);
            ThisSrc s;
            s.kind = TH_LOCAL;
            s.off = slot;
            construct(s, t->cls, e->kids, e->braced, e->line);
            if (t->cls->needsDtor)
                addTemp(slot, t->cls);
            a.lea(RAX, slot);
            return t;
        }
        if (e->kids.size() != 1)
        {
            if (e->kids.empty() && (t->cat == C_INT || t->cat == C_PTR))
            {
                a.movImm(RAX, 0); // int(), T*(): zero
                return t;
            }
            fail("this conversion (" + std::to_string(e->kids.size()) + " values to " + typeKey(t) + ")", e->line);
        }
        cpp::ExprP src = e->kids[0];
        if (t->cat == C_INT || t->cat == C_PTR)
        {
            NT st = typeOfExpr(src);
            if (st->cat == C_REF)
                st = st->elem;
            if (st->cat == C_CLASS)
                src = asCondition(src); // (bool)obj: its conversion operator
        }
        NT from = expr(src);
        if (t->cat == C_VOID)
            return t;
        if (e->op == "dynamic_cast" && t->cat == C_PTR && from->cat == C_PTR && t->elem->cat == C_CLASS &&
            t->elem->cls->polymorphic &&
            !(from->elem->cat == C_CLASS && derivesFrom(from->elem->cls, t->elem->cls)))
        {
            // a downcast: the object's vtable, or one of its bases', is the target's
            int loop = a.newLabel(), done = a.newLabel();
            a.test(RAX, RAX);
            a.jcc(CC_E, done);
            a.loadInd(RCX, RAX);
            a.leaData(RDX, t->elem->cls->vtableOff);
            a.bind(loop);
            a.alu(0x39, RCX, RDX);
            a.jcc(CC_E, done);
            a.loadDisp(RCX, RCX, -8);
            a.test(RCX, RCX);
            a.jcc(CC_NE, loop);
            a.movImm(RAX, 0);
            a.bind(done);
            return t;
        }
        if (t->cat == C_PTR && (from->cat == C_PTR || from->cat == C_INT))
            return t; // a pointer cast reinterprets
        if (t->cat == C_INT && from->cat == C_PTR)
        {
            wrap(t->kind);
            return t;
        }
        convert(t, from, e->line);
        return t;
    }
    case cpp::EK::Lambda:
        return lambda(e);
    case cpp::EK::Throw:
        throwExpr(e);
        return tVoid();
    case cpp::EK::SizeofT:
        a.movImm(RAX, sizeOf(typeOf(e->type, e->line)));
        return tInt(K_U64);
    case cpp::EK::SizeofE:
    {
        NT t = typeOfExpr(e->kids[0]);
        if (t->cat == C_REF)
            t = t->elem;
        // an array name decays in typeOfExpr; ask for the object's type instead
        if (e->kids[0]->k == cpp::EK::Name || e->kids[0]->k == cpp::EK::Member || e->kids[0]->k == cpp::EK::Index)
        {
            Asm::Mark m = a.mark();
            int depth = depth_;
            t = addr(e->kids[0]);
            a.rewind(m);
            depth_ = depth;
        }
        a.movImm(RAX, sizeOf(t));
        return tInt(K_U64);
    }
    case cpp::EK::New:
    {
        NT t = typeOf(e->type, e->line);
        if (e->newArray)
        {
            if (e->braced)
                fail("new[] with an initializer list (not yet)", e->line);
            NT n = expr(e->kids[0]);
            if (n->cat != C_INT)
                fail("a non-integer array size", e->line);
            if (t->cat != C_CLASS)
            {
                a.imulImm(RAX, sizeOf(t));
                a.movRR(RCX, RAX);
                callRoutine(routine("alloc"));
                return tPtr(t);
            }
            // objects: their count in 8 bytes before them (for delete[]), each constructed
            int nSlot = newSlot(tInt(K_I64)), pSlot = newSlot(tPtr(t)), iSlot = newSlot(tInt(K_I64)),
                eSlot = newSlot(tPtr(t));
            a.store(nSlot, RAX);
            a.imulImm(RAX, t->cls->size);
            a.addImm(RAX, 8);
            a.movRR(RCX, RAX);
            callRoutine(routine("alloc"));
            a.load(RCX, nSlot);
            a.storeInd(RAX, RCX);
            a.addImm(RAX, 8);
            a.store(pSlot, RAX);
            a.movImm(RAX, 0);
            a.store(iSlot, RAX);
            int top = a.newLabel(), done = a.newLabel();
            a.bind(top);
            a.load(RAX, iSlot);
            a.load(RCX, nSlot);
            a.alu(0x39, RAX, RCX);
            a.jcc(CC_GE, done);
            a.imulImm(RAX, t->cls->size);
            a.load(RCX, pSlot);
            a.alu(0x01, RAX, RCX);
            a.store(eSlot, RAX);
            ThisSrc es;
            es.kind = TH_INDIRECT;
            es.off = eSlot;
            std::vector<cpp::ExprP> none;
            construct(es, t->cls, none, false, e->line);
            a.load(RAX, iSlot);
            a.addImm(RAX, 1);
            a.store(iSlot, RAX);
            a.jmp(top);
            a.bind(done);
            a.load(RAX, pSlot);
            return tPtr(t);
        }
        a.movImm(RCX, sizeOf(t));
        callRoutine(routine("alloc"));
        if (t->cat == C_CLASS)
        {
            int slot = newSlot(tPtr(t));
            a.store(slot, RAX);
            ThisSrc s;
            s.kind = TH_INDIRECT;
            s.off = slot;
            construct(s, t->cls, e->kids, e->braced, e->line);
            a.load(RAX, slot);
            return tPtr(t);
        }
        if (!e->kids.empty())
        {
            if (e->kids.size() != 1)
                fail("new with several values", e->line);
            int slot = newSlot(tPtr(t));
            a.store(slot, RAX);
            NT v = expr(e->kids[0]);
            if (!(t->cat == C_PTR && v->cat == C_PTR))
                convert(t, v, e->line);
            a.load(RCX, slot);
            a.storeRcx(sizeOf(t));
            a.load(RAX, slot);
        }
        return tPtr(t);
    }
    case cpp::EK::Delete:
    {
        NT p = expr(e->kids[0]);
        if (p->cat != C_PTR)
            fail("delete of a non-pointer", e->line);
        if (e->newArray && p->elem->cat == C_CLASS)
        {
            // delete[]: each object destroyed, last first, then the block with its count
            ClassInfo *c = p->elem->cls;
            int pSlot = newSlot(p), iSlot = newSlot(tInt(K_I64));
            int skip = a.newLabel();
            a.store(pSlot, RAX);
            a.test(RAX, RAX);
            a.jcc(CC_E, skip);
            if (c->needsDtor)
            {
                a.loadDisp(RCX, RAX, -8);
                a.store(iSlot, RCX);
                int top = a.newLabel(), done = a.newLabel();
                a.bind(top);
                a.load(RAX, iSlot);
                a.test(RAX, RAX);
                a.jcc(CC_E, done);
                a.addImm(RAX, -1);
                a.store(iSlot, RAX);
                a.imulImm(RAX, c->size);
                a.load(RCX, pSlot);
                a.alu(0x01, RCX, RAX);
                c->dtor->used = true;
    callRoutine(c->dtor->label);
                a.jmp(top);
                a.bind(done);
            }
            a.load(RCX, pSlot);
            a.addImm(RCX, -8);
            callRoutine(routine("free"));
            a.bind(skip);
            return tVoid();
        }
        if (p->elem->cat == C_CLASS && p->elem->cls->needsDtor)
        {
            int slot = newSlot(p);
            a.store(slot, RAX);
            int skip = a.newLabel();
            a.test(RAX, RAX);
            a.jcc(CC_E, skip);
            ClassInfo *c = p->elem->cls;
            a.movRR(RCX, RAX);
            if (c->dtor->isVirtual)
            {
                // the dynamic type's destructor
                int pad = (depth_ + 4) % 2;
                if (pad)
                    a.subRsp(8);
                a.subRsp(32);
                a.loadInd(RAX, RCX);
                a.addImm(RAX, 8 * c->dtor->vslot);
                a.loadInd(RAX, RAX);
                a.callReg(RAX);
                a.addRsp(32 + 8 * pad);
            }
            else
            {
                c->dtor->used = true;
                callRoutine(c->dtor->label);
            }
            a.bind(skip);
            a.load(RAX, slot);
        }
        a.movRR(RCX, RAX);
        callRoutine(routine("free"));
        return tVoid();
    }
    default:
        fail("this expression (not yet)", e->line);
    }
}

void Gen::cond(const cpp::ExprP &eIn, int falseLabel)
{
    cpp::ExprP e = asCondition(eIn);
    NT t = expr(e);
    if (t->cat == C_REF)
        t = t->elem;
    if (!isScalar(t))
        fail("an object as a condition", e->line);
    truth(t);
    endFullExpr();
    a.test(RAX, RAX);
    a.jcc(CC_E, falseLabel);
}

// A local's initial value, stored in place (the slot is zeroed first)
void Gen::localInit(int off, const NT &t, const cpp::ExprP &init, int line)
{
    if (t->cat == C_ARRAY && t->elem->cat == C_INT && t->elem->kind == K_I8 && init->k == cpp::EK::Str)
    {
        for (size_t i = 0; i < init->str.size() && (int)i < t->n; ++i)
        {
            a.lea(RCX, off + (int)i);
            a.movImm(RAX, (unsigned char)init->str[i]);
            a.storeRcx(1);
        }
        return;
    }
    if (t->cat == C_ARRAY)
    {
        if (init->k != cpp::EK::InitList)
            fail("initializer of an array", line);
        for (size_t i = 0; i < init->kids.size(); ++i)
        {
            if ((int)i >= t->n)
                fail("too many initializers", line);
            localInit(off + (int)i * sizeOf(t->elem), t->elem, init->kids[i], line);
        }
        return;
    }
    if (t->cat == C_CLASS)
    {
        ThisSrc s;
        s.kind = TH_LOCAL;
        s.off = off;
        std::vector<cpp::ExprP> args = {init};
        bool braced = init->k == cpp::EK::InitList;
        if (braced)
            args = init->kids;
        construct(s, t->cls, args, braced, line);
        return;
    }
    cpp::ExprP e = init;
    if (e->k == cpp::EK::InitList)
    {
        if (e->kids.size() > 1)
            fail("too many initializers", line);
        if (e->kids.empty())
            return; // {}: zero
        e = e->kids[0];
    }
    NT from = expr(e);
    if (from->cat == C_REF)
        from = from->elem;
    if (t->cat == C_PTR && (from->cat == C_PTR || (from->cat == C_INT && e->k == cpp::EK::Int)))
        convert(t, from->cat == C_PTR ? from : t, line);
    else
        convert(t, from, line);
    a.lea(RCX, off);
    a.storeRcx(sizeOf(t));
}

void Gen::declare(const std::string &name, const NT &tIn, const cpp::ExprP &init, bool braced,
                  const std::vector<cpp::ExprP> &args, int line)
{
    NT t = tIn;
    if (t->cat == C_ARRAY && t->n == 0)
    {
        if (!init)
            fail("array without a size", line);
        t = tArray(t->elem, init->k == cpp::EK::Str ? (int)init->str.size() + 1 : (int)init->kids.size());
    }
    if (t->cat == C_VOID)
        fail("a void variable", line);
    if (t->cat == C_ARRAY && t->elem->cat == C_CLASS &&
        (t->elem->cls->needsDtor || !noCtors(t->elem->cls) || t->elem->cls->implicitCtor))
    {
        // an array of objects: each built in place (from its initializer, if
        // any), each destroyed when the scope ends
        ClassInfo *ec = t->elem->cls;
        int off = newSlot(t);
        a.movImm(RAX, 0);
        for (int k = 0; k < alignUp(sizeOf(t), 8); k += 8)
            a.store(off + k, RAX);
        std::vector<cpp::ExprP> items;
        if (init && init->k == cpp::EK::InitList)
            items = init->kids;
        else if (braced)
            items = args;
        scopes_.back().vars[name] = Var{t, false, off};
        for (int i = 0; i < t->n; ++i)
        {
            ThisSrc es;
            es.kind = TH_LOCAL;
            es.off = off + i * ec->size;
            std::vector<cpp::ExprP> one;
            if (i < (int)items.size())
                one.push_back(items[(size_t)i]);
            construct(es, ec, one, i < (int)items.size() && items[(size_t)i]->k == cpp::EK::InitList, line);
            endFullExpr();
            if (ec->needsDtor)
            {
                Cleanup c{off + i * ec->size, ec, 0};
                protect(c);
                scopes_.back().cleanups.push_back(c);
            }
        }
        return;
    }
    if (t->cat == C_REF)
    {
        if (!init)
            fail("a reference without an initializer", line);
        // a temporary object bound here lives as long as the reference
        NT it = typeOfExpr(init);
        bool prvalue = it->cat == C_CLASS && init->k != cpp::EK::Name && init->k != cpp::EK::Member &&
                       init->k != cpp::EK::Index && !(init->k == cpp::EK::Unary && init->op == "*");
        if (prvalue && (init->k == cpp::EK::Call || init->k == cpp::EK::Construct) && t->elem->cat == C_CLASS &&
            derivesFrom(it->cls, t->elem->cls) && rawType(init)->cat == C_CLASS)
        {
            // the object a call returns: a hidden local built in place (its
            // arguments' temporaries die with the full expression as usual)
            std::string hid = "__bound" + std::to_string(++tempCount_);
            declare(hid, it, init, false, {init}, line);
            Var held = *lookup(hid);
            a.lea(RAX, held.off);
            int off = newSlot(tPtr(tVoid()));
            a.store(off, RAX);
            scopes_.back().vars[name] = Var{t, false, off};
            return;
        }
        size_t before = temps_.size();
        bindRef(t, init, line);
        int off = newSlot(tPtr(tVoid()));
        a.store(off, RAX);
        if (prvalue && temps_.size() > before)
        {
            Cleanup c = temps_.back();
            temps_.pop_back();
            c.flag = 0;
            scopes_.back().cleanups.push_back(c);
        }
        endFullExpr();
        scopes_.back().vars[name] = Var{t, false, off};
        return;
    }
    int off = newSlot(t);
    a.movImm(RAX, 0);
    for (int k = 0; k < alignUp(sizeOf(t), 8); k += 8)
        a.store(off + k, RAX);
    if (t->cat == C_CLASS)
    {
        if (name == nrvoName_ && retType_->cat == C_CLASS && t->cls == retType_->cls)
        {
            // the named return value: built in the caller's place from the start
            ThisSrc rs;
            rs.kind = TH_INDIRECT;
            rs.off = retPtrOff_;
            scopes_.back().vars[name] = Var{tRef(t, false), false, retPtrOff_}; // in scope in its initializer
            construct(rs, t->cls, args, braced, line);
            endFullExpr();
            return;
        }
        ThisSrc s;
        s.kind = TH_LOCAL;
        s.off = off;
        scopes_.back().vars[name] = Var{t, false, off}; // in scope in its own initializer (a recursive lambda)
        construct(s, t->cls, args, braced, line);
    }
    else if (init)
        localInit(off, t, init, line);
    endFullExpr();
    scopes_.back().vars[name] = Var{t, false, off};
    if (t->cat == C_CLASS && t->cls->needsDtor)
    {
        Cleanup c{off, t->cls, 0};
        protect(c);
        scopes_.back().cleanups.push_back(c);
    }
}

void Gen::stmt(const cpp::StmtP &s)
{
    switch (s->k)
    {
    case cpp::SK::Expr:
        expr(s->expr);
        endFullExpr();
        break;
    case cpp::SK::Empty:
        break;
    case cpp::SK::Decl:
        if (s->isStatic)
        {
            // a static local: storage in .data, initialized the first time
            // control passes (a guard word says it was)
            for (const cpp::VarDeclarator &d : s->decls)
            {
                cpp::ExprP first = d.args.empty() ? nullptr : d.args[0];
                NT t = d.type && d.type->isAuto() ? autoType(d.type, first, s->line) : typeOf(d.type, s->line);
                bool braced = d.init == cpp::VarDeclarator::Brace;
                std::vector<cpp::ExprP> args = d.args;
                if (braced && args.size() == 1 && args[0]->k == cpp::EK::InitList)
                    args = args[0]->kids;
                if (t->cat == C_ARRAY && t->n == 0)
                    t = tArray(t->elem, braced                                   ? (int)args.size()
                                        : first && first->k == cpp::EK::Str      ? (int)first->str.size() + 1
                                        : first && first->k == cpp::EK::InitList ? (int)first->kids.size()
                                                                                 : (int)args.size());
                while (data.size() % 8)
                    data.push_back('\0');
                int guard = (int)data.size();
                data.append(8, '\0');
                int off = (int)data.size();
                data.append(alignUp(sizeOf(t), 8), '\0');
                Var v;
                v.type = t;
                v.global = true;
                v.off = off;
                if (t->cat == C_ARRAY)
                {
                    cpp::ExprP list = d.args.empty() ? nullptr : first;
                    if (!d.args.empty())
                    {
                        if (braced)
                            list = keepExpr(mkExpr(cpp::EK::InitList, "", args, s->line)); // the elements
                        else if (first->k != cpp::EK::InitList && first->k != cpp::EK::Str)
                            list = keepExpr(mkExpr(cpp::EK::InitList, "", d.args, s->line));
                    }
                    bool constant = t->elem->cat != C_CLASS;
                    if (constant && list)
                    {
                        std::string saved = data;
                        try
                        {
                            constInit(off, t, list, s->line); // constant elements
                        }
                        catch (const cpp::Unsupported &)
                        {
                            data = saved;
                            constant = false;
                        }
                    }
                    if (!constant)
                    {
                        // elements computed (or objects built) the first time through
                        int skip = a.newLabel();
                        a.leaData(RCX, guard);
                        a.loadRcx(8, false);
                        a.test(RAX, RAX);
                        a.jcc(CC_NE, skip);
                        a.movImm(RAX, 1);
                        a.leaData(RCX, guard);
                        a.storeRcx(8);
                        NT el = t->elem;
                        std::vector<cpp::ExprP> items;
                        if (list && list->k == cpp::EK::InitList)
                            items = list->kids;
                        for (int i = 0; i < t->n; ++i)
                        {
                            int eoff = off + i * sizeOf(el);
                            if (el->cat == C_CLASS)
                            {
                                ThisSrc es;
                                es.kind = TH_GLOBAL;
                                es.off = eoff;
                                std::vector<cpp::ExprP> one;
                                if (i < (int)items.size())
                                    one.push_back(items[(size_t)i]);
                                construct(es, el->cls, one, i < (int)items.size() && items[(size_t)i]->k == cpp::EK::InitList,
                                          s->line);
                            }
                            else if (i < (int)items.size())
                            {
                                NT vt = expr(items[(size_t)i]);
                                if (vt->cat == C_REF)
                                    vt = valueAt(vt->elem);
                                if (!(el->cat == C_PTR && (vt->cat == C_PTR || vt->cat == C_INT)))
                                    convert(el, vt, s->line);
                                a.leaData(RCX, eoff);
                                a.storeRcx(sizeOf(el));
                            }
                            endFullExpr();
                        }
                        a.bind(skip);
                    }
                    scopes_.back().vars[d.name] = v;
                    globals_[curNs_ + d.name] = v; // lambdas in the function see it too
                    continue;
                }
                int skip = a.newLabel();
                a.leaData(RCX, guard);
                a.loadRcx(8, false);
                a.test(RAX, RAX);
                a.jcc(CC_NE, skip);
                a.movImm(RAX, 1);
                a.leaData(RCX, guard);
                a.storeRcx(8);
                if (t->cat == C_CLASS)
                {
                    ThisSrc gs;
                    gs.kind = TH_GLOBAL;
                    gs.off = off;
                    construct(gs, t->cls, args, braced, s->line);
                }
                else if (!args.empty())
                {
                    NT vt = expr(args[0]);
                    if (vt->cat == C_REF)
                        vt = valueAt(vt->elem);
                    if (!(t->cat == C_PTR && (vt->cat == C_PTR || vt->cat == C_INT)))
                        convert(t, vt, s->line);
                    a.leaData(RCX, off);
                    a.storeRcx(sizeOf(t));
                }
                endFullExpr();
                a.bind(skip);
                scopes_.back().vars[d.name] = v;
                globals_[curNs_ + d.name] = v; // lambdas in the function see it too
            }
            break;
        }
        for (const cpp::VarDeclarator &d : s->decls)
        {
            if (!d.bindings.empty())
            {
                bindNames(d, s->line);
                continue;
            }
            cpp::ExprP first = d.args.empty() ? nullptr : d.args[0];
            NT t = d.type && d.type->isAuto() ? autoType(d.type, first, s->line) : typeOf(d.type, s->line);
            cpp::ExprP init;
            bool braced = d.init == cpp::VarDeclarator::Brace;
            if (d.args.size() == 1 && !braced)
                init = d.args[0];
            else if (!d.args.empty() || braced)
            {
                auto list = std::make_shared<cpp::Expr>();
                keepExprs_.push_back(list);
                list->k = cpp::EK::InitList;
                list->line = s->line;
                list->kids = d.args;
                if (d.args.size() == 1 && d.args[0]->k == cpp::EK::InitList)
                    list = d.args[0];
                init = list;
            }
            std::vector<cpp::ExprP> args = d.args;
            // (an object's construct() reads T x{{a, b}} itself: one element
            // {a, b} of an initializer_list, or the items a, b)
            if (braced && args.size() == 1 && args[0]->k == cpp::EK::InitList && t->cat != C_CLASS)
                args = args[0]->kids;
            declare(d.name, t, init, braced, args, s->line);
        }
        break;
    case cpp::SK::Block:
        scopes_.emplace_back();
        for (const cpp::StmtP &x : s->body)
            stmt(x);
        destroyScopes(scopes_.size() - 1);
        scopes_.pop_back();
        break;
    case cpp::SK::If:
    {
        if (s->condDecl)
        {
            // if (T x = e) ...: x in scope for both branches, tested as the condition
            scopes_.emplace_back();
            if (s->init)
                stmt(s->init);
            stmt(s->condDecl);
            cpp::ExprP c = s->expr;
            if (!c)
            {
                if (s->condDecl->decls.empty())
                    fail("a declaration as the condition", s->line);
                c = keepExpr(mkName(s->condDecl->decls[0].name, s->line));
            }
            int other = a.newLabel(), end = a.newLabel();
            cond(c, other);
            stmt(s->then);
            a.jmp(end);
            a.bind(other);
            if (s->els)
                stmt(s->els);
            a.bind(end);
            destroyScopes(scopes_.size() - 1);
            scopes_.pop_back();
            break;
        }
        if (s->isConstexpr)
        {
            // only the taken branch exists
            scopes_.emplace_back();
            if (s->init)
                stmt(s->init);
            if (constInt(s->expr))
                stmt(s->then);
            else if (s->els)
                stmt(s->els);
            destroyScopes(scopes_.size() - 1);
            scopes_.pop_back();
            break;
        }
        scopes_.emplace_back();
        if (s->init)
            stmt(s->init);
        int other = a.newLabel(), end = a.newLabel();
        cond(s->expr, other);
        stmt(s->then);
        a.jmp(end);
        a.bind(other);
        if (s->els)
            stmt(s->els);
        a.bind(end);
        destroyScopes(scopes_.size() - 1);
        scopes_.pop_back();
        break;
    }
    case cpp::SK::While:
    {
        if (s->condDecl)
        {
            // while (T x = e) ...: x made anew (and destroyed) each time round
            if (s->condDecl->decls.empty())
                fail("a declaration as the condition", s->line);
            int top = a.newLabel(), end = a.newLabel(), out = a.newLabel();
            a.bind(top);
            scopes_.emplace_back();
            stmt(s->condDecl);
            cond(keepExpr(mkName(s->condDecl->decls[0].name, s->line)), out);
            loops_.push_back(Loop{end, top, scopes_.size() - 1});
            stmt(s->then);
            loops_.pop_back();
            destroyScopes(scopes_.size() - 1);
            a.jmp(top);
            a.bind(out);
            destroyScopes(scopes_.size() - 1);
            scopes_.pop_back();
            a.bind(end);
            break;
        }
        int top = a.newLabel(), end = a.newLabel();
        a.bind(top);
        cond(s->expr, end);
        loops_.push_back(Loop{end, top, scopes_.size()});
        stmt(s->then);
        loops_.pop_back();
        a.jmp(top);
        a.bind(end);
        break;
    }
    case cpp::SK::Do:
    {
        int top = a.newLabel(), next = a.newLabel(), end = a.newLabel();
        a.bind(top);
        loops_.push_back(Loop{end, next, scopes_.size()});
        stmt(s->then);
        loops_.pop_back();
        a.bind(next);
        cond(s->expr, end);
        a.jmp(top);
        a.bind(end);
        break;
    }
    case cpp::SK::For:
    {
        scopes_.emplace_back();
        if (s->init)
            stmt(s->init);
        int top = a.newLabel(), next = a.newLabel(), end = a.newLabel(), out = a.newLabel();
        a.bind(top);
        if (s->cond2)
            cond(s->cond2, end);
        loops_.push_back(Loop{out, next, scopes_.size()});
        stmt(s->then);
        loops_.pop_back();
        a.bind(next);
        if (s->step)
        {
            expr(s->step);
            endFullExpr();
        }
        a.jmp(top);
        a.bind(out);
        a.bind(end);
        destroyScopes(scopes_.size() - 1);
        scopes_.pop_back();
        break;
    }
    case cpp::SK::Switch:
    {
        if (s->condDecl || s->init)
            fail("switch with a declaration", s->line);
        NT st = expr(s->expr);
        if (st->cat != C_INT)
            fail("switch on a non-integer", s->line);
        endFullExpr();
        Kind k = promote(st->kind);
        int slot = newSlot(tInt(K_I64));
        a.store(slot, RAX);
        int end = a.newLabel(), deflt = -1;
        std::vector<int> labels;
        // constant cases close together: a jump table instead of a compare per case
        std::vector<int64_t> vals;
        bool table = true;
        for (const cpp::StmtP &x : s->body)
            if (x->k == cpp::SK::Case)
            {
                try
                {
                    vals.push_back(constInt(x->expr));
                }
                catch (const cpp::Unsupported &)
                {
                    table = false;
                    break;
                }
            }
        int64_t lo = 0, hi = 0;
        if (table && vals.size() >= 4)
        {
            lo = *std::min_element(vals.begin(), vals.end());
            hi = *std::max_element(vals.begin(), vals.end());
            std::vector<int64_t> sorted = vals;
            std::sort(sorted.begin(), sorted.end());
            table = lo >= -0x40000000 && hi <= 0x40000000 && hi - lo <= 4 * (int64_t)vals.size() + 16 &&
                    std::adjacent_find(sorted.begin(), sorted.end()) == sorted.end() &&
                    !(isUnsigned(k) && lo < 0);
        }
        else
            table = false;
        if (table)
        {
            for (const cpp::StmtP &x : s->body)
                if (x->k == cpp::SK::Case || x->k == cpp::SK::Default)
                {
                    labels.push_back(a.newLabel());
                    if (x->k == cpp::SK::Default)
                        deflt = labels.back();
                }
            int outside = deflt >= 0 ? deflt : end;
            std::vector<int> entries(hi - lo + 1, outside);
            size_t ci = 0, li = 0;
            for (const cpp::StmtP &x : s->body)
                if (x->k == cpp::SK::Case || x->k == cpp::SK::Default)
                {
                    if (x->k == cpp::SK::Case)
                        entries[vals[ci++] - lo] = labels[li];
                    ++li;
                }
            int tbl = a.newLabel();
            wrap(k);
            if (lo)
                a.addImm(RAX, (int32_t)-lo);
            a.movImm(RCX, hi - lo);
            a.alu(0x39, RAX, RCX);
            a.jcc(CC_A, outside);
            a.tableJump(tbl);
            a.bind(tbl);
            for (int l : entries)
                a.tableEntry(l);
        }
        for (const cpp::StmtP &x : s->body)
        {
            if (table)
                break;
            if (x->k == cpp::SK::Case)
            {
                int l = a.newLabel();
                labels.push_back(l);
                NT ct = expr(x->expr);
                Kind cmpK = common(k, ct->kind);
                wrap(cmpK);
                a.movRR(RCX, RAX);
                a.load(RAX, slot);
                wrap(cmpK);
                a.alu(0x39, RAX, RCX);
                a.jcc(CC_E, l);
            }
            else if (x->k == cpp::SK::Default)
            {
                deflt = a.newLabel();
                labels.push_back(deflt);
            }
        }
        if (!table)
            a.jmp(deflt >= 0 ? deflt : end);
        scopes_.emplace_back();
        // break leaves the switch; continue still belongs to the enclosing loop
        int cont = loops_.empty() ? -1 : loops_.back().continueLabel;
        loops_.push_back(Loop{end, cont, scopes_.size() - 1});
        size_t next = 0;
        for (const cpp::StmtP &x : s->body)
        {
            if (x->k == cpp::SK::Case || x->k == cpp::SK::Default)
                a.bind(labels[next++]);
            else
                stmt(x);
        }
        loops_.pop_back();
        destroyScopes(scopes_.size() - 1);
        scopes_.pop_back();
        a.bind(end);
        break;
    }
    case cpp::SK::Try:
        tryStmt(s);
        break;
    case cpp::SK::RangeFor:
        rangeFor(s);
        break;
    case cpp::SK::LocalClass:
        if (s->local && s->local->k == cpp::DK::UsingDirective)
        {
            tuUsings_[curTu_].push_back(joinName(s->local->name));
            break;
        }
        if (s->local && s->local->k == cpp::DK::Alias)
        {
            aliases_[curNs_ + s->local->name.back()] = Alias{s->local->aliased, curNs_, bind_};
            break;
        }
        if (s->local && s->local->k == cpp::DK::UsingDecl)
        {
            usingDecls_[s->local->name.back()] = joinName(s->local->name);
            break;
        }
        if (s->local && s->local->k == cpp::DK::Enum)
        {
            enumDecl(s->local, curNs_);
            break;
        }
        if (s->local && s->local->k == cpp::DK::Class && !s->local->isTemplate)
        {
            // a class in the function's scope
            std::string key = curNs_ + joinName(s->local->name);
            if (!classes_.count(key) || !classes_[key]->complete)
            {
                Method *savedCur = cur_;
                cur_ = nullptr;
                if (!s->local->forwardOnly)
                    classDecl(s->local);
                cur_ = savedCur;
            }
            break;
        }
        fail("this local declaration (not yet)", s->line);
    case cpp::SK::Break:
        if (loops_.empty())
            fail("break outside a loop", s->line);
        destroyScopes(loops_.back().scopeDepth);
        a.jmp(loops_.back().breakLabel);
        break;
    case cpp::SK::Continue:
    {
        int i = (int)loops_.size() - 1;
        if (i < 0 || loops_[i].continueLabel < 0)
            fail("continue outside a loop", s->line);
        // a switch's entry carries the enclosing loop's continue label
        size_t depth = loops_[i].scopeDepth;
        for (int k = i; k >= 0; --k)
            if (loops_[k].continueLabel == loops_[i].continueLabel)
                depth = loops_[k].scopeDepth;
        destroyScopes(depth);
        a.jmp(loops_[i].continueLabel);
        break;
    }
    case cpp::SK::Return:
        if (deducing_)
        {
            if (s->expr && !deducedRet_)
            {
                NT t = typeOfExpr(s->expr);
                if (t->cat == C_REF)
                    t = t->elem;
                if (t->cat == C_ARRAY)
                    t = tPtr(t->elem);
                deducedRet_ = t;
            }
            a.jmp(retLabel_);
            break;
        }
        if (s->expr)
        {
            Var *nrv = retType_->cat == C_CLASS && !nrvoName_.empty() && s->expr->k == cpp::EK::Name &&
                               s->expr->name[0] == nrvoName_
                           ? lookup(nrvoName_)
                           : nullptr;
            if (nrv && (nrv->global || nrv->off != retPtrOff_ || nrv->type->cat != C_REF))
                nrv = nullptr; // a variable of that name, but not the named return value
            if (nrv)
                ; // already there (a static local is not built in the caller's place)
            else if (retType_->cat == C_CLASS)
            {
                // build the result in the caller's place
                a.load(RAX, retPtrOff_);
                int slot = newSlot(tPtr(tVoid()));
                a.store(slot, RAX);
                ThisSrc rs;
                rs.kind = TH_INDIRECT;
                rs.off = slot;
                std::vector<cpp::ExprP> one = {s->expr};
                bool braced = s->expr->k == cpp::EK::InitList;
                if (braced)
                    one = s->expr->kids;
                else if (s->expr->k == cpp::EK::Name && s->expr->name.size() == 1)
                {
                    // return local;  moves it (as C++ does)
                    bool local = false;
                    for (const Scope &sc : scopes_)
                    {
                        auto v = sc.vars.find(s->expr->name[0]);
                        if (v != sc.vars.end())
                            local = !v->second.global && v->second.type->cat == C_CLASS;
                    }
                    // a by-value class parameter (held as the address of the caller's copy)
                    if (!local && cur_ && cur_->decl)
                        for (size_t pi = 0; pi < cur_->decl->params.size() && pi < cur_->params.size(); ++pi)
                            if (cur_->decl->params[pi].name == s->expr->name[0] && cur_->params[pi]->cat == C_CLASS)
                                local = true;
                    if (local)
                    {
                        auto mv = keepExpr(mkName("move", s->line));
                        mv->name = {"std", "move"};
                        one = {keepExpr(mkExpr(cpp::EK::Call, "", {mv, s->expr}, s->line))};
                    }
                }
                construct(rs, retType_->cls, one, braced, s->line);
            }
            else if (retType_->cat == C_REF)
                bindRef(retType_, s->expr, s->line);
            else
            {
                NT t = expr(s->expr);
                if (t->cat == C_REF)
                    t = t->elem;
                if (retType_->cat == C_PTR && (t->cat == C_PTR || (t->cat == C_INT && s->expr->k == cpp::EK::Int)))
                    convert(retType_, t->cat == C_PTR ? t : retType_, s->line);
                else if (retType_->cat != C_VOID)
                    convert(retType_, t, s->line);
            }
            endFullExpr();
        }
        destroyScopes(0);
        a.jmp(retLabel_);
        break;
    default:
        fail("this statement (not yet)", s->line);
    }
}

} // namespace

std::string compileExe(const std::string &path, const std::string &source)
{
    cpp::g_libraryOverride = &libraryHeaders();
    // QUANTUM_NATIVE_LIB=<dir>: the library headers read from there instead
    // (working on lib/native without rebuilding the compiler)
    static std::vector<std::pair<std::string, std::string>> fromDisk;
    if (const char *dir = std::getenv("QUANTUM_NATIVE_LIB"))
    {
        fromDisk = libraryHeaders();
        for (auto &h : fromDisk)
        {
            std::ifstream in(std::string(dir) + "/" + h.first, std::ios::binary);
            if (!in)
                continue;
            std::ostringstream ss;
            ss << in.rdbuf();
            h.second = ss.str();
        }
        // and the headers not embedded yet
        std::error_code ec;
        for (const auto &e : std::filesystem::directory_iterator(dir, ec))
        {
            std::string name = e.path().filename().string();
            bool known = false;
            for (auto &h : fromDisk)
                known = known || h.first == name;
            if (known || !e.is_regular_file())
                continue;
            std::ifstream in(e.path().string(), std::ios::binary);
            std::ostringstream ss;
            ss << in.rdbuf();
            fromDisk.push_back({name, ss.str()});
        }
        cpp::g_libraryOverride = &fromDisk;
    }
    cpp::Preprocessed pp;
    // main(argc, argv) gets them from the startup library (appended: the
    // program's own line numbers stay as they are; generated only when used)
    std::string text = source + "\n#include <__startup>\n";
    try
    {
        pp = cpp::preprocess(path, text);
    }
    catch (...)
    {
        cpp::g_libraryOverride = nullptr;
        throw;
    }
    cpp::g_libraryOverride = nullptr;
    cpp::Program prog = cpp::parse(pp);
    Gen g;
    g.files_ = prog.files;
    g.trace_ = std::getenv("QUANTUM_NATIVE_TRACE") != nullptr;
    g.verbose_ = std::getenv("QUANTUM_NATIVE_VERBOSE") != nullptr;
    g_failFile.clear();
    g.program(prog);
    if (const char *mapPath = std::getenv("QUANTUM_NATIVE_MAP"))
        g.writeMap(mapPath); // function addresses, for a debugger's crash address
    return writePe(g.a, g.entry, g.imports, g.data, g.dataPtrs);
}

} // namespace native

int nativeCompileFile(const std::string &path, const std::string &outPath)
{
    std::ifstream in(path, std::ios::binary);
    if (!in)
    {
        std::cerr << path << ": error: cannot open\n";
        return 1;
    }
    std::ostringstream ss;
    ss << in.rdbuf();
    try
    {
        std::string exe = native::compileExe(path, ss.str());
        std::ofstream out(outPath, std::ios::binary);
        out << exe;
        return out ? 0 : 1;
    }
    catch (const cpp::Unsupported &u)
    {
        std::cerr << (u.file.empty() ? path : u.file) << ":" << u.line << ": error: " << u.what() << "\n";
        return 1;
    }
}
