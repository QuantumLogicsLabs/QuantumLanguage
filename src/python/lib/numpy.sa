"""NumPy for the Quantum compiler: n-dimensional arrays written in Python.

Arrays keep NumPy's model: a shared buffer (a list), an offset, a shape and
strides counted in elements, so slices are views. Results follow NumPy 2:
its type promotion, fixed-width integer wraparound, pairwise float sums,
np.round's algorithm, and array2string's printing.
"""

import math as _math
import builtins as _bi
import sys as _sys
import _npcore

__version__ = "2.4.6"

pi = _math.pi
e = _math.e
inf = _math.inf
nan = _math.nan
euler_gamma = 0.5772156649015329
newaxis = None
PINF = inf
NINF = -inf

_MAXSIZE = 9223372036854775807


# ═══════════════════════════════════ dtypes ═══════════════════════════════════

class dtype:
    """A data type: name, kind ('b' 'i' 'u' 'f'), item size."""

    _registry = {}

    def __new__(cls, spec=None, align=False, copy=False):
        return _dtype_of(spec)

    @classmethod
    def _make(cls, name, kind, itemsize, char, typestr):
        self = object.__new__(cls)
        self.name = name
        self.kind = kind
        self.itemsize = itemsize
        self.char = char
        self.str = typestr
        self.type = None
        self.byteorder = "=" if itemsize > 1 else "|"
        self.alignment = itemsize
        self.names = None
        self.fields = None
        self.shape = ()
        self.ndim = 0
        self.subdtype = None
        self.isnative = True
        self.descr = [("", typestr)]
        cls._registry[name] = self
        return self

    @property
    def num(self):
        return _DTYPE_NUM.get(self.name, 0)

    def __repr__(self):
        return f"dtype('{self.name}')"

    def __str__(self):
        return self.name

    def __eq__(self, other):
        if isinstance(other, dtype):
            return self is other
        try:
            return self is _dtype_of(other)
        except TypeError:
            return False

    def __ne__(self, other):
        return not self == other

    def __hash__(self):
        return hash(self.name)

    def __reduce__(self):
        return (dtype, (self.name,))

    @property
    def bits(self):
        return self.itemsize * 8


_DTYPE_NUM = {"bool": 0, "int8": 1, "uint8": 2, "int16": 3, "uint16": 4, "int32": 5, "uint32": 6, "int64": 9,
              "uint64": 10, "float16": 23, "float32": 11, "float64": 12}

_bool_dt = dtype._make("bool", "b", 1, "?", "|b1")
_int8_dt = dtype._make("int8", "i", 1, "b", "|i1")
_int16_dt = dtype._make("int16", "i", 2, "h", "<i2")
_int32_dt = dtype._make("int32", "i", 4, "i", "<i4")
_int64_dt = dtype._make("int64", "i", 8, "q", "<i8")
_uint8_dt = dtype._make("uint8", "u", 1, "B", "|u1")
_uint16_dt = dtype._make("uint16", "u", 2, "H", "<u2")
_uint32_dt = dtype._make("uint32", "u", 4, "I", "<u4")
_uint64_dt = dtype._make("uint64", "u", 8, "Q", "<u8")
_float16_dt = dtype._make("float16", "f", 2, "e", "<f2")
_float32_dt = dtype._make("float32", "f", 4, "f", "<f4")
_float64_dt = dtype._make("float64", "f", 8, "d", "<f8")

_INT_RANGE = {"int8": (-128, 127), "int16": (-32768, 32767), "int32": (-2147483648, 2147483647),
              "int64": (-9223372036854775808, 9223372036854775807), "uint8": (0, 255), "uint16": (0, 65535),
              "uint32": (0, 4294967295), "uint64": (0, 18446744073709551615)}

_ALIASES = {"bool": "bool", "?": "bool", "b1": "bool", "bool_": "bool", "bool8": "bool",
            "int8": "int8", "i1": "int8", "b": "int8", "byte": "int8",
            "int16": "int16", "i2": "int16", "h": "int16", "short": "int16",
            "int32": "int32", "i4": "int32", "i": "int32", "intc": "int32",
            "int64": "int64", "i8": "int64", "q": "int64", "l": "int64", "int": "int64", "int_": "int64",
            "intp": "int64", "p": "int64", "longlong": "int64", "long": "int64",
            "uint8": "uint8", "u1": "uint8", "B": "uint8", "ubyte": "uint8",
            "uint16": "uint16", "u2": "uint16", "H": "uint16", "ushort": "uint16",
            "uint32": "uint32", "u4": "uint32", "I": "uint32", "uintc": "uint32",
            "uint64": "uint64", "u8": "uint64", "Q": "uint64", "L": "uint64", "uint": "uint64", "uintp": "uint64",
            "ulonglong": "uint64", "ulong": "uint64",
            "float16": "float16", "f2": "float16", "e": "float16", "half": "float16",
            "float32": "float32", "f4": "float32", "f": "float32", "single": "float32",
            "float64": "float64", "f8": "float64", "d": "float64", "float": "float64", "double": "float64",
            "float_": "float64", "longdouble": "float64", "g": "float64"}


def _dtype_of(spec):
    if spec is None:
        return _float64_dt
    if isinstance(spec, dtype):
        return spec
    if isinstance(spec, str):
        key = spec.lstrip("<>=|")
        name = _ALIASES.get(key)
        if name is None:
            raise TypeError(f"data type '{spec}' not understood")
        return dtype._registry[name]
    if spec is _bi.bool:
        return _bool_dt
    if spec is _bi.int:
        return _int64_dt
    if spec is _bi.float:
        return _float64_dt
    if spec is _bi.complex:
        raise TypeError("complex arrays are not supported")
    if isinstance(spec, type) and issubclass(spec, generic):
        dt = getattr(spec, "_dtype", None)
        if dt is not None:
            return dt
        if spec in (signedinteger, integer):
            return _int64_dt
        if spec is unsignedinteger:
            return _uint64_dt
        if spec in (floating, inexact, number):
            return _float64_dt
    if hasattr(spec, "dtype") and isinstance(spec.dtype, dtype):
        return spec.dtype
    raise TypeError(f"Cannot interpret '{spec!r}' as a data type")


_KIND_ORDER = {"b": 0, "u": 1, "i": 1, "f": 2}


def _int_result(dt1, dt2):
    """The promotion of two integer dtypes (NumPy's table)."""
    if dt1 is dt2:
        return dt1
    s1, s2 = dt1.kind == "i", dt2.kind == "i"
    if s1 == s2:
        return dt1 if dt1.itemsize >= dt2.itemsize else dt2
    signed, unsigned = (dt1, dt2) if s1 else (dt2, dt1)
    if signed.itemsize > unsigned.itemsize:
        return signed
    size = unsigned.itemsize * 2
    if size > 8:
        return _float64_dt
    return {2: _int16_dt, 4: _int32_dt, 8: _int64_dt}[size]


def promote_types(t1, t2):
    t1 = _dtype_of(t1)
    t2 = _dtype_of(t2)
    if t1 is t2:
        return t1
    if t1.kind == "b":
        return t2
    if t2.kind == "b":
        return t1
    if t1.kind in "iu" and t2.kind in "iu":
        return _int_result(t1, t2)
    if t1.kind == "f" and t2.kind == "f":
        return t1 if t1.itemsize >= t2.itemsize else t2
    # int with float: the float must hold the int
    f, i = (t1, t2) if t1.kind == "f" else (t2, t1)
    if f.itemsize == 8 or i.itemsize >= 4:
        return _float64_dt
    if f.itemsize == 4 or i.itemsize == 2:
        return _float32_dt
    return f if f.itemsize > i.itemsize else _float32_dt


def _weak_kind(x):
    """A Python scalar's kind (it adapts to the array's dtype, NEP 50)."""
    if x is True or x is False:
        return "b"
    if type(x) is _bi.int:
        return "i"
    if type(x) is _bi.float:
        return "f"
    return None


def result_type(*arrays_and_dtypes):
    strong = []
    weak = []
    for a in arrays_and_dtypes:
        if isinstance(a, ndarray):
            strong.append(a.dtype)
        elif isinstance(a, generic):
            strong.append(a.dtype)
        elif isinstance(a, (dtype, str, type)):
            strong.append(_dtype_of(a))
        else:
            k = _weak_kind(a)
            if k is None:
                strong.append(asarray(a).dtype)
            else:
                weak.append(k)
    if not strong:
        if "f" in weak:
            return _float64_dt
        if "i" in weak:
            return _int64_dt
        return _bool_dt
    dt = strong[0]
    for d in strong[1:]:
        dt = promote_types(dt, d)
    for k in weak:
        if k == "f" and dt.kind != "f":
            dt = _float64_dt
        elif k == "i" and dt.kind == "b":
            dt = _int64_dt
    return dt


def can_cast(from_, to, casting="safe"):
    if not isinstance(from_, (dtype, str, type)):
        from_ = asarray(from_).dtype
    f = _dtype_of(from_)
    t = _dtype_of(to)
    if casting == "unsafe":
        return True
    if casting in ("no", "equiv"):
        return f is t
    if f is t:
        return True
    if casting == "same_kind":
        return _KIND_ORDER[f.kind] <= _KIND_ORDER[t.kind] and not (f.kind == "i" and t.kind == "u")
    if f.kind == "b":
        return True
    if t.kind == "b":
        return False
    if f.kind in "iu" and t.kind in "iu":
        if f.kind == t.kind:
            return f.itemsize <= t.itemsize
        if f.kind == "u":
            return t.itemsize > f.itemsize
        return False
    if f.kind in "iu" and t.kind == "f":
        if t.itemsize == 8:
            return True
        if t.itemsize == 4:
            return f.itemsize <= 2
        return f.itemsize <= 1
    if f.kind == "f" and t.kind == "f":
        return f.itemsize <= t.itemsize
    return False


def issubdtype(arg1, arg2):
    if not (isinstance(arg1, type) and issubclass(arg1, generic)):
        arg1 = _dtype_of(arg1).type
    if not (isinstance(arg2, type) and issubclass(arg2, generic)):
        arg2 = _dtype_of(arg2).type
    return issubclass(arg1, arg2)


def _fix_int(v, name):
    lo, hi = _INT_RANGE[name]
    if lo <= v <= hi:
        return v
    span = hi - lo + 1
    return (v - lo) % span + lo


def _caster(dt):
    """A function converting a Python value to the dtype's value."""
    k = dt.kind
    if k == "f":
        if dt.itemsize == 8:
            return _to_f64
        return _to_f32
    if k == "b":
        return _to_bool
    name = dt.name

    def conv(v):
        if type(v) is _bi.float or isinstance(v, _bi.float):
            if v != v or v in (inf, -inf):
                return _INT_RANGE[name][0] if dt.kind == "i" else 0
            v = _bi.int(v)
        else:
            v = _bi.int(v)
        return _fix_int(v, name)
    return conv


def _to_f64(v):
    return _bi.float(v)


def _to_f32(v):
    return _npcore.f32(_bi.float(v))


def _to_bool(v):
    return _bi.bool(v)


# ═══════════════════════════════════ scalars ══════════════════════════════════

class generic:
    """The base of NumPy's scalar types."""

    @property
    def dtype(self):
        return type(self)._dtype

    @property
    def shape(self):
        return ()

    @property
    def ndim(self):
        return 0

    @property
    def size(self):
        return 1

    @property
    def itemsize(self):
        return type(self)._dtype.itemsize

    @property
    def nbytes(self):
        return type(self)._dtype.itemsize

    @property
    def T(self):
        return self

    def item(self):
        return _py(self)

    def tolist(self):
        return _py(self)

    def astype(self, dt):
        return _scalar(_caster(_dtype_of(dt))(_py(self)), _dtype_of(dt))

    def __array__(self):
        return array(_py(self), dtype=self.dtype)

    def reshape(self, *shape):
        return array(self).reshape(*shape)

    def round(self, decimals=0):
        return around(self, decimals)

    def sum(self, *a, **k):
        return self

    def all(self, *a, **k):
        return bool_(bool(self))

    def any(self, *a, **k):
        return bool_(bool(self))


class number(generic):
    pass


class integer(number):
    _not_python_int = True

    def is_integer(self):
        return True

    @property
    def numerator(self):
        return self

    @property
    def denominator(self):
        return 1


class signedinteger(integer):
    pass


class unsignedinteger(integer):
    pass


class inexact(number):
    pass


class floating(inexact):
    pass


class complexfloating(inexact):
    pass


def _py(x):
    """The plain Python value of a NumPy scalar."""
    t = type(x)
    if t is _bi.int or t is _bi.float or t is _bi.bool:
        return x
    if isinstance(x, bool_):
        return x._b
    if isinstance(x, integer):
        return _bi.int.__index__(x)
    if isinstance(x, floating):
        return _bi.float.__float__(x)
    return x


def _int_scalar_class(name, base):
    dt = dtype._registry[name]

    def __new__(cls, value=0):
        if isinstance(value, str):
            value = _bi.int(value)
        if isinstance(value, (ndarray,)):
            return value.astype(dt)
        v = _caster(dt)(_py(value))
        return _bi.int.__new__(cls, v)

    def __repr__(self):
        return f"np.{name}({_bi.int.__repr__(self)})"

    def __str__(self):
        return _bi.int.__repr__(self)

    def __hash__(self):
        return _bi.int.__hash__(self)

    cls = type(name, (base, _bi.int), {"__new__": __new__, "__repr__": __repr__, "__str__": __str__,
                                        "__hash__": __hash__, "_dtype": dt, "__module__": "numpy"})
    dt.type = cls
    return cls


class bool_(generic):
    _dtype = _bool_dt
    _not_python_int = True

    def __new__(cls, value=False):
        if isinstance(value, ndarray):
            return value.astype(_bool_dt)
        b = _bi.bool(_py(value))
        if b:
            return True_
        return False_

    def __bool__(self):
        return self._b

    def __repr__(self):
        return "np.True_" if self._b else "np.False_"

    def __str__(self):
        return "True" if self._b else "False"

    def __hash__(self):
        return hash(self._b)

    def __index__(self):
        return int(self._b)

    def __int__(self):
        return int(self._b)

    def __float__(self):
        return float(self._b)

    def __format__(self, spec):
        return format(self._b, spec)

    def __eq__(self, other):
        if isinstance(other, ndarray):
            return NotImplemented
        return bool_(self._b == _py(other))

    def __ne__(self, other):
        if isinstance(other, ndarray):
            return NotImplemented
        return bool_(self._b != _py(other))

    def __invert__(self):
        return bool_(not self._b)

    def __and__(self, other):
        if isinstance(other, (bool_, _bi.bool)):
            return bool_(self._b and _py(other))
        return _scalar_binop(self, other, _UFUNCS["bitwise_and"])

    def __or__(self, other):
        if isinstance(other, (bool_, _bi.bool)):
            return bool_(self._b or _py(other))
        return _scalar_binop(self, other, _UFUNCS["bitwise_or"])

    def __xor__(self, other):
        if isinstance(other, (bool_, _bi.bool)):
            return bool_(self._b != _py(other))
        return _scalar_binop(self, other, _UFUNCS["bitwise_xor"])

    __rand__ = __and__
    __ror__ = __or__
    __rxor__ = __xor__


_bool_dt.type = bool_
bool_.__name__ = "bool"
bool_.__qualname__ = "bool"
bool_.__module__ = "numpy"
True_ = object.__new__(bool_)
True_._b = True
False_ = object.__new__(bool_)
False_._b = False

bool = bool_
int8 = _int_scalar_class("int8", signedinteger)
int16 = _int_scalar_class("int16", signedinteger)
int32 = _int_scalar_class("int32", signedinteger)
int64 = _int_scalar_class("int64", signedinteger)
uint8 = _int_scalar_class("uint8", unsignedinteger)
uint16 = _int_scalar_class("uint16", unsignedinteger)
uint32 = _int_scalar_class("uint32", unsignedinteger)
uint64 = _int_scalar_class("uint64", unsignedinteger)


def _float_scalar_class(name, f32):
    dt = dtype._registry[name]

    def __new__(cls, value=0.0):
        if isinstance(value, ndarray):
            return value.astype(dt)
        if isinstance(value, str):
            value = _bi.float(value)
        v = _caster(dt)(_py(value))
        return _bi.float.__new__(cls, v)

    if f32:
        def _s(self):
            return _npcore.f32repr(_bi.float.__float__(self))
    else:
        def _s(self):
            return _bi.float.__repr__(self)

    def __repr__(self):
        return f"np.{name}({_s(self)})"

    def __str__(self):
        return _s(self)

    def __hash__(self):
        return _bi.float.__hash__(self)

    def is_integer(self):
        return _bi.float.is_integer(self)

    cls = type(name, (floating, _bi.float), {"__new__": __new__, "__repr__": __repr__, "__str__": __str__,
                                             "__hash__": __hash__, "is_integer": is_integer, "_dtype": dt,
                                             "__module__": "numpy", "_not_python_float": f32})
    dt.type = cls
    return cls


float16 = _float_scalar_class("float16", True)
float32 = _float_scalar_class("float32", True)
float64 = _float_scalar_class("float64", False)

int_ = int64
intp = int64
intc = int32
uint = uint64
uintp = uint64
byte = int8
ubyte = uint8
short = int16
ushort = uint16
longlong = int64
ulonglong = uint64
single = float32
double = float64
half = float16
longdouble = float64
float_ = float64

_SCALAR_TYPES = (int8, int16, int32, int64, uint8, uint16, uint32, uint64, float16, float32, float64)


def _scalar(v, dt):
    """A NumPy scalar of dtype dt holding the (already converted) value v."""
    t = dt.type
    if dt.kind == "b":
        return True_ if v else False_
    if dt.kind == "f":
        return _bi.float.__new__(t, v)
    return _bi.int.__new__(t, v)


def _scalar_binop(a, b, uf):
    if isinstance(b, ndarray):
        return NotImplemented
    r = uf(a, b)
    return r


def _scalar_rbinop(a, b, uf):
    if isinstance(b, ndarray):
        return NotImplemented
    return uf(b, a)


def _install_scalar_ops():
    ops = [("__add__", "add"), ("__sub__", "subtract"), ("__mul__", "multiply"), ("__truediv__", "true_divide"),
           ("__floordiv__", "floor_divide"), ("__mod__", "remainder"), ("__pow__", "power"),
           ("__lshift__", "left_shift"), ("__rshift__", "right_shift"), ("__and__", "bitwise_and"),
           ("__or__", "bitwise_or"), ("__xor__", "bitwise_xor"),
           ("__lt__", "less"), ("__le__", "less_equal"), ("__gt__", "greater"), ("__ge__", "greater_equal"),
           ("__eq__", "equal"), ("__ne__", "not_equal")]
    for dunder, name in ops:
        uf = _UFUNCS[name]

        def fwd(self, other, _uf=uf):
            if isinstance(other, ndarray):
                return NotImplemented
            if not isinstance(other, (_bi.int, _bi.float, _bi.bool, generic)):
                return NotImplemented
            return _uf(self, other)

        def rev(self, other, _uf=uf):
            if isinstance(other, ndarray):
                return NotImplemented
            if not isinstance(other, (_bi.int, _bi.float, _bi.bool, generic)):
                return NotImplemented
            return _uf(other, self)

        for cls in _SCALAR_TYPES:
            setattr(cls, dunder, fwd)
            if dunder not in ("__lt__", "__le__", "__gt__", "__ge__", "__eq__", "__ne__"):
                setattr(cls, "__r" + dunder[2:], rev)
        if dunder in ("__add__", "__sub__", "__mul__", "__truediv__", "__floordiv__", "__mod__", "__pow__"):
            setattr(bool_, dunder, fwd)
            setattr(bool_, "__r" + dunder[2:], rev)
    for dunder, name in (("__lt__", "less"), ("__le__", "less_equal"), ("__gt__", "greater"),
                         ("__ge__", "greater_equal")):
        def cmp(self, other, _uf=_UFUNCS[name]):
            if isinstance(other, ndarray):
                return NotImplemented
            return _uf(self, other)
        setattr(bool_, dunder, cmp)

    def neg(self):
        return negative(self)

    def pos(self):
        return self

    def ab(self):
        return absolute(self)

    def inv(self):
        return invert(self)
    for cls in _SCALAR_TYPES:
        cls.__neg__ = neg
        cls.__pos__ = pos
        cls.__abs__ = ab
        if issubclass(cls, integer):
            cls.__invert__ = inv
    bool_.__neg__ = neg
    bool_.__abs__ = ab


# ═══════════════════════════════════ arrays ═══════════════════════════════════

def _prod(shape):
    p = 1
    for s in shape:
        p *= s
    return p


def _c_strides(shape):
    strides = []
    acc = 1
    for s in reversed(shape):
        strides.append(acc)
        acc *= s if s else 1
    return tuple(reversed(strides))


def _norm_shape(shape):
    if isinstance(shape, (_bi.int, integer)):
        return (_bi.int(shape),)
    return tuple(_bi.int(s) for s in shape)


class flagsobj:
    def __init__(self, a):
        self._a = a

    @property
    def c_contiguous(self):
        return self._a._is_c_contig()

    @property
    def f_contiguous(self):
        a = self._a
        if a.ndim <= 1:
            return a._is_c_contig()
        return False

    @property
    def owndata(self):
        return self._a.base is None

    @property
    def writeable(self):
        return self._a._writeable

    def __getitem__(self, key):
        return getattr(self, {"C_CONTIGUOUS": "c_contiguous", "F_CONTIGUOUS": "f_contiguous",
                              "OWNDATA": "owndata", "WRITEABLE": "writeable", "C": "c_contiguous",
                              "F": "f_contiguous"}[key])


class ndarray:
    """An n-dimensional array of one dtype."""

    __array_priority__ = 0.0

    def __new__(cls, shape=None, dtype=float, buffer=None, offset=0, strides=None, order=None):
        dt = _dtype_of(dtype)
        shape = _norm_shape(shape)
        data = [_caster(dt)(0)] * _prod(shape)
        return _make(data, shape, dt)

    # ── layout ──

    def _is_c_contig(self):
        return self._strides == _c_strides(self._shape) or self.size <= 1

    def _indices(self):
        """Buffer positions of the elements in C order."""
        shape = self._shape
        n = _prod(shape)
        if n == 0:
            return []
        off = self._off
        if self._strides == _c_strides(shape):
            return range(off, off + n)
        idx = [off]
        for dim, st in zip(shape, self._strides):
            idx = [i + k * st for i in idx for k in range(dim)]
        return idx

    def _values(self):
        """The elements as a list in C order (a copy)."""
        buf = self._buf
        shape = self._shape
        n = _prod(shape)
        if self._strides == _c_strides(shape):
            off = self._off
            return buf[off:off + n]
        return [buf[i] for i in self._indices()]

    # ── attributes ──

    @property
    def shape(self):
        return self._shape

    @shape.setter
    def shape(self, value):
        r = self.reshape(value)
        if not self._is_c_contig():
            raise AttributeError("Incompatible shape for in-place modification. Use `.reshape()` to make a copy with the desired shape.")
        self._shape = r._shape
        self._strides = r._strides

    @property
    def ndim(self):
        return len(self._shape)

    @property
    def size(self):
        return _prod(self._shape)

    @property
    def dtype(self):
        return self._dtype

    @property
    def itemsize(self):
        return self._dtype.itemsize

    @property
    def nbytes(self):
        return self.size * self._dtype.itemsize

    @property
    def strides(self):
        return tuple(s * self._dtype.itemsize for s in self._strides)

    @property
    def base(self):
        return self._base

    @property
    def flags(self):
        return flagsobj(self)

    @property
    def T(self):
        return self.transpose()

    @property
    def mT(self):
        return swapaxes(self, -1, -2)

    @property
    def flat(self):
        return flatiter(self)

    @property
    def real(self):
        return self

    @property
    def imag(self):
        return zeros_like(self)

    @property
    def data(self):
        return memoryview_like(self)

    def __len__(self):
        if not self._shape:
            raise TypeError("len() of unsized object")
        return self._shape[0]

    def __array__(self, dtype=None, copy=None):
        if dtype is not None:
            return self.astype(dtype)
        return self

    # ── conversion ──

    def tolist(self):
        if not self._shape:
            return _py(self._buf[self._off])
        vals = [_py(v) for v in self._values()]
        return _nest(vals, self._shape)

    def item(self, *args):
        if not args:
            if self.size != 1:
                raise ValueError("can only convert an array of size 1 to a Python scalar")
            return _py(self._values()[0])
        if len(args) == 1 and isinstance(args[0], (_bi.int, integer)):
            vals = self._values()
            i = _bi.int(args[0])
            if i < 0:
                i += len(vals)
            if not 0 <= i < len(vals):
                raise IndexError(f"index {args[0]} is out of bounds for size {len(vals)}")
            return _py(vals[i])
        return _py(self[tuple(args) if len(args) > 1 else args[0]])

    def astype(self, dtype, order="K", casting="unsafe", subok=True, copy=True):
        dt = _dtype_of(dtype)
        if casting != "unsafe" and not can_cast(self._dtype, dt, casting):
            raise TypeError(f"Cannot cast array data from {self._dtype!r} to {dt!r} according to the rule '{casting}'")
        if dt is self._dtype and not copy:
            return self
        if self._dtype.kind == "f" and dt.kind in "iu":
            conv = _caster(dt)
            vals = []
            for v in self._values():
                if v != v or v in (inf, -inf):
                    vals.append(_INT_RANGE[dt.name][0])
                else:
                    vals.append(conv(_math.trunc(v)))
            return _make(vals, self._shape, dt)
        conv = _caster(dt)
        return _make([conv(v) for v in self._values()], self._shape, dt)

    def copy(self, order="C"):
        return _make(self._values(), self._shape, self._dtype)

    def __copy__(self):
        return self.copy()

    def __deepcopy__(self, memo):
        return self.copy()

    def view(self, dtype=None):
        if dtype is not None and _dtype_of(dtype) is not self._dtype:
            raise TypeError("view() with a different dtype is not supported")
        v = _view_of(self, self._off, self._shape, self._strides)
        return v

    def fill(self, value):
        conv = _caster(self._dtype)
        v = conv(_py(value))
        for i in self._indices():
            self._buf[i] = v

    # ── shape manipulation ──

    def reshape(self, *shape, order="C"):
        if len(shape) == 1 and not isinstance(shape[0], (_bi.int, integer)):
            shape = shape[0]
        shape = list(_norm_shape(shape))
        size = self.size
        if shape.count(-1) > 1:
            raise ValueError("can only specify one unknown dimension")
        if -1 in shape:
            known = _prod([s for s in shape if s != -1])
            if known == 0 or size % known:
                raise ValueError(f"cannot reshape array of size {size} into shape {_shape_str(tuple(shape))}")
            shape[shape.index(-1)] = size // known
        shape = tuple(shape)
        if _prod(shape) != size:
            raise ValueError(f"cannot reshape array of size {size} into shape {_shape_str(shape)}")
        if order == "F":
            vals = self.transpose()._values()
            return _make(vals, tuple(reversed(shape)), self._dtype).transpose()
        if self._is_c_contig():
            return _view_of(self, self._off, shape, _c_strides(shape))
        return _make(self._values(), shape, self._dtype)

    def resize(self, *new_shape, refcheck=True):
        if len(new_shape) == 1 and not isinstance(new_shape[0], (_bi.int, integer)):
            new_shape = new_shape[0]
        shape = _norm_shape(new_shape)
        vals = self._values()
        n = _prod(shape)
        vals = (vals + [_caster(self._dtype)(0)] * n)[:n]
        self._buf = vals
        self._off = 0
        self._shape = shape
        self._strides = _c_strides(shape)

    def ravel(self, order="C"):
        if order == "F":
            return self.transpose().ravel()
        if self._is_c_contig():
            return _view_of(self, self._off, (self.size,), (1,))
        return _make(self._values(), (self.size,), self._dtype)

    def flatten(self, order="C"):
        if order == "F":
            return self.transpose().flatten()
        return _make(self._values(), (self.size,), self._dtype)

    def transpose(self, *axes):
        if not axes or (len(axes) == 1 and axes[0] is None):
            axes = tuple(reversed(range(self.ndim)))
        elif len(axes) == 1 and not isinstance(axes[0], (_bi.int, integer)):
            axes = tuple(axes[0])
        axes = tuple(_norm_axis(a, self.ndim) for a in axes)
        if sorted(axes) != list(range(self.ndim)):
            raise ValueError("axes don't match array")
        shape = tuple(self._shape[a] for a in axes)
        strides = tuple(self._strides[a] for a in axes)
        return _view_of(self, self._off, shape, strides)

    def swapaxes(self, a1, a2):
        return swapaxes(self, a1, a2)

    def squeeze(self, axis=None):
        return squeeze(self, axis)

    # ── element access ──

    def __getitem__(self, key):
        return _getitem(self, key)

    def __setitem__(self, key, value):
        _setitem(self, key, value)

    def __iter__(self):
        if not self._shape:
            raise TypeError("iteration over a 0-d array")
        for i in range(self._shape[0]):
            yield self[i]

    def __contains__(self, value):
        return _bi.bool((self == value).any())

    # ── arithmetic ──

    def __add__(self, o):
        return add(self, o)

    def __radd__(self, o):
        return add(o, self)

    def __sub__(self, o):
        return subtract(self, o)

    def __rsub__(self, o):
        return subtract(o, self)

    def __mul__(self, o):
        return multiply(self, o)

    def __rmul__(self, o):
        return multiply(o, self)

    def __truediv__(self, o):
        return true_divide(self, o)

    def __rtruediv__(self, o):
        return true_divide(o, self)

    def __floordiv__(self, o):
        return floor_divide(self, o)

    def __rfloordiv__(self, o):
        return floor_divide(o, self)

    def __mod__(self, o):
        return remainder(self, o)

    def __rmod__(self, o):
        return remainder(o, self)

    def __divmod__(self, o):
        return divmod_(self, o)

    def __pow__(self, o, mod=None):
        return power(self, o)

    def __rpow__(self, o):
        return power(o, self)

    def __matmul__(self, o):
        return matmul(self, o)

    def __rmatmul__(self, o):
        return matmul(o, self)

    def __and__(self, o):
        return bitwise_and(self, o)

    def __rand__(self, o):
        return bitwise_and(o, self)

    def __or__(self, o):
        return bitwise_or(self, o)

    def __ror__(self, o):
        return bitwise_or(o, self)

    def __xor__(self, o):
        return bitwise_xor(self, o)

    def __rxor__(self, o):
        return bitwise_xor(o, self)

    def __lshift__(self, o):
        return left_shift(self, o)

    def __rshift__(self, o):
        return right_shift(self, o)

    def __neg__(self):
        return negative(self)

    def __pos__(self):
        return positive(self)

    def __abs__(self):
        return absolute(self)

    def __invert__(self):
        return invert(self)

    def __iadd__(self, o):
        return add(self, o, out=self)

    def __isub__(self, o):
        return subtract(self, o, out=self)

    def __imul__(self, o):
        return multiply(self, o, out=self)

    def __itruediv__(self, o):
        return true_divide(self, o, out=self)

    def __ifloordiv__(self, o):
        return floor_divide(self, o, out=self)

    def __imod__(self, o):
        return remainder(self, o, out=self)

    def __ipow__(self, o):
        return power(self, o, out=self)

    def __iand__(self, o):
        return bitwise_and(self, o, out=self)

    def __ior__(self, o):
        return bitwise_or(self, o, out=self)

    def __ixor__(self, o):
        return bitwise_xor(self, o, out=self)

    def __imatmul__(self, o):
        r = matmul(self, o)
        self[...] = r
        return self

    def __eq__(self, o):
        return equal(self, o)

    def __ne__(self, o):
        return not_equal(self, o)

    def __lt__(self, o):
        return less(self, o)

    def __le__(self, o):
        return less_equal(self, o)

    def __gt__(self, o):
        return greater(self, o)

    def __ge__(self, o):
        return greater_equal(self, o)

    __hash__ = None

    def __bool__(self):
        if self.size != 1:
            raise ValueError("The truth value of an array with more than one element is ambiguous. Use a.any() or a.all()")
        return _bi.bool(self._values()[0])

    def __int__(self):
        if self.size != 1:
            raise TypeError("only length-1 arrays can be converted to Python scalars")
        return _bi.int(self._values()[0])

    def __float__(self):
        if self.size != 1:
            raise TypeError("only length-1 arrays can be converted to Python scalars")
        return _bi.float(self._values()[0])

    def __index__(self):
        if self.ndim != 0 or self._dtype.kind not in "iub":
            raise TypeError("only integer scalar arrays can be converted to a scalar index")
        return _bi.int(self._values()[0])

    def __round__(self, ndigits=None):
        return around(self, ndigits or 0)

    def __format__(self, spec):
        if self.ndim == 0:
            return format(self[()], spec)
        if spec:
            raise TypeError("unsupported format string passed to numpy.ndarray.__format__")
        return str(self)

    # ── methods that are functions ──

    def sum(self, axis=None, dtype=None, out=None, keepdims=False, initial=None, where=None):
        return sum(self, axis=axis, dtype=dtype, out=out, keepdims=keepdims, initial=initial, where=where)

    def prod(self, axis=None, dtype=None, out=None, keepdims=False, initial=None, where=None):
        return prod(self, axis=axis, dtype=dtype, out=out, keepdims=keepdims, initial=initial, where=where)

    def min(self, axis=None, out=None, keepdims=False, initial=None, where=None):
        return amin(self, axis=axis, out=out, keepdims=keepdims, initial=initial, where=where)

    def max(self, axis=None, out=None, keepdims=False, initial=None, where=None):
        return amax(self, axis=axis, out=out, keepdims=keepdims, initial=initial, where=where)

    def argmin(self, axis=None, out=None, keepdims=False):
        return argmin(self, axis=axis, keepdims=keepdims)

    def argmax(self, axis=None, out=None, keepdims=False):
        return argmax(self, axis=axis, keepdims=keepdims)

    def mean(self, axis=None, dtype=None, out=None, keepdims=False, where=None):
        return mean(self, axis=axis, dtype=dtype, keepdims=keepdims, where=where)

    def std(self, axis=None, dtype=None, out=None, ddof=0, keepdims=False, where=None):
        return std(self, axis=axis, dtype=dtype, ddof=ddof, keepdims=keepdims, where=where)

    def var(self, axis=None, dtype=None, out=None, ddof=0, keepdims=False, where=None):
        return var(self, axis=axis, dtype=dtype, ddof=ddof, keepdims=keepdims, where=where)

    def ptp(self, axis=None, out=None, keepdims=False):
        return ptp(self, axis=axis, keepdims=keepdims)

    def cumsum(self, axis=None, dtype=None, out=None):
        return cumsum(self, axis=axis, dtype=dtype)

    def cumprod(self, axis=None, dtype=None, out=None):
        return cumprod(self, axis=axis, dtype=dtype)

    def all(self, axis=None, out=None, keepdims=False, where=None):
        return all(self, axis=axis, keepdims=keepdims, where=where)

    def any(self, axis=None, out=None, keepdims=False, where=None):
        return any(self, axis=axis, keepdims=keepdims, where=where)

    def sort(self, axis=-1, kind=None, order=None, stable=None):
        r = sort(self, axis=axis, kind=kind)
        self[...] = r

    def argsort(self, axis=-1, kind=None, order=None, stable=None):
        return argsort(self, axis=axis, kind=kind)

    def partition(self, kth, axis=-1, kind="introselect", order=None):
        r = partition(self, kth, axis=axis)
        self[...] = r

    def argpartition(self, kth, axis=-1, kind="introselect", order=None):
        return argpartition(self, kth, axis=axis)

    def searchsorted(self, v, side="left", sorter=None):
        return searchsorted(self, v, side=side, sorter=sorter)

    def nonzero(self):
        return nonzero(self)

    def clip(self, min=None, max=None, out=None, **kw):
        return clip(self, min, max, out=out)

    def round(self, decimals=0, out=None):
        return around(self, decimals, out=out)

    def trace(self, offset=0, axis1=0, axis2=1, dtype=None, out=None):
        return trace(self, offset, axis1, axis2, dtype=dtype)

    def diagonal(self, offset=0, axis1=0, axis2=1):
        return diagonal(self, offset, axis1, axis2)

    def dot(self, b, out=None):
        return dot(self, b)

    def repeat(self, repeats, axis=None):
        return repeat(self, repeats, axis)

    def take(self, indices, axis=None, out=None, mode="raise"):
        return take(self, indices, axis=axis, mode=mode)

    def put(self, indices, values, mode="raise"):
        put(self, indices, values, mode=mode)

    def compress(self, condition, axis=None, out=None):
        return compress(condition, self, axis=axis)

    def conj(self):
        return self.copy()

    conjugate = conj

    def __reduce__(self):
        return (array, (self.tolist(), self._dtype.name))

    # ── printing ──

    def __repr__(self):
        return array_repr(self)

    def __str__(self):
        return array_str(self)


def memoryview_like(a):
    return a.tolist()


def _make(values, shape, dt):
    """A new C-contiguous array owning the given list."""
    a = object.__new__(ndarray)
    a._buf = values
    a._off = 0
    a._shape = shape
    a._strides = _c_strides(shape)
    a._dtype = dt
    a._base = None
    a._writeable = True
    return a


def _view_of(src, off, shape, strides):
    a = object.__new__(ndarray)
    a._buf = src._buf
    a._off = off
    a._shape = tuple(shape)
    a._strides = tuple(strides)
    a._dtype = src._dtype
    a._base = src if src._base is None else src._base
    a._writeable = src._writeable
    return a


def _nest(vals, shape):
    if not shape:
        return vals[0]
    if len(shape) == 1:
        return list(vals)
    step = _prod(shape[1:])
    return [_nest(vals[i * step:(i + 1) * step], shape[1:]) for i in range(shape[0])]


def _shape_str(shape):
    if len(shape) == 1:
        return f"({shape[0]},)"
    return "(" + ", ".join(str(s) for s in shape) + ")"


def _norm_axis(axis, ndim):
    axis = _bi.int(axis)
    if axis < -ndim or axis >= ndim:
        raise AxisError(f"axis {axis} is out of bounds for array of dimension {ndim}")
    return axis + ndim if axis < 0 else axis


class UFuncTypeError(TypeError):
    pass


class AxisError(ValueError, IndexError):
    pass


class ComplexWarning(RuntimeWarning):
    pass


class VisibleDeprecationWarning(UserWarning):
    pass


class RankWarning(RuntimeWarning):
    pass


class exceptions:
    AxisError = AxisError
    ComplexWarning = ComplexWarning
    VisibleDeprecationWarning = VisibleDeprecationWarning
    RankWarning = RankWarning


class flatiter:
    def __init__(self, a):
        self.base = a
        self._i = 0

    def __iter__(self):
        for v in self.base._values():
            yield _scalar(v, self.base._dtype)

    def __len__(self):
        return self.base.size

    def __getitem__(self, key):
        flat = self.base.ravel()
        return flat[key]

    def __setitem__(self, key, value):
        a = self.base
        idx = list(a._indices())
        tmp = arange(len(idx))[key]
        if isinstance(tmp, ndarray):
            positions = tmp._values()
            vals = asarray(value)
            vv = broadcast_to(vals, (len(positions),))._values() if vals.size != 1 else [vals._values()[0]] * len(positions)
            conv = _caster(a._dtype)
            for p, v in zip(positions, vv):
                a._buf[idx[p]] = conv(_py(v))
        else:
            a._buf[idx[_bi.int(tmp)]] = _caster(a._dtype)(_py(value))

    def __next__(self):
        if self._i >= self.base.size:
            raise StopIteration
        v = self.base._values()[self._i]
        self._i += 1
        return _scalar(v, self.base._dtype)


# ═══════════════════════════════ array creation ═══════════════════════════════

def _infer(obj):
    """(flat values, shape, dtype) of a nested sequence."""
    if isinstance(obj, ndarray):
        return obj._values(), obj._shape, obj._dtype
    if isinstance(obj, generic):
        return [_py(obj)], (), obj.dtype
    if isinstance(obj, (_bi.bool,)):
        return [obj], (), _bool_dt
    if isinstance(obj, _bi.int):
        if not -9223372036854775808 <= obj <= 9223372036854775807:
            if 0 <= obj <= 18446744073709551615:
                return [obj], (), _uint64_dt
            raise OverflowError("Python int too large to convert to C long")
        return [obj], (), _int64_dt
    if isinstance(obj, _bi.float):
        return [obj], (), _float64_dt
    if isinstance(obj, (range,)):
        vals = list(obj)
        return vals, (len(vals),), _int64_dt
    if isinstance(obj, (list, tuple)):
        if len(obj) == 0:
            return [], (0,), _float64_dt
        parts = [_infer(x) for x in obj]
        shape0 = parts[0][1]
        for p in parts:
            if p[1] != shape0:
                raise ValueError("setting an array element with a sequence. The requested array has an inhomogeneous shape after 1 dimensions. The detected shape was "
                                 f"({len(obj)},) + inhomogeneous part.")
        dt = parts[0][2]
        weak_float = False
        any_strong = False
        for x, p in zip(obj, parts):
            dt = promote_types(dt, p[2]) if p is not parts[0] else dt
        vals = []
        for p in parts:
            vals.extend(p[0])
        return vals, (len(obj),) + shape0, dt
    if hasattr(obj, "__array__"):
        return _infer(obj.__array__())
    if isinstance(obj, complex):
        raise TypeError("complex values are not supported")
    if obj is None:
        raise TypeError("object arrays are not supported")
    if hasattr(obj, "__iter__") and not isinstance(obj, (str, bytes, dict)):
        return _infer(list(obj))
    raise TypeError(f"cannot make an array from {type(obj).__name__}")


def array(object, dtype=None, copy=True, order="K", subok=False, ndmin=0, like=None):
    if isinstance(object, ndarray) and dtype is None and not copy:
        a = object
    else:
        vals, shape, dt = _infer(object)
        if dtype is not None:
            ndt = _dtype_of(dtype)
            if dt.kind == "f" and ndt.kind in "iu":
                conv = _caster(ndt)
                vals = [conv(_math.trunc(v)) for v in vals]
            else:
                conv = _caster(ndt)
                vals = [conv(_py(v)) for v in vals]
            dt = ndt
        else:
            conv = _caster(dt)
            vals = [conv(_py(v)) for v in vals]
        a = _make(vals, shape, dt)
    while a.ndim < ndmin:
        a = a.reshape((1,) + a._shape)
    return a


def asarray(a, dtype=None, order=None, copy=None, like=None):
    if isinstance(a, ndarray) and (dtype is None or _dtype_of(dtype) is a._dtype):
        return a
    return array(a, dtype=dtype)


asanyarray = asarray
ascontiguousarray = asarray


def asfarray(a):
    return asarray(a, dtype=float64)


def _fill(shape, value, dt):
    shape = _norm_shape(shape)
    return _make([_caster(dt)(value)] * _prod(shape), shape, dt)


def zeros(shape, dtype=float, order="C", like=None):
    return _fill(shape, 0, _dtype_of(dtype))


def ones(shape, dtype=None, order="C", like=None):
    return _fill(shape, 1, _dtype_of(dtype))


def empty(shape, dtype=float, order="C", like=None):
    return _fill(shape, 0, _dtype_of(dtype))


def full(shape, fill_value, dtype=None, order="C", like=None):
    if dtype is None:
        dt = asarray(fill_value).dtype
    else:
        dt = _dtype_of(dtype)
    fv = asarray(fill_value)
    if fv.ndim == 0:
        return _fill(shape, _py(fv._values()[0]), dt)
    return broadcast_to(fv, _norm_shape(shape)).astype(dt)


def zeros_like(a, dtype=None, order="K", subok=True, shape=None):
    a = asarray(a)
    return zeros(a.shape if shape is None else shape, dtype=a.dtype if dtype is None else dtype)


def ones_like(a, dtype=None, order="K", subok=True, shape=None):
    a = asarray(a)
    return ones(a.shape if shape is None else shape, dtype=a.dtype if dtype is None else dtype)


def empty_like(a, dtype=None, order="K", subok=True, shape=None):
    return zeros_like(a, dtype=dtype, shape=shape)


def full_like(a, fill_value, dtype=None, order="K", subok=True, shape=None):
    a = asarray(a)
    return full(a.shape if shape is None else shape, fill_value, dtype=a.dtype if dtype is None else dtype)


def arange(start, stop=None, step=None, dtype=None, like=None):
    if stop is None:
        start, stop = 0, start
    if step is None:
        step = 1
    if step == 0:
        raise ZeroDivisionError("division by zero")
    start, stop, step = _py(start), _py(stop), _py(step)
    if dtype is None:
        dt = result_type(start, stop, step)
        if _bi.all(type(x) is _bi.bool for x in (start, stop, step)):
            dt = _int64_dt
    else:
        dt = _dtype_of(dtype)
    if dt.kind in "iu" and _bi.all(isinstance(x, _bi.int) for x in (start, stop, step)):
        vals = list(range(start, stop, step))
        conv = _caster(dt)
        return _make([conv(v) for v in vals], (len(vals),), dt)
    n = _math.ceil((stop - start) / step)
    if n <= 0:
        return _make([], (0,), dt)
    # NumPy fills from the first two values: start + i * (next - start)
    first = _bi.float(start)
    delta = (first + step) - first
    conv = _caster(dt)
    vals = [conv(first)] + [conv(first + i * delta) for i in range(1, n)]
    return _make(vals, (n,), dt)


def linspace(start, stop, num=50, endpoint=True, retstep=False, dtype=None, axis=0):
    num = _bi.int(num)
    if num < 0:
        raise ValueError(f"Number of samples, {num}, must be non-negative.")
    div = (num - 1) if endpoint else num
    start_a = asarray(start)
    stop_a = asarray(stop)
    if start_a.ndim or stop_a.ndim:
        cols = broadcast_arrays(start_a.astype(float64), stop_a.astype(float64))
        res = stack([linspace(s, t, num, endpoint) for s, t in zip(cols[0].ravel()._values(), cols[1].ravel()._values())], axis=-1)
        res = res.reshape((num,) + cols[0].shape)
        if axis != 0:
            res = moveaxis(res, 0, axis)
        return res
    start = _bi.float(_py(start))
    stop = _bi.float(_py(stop))
    delta = stop - start
    y = [_bi.float(i) for i in range(num)]
    if div > 0:
        step = delta / div
        if step == 0:
            y = [(v / div) * delta for v in y]
        else:
            y = [v * step for v in y]
    else:
        step = nan
        y = [v * delta for v in y]
    y = [v + start for v in y]
    if endpoint and num > 1:
        y[-1] = stop
    res = _make(y, (num,), _float64_dt)
    if dtype is not None:
        dt = _dtype_of(dtype)
        if dt.kind in "iu":
            res = floor(res)
        res = res.astype(dt)
    if retstep:
        return res, float64(step)
    return res


def logspace(start, stop, num=50, endpoint=True, base=10.0, dtype=None, axis=0):
    y = linspace(start, stop, num=num, endpoint=endpoint)
    r = power(base, y)
    if dtype is not None:
        r = r.astype(dtype)
    return r


def geomspace(start, stop, num=50, endpoint=True, dtype=None, axis=0):
    log_start = _math.log10(start)
    log_stop = _math.log10(stop)
    r = logspace(log_start, log_stop, num=num, endpoint=endpoint, base=10.0)
    if num > 0:
        r[0] = start
        if num > 1 and endpoint:
            r[-1] = stop
    if dtype is not None:
        r = r.astype(dtype)
    return r


def eye(N, M=None, k=0, dtype=float, order="C", like=None):
    M = N if M is None else M
    a = zeros((N, M), dtype=dtype)
    one = _caster(a.dtype)(1)
    for i in range(N):
        j = i + k
        if 0 <= j < M:
            a._buf[i * M + j] = one
    return a


def identity(n, dtype=None, like=None):
    return eye(n, dtype=float if dtype is None else dtype)


def diag(v, k=0):
    v = asarray(v)
    if v.ndim == 1:
        n = v.shape[0] + _bi.abs(k)
        res = zeros((n, n), dtype=v.dtype)
        vals = v._values()
        for i, x in enumerate(vals):
            r, c = (i, i + k) if k >= 0 else (i - k, i)
            res._buf[r * n + c] = x
        return res
    if v.ndim == 2:
        return diagonal(v, k).copy()
    raise ValueError("Input must be 1- or 2-d.")


def diagflat(v, k=0):
    return diag(asarray(v).ravel(), k)


def diagonal(a, offset=0, axis1=0, axis2=1):
    a = asarray(a)
    if a.ndim == 2 and axis1 == 0 and axis2 == 1:
        r, c = a.shape
        if offset >= 0:
            n = _bi.max(0, _bi.min(r, c - offset))
            start = a._off + offset * a._strides[1]
        else:
            n = _bi.max(0, _bi.min(r + offset, c))
            start = a._off - offset * a._strides[0]
        v = _view_of(a, start, (n,), (a._strides[0] + a._strides[1],))
        v._writeable = False
        return v
    a2 = moveaxis(a, (axis1, axis2), (-2, -1))
    rows = [diagonal(a2[idx], offset)._values() for idx in ndindex(*a2.shape[:-2])]
    n = len(rows[0]) if rows else 0
    vals = [x for r in rows for x in r]
    return _make(vals, a2.shape[:-2] + (n,), a.dtype)


def tri(N, M=None, k=0, dtype=float):
    M = N if M is None else M
    one = _caster(_dtype_of(dtype))(1)
    zero = _caster(_dtype_of(dtype))(0)
    vals = [one if j <= i + k else zero for i in range(N) for j in range(M)]
    return _make(vals, (N, M), _dtype_of(dtype))


def tril(m, k=0):
    m = asarray(m)
    mask = tri(m.shape[-2], m.shape[-1], k, dtype=bool)
    return where(mask, m, zeros(1, m.dtype))


def triu(m, k=0):
    m = asarray(m)
    mask = tri(m.shape[-2], m.shape[-1], k - 1, dtype=bool)
    return where(mask, zeros(1, m.dtype), m)


def vander(x, N=None, increasing=False):
    x = asarray(x)
    N = len(x) if N is None else N
    cols = []
    for p in range(N):
        cols.append(power(x, p) if p else ones_like(x))
    res = stack(cols, axis=1)
    if not increasing:
        res = res[:, ::-1]
    return res.copy()


def fromfunction(function, shape, *, dtype=float, like=None, **kwargs):
    shape = _norm_shape(shape)
    args = indices(shape, dtype=dtype)
    return function(*args, **kwargs)


def fromiter(iterable, dtype, count=-1, like=None):
    vals = list(iterable)
    if count >= 0:
        vals = vals[:count]
    return array(vals, dtype=dtype)


def frombuffer(*a, **k):
    raise NotImplementedError("frombuffer is not supported")


def indices(dimensions, dtype=int, sparse=False):
    dims = _norm_shape(dimensions)
    res = []
    for ax, d in enumerate(dims):
        shape = [1] * len(dims)
        shape[ax] = d
        r = arange(d, dtype=dtype).reshape(shape)
        if not sparse:
            r = broadcast_to(r, dims).copy()
        res.append(r)
    if sparse:
        return tuple(res)
    return stack(res) if res else array([], dtype=dtype)


def meshgrid(*xi, copy=True, sparse=False, indexing="xy"):
    ndim = len(xi)
    xs = [asarray(x).ravel() for x in xi]
    s0 = (1,) * ndim
    output = [x.reshape(s0[:i] + (-1,) + s0[i + 1:]) for i, x in enumerate(xs)]
    if indexing == "xy" and ndim > 1:
        output[0] = output[0].reshape((1, -1) + s0[2:])
        output[1] = output[1].reshape((-1, 1) + s0[2:])
    if not sparse:
        output = broadcast_arrays(*output)
        output = [o.copy() for o in output]
    return tuple(output) if False else list(output) if False else output


def copy(a, order="K", subok=False):
    return asarray(a).copy()


def tile(A, reps):
    A = asarray(A)
    if isinstance(reps, (_bi.int, integer)):
        reps = (reps,)
    reps = tuple(reps)
    d = len(reps)
    if A.ndim < d:
        A = A.reshape((1,) * (d - A.ndim) + A.shape)
    if d < A.ndim:
        reps = (1,) * (A.ndim - d) + reps
    res = A
    for ax, r in enumerate(reps):
        if r != 1:
            res = concatenate([res] * r, axis=ax) if r > 0 else take(res, [], axis=ax)
    return res.copy() if res is A else res


def repeat(a, repeats, axis=None):
    a = asarray(a)
    if axis is None:
        a = a.ravel()
        axis = 0
    axis = _norm_axis(axis, a.ndim)
    n = a.shape[axis]
    if isinstance(repeats, (_bi.int, integer)):
        reps = [_bi.int(repeats)] * n
    else:
        reps = [_bi.int(r) for r in asarray(repeats).ravel()._values()]
        if len(reps) == 1:
            reps = reps * n
    idx = []
    for i, r in enumerate(reps):
        idx.extend([i] * r)
    return take(a, idx, axis=axis)


# ═══════════════════════════════ broadcasting ═════════════════════════════════

def _broadcast_shapes(*shapes):
    nd = _bi.max((len(s) for s in shapes), default=0)
    out = []
    for i in range(nd):
        dim = 1
        for s in shapes:
            k = len(s) - nd + i
            if k < 0:
                continue
            d = s[k]
            if d == 1:
                continue
            if dim == 1:
                dim = d
            elif d != dim:
                raise ValueError("operands could not be broadcast together with shapes " +
                                 " ".join(_shape_str(s) if len(s) != 1 else f"({s[0]},)" for s in shapes) + " ")
        out.append(dim)
    return tuple(out)


def broadcast_shapes(*args):
    return _broadcast_shapes(*[_norm_shape(s) for s in args])


def _bvalues(a, shape):
    """a's values broadcast to shape, in C order."""
    if a._shape == shape:
        return a._values()
    nd = len(shape)
    pad = nd - a.ndim
    strides = [0] * pad + [0 if a._shape[i] == 1 else a._strides[i] for i in range(a.ndim)]
    if a.size == 1:
        return [a._buf[a._off]] * _prod(shape)
    idx = [a._off]
    for dim, st in zip(shape, strides):
        idx = [i + k * st for i in idx for k in range(dim)]
    buf = a._buf
    return [buf[i] for i in idx]


def broadcast_to(array_, shape, subok=False):
    a = asarray(array_)
    shape = _norm_shape(shape)
    if _broadcast_shapes(a.shape, shape) != shape:
        raise ValueError(f"operands could not be broadcast together with remapped shapes [original->remapped]: {_shape_str(a.shape)}  and requested shape {_shape_str(shape)}")
    pad = len(shape) - a.ndim
    strides = [0] * pad + [0 if a._shape[i] == 1 and shape[pad + i] != 1 else a._strides[i] for i in range(a.ndim)]
    v = _view_of(a, a._off, shape, strides)
    v._writeable = False
    return v


def broadcast_arrays(*args, subok=False):
    arrs = [asarray(a) for a in args]
    shape = _broadcast_shapes(*[a.shape for a in arrs])
    return tuple(broadcast_to(a, shape) for a in arrs)


class broadcast:
    def __init__(self, *args):
        self._arrs = [asarray(a) for a in args]
        self.shape = _broadcast_shapes(*[a.shape for a in self._arrs])
        self.nd = self.ndim = len(self.shape)
        self.size = _prod(self.shape)
        self.numiter = len(args)

    def __iter__(self):
        vals = [_bvalues(a, self.shape) for a in self._arrs]
        return iter(zip(*vals))


# ═════════════════════════════════ ufuncs ═════════════════════════════════════

class _errstate_state:
    divide = "warn"
    over = "warn"
    under = "ignore"
    invalid = "warn"


_err = _errstate_state()
_warned = set()


def _warn(kind, msg):
    mode = getattr(_err, kind)
    if mode == "ignore":
        return
    if mode == "raise":
        raise FloatingPointError(msg)
    _sys.stderr.write(f"RuntimeWarning: {msg}\n")


class errstate:
    def __init__(self, *, all=None, divide=None, over=None, under=None, invalid=None, call=None):
        self._new = {}
        for k, v in (("divide", divide), ("over", over), ("under", under), ("invalid", invalid)):
            if v is None and all is not None:
                v = all
            if v is not None:
                self._new[k] = v

    def __enter__(self):
        self._old = {k: getattr(_err, k) for k in ("divide", "over", "under", "invalid")}
        for k, v in self._new.items():
            setattr(_err, k, v)
        return self

    def __exit__(self, *exc):
        for k, v in self._old.items():
            setattr(_err, k, v)
        return False

    def __call__(self, func):
        def wrapper(*a, **kw):
            with self:
                return func(*a, **kw)
        return wrapper


def seterr(all=None, divide=None, over=None, under=None, invalid=None):
    old = {k: getattr(_err, k) for k in ("divide", "over", "under", "invalid")}
    for k, v in (("divide", divide), ("over", over), ("under", under), ("invalid", invalid)):
        if v is None and all is not None:
            v = all
        if v is not None:
            setattr(_err, k, v)
    return old


def geterr():
    return {k: getattr(_err, k) for k in ("divide", "over", "under", "invalid")}


def _as_operand(x):
    """(array, weak kind or None) for a ufunc operand."""
    if isinstance(x, ndarray):
        return x, None
    if isinstance(x, generic):
        return _make([_py(x)], (), x.dtype), None
    k = _weak_kind(x)
    if k is not None:
        dt = {"b": _bool_dt, "i": _int64_dt, "f": _float64_dt}[k]
        return _make([x], (), dt), k
    return asarray(x), None


def _binary_dtype(a, ka, b, kb):
    """The common dtype of two operands, Python scalars being weak."""
    if ka is None and kb is None:
        return promote_types(a.dtype, b.dtype)
    if ka is not None and kb is not None:
        return result_type(a._buf[a._off], b._buf[b._off])
    arr, k, other = (b, ka, a) if ka is not None else (a, kb, b)
    dt = arr.dtype
    if k == "f" and dt.kind != "f":
        return _float64_dt
    if k == "i":
        if dt.kind == "b":
            return _int64_dt
        if dt.kind in "iu":
            v = other._buf[other._off]
            lo, hi = _INT_RANGE[dt.name]
            if not lo <= v <= hi:
                raise OverflowError(f"Python integer {v} out of bounds for {dt.name}")
    return dt


class ufunc:
    """A universal function: elementwise, with reduce/accumulate/outer."""

    def __init__(self, name, nin, fn, kind="arith", identity=None, out_dtype=None):
        self.__name__ = name
        self.nin = nin
        self.nout = 1
        self.nargs = nin + 1
        self._fn = fn
        self._kind = kind
        self.identity = identity
        self._out_dtype = out_dtype

    def __repr__(self):
        return f"<ufunc '{self.__name__}'>"

    def _result_dtype(self, dt):
        k = self._kind
        if k == "cmp" or k == "pred":
            return _bool_dt
        if k == "float":
            if dt.kind == "f":
                return dt
            if dt.itemsize <= 1 and dt.kind != "b":
                return _float16_dt if False else _float32_dt if dt.itemsize == 1 and False else _float64_dt
            return _float64_dt
        if k == "truediv":
            if dt.kind == "f":
                return dt
            return _float64_dt
        if k == "intbool":
            return dt
        if k == "arith_nobool" and dt.kind == "b":
            return _int64_dt
        return dt

    def __call__(self, *args, out=None, where=True, dtype=None, casting="same_kind", **kw):
        if len(args) > self.nin:
            out = args[self.nin]
            args = args[:self.nin]
        if len(args) != self.nin:
            raise TypeError(f"{self.__name__}() takes from {self.nin} to {self.nin + 1} positional arguments but {len(args)} were given")
        if isinstance(out, tuple):
            out = out[0]
        if self.nin == 1:
            a, ka = _as_operand(args[0])
            dt = a.dtype if dtype is None else _dtype_of(dtype)
            rdt = self._result_dtype(dt) if dtype is None or self._kind in ("cmp", "pred") else _dtype_of(dtype)
            vals = a._values()
            if dt is not a.dtype:
                vals = [_caster(dt)(v) for v in vals]
            res_vals = self._fn(vals, dt, rdt)
            shape = a.shape
            scalar_out = not isinstance(args[0], ndarray)
        else:
            a, ka = _as_operand(args[0])
            b, kb = _as_operand(args[1])
            dt = _binary_dtype(a, ka, b, kb) if dtype is None else _dtype_of(dtype)
            if self._kind == "intbool" and dt.kind == "f":
                raise TypeError(f"ufunc '{self.__name__}' not supported for the input types, and the inputs could not be safely coerced to any supported types according to the casting rule ''safe''")
            rdt = self._result_dtype(dt)
            shape = _broadcast_shapes(a.shape, b.shape)
            av = _bvalues(a, shape)
            bv = _bvalues(b, shape)
            if a.dtype is not dt:
                c = _caster(dt)
                av = [c(v) for v in av]
            if b.dtype is not dt:
                c = _caster(dt)
                bv = [c(v) for v in bv]
            res_vals = self._fn(av, bv, dt, rdt)
            scalar_out = not isinstance(args[0], ndarray) and not isinstance(args[1], ndarray)
        if out is not None:
            if not can_cast(rdt, out.dtype, "same_kind"):
                raise UFuncTypeError(f"Cannot cast ufunc '{self.__name__ if self.__name__ != 'true_divide' else 'divide'}' output from {rdt!r} to {out.dtype!r} with casting rule 'same_kind'")
            if where is not True:
                w = _bvalues(asarray(where), out.shape)
                cur = out._values()
                full_vals = _bvalues(_make(res_vals, shape, rdt), out.shape) if shape != out.shape else res_vals
                res_vals = [r if m else c for r, m, c in zip(full_vals, w, cur)]
                shape = out.shape
            _assign(out, _make(res_vals, shape, rdt))
            return out
        if where is not True:
            w = _bvalues(asarray(where), shape)
            res_vals = [r if m else 0 for r, m in zip(res_vals, w)]
        if scalar_out and shape == ():
            return _scalar(res_vals[0], rdt)
        return _make(res_vals, shape, rdt)

    def reduce(self, array_, axis=0, dtype=None, out=None, keepdims=False, initial=None, where=True):
        a = asarray(array_)
        name = self.__name__
        if name == "add":
            return _np_mod().sum(a, axis=axis, dtype=dtype, keepdims=keepdims, initial=initial)
        if name == "multiply":
            return prod(a, axis=axis, dtype=dtype, keepdims=keepdims, initial=initial)
        if name in ("maximum", "fmax"):
            return amax(a, axis=axis, keepdims=keepdims, initial=initial)
        if name in ("minimum", "fmin"):
            return amin(a, axis=axis, keepdims=keepdims, initial=initial)
        if name == "logical_and":
            return _np_mod().all(a, axis=axis, keepdims=keepdims)
        if name == "logical_or":
            return _np_mod().any(a, axis=axis, keepdims=keepdims)
        return _reduce_generic(self, a, axis, keepdims, initial)

    def accumulate(self, array_, axis=0, dtype=None, out=None):
        a = asarray(array_)
        if a.ndim == 0:
            raise TypeError("cannot accumulate on a scalar")
        axis = _norm_axis(axis, a.ndim)
        moved = moveaxis(a, axis, -1)
        rows = moved.reshape(-1, moved.shape[-1]) if moved.size else moved.reshape(0, moved.shape[-1])
        res_rows = []
        rdt = None
        for r in rows:
            acc = []
            cur = None
            for i in range(r.shape[0]):
                x = r[i]
                cur = x if i == 0 else self(cur, x)
                acc.append(cur)
            arr_r = array(acc, dtype=dtype if dtype is not None else (self._result_dtype(a.dtype) if self.__name__ in ("add", "multiply") and a.dtype.kind == "b" else None))
            if a.size and self.__name__ in ("add", "multiply") and a.dtype.kind in "iu" and dtype is None:
                arr_r = arr_r.astype(a.dtype)
            res_rows.append(arr_r)
        if not res_rows:
            return a.copy()
        res = stack(res_rows).reshape(moved.shape)
        return moveaxis(res, -1, axis)

    def outer(self, A, B, **kw):
        A = asarray(A)
        B = asarray(B)
        return self(A.reshape(A.shape + (1,) * B.ndim), B)

    def at(self, a, indices, b=None):
        idx = asarray(indices).ravel()._values()
        bv = None if b is None else _bvalues(asarray(b), (len(idx),))
        for k, i in enumerate(idx):
            if self.nin == 1:
                a[i] = self(a[i])
            else:
                a[i] = self(a[i], bv[k])

    def reduceat(self, a, indices, axis=0):
        a = asarray(a)
        idx = [_bi.int(i) for i in asarray(indices).ravel()._values()]
        parts = []
        for k, i in enumerate(idx):
            j = idx[k + 1] if k + 1 < len(idx) else a.shape[axis]
            if j <= i:
                parts.append(take(a, [i], axis=axis))
            else:
                parts.append(expand_dims(self.reduce(take(a, list(range(i, j)), axis=axis), axis=axis), axis))
        return concatenate(parts, axis=axis)


def _np_mod():
    return _sys.modules["numpy"]


def _reduce_generic(uf, a, axis, keepdims, initial):
    if axis is None:
        vals = [_scalar(v, a.dtype) for v in a._values()]
        if initial is not None:
            vals = [initial] + vals
        if not vals:
            raise ValueError(f"zero-size array to reduction operation {uf.__name__} which has no identity")
        cur = vals[0]
        for v in vals[1:]:
            cur = uf(cur, v)
        return cur
    axis = _norm_axis(axis, a.ndim)
    moved = moveaxis(a, axis, -1)
    outshape = moved.shape[:-1]
    res = []
    for idx in ndindex(*outshape):
        row = moved[idx]
        cur = row[0] if initial is None else initial
        for x in (row[1:] if initial is None else row):
            cur = uf(cur, x)
        res.append(cur)
    r = array(res).reshape(outshape) if res else zeros(outshape, a.dtype)
    if keepdims:
        r = expand_dims(r, axis)
    return r


# ── elementwise kernels ──

def _wrapper_for(rdt):
    if rdt.kind in "iu":
        name = rdt.name
        lo, hi = _INT_RANGE[name]
        span = hi - lo + 1

        def fix(v):
            if lo <= v <= hi:
                return v
            return (v - lo) % span + lo
        return fix
    if rdt.kind == "f" and rdt.itemsize != 8:
        return _npcore.f32
    return None


def _k_add(a, b, dt, rdt):
    if dt.kind == "b":
        return [x or y for x, y in zip(a, b)]
    r = [x + y for x, y in zip(a, b)]
    fix = _wrapper_for(rdt)
    return [fix(v) for v in r] if fix else r


def _k_sub(a, b, dt, rdt):
    if dt.kind == "b":
        raise TypeError("numpy boolean subtract, the `-` operator, is not supported, use the bitwise_xor, the `^` operator, or the logical_xor function instead.")
    r = [x - y for x, y in zip(a, b)]
    fix = _wrapper_for(rdt)
    return [fix(v) for v in r] if fix else r


def _k_mul(a, b, dt, rdt):
    if dt.kind == "b":
        return [x and y for x, y in zip(a, b)]
    r = [x * y for x, y in zip(a, b)]
    fix = _wrapper_for(rdt)
    return [fix(v) for v in r] if fix else r


def _fdiv(x, y):
    if y == 0:
        if x != x or x == 0:
            _warn("invalid", "invalid value encountered in divide")
            return nan
        _warn("divide", "divide by zero encountered in divide")
        neg = (x < 0) != (_math.copysign(1.0, y) < 0)
        return -inf if neg else inf
    return x / y


def _k_truediv(a, b, dt, rdt):
    fix = _wrapper_for(rdt)
    if dt.kind != "f":
        r = [_fdiv(_bi.float(x), _bi.float(y)) for x, y in zip(a, b)]
    else:
        r = [_fdiv(x, y) for x, y in zip(a, b)]
    return [fix(v) for v in r] if fix else r


def _k_floordiv(a, b, dt, rdt):
    if dt.kind == "b":
        dt = rdt = _int8_dt
    if dt.kind in "iu":
        out = []
        warned = False
        for x, y in zip(a, b):
            if y == 0:
                if not warned:
                    _warn("divide", "divide by zero encountered in floor_divide")
                    warned = True
                out.append(0)
            else:
                out.append(x // y)
        fix = _wrapper_for(rdt)
        return [fix(v) for v in out]
    out = []
    for x, y in zip(a, b):
        if y == 0:
            if x == 0 or x != x:
                _warn("invalid", "invalid value encountered in floor_divide")
                out.append(nan)
            else:
                _warn("divide", "divide by zero encountered in floor_divide")
                out.append(inf if (x > 0) == (_math.copysign(1.0, y) > 0) else -inf)
        elif x != x or y != y:
            out.append(nan)
        elif x in (inf, -inf):
            out.append(nan)
        else:
            out.append(x // y)
    fix = _wrapper_for(rdt)
    return [fix(v) for v in out] if fix else out


def _k_mod(a, b, dt, rdt):
    if dt.kind == "b":
        dt = rdt = _int8_dt
    if dt.kind in "iu":
        out = []
        warned = False
        for x, y in zip(a, b):
            if y == 0:
                if not warned:
                    _warn("divide", "divide by zero encountered in remainder")
                    warned = True
                out.append(0)
            else:
                out.append(x % y)
        return out
    out = []
    for x, y in zip(a, b):
        if y == 0 or x != x or y != y or x in (inf, -inf):
            if y == 0:
                _warn("invalid", "invalid value encountered in remainder")
            out.append(nan)
        elif y in (inf, -inf):
            out.append(x if (x >= 0) == (y > 0) else y)
        else:
            out.append(x % y)
    fix = _wrapper_for(rdt)
    return [fix(v) for v in out] if fix else out


def _k_fmod(a, b, dt, rdt):
    if dt.kind in "iu":
        out = []
        for x, y in zip(a, b):
            if y == 0:
                out.append(0)
            else:
                r = _bi.abs(x) % _bi.abs(y)
                out.append(-r if x < 0 else r)
        return out
    out = []
    for x, y in zip(a, b):
        if y == 0 or x != x or y != y or x in (inf, -inf):
            out.append(nan)
        else:
            out.append(_math.fmod(x, y))
    return out


def _k_pow(a, b, dt, rdt):
    if dt.kind == "b":
        dt = rdt = _int8_dt
    if dt.kind in "iu":
        fix = _wrapper_for(rdt)
        out = []
        for x, y in zip(a, b):
            if y < 0:
                raise ValueError("Integers to negative integer powers are not allowed.")
            out.append(fix(_bi.pow(x, y, 1 << 64) if _bi.abs(x) > 1 and y > 64 else x ** y))
        return out
    out = []
    for x, y in zip(a, b):
        if x < 0 and y != _math.floor(y) and y == y:
            _warn("invalid", "invalid value encountered in power")
            out.append(nan)
        elif x == 0 and y < 0:
            _warn("divide", "divide by zero encountered in power")
            out.append(inf)
        else:
            try:
                out.append(_bi.float(x) ** y)
            except OverflowError:
                _warn("over", "overflow encountered in power")
                out.append(inf if x > 0 or y % 2 == 0 else -inf)
    fix = _wrapper_for(rdt)
    return [fix(v) for v in out] if fix else out


def _cmp_kernel(op):
    def k(a, b, dt, rdt):
        return [op(x, y) for x, y in zip(a, b)]
    return k


def _bit_kernel(op):
    def k(a, b, dt, rdt):
        if dt.kind == "b":
            return [_bi.bool(op(_bi.int(x), _bi.int(y))) for x, y in zip(a, b)]
        fix = _wrapper_for(rdt)
        return [fix(op(x, y)) for x, y in zip(a, b)]
    return k


def _shift_kernel(left):
    def k(a, b, dt, rdt):
        fix = _wrapper_for(rdt)
        if left:
            return [fix(x << y) if y < 64 else 0 for x, y in zip(a, b)]
        return [x >> y if y < 64 else (-1 if x < 0 else 0) for x, y in zip(a, b)]
    return k


def _minmax_kernel(is_max, nan_aware):
    def k(a, b, dt, rdt):
        out = []
        for x, y in zip(a, b):
            if x != x or y != y:
                if nan_aware:
                    out.append(y if x != x else x)
                else:
                    out.append(nan)
            elif is_max:
                out.append(x if x >= y else y)
            else:
                out.append(x if x <= y else y)
        return out
    return k


def _logical_kernel(op):
    def k(a, b, dt, rdt):
        return [op(_bi.bool(x), _bi.bool(y)) for x, y in zip(a, b)]
    return k


def _unary_float(fn, name, domain=None, special=None):
    def k(vals, dt, rdt):
        fix = _wrapper_for(rdt)
        out = []
        warned = False
        for v in vals:
            v = _bi.float(v)
            if v != v:
                out.append(nan)
                continue
            if special is not None:
                s = special(v)
                if s is not None:
                    if s[1] and not warned:
                        _warn(s[1], f"{'divide by zero' if s[1] == 'divide' else 'invalid value'} encountered in {name}")
                        warned = True
                    out.append(s[0])
                    continue
            try:
                out.append(fn(v))
            except (ValueError, OverflowError) as exc:
                if isinstance(exc, OverflowError):
                    if not warned:
                        _warn("over", f"overflow encountered in {name}")
                        warned = True
                    out.append(inf)
                else:
                    if not warned:
                        _warn("invalid", f"invalid value encountered in {name}")
                        warned = True
                    out.append(nan)
        return [fix(v) for v in out] if fix else out
    return k


def _log_special(base):
    def sp(v):
        if v == 0:
            return (-inf, "divide")
        if v < 0:
            return (nan, "invalid")
        if v == inf:
            return (inf, None)
        return None
    return sp


def _sqrt_special(v):
    if v < 0:
        return (nan, "invalid")
    if v == inf:
        return (inf, None)
    return None


def _inf_aware(fn, at_inf, at_neg_inf):
    def g(v):
        if v == inf:
            return at_inf
        if v == -inf:
            return at_neg_inf
        return fn(v)
    return g


def _k_neg(vals, dt, rdt):
    if dt.kind == "b":
        raise TypeError("The numpy boolean negative, the `-` operator, is not supported, use the `~` operator or the logical_not function instead.")
    fix = _wrapper_for(rdt)
    r = [-v for v in vals]
    return [fix(v) for v in r] if fix else r


def _k_pos(vals, dt, rdt):
    return list(vals)


def _k_abs(vals, dt, rdt):
    if dt.kind == "b":
        return list(vals)
    fix = _wrapper_for(rdt)
    r = [_bi.abs(v) for v in vals]
    return [fix(v) for v in r] if fix else r


def _k_sign(vals, dt, rdt):
    if dt.kind == "f":
        return [nan if v != v else (1.0 if v > 0 else -1.0 if v < 0 else 0.0) for v in vals]
    return [1 if v > 0 else -1 if v < 0 else 0 for v in vals]


def _k_invert(vals, dt, rdt):
    if dt.kind == "b":
        return [not v for v in vals]
    if dt.kind == "f":
        raise TypeError("ufunc 'invert' not supported for the input types, and the inputs could not be safely coerced to any supported types according to the casting rule ''safe''")
    fix = _wrapper_for(rdt)
    return [fix(~v) for v in vals]


def _k_not(vals, dt, rdt):
    return [not v for v in vals]


def _rint(v):
    if v != v or v in (inf, -inf):
        return v
    r = _bi.float(_bi.round(v))
    if r == 0 and v < 0:
        return -0.0
    return r


def _k_rint(vals, dt, rdt):
    if dt.kind != "f":
        return list(vals)
    fix = _wrapper_for(rdt)
    r = [_rint(v) for v in vals]
    return [fix(v) for v in r] if fix else r


def _same_kind_round(fn):
    def k(vals, dt, rdt):
        if dt.kind != "f":
            return list(vals)
        out = []
        for v in vals:
            if v != v or v in (inf, -inf):
                out.append(v)
            else:
                r = _bi.float(fn(v))
                if r == 0 and (v < 0 or _math.copysign(1.0, v) < 0):
                    r = -0.0
                out.append(r)
        return out
    return k


def _pred(fn):
    def k(vals, dt, rdt):
        return [fn(v) for v in vals]
    return k


def _k_square(vals, dt, rdt):
    if dt.kind == "b":
        return [x and x for x in vals]
    fix = _wrapper_for(rdt)
    r = [v * v for v in vals]
    return [fix(v) for v in r] if fix else r


def _k_reciprocal(vals, dt, rdt):
    if dt.kind in "iu":
        out = []
        for v in vals:
            if v == 0:
                _warn("divide", "divide by zero encountered in reciprocal")
                out.append(_INT_RANGE[dt.name][0])
            else:
                out.append(1 if v == 1 else -1 if v == -1 else 0)
        return out
    return [_fdiv(1.0, v) for v in vals]


def _gcd(a, b):
    return _math.gcd(_bi.int(a), _bi.int(b))


def _lcm(a, b):
    a = _bi.int(a)
    b = _bi.int(b)
    if a == 0 or b == 0:
        return 0
    return _bi.abs(a * b) // _math.gcd(a, b)


def _hypot(x, y):
    return _math.hypot(x, y)


def _atan2(y, x):
    return _math.atan2(y, x)


def _float_binary(fn, name):
    def k(a, b, dt, rdt):
        out = []
        for x, y in zip(a, b):
            try:
                out.append(fn(_bi.float(x), _bi.float(y)))
            except (ValueError, ZeroDivisionError):
                out.append(nan)
        fix = _wrapper_for(rdt)
        return [fix(v) for v in out] if fix else out
    return k


def _int_binary(fn):
    def k(a, b, dt, rdt):
        if dt.kind == "f":
            raise TypeError("ufunc not supported for the input types")
        return [fn(x, y) for x, y in zip(a, b)]
    return k


def _logaddexp(x, y):
    m = _bi.max(x, y)
    if m == -inf:
        return -inf
    return m + _math.log1p(_math.exp(-_bi.abs(x - y)))


def _copysign(x, y):
    return _math.copysign(x, y)


def _expm1(v):
    return _math.expm1(v)


def _cbrt(v):
    return _math.copysign(_bi.abs(v) ** (1.0 / 3.0), v) if v else v


def _sinc(v):
    if v == 0:
        return 1.0
    y = _math.pi * v
    return _math.sin(y) / y


_UFUNCS = {}


def _def_ufunc(name, nin, fn, kind="arith", identity=None):
    uf = ufunc(name, nin, fn, kind, identity)
    _UFUNCS[name] = uf
    globals()[name] = uf
    return uf


_def_ufunc("add", 2, _k_add, identity=0)
_def_ufunc("subtract", 2, _k_sub)
_def_ufunc("multiply", 2, _k_mul, identity=1)
_def_ufunc("true_divide", 2, _k_truediv, "truediv")
divide = true_divide
_UFUNCS["divide"] = true_divide
_def_ufunc("floor_divide", 2, _k_floordiv, "arith_nobool")
_def_ufunc("remainder", 2, _k_mod, "arith_nobool")
mod = remainder
_def_ufunc("fmod", 2, _k_fmod)
_def_ufunc("power", 2, _k_pow, "arith_nobool")
pow = power
_def_ufunc("float_power", 2, lambda a, b, dt, rdt: _k_pow([_bi.float(x) for x in a], [_bi.float(y) for y in b], _float64_dt, _float64_dt), "float")
_def_ufunc("equal", 2, _cmp_kernel(lambda x, y: x == y), "cmp")
_def_ufunc("not_equal", 2, _cmp_kernel(lambda x, y: x != y), "cmp")
_def_ufunc("less", 2, _cmp_kernel(lambda x, y: x < y), "cmp")
_def_ufunc("less_equal", 2, _cmp_kernel(lambda x, y: x <= y), "cmp")
_def_ufunc("greater", 2, _cmp_kernel(lambda x, y: x > y), "cmp")
_def_ufunc("greater_equal", 2, _cmp_kernel(lambda x, y: x >= y), "cmp")
_def_ufunc("bitwise_and", 2, _bit_kernel(lambda x, y: x & y), "intbool")
_def_ufunc("bitwise_or", 2, _bit_kernel(lambda x, y: x | y), "intbool")
_def_ufunc("bitwise_xor", 2, _bit_kernel(lambda x, y: x ^ y), "intbool")
_def_ufunc("left_shift", 2, _shift_kernel(True), "intbool")
_def_ufunc("right_shift", 2, _shift_kernel(False), "intbool")
_def_ufunc("logical_and", 2, _logical_kernel(lambda x, y: x and y), "cmp")
_def_ufunc("logical_or", 2, _logical_kernel(lambda x, y: x or y), "cmp")
_def_ufunc("logical_xor", 2, _logical_kernel(lambda x, y: x != y), "cmp")
_def_ufunc("maximum", 2, _minmax_kernel(True, False))
_def_ufunc("minimum", 2, _minmax_kernel(False, False))
_def_ufunc("fmax", 2, _minmax_kernel(True, True))
_def_ufunc("fmin", 2, _minmax_kernel(False, True))
_def_ufunc("arctan2", 2, _float_binary(_atan2, "arctan2"), "float")
_def_ufunc("hypot", 2, _float_binary(_hypot, "hypot"), "float")
_def_ufunc("logaddexp", 2, _float_binary(_logaddexp, "logaddexp"), "float")
_def_ufunc("copysign", 2, _float_binary(_copysign, "copysign"), "float")
_def_ufunc("gcd", 2, _int_binary(_gcd), "arith_nobool")
_def_ufunc("lcm", 2, _int_binary(_lcm), "arith_nobool")
_def_ufunc("negative", 1, _k_neg)
_def_ufunc("positive", 1, _k_pos)
_def_ufunc("absolute", 1, _k_abs)
abs = absolute
_def_ufunc("fabs", 1, _unary_float(_math.fabs, "fabs"), "float")
_def_ufunc("sign", 1, _k_sign)
_def_ufunc("invert", 1, _k_invert)
bitwise_not = invert
_def_ufunc("logical_not", 1, _k_not, "pred")
_def_ufunc("sqrt", 1, _unary_float(_math.sqrt, "sqrt", special=_sqrt_special), "float")
_def_ufunc("cbrt", 1, _unary_float(_cbrt, "cbrt"), "float")
_def_ufunc("square", 1, _k_square)
_def_ufunc("reciprocal", 1, _k_reciprocal)
_def_ufunc("exp", 1, _unary_float(_inf_aware(_math.exp, inf, 0.0), "exp"), "float")
_def_ufunc("exp2", 1, _unary_float(_inf_aware(lambda v: 2.0 ** v, inf, 0.0), "exp2"), "float")
_def_ufunc("expm1", 1, _unary_float(_inf_aware(_expm1, inf, -1.0), "expm1"), "float")
_def_ufunc("log", 1, _unary_float(_math.log, "log", special=_log_special(None)), "float")
_def_ufunc("log2", 1, _unary_float(_math.log2, "log2", special=_log_special(2)), "float")
_def_ufunc("log10", 1, _unary_float(_math.log10, "log10", special=_log_special(10)), "float")
_def_ufunc("log1p", 1, _unary_float(_math.log1p, "log1p", special=lambda v: (-inf, "divide") if v == -1 else (nan, "invalid") if v < -1 else (inf, None) if v == inf else None), "float")
_def_ufunc("sin", 1, _unary_float(_math.sin, "sin"), "float")
_def_ufunc("cos", 1, _unary_float(_math.cos, "cos"), "float")
_def_ufunc("tan", 1, _unary_float(_math.tan, "tan"), "float")
_def_ufunc("arcsin", 1, _unary_float(_math.asin, "arcsin"), "float")
_def_ufunc("arccos", 1, _unary_float(_math.acos, "arccos"), "float")
_def_ufunc("arctan", 1, _unary_float(_inf_aware(_math.atan, _math.pi / 2, -_math.pi / 2), "arctan"), "float")
_def_ufunc("sinh", 1, _unary_float(_inf_aware(_math.sinh, inf, -inf), "sinh"), "float")
_def_ufunc("cosh", 1, _unary_float(_inf_aware(_math.cosh, inf, inf), "cosh"), "float")
_def_ufunc("tanh", 1, _unary_float(_inf_aware(_math.tanh, 1.0, -1.0), "tanh"), "float")
_def_ufunc("arcsinh", 1, _unary_float(_inf_aware(_math.asinh, inf, -inf), "arcsinh"), "float")
_def_ufunc("arccosh", 1, _unary_float(_math.acosh, "arccosh"), "float")
_def_ufunc("arctanh", 1, _unary_float(_math.atanh, "arctanh"), "float")
_def_ufunc("degrees", 1, _unary_float(lambda v: v * (180.0 / _math.pi), "degrees"), "float")
_def_ufunc("radians", 1, _unary_float(lambda v: v * (_math.pi / 180.0), "radians"), "float")
rad2deg = degrees
deg2rad = radians
_def_ufunc("floor", 1, _same_kind_round(_math.floor))
_def_ufunc("ceil", 1, _same_kind_round(_math.ceil))
_def_ufunc("trunc", 1, _same_kind_round(_math.trunc))
_def_ufunc("rint", 1, _k_rint)
_def_ufunc("isnan", 1, _pred(lambda v: v != v), "pred")
_def_ufunc("isinf", 1, _pred(lambda v: v in (inf, -inf)), "pred")
_def_ufunc("isfinite", 1, _pred(lambda v: v == v and v not in (inf, -inf)), "pred")
_def_ufunc("signbit", 1, _pred(lambda v: _math.copysign(1.0, _bi.float(v)) < 0), "pred")
_def_ufunc("sinc", 1, _unary_float(_sinc, "sinc"), "float")
_install_scalar_ops()


def fix(x, out=None):
    return trunc(x, out=out) if out is not None else trunc(x)


def divmod_(x1, x2):
    return floor_divide(x1, x2), remainder(x1, x2)


divmod = divmod_
_UFUNCS["divmod"] = divmod_


def around(a, decimals=0, out=None):
    """np.round: scale, round half to even, scale back (NumPy's algorithm)."""
    arr, k = _as_operand(a)
    dt = arr.dtype
    decimals = _bi.int(decimals)
    vals = arr._values()
    if dt.kind in "iub":
        if decimals >= 0:
            res_vals = list(vals)
        else:
            f = 10 ** (-decimals)
            res_vals = []
            for v in vals:
                q, r = _bi.divmod(_bi.int(v), f)
                if 2 * r > f or (2 * r == f and q % 2 == 1):
                    q += 1
                res_vals.append(q * f)
        rdt = _int64_dt if dt.kind == "b" else dt
    else:
        res_vals = []
        if decimals >= 0:
            f = 10.0 ** decimals
            for v in vals:
                if v != v or v in (inf, -inf):
                    res_vals.append(v)
                    continue
                y = v * f
                r = _rint(y) / f
                res_vals.append(r)
        else:
            f = 10.0 ** (-decimals)
            for v in vals:
                if v != v or v in (inf, -inf):
                    res_vals.append(v)
                    continue
                res_vals.append(_rint(v / f) * f)
        rdt = dt
        fixer = _wrapper_for(rdt)
        if fixer:
            res_vals = [fixer(v) for v in res_vals]
    if out is not None:
        _assign(out, _make(res_vals, arr.shape, rdt))
        return out
    if not isinstance(a, ndarray):
        return _scalar(res_vals[0], rdt)
    return _make(res_vals, arr.shape, rdt)


round = around
round_ = around


def clip(a, a_min=None, a_max=None, out=None, *, min=None, max=None, **kw):
    if min is not None:
        a_min = min
    if max is not None:
        a_max = max
    r = a
    if a_min is not None:
        r = maximum(r, a_min)
    if a_max is not None:
        r = minimum(r, a_max)
    if out is not None:
        _assign(out, asarray(r))
        return out
    return r


def nan_to_num(x, copy=True, nan=0.0, posinf=None, neginf=None):
    a = asarray(x)
    if a.dtype.kind != "f":
        return a.copy() if isinstance(x, ndarray) else x
    big = 1.7976931348623157e308 if a.dtype.itemsize == 8 else 3.4028234663852886e38
    pi_ = big if posinf is None else posinf
    ni_ = -big if neginf is None else neginf
    vals = [nan if False else (nan_val if v != v else pi_ if v == inf else ni_ if v == -inf else v) for v in a._values() for nan_val in (nan,)]
    r = _make(vals, a.shape, a.dtype)
    if not copy and isinstance(x, ndarray):
        x[...] = r
        return x
    if not isinstance(x, ndarray):
        return _scalar(vals[0], a.dtype)
    return r


def real_if_close(a, tol=100):
    return asarray(a)


def isclose(a, b, rtol=1e-05, atol=1e-08, equal_nan=False):
    a2 = asarray(a)
    b2 = asarray(b)
    shape = _broadcast_shapes(a2.shape, b2.shape)
    av = _bvalues(a2, shape)
    bv = _bvalues(b2, shape)
    out = []
    for x, y in zip(av, bv):
        x = _bi.float(x)
        y = _bi.float(y)
        if x != x or y != y:
            out.append(equal_nan and x != x and y != y)
        elif x in (inf, -inf) or y in (inf, -inf):
            out.append(x == y)
        else:
            out.append(_bi.abs(x - y) <= atol + rtol * _bi.abs(y))
    if shape == () and not isinstance(a, ndarray) and not isinstance(b, ndarray):
        return bool_(out[0])
    return _make(out, shape, _bool_dt)


def allclose(a, b, rtol=1e-05, atol=1e-08, equal_nan=False):
    return _bi.bool(isclose(a, b, rtol, atol, equal_nan).all() if isinstance(isclose(a, b, rtol, atol, equal_nan), ndarray) else isclose(a, b, rtol, atol, equal_nan))


def array_equal(a1, a2, equal_nan=False):
    try:
        a = asarray(a1)
        b = asarray(a2)
    except Exception:
        return False
    if a.shape != b.shape:
        return False
    av = a._values()
    bv = b._values()
    for x, y in zip(av, bv):
        if x == y:
            continue
        if equal_nan and x != x and y != y:
            continue
        return False
    return True


def array_equiv(a1, a2):
    try:
        a = asarray(a1)
        b = asarray(a2)
        shape = _broadcast_shapes(a.shape, b.shape)
    except Exception:
        return False
    return _bvalues(a, shape) == _bvalues(b, shape)


# ═══════════════════════════════ assignment ═══════════════════════════════════

def _assign(dst, src):
    """dst[...] = src with broadcasting and casting."""
    if not dst._writeable:
        raise ValueError("assignment destination is read-only")
    src = asarray(src) if not isinstance(src, ndarray) else src
    vals = _bvalues(src, dst._shape)
    conv = _caster(dst._dtype)
    if src._dtype.kind == "f" and dst._dtype.kind in "iu":
        vals = [conv(_math.trunc(v)) if v == v and v not in (inf, -inf) else _INT_RANGE[dst._dtype.name][0] for v in vals]
    elif src._dtype is not dst._dtype:
        vals = [conv(v) for v in vals]
    buf = dst._buf
    for i, v in zip(dst._indices(), vals):
        buf[i] = v


# ═══════════════════════════════ indexing ═════════════════════════════════════

def _is_int_index(k):
    return isinstance(k, (_bi.int, integer)) and not isinstance(k, (_bi.bool, bool_))


def _expand_key(a, key):
    if not isinstance(key, tuple):
        key = (key,)
    # lists of ints and arrays are advanced indices
    out = []
    for k in key:
        if isinstance(k, list):
            k = array(k) if k else array([], dtype=int64)
        elif isinstance(k, (bool_, _bi.bool)):
            k = array(_bi.bool(k))
        out.append(k)
    key = out
    n_ell = _bi.sum(1 for k in key if k is Ellipsis)
    if n_ell > 1:
        raise IndexError("an index can only have a single ellipsis ('...')")
    used = _bi.sum(k.ndim if isinstance(k, ndarray) and k.dtype.kind == "b" else 1 for k in key if k is not None and k is not Ellipsis)
    if used > a.ndim:
        raise IndexError(f"too many indices for array: array is {a.ndim}-dimensional, but {used} were indexed")
    if n_ell:
        i = [j for j, x in enumerate(key) if x is Ellipsis][0]
        key = key[:i] + [slice(None)] * (a.ndim - used) + key[i + 1:]
    else:
        key = key + [slice(None)] * (a.ndim - used)
    return key


def _basic_index(a, key):
    """A view for an index of ints, slices and None; key is expanded."""
    off = a._off
    shape = []
    strides = []
    dim = 0
    for k in key:
        if k is None:
            shape.append(1)
            strides.append(0)
            continue
        n = a._shape[dim]
        st = a._strides[dim]
        if isinstance(k, slice):
            start, stop, step = k.indices(n)
            cnt = len(range(start, stop, step))
            off += start * st
            shape.append(cnt)
            strides.append(st * step)
        else:
            i = _bi.int(k)
            if i < -n or i >= n:
                raise IndexError(f"index {k} is out of bounds for axis {dim} with size {n}")
            if i < 0:
                i += n
            off += i * st
        dim += 1
    return _view_of(a, off, tuple(shape), tuple(strides))


def _getitem(a, key):
    if isinstance(key, (_bi.int, integer)) and not isinstance(key, (_bi.bool, bool_)) and a.ndim >= 1:
        n = a._shape[0]
        i = _bi.int(key)
        if i < -n or i >= n:
            raise IndexError(f"index {key} is out of bounds for axis 0 with size {n}")
        if i < 0:
            i += n
        if a.ndim == 1:
            return _scalar(a._buf[a._off + i * a._strides[0]], a._dtype)
        return _view_of(a, a._off + i * a._strides[0], a._shape[1:], a._strides[1:])
    if isinstance(key, tuple) and len(key) == a.ndim and _bi.all(_is_int_index(k) for k in key):
        off = a._off
        for d, k in enumerate(key):
            n = a._shape[d]
            i = _bi.int(k)
            if i < -n or i >= n:
                raise IndexError(f"index {k} is out of bounds for axis {d} with size {n}")
            if i < 0:
                i += n
            off += i * a._strides[d]
        return _scalar(a._buf[off], a._dtype)
    if isinstance(key, tuple) and len(key) == 0 and a.ndim == 0:
        return _scalar(a._buf[a._off], a._dtype)
    k = _expand_key(a, key)
    if not _bi.any(isinstance(x, ndarray) for x in k):
        v = _basic_index(a, k)
        if v.ndim == 0 and not _bi.any(x is None for x in k) and not (isinstance(key, tuple) and _bi.any(x is Ellipsis for x in key)) and key is not Ellipsis:
            return _scalar(v._buf[v._off], v._dtype)
        return v
    return _advanced(a, k)


def _advanced_plan(a, key):
    """(result shape, list of buffer positions) for an advanced index."""
    # boolean arrays become their nonzero coordinates
    k2 = []
    for x in key:
        if isinstance(x, ndarray) and x.dtype.kind == "b":
            if x.ndim == 0:
                k2.append(x)
                continue
            nz = nonzero(x)
            k2.extend(nz)
        else:
            k2.append(x)
    key = k2
    # first apply the basic parts, keeping advanced axes
    adv_pos = [i for i, x in enumerate(key) if isinstance(x, ndarray)]
    arrs = [key[i] for i in adv_pos]
    for x in arrs:
        if x.dtype.kind not in "iub":
            raise IndexError("arrays used as indices must be of integer (or boolean) type")
    bshape = _broadcast_shapes(*[x.shape for x in arrs])
    idx_vals = [_bvalues(x, bshape) for x in arrs]
    # dims of a for each key element
    dims = []
    d = 0
    for x in key:
        if x is None:
            dims.append(None)
        else:
            dims.append(d)
            d += 1
    contiguous = adv_pos == list(range(adv_pos[0], adv_pos[-1] + 1))
    # build the other (basic) axes
    basic = []  # (kind, info) in key order for non-advanced items
    for i, x in enumerate(key):
        if i in adv_pos:
            continue
        if x is None:
            basic.append((i, "new", None))
        elif isinstance(x, slice):
            n = a._shape[dims[i]]
            basic.append((i, "slice", list(range(*x.indices(n)))))
        else:
            n = a._shape[dims[i]]
            j = _bi.int(x)
            if j < -n or j >= n:
                raise IndexError(f"index {x} is out of bounds for axis {dims[i]} with size {n}")
            basic.append((i, "int", j + n if j < 0 else j))
    # result axes
    before = [b for b in basic if b[0] < adv_pos[0] and b[1] != "int"]
    after = [b for b in basic if b[0] > adv_pos[0] and b[1] != "int"]
    if contiguous:
        axes_order = before + [("adv",)] + after
    else:
        axes_order = [("adv",)] + [b for b in basic if b[1] != "int"]
    out_shape = []
    for ax in axes_order:
        if ax[0] == "adv":
            out_shape.extend(bshape)
        elif ax[1] == "new":
            out_shape.append(1)
        else:
            out_shape.append(len(ax[2]))
    # positions
    nb = _prod(bshape)
    positions = []
    ranges = []
    for ax in axes_order:
        if ax[0] == "adv":
            ranges.append(("adv", range(nb)))
        elif ax[1] == "new":
            ranges.append(("new", [0]))
        else:
            ranges.append((ax[0], ax[2]))
    fixed_off = a._off
    for b in basic:
        if b[1] == "int":
            fixed_off += b[2] * a._strides[dims[b[0]]]
    combos = [fixed_off]
    for kind, rng in ranges:
        if kind == "adv":
            offs = []
            for t in range(nb):
                o = 0
                for p, vals in zip(adv_pos, idx_vals):
                    n = a._shape[dims[p]]
                    j = _bi.int(vals[t])
                    if j < -n or j >= n:
                        raise IndexError(f"index {j} is out of bounds for axis {dims[p]} with size {n}")
                    if j < 0:
                        j += n
                    o += j * a._strides[dims[p]]
                offs.append(o)
            combos = [c + o for c in combos for o in offs]
        elif kind == "new":
            pass
        else:
            st = a._strides[dims[kind]]
            combos = [c + j * st for c in combos for j in rng]
    return tuple(out_shape), combos


def _advanced(a, key):
    if len(key) == 1 and isinstance(key[0], ndarray) and key[0].dtype.kind == "b" and key[0].shape == a.shape:
        # mask indexing: the selected elements in order
        m = key[0]._values()
        idx = a._indices()
        vals = [a._buf[i] for i, keep in zip(idx, m) if keep]
        return _make(vals, (len(vals),), a._dtype)
    shape, positions = _advanced_plan(a, key)
    buf = a._buf
    return _make([buf[p] for p in positions], shape, a._dtype)


def _setitem(a, key, value):
    if not a._writeable:
        raise ValueError("assignment destination is read-only")
    conv = _caster(a._dtype)
    if isinstance(key, (_bi.int, integer)) and not isinstance(key, (_bi.bool, bool_)) and a.ndim == 1 and not isinstance(value, (ndarray, list, tuple)):
        n = a._shape[0]
        i = _bi.int(key)
        if i < -n or i >= n:
            raise IndexError(f"index {key} is out of bounds for axis 0 with size {n}")
        if i < 0:
            i += n
        v = _py(value)
        if a._dtype.kind in "iu" and isinstance(v, _bi.float):
            if v != v:
                raise ValueError("cannot convert float NaN to integer")
            v = _math.trunc(v)
        a._buf[a._off + i * a._strides[0]] = conv(v)
        return
    k = _expand_key(a, key)
    if not _bi.any(isinstance(x, ndarray) for x in k):
        view = _basic_index(a, k)
        _assign(view, value)
        return
    if len(k) == 1 and isinstance(k[0], ndarray) and k[0].dtype.kind == "b" and k[0].shape == a.shape:
        m = k[0]._values()
        idx = [i for i, keep in zip(a._indices(), m) if keep]
        src = asarray(value)
        if src.size == 1:
            vals = [src._values()[0]] * len(idx)
        else:
            if src.size != len(idx):
                raise ValueError(f"NumPy boolean array indexing assignment cannot assign {src.size} input values to the {len(idx)} output values where the mask is true")
            vals = src.ravel()._values()
        if src.dtype.kind == "f" and a._dtype.kind in "iu":
            vals = [_math.trunc(v) for v in vals]
        for i, v in zip(idx, vals):
            a._buf[i] = conv(v)
        return
    shape, positions = _advanced_plan(a, k)
    src = asarray(value)
    vals = _bvalues(src, shape)
    if src.dtype.kind == "f" and a._dtype.kind in "iu":
        vals = [_math.trunc(v) for v in vals]
    for p, v in zip(positions, vals):
        a._buf[p] = conv(v)


def ndindex(*shape):
    if len(shape) == 1 and isinstance(shape[0], tuple):
        shape = shape[0]
    idx = [()]
    for d in shape:
        idx = [i + (k,) for i in idx for k in range(d)]
    return iter(idx)


def ndenumerate(a):
    a = asarray(a)
    for idx, v in zip(ndindex(*a.shape), a._values()):
        yield idx, _scalar(v, a.dtype)


# the printing engine, reductions, and the rest of the library live in
# _numpy_part2 (which sees this module's names); its names join these
import _numpy_part2 as _part2
globals().update({_k: _v for _k, _v in vars(_part2).items() if not _k.startswith("__") and _k not in globals()})
import numpy.linalg as linalg
