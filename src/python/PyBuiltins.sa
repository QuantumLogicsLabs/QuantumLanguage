}

static V m_expm1(V *a, int n, Kw *)
{
    checkArgs("expm1", n, 1, 1);
    double x = num(a[0], "expm1");
    return mathResult(expm1(x), x);
}

static V m_exp2(V *a, int n, Kw *)
{
    checkArgs("exp2", n, 1, 1);
    double x = num(a[0], "exp2");
    return mathResult(exp2(x), x);
}

static V m_log1p(V *a, int n, Kw *)
{
    checkArgs("log1p", n, 1, 1);
    double x = num(a[0], "log1p");
    return mathResult(nanIf(x <= -1, log1p(x)), x);
}

static V m_fabs(V *a, int n, Kw *)
{
    checkArgs("fabs", n, 1, 1);
    double x = num(a[0], "fabs");
    return mathResult(fabs(x), x);
}

static V m_erf(V *a, int n, Kw *)
{
    checkArgs("erf", n, 1, 1);
    double x = num(a[0], "erf");
    return mathResult(erf(x), x);
}

static V m_erfc(V *a, int n, Kw *)
{
    checkArgs("erfc", n, 1, 1);
    double x = num(a[0], "erfc");
    return mathResult(erfc(x), x);
}

static V m_degrees(V *a, int n, Kw *)
{
    checkArgs("degrees", n, 1, 1);
    double x = num(a[0], "degrees");
    return mathResult(x * 180.0 / M_PI, x);
}

static V m_radians(V *a, int n, Kw *)
{
    checkArgs("radians", n, 1, 1);
    double x = num(a[0], "radians");
    return mathResult(x * M_PI / 180.0, x);
}

static V m_cbrt(V *a, int n, Kw *)
{
    checkArgs("cbrt", n, 1, 1);
    double x = num(a[0], "cbrt");
    return mathResult(cbrt(x), x);
}

static V m_gamma(V *a, int n, Kw *)
{
    checkArgs("gamma", n, 1, 1);
    double x = num(a[0], "gamma");
    if (x <= 0 && x == std::floor(x))
        raise(tValueError, "math domain error");
    return mathResult(tgamma(x), x);
}

static V m_lgamma(V *a, int n, Kw *)
{
    checkArgs("lgamma", n, 1, 1);
    double x = num(a[0], "lgamma");
    if (x <= 0 && x == std::floor(x))
        raise(tValueError, "math domain error");
    return mathResult(lgamma(x), x);
}

static V m_sqrt(V *a, int n, Kw *)
{
    checkArgs("sqrt", n, 1, 1);
    double x = num(a[0], "sqrt");
    if (x < 0)
        raise(tValueError, "math domain error");
    return mkfloat(sqrt(x));
}

static double logOf(V v)
{
    if (isIntLike(v) && !IS_SMALL(v) && static_cast<IntObj *>(v)->big)
    {
        // log of a huge int: split off a power of two
        if (intSign(v) <= 0)
            raise(tValueError, "math domain error");
        std::string s = intToString(v, 16);
        double mant = strtod(("0x" + s.substr(0, 13)).c_str(), nullptr);
        return log(mant) + (double)(s.size() - 13) * 4 * log(2.0);
    }
    double x = num(v, "log");
    if (x <= 0)
        raise(tValueError, x == 0 ? "math domain error" : "math domain error");
    return log(x);
}

static V m_log(V *a, int n, Kw *)
{
    checkArgs("log", n, 1, 2);
    double r = logOf(a[0]);
    if (n > 1)
    {
        double b = logOf(a[1]);
        if (b == 0)
            raise(tZeroDivisionError, "float division by zero");
        r /= b;
    }
    return mkfloat(r);
}

static V m_log2(V *a, int n, Kw *)
{
    checkArgs("log2", n, 1, 1);
    if (isIntLike(a[0]) && intSign(a[0]) > 0)
    {
        // exact for powers of two
        int64_t s;
        if (intSmall(a[0], s) && (s & (s - 1)) == 0)
        {
            int k = 0;
            while (s > 1)
                s >>= 1, ++k;
            return mkfloat((double)k);
        }
        return mkfloat(logOf(a[0]) / log(2.0));
    }
    double x = num(a[0], "log2");
    if (x <= 0)
        raise(tValueError, "math domain error");
    return mkfloat(log2(x));
}

static V m_log10(V *a, int n, Kw *)
{
    checkArgs("log10", n, 1, 1);
    if (isIntLike(a[0]) && !IS_SMALL(a[0]))
        return mkfloat(logOf(a[0]) / log(10.0));
    double x = num(a[0], "log10");
    if (x <= 0)
        raise(tValueError, "math domain error");
    return mkfloat(log10(x));
}

static V m_pow(V *a, int n, Kw *)
{
    checkArgs("pow", n, 2, 2);
    double x = num(a[0], "pow"), y = num(a[1], "pow");
    if (x == 0 && y < 0)
        raise(tValueError, "math domain error");
    if (x < 0 && y != std::floor(y))
        raise(tValueError, "math domain error");
    double r = pow(x, y);
    if (std::isinf(r) && std::isfinite(x) && std::isfinite(y))
        raise(tOverflowError, "math range error");
    return mkfloat(r);
}

static V m_atan2(V *a, int n, Kw *)
{
    checkArgs("atan2", n, 2, 2);
    return mkfloat(atan2(num(a[0], "atan2"), num(a[1], "atan2")));
}

static V m_hypot(V *a, int n, Kw *)
{
    double acc = 0;
    if (n == 2)
        return mkfloat(hypot(num(a[0], "hypot"), num(a[1], "hypot")));
    double mx = 0;
    for (int i = 0; i < n; ++i)
        mx = fmax(mx, fabs(num(a[i], "hypot")));
    if (mx == 0)
        return mkfloat(0.0);
    for (int i = 0; i < n; ++i)
    {
        double x = num(a[i], "hypot") / mx;
        acc += x * x;
    }
    return mkfloat(mx * sqrt(acc));
}

static V m_copysign(V *a, int n, Kw *)
{
    checkArgs("copysign", n, 2, 2);
    return mkfloat(copysign(num(a[0], "copysign"), num(a[1], "copysign")));
}

static V m_fmod(V *a, int n, Kw *)
{
    checkArgs("fmod", n, 2, 2);
    double y = num(a[1], "fmod");
    if (y == 0)
        raise(tValueError, "math domain error");
    return mkfloat(fmod(num(a[0], "fmod"), y));
}

static V m_remainder(V *a, int n, Kw *)
{
    checkArgs("remainder", n, 2, 2);
    return mkfloat(remainder(num(a[0], "remainder"), num(a[1], "remainder")));
}

static V m_ldexp(V *a, int n, Kw *)
{
    checkArgs("ldexp", n, 2, 2);
    return mkfloat(ldexp(num(a[0], "ldexp"), (int)indexOf(a[1])));
}

static V m_frexp(V *a, int n, Kw *)
{
    checkArgs("frexp", n, 1, 1);
    int e;
    double m = frexp(num(a[0], "frexp"), &e);
    Tuple *t = newTuple(2);
    t->items[0] = mkfloat(m);
    t->items[1] = mkint(e);
    return t;
}

static V m_modf(V *a, int n, Kw *)
{
    checkArgs("modf", n, 1, 1);
    double ip;
    double fp = modf(num(a[0], "modf"), &ip);
    Tuple *t = newTuple(2);
    t->items[0] = mkfloat(fp);
    t->items[1] = mkfloat(ip);
    return t;
}

static V roundingCall(V x, const char *dunder, double (*f)(double))
{
    if (isIntLike(x))
        return IS_SMALL(x) ? x : fromBig(toBig(x));
    if (!IS_SMALL(x) && x->type->layout == L::Float)
        return intFromDouble(f(static_cast<FloatObj *>(x)->v));
    bool found;
    V r = callSpecial(x, intern(dunder), nullptr, 0, found);
    if (found)
        return r;
    return intFromDouble(f(num(x, dunder)));
}

static V m_floor(V *a, int n, Kw *)
{
    checkArgs("floor", n, 1, 1);
    return roundingCall(a[0], "__floor__", std::floor);
}
static V m_ceil(V *a, int n, Kw *)
{
    checkArgs("ceil", n, 1, 1);
    return roundingCall(a[0], "__ceil__", std::ceil);
}
static V m_trunc(V *a, int n, Kw *)
{
    checkArgs("trunc", n, 1, 1);
    return roundingCall(a[0], "__trunc__", std::trunc);
}

static V m_isnan(V *a, int n, Kw *)
{
    checkArgs("isnan", n, 1, 1);
    return mkbool(std::isnan(num(a[0], "isnan")));
}
static V m_isinf(V *a, int n, Kw *)
{
    checkArgs("isinf", n, 1, 1);
    return mkbool(std::isinf(num(a[0], "isinf")));
}
static V m_isfinite(V *a, int n, Kw *)
{
    checkArgs("isfinite", n, 1, 1);
    return mkbool(std::isfinite(num(a[0], "isfinite")));
}

static V m_isclose(V *a, int n, Kw *kw)
{
    checkArgs("isclose", n, 2, 2);
    double x = num(a[0], "isclose"), y = num(a[1], "isclose");
    V rt = kwArg(kw, "rel_tol"), at = kwArg(kw, "abs_tol");
    double rel = rt ? num(rt, "isclose") : 1e-9, abst = at ? num(at, "isclose") : 0.0;
    if (x == y)
        return True;
    if (std::isinf(x) || std::isinf(y))
        return False;
    double diff = fabs(y - x);
    return mkbool(diff <= fabs(rel * y) || diff <= fabs(rel * x) || diff <= abst);
}

static V intAbs(V v)
{
    return intSign(v) < 0 ? binaryOp(MKSMALL(0), v, OpSub) : v;
}

static V gcd2(V a, V b)
{
    int64_t x, y;
    if (intSmall(a, x) && intSmall(b, y))
    {
        x = x < 0 ? -x : x;
        y = y < 0 ? -y : y;
        while (y)
        {
            int64_t t = x % y;
            x = y;
            y = t;
        }
        return mkint(x);
    }
    a = intAbs(a);
    b = intAbs(b);
    while (intSign(b) != 0)
    {
        V t = binaryOp(a, b, OpMod);
        a = b;
        b = t;
    }
    return a;
}

static V m_gcd(V *a, int n, Kw *)
{
    V r = MKSMALL(0);
    for (int i = 0; i < n; ++i)
    {
        if (!isIntLike(a[i]))
            raise(tTypeError, "'" + std::string(typeName(a[i])) + "' object cannot be interpreted as an integer");
        r = gcd2(r, a[i]);
    }
    return r;
}

static V m_lcm(V *a, int n, Kw *)
{
    V r = MKSMALL(1);
    for (int i = 0; i < n; ++i)
    {
        if (!isIntLike(a[i]))
            raise(tTypeError, "'" + std::string(typeName(a[i])) + "' object cannot be interpreted as an integer");
        if (intSign(a[i]) == 0)
            return MKSMALL(0);
        V g = gcd2(r, a[i]);
        r = intAbs(binaryOp(binaryOp(r, g, OpFloorDiv), a[i], OpMul));
    }
    return r;
}

static V m_factorial(V *a, int n, Kw *)
{
    checkArgs("factorial", n, 1, 1);
    if (!isIntLike(a[0]))
    {
        if (!IS_SMALL(a[0]) && a[0]->type->layout == L::Float)
            raise(tTypeError, "'float' object cannot be interpreted as an integer");
        raise(tTypeError, "'" + std::string(typeName(a[0])) + "' object cannot be interpreted as an integer");
    }
    int64_t k = indexOf(a[0]);
    if (k < 0)
        raise(tValueError, "factorial() not defined for negative values");
    // multiply in a balanced tree to keep the operands similar in size
    std::vector<V> parts;
    for (int64_t i = 2; i <= k; ++i)
        parts.push_back(mkint(i));
    if (parts.empty())
        return MKSMALL(1);
    while (parts.size() > 1)
    {
        std::vector<V> next;
        for (size_t i = 0; i + 1 < parts.size(); i += 2)
            next.push_back(binaryOp(parts[i], parts[i + 1], OpMul));
        if (parts.size() % 2)
            next.push_back(parts.back());
        parts = next;
    }
    return parts[0];
}

static V m_comb(V *a, int n, Kw *)
{
    checkArgs("comb", n, 2, 2);
    int64_t nn = indexOf(a[0]), k = indexOf(a[1]);
    if (nn < 0 || k < 0)
        raise(tValueError, nn < 0 ? "n must be a non-negative integer" : "k must be a non-negative integer");
    if (k > nn)
        return MKSMALL(0);
    if (k > nn - k)
        k = nn - k;
    V r = MKSMALL(1);
    for (int64_t i = 1; i <= k; ++i)
        r = binaryOp(binaryOp(r, mkint(nn - k + i), OpMul), mkint(i), OpFloorDiv);
    return r;
}

static V m_perm(V *a, int n, Kw *)
{
    checkArgs("perm", n, 1, 2);
    int64_t nn = indexOf(a[0]);
    int64_t k = n > 1 && a[1] != None ? indexOf(a[1]) : nn;
    if (nn < 0 || k < 0)
        raise(tValueError, nn < 0 ? "n must be a non-negative integer" : "k must be a non-negative integer");
    if (k > nn)
        return MKSMALL(0);
    V r = MKSMALL(1);
    for (int64_t i = 0; i < k; ++i)
        r = binaryOp(r, mkint(nn - i), OpMul);
    return r;
}

static V m_isqrt(V *a, int n, Kw *)
{
    checkArgs("isqrt", n, 1, 1);
    V x = a[0];
    if (!isIntLike(x))
    {
        bool found;
        x = callSpecial(a[0], intern("__index__"), nullptr, 0, found);
        if (!found)
            raise(tTypeError, "'" + std::string(typeName(a[0])) + "' object cannot be interpreted as an integer");
    }
    if (intSign(x) < 0)
        raise(tValueError, "isqrt() argument must be nonnegative");
    if (intSign(x) == 0)
        return MKSMALL(0);
    int64_t s;
    if (intSmall(x, s) && s < ((int64_t)1 << 52))
    {
        int64_t r = (int64_t)std::sqrt((double)s);
        while (r * r > s)
            --r;
        while ((r + 1) * (r + 1) <= s)
            ++r;
        return mkint(r);
    }
    // Newton's method on big ints
    V r = intFromDouble(std::sqrt(intToDouble(x)));
    for (;;)
    {
        V nr = binaryOp(binaryOp(r, binaryOp(x, r, OpFloorDiv), OpAdd), MKSMALL(2), OpFloorDiv);
        if (intCompare(nr, r) >= 0)
        {
            // r may still be one too large
            while (intCompare(binaryOp(r, r, OpMul), x) > 0)
                r = binaryOp(r, MKSMALL(1), OpSub);
            while (intCompare(binaryOp(binaryOp(r, MKSMALL(1), OpAdd), binaryOp(r, MKSMALL(1), OpAdd), OpMul), x) <= 0)
                r = binaryOp(r, MKSMALL(1), OpAdd);
            return r;
        }
        r = nr;
    }
}

static V m_fsum(V *a, int n, Kw *)
{
    checkArgs("fsum", n, 1, 1);
    // Shewchuk's exact summation (as math.fsum)
    std::vector<double> partials;
    for (V v : toVector(a[0]))
    {
        double x = num(v, "fsum");
        size_t i = 0;
        for (double y : partials)
        {
            if (fabs(x) < fabs(y))
            {
                double t = x;
                x = y;
                y = t;
            }
            double hi = x + y;
            double lo = y - (hi - x);
            if (lo != 0.0)
                partials[i++] = lo;
            x = hi;
        }
        partials.resize(i);
        partials.push_back(x);
    }
    double hi = 0.0;
    if (!partials.empty())
    {
        size_t k = partials.size();
        hi = partials[--k];
        double lo = 0;
        while (k > 0)
        {
            double x = hi;
            double y = partials[--k];
            hi = x + y;
            double yr = hi - x;
            lo = y - yr;
            if (lo != 0.0)
                break;
        }
        if (k > 0 && ((lo < 0.0 && partials[k - 1] < 0.0) || (lo > 0.0 && partials[k - 1] > 0.0)))
        {
            double y = lo * 2.0;
            double x = hi + y;
            double yr = x - hi;
            if (y == yr)
                hi = x;
        }
    }
    return mkfloat(hi);
}

static V m_prod(V *a, int n, Kw *kw)
{
    checkArgs("prod", n, 1, 1);
    V start = kwArg(kw, "start");
    V r = start ? start : MKSMALL(1);
    for (V v : toVector(a[0]))
        r = binaryOp(r, v, OpMul);
    return r;
}

static V m_dist(V *a, int n, Kw *)
{
    checkArgs("dist", n, 2, 2);
    std::vector<V> p = toVector(a[0]), q = toVector(a[1]);
    if (p.size() != q.size())
        raise(tValueError, "both points must have the same number of dimensions");
    std::vector<V> diffs;
    for (size_t i = 0; i < p.size(); ++i)
        diffs.push_back(mkfloat(fabs(num(p[i], "dist") - num(q[i], "dist"))));
    return m_hypot(diffs.data(), (int)diffs.size(), nullptr);
}

static V m_sumprod(V *a, int n, Kw *)
{
    checkArgs("sumprod", n, 2, 2);
    std::vector<V> p = toVector(a[0]), q = toVector(a[1]);
    if (p.size() != q.size())
        raise(tValueError, "Inputs are not the same length");
    bool allInt = true, allNum = true;
    for (size_t i = 0; i < p.size(); ++i)
        for (V v : {p[i], q[i]})
        {
            if (!isIntLike(v) || (!IS_SMALL(v) && v->type == tBool))
                allInt = allInt && isIntLike(v);
            if (!isIntLike(v) && !(typeOf(v) == tFloat))
                allNum = false;
        }
    if (allNum && !allInt)
    {
        // a dot product with twice the working precision (TwoProduct and TwoSum)
        double s = 0, c = 0;
        for (size_t i = 0; i < p.size(); ++i)
        {
            double x = toDouble(p[i]), y = toDouble(q[i]);
            double prod = x * y;
            // the exact error of x*y by Dekker's split (no fma needed)
            const double split = 134217729.0;
            double tx = split * x, xh = tx - (tx - x), xl = x - xh;
            double ty = split * y, yh = ty - (ty - y), yl = y - yh;
            double pe = ((xh * yh - prod) + xh * yl + xl * yh) + xl * yl;
            double t = s + prod;
            double z = t - s;
            double e = (s - (t - z)) + (prod - z);
            s = t;
            c += pe + e;
        }
        return mkfloat(s + c);
    }
    V r = MKSMALL(0);
    for (size_t i = 0; i < p.size(); ++i)
        r = binaryOp(r, binaryOp(p[i], q[i], OpMul), OpAdd);
    return r;
}

static V m_nextafter(V *a, int n, Kw *)
{
    checkArgs("nextafter", n, 2, 2);
    return mkfloat(nextafter(num(a[0], "nextafter"), num(a[1], "nextafter")));
}

static V m_ulp(V *a, int n, Kw *)
{
    checkArgs("ulp", n, 1, 1);
    double x = fabs(num(a[0], "ulp"));
    return mkfloat(nextafter(x, HUGE_VAL) - x);
}

struct NamedFn
{
    const char *name;
    NativeFn fn;
};

static V mathModule()
{
    ModuleObj *m = new ModuleObj(tModule);
    m->name = "math";
    m->dict = newDict();
    Dict *d = m->dict;
    setAttrStr(d, "__name__", newStr("math"));
    setAttrStr(d, "pi", mkfloat(M_PI));
    setAttrStr(d, "e", mkfloat(M_E));
    setAttrStr(d, "tau", mkfloat(2 * M_PI));
    setAttrStr(d, "inf", mkfloat(HUGE_VAL));
    setAttrStr(d, "nan", mkfloat(NAN));
    NamedFn fns[] = {{"sin", m_sin}, {"cos", m_cos}, {"tan", m_tan}, {"asin", m_asin}, {"acos", m_acos}, {"atan", m_atan},
               {"sinh", m_sinh}, {"cosh", m_cosh}, {"tanh", m_tanh}, {"asinh", m_asinh}, {"acosh", m_acosh},
               {"atanh", m_atanh}, {"exp", m_exp}, {"expm1", m_expm1}, {"exp2", m_exp2}, {"log1p", m_log1p},
               {"fabs", m_fabs}, {"erf", m_erf}, {"erfc", m_erfc}, {"degrees", m_degrees}, {"radians", m_radians},
               {"cbrt", m_cbrt}, {"gamma", m_gamma}, {"lgamma", m_lgamma}, {"sqrt", m_sqrt}, {"log", m_log},
               {"log2", m_log2}, {"log10", m_log10}, {"pow", m_pow}, {"atan2", m_atan2}, {"hypot", m_hypot},
               {"copysign", m_copysign}, {"fmod", m_fmod}, {"remainder", m_remainder}, {"ldexp", m_ldexp},
               {"frexp", m_frexp}, {"modf", m_modf}, {"floor", m_floor}, {"ceil", m_ceil}, {"trunc", m_trunc},
               {"isnan", m_isnan}, {"isinf", m_isinf}, {"isfinite", m_isfinite}, {"isclose", m_isclose},
               {"gcd", m_gcd}, {"lcm", m_lcm}, {"factorial", m_factorial}, {"comb", m_comb}, {"perm", m_perm},
               {"isqrt", m_isqrt}, {"fsum", m_fsum}, {"prod", m_prod}, {"dist", m_dist}, {"sumprod", m_sumprod},
               {"nextafter", m_nextafter}, {"ulp", m_ulp}};
    for (auto &f : fns)
        setAttrStr(d, f.name, makeNative(f.name, f.fn));
    return m;
}

// ── imports ────────────────────────────────────────────────────────────────

static std::unordered_map<std::string, V (*)()> *nativeModules;

void registerNativeModule(const std::string &name, V (*init)())
{
    if (!nativeModules)
        nativeModules = new std::unordered_map<std::string, V (*)()>();
    (*nativeModules)[name] = init;
}

std::string librarySource(const std::string &name, bool &found)
{
    // a development override: QUANTUM_PYLIB=<dir> reads the library from disk
    const char *dir = std::getenv("QUANTUM_PYLIB");
    std::string file = name + ".sa";
    if (dir)
    {
        std::string path = std::string(dir) + "/" + file;
        FILE *fp = fopen(path.c_str(), "rb");
        if (fp)
        {
            std::string s;
            char buf[8192];
            size_t k;
            while ((k = fread(buf, 1, sizeof buf, fp)) > 0)
                s.append(buf, k);
            fclose(fp);
            found = true;
            return s;
        }
    }
    for (const auto &lib : librarySources())
        if (lib.first == file)
        {
            found = true;
            return lib.second;
        }
    found = false;
    return "";
}

static void runInModule(ModuleObj *m, const std::string &source, const std::string &filename)
{
    std::vector<Node *> body;
    try
    {
        body = parseModule(source);
    }
    catch (SyntaxErr &e)
    {
        raise(tSyntaxError, filename + ":" + std::to_string(e.line) + ": " + e.message);
    }
    Code *code;
    try
    {
        code = compileModule(body, filename, "<module>");
    }
    catch (SyntaxErr &e)
    {
        raise(tSyntaxError, filename + ":" + std::to_string(e.line) + ": " + e.message);
    }
    execModuleCode(code, m->dict);
}

V importModule(const std::string &name, int line)
{
    (void)line;
    V existing = dictGetStr(modulesDict, intern(name));
    if (existing)
        return existing;
    if (nativeModules)
    {
        auto it = nativeModules->find(name);
        if (it != nativeModules->end())
        {
            V m = it->second();
            dictSet(modulesDict, intern(name), m);
            return m;
        }
    }
    bool found;
    std::string libName = name;
    for (char &c : libName)
        if (c == '.')
            c = '_';
    std::string src = librarySource(libName, found);
    if (!found)
    {
        V e = makeExc(tModuleNotFoundError, "No module named '" + name + "'");
        static_cast<ExcObj *>(e)->dict = newDict();
        setAttrStr(static_cast<ExcObj *>(e)->dict, "name", newStr(name));
        raiseV(e);
    }
    ModuleObj *m = new ModuleObj(tModule);
    m->name = name;
    m->dict = newDict();
    setAttrStr(m->dict, "__name__", newStr(name));
    setAttrStr(m->dict, "__builtins__", builtinsDict);
    setAttrStr(m->dict, "__file__", newStr("<frozen " + name + ">"));
    dictSet(modulesDict, intern(name), m);
    try
    {
        runInModule(m, src, "<frozen " + name + ">");
    }
    catch (...)
    {
        dictDel(modulesDict, intern(name));
        throw;
    }
    // a submodule is an attribute of its package
    size_t dot = name.rfind('.');
    if (dot != std::string::npos)
    {
        V parent = importModule(name.substr(0, dot), line);
        setattr(parent, intern(name.substr(dot + 1)), m);
    }
    return m;
}

// ── setup ──────────────────────────────────────────────────────────────────

static void def(const char *name, NativeFn fn) { setAttrStr(builtinsDict, name, makeNative(name, fn)); }

static bool g_initialised = false;

void initBuiltins()
{
    builtinsDict = newDict();
    modulesDict = newDict();
    def("print", builtinPrint);
    def("len", b_len);
    def("repr", b_repr);
    def("ascii", b_ascii);
    def("format", b_format);
    def("abs", b_abs);
    def("min", b_min);
    def("max", b_max);
    def("sum", b_sum);
    def("sorted", b_sorted);
    def("reversed", b_reversed);
    def("enumerate", b_enumerate);
    def("zip", b_zip);
    def("map", b_map);
    def("filter", b_filter);
    def("any", b_any);
    def("all", b_all);
    def("isinstance", b_isinstance);
    def("issubclass", b_issubclass);
    def("getattr", b_getattr);
    def("setattr", b_setattr);
    def("delattr", b_delattr);
    def("hasattr", b_hasattr);
    def("chr", b_chr);
    def("ord", b_ord);
    def("hex", b_hex);
    def("oct", b_oct);
    def("bin", b_bin);
    def("round", b_round);
    def("divmod", b_divmod);
    def("pow", b_pow);
    def("hash", b_hash);
    def("id", b_id);
    def("callable", b_callable);
    def("iter", b_iter);
    def("next", b_next);
    def("vars", b_vars);
    def("dir", b_dir);
    def("globals", b_globals);
    def("locals", b_locals);
    def("input", b_input);
    def("exit", b_exit);
    def("quit", b_exit);
    def("__import__", b_import);
    def("open", b_open);
    def("eval", b_eval);
    def("exec", b_exec);

    Type *types[] = {tObject, tType, tInt, tBool, tFloat, tComplex, tStr, tBytes, tByteArray, tTuple, tList, tDict,
                     tSet, tFrozenSet, tRange, tSlice, tProperty, tClassMethod, tStaticMethod, tSuper};
    for (Type *t : types)
        setAttrStr(builtinsDict, t->name.c_str(), t);
    dictSet(tInt->dict, intern("__new__"), makeNative("__new__", int_new, false));
    dictSet(tBool->dict, intern("__new__"), makeNative("__new__", bool_new, false));
    defMethod(tBool, "__repr__", bool_repr);
    defMethod(tBool, "__str__", bool_repr);
    dictSet(tFloat->dict, intern("__new__"), makeNative("__new__", float_new, false));
    defClassMethod(tFloat, "fromhex", float_fromhex);
    dictSet(tComplex->dict, intern("__new__"), makeNative("__new__", complex_new, false));
    defProperty(tComplex, "real", complex_real);
    defProperty(tComplex, "imag", complex_imag);
    defMethod(tComplex, "conjugate", complex_conjugate);
    defMethod(tComplex, "__abs__", complex_abs);
    defMethod(tComplex, "__neg__", complex_neg);
    defMethod(tComplex, "__bool__", complex_bool);
    setAttrStr(builtinsDict, "NotImplemented", NotImpl);
    setAttrStr(builtinsDict, "Ellipsis", EllipsisV);
    setAttrStr(builtinsDict, "None", None);
    setAttrStr(builtinsDict, "True", True);
    setAttrStr(builtinsDict, "False", False);
    setAttrStr(builtinsDict, "__debug__", True);
    setAttrStr(builtinsDict, "__name__", newStr("builtins"));
    extern std::vector<Type *> &exceptionTypes();
    for (Type *t : exceptionTypes())
        setAttrStr(builtinsDict, t->name.c_str(), t);
    setAttrStr(builtinsDict, "EnvironmentError", tOSError);
    setAttrStr(builtinsDict, "IOError", tOSError);

    registerNativeModule("builtins", []() -> V {
        ModuleObj *m = new ModuleObj(tModule);
        m->name = "builtins";
        m->dict = builtinsDict;
        return m;
    });
    registerNativeModule("sys", sysModule);
    registerNativeModule("math", mathModule);
    registerNativeModules();
    (void)notimpl_singleton;
}

static void initRuntime()
{
    if (g_initialised)
        return;
    g_initialised = true;
    initObjectModel();
    initCollections();
    initNumbers();
    initStrings();
    initVm();
    initBuiltins();
    // the builtins written in Python
    bool found;
    std::string src = librarySource("_prelude", found);
    if (found)
    {
        ModuleObj *m = new ModuleObj(tModule);
        m->name = "builtins";
        m->dict = builtinsDict;
        runInModule(m, src, "<frozen builtins>");
    }
}

// The message CPython prints for an uncaught exception, and its traceback
static void reportUncaught(V exc, RunFailure &failure, const std::string &path)
{
    std::string kind = typeName(exc);
    std::string msg;
    try
    {
        msg = strOf(exc);
    }
    catch (...)
    {
        msg = "<exception str() failed>";
    }
    ExcObj *e = IS_SMALL(exc) || exc->type->layout != L::Exc ? nullptr : static_cast<ExcObj *>(exc);
    int line = e && !e->tbLines.empty() ? e->tbLines.front() : 0;
    std::string out;
    // the chain: causes and contexts first
    std::vector<ExcObj *> chain;
    std::vector<bool> viaCause;
    for (ExcObj *x = e; x;)
    {
        chain.push_back(x);
        ExcObj *next = nullptr;
        bool cause = false;
        if (x->cause)
        {
            next = static_cast<ExcObj *>(x->cause);
            cause = true;
        }
        else if (x->context && !x->suppressContext)
            next = static_cast<ExcObj *>(x->context);
        viaCause.push_back(cause);
        if (chain.size() > 20)
            break;
        x = next;
    }
    for (size_t i = chain.size(); i-- > 0;)
    {
        ExcObj *x = chain[i];
        out += "Traceback (most recent call last):\n";
        for (size_t k = x->tbLines.size(); k-- > 0;)
            out += "  File \"" + path + "\", line " + std::to_string(x->tbLines[k]) + "\n";
        std::string m;
        try
        {
            m = strOf(x);
        }
        catch (...)
        {
        }
        out += std::string(typeName(x)) + (m.empty() ? "" : ": " + m) + "\n";
        for (const std::string &note : x->notes)
            out += note + "\n";
        if (i > 0)
            out += viaCause[i - 1] ? "\nThe above exception was the direct cause of the following exception:\n\n"
                                   : "\nDuring handling of the above exception, another exception occurred:\n\n";
    }
    if (!e)
        out += kind + ": " + msg + "\n";
    writeErr(out);
    failure.failed = true;
    failure.kind = kind;
    failure.message = msg;
    failure.line = line;
}

int runProgram(const std::string &source, const std::string &path, RunFailure &failure)
{
    g_scriptPath = path;
    try
    {
        initRuntime();
    }
    catch (PyThrow &e)
    {
        flushOut();
        reportUncaught(e.exc, failure, "<frozen builtins>");
        return 1;
    }
    std::vector<Node *> body;
    try
    {
        body = parseModule(source);
    }
    catch (SyntaxErr &e)
    {
        failure.failed = true;
        failure.kind = "SyntaxError";
        failure.message = e.message;
        failure.line = e.line;
        writeErr("  File \"" + path + "\", line " + std::to_string(e.line) + "\nSyntaxError: " + e.message + "\n");
        return 1;
    }
    ModuleObj *main = new ModuleObj(tModule);
    main->name = "__main__";
    main->dict = newDict();
    setAttrStr(main->dict, "__name__", newStr("__main__"));
    setAttrStr(main->dict, "__file__", newStr(path));
    setAttrStr(main->dict, "__builtins__", builtinsDict);
    setAttrStr(main->dict, "__doc__", None);
    dictSet(modulesDict, intern("__main__"), main);
    int status = 0;
    try
    {
        Code *code = compileModule(body, path, "<module>");
        execModuleCode(code, main->dict);
    }
    catch (SyntaxErr &e)
    {
        failure.failed = true;
        failure.kind = "SyntaxError";
        failure.message = e.message;
        failure.line = e.line;
        writeErr("  File \"" + path + "\", line " + std::to_string(e.line) + "\nSyntaxError: " + e.message + "\n");
        status = 1;
    }
    catch (PyThrow &e)
    {
        flushOut();
        if (isinst(e.exc, tSystemExit))
        {
            ExcObj *x = static_cast<ExcObj *>(e.exc);
            V code = x->args->items.empty() ? None : x->args->items[0];
            if (code == None)
                status = 0;
            else if (isIntLike(code))
                status = (int)indexOf(code);
            else
            {
                writeErr(strOf(code) + "\n");
                status = 1;
            }
        }
        else
        {
            reportUncaught(e.exc, failure, path);
            status = 1;
        }
    }
    flushOut();
    return status;
}

bool canRun(const std::string &source, const std::string &path, std::string &why)
{
    (void)path;
    try
    {
        parseModule(source);
        return true;
    }
    catch (SyntaxErr &e)
    {
        why = e.message;
        return false;
    }
}

} // namespace py
