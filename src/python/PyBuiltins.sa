}

static V m_acosh(V *a, int n, Kw *)
{
    checkArgs("acosh", n, 1, 1);
    double x = num(a[0], "acosh");
    return mathResult(nanIf(x < 1, acosh(x)), x);
}

static V m_atanh(V *a, int n, Kw *)
{
    checkArgs("atanh", n, 1, 1);
