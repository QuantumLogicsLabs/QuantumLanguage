// quantum: cpp
// Python front-end: the builtins module, the native modules (sys, math),
// imports, and the entry points the rest of the compiler calls.
#include "PyMain.h.sa"
#include "PyRt.h.sa"
#include "PyAst.h.sa"
#include "PyParse.h.sa"

#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <cstring>

namespace py
{

const std::vector<std::pair<std::string, std::string>> &librarySources();

// ── output ─────────────────────────────────────────────────────────────────

static std::string *outBuf;

void writeOut(const std::string &s)
{
    if (!outBuf)
        outBuf = new std::string();
    outBuf->append(s);
    if (outBuf->size() > (1 << 16))
        flushOut();
}

void flushOut()
{
    if (outBuf && !outBuf->empty())
    {
        fwrite(outBuf->data(), 1, outBuf->size(), stdout);
        outBuf->clear();
    }
    fflush(stdout);
}

static void writeErr(const std::string &s)
{
    flushOut();
    fwrite(s.data(), 1, s.size(), stderr);
    fflush(stderr);
}

static V sysStdout, sysStderr;

// print(*objects, sep=' ', end='\n', file=None, flush=False)
V builtinPrint(V *args, int n, Kw *kw)
{
    V sepV = kwArg(kw, "sep"), endV = kwArg(kw, "end"), fileV = kwArg(kw, "file");
    std::string sep = (!sepV || sepV == None) ? " " : strOf(sepV);
    std::string end = (!endV || endV == None) ? "\n" : strOf(endV);
    std::string out;
    for (int i = 0; i < n; ++i)
    {
        if (i)
            out += sep;
        out += strOf(args[i]);
    }
    out += end;
    if (fileV && fileV != None && fileV != sysStdout)
    {
        if (fileV == sysStderr)
        {
            writeErr(out);
            return None;
        }
        V w = getattr(fileV, intern("write"));
        call1(w, newStr(out));
        return None;
    }
    writeOut(out);
    V fl = kwArg(kw, "flush");
    if (fl && truthy(fl))
        flushOut();
    return None;
}

// ── builtin functions ──────────────────────────────────────────────────────

static V b_len(V *a, int n, Kw *kw)
{
    noKw("len", kw);
    checkArgs("len", n, 1, 1);
    return mkint(lenOf(a[0]));
}

static V b_repr(V *a, int n, Kw *)
{
    checkArgs("repr", n, 1, 1);
    return newStr(reprOf(a[0]));
}

extern std::string asciiOf(V v);

static V b_ascii(V *a, int n, Kw *)
{
    checkArgs("ascii", n, 1, 1);
    return newStr(asciiOf(a[0]));
}

static V b_format(V *a, int n, Kw *)
{
    checkArgs("format", n, 1, 2);
    return newStr(formatValue(a[0], n > 1 ? strOf(a[1]) : ""));
}

static V b_abs(V *a, int n, Kw *)
{
    checkArgs("abs", n, 1, 1);
    V x = a[0];
    if (IS_SMALL(x))
    {
        int64_t v = SMALLV(x);
        return mkint(v < 0 ? -v : v);
    }
    if (x->type == tFloat)
        return mkfloat(fabs(static_cast<FloatObj *>(x)->v));
    if (x->type == tComplex)
    {
        ComplexObj *c = static_cast<ComplexObj *>(x);
        return mkfloat(hypot(c->re, c->im));
    }
    bool found;
    V r = callSpecial(x, intern("__abs__"), nullptr, 0, found);
    if (found)
        return r;
    raise(tTypeError, "bad operand type for abs(): '" + std::string(typeName(x)) + "'");
}

static V minmax(V *a, int n, Kw *kw, bool isMax)
{
    const char *name = isMax ? "max" : "min";
    V key = kwArg(kw, "key");
    V def = kwArg(kw, "default");
    if (key == None)
        key = nullptr;
    std::vector<V> items;
    if (n == 0)
        raise(tTypeError, std::string(name) + " expected at least 1 argument, got 0");
    if (n == 1)
        items = toVector(a[0]);
    else
    {
        if (def)
            raise(tTypeError, std::string("Cannot specify a default for ") + name + "() with multiple positional arguments");
        items.assign(a, a + n);
    }
    if (items.empty())
    {
        if (def)
            return def;
        raise(tValueError, std::string(name) + "() iterable argument is empty");
    }
    V best = items[0];
    V bestKey = key ? call1(key, best) : best;
    for (size_t i = 1; i < items.size(); ++i)
    {
        V k = key ? call1(key, items[i]) : items[i];
        bool better = isMax ? lt(bestKey, k) : lt(k, bestKey);
        if (better)
        {
            best = items[i];
            bestKey = k;
        }
    }
    return best;
}

static V b_min(V *a, int n, Kw *kw) { return minmax(a, n, kw, false); }
static V b_max(V *a, int n, Kw *kw) { return minmax(a, n, kw, true); }

// sum(): ints exactly, floats with CPython's compensated summation
static V b_sum(V *a, int n, Kw *kw)
{
    checkArgs("sum", n, 1, 2);
    V start = n > 1 ? a[1] : kwArg(kw, "start");
    if (!start)
        start = MKSMALL(0);
    if (isStr(start))
        raise(tTypeError, "sum() can't sum strings [use ''.join(seq) instead]");
    V it = getiter(a[0]);
    V result = start;
    V x;
    // integer fast path
    if (IS_SMALL(result))
    {
        int64_t acc = SMALLV(result);
        bool more = false;
        while (iterNext(it, x))
        {
            if (IS_SMALL(x))
            {
                int64_t y = SMALLV(x);
                int64_t s = acc + y;
                if (FITS_SMALL(s))
                {
                    acc = s;
                    continue;
                }
            }
            result = mkint(acc);
            more = true;
            break;
        }
        if (!more)
            return mkint(acc);
        // x is the first item the fast path could not take
        if (!IS_SMALL(x) && x->type == tFloat)
        {
            double f = (double)SMALLV(result) + 0.0;
            if (!IS_SMALL(result))
                f = toDouble(result);
            double c = 0.0;
            double v = static_cast<FloatObj *>(x)->v;
            for (;;)
            {
                double t = f + v;
                if (fabs(f) >= fabs(v))
                    c += (f - t) + v;
                else
                    c += (v - t) + f;
                f = t;
                if (!iterNext(it, x))
                {
                    if (c != 0 && std::isfinite(c))
                        f += c;
                    return mkfloat(f);
                }
                if (!IS_SMALL(x) && x->type == tFloat)
                    v = static_cast<FloatObj *>(x)->v;
                else if (IS_SMALL(x) && SMALLV(x) > -((int64_t)1 << 53) && SMALLV(x) < ((int64_t)1 << 53))
                    v = (double)SMALLV(x);
                else
                {
                    if (c != 0 && std::isfinite(c))
                        f += c;
                    result = mkfloat(f);
                    break;
                }
            }
        }
        result = binaryOp(result, x, OpAdd);
    }
    else if (!IS_SMALL(result) && result->type == tFloat)
    {
        double f = static_cast<FloatObj *>(result)->v, c = 0.0;
        bool generic = false;
        while (iterNext(it, x))
        {
            double v;
            if (!IS_SMALL(x) && x->type == tFloat)
                v = static_cast<FloatObj *>(x)->v;
            else if (IS_SMALL(x) && SMALLV(x) > -((int64_t)1 << 53) && SMALLV(x) < ((int64_t)1 << 53))
                v = (double)SMALLV(x);
            else
            {
                generic = true;
                break;
            }
            double t = f + v;
            if (fabs(f) >= fabs(v))
                c += (f - t) + v;
            else
                c += (v - t) + f;
            f = t;
        }
        if (c != 0 && std::isfinite(c))
            f += c;
        result = mkfloat(f);
        if (!generic)
            return result;
        result = binaryOp(result, x, OpAdd);
    }
    while (iterNext(it, x))
        result = binaryOp(result, x, OpAdd);
    return result;
}

static V b_sorted(V *a, int n, Kw *kw)
{
    checkArgs("sorted", n, 1, 1);
    List *l = newList();
    l->items = toVector(a[0]);
    if (l->items.data() == (IS_SMALL(a[0]) ? nullptr : (typeOf(a[0])->layout == L::List ? static_cast<List *>(a[0])->items.data() : nullptr)))
        l->items = std::vector<V>(l->items);
    V key = kwArg(kw, "key");
    V rev = kwArg(kw, "reverse");
    listSort(l, key, rev && truthy(rev));
    return l;
}

static V b_reversed(V *a, int n, Kw *)
{
    checkArgs("reversed", n, 1, 1);
    V seq = a[0];
    bool found;
    V r = callSpecial(seq, intern("__reversed__"), nullptr, 0, found);
    if (found)
        return r;
    if (!lookupMro(typeOf(seq), intern("__getitem__")) || !lookupMro(typeOf(seq), intern("__len__")))
        raise(tTypeError, "'" + std::string(typeName(seq)) + "' object is not reversible");
    int64_t *i = new int64_t(lenOf(seq));
    return makeIter([seq, i](V &out) -> bool {
        if (*i <= 0)
            return false;
        out = getitem(seq, mkint(--*i));
        return true;
    });
}

static V b_enumerate(V *a, int n, Kw *kw)
{
    V it = getiter(n > 0 ? a[0] : kwArg(kw, "iterable"));
    V startV = n > 1 ? a[1] : kwArg(kw, "start");
    V *idx = new V(startV ? startV : MKSMALL(0));
    return makeIter([it, idx](V &out) -> bool {
        V x;
        if (!iterNext(it, x))
            return false;
        Tuple *t = newTuple(2);
        t->items[0] = *idx;
        t->items[1] = x;
        *idx = IS_SMALL(*idx) ? mkint(SMALLV(*idx) + 1) : binaryOp(*idx, MKSMALL(1), OpAdd);
        out = t;
        return true;
    });
}

static V b_zip(V *a, int n, Kw *kw)
{
    std::vector<V> *its = new std::vector<V>();
    for (int i = 0; i < n; ++i)
        its->push_back(getiter(a[i]));
    V strictV = kwArg(kw, "strict");
    bool strict = strictV && truthy(strictV);
    return makeIter([its, strict](V &out) -> bool {
        if (its->empty())
            return false;
        Tuple *t = newTuple(its->size());
        for (size_t i = 0; i < its->size(); ++i)
        {
            V x;
            if (!iterNext((*its)[i], x))
            {
                if (strict)
                {
                    if (i > 0)
                        raise(tValueError, "zip() argument " + std::to_string(i + 1) + " is shorter than argument" + (i == 1 ? " 1" : "s 1-" + std::to_string(i)));
                    for (size_t j = 1; j < its->size(); ++j)
                    {
                        V y;
                        if (iterNext((*its)[j], y))
                            raise(tValueError, "zip() argument " + std::to_string(j + 1) + " is longer than argument" + (j == 1 ? " 1" : "s 1-" + std::to_string(j)));
                    }
                }
                return false;
            }
            t->items[i] = x;
        }
        out = t;
        return true;
    });
}

static V b_map(V *a, int n, Kw *)
{
    if (n < 2)
        raise(tTypeError, "map() must have at least two arguments.");
    V fn = a[0];
    std::vector<V> *its = new std::vector<V>();
    for (int i = 1; i < n; ++i)
        its->push_back(getiter(a[i]));
    return makeIter([fn, its](V &out) -> bool {
        std::vector<V> args(its->size());
        for (size_t i = 0; i < its->size(); ++i)
            if (!iterNext((*its)[i], args[i]))
                return false;
        out = call(fn, args.data(), (int)args.size());
        return true;
    });
}

static V b_filter(V *a, int n, Kw *)
{
    checkArgs("filter", n, 2, 2);
    V fn = a[0];
    V it = getiter(a[1]);
    return makeIter([fn, it](V &out) -> bool {
        V x;
        while (iterNext(it, x))
        {
            bool keep = fn == None ? truthy(x) : truthy(call1(fn, x));
            if (keep)
            {
                out = x;
                return true;
            }
        }
        return false;
    });
}

static V b_any(V *a, int n, Kw *)
{
    checkArgs("any", n, 1, 1);
    V it = getiter(a[0]);
    V x;
    while (iterNext(it, x))
        if (truthy(x))
            return True;
    return False;
}

static V b_all(V *a, int n, Kw *)
{
    checkArgs("all", n, 1, 1);
    V it = getiter(a[0]);
    V x;
    while (iterNext(it, x))
        if (!truthy(x))
            return False;
    return True;
}

static bool instanceCheck(V obj, V cls)
{
    if (!IS_SMALL(cls) && cls->type->layout == L::Tuple)
    {
        for (V c : static_cast<Tuple *>(cls)->items)
            if (instanceCheck(obj, c))
                return true;
        return false;
    }
    if (typeOf(cls)->layout == L::Type && issub(typeOf(cls), tType))
    {
        Type *meta = typeOf(cls);
        if (meta != tType)
        {
            V ic = lookupMro(meta, intern("__instancecheck__"));
            if (ic && !(IS_SMALL(ic) || ic->type->layout == L::Native))
                return truthy(call2(ic, cls, obj));
        }
        if ((cls == tInt || cls == tFloat) && !typeOf(obj)->builtin)
        {
            // NumPy's int64 and the like are not Python ints (they only are here underneath)
            V optOut = lookupMro(typeOf(obj), intern(cls == tInt ? "_not_python_int" : "_not_python_float"));
            if (optOut && truthy(optOut))
                return false;
        }
        return isinst(obj, static_cast<Type *>(cls));
    }
    V ic;
    if (getattrOpt(cls, intern("__instancecheck__"), ic))
        return truthy(call1(ic, obj));
    raise(tTypeError, "isinstance() arg 2 must be a type, a tuple of types, or a union");
}

static bool subclassCheck(V sub, V cls)
{
    if (!IS_SMALL(cls) && cls->type->layout == L::Tuple)
    {
        for (V c : static_cast<Tuple *>(cls)->items)
            if (subclassCheck(sub, c))
                return true;
        return false;
    }
    if (typeOf(cls)->layout == L::Type && issub(typeOf(cls), tType))
    {
        Type *meta = typeOf(cls);
        if (meta != tType)
        {
            V sc = lookupMro(meta, intern("__subclasscheck__"));
            if (sc && !(IS_SMALL(sc) || sc->type->layout == L::Native))
                return truthy(call2(sc, cls, sub));
        }
        if (typeOf(sub)->layout != L::Type)
            raise(tTypeError, "issubclass() arg 1 must be a class");
        if ((cls == tInt || cls == tFloat) && !static_cast<Type *>(sub)->builtin)
        {
            V optOut = lookupMro(static_cast<Type *>(sub), intern(cls == tInt ? "_not_python_int" : "_not_python_float"));
            if (optOut && truthy(optOut))
                return false;
        }
        return issub(static_cast<Type *>(sub), static_cast<Type *>(cls));
    }
    V sc;
    if (getattrOpt(cls, intern("__subclasscheck__"), sc))
        return truthy(call1(sc, sub));
    raise(tTypeError, "issubclass() arg 2 must be a class, a tuple of classes, or a union");
}

static V b_isinstance(V *a, int n, Kw *)
{
    checkArgs("isinstance", n, 2, 2);
    return mkbool(instanceCheck(a[0], a[1]));
}

static V b_issubclass(V *a, int n, Kw *)
{
    checkArgs("issubclass", n, 2, 2);
    return mkbool(subclassCheck(a[0], a[1]));
}

static Str *attrName(V v)
{
    if (!isStr(v))
        raise(tTypeError, "attribute name must be string, not '" + std::string(typeName(v)) + "'");
    return intern(asStr(v)->s);
}

static V b_getattr(V *a, int n, Kw *)
{
    checkArgs("getattr", n, 2, 3);
    if (n == 3)
    {
        V out;
        try
        {
            if (getattrOpt(a[0], attrName(a[1]), out))
                return out;
        }
        catch (PyThrow &e)
        {
            if (!isinst(e.exc, tAttributeError))
                throw;
        }
        return a[2];
    }
    return getattr(a[0], attrName(a[1]));
}

static V b_setattr(V *a, int n, Kw *)
{
    checkArgs("setattr", n, 3, 3);
    setattr(a[0], attrName(a[1]), a[2]);
    return None;
}

static V b_delattr(V *a, int n, Kw *)
{
    checkArgs("delattr", n, 2, 2);
    delattr(a[0], attrName(a[1]));
    return None;
}

static V b_hasattr(V *a, int n, Kw *)
{
    checkArgs("hasattr", n, 2, 2);
    return mkbool(hasattr(a[0], attrName(a[1])));
}

static V b_chr(V *a, int n, Kw *)
{
    checkArgs("chr", n, 1, 1);
    int64_t c = indexOf(a[0]);
    if (c < 0 || c > 0x10FFFF)
        raise(tValueError, "chr() arg not in range(0x110000)");
    return newStr(encodeUtf8((uint32_t)c));
}

static V b_ord(V *a, int n, Kw *)
{
    checkArgs("ord", n, 1, 1);
    if (isStr(a[0]))
    {
        Str *s = asStr(a[0]);
        if (s->len != 1)
            raise(tTypeError, "ord() expected a character, but string of length " + std::to_string(s->len) + " found");
        return mkint(strCharAt(s, 0));
    }
    if (typeOf(a[0])->layout == L::Bytes)
    {
        BytesObj *b = static_cast<BytesObj *>(a[0]);
        if (b->s.size() != 1)
            raise(tTypeError, "ord() expected a character, but string of length " + std::to_string(b->s.size()) + " found");
        return mkint((unsigned char)b->s[0]);
    }
    raise(tTypeError, "ord() expected string of length 1, but " + std::string(typeName(a[0])) + " found");
}

static V radixStr(V v, int base, const char *prefix)
{
    V x = v;
    if (!isIntLike(x))
    {
        bool found;
        x = callSpecial(v, intern("__index__"), nullptr, 0, found);
        if (!found)
            raise(tTypeError, "'" + std::string(typeName(v)) + "' object cannot be interpreted as an integer");
    }
    bool neg = intSign(x) < 0;
    V mag = neg ? binaryOp(MKSMALL(0), x, OpSub) : x;
    return newStr(std::string(neg ? "-" : "") + prefix + intToString(mag, base));
}

static V b_hex(V *a, int n, Kw *)
{
    checkArgs("hex", n, 1, 1);
    return radixStr(a[0], 16, "0x");
}
static V b_oct(V *a, int n, Kw *)
{
    checkArgs("oct", n, 1, 1);
    return radixStr(a[0], 8, "0o");
}
static V b_bin(V *a, int n, Kw *)
{
    checkArgs("bin", n, 1, 1);
    return radixStr(a[0], 2, "0b");
}

extern V numRound(V x, V nd);

static V b_round(V *a, int n, Kw *kw)
{
    checkArgs("round", n, 1, 2);
    V nd = n > 1 ? a[1] : kwArg(kw, "ndigits");
    V x = a[0];
    Type *t = typeOf(x);
    if (t->builtin && (t->layout == L::Int || t->layout == L::Float))
        return numRound(x, nd);
    bool found;
    V r = (nd && nd != None) ? callSpecial(x, intern("__round__"), &nd, 1, found) : callSpecial(x, intern("__round__"), nullptr, 0, found);
    if (found)
        return r;
    raise(tTypeError, "type " + t->name + " doesn't define __round__ method");
}

static V b_divmod(V *a, int n, Kw *)
{
    checkArgs("divmod", n, 2, 2);
    if (isIntLike(a[0]) && isIntLike(a[1]))
    {
        Tuple *t = newTuple(2);
        t->items[0] = binaryOp(a[0], a[1], OpFloorDiv);
        t->items[1] = binaryOp(a[0], a[1], OpMod);
        return t;
    }
    bool found;
    V r = callSpecial(a[0], intern("__divmod__"), &a[1], 1, found);
    if (found && r != NotImpl)
        return r;
    if (!typeOf(a[1])->builtin)
    {
        r = callSpecial(a[1], intern("__rdivmod__"), &a[0], 1, found);
        if (found && r != NotImpl)
            return r;
    }
    Tuple *t = newTuple(2);
    t->items[0] = binaryOp(a[0], a[1], OpFloorDiv);
    t->items[1] = binaryOp(a[0], a[1], OpMod);
    return t;
}

static V b_pow(V *a, int n, Kw *kw)
{
    checkArgs("pow", n, 2, 3);
    V mod = n > 2 ? a[2] : kwArg(kw, "mod");
    if (mod && mod != None)
    {
        if (!isIntLike(a[0]) || !isIntLike(a[1]) || !isIntLike(mod))
        {
            bool found;
            V args[2] = {a[1], mod};
            V r = callSpecial(a[0], intern("__pow__"), args, 2, found);
            if (found)
                return r;
            raise(tTypeError, "pow() 3rd argument not allowed unless all arguments are integers");
        }
        return intPow(a[0], a[1], mod);
    }
    return binaryOp(a[0], a[1], OpPow);
}

static V b_hash(V *a, int n, Kw *)
{
    checkArgs("hash", n, 1, 1);
    return mkint(hashOf(a[0]));
}

static V b_id(V *a, int n, Kw *)
{
    checkArgs("id", n, 1, 1);
    return mkint(objectId(a[0]));
}

static V b_callable(V *a, int n, Kw *)
{
    checkArgs("callable", n, 1, 1);
    V x = a[0];
    if (IS_SMALL(x))
        return False;
    switch (x->type->layout)
    {
    case L::Func:
    case L::Native:
    case L::Method:
        return True;
    case L::Type:
        if (issub(x->type, tType))
            return True;
        break;
    default:
        break;
    }
    return mkbool(lookupMro(x->type, intern("__call__")) != nullptr);
}

static V b_iter(V *a, int n, Kw *)
{
    checkArgs("iter", n, 1, 2);
    if (n == 2)
    {
        V fn = a[0], sentinel = a[1];
        bool *done = new bool(false);
        return makeIter([fn, sentinel, done](V &out) -> bool {
            if (*done)
                return false;
            V x = call0(fn);
            if (eq(x, sentinel))
            {
                *done = true;
                return false;
            }
            out = x;
            return true;
        });
    }
    return getiter(a[0]);
}

static V b_next(V *a, int n, Kw *)
{
    checkArgs("next", n, 1, 2);
    V it = a[0];
    Type *t = typeOf(it);
    if (t->layout != L::Iter && t->layout != L::Gen && !lookupMro(t, intern("__next__")))
        raise(tTypeError, "'" + t->name + "' object is not an iterator");
    if (t->layout == L::Gen)
    {
        // a generator's return value travels in StopIteration
        bool done;
        V r = genSend(static_cast<GenObj *>(it), None, done);
        if (!done)
            return r;
        if (n > 1)
            return a[1];
        extern V makeStopIteration(V value);
        raiseV(makeStopIteration(r));
    }
    if (t->layout == L::Iter)
    {
        V x;
        if (iterNext(it, x))
            return x;
        if (n > 1)
            return a[1];
        if (t->layout == L::Gen)
        {
            // a generator's return value travels in StopIteration
            raiseV(makeExc(tStopIteration, ""));
        }
        V e = call0(tStopIteration);
        raiseV(e);
    }
    try
    {
        bool found;
        return callSpecial(it, intern("__next__"), nullptr, 0, found);
    }
    catch (PyThrow &e)
    {
        if (n > 1 && isinst(e.exc, tStopIteration))
            return a[1];
        throw;
    }
}

static V b_vars(V *a, int n, Kw *)
{
    checkArgs("vars", n, 0, 1);
    if (n == 0)
    {
        Frame *f = currentFrame();
        return f && f->locals ? (V)f->locals : (V)newDict();
    }
    V d;
    if (!getattrOpt(a[0], intern("__dict__"), d))
        raise(tTypeError, "vars() argument must have __dict__ attribute");
    return d;
}

static V b_dir(V *a, int n, Kw *)
{
    checkArgs("dir", n, 0, 1);
    if (n == 0)
    {
        Frame *f = currentFrame();
        List *l = newList();
        Dict *d = f ? (f->locals ? f->locals : f->globals) : nullptr;
        if (d)
            for (const DEntry &e : d->entries)
                if (e.key)
                    l->items.push_back(e.key);
        listSort(l, nullptr, false);
        return l;
    }
    List *l = newList();
    if (typeOf(a[0])->layout == L::Type && issub(typeOf(a[0]), tType) && typeOf(a[0]) == tType)
    {
        // a class: its own names and its bases'
        Set *names = newSet();
        for (Type *m : static_cast<Type *>(a[0])->mro)
            for (const DEntry &e : m->dict->entries)
                if (e.key)
                    setAdd(names, e.key);
        l->items = setItems(names);
        listSort(l, nullptr, false);
        return l;
    }
    if (typeOf(a[0])->layout == L::Module)
    {
        for (const DEntry &e : a[0]->dict->entries)
            if (e.key)
                l->items.push_back(e.key);
        listSort(l, nullptr, false);
        return l;
    }
    bool found;
    V r = callSpecial(a[0], intern("__dir__"), nullptr, 0, found);
    l->items = toVector(r);
    listSort(l, nullptr, false);
    return l;
}

static V b_globals(V *, int, Kw *)
{
    Frame *f = currentFrame();
    return f ? (V)f->globals : (V)newDict();
}

static V b_locals(V *, int, Kw *)
{
    Frame *f = currentFrame();
    if (!f)
        return newDict();
    if (f->locals)
        return f->locals;
    Dict *d = newDict();
    for (size_t i = 0; i < f->code->varnames.size() && i < f->fast.size(); ++i)
        if (f->fast[i] && f->code->varnames[i]->s[0] != '$' && f->code->varnames[i]->s[0] != '.')
            dictSet(d, f->code->varnames[i], f->fast[i]);
    for (size_t i = 0; i < f->code->cellvars.size(); ++i)
        if (f->cells[i]->v)
            dictSet(d, f->code->cellvars[i], f->cells[i]->v);
    return d;
}

bool testModeActive();
std::string testModeAnswer(const std::string &prompt);

static V b_input(V *a, int n, Kw *)
{
    if (testModeActive())
        return newStr(testModeAnswer(n > 0 ? strOf(a[0]) : ""));
    if (n > 0)
        writeOut(strOf(a[0]));
    flushOut();
    std::string line;
    int ch;
    bool any = false;
    while ((ch = fgetc(stdin)) != EOF)
    {
        any = true;
        if (ch == '\n')
            break;
        line += (char)ch;
    }
    if (!any)
        raise(tEOFError, "EOF when reading a line");
    if (!line.empty() && line.back() == '\r')
        line.pop_back();
    return newStr(line);
}

static V b_exit(V *a, int n, Kw *)
{
    V e = n > 0 ? call1(tSystemExit, a[0]) : call0(tSystemExit);
    raiseV(e);
}

static V b_import(V *a, int n, Kw *)
{
    checkArgs("__import__", n, 1, 5);
    return importModule(strOf(a[0]), currentLine());
}

V openFile(V *a, int n, Kw *kw);

static V b_open(V *a, int n, Kw *kw)
{
    checkArgs("open", n, 1, 8);
    return openFile(a, n, kw);
}

static V compileAndRun(const std::string &src, V globals, V locals, bool isEval)
{
    Dict *g = globals && globals != None ? static_cast<Dict *>(globals) : currentFrame()->globals;
    std::string text = isEval ? "__eval_result__ = (" + src + "\n)" : src;
    std::vector<Node *> body;
    try
    {
        body = parseModule(text);
    }
    catch (SyntaxErr &e)
    {
        raise(tSyntaxError, e.message);
    }
    Code *code = compileModule(body, "<string>", "<module>");
    Dict *ns = locals && locals != None ? static_cast<Dict *>(locals) : g;
    if (!dictGetC(g, "__builtins__"))
        setAttrStr(g, "__builtins__", builtinsDict);
    Frame *f = currentFrame();
    if (!locals && !globals && f && !f->locals)
    {
        // eval inside a function sees its locals through a snapshot
        Dict *snap = dictCopy(g);
        for (size_t i = 0; i < f->code->varnames.size() && i < f->fast.size(); ++i)
            if (f->fast[i])
                dictSet(snap, f->code->varnames[i], f->fast[i]);
        ns = snap;
        g = snap;
    }
    Frame fr;
    fr.code = code;
    fr.globals = g;
    fr.locals = ns;
    fr.fast.assign((size_t)code->nlocals, nullptr);
    runFrame(&fr);
    if (isEval)
    {
        V r = dictGetC(ns, "__eval_result__");
        dictDel(ns, intern("__eval_result__"));
        return r ? r : None;
    }
    return None;
}

static V b_eval(V *a, int n, Kw *)
{
    checkArgs("eval", n, 1, 3);
    return compileAndRun(strOf(a[0]), n > 1 ? a[1] : nullptr, n > 2 ? a[2] : nullptr, true);
}

static V b_exec(V *a, int n, Kw *)
{
    checkArgs("exec", n, 1, 3);
    return compileAndRun(strOf(a[0]), n > 1 ? a[1] : nullptr, n > 2 ? a[2] : nullptr, false);
}

// ── constructors of the numeric types ──────────────────────────────────────

static V int_new(V *a, int n, Kw *kw)
{
    Type *t = static_cast<Type *>(a[0]);
    V x = n > 1 ? a[1] : kwArg(kw, "x");
    V baseV = n > 2 ? a[2] : kwArg(kw, "base");
    V val;
    if (!x)
        val = MKSMALL(0);
    else if (baseV)
    {
        int64_t base = indexOf(baseV);
        std::string s;
        if (isStr(x))
            s = asStr(x)->s;
        else if (typeOf(x)->layout == L::Bytes)
            s = static_cast<BytesObj *>(x)->s;
        else
            raise(tTypeError, "int() can't convert non-string with explicit base");
        if (base != 0 && (base < 2 || base > 36))
            raise(tValueError, "int() base must be >= 2 and <= 36, or 0");
        bool ok;
        val = intFromString(s, (int)base, ok);
        if (!ok)
            raise(tValueError, "invalid literal for int() with base " + std::to_string(base) + ": " + quoteStr(s));
    }
    else if (isIntLike(x))
        val = IS_SMALL(x) ? x : fromBig(toBig(x));
    else if (isStr(x))
    {
        bool ok;
        val = intFromString(asStr(x)->s, 10, ok);
        if (!ok)
        {
            // non-ASCII digits are rare; report like CPython
            raise(tValueError, "invalid literal for int() with base 10: " + quoteStr(asStr(x)->s));
        }
    }
    else if (typeOf(x)->layout == L::Float)
        val = intFromDouble(static_cast<FloatObj *>(x)->v);
    else if (typeOf(x)->layout == L::Bytes)
    {
        bool ok;
        val = intFromString(static_cast<BytesObj *>(x)->s, 10, ok);
        if (!ok)
            raise(tValueError, "invalid literal for int() with base 10: " + reprOf(x));
    }
    else
    {
        bool found;
        val = callSpecial(x, intern("__int__"), nullptr, 0, found);
        if (!found)
            val = callSpecial(x, intern("__index__"), nullptr, 0, found);
        if (!found)
            val = callSpecial(x, intern("__trunc__"), nullptr, 0, found);
        if (!found)
            raise(tTypeError, "int() argument must be a string, a bytes-like object or a real number, not '" + std::string(typeName(x)) + "'");
        if (!isIntLike(val))
            raise(tTypeError, "__int__ returned non-int (type " + std::string(typeName(val)) + ")");
    }
    if (t == tInt)
        return val;
    if (t == tBool)
        return mkbool(truthy(val));
    IntObj *o = static_cast<IntObj *>(newObject(t));
    int64_t s;
    if (intSmall(val, s))
        o->small = s;
    else
        o->big = new Big(toBig(val));
    return o;
}

static V bool_new(V *a, int n, Kw *)
{
    checkArgs("bool", n - 1, 0, 1);
    return mkbool(n > 1 && truthy(a[1]));
}

static V bool_repr(V *a, int, Kw *) { return newStr(static_cast<IntObj *>(a[0])->small ? "True" : "False"); }

static V parseFloat(const std::string &text, bool &ok)
{
    ok = false;
    std::string s;
    size_t b = 0, e = text.size();
    while (b < e && isspace((unsigned char)text[b]))
        ++b;
    while (e > b && isspace((unsigned char)text[e - 1]))
        --e;
    for (size_t i = b; i < e; ++i)
    {
        if (text[i] == '_')
        {
            if (i == b || i + 1 >= e || !isdigit((unsigned char)text[i - 1]) || !isdigit((unsigned char)text[i + 1]))
                return nullptr;
            continue;
        }
        s += (char)tolower((unsigned char)text[i]);
    }
    if (s.empty())
        return nullptr;
    std::string body = s;
    double sign = 1;
    if (body[0] == '+' || body[0] == '-')
    {
        if (body[0] == '-')
            sign = -1;
        body = body.substr(1);
    }
    if (body == "inf" || body == "infinity")
    {
        ok = true;
        return mkfloat(sign * HUGE_VAL);
    }
    if (body == "nan")
    {
        ok = true;
        return mkfloat(NAN);
    }
    // digits [. digits] [e [+-] digits]
    size_t i = 0;
    bool digits = false;
    while (i < body.size() && isdigit((unsigned char)body[i]))
        ++i, digits = true;
    if (i < body.size() && body[i] == '.')
    {
        ++i;
        while (i < body.size() && isdigit((unsigned char)body[i]))
            ++i, digits = true;
    }
    if (!digits)
        return nullptr;
    if (i < body.size() && body[i] == 'e')
    {
        ++i;
        if (i < body.size() && (body[i] == '+' || body[i] == '-'))
            ++i;
        bool ed = false;
        while (i < body.size() && isdigit((unsigned char)body[i]))
            ++i, ed = true;
        if (!ed)
            return nullptr;
    }
    if (i != body.size())
        return nullptr;
    ok = true;
    return mkfloat(sign * strtod(body.c_str(), nullptr));
}

static V float_new(V *a, int n, Kw *)
{
    checkArgs("float", n - 1, 0, 1);
    Type *t = static_cast<Type *>(a[0]);
    double d = 0;
    if (n > 1)
    {
        V x = a[1];
        if (isStr(x) || typeOf(x)->layout == L::Bytes)
        {
            std::string s = isStr(x) ? asStr(x)->s : static_cast<BytesObj *>(x)->s;
            bool ok;
            V f = parseFloat(s, ok);
            if (!ok)
                raise(tValueError, "could not convert string to float: " + quoteStr(s));
            d = static_cast<FloatObj *>(f)->v;
        }
        else if (isIntLike(x))
            d = intToDouble(x);
        else if (typeOf(x)->layout == L::Float)
            d = static_cast<FloatObj *>(x)->v;
        else
        {
            bool found;
            V r = callSpecial(x, intern("__float__"), nullptr, 0, found);
            if (!found)
                r = callSpecial(x, intern("__index__"), nullptr, 0, found);
            if (!found)
                raise(tTypeError, "float() argument must be a string or a real number, not '" + std::string(typeName(x)) + "'");
            d = toDouble(r);
        }
    }
    if (t == tFloat)
        return mkfloat(d);
    FloatObj *o = static_cast<FloatObj *>(newObject(t));
    o->v = d;
    return o;
}

static V float_fromhex(V *a, int n, Kw *)
{
    checkArgs("fromhex", n - 1, 1, 1);
    return mkfloat(strtod(strOf(a[1]).c_str(), nullptr));
}

static V complex_new(V *a, int n, Kw *kw)
{
    V re = n > 1 ? a[1] : kwArg(kw, "real");
    V im = n > 2 ? a[2] : kwArg(kw, "imag");
    double r = 0, i = 0;
    if (re)
    {
        if (!IS_SMALL(re) && re->type->layout == L::Complex)
        {
            r = static_cast<ComplexObj *>(re)->re;
            i = static_cast<ComplexObj *>(re)->im;
        }
        else if (isStr(re))
        {
            std::string s = asStr(re)->s;
            std::string t;
            for (char c : s)
                if (!isspace((unsigned char)c) && c != '(' && c != ')')
                    t += c;
            if (!t.empty() && (t.back() == 'j' || t.back() == 'J'))
            {
                t.pop_back();
                size_t split = std::string::npos;
                for (size_t k = t.size(); k-- > 1;)
                    if ((t[k] == '+' || t[k] == '-') && t[k - 1] != 'e' && t[k - 1] != 'E')
                    {
                        split = k;
                        break;
                    }
                if (split == std::string::npos)
                    i = t.empty() || t == "+" ? 1 : t == "-" ? -1 : strtod(t.c_str(), nullptr);
                else
                {
                    r = strtod(t.substr(0, split).c_str(), nullptr);
                    std::string ip = t.substr(split);
                    i = ip == "+" ? 1 : ip == "-" ? -1 : strtod(ip.c_str(), nullptr);
                }
            }
            else
                r = strtod(t.c_str(), nullptr);
        }
        else
            r = toDouble(re);
    }
    if (im)
    {
        if (!IS_SMALL(im) && im->type->layout == L::Complex)
        {
            r -= static_cast<ComplexObj *>(im)->im;
            i += static_cast<ComplexObj *>(im)->re;
        }
        else
            i += toDouble(im);
    }
    return new ComplexObj(static_cast<Type *>(a[0]), r, i);
}

static V complex_real(V *a, int, Kw *) { return mkfloat(static_cast<ComplexObj *>(a[0])->re); }
static V complex_imag(V *a, int, Kw *) { return mkfloat(static_cast<ComplexObj *>(a[0])->im); }
static V complex_conjugate(V *a, int, Kw *)
{
    ComplexObj *c = static_cast<ComplexObj *>(a[0]);
    return new ComplexObj(tComplex, c->re, -c->im);
}
static V complex_abs(V *a, int, Kw *)
{
    ComplexObj *c = static_cast<ComplexObj *>(a[0]);
    return mkfloat(hypot(c->re, c->im));
}
static V complex_neg(V *a, int, Kw *)
{
    ComplexObj *c = static_cast<ComplexObj *>(a[0]);
    return new ComplexObj(tComplex, -c->re, -c->im);
}
static V complex_bool(V *a, int, Kw *)
{
    ComplexObj *c = static_cast<ComplexObj *>(a[0]);
    return mkbool(c->re != 0 || c->im != 0);
}


static V notimpl_singleton(V *, int, Kw *) { return NotImpl; }

// ── sys ────────────────────────────────────────────────────────────────────

static V stream_write(V *a, int n, Kw *)
{
    checkArgs("write", n, 2, 2);
    std::string s = strOf(a[1]);
    if (a[0] == sysStderr)
        writeErr(s);
    else
        writeOut(s);
    return mkint((int64_t)asStr(a[1])->len);
}

static V stream_flush(V *, int, Kw *)
{
    flushOut();
    return None;
}

static V sys_exit(V *a, int n, Kw *) { return b_exit(a, n, nullptr); }
static int g_recursionLimit = 1000;
static V sys_getrecursionlimit(V *, int, Kw *) { return mkint(g_recursionLimit); }
static V sys_setrecursionlimit(V *a, int n, Kw *)
{
    checkArgs("setrecursionlimit", n, 1, 1);
    g_recursionLimit = (int)indexOf(a[0]);
    return None;
}
static V sys_getsizeof(V *a, int, Kw *)
{
    // rough sizes in the spirit of CPython's
    V x = a[0];
    switch (typeOf(x)->layout)
    {
    case L::List: return mkint(56 + 8 * (int64_t)static_cast<List *>(x)->items.size());
    case L::Tuple: return mkint(40 + 8 * (int64_t)static_cast<Tuple *>(x)->items.size());
    case L::Str: return mkint(49 + static_cast<Str *>(x)->len);
    case L::Dict: return mkint(184);
    case L::Set: return mkint(216);
    case L::Float: return mkint(24);
    default: return mkint(28);
    }
}
static V sys_intern(V *a, int n, Kw *)
{
    checkArgs("intern", n, 1, 1);
    return intern(strOf(a[0]));
}

static V sysModule()
{
    ModuleObj *m = new ModuleObj(tModule);
    m->name = "sys";
    m->dict = newDict();
    Dict *d = m->dict;
    setAttrStr(d, "__name__", newStr("sys"));
    Type *streamType = newType("TextIOWrapper", tObject, L::Object);
    defMethod(streamType, "write", stream_write);
    defMethod(streamType, "flush", stream_flush);
    sysStdout = new Obj(streamType);
    sysStderr = new Obj(streamType);
    setAttrStr(d, "stdout", sysStdout);
    setAttrStr(d, "stderr", sysStderr);
    setAttrStr(d, "__stdout__", sysStdout);
    setAttrStr(d, "__stderr__", sysStderr);
    setAttrStr(d, "stdin", None);
    List *argv = newList();
    argv->items.push_back(newStr(g_scriptPath));
    setAttrStr(d, "argv", argv);
    setAttrStr(d, "maxsize", mkint(INT64_MAX));
    setAttrStr(d, "byteorder", newStr("little"));
    setAttrStr(d, "platform", newStr("win32"));
    setAttrStr(d, "version", newStr("3.13.0 (Quantum)"));
    Tuple *vi = newTuple(5);
    vi->items[0] = MKSMALL(3);
    vi->items[1] = MKSMALL(13);
    vi->items[2] = MKSMALL(0);
    vi->items[3] = newStr("final");
    vi->items[4] = MKSMALL(0);
    setAttrStr(d, "version_info", vi);
    setAttrStr(d, "modules", modulesDict);
    setAttrStr(d, "path", newList());
    setAttrStr(d, "maxunicode", mkint(0x10FFFF));
    setAttrStr(d, "exit", makeNative("exit", sys_exit));
    setAttrStr(d, "getrecursionlimit", makeNative("getrecursionlimit", sys_getrecursionlimit));
    setAttrStr(d, "setrecursionlimit", makeNative("setrecursionlimit", sys_setrecursionlimit));
    setAttrStr(d, "getsizeof", makeNative("getsizeof", sys_getsizeof));
    setAttrStr(d, "intern", makeNative("intern", sys_intern));
    Dict *fi = newDict();
    (void)fi;
    return m;
}

// ── math ───────────────────────────────────────────────────────────────────

static double num(V v, const char *fn)
{
    if (IS_SMALL(v))
        return (double)SMALLV(v);
    L l = v->type->layout;
    if (l == L::Float)
        return static_cast<FloatObj *>(v)->v;
    if (l == L::Int)
        return intToDouble(v);
    bool found;
    V r = callSpecial(v, intern("__float__"), nullptr, 0, found);
    if (found)
        return toDouble(r);
    r = callSpecial(v, intern("__index__"), nullptr, 0, found);
    if (found)
        return toDouble(r);
    (void)fn;
    raise(tTypeError, "must be real number, not " + std::string(typeName(v)));
}

static V mathResult(double r, double x)
{
    if (std::isnan(r) && !std::isnan(x))
        raise(tValueError, "math domain error");
    if (std::isinf(r) && std::isfinite(x))
        raise(tOverflowError, "math range error");
    return mkfloat(r);
}

static double nanIf(bool bad, double v) { return bad ? NAN : v; }

static V m_sin(V *a, int n, Kw *)
{
    checkArgs("sin", n, 1, 1);
    double x = num(a[0], "sin");
    return mathResult(sin(x), x);
}

