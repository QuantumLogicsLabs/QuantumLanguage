// quantum: cpp
#pragma once
// Python front-end: what the rest of the compiler sees of it.
#include <string>

namespace py
{

// An uncaught exception, for the caller to report
struct RunFailure
{
    bool failed = false;
    std::string kind, message;
    int line = 0;
};

// Runs a Python program to its end; the result is the exit status
int runProgram(const std::string &source, const std::string &path, RunFailure &failure);

// What python prints when it cannot parse the source (qrun reports it as a
// compile error: a .py file is Python and nothing else), or "" when the
// source parses
std::string syntaxReport(const std::string &source, const std::string &path);

} // namespace py
