static V method_func_get(V *a, int, Kw *) { return static_cast<MethodObj *>(a[0])->func; }
static V method_self_get(V *a, int, Kw *) { return static_cast<MethodObj *>(a[0])->self; }
static V method_name_get(V *a, int, Kw *) { return getattr(static_cast<MethodObj *>(a[0])->func, s___name__); }
static V method_qualname_get(V *a, int, Kw *) { return getattr(static_cast<MethodObj *>(a[0])->func, s___qualname__); }
static V method_doc_get(V *a, int, Kw *) { return getattr(static_cast<MethodObj *>(a[0])->func, s___doc__); }
static V method_getattr(V *a, int n, Kw *)
{
    checkArgs("__getattr__", n, 2, 2);
    return getattr(static_cast<MethodObj *>(a[0])->func, intern(strOf(a[1])));
}

static V native_name_get(V *a, int, Kw *) { return newStr(static_cast<NativeObj *>(a[0])->name); }
static V native_self_get(V *a, int, Kw *)
{
    V s = static_cast<NativeObj *>(a[0])->self;
    return s ? s : None;
}
static V native_doc_get(V *, int, Kw *) { return None; }
static V native_module_get(V *, int, Kw *) { return newStr("builtins"); }
static V native_get(V *a, int n, Kw *)
{
    if (n < 2 || a[1] == None)
        return a[0];
    return bindDescriptor(a[0], a[1], typeOf(a[1]));
}

static V wrap_new(V *a, int n, Kw *)
{
    checkArgs("classmethod", n, 2, 2);
    Type *t = static_cast<Type *>(a[0]);
    WrapObj *w = static_cast<WrapObj *>(newObject(t));
    w->func = a[1];
    return w;
}
static V wrap_func_get(V *a, int, Kw *) { return static_cast<WrapObj *>(a[0])->func; }
static V wrap_isabstract_get(V *a, int, Kw *)
{
    V f = static_cast<WrapObj *>(a[0])->func;
    V flag;
    if (getattrOpt(f, s___isabstractmethod__, flag))
        return flag;
    return False;
}
static V wrap_get(V *a, int n, Kw *)
{
    WrapObj *w = static_cast<WrapObj *>(a[0]);
    V obj = n > 1 ? a[1] : None;
    V owner = n > 2 && a[2] != None ? a[2] : (V)typeOf(obj);
    if (issub(typeOf(a[0]), tStaticMethod))
        return w->func;
    MethodObj *m = new MethodObj(tMethod);
    m->func = w->func;
    m->self = owner;
    return m;
}
static V wrap_call(V *a, int n, Kw *kw) { return call(static_cast<WrapObj *>(a[0])->func, a + 1, n - 1, kw); }
static V wrap_getattr(V *a, int n, Kw *)
{
    checkArgs("__getattr__", n, 2, 2);
    return getattr(static_cast<WrapObj *>(a[0])->func, intern(strOf(a[1])));
}

static V property_new(V *a, int n, Kw *kw)
{
    Type *t = static_cast<Type *>(a[0]);
    PropertyObj *p = static_cast<PropertyObj *>(newObject(t));
    V args[4] = {nullptr, nullptr, nullptr, nullptr};
    for (int i = 1; i < n && i <= 4; ++i)
        args[i - 1] = a[i];
    if (V x = kwArg(kw, "fget"))
        args[0] = x;
    if (V x = kwArg(kw, "fset"))
        args[1] = x;
    if (V x = kwArg(kw, "fdel"))
        args[2] = x;
    if (V x = kwArg(kw, "doc"))
        args[3] = x;
    p->fget = args[0] == None ? nullptr : args[0];
    p->fset = args[1] == None ? nullptr : args[1];
    p->fdel = args[2] == None ? nullptr : args[2];
    p->doc = args[3];
    if (!p->doc && p->fget)
    {
        V d;
        if (getattrOpt(p->fget, s___doc__, d))
            p->doc = d;
    }
    return p;
}
static V property_init(V *, int, Kw *) { return None; }
static PropertyObj *propCopy(V self)
{
    PropertyObj *old = static_cast<PropertyObj *>(self);
    PropertyObj *p = static_cast<PropertyObj *>(newObject(typeOf(self)));
    p->fget = old->fget;
    p->fset = old->fset;
    p->fdel = old->fdel;
    p->doc = old->doc;
    return p;
}
static V property_getter(V *a, int, Kw *)
{
    PropertyObj *p = propCopy(a[0]);
    p->fget = a[1];
    return p;
}
static V property_setter(V *a, int, Kw *)
{
    PropertyObj *p = propCopy(a[0]);
    p->fset = a[1];
    return p;
}
static V property_deleter(V *a, int, Kw *)
{
    PropertyObj *p = propCopy(a[0]);
    p->fdel = a[1];
    return p;
}
static V property_get(V *a, int n, Kw *)
{
    PropertyObj *p = static_cast<PropertyObj *>(a[0]);
    if (n < 2 || a[1] == None)
        return a[0];
    if (!p->fget)
        raise(tAttributeError, "unreadable attribute");
    return call1(p->fget, a[1]);
}
static V property_set(V *a, int n, Kw *)
{
    checkArgs("__set__", n, 3, 3);
    PropertyObj *p = static_cast<PropertyObj *>(a[0]);
    if (!p->fset)
        raise(tAttributeError, "can't set attribute");
    call2(p->fset, a[1], a[2]);
    return None;
}
static V property_fget(V *a, int, Kw *)
{
    V f = static_cast<PropertyObj *>(a[0])->fget;
    return f ? f : None;
}
static V property_fset(V *a, int, Kw *)
{
    V f = static_cast<PropertyObj *>(a[0])->fset;
    return f ? f : None;
}
static V property_fdel(V *a, int, Kw *)
{
    V f = static_cast<PropertyObj *>(a[0])->fdel;
    return f ? f : None;
}
static V property_doc(V *a, int, Kw *)
{
    V d = static_cast<PropertyObj *>(a[0])->doc;
    return d ? d : None;
}
static V property_isabstract(V *a, int, Kw *)
{
    PropertyObj *p = static_cast<PropertyObj *>(a[0]);
    V flag;
    for (V f : {p->fget, p->fset, p->fdel})
        if (f && getattrOpt(f, s___isabstractmethod__, flag) && truthy(flag))
            return True;
    return False;
}
static V property_name(V *a, int, Kw *)
{
    PropertyObj *p = static_cast<PropertyObj *>(a[0]);
    if (p->fget)
        return getattr(p->fget, s___name__);
    return None;
}

// super(), super(T, obj)
static V super_new(V *a, int n, Kw *)
{
    SuperObj *s = new SuperObj(tSuper);
    if (n == 1)
    {
        Frame *f = currentFrame();
        if (!f || f->code->argcount == 0 || f->fast.empty())
            raise(tRuntimeError, "super(): no arguments");
        // __class__ is a free variable of the method
        CellObj *cell = nullptr;
        Code *c = f->code;
        for (size_t i = 0; i < c->freevars.size(); ++i)
            if (c->freevars[i]->s == "__class__")
                cell = f->cells[c->cellvars.size() + i];
        if (!cell || !cell->v)
            raise(tRuntimeError, "super(): __class__ cell not found");
        s->start = static_cast<Type *>(cell->v);
        V self = f->fast[0];
        if (!self)
        {
            // the first argument may live in a cell
            for (size_t i = 0; i < c->cellvars.size(); ++i)
                if (!c->cell2arg.empty() && c->cell2arg[i] == 0)
                    self = f->cells[i]->v;
        }
        s->self = self;
        return s;
    }
    checkArgs("super", n - 1, 1, 2);
    if (typeOf(a[1])->layout != L::Type)
        raise(tTypeError, "super() argument 1 must be a type");
    s->start = static_cast<Type *>(a[1]);
    s->self = n > 2 ? a[2] : None;
    return s;
}

static V super_getattribute(V *a, int n, Kw *)
{
    checkArgs("__getattribute__", n, 2, 2);
    SuperObj *s = static_cast<SuperObj *>(a[0]);
    Str *name = intern(strOf(a[1]));
    if (name->s == "__class__")
        return tSuper;
    Type *startType = s->self == None ? s->start
                      : (typeOf(s->self)->layout == L::Type && issub(static_cast<Type *>(s->self), s->start))
                          ? static_cast<Type *>(s->self)
                          : typeOf(s->self);
    V attr = lookupMroAfter(startType, s->start, name);
    if (!attr)
        raise(tAttributeError, "'super' object has no attribute '" + name->s + "'");
    bool selfIsType = s->self != None && typeOf(s->self)->layout == L::Type && issub(static_cast<Type *>(s->self), s->start);
    if (selfIsType)
    {
        // super() inside a classmethod / __new__ / __init_subclass__
        if (!IS_SMALL(attr) && attr->type->layout == L::ClassMethod)
        {
            MethodObj *m = new MethodObj(tMethod);
            m->func = static_cast<WrapObj *>(attr)->func;
            m->self = s->self;
            return m;
        }
        if (!IS_SMALL(attr) && attr->type->layout == L::StaticMethod)
            return static_cast<WrapObj *>(attr)->func;
        if (!IS_SMALL(attr) && attr->type->layout == L::Native && static_cast<NativeObj *>(attr)->classMethod)
            return bindDescriptor(attr, nullptr, static_cast<Type *>(s->self));
        if (!IS_SMALL(attr) && attr->type->layout == L::Func && name->s == "__init_subclass__")
        {
            MethodObj *m = new MethodObj(tMethod);
            m->func = attr;
            m->self = s->self;
            return m;
        }
        return attr;
    }
    if (s->self == None)
        return attr;
    return bindDescriptor(attr, s->self, typeOf(s->self));
}

static V super_thisclass(V *a, int, Kw *) { return static_cast<SuperObj *>(a[0])->start; }
static V super_self(V *a, int, Kw *) { return static_cast<SuperObj *>(a[0])->self; }

static V notimpl_bool(V *, int, Kw *) { return True; }

static V module_repr(V *a, int, Kw *) { return newStr(builtinRepr(a[0])); }
static V module_name_get(V *a, int, Kw *)
{
    V n = dictGetStr(a[0]->dict, s___name__);
    return n ? n : newStr(static_cast<ModuleObj *>(a[0])->name);
}

static V singleton_repr(V *a, int, Kw *) { return newStr(builtinRepr(a[0])); }

// The native dunders of the builtin layouts, so `int.__add__`, super()
// calls from subclasses and the like reach them
static void defBinaryDunders(Type *t)
{
    for (int op = OpAdd; op <= OpBitAnd; ++op)
    {
        Op o = (Op)op;
        setAttrStr(t->dict, binNames[op]->s.c_str(), makeNativeClosure(binNames[op]->s.c_str(), [o](V *a, int n, Kw *) -> V {
            checkArgs("binary op", n, 2, 2);
            return builtinBinary(a[0], a[1], o);
        }));
        setAttrStr(t->dict, rbinNames[op]->s.c_str(), makeNativeClosure(rbinNames[op]->s.c_str(), [o](V *a, int n, Kw *) -> V {
            checkArgs("binary op", n, 2, 2);
            return builtinBinary(a[1], a[0], o);
        }));
        static_cast<NativeObj *>(dictGetStr(t->dict, binNames[op]))->method = true;
        static_cast<NativeObj *>(dictGetStr(t->dict, rbinNames[op]))->method = true;
    }
}

static void defCompareDunders(Type *t)
{
    Op ops[] = {OpEq, OpNe, OpLt, OpLe, OpGt, OpGe};
    for (Op o : ops)
    {
        NativeObj *nf = static_cast<NativeObj *>(makeNativeClosure(cmpName(o)->s.c_str(), [o](V *a, int n, Kw *) -> V {
            checkArgs("comparison", n, 2, 2);
            return builtinCompare(a[0], a[1], o);
        }));
        nf->method = true;
        dictSet(t->dict, cmpName(o), nf);
    }
}

static void defCommonDunders(Type *t)
{
    NativeObj *r = static_cast<NativeObj *>(makeNativeClosure("__repr__", [](V *a, int, Kw *) -> V { return newStr(builtinRepr(a[0])); }));
    r->method = true;
    dictSet(t->dict, s___repr__, r);
    NativeObj *h = static_cast<NativeObj *>(makeNativeClosure("__hash__", [](V *a, int, Kw *) -> V { return mkint(builtinHash(a[0])); }));
    h->method = true;
    dictSet(t->dict, s___hash__, h);
}

static V num_bool(V *a, int, Kw *)
{
    V x = a[0];
    if (IS_SMALL(x))
        return mkbool(SMALLV(x) != 0);
    if (x->type->layout == L::Int)
        return mkbool(intSign(x) != 0);
    if (x->type->layout == L::Float)
        return mkbool(static_cast<FloatObj *>(x)->v != 0);
    return mkbool(truthy(x));
}
static V num_neg(V *a, int, Kw *)
{
    if (typeOf(a[0])->layout == L::Int)
        return intBinary(MKSMALL(0), a[0], OpSub);
    if (typeOf(a[0])->layout == L::Float)
        return mkfloat(-static_cast<FloatObj *>(a[0])->v);
    return unaryOp(a[0], OpNeg);
}
static V num_pos(V *a, int, Kw *)
{
    if (typeOf(a[0])->layout == L::Int)
        return fromBig(toBig(a[0]));
    return mkfloat(toDouble(a[0]));
}
static V num_abs(V *a, int, Kw *)
{
    if (typeOf(a[0])->layout == L::Int)
        return intSign(a[0]) < 0 ? intBinary(MKSMALL(0), a[0], OpSub) : fromBig(toBig(a[0]));
    return mkfloat(fabs(toDouble(a[0])));
}
static V int_invert(V *a, int, Kw *) { return intBinary(MKSMALL(-1), a[0], OpBitXor); }
static V int_index(V *a, int, Kw *) { return fromBig(toBig(a[0])); }
static V int_float(V *a, int, Kw *) { return mkfloat(intToDouble(a[0])); }
static V num_int(V *a, int, Kw *)
{
    if (typeOf(a[0])->layout == L::Int)
        return fromBig(toBig(a[0]));
    return intFromDouble(toDouble(a[0]));
}
static V num_format(V *a, int n, Kw *)
{
    checkArgs("__format__", n, 2, 2);
    std::string spec = strOf(a[1]);
    if (typeOf(a[0])->layout == L::Int)
        return newStr(formatIntSpec(fromBig(toBig(a[0])), spec));
    return newStr(formatFloatSpec(toDouble(a[0]), spec, false));
}
static V num_str(V *a, int, Kw *) { return newStr(builtinRepr(a[0])); }
static V float_float(V *a, int, Kw *) { return mkfloat(toDouble(a[0])); }
static V num_round(V *a, int n, Kw *kw);
static V num_trunc(V *a, int, Kw *)
{
    if (typeOf(a[0])->layout == L::Int)
        return fromBig(toBig(a[0]));
    return intFromDouble(toDouble(a[0]));
}
static V num_floor(V *a, int, Kw *)
{
    if (typeOf(a[0])->layout == L::Int)
        return fromBig(toBig(a[0]));
    return intFromDouble(std::floor(toDouble(a[0])));
}
static V num_ceil(V *a, int, Kw *)
{
    if (typeOf(a[0])->layout == L::Int)
        return fromBig(toBig(a[0]));
    return intFromDouble(std::ceil(toDouble(a[0])));
}
static V num_getnewargs(V *a, int, Kw *)
{
    Tuple *t = newTuple(1);
    t->items[0] = typeOf(a[0])->layout == L::Int ? fromBig(toBig(a[0])) : mkfloat(toDouble(a[0]));
    return t;
}

// round(x[, ndigits]) for ints and floats
V numRound(V x, V nd)
{
    if (typeOf(x)->layout == L::Int || IS_SMALL(x))
    {
        if (!nd || nd == None)
            return fromBig(toBig(x));
        int64_t d = indexOf(nd);
        if (d >= 0)
            return fromBig(toBig(x));
        // round to a multiple of 10**-d, half to even
        V p = intPow(MKSMALL(10), mkint(-d), nullptr);
        V q = intBinary(x, p, OpFloorDiv);
        V r = intBinary(x, p, OpMod);
        V twice = intBinary(r, MKSMALL(2), OpMul);
        int c = intCompare(twice, p);
        if (c > 0 || (c == 0 && intSign(intBinary(q, MKSMALL(2), OpMod)) != 0))
            q = intBinary(q, MKSMALL(1), OpAdd);
        return intBinary(q, p, OpMul);
    }
    double d = toDouble(x);
    if (!nd || nd == None)
    {
        double r = std::nearbyint(d); // banker's rounding in the default mode
        if (std::fabs(d - std::trunc(d)) == 0.5)
            r = 2.0 * std::round(d / 2.0);
        else
            r = std::round(d);
        return intFromDouble(r);
    }
    int64_t nd2 = indexOf(nd);
    if (!std::isfinite(d))
        return mkfloat(d);
    if (nd2 > 22)
        return mkfloat(d);
    if (nd2 < -22)
        return mkfloat(0.0 * d);
    // correctly rounded through the decimal string, as CPython does
    char buf[512];
    if (nd2 >= 0)
    {
        snprintf(buf, sizeof buf, "%.*f", (int)nd2, d);
        return mkfloat(strtod(buf, nullptr));
    }
    double p = pow(10.0, (double)-nd2);
    double y = d / p;
    double z = std::round(y);
    if (std::fabs(y - std::trunc(y)) == 0.5)
        z = 2.0 * std::round(y / 2.0);
    return mkfloat(z * p);
}

static V num_round(V *a, int n, Kw *kw)
{
    V nd = n > 1 ? a[1] : kwArg(kw, "ndigits");
    return numRound(a[0], nd);
}

static void defNumberDunders(Type *t, bool isInt)
{
    defBinaryDunders(t);
    defCompareDunders(t);
    defCommonDunders(t);
    defMethod(t, "__bool__", num_bool);
    defMethod(t, "__neg__", num_neg);
    defMethod(t, "__pos__", num_pos);
    defMethod(t, "__abs__", num_abs);
    defMethod(t, "__int__", num_int);
    defMethod(t, "__format__", num_format);
    defMethod(t, "__str__", num_str);
    defMethod(t, "__round__", num_round);
    defMethod(t, "__trunc__", num_trunc);
    defMethod(t, "__floor__", num_floor);
    defMethod(t, "__ceil__", num_ceil);
    defMethod(t, "__getnewargs__", num_getnewargs);
    if (isInt)
    {
        defMethod(t, "__invert__", int_invert);
        defMethod(t, "__index__", int_index);
        defMethod(t, "__float__", int_float);
    }
    else
        defMethod(t, "__float__", float_float);
}

static void addType(Type *t)
{
    if (!allTypes)
        allTypes = new std::vector<Type *>();
    allTypes->push_back(t);
}

V nativeTypeNew(Type *t)
{
    (void)t;
    return nullptr;
}

static Type *excType(const char *name, Type *base)
{
    Type *t = newType(name, base, L::Exc);
    t->hasDict = true;
    addType(t);
    return t;
}

static void initExceptionTypes();

void initObjectModel()
{
    // bootstrap: type and object before anything can be allocated through them
    tType = new Type(nullptr);
    tType->type = tType;
    tObject = new Type(tType);
    tStr = new Type(tType);
    tDict = new Type(tType);
    tType->dict = new Dict(tDict);
    tObject->dict = new Dict(tDict);
    tStr->dict = new Dict(tDict);
    tDict->dict = new Dict(tDict);
    auto setup = [](Type *t, const char *name, Type *base, L layout) {
        t->name = name;
        t->qualname = name;
        t->module = "builtins";
        t->layout = layout;
        t->builtin = true;
        t->hasDict = false;
        if (base)
        {
            t->bases.push_back(base);
            t->base = base;
        }
        t->mro.clear();
        t->mro.push_back(t);
        if (base)
            for (Type *m : base->mro)
                t->mro.push_back(m);
    };
    setup(tObject, "object", nullptr, L::Object);
    setup(tType, "type", tObject, L::Type);
    setup(tStr, "str", tObject, L::Str);
    setup(tDict, "dict", tObject, L::Dict);
    tType->dict->type = tDict;
    tObject->dict->type = tDict;
    tStr->dict->type = tDict;
    tDict->dict->type = tDict;

    tInt = newType("int", tObject, L::Int);
    tBool = newType("bool", tInt, L::Int);
    tFloat = newType("float", tObject, L::Float);
    tComplex = newType("complex", tObject, L::Complex);
    tBytes = newType("bytes", tObject, L::Bytes);
    tByteArray = newType("bytearray", tObject, L::Bytes);
    tTuple = newType("tuple", tObject, L::Tuple);
    tList = newType("list", tObject, L::List);
    tSet = newType("set", tObject, L::Set);
    tFrozenSet = newType("frozenset", tObject, L::Set);
    tRange = newType("range", tObject, L::Range);
    tSlice = newType("slice", tObject, L::Slice);
    tFunc = newType("function", tObject, L::Func);
    tNative = newType("builtin_function_or_method", tObject, L::Native);
    tMethod = newType("method", tObject, L::Method);
    tClassMethod = newType("classmethod", tObject, L::ClassMethod);
    tStaticMethod = newType("staticmethod", tObject, L::StaticMethod);
    tProperty = newType("property", tObject, L::Property);
    tCell = newType("cell", tObject, L::Cell);
    tCode = newType("code", tObject, L::Code);
    tGen = newType("generator", tObject, L::Gen);
    tModule = newType("module", tObject, L::Module);
    tNoneType = newType("NoneType", tObject, L::Singleton);
    tNotImplType = newType("NotImplementedType", tObject, L::Singleton);
    tEllipsisType = newType("ellipsis", tObject, L::Singleton);
    tIter = newType("iterator", tObject, L::Iter);
    tDictKeys = newType("dict_keys", tObject, L::DictView);
    tDictValues = newType("dict_values", tObject, L::DictView);
    tDictItems = newType("dict_items", tObject, L::DictView);
    tSuper = newType("super", tObject, L::Super);
    tData = newType("object", tObject, L::Data);
    tModule->hasDict = true;
    tFunc->hasDict = true;
    Type *all[] = {tObject, tType, tStr, tDict, tInt, tBool, tFloat, tComplex, tBytes, tByteArray, tTuple, tList, tSet,
                   tFrozenSet, tRange, tSlice, tFunc, tNative, tMethod, tClassMethod, tStaticMethod, tProperty, tCell,
                   tCode, tGen, tModule, tNoneType, tNotImplType, tEllipsisType, tIter, tDictKeys, tDictValues,
                   tDictItems, tSuper};
    for (Type *t : all)
        addType(t);

    None = new Obj(tNoneType);
    NotImpl = new Obj(tNotImplType);
    EllipsisV = new Obj(tEllipsisType);
    IntObj *t1 = new IntObj(tBool);
    t1->small = 1;
    IntObj *f0 = new IntObj(tBool);
    f0->small = 0;
    True = t1;
    False = f0;

#define S(var, text) var = intern(text)
    S(s___get__, "__get__");
    S(s___set__, "__set__");
    S(s___delete__, "__delete__");
    S(s___getattr__, "__getattr__");
    S(s___getattribute__, "__getattribute__");
    S(s___setattr__, "__setattr__");
    S(s___delattr__, "__delattr__");
    S(s___init__, "__init__");
    S(s___new__, "__new__");
    S(s___call__, "__call__");
    S(s___repr__, "__repr__");
    S(s___str__, "__str__");
    S(s___hash__, "__hash__");
    S(s___eq__, "__eq__");
    S(s___ne__, "__ne__");
    S(s___lt__, "__lt__");
    S(s___le__, "__le__");
    S(s___gt__, "__gt__");
    S(s___ge__, "__ge__");
    S(s___len__, "__len__");
    S(s___bool__, "__bool__");
    S(s___iter__, "__iter__");
    S(s___next__, "__next__");
    S(s___getitem__, "__getitem__");
    S(s___setitem__, "__setitem__");
    S(s___delitem__, "__delitem__");
    S(s___contains__, "__contains__");
    S(s___index__, "__index__");
    S(s___format__, "__format__");
    S(s___class__, "__class__");
    S(s___dict__, "__dict__");
    S(s___name__, "__name__");
    S(s___qualname__, "__qualname__");
    S(s___module__, "__module__");
    S(s___doc__, "__doc__");
    S(s___init_subclass__, "__init_subclass__");
    S(s___set_name__, "__set_name__");
    S(s___class_getitem__, "__class_getitem__");
    S(s___missing__, "__missing__");
    S(s___reversed__, "__reversed__");
    S(s___neg__, "__neg__");
    S(s___pos__, "__pos__");
    S(s___invert__, "__invert__");
    S(s___abs__, "__abs__");
    S(s___int__, "__int__");
    S(s___float__, "__float__");
    S(s___mro_entries__, "__mro_entries__");
    S(s___instancecheck__, "__instancecheck__");
    S(s___subclasscheck__, "__subclasscheck__");
    S(s___slots__, "__slots__");
    S(s___abstractmethods__, "__abstractmethods__");
    S(s___isabstractmethod__, "__isabstractmethod__");
    S(s___classcell__, "__classcell__");
    S(s___weakref__, "__weakref__");
    S(s___annotations__, "__annotations__");
    S(s___orig_bases__, "__orig_bases__");
    S(s___length_hint__, "__length_hint__");
#undef S
    const char *bn[] = {"add", "sub", "mul", "matmul", "truediv", "floordiv", "mod", "pow", "lshift", "rshift", "or", "xor", "and"};
    for (int i = 0; i < 13; ++i)
    {
        binNames[i] = intern(std::string("__") + bn[i] + "__");
        rbinNames[i] = intern(std::string("__r") + bn[i] + "__");
        ibinNames[i] = intern(std::string("__i") + bn[i] + "__");
    }

    // object
    s_objectNew = makeNative("__new__", object_new, false);
    dictSet(tObject->dict, s___new__, s_objectNew);
    s_objectInit = makeNative("__init__", object_init, true);
    dictSet(tObject->dict, s___init__, s_objectInit);
    defMethod(tObject, "__repr__", object_repr);
    defMethod(tObject, "__str__", object_str);
    defMethod(tObject, "__eq__", object_eq);
    defMethod(tObject, "__ne__", object_ne);
    defMethod(tObject, "__lt__", object_notimpl);
    defMethod(tObject, "__le__", object_notimpl);
    defMethod(tObject, "__gt__", object_notimpl);
    defMethod(tObject, "__ge__", object_notimpl);
    defMethod(tObject, "__hash__", object_hash);
    defMethod(tObject, "__format__", object_format);
    nativeObjectSetattr = makeNative("__setattr__", object_setattr, true);
    dictSet(tObject->dict, s___setattr__, nativeObjectSetattr);
    nativeObjectDelattr = makeNative("__delattr__", object_delattr, true);
    dictSet(tObject->dict, s___delattr__, nativeObjectDelattr);
    nativeObjectGetattribute = makeNative("__getattribute__", objectGetattributeNative, true);
    dictSet(tObject->dict, s___getattribute__, nativeObjectGetattribute);
    defClassMethod(tObject, "__init_subclass__", object_init_subclass);
    defClassMethod(tObject, "__subclasshook__", object_subclasshook);
    defMethod(tObject, "__dir__", object_dir);
    defMethod(tObject, "__reduce_ex__", object_reduce_ex);
    PropertyObj *cls = new PropertyObj(tProperty);
    cls->fget = makeNative("__class__", object_class, false);
    dictSet(tObject->dict, s___class__, cls);
    PropertyObj *dictProp = new PropertyObj(tProperty);
    dictProp->fget = makeNative("__dict__", object_dict, false);
    dictSet(tObject->dict, s___dict__, dictProp);
    setAttrStr(tObject->dict, "__doc__", newStr("The base class of the class hierarchy."));

    // type
    dictSet(tType->dict, s___new__, makeNative("__new__", type_new, false));
    defMethod(tType, "__init__", type_init);
    defMethod(tType, "__call__", type_call);
    defMethod(tType, "__repr__", type_repr);
    defMethod(tType, "mro", type_mro);
    defMethod(tType, "__subclasses__", type_subclasses);
    defMethod(tType, "__instancecheck__", type_instancecheck);
    defMethod(tType, "__subclasscheck__", type_subclasscheck);
    defMethod(tType, "__or__", type_or);
    defMethod(tType, "__ror__", type_ror);
    defClassMethod(tType, "__prepare__", type_prepare);
    defGetSet(tType, "__name__", type_name_get, type_name_set);
    defGetSet(tType, "__qualname__", type_qualname_get, type_qualname_set);
    defGetSet(tType, "__module__", type_module_get, type_module_set);
    defGetSet(tType, "__doc__", type_doc_get, type_doc_set);
    defProperty(tType, "__mro__", type_mro_get);
    defProperty(tType, "__bases__", type_bases_get);
    defProperty(tType, "__base__", type_base_get);
    defProperty(tType, "__dict__", type_dict_get);
    defGetSet(tType, "__annotations__", type_annotations_get, type_annotations_set);
    defGetSet(tType, "__abstractmethods__", type_abstract_get, type_abstract_set);

    // functions
    defGetSet(tFunc, "__name__", func_name_get, func_name_set);
    defGetSet(tFunc, "__qualname__", func_qualname_get, func_qualname_set);
    defGetSet(tFunc, "__doc__", func_doc_get, func_doc_set);
    defGetSet(tFunc, "__module__", func_module_get, func_module_set);
    defGetSet(tFunc, "__defaults__", func_defaults_get, func_defaults_set);
    defProperty(tFunc, "__kwdefaults__", func_kwdefaults_get);
    defGetSet(tFunc, "__annotations__", func_annotations_get, func_annotations_set);
    defProperty(tFunc, "__code__", func_code_get);
    defProperty(tFunc, "__globals__", func_globals_get);
    defProperty(tFunc, "__closure__", func_closure_get);
    defMethod(tFunc, "__get__", func_get);
    defMethod(tFunc, "__call__", func_call);
    defCommonDunders(tFunc);
    defProperty(tCode, "co_name", code_name_get);
    defProperty(tCode, "co_argcount", code_argcount_get);
    defProperty(tCode, "co_varnames", code_varnames_get);
    defProperty(tCode, "co_flags", code_flags_get);
    defProperty(tCode, "co_firstlineno", code_firstlineno_get);
    defProperty(tCode, "co_filename", code_filename_get);
    defProperty(tCode, "co_kwonlyargcount", code_kwonly_get);
    defProperty(tCode, "co_posonlyargcount", code_posonly_get);
    defProperty(tCode, "co_freevars", code_freevars_get);
    defProperty(tCode, "co_cellvars", code_cellvars_get);
    defProperty(tCode, "co_names", code_names_get);
    defProperty(tCode, "co_nlocals", code_nlocals_get);
    defProperty(tCode, "co_qualname", code_qualname_get);
    defProperty(tMethod, "__func__", method_func_get);
    defProperty(tMethod, "__self__", method_self_get);
    defProperty(tMethod, "__name__", method_name_get);
    defProperty(tMethod, "__qualname__", method_qualname_get);
    defProperty(tMethod, "__doc__", method_doc_get);
    defMethod(tMethod, "__getattr__", method_getattr);
    defCompareDunders(tMethod);
    defCommonDunders(tMethod);
    defProperty(tNative, "__name__", native_name_get);
    defProperty(tNative, "__qualname__", native_name_get);
    defProperty(tNative, "__self__", native_self_get);
    defProperty(tNative, "__doc__", native_doc_get);
    defProperty(tNative, "__module__", native_module_get);
    defMethod(tNative, "__get__", native_get);
    defMethod(tNative, "__call__", func_call);
    defMethod(tMethod, "__call__", func_call);
    defCommonDunders(tNative);
    for (Type *w : {tClassMethod, tStaticMethod})
    {
        dictSet(w->dict, s___new__, makeNative("__new__", wrap_new, false));
        defProperty(w, "__func__", wrap_func_get);
        defProperty(w, "__wrapped__", wrap_func_get);
        defProperty(w, "__isabstractmethod__", wrap_isabstract_get);
        defMethod(w, "__get__", wrap_get);
        defMethod(w, "__getattr__", wrap_getattr);
        w->hasDict = true;
    }
    defMethod(tStaticMethod, "__call__", wrap_call);
    dictSet(tProperty->dict, s___new__, makeNative("__new__", property_new, false));
    defMethod(tProperty, "__init__", property_init);
    defMethod(tProperty, "getter", property_getter);
    defMethod(tProperty, "setter", property_setter);
    defMethod(tProperty, "deleter", property_deleter);
    defMethod(tProperty, "__get__", property_get);
    defMethod(tProperty, "__set__", property_set);
    defProperty(tProperty, "fget", property_fget);
    defProperty(tProperty, "fset", property_fset);
    defProperty(tProperty, "fdel", property_fdel);
    defProperty(tProperty, "__doc__", property_doc);
    defProperty(tProperty, "__isabstractmethod__", property_isabstract);
    defProperty(tProperty, "__name__", property_name);
    dictSet(tSuper->dict, s___new__, makeNative("__new__", super_new, false));
    defMethod(tSuper, "__getattribute__", super_getattribute);
    defProperty(tSuper, "__thisclass__", super_thisclass);
    defProperty(tSuper, "__self__", super_self);
    tSuper->builtin = false; // so its __getattribute__ is honoured
    tSuper->hasDict = false;
    defMethod(tNotImplType, "__bool__", notimpl_bool);
    for (Type *s : {tNoneType, tNotImplType, tEllipsisType})
    {
        defMethod(s, "__repr__", singleton_repr);
        defCompareDunders(s);
    }
    defMethod(tModule, "__repr__", module_repr);
    defProperty(tModule, "__name__", module_name_get);

    // numbers
    defNumberDunders(tInt, true);
    defNumberDunders(tFloat, false);
    defBinaryDunders(tComplex);
    defCompareDunders(tComplex);
    defCommonDunders(tComplex);
    // sequences and the rest share the layout-based comparison and repr
    for (Type *t : {tStr, tBytes, tByteArray, tTuple, tList, tDict, tSet, tFrozenSet, tRange, tSlice, tDictKeys,
                    tDictValues, tDictItems, tGen, tCell, tIter, tProperty, tType})
    {
        defCompareDunders(t);
        if (!dictGetStr(t->dict, s___repr__))
            defCommonDunders(t);
    }
    for (Type *t : {tStr, tBytes, tTuple, tList, tSet, tFrozenSet, tDict, tDictKeys, tDictItems})
    {
        Op ops[] = {OpAdd, OpMul, OpMod, OpBitOr, OpBitAnd, OpSub, OpBitXor};
        for (Op o : ops)
        {
            NativeObj *f = static_cast<NativeObj *>(makeNativeClosure(binNames[o]->s.c_str(), [o](V *a, int n, Kw *) -> V {
                checkArgs("binary op", n, 2, 2);
                return builtinBinary(a[0], a[1], o);
            }));
            f->method = true;
            dictSet(t->dict, binNames[o], f);
            NativeObj *r = static_cast<NativeObj *>(makeNativeClosure(rbinNames[o]->s.c_str(), [o](V *a, int n, Kw *) -> V {
                checkArgs("binary op", n, 2, 2);
                return builtinBinary(a[1], a[0], o);
            }));
            r->method = true;
            dictSet(t->dict, rbinNames[o], r);
        }
    }
    for (Type *t : {tList, tDict, tSet, tByteArray})
        dictSet(t->dict, s___hash__, None);
    initExceptionTypes();
}

// ── exceptions ─────────────────────────────────────────────────────────────

Type *tBaseException, *tException, *tStopIteration, *tGeneratorExit, *tKeyboardInterrupt, *tSystemExit,
    *tArithmeticError, *tZeroDivisionError, *tOverflowError, *tAssertionError, *tAttributeError, *tLookupError,
    *tIndexError, *tKeyError, *tNameError, *tUnboundLocalError, *tRuntimeError, *tRecursionError,
    *tNotImplementedError, *tTypeError, *tValueError, *tUnicodeError, *tImportError, *tModuleNotFoundError, *tOSError,
    *tFileNotFoundError, *tEOFError, *tMemoryError, *tSyntaxError, *tStopAsyncIteration, *tUnicodeDecodeError,
    *tUnicodeEncodeError, *tFloatingPointError, *tBufferError, *tWarning, *tUserWarning, *tDeprecationWarning,
    *tRuntimeWarning, *tPermissionError, *tTimeoutError, *tIsADirectoryError, *tExceptionGroup, *tBaseExceptionGroup,
    *tConnectionError, *tFileExistsError, *tIndentationError, *tTabError, *tSystemError, *tReferenceError,
    *tProcessLookupError, *tChildProcessError, *tBrokenPipeError, *tInterruptedError, *tBlockingIOError,
    *tUnicodeTranslateError, *tFutureWarning, *tPendingDeprecationWarning, *tSyntaxWarning, *tImportWarning,
    *tUnicodeWarning, *tBytesWarning, *tResourceWarning, *tEncodingWarning, *tNotADirectoryError,
    *tConnectionResetError, *tConnectionRefusedError, *tConnectionAbortedError;

static V exc_new(V *a, int n, Kw *)
{
    Type *t = static_cast<Type *>(a[0]);
    ExcObj *e = static_cast<ExcObj *>(newObject(t));
    std::vector<V> args(a + 1, a + n);
    e->args = tupleOf(args);
    return e;
}

static V exc_init(V *a, int n, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    std::vector<V> args(a + 1, a + n);
    e->args = tupleOf(args);
    return None;
}

static V exc_str(V *a, int, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    if (e->args->items.empty())
        return newStr("");
    if (e->args->items.size() == 1)
        return strV(e->args->items[0]);
    return newStr(reprOf(e->args));
}

static V keyerror_str(V *a, int, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    if (e->args->items.size() == 1)
        return newStr(reprOf(e->args->items[0]));
    return exc_str(a, 1, nullptr);
}

static V exc_repr(V *a, int, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    std::string args = e->args->items.size() == 1 ? "(" + reprOf(e->args->items[0]) + ")" : reprOf(e->args);
    return newStr(std::string(typeName(a[0])) + args);
}

static V exc_args_get(V *a, int, Kw *) { return static_cast<ExcObj *>(a[0])->args; }
static V exc_args_set(V *a, int, Kw *)
{
    static_cast<ExcObj *>(a[0])->args = tupleOf(toVector(a[1]));
    return None;
}
static V exc_cause_get(V *a, int, Kw *)
{
    V c = static_cast<ExcObj *>(a[0])->cause;
    return c ? c : None;
}
static V exc_cause_set(V *a, int, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    e->cause = a[1] == None ? nullptr : a[1];
    e->suppressContext = true;
    return None;
}
static V exc_context_get(V *a, int, Kw *)
{
    V c = static_cast<ExcObj *>(a[0])->context;
    return c ? c : None;
}
static V exc_context_set(V *a, int, Kw *)
{
    static_cast<ExcObj *>(a[0])->context = a[1] == None ? nullptr : a[1];
    return None;
}
static V exc_suppress_get(V *a, int, Kw *) { return mkbool(static_cast<ExcObj *>(a[0])->suppressContext); }
static V exc_suppress_set(V *a, int, Kw *)
{
    static_cast<ExcObj *>(a[0])->suppressContext = truthy(a[1]);
    return None;
}
static V exc_traceback_get(V *a, int, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    return e->tbLines.empty() ? None : (V)tupleOf(std::vector<V>{mkint(e->tbLines[0])});
}
static V exc_with_traceback(V *a, int, Kw *) { return a[0]; }
static V exc_add_note(V *a, int n, Kw *)
{
    checkArgs("add_note", n, 2, 2);
    if (!isStr(a[1]))
        raise(tTypeError, "note must be a str, not '" + std::string(typeName(a[1])) + "'");
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    e->notes.push_back(asStr(a[1])->s);
    if (!e->dict)
        e->dict = newDict();
    V notes = dictGetC(e->dict, "__notes__");
    if (!notes)
    {
        notes = newList();
        setAttrStr(e->dict, "__notes__", notes);
    }
    static_cast<List *>(notes)->items.push_back(a[1]);
    return None;
}
static V stopiter_value_get(V *a, int, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    if (e->dict)
    {
        V v = dictGetC(e->dict, "value");
        if (v)
            return v;
    }
    return e->args->items.empty() ? None : e->args->items[0];
}
static V systemexit_code_get(V *a, int, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    return e->args->items.empty() ? None : e->args->items.size() == 1 ? e->args->items[0] : (V)e->args;
}

static V oserror_errno(V *a, int, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    return e->args->items.size() >= 2 ? e->args->items[0] : None;
}
static V oserror_strerror(V *a, int, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    return e->args->items.size() >= 2 ? e->args->items[1] : None;
}

static Type *osErrorFor(int64_t err)
{
    switch (err)
    {
    case 2: return tFileNotFoundError;
    case 13: return tPermissionError;
    case 17: return tFileExistsError;
    case 21: return tIsADirectoryError;
    case 20: return tNotADirectoryError;
    case 32: return tBrokenPipeError;
    case 110:
    case 60: return tTimeoutError;
    case 111:
    case 61: return tConnectionRefusedError;
    case 104:
    case 54: return tConnectionResetError;
    case 103:
    case 53: return tConnectionAbortedError;
    case 3: return tProcessLookupError;
    case 10: return tChildProcessError;
    case 11:
    case 35: return tBlockingIOError;
    case 4: return tInterruptedError;
    default: return nullptr;
    }
}

V osErrorFor(int64_t errnoValue, const std::string &msg, const std::string &path)
{
    V args[4] = {tOSError, mkint(errnoValue), newStr(msg), newStr(path)};
    extern V callOsErrorNew(V *a, int n);
    return callOsErrorNew(args, 4);
}

static V oserror_new(V *a, int n, Kw *)
{
    Type *t = static_cast<Type *>(a[0]);
    if (t == tOSError && n >= 3 && isIntLike(a[1]))
    {
        Type *sub = osErrorFor(indexOf(a[1]));
        if (sub)
            t = sub;
    }
    ExcObj *e = static_cast<ExcObj *>(newObject(t));
    std::vector<V> args(a + 1, a + n);
    if (args.size() >= 3 && args.size() <= 5)
    {
        if (!e->dict)
            e->dict = newDict();
        setAttrStr(e->dict, "filename", args[2]);
        if (args.size() >= 5)
            setAttrStr(e->dict, "filename2", args[4]);
        args.resize(2);
    }
    e->args = tupleOf(args);
    return e;
}

static V oserror_init(V *, int, Kw *) { return None; }

V callOsErrorNew(V *a, int n) { return oserror_new(a, n, nullptr); }

static V oserror_str(V *a, int, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    V fn = e->dict ? dictGetC(e->dict, "filename") : nullptr;
    if (e->args->items.size() == 2)
    {
        std::string s = "[Errno " + strOf(e->args->items[0]) + "] " + strOf(e->args->items[1]);
        if (fn && fn != None)
            s += ": " + reprOf(fn);
        V fn2 = e->dict ? dictGetC(e->dict, "filename2") : nullptr;
        if (fn2 && fn2 != None)
            s += " -> " + reprOf(fn2);
        return newStr(s);
    }
    return exc_str(a, 1, nullptr);
}

static V oserror_filename(V *a, int, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    V fn = e->dict ? dictGetC(e->dict, "filename") : nullptr;
    return fn ? fn : None;
}

static V unicodeArg(V *a, size_t i)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    if (e->args->items.size() != 5)
        raise(tAttributeError, "attribute not set");
    return e->args->items[i];
}
static V unicode_encoding(V *a, int, Kw *) { return unicodeArg(a, 0); }
static V unicode_object(V *a, int, Kw *) { return unicodeArg(a, 1); }
static V unicode_start(V *a, int, Kw *) { return unicodeArg(a, 2); }
static V unicode_end(V *a, int, Kw *) { return unicodeArg(a, 3); }
static V unicode_reason(V *a, int, Kw *) { return unicodeArg(a, 4); }

static V unicode_str(V *a, int, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    if (e->args->items.size() != 5)
        return exc_str(a, 1, nullptr);
    std::string enc = strOf(e->args->items[0]), reason = strOf(e->args->items[4]);
    int64_t start = indexOf(e->args->items[2]), end = indexOf(e->args->items[3]);
    V obj = e->args->items[1];
    char buf[64];
    if (issub(typeOf(a[0]), tUnicodeDecodeError))
    {
        const std::string &b = static_cast<BytesObj *>(obj)->s;
        if (end == start + 1 && start < (int64_t)b.size())
        {
            snprintf(buf, sizeof buf, "0x%02x", (unsigned char)b[(size_t)start]);
            return newStr("'" + enc + "' codec can't decode byte " + buf + " in position " + std::to_string(start) + ": " + reason);
        }
        return newStr("'" + enc + "' codec can't decode bytes in position " + std::to_string(start) + "-" + std::to_string(end - 1) + ": " + reason);
    }
    if (end == start + 1 && isStr(obj))
    {
        uint32_t c = strCharAt(asStr(obj), start);
        if (c < 0x100)
            snprintf(buf, sizeof buf, "\\x%02x", c);
        else if (c < 0x10000)
            snprintf(buf, sizeof buf, "\\u%04x", c);
        else
            snprintf(buf, sizeof buf, "\\U%08x", c);
        return newStr("'" + enc + "' codec can't encode character '" + buf + "' in position " + std::to_string(start) + ": " + reason);
    }
    return newStr("'" + enc + "' codec can't encode characters in position " + std::to_string(start) + "-" + std::to_string(end - 1) + ": " + reason);
}

V makeUnicodeError(Type *t, const std::string &enc, V object, int64_t start, int64_t end, const std::string &reason)
{
    ExcObj *e = static_cast<ExcObj *>(newObject(t));
    std::vector<V> args;
    args.push_back(newStr(enc));
    args.push_back(object);
    args.push_back(mkint(start));
    args.push_back(mkint(end));
    args.push_back(newStr(reason));
    e->args = tupleOf(args);
    return e;
}

static V exc_reduce(V *a, int, Kw *)
{
    ExcObj *e = static_cast<ExcObj *>(a[0]);
    Tuple *t = newTuple(2);
    t->items[0] = typeOf(a[0]);
    t->items[1] = e->args;
    return t;
}

static void initExceptionTypes()
{
    tBaseException = excType("BaseException", tObject);
    dictSet(tBaseException->dict, s___new__, makeNative("__new__", exc_new, false));
    defMethod(tBaseException, "__init__", exc_init);
    defMethod(tBaseException, "__str__", exc_str);
    defMethod(tBaseException, "__repr__", exc_repr);
    defMethod(tBaseException, "with_traceback", exc_with_traceback);
    defMethod(tBaseException, "add_note", exc_add_note);
    defMethod(tBaseException, "__reduce__", exc_reduce);
    defGetSet(tBaseException, "args", exc_args_get, exc_args_set);
    defGetSet(tBaseException, "__cause__", exc_cause_get, exc_cause_set);
    defGetSet(tBaseException, "__context__", exc_context_get, exc_context_set);
    defGetSet(tBaseException, "__suppress_context__", exc_suppress_get, exc_suppress_set);
    defProperty(tBaseException, "__traceback__", exc_traceback_get);
    tException = excType("Exception", tBaseException);
    tGeneratorExit = excType("GeneratorExit", tBaseException);
    tKeyboardInterrupt = excType("KeyboardInterrupt", tBaseException);
    tSystemExit = excType("SystemExit", tBaseException);
    defProperty(tSystemExit, "code", systemexit_code_get);
    tStopIteration = excType("StopIteration", tException);
    defProperty(tStopIteration, "value", stopiter_value_get);
    tStopAsyncIteration = excType("StopAsyncIteration", tException);
    tArithmeticError = excType("ArithmeticError", tException);
    tZeroDivisionError = excType("ZeroDivisionError", tArithmeticError);
    tOverflowError = excType("OverflowError", tArithmeticError);
    tFloatingPointError = excType("FloatingPointError", tArithmeticError);
    tAssertionError = excType("AssertionError", tException);
    tAttributeError = excType("AttributeError", tException);
    tBufferError = excType("BufferError", tException);
    tEOFError = excType("EOFError", tException);
    tImportError = excType("ImportError", tException);
    tModuleNotFoundError = excType("ModuleNotFoundError", tImportError);
    tLookupError = excType("LookupError", tException);
    tIndexError = excType("IndexError", tLookupError);
    tKeyError = excType("KeyError", tLookupError);
    defMethod(tKeyError, "__str__", keyerror_str);
    tMemoryError = excType("MemoryError", tException);
    tNameError = excType("NameError", tException);
    tUnboundLocalError = excType("UnboundLocalError", tNameError);
    tOSError = excType("OSError", tException);
    defProperty(tOSError, "errno", oserror_errno);
    defProperty(tOSError, "strerror", oserror_strerror);
    dictSet(tOSError->dict, intern("__new__"), makeNative("__new__", oserror_new, false));
    defMethod(tOSError, "__init__", oserror_init);
    defMethod(tOSError, "__str__", oserror_str);
    tFileNotFoundError = excType("FileNotFoundError", tOSError);
    tFileExistsError = excType("FileExistsError", tOSError);
    tPermissionError = excType("PermissionError", tOSError);
    tTimeoutError = excType("TimeoutError", tOSError);
    tIsADirectoryError = excType("IsADirectoryError", tOSError);
    tNotADirectoryError = excType("NotADirectoryError", tOSError);
    tConnectionError = excType("ConnectionError", tOSError);
    tConnectionResetError = excType("ConnectionResetError", tConnectionError);
    tConnectionRefusedError = excType("ConnectionRefusedError", tConnectionError);
    tConnectionAbortedError = excType("ConnectionAbortedError", tConnectionError);
    tBrokenPipeError = excType("BrokenPipeError", tConnectionError);
    tProcessLookupError = excType("ProcessLookupError", tOSError);
    tChildProcessError = excType("ChildProcessError", tOSError);
    tInterruptedError = excType("InterruptedError", tOSError);
    tBlockingIOError = excType("BlockingIOError", tOSError);
    tReferenceError = excType("ReferenceError", tException);
    tRuntimeError = excType("RuntimeError", tException);
    tRecursionError = excType("RecursionError", tRuntimeError);
    tNotImplementedError = excType("NotImplementedError", tRuntimeError);
    tSyntaxError = excType("SyntaxError", tException);
    tIndentationError = excType("IndentationError", tSyntaxError);
    tTabError = excType("TabError", tIndentationError);
    tSystemError = excType("SystemError", tException);
    tTypeError = excType("TypeError", tException);
    tValueError = excType("ValueError", tException);
    tUnicodeError = excType("UnicodeError", tValueError);
    tUnicodeDecodeError = excType("UnicodeDecodeError", tUnicodeError);
    tUnicodeEncodeError = excType("UnicodeEncodeError", tUnicodeError);
    tUnicodeTranslateError = excType("UnicodeTranslateError", tUnicodeError);
    for (Type *t : {tUnicodeEncodeError, tUnicodeDecodeError})
    {
        defProperty(t, "encoding", unicode_encoding);
        defProperty(t, "object", unicode_object);
        defProperty(t, "start", unicode_start);
        defProperty(t, "end", unicode_end);
        defProperty(t, "reason", unicode_reason);
        defMethod(t, "__str__", unicode_str);
    }
    tWarning = excType("Warning", tException);
    tUserWarning = excType("UserWarning", tWarning);
    tDeprecationWarning = excType("DeprecationWarning", tWarning);
    tPendingDeprecationWarning = excType("PendingDeprecationWarning", tWarning);
    tSyntaxWarning = excType("SyntaxWarning", tWarning);
    tRuntimeWarning = excType("RuntimeWarning", tWarning);
    tFutureWarning = excType("FutureWarning", tWarning);
    tImportWarning = excType("ImportWarning", tWarning);
    tUnicodeWarning = excType("UnicodeWarning", tWarning);
    tBytesWarning = excType("BytesWarning", tWarning);
    tResourceWarning = excType("ResourceWarning", tWarning);
    tEncodingWarning = excType("EncodingWarning", tWarning);
    tBaseExceptionGroup = excType("BaseExceptionGroup", tBaseException);
    tExceptionGroup = excType("ExceptionGroup", tBaseExceptionGroup);
    tExceptionGroup->bases.push_back(tException);
    computeMro(tExceptionGroup);
}

std::vector<Type *> &exceptionTypes()
{
    static std::vector<Type *> v;
    if (v.empty() && allTypes)
        for (Type *t : *allTypes)
            if (t->layout == L::Exc)
                v.push_back(t);
    return v;
}

} // namespace py
