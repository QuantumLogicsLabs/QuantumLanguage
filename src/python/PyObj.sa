static V func_get(V *a, int n, Kw *)
{
    // function.__get__(obj, type)
    if (n < 2 || a[1] == None)
        return a[0];
    MethodObj *m = new MethodObj(tMethod);
    m->func = a[0];
    m->self = a[1];
    return m;
}
static V func_call(V *a, int n, Kw *kw) { return call(a[0], a + 1, n - 1, kw); }

static V code_name_get(V *a, int, Kw *) { return newStr(static_cast<Code *>(a[0])->name); }
static V code_argcount_get(V *a, int, Kw *) { return mkint(static_cast<Code *>(a[0])->argcount); }
