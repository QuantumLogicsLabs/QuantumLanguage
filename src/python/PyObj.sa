{
    Code *c = static_cast<Code *>(a[0]);
    std::vector<V> items(c->varnames.begin(), c->varnames.end());
    return tupleOf(items);
}
static V code_flags_get(V *a, int, Kw *)
{
    Code *c = static_cast<Code *>(a[0]);
    int f = 0;
    if (c->flags & CF_GENERATOR)
        f |= 0x20;
    if (c->flags & CF_VARARGS)
        f |= 0x04;
    if (c->flags & CF_VARKW)
        f |= 0x08;
    return mkint(f);
}
static V code_firstlineno_get(V *a, int, Kw *) { return mkint(static_cast<Code *>(a[0])->firstline); }
static V code_filename_get(V *a, int, Kw *) { return newStr(static_cast<Code *>(a[0])->filename); }
