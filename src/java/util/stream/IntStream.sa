package java.util.stream;

import java.util.*;
import java.util.function.*;

public interface IntStream extends BaseStream<Integer, IntStream> {
    IntStream filter(IntPredicate predicate);
    IntStream map(IntUnaryOperator mapper);
    <U> Stream<U> mapToObj(IntFunction<? extends U> mapper);
    LongStream mapToLong(IntToLongFunction mapper);
    DoubleStream mapToDouble(IntToDoubleFunction mapper);
    IntStream flatMap(IntFunction<? extends IntStream> mapper);
    IntStream distinct();
    IntStream sorted();
    IntStream peek(IntConsumer action);
    IntStream limit(long maxSize);
    IntStream skip(long n);
    IntStream takeWhile(IntPredicate predicate);
    IntStream dropWhile(IntPredicate predicate);
    void forEach(IntConsumer action);
    void forEachOrdered(IntConsumer action);
    int[] toArray();
    int reduce(int identity, IntBinaryOperator op);
    OptionalInt reduce(IntBinaryOperator op);
    <R> R collect(Supplier<R> supplier, ObjIntConsumer<R> accumulator, BiConsumer<R, R> combiner);
    int sum();
    OptionalInt min();
    OptionalInt max();
    long count();
    OptionalDouble average();
    IntSummaryStatistics summaryStatistics();
    boolean anyMatch(IntPredicate predicate);
    boolean allMatch(IntPredicate predicate);
    boolean noneMatch(IntPredicate predicate);
    OptionalInt findFirst();
    OptionalInt findAny();
    LongStream asLongStream();
    DoubleStream asDoubleStream();
    Stream<Integer> boxed();
    PrimitiveIterator.OfInt iterator();

    public static IntStream empty() { return new IntStreamImpl(Collections.<Integer>emptyIterator()); }
    public static IntStream of(int t) { return StreamSupport.$intsOfArray(new int[] {t}, 0, 1); }
    public static IntStream of(int... values) { return StreamSupport.$intsOfArray(values, 0, values.length); }

    public static IntStream range(int startInclusive, int endExclusive) {
        return new IntStreamImpl(new Iterator<Integer>() {
            int i = startInclusive;
            public boolean hasNext() { return i < endExclusive; }
            public Integer next() {
                if (i >= endExclusive)
                    throw new NoSuchElementException();
                return i++;
            }
        });
    }

    public static IntStream rangeClosed(int startInclusive, int endInclusive) {
        return new IntStreamImpl(new Iterator<Integer>() {
            long i = startInclusive;
            public boolean hasNext() { return i <= endInclusive; }
            public Integer next() {
                if (i > endInclusive)
                    throw new NoSuchElementException();
                return (int) i++;
            }
        });
    }

    public static IntStream iterate(final int seed, final IntUnaryOperator f) {
        return new IntStreamImpl(Stream.<Integer>iterate(seed, x -> f.applyAsInt(x)).iterator());
    }

    public static IntStream iterate(int seed, IntPredicate hasNext, IntUnaryOperator next) {
        return new IntStreamImpl(Stream.<Integer>iterate(seed, x -> hasNext.test(x), x -> next.applyAsInt(x)).iterator());
    }

    public static IntStream generate(IntSupplier s) {
        return new IntStreamImpl(new Iterator<Integer>() {
            public boolean hasNext() { return true; }
            public Integer next() { return s.getAsInt(); }
        });
    }

    public static IntStream concat(IntStream a, IntStream b) {
        return new IntStreamImpl(Stream.concat(a.boxed(), b.boxed()).iterator());
    }
}
