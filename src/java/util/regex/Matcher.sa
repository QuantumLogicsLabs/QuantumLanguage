package java.util.regex;

import java.util.*;
import java.util.function.*;

public final class Matcher implements MatchResult {
    private Pattern pattern;
    private String text;
    private int[] groups;    // [start0, end0, start1, end1, ...] of the last match, or null
    private int searchFrom;  // where the next find() starts
    private int appendPos;

    Matcher(Pattern pattern, String text) {
        this.pattern = pattern;
        this.text = text;
    }

    public Pattern pattern() { return pattern; }

    public boolean matches() {
        groups = Pattern.$match(pattern.effective(), pattern.flags(), text, 0, 1);
        if (groups != null)
            searchFrom = groups[1];
        return groups != null;
    }

    public boolean lookingAt() {
        groups = Pattern.$match(pattern.effective(), pattern.flags(), text, 0, 2);
        if (groups != null)
            searchFrom = groups[1];
        return groups != null;
    }

    public boolean find() {
        if (searchFrom > text.length()) {
            groups = null;
            return false;
        }
        groups = Pattern.$match(pattern.effective(), pattern.flags(), text, searchFrom, 0);
        if (groups == null) {
            searchFrom = text.length() + 1;
            return false;
        }
        searchFrom = groups[1] == groups[0] ? groups[1] + 1 : groups[1];
        return true;
    }

    public boolean find(int start) {
        if (start < 0 || start > text.length())
            throw new IndexOutOfBoundsException("Illegal start index");
        reset();
        searchFrom = start;
        return find();
    }

    private void checkMatch() {
        if (groups == null)
            throw new IllegalStateException("No match found");
    }

    private void checkGroup(int group) {
        if (group < 0 || group > groupCount())
            throw new IndexOutOfBoundsException("No group " + group);
    }

    public String group() { return group(0); }

    public String group(int group) {
        checkMatch();
        checkGroup(group);
        if (groups[2 * group] < 0)
            return null;
        return text.substring(groups[2 * group], groups[2 * group + 1]);
    }

    public String group(String name) { throw new IllegalArgumentException("No group with name <" + name + ">"); }

    public int groupCount() { return groups != null ? groups.length / 2 - 1 : Pattern.$groupCount(pattern.effective()); }

    public int start() { return start(0); }

    public int start(int group) {
        checkMatch();
        checkGroup(group);
        return groups[2 * group];
    }

    public int end() { return end(0); }

    public int end(int group) {
        checkMatch();
        checkGroup(group);
        return groups[2 * group + 1];
    }

    public boolean hasMatch() { return groups != null; }
    public boolean hitEnd() { return groups == null || groups[1] == text.length(); }

    public Matcher reset() {
        groups = null;
        searchFrom = 0;
        appendPos = 0;
        return this;
    }

    public Matcher reset(CharSequence input) {
        text = input.toString();
        return reset();
    }

    public Matcher usePattern(Pattern newPattern) {
        pattern = Objects.requireNonNull(newPattern);
        groups = null;
        return this;
    }

    // $n and \x in a replacement string
    private String expand(String replacement) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < replacement.length(); i++) {
            char c = replacement.charAt(i);
            if (c == '\\' && i + 1 < replacement.length()) {
                sb.append(replacement.charAt(++i));
            } else if (c == '$' && i + 1 < replacement.length() && Character.isDigit(replacement.charAt(i + 1))) {
                int g = replacement.charAt(++i) - '0';
                while (i + 1 < replacement.length() && Character.isDigit(replacement.charAt(i + 1))
                        && g * 10 + (replacement.charAt(i + 1) - '0') <= groupCount())
                    g = g * 10 + (replacement.charAt(++i) - '0');
                String v = group(g);
                if (v != null)
                    sb.append(v);
            } else if (c == '$') {
                throw new IllegalArgumentException("Illegal group reference");
            } else
                sb.append(c);
        }
        return sb.toString();
    }

    public Matcher appendReplacement(StringBuilder sb, String replacement) {
        checkMatch();
        sb.append(text, appendPos, start());
        sb.append(expand(replacement));
        appendPos = end();
        return this;
    }

    public Matcher appendReplacement(StringBuffer sb, String replacement) {
        checkMatch();
        sb.append(text, appendPos, start());
        sb.append(expand(replacement));
        appendPos = end();
        return this;
    }

    public StringBuilder appendTail(StringBuilder sb) {
        sb.append(text, appendPos, text.length());
        return sb;
    }

    public StringBuffer appendTail(StringBuffer sb) {
        sb.append(text, appendPos, text.length());
        return sb;
    }

    public String replaceAll(String replacement) {
        reset();
        StringBuilder sb = new StringBuilder();
        while (find())
            appendReplacement(sb, replacement);
        return appendTail(sb).toString();
    }

    public String replaceAll(Function<MatchResult, String> replacer) {
        reset();
        StringBuilder sb = new StringBuilder();
        while (find())
            appendReplacement(sb, replacer.apply(toMatchResult()));
        return appendTail(sb).toString();
    }

    public String replaceFirst(String replacement) {
        reset();
        StringBuilder sb = new StringBuilder();
        if (find())
            appendReplacement(sb, replacement);
        return appendTail(sb).toString();
    }

    public MatchResult toMatchResult() {
        checkMatch();
        final int[] g = groups.clone();
        final String t = text;
        return new MatchResult() {
            public int start() { return g[0]; }
            public int start(int group) { return g[2 * group]; }
            public int end() { return g[1]; }
            public int end(int group) { return g[2 * group + 1]; }
            public String group() { return t.substring(g[0], g[1]); }
            public String group(int group) { return g[2 * group] < 0 ? null : t.substring(g[2 * group], g[2 * group + 1]); }
            public int groupCount() { return g.length / 2 - 1; }
        };
    }

    public java.util.stream.Stream<MatchResult> results() {
        ArrayList<MatchResult> out = new ArrayList<>();
        reset();
        while (find())
            out.add(toMatchResult());
        return out.stream();
    }

    public static String quoteReplacement(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '\\' || c == '$')
                sb.append('\\');
            sb.append(c);
        }
        return sb.toString();
    }

    public String toString() {
        return "java.util.regex.Matcher[pattern=" + pattern + " region=0," + text.length() + " lastmatch="
                + (groups != null ? group() : "") + "]";
    }
}
