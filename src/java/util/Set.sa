package java.util;

import java.util.function.*;
import java.util.stream.*;

public interface Set<E> extends Collection<E> {
    int size();
    boolean isEmpty();
    boolean contains(Object o);
    Iterator<E> iterator();
    Object[] toArray();
    <T> T[] toArray(T[] a);
    boolean add(E e);
    boolean remove(Object o);
    boolean containsAll(Collection<?> c);
    boolean addAll(Collection<? extends E> c);
    boolean retainAll(Collection<?> c);
    boolean removeAll(Collection<?> c);
    void clear();
    boolean equals(Object o);
    int hashCode();

    @SafeVarargs
    static <E> Set<E> of(E... elements) { return ImmutableCollections.setOf(elements); }

    static <E> Set<E> copyOf(Collection<? extends E> coll) {
        if (coll instanceof ImmutableCollections.SetN)
            return ImmutableCollections.setOf(coll.toArray());
        return ImmutableCollections.setOf(new LinkedHashSet<>(coll).toArray());
    }
}
