// quantum: cpp
#pragma once
// HTML front-end: what the rest of the compiler sees of it. A page is read
// the way a browser reads it, checked the way a validator checks it (its CSS
// by src/css), and compiled to the document as a browser holds it, with the
// local stylesheets it links inlined.
#include <string>
#include <vector>

namespace html
{

// A page as qrun compiles it: the document, gcc-style diagnostics, and
// whether any of them is an error
struct Result
{
    std::string output, report;
    bool failed = false;
};

// Compiles the page at `path`; `extraSheets` are stylesheet files applied as
// well (qrun page.html extra.css), unless the page links them already
Result compile(const std::string &source, const std::string &path, const std::vector<std::string> &extraSheets);

// Whether a .sa file holds a page: it starts with a doctype, an HTML comment
// or an HTML element's tag
bool looksLikePage(const std::string &source);

// Conformance testing (hidden qrun flags). The tree construction tests of
// the web-platform-tests / html5lib .dat format: each test's input is parsed
// (as a document, or as a fragment in a context element; with scripting on,
// off, or both) and its tree compared with the expected one. Prints the
// failures and a summary; 0 when all pass.
int runTreeTests(const std::vector<std::string> &files, bool verbose);

// The tree of a page in that format (qrun --html-dump page.html)
int dumpTreeFile(const std::string &path, bool scripting);

// html5lib tokenizer tests, given as a batch file that tools write from the
// JSON tests: prints each test's tokens, one JSON array per line
int runTokenizerBatch(const std::string &path);

} // namespace html
