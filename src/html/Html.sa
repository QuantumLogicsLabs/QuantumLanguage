// start tags that close an open "p"
const std::set<std::string> &closesP()
{
    static const std::set<std::string> s = words(
        "address article aside blockquote center details dialog dir div dl fieldset figcaption figure footer "
        "header hgroup main menu nav ol p search section summary ul h1 h2 h3 h4 h5 h6 pre listing form "
        "plaintext table hr xmp li dd dt");
    return s;
}

// end tags closed by scope (the "address, article, ..." group of the standard)
const std::set<std::string> &blockEnds()
{
    static const std::set<std::string> s = words(
        "address article aside blockquote button center details dialog dir div dl fieldset figcaption figure "
        "footer header hgroup listing main menu nav ol pre search section summary ul");
    return s;
}

// elements whose end tag may be left out
const std::set<std::string> &impliedEnd()
{
    static const std::set<std::string> s = words("dd dt li optgroup option p rb rp rt rtc");
    return s;
}

// elements that may still be open when the body ends
const std::set<std::string> &openAtEndOk()
{
    static const std::set<std::string> s = words(
        "dd dt li optgroup option p rb rp rt rtc tbody td tfoot th thead tr body html head caption colgroup");
    return s;
}

const std::set<std::string> &tableParts()
{
    static const std::set<std::string> s = words("caption colgroup col tbody thead tfoot tr td th");
    return s;
}

// HTML start tags that end SVG / MathML content
const std::set<std::string> &breakout()
{
    static const std::set<std::string> s = words(
        "b big blockquote body br center code dd div dl dt em embed h1 h2 h3 h4 h5 h6 head hr i img li listing "
        "menu meta nobr ol p pre ruby s small span strong strike sub sup table tt u ul var");
    return s;
}

// elements whose text is not markup (style, script) — written back as it is
const std::set<std::string> &rawText()
{
    static const std::set<std::string> s = words("style script xmp iframe noembed noframes plaintext");
    return s;
}

bool heading(const std::string &n) { return n.size() == 2 && n[0] == 'h' && n[1] >= '1' && n[1] <= '6'; }

void appendUtf8(std::string &out, unsigned cp)
{
    if (cp < 0x80)
        out += (char)cp;
    else if (cp < 0x800)
    {
        out += (char)(0xC0 | (cp >> 6));
        out += (char)(0x80 | (cp & 0x3F));
    }
    else if (cp < 0x10000)
    {
        out += (char)(0xE0 | (cp >> 12));
        out += (char)(0x80 | ((cp >> 6) & 0x3F));
        out += (char)(0x80 | (cp & 0x3F));
    }
    else
    {
        out += (char)(0xF0 | (cp >> 18));
        out += (char)(0x80 | ((cp >> 12) & 0x3F));
        out += (char)(0x80 | ((cp >> 6) & 0x3F));
        out += (char)(0x80 | (cp & 0x3F));
    }
}

// what a browser makes of &#128; .. &#159; (Windows-1252)
unsigned windows1252(unsigned cp)
{
    static const unsigned table[32] = {0x20AC, 0x81,   0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021,
                                       0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, 0x8D,   0x017D, 0x8F,
                                       0x90,   0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014,
                                       0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, 0x9D,   0x017E, 0x0178};
    return table[cp - 0x80];
}

const std::map<std::string, std::string> &entityMap()
{
    static std::map<std::string, std::string> m;
    if (m.empty())
        for (int k = 0; k < kEntityCount; ++k)
            m[kEntities[2 * k]] = kEntities[2 * k + 1];
    return m;
}

struct Attr
{
    std::string name, value;
    std::string rawName; // as written (SVG keeps its case: viewBox)
    int pos = 0;       // offset of the name
    int valuePos = -1; // offset of the value's first character
};

struct Node
{
    bool element = true; // else text, or a comment when `comment`
    bool comment = false;
    std::string name;
    std::vector<Attr> attrs;
    std::string text;
    std::vector<Node *> kids;
    Node *parent = nullptr;
    bool foreign = false; // SVG or MathML
    bool implied = false; // made by the parser: no tag in the source
    int pos = 0;          // offset of its start tag
    int contentPos = -1;  // a raw-text element: offset of its text
};

const Attr *findAttr(const Node *e, const std::string &name)
{
    for (const Attr &a : e->attrs)
        if (a.name == name)
            return &a;
    return nullptr;
}

struct Token
{
    enum Type
    {
        START,
        END,
        TEXT,
        COMMENT,
        DOCTYPE,
        END_OF_FILE
    };
    Type type = END_OF_FILE;
    std::string name;    // tag name (lowercase), doctype name
    std::string rawName; // as written (SVG keeps its case)
    std::vector<Attr> attrs;
    bool selfClosing = false;
    std::string data; // text, comment, what follows the doctype name
    int pos = 0;
};

struct Diag
{
    int line = 1, col = 1, width = 1;
    bool error = true;
    std::string message;
};

enum Mode
{
    INITIAL,
    BEFORE_HTML,
    BEFORE_HEAD,
    IN_HEAD,
    AFTER_HEAD,
    IN_BODY,
    AFTER_BODY,
    AFTER_AFTER_BODY
};

enum Scope
{
    S_DEFAULT,
    S_BUTTON,
    S_LIST,
    S_TABLE
};

class Parser
{
public:
    explicit Parser(const std::string &source) : s(source), n(source.size())
    {
        lineStarts.push_back(0);
        for (size_t k = 0; k < n; ++k)
            if (s[k] == '\n')
                lineStarts.push_back((int)k + 1);
    }

    std::vector<Diag> diags;
    Node *doc = nullptr, *htmlEl = nullptr, *headEl = nullptr, *bodyEl = nullptr;
    bool hasDoctype = false, explicitHtml = false, explicitHead = false;
    std::string doctypeName;

    void lineCol(int off, int &line, int &col) const
    {
        size_t idx = (size_t)(std::upper_bound(lineStarts.begin(), lineStarts.end(), off) - lineStarts.begin()) - 1;
        line = (int)idx + 1;
        col = off - lineStarts[idx] + 1;
    }

    void report(int pos, int width, bool error, const std::string &msg)
    {
        Diag d;
        lineCol(pos, d.line, d.col);
        d.width = std::max(1, width);
        d.error = error;
        d.message = msg;
        diags.push_back(d);
    }

    Node *parse()
    {
        doc = new Node();
        doc->name = "#document";
        Token t;
        while (true)
        {
            readToken(t);
            while (!step(t))
            {
            }
            if (t.type == Token::END_OF_FILE)
                break;
        }
        finish();
        return doc;
    }

private:
    const std::string &s;
    size_t n;
    size_t i = 0;
    std::vector<int> lineStarts;
    std::vector<Node *> open; // the stack of open elements
    std::set<Node *> reported; // already reported as unclosed
    int mode = INITIAL;
    Node *rawNode = nullptr;  // the open raw-text element (style, script, title ...)
    std::string rawEnd;       // inside a raw-text element: its name
    bool rcdata = false;      // ... whose character references are read (title, textarea)
    bool plaintext = false;   // the rest of the file is text
    bool skipNewline = false; // right after <pre>, <listing>, <textarea>

    static int tagWidth(const Token &t) { return (int)t.name.size() + 1; }

    // ── tokenizer ────────────────────────────────────────────────────────

    void readToken(Token &t)
    {
        while (true)
        {
            t = Token();
            t.pos = (int)i;
            if (i >= n)
            {
                t.type = Token::END_OF_FILE;
                break;
            }
            if (plaintext)
            {
                t.type = Token::TEXT;
                t.data = s.substr(i);
                i = n;
                break;
            }
            if (!rawEnd.empty())
            {
                readRaw(t);
                break;
            }
            int got = s[i] == '<' ? readTag(t) : 0;
            if (got == 1)
                break;
            if (got == 2)
                continue;
            readText(t);
            break;
        }
        if (skipNewline)
        {
            skipNewline = false;
            if (t.type == Token::TEXT && !t.data.empty() && t.data[0] == '\n')
                t.data.erase(0, 1);
        }
    }

    void readText(Token &t)
    {
        t.type = Token::TEXT;
        std::string out;
        if (i < n && s[i] == '<')
            out += s[i++]; // a "<" that starts no tag
        while (i < n && s[i] != '<')
        {
            char c = s[i];
            if (c == '&')
            {
                charRef(out, false);
                continue;
            }
            if (c == '\r')
            {
                out += '\n';
                ++i;
                if (i < n && s[i] == '\n')
                    ++i;
                continue;
            }
            if (c == '\0')
            {
                report((int)i, 1, true, "Saw U+0000 in the text.");
                ++i;
                continue;
            }
            out += c;
            ++i;
        }
        t.data = out;
    }

    // the text of a raw-text element, up to its end tag
    void readRaw(Token &t)
    {
        t.type = Token::TEXT;
        size_t end = n;
        for (size_t j = i;;)
        {
            size_t k = s.find("</", j);
            if (k == std::string::npos)
                break;
            size_t m = k + 2;
            if (m + rawEnd.size() <= n && lower(s.substr(m, rawEnd.size())) == rawEnd)
            {
                char after = m + rawEnd.size() < n ? s[m + rawEnd.size()] : '>';
                if (isWs(after) || after == '/' || after == '>')
                {
                    end = k;
                    break;
                }
            }
            j = k + 2;
        }
        std::string out;
        while (i < end)
        {
            if (rcdata && s[i] == '&')
            {
                charRef(out, false);
                continue;
            }
            if (s[i] == '\r')
            {
                out += '\n';
                ++i;
                if (i < end && s[i] == '\n')
                    ++i;
                continue;
            }
            out += s[i++];
        }
        i = end;
        if (end == n)
            report((int)n, 1, true, "End of file seen when expecting text or an end tag.");
        t.data = out;
        rawEnd.clear();
        rcdata = false;
    }

    // From "<": a token (1), nothing to keep (2), or a "<" that is text (0)
    int readTag(Token &t)
    {
        size_t start = i;
        char c1 = i + 1 < n ? s[i + 1] : '\0';
        if (c1 == '!')
        {
            if (s.compare(i, 4, "<!--") == 0)
            {
                comment(t);
                return 1;
            }
            if (i + 9 <= n && lower(s.substr(i, 9)) == "<!doctype")
            {
                doctype(t);
                return 1;
            }
            if (s.compare(i, 9, "<![CDATA[") == 0)
            {
                size_t close = s.find("]]>", i + 9);
                size_t stop = close == std::string::npos ? n : close;
                if (current()->foreign)
                {
                    t.type = Token::TEXT;
                    t.data = s.substr(i + 9, stop - (i + 9));
                    i = close == std::string::npos ? n : close + 3;
                    return 1;
                }
                report((int)start, 9, true, "Saw \"<![CDATA[\" in HTML: CDATA sections are only allowed in SVG and MathML.");
                bogusComment(t, i + 2);
                return 1;
            }
            report((int)start, 2, true, "Bogus comment.");
            bogusComment(t, i + 2);
            return 1;
        }
        if (c1 == '/')
        {
            char c2 = i + 2 < n ? s[i + 2] : '\0';
            if (std::isalpha((unsigned char)c2))
                return endTag(t) ? 1 : 2;
            if (c2 == '>')
            {
                report((int)start, 3, true,
                       "Saw \"</>\". Probable causes: Unescaped \"<\" (escape as \"&lt;\") or mistyped end tag.");
                i += 3;
                return 2;
            }
            if (i + 2 >= n)
            {
                report((int)start, 2, true, "End of file seen after \"</\".");
                return 0;
            }
            report((int)start, 2, true,
                   "Garbage after \"</\". Probable causes: Unescaped \"<\" (escape as \"&lt;\") or mistyped end tag.");
            bogusComment(t, i + 2);
            return 1;
        }
        if (c1 == '?')
        {
            report((int)start, 2, true,
                   "Saw \"<?\". Probable cause: Attempt to use an XML processing instruction in HTML. (XML "
                   "processing instructions are not supported in HTML.)");
            bogusComment(t, i + 1);
            return 1;
        }
        if (std::isalpha((unsigned char)c1))
            return startTag(t) ? 1 : 2;
        if (i + 1 >= n)
            report((int)start, 1, true, "End of file after \"<\".");
        else if ((unsigned char)c1 < 0x80 && !isWs(c1))
            report((int)start, 2, true,
                   std::string("Bad character \"") + c1 +
                       "\" after \"<\". Probable cause: Unescaped \"<\". Try escaping it as \"&lt;\".");
        else
            report((int)start, 1, true, "Bad character after \"<\". Probable cause: Unescaped \"<\". Try escaping it as \"&lt;\".");
        return 0;
    }

    void bogusComment(Token &t, size_t from)
    {
        size_t close = s.find('>', from);
        size_t stop = close == std::string::npos ? n : close;
        t.type = Token::COMMENT;
        t.data = s.substr(from, stop - from);
        i = close == std::string::npos ? n : close + 1;
    }

    void comment(Token &t)
    {
        size_t start = i, j = i + 4;
        t.type = Token::COMMENT;
        if (s.compare(j, 1, ">") == 0 || s.compare(j, 2, "->") == 0)
        {
            report((int)start, 4, true, "Premature end of comment. Use \"-->\" to end a comment properly.");
            i = j + (s[j] == '>' ? 1 : 2);
            return;
        }
        size_t close = s.find("-->", j);
        size_t bang = s.find("--!>", j);
        if (bang != std::string::npos && (close == std::string::npos || bang < close))
        {
            report((int)bang, 4, true, "The comment ended with \"--!>\": use \"-->\".");
            t.data = s.substr(j, bang - j);
            i = bang + 4;
            return;
        }
        if (close == std::string::npos)
        {
            report((int)start, 4, true, "End of file inside comment.");
            t.data = s.substr(j);
            i = n;
            return;
        }
        t.data = s.substr(j, close - j);
        size_t nested = t.data.find("<!--");
        if (nested != std::string::npos)
            report((int)(j + nested), 4, true, "Saw \"<!--\" within a comment. Probable cause: Nested comment (not allowed).");
        i = close + 3;
    }

    void doctype(Token &t)
    {
        size_t start = i;
        size_t close = s.find('>', i);
        if (close == std::string::npos)
        {
            report((int)start, 9, true, "End of file inside doctype.");
            close = n;
        }
        std::string body = s.substr(i + 9, close - (i + 9));
        std::istringstream in(body);
        std::string name, rest;
        in >> name;
        std::getline(in, rest);
        size_t a = rest.find_first_not_of(" \t\r\n\f");
        t.type = Token::DOCTYPE;
        t.name = lower(name);
        t.data = a == std::string::npos ? "" : rest.substr(a);
        i = close < n ? close + 1 : n;
    }

    bool endTag(Token &t)
    {
        size_t start = i, j = i + 2;
        while (j < n && !isWs(s[j]) && s[j] != '/' && s[j] != '>')
            ++j;
        t.type = Token::END;
        t.rawName = s.substr(i + 2, j - i - 2);
        t.name = lower(t.rawName);
        size_t close = s.find('>', j);
        if (close == std::string::npos)
        {
            report((int)start, (int)(j - start), true, "End of file seen inside an end tag. Ignoring tag.");
            i = n;
            return false;
        }
        for (size_t k = j; k < close; ++k)
            if (!isWs(s[k]) && s[k] != '/')
            {
                report((int)k, 1, true, "End tag had attributes.");
                break;
            }
        i = close + 1;
        return true;
    }

    bool startTag(Token &t)
    {
        size_t start = i, j = i + 1;
        while (j < n && !isWs(s[j]) && s[j] != '/' && s[j] != '>')
            ++j;
        t.type = Token::START;
        t.rawName = s.substr(i + 1, j - i - 1);
        t.name = lower(t.rawName);
        i = j;
        bool afterValue = false; // right after a quoted value: a space must come next
        while (true)
        {
            bool space = false;
            while (i < n && isWs(s[i]))
            {
                ++i;
                space = true;
            }
            if (i >= n)
            {
                report((int)start, tagWidth(t), true, "End of file inside a tag. Ignoring tag.");
                return false;
            }
            char c = s[i];
            if (c == '>')
            {
                ++i;
                return true;
            }
            if (c == '/')
            {
                if (i + 1 < n && s[i + 1] == '>')
                {
                    t.selfClosing = true;
                    i += 2;
                    return true;
                }
                report((int)i, 1, true, "A slash was not immediately followed by \">\".");
                ++i;
                afterValue = false;
                continue;
            }
            if (afterValue && !space)
                report((int)i, 1, true, "No space between attributes.");
            afterValue = false;
            Attr a;
            a.pos = (int)i;
            size_t k = i;
            if (s[k] == '=')
            {
                report((int)k, 1, true, "\"=\" at the start of an attribute name. Probable cause: Stray \"=\".");
                ++k;
            }
            while (k < n && !isWs(s[k]) && s[k] != '/' && s[k] != '>' && s[k] != '=')
            {
                if (s[k] == '"' || s[k] == '\'')
                    report((int)k, 1, true, "Quote in attribute name. Probable cause: Matching quote missing somewhere earlier.");
                else if (s[k] == '<')
                    report((int)k, 1, true, "\"<\" in attribute name. Probable cause: \">\" missing immediately before.");
                ++k;
            }
            a.rawName = s.substr(i, k - i);
            a.name = lower(a.rawName);
            i = k;
            size_t afterName = i;
            while (i < n && isWs(s[i]))
                ++i;
            if (i < n && s[i] == '=')
            {
                ++i;
                while (i < n && isWs(s[i]))
                    ++i;
                if (i >= n)
                {
                    report((int)start, tagWidth(t), true, "End of file inside a tag. Ignoring tag.");
                    return false;
                }
                if (s[i] == '"' || s[i] == '\'')
                {
                    char q = s[i++];
                    a.valuePos = (int)i;
                    while (i < n && s[i] != q)
                    {
                        if (s[i] == '&')
                        {
                            charRef(a.value, true);
                            continue;
                        }
                        if (s[i] == '\r')
                        {
                            a.value += '\n';
                            ++i;
                            if (i < n && s[i] == '\n')
                                ++i;
                            continue;
                        }
                        a.value += s[i++];
                    }
                    if (i >= n)
                    {
                        report((int)start, tagWidth(t), true, "End of file inside a tag. Ignoring tag.");
                        return false;
                    }
                    ++i;
                    afterValue = true;
                }
                else if (s[i] == '>')
                {
                    report((int)i, 1, true, "Attribute value missing.");
                    a.valuePos = (int)i;
                }
                else
                {
                    a.valuePos = (int)i;
                    bool warned = false;
                    while (i < n && !isWs(s[i]) && s[i] != '>')
                    {
                        char v = s[i];
                        if (!warned && (v == '"' || v == '\'' || v == '<' || v == '=' || v == '`'))
                        {
                            report((int)i, 1, true,
                                   std::string("\"") + v +
                                       "\" in an unquoted attribute value. Probable causes: Attributes running "
                                       "together or a URL query string in an unquoted attribute value.");
                            warned = true;
                        }
                        if (v == '&')
                        {
                            charRef(a.value, true);
                            continue;
                        }
                        a.value += v;
                        ++i;
                    }
                }
            }
            else
                i = afterName; // no value
            bool duplicate = false;
            for (const Attr &b : t.attrs)
                if (b.name == a.name)
                    duplicate = true;
            if (duplicate)
                report(a.pos, (int)a.name.size(), true, "Duplicate attribute \"" + a.name + "\".");
            else
                t.attrs.push_back(a);
        }
    }

    void charRef(std::string &out, bool inAttr)
    {
        size_t start = i;
        if (i + 1 < n && s[i + 1] == '#')
        {
            size_t j = i + 2;
            bool hex = j < n && (s[j] == 'x' || s[j] == 'X');
            if (hex)
                ++j;
            size_t digits = j;
            unsigned long long v = 0;
            while (j < n && (hex ? std::isxdigit((unsigned char)s[j]) : std::isdigit((unsigned char)s[j])))
            {
                int d = std::isdigit((unsigned char)s[j]) ? s[j] - '0' : std::tolower((unsigned char)s[j]) - 'a' + 10;
                if (v <= 0x10FFFF)
                    v = v * (hex ? 16 : 10) + (unsigned long long)d;
                ++j;
            }
            if (j == digits)
            {
                report((int)start, (int)(j - start), true,
                       "No digits in a numeric character reference. (\"&\" probably should have been escaped as \"&amp;\".)");
                out += '&';
                ++i;
                return;
            }
            if (j < n && s[j] == ';')
                ++j;
            else
                report((int)start, (int)(j - start), true, "Character reference was not terminated by a semicolon.");
            int width = (int)(j - start);
            unsigned cp = (unsigned)v;
            if (v == 0)
            {
                report((int)start, width, true, "Character reference expands to zero.");
                cp = 0xFFFD;
            }
            else if (v > 0x10FFFF)
            {
                report((int)start, width, true, "Character reference outside the permissible Unicode range.");
                cp = 0xFFFD;
            }
            else if (v >= 0xD800 && v <= 0xDFFF)
            {
                report((int)start, width, true, "Character reference expands to a surrogate.");
                cp = 0xFFFD;
            }
            else if (v >= 0x80 && v <= 0x9F)
            {
                report((int)start, width, true, "A numeric character reference expanded to the C1 controls range.");
                cp = windows1252(cp);
            }
            else if ((v < 0x20 && v != '\t' && v != '\n' && v != '\f') || v == 0x7F)
                report((int)start, width, true, "Character reference expands to a control character.");
            appendUtf8(out, cp);
            i = j;
            return;
        }
        const std::map<std::string, std::string> &table = entityMap();
        size_t j = i + 1, best = 0;
        for (size_t len = 1; len <= 32 && j + len <= n; ++len)
        {
            char c = s[j + len - 1];
            if (c == ';')
            {
                if (table.count(s.substr(j, len)))
                    best = len;
                break;
            }
            if (!std::isalnum((unsigned char)c))
                break;
            if (table.count(s.substr(j, len)))
                best = len;
        }
        if (best == 0)
        {
            size_t k = j;
            while (k < n && std::isalnum((unsigned char)s[k]))
                ++k;
            if (k > j && k < n && s[k] == ';')
                report((int)start, (int)(k + 1 - start), true,
                       "\"" + s.substr(start, k + 1 - start) +
                           "\" is not a character reference. (\"&\" probably should have been escaped as \"&amp;\".)");
            out += '&';
            ++i;
            return;
        }
        std::string name = s.substr(j, best);
        if (name.back() != ';')
        {
            char next = j + best < n ? s[j + best] : '\0';
            if (inAttr && (next == '=' || std::isalnum((unsigned char)next)))
            {
                out += '&'; // "?a=1&copy=2" in a URL stays as it is
                ++i;
                return;
            }
            report((int)start, (int)best + 1, true,
                   "Named character reference was not terminated by a semicolon. (Or \"&\" should have been escaped as \"&amp;\".)");
        }
        out += table.at(name);
        i = j + best;
    }

    // ── tree construction ────────────────────────────────────────────────

    Node *current() const { return open.empty() ? (htmlEl ? htmlEl : doc) : open.back(); }

    static void append(Node *parent, Node *child)
    {
        child->parent = parent;
        parent->kids.push_back(child);
    }

    static void appendText(Node *parent, const std::string &text)
    {
        if (text.empty())
            return;
        if (!parent->kids.empty() && !parent->kids.back()->element && !parent->kids.back()->comment)
        {
            parent->kids.back()->text += text;
            return;
        }
        Node *t = new Node();
        t->element = false;
        t->text = text;
        append(parent, t);
    }

    Node *insert(const Token &t, bool foreign)
    {
        Node *e = new Node();
        e->name = foreign ? t.rawName : t.name;
        e->attrs = t.attrs;
        if (foreign)
            for (Attr &a : e->attrs)
                a.name = a.rawName;
        e->foreign = foreign;
        e->pos = t.pos;
        append(current(), e);
        return e;
    }

    Node *insertImplied(const std::string &name, int pos)
    {
        Node *e = new Node();
        e->name = name;
        e->implied = true;
        e->pos = pos;
        append(current(), e);
        open.push_back(e);
        return e;
    }

    // the element's text is raw text up to its end tag
    void startRaw(Node *e, bool readRefs)
    {
        rawNode = e;
        rawEnd = e->name;
        rcdata = readRefs;
        e->contentPos = (int)i;
    }

    void mergeAttrs(Node *e, const Token &t)
    {
        if (!e)
            return;
        for (const Attr &a : t.attrs)
            if (!findAttr(e, a.name))
                e->attrs.push_back(a);
    }

    // a text token's leading whitespace: kept in `into` (or dropped); true
    // when nothing else is left
    static bool leadingSpace(Token &t, Node *into)
    {
        size_t k = 0;
        while (k < t.data.size() && isWs(t.data[k]))
            ++k;
        if (into && k)
            appendText(into, t.data.substr(0, k));
        t.data.erase(0, k);
        t.pos += (int)k;
        return t.data.empty();
    }

    static bool integrationPoint(const Node *e)
    {
        if (!e->foreign)
            return false;
        std::string nm = lower(e->name);
        return nm == "foreignobject" || nm == "desc" || nm == "title" || nm == "mi" || nm == "mo" || nm == "mn" ||
               nm == "ms" || nm == "mtext" || nm == "annotation-xml";
    }

    bool boundary(const Node *e, int scope) const
    {
        if (e->foreign)
            return integrationPoint(e);
        const std::string &nm = e->name;
        if (scope == S_TABLE)
            return nm == "html" || nm == "table" || nm == "template";
        if (nm == "applet" || nm == "caption" || nm == "html" || nm == "table" || nm == "td" || nm == "th" ||
            nm == "marquee" || nm == "object" || nm == "template")
            return true;
        if (scope == S_BUTTON)
            return nm == "button";
        if (scope == S_LIST)
            return nm == "ol" || nm == "ul";
        return false;
    }

    // the index of the open element `name` in scope, or -1
    int inScope(const std::string &name, int scope) const
    {
        for (size_t k = open.size(); k-- > 0;)
        {
            const Node *e = open[k];
            if (!e->foreign && e->name == name)
                return (int)k;
            if (boundary(e, scope))
                return -1;
        }
        return -1;
    }

    void unclosed(Node *e)
    {
        if (reported.count(e))
            return;
        reported.insert(e);
        report(e->pos, (int)e->name.size() + 1, true, "Unclosed element \"" + e->name + "\".");
    }

    // Closes open[k] and everything above it: what may be left open closes
    // silently, anything else is reported as unclosed
    void closeAt(size_t k, const Token &t, bool tableOk)
    {
        bool any = false;
        for (size_t m = open.size(); m-- > k + 1;)
        {
            Node *x = open[m];
            bool optional = x->implied || (!x->foreign && (impliedEnd().count(x->name) ||
                                                           (tableOk && tableParts().count(x->name))));
            if (!optional)
            {
                if (!any)
                    report(t.pos, tagWidth(t) + 1, true, "End tag \"" + t.name + "\" seen, but there were open elements.");
                any = true;
                unclosed(x);
            }
        }
        open.resize(k);
    }

    // what is still open where the body ends
    void openAtEnd(int pos, const std::string &message)
    {
        bool any = false;
        for (size_t k = open.size(); k-- > 0;)
        {
            Node *x = open[k];
            if (x->implied || reported.count(x) || (!x->foreign && openAtEndOk().count(x->name)))
                continue;
            if (!any)
                report(pos, 1, true, message);
            any = true;
            unclosed(x);
        }
    }

    // a start tag implies the end of an open "p"
    void closeP(const Token &t)
    {
        int k = inScope("p", S_BUTTON);
        if (k < 0)
            return;
        for (size_t m = open.size(); m-- > (size_t)k + 1;)
        {
            Node *x = open[m];
            if (!x->implied && !(!x->foreign && impliedEnd().count(x->name)))
            {
                report(t.pos, tagWidth(t), true, "Start tag \"" + t.name + "\" implied the end of \"p\", but there were open elements.");
                unclosed(x);
            }
        }
        open.resize((size_t)k);
    }

    // ends the head: what is still open in it (a noscript) is unclosed
    void closeHead()
    {
        while (!open.empty() && open.back() != headEl)
        {
            unclosed(open.back());
            open.pop_back();
        }
        if (!open.empty())
            open.pop_back();
        mode = AFTER_HEAD;
    }

    void strayEnd(const Token &t) { report(t.pos, tagWidth(t) + 1, true, "Stray end tag \"" + t.name + "\"."); }

    void strayStart(const Token &t) { report(t.pos, tagWidth(t), true, "Stray start tag \"" + t.name + "\"."); }

    bool tableContext(const Node *e) const
    {
        return !e->foreign && (e->name == "table" || e->name == "tbody" || e->name == "thead" ||
                               e->name == "tfoot" || e->name == "tr");
    }

    // Processes a token in the current insertion mode; false to process it
    // again in the mode it switched to
    bool step(Token &t)
    {
        if (rawNode)
        {
            // the text of a raw-text element, then its end tag
            if (t.type == Token::TEXT)
            {
                appendText(rawNode, t.data);
                return true;
            }
            bool closes = t.type == Token::END && t.name == rawNode->name;
            if (!open.empty() && open.back() == rawNode)
                open.pop_back();
            rawNode = nullptr;
            if (closes)
                return true;
        }
        if (t.type == Token::TEXT && t.data.empty())
            return true;
        if (t.type == Token::DOCTYPE)
        {
            if (mode != INITIAL)
            {
                report(t.pos, 9, true, "Stray doctype.");
                return true;
            }
            hasDoctype = true;
            doctypeName = t.name;
            bool legacy = !t.data.empty() && lower(t.data).find("about:legacy-compat") == std::string::npos;
            if (t.name.empty())
                report(t.pos, 9, true, "Missing doctype name. Expected \"<!DOCTYPE html>\".");
            else if (t.name != "html" || legacy)
                report(t.pos, 9, true, "Obsolete doctype. Expected \"<!DOCTYPE html>\".");
            mode = BEFORE_HTML;
            return true;
        }
        if (t.type == Token::COMMENT)
        {
            Node *c = new Node();
            c->element = false;
            c->comment = true;
            c->text = t.data;
            if (mode == INITIAL || mode == BEFORE_HTML || mode == AFTER_AFTER_BODY)
                append(doc, c);
            else if (mode == AFTER_BODY)
                append(htmlEl, c);
            else
                append(current(), c);
            return true;
        }
        const bool start = t.type == Token::START, end = t.type == Token::END;
        const std::string &nm = t.name;
        switch (mode)
        {
        case INITIAL:
            if (t.type == Token::TEXT && leadingSpace(t, nullptr))
                return true;
            if (t.type == Token::TEXT)
                report(t.pos, 1, false, "Non-space characters found without seeing a doctype first. Expected \"<!DOCTYPE html>\".");
            else if (start)
                report(t.pos, tagWidth(t), false, "Start tag seen without seeing a doctype first. Expected \"<!DOCTYPE html>\".");
            else if (end)
                report(t.pos, tagWidth(t), false, "End tag seen without seeing a doctype first. Expected \"<!DOCTYPE html>\".");
            mode = BEFORE_HTML;
            return false;

        case BEFORE_HTML:
            if (t.type == Token::TEXT && leadingSpace(t, nullptr))
                return true;
            if (start && nm == "html")
            {
                htmlEl = insert(t, false);
                open.push_back(htmlEl);
                explicitHtml = true;
                mode = BEFORE_HEAD;
                return true;
            }
            if (end && nm != "head" && nm != "body" && nm != "html" && nm != "br")
            {
                strayEnd(t);
                return true;
            }
            htmlEl = insertImplied("html", t.pos);
            mode = BEFORE_HEAD;
            return false;

        case BEFORE_HEAD:
            if (t.type == Token::TEXT && leadingSpace(t, nullptr))
                return true;
            if (start && nm == "html")
            {
                strayStart(t);
                mergeAttrs(htmlEl, t);
                return true;
            }
            if (start && nm == "head")
            {
                headEl = insert(t, false);
                open.push_back(headEl);
                explicitHead = true;
                mode = IN_HEAD;
                return true;
            }
            if (end && nm != "head" && nm != "body" && nm != "html" && nm != "br")
            {
                strayEnd(t);
                return true;
            }
            headEl = insertImplied("head", t.pos);
            mode = IN_HEAD;
            return false;

        case IN_HEAD:
            if (t.type == Token::TEXT && leadingSpace(t, current()))
                return true;
            if (start)
            {
                if (nm == "html")
                {
                    strayStart(t);
                    mergeAttrs(htmlEl, t);
                    return true;
                }
                if (nm == "base" || nm == "basefont" || nm == "bgsound" || nm == "link" || nm == "meta")
                {
                    obsoleteCheck(t);
                    insert(t, false);
                    return true;
                }
                if (nm == "title" || nm == "style" || nm == "script" || nm == "noframes")
                {
                    obsoleteCheck(t);
                    Node *e = insert(t, false);
                    open.push_back(e);
                    startRaw(e, nm == "title");
                    return true;
                }
                if (nm == "noscript" || nm == "template")
                {
                    open.push_back(insert(t, false));
                    return true;
                }
                if (nm == "head")
                {
                    report(t.pos, tagWidth(t), true, "Start tag \"head\" seen but an element of the same type was already open.");
                    return true;
                }
            }
            if (end)
            {
                if (nm == "head")
                {
                    closeHead();
                    return true;
                }
                if (current() != headEl && current()->name == nm)
                {
                    open.pop_back();
                    return true;
                }
                if (nm != "body" && nm != "html" && nm != "br")
                {
                    strayEnd(t);
                    return true;
                }
            }
            closeHead();
            return false;

        case AFTER_HEAD:
            if (t.type == Token::TEXT && leadingSpace(t, current()))
                return true;
            if (start)
            {
                if (nm == "html")
                {
                    strayStart(t);
                    mergeAttrs(htmlEl, t);
                    return true;
                }
                if (nm == "body")
                {
                    bodyEl = insert(t, false);
                    open.push_back(bodyEl);
                    mode = IN_BODY;
                    return true;
                }
                if (nm == "base" || nm == "basefont" || nm == "bgsound" || nm == "link" || nm == "meta" ||
                    nm == "noframes" || nm == "script" || nm == "style" || nm == "template" || nm == "title")
                {
                    report(t.pos, tagWidth(t), true, "\"" + nm + "\" element between \"head\" and \"body\".");
                    open.push_back(headEl);
                    mode = IN_HEAD;
                    return false;
                }
                if (nm == "head")
                {
                    strayStart(t);
                    return true;
                }
            }
            if (end && nm != "body" && nm != "html" && nm != "br")
            {
                strayEnd(t);
                return true;
            }
            bodyEl = insertImplied("body", t.pos);
            mode = IN_BODY;
            return false;

        case IN_BODY:
            return inBody(t);

        case AFTER_BODY:
        case AFTER_AFTER_BODY:
            if (t.type == Token::TEXT)
            {
                if (leadingSpace(t, bodyEl ? bodyEl : current()))
                    return true;
                report(t.pos, 1, true, "Non-space character after body.");
                mode = IN_BODY;
                return false;
            }
            if (t.type == Token::END_OF_FILE)
                return true;
            if (start && nm == "html")
                return inBody(t);
            if (end && nm == "html" && mode == AFTER_BODY)
            {
                mode = AFTER_AFTER_BODY;
                return true;
            }
            if (start)
                strayStart(t);
            else
                strayEnd(t);
            mode = IN_BODY;
            return false;
        }
        return true;
    }

    void obsoleteCheck(const Token &t)
    {
        auto o = obsoleteElements().find(t.name);
        if (o != obsoleteElements().end())
            report(t.pos, tagWidth(t), false, "The \"" + t.name + "\" element is obsolete. " + o->second);
    }

    bool inBody(Token &t)
    {
        Node *cur = current();
        bool foreignContext = cur->foreign && !integrationPoint(cur);
        switch (t.type)
        {
        case Token::TEXT:
            if (!foreignContext && tableContext(cur) && t.data.find_first_not_of(" \t\n\r\f") != std::string::npos)
                report(t.pos, 1, true, "Misplaced non-space characters inside a table.");
            appendText(cur, t.data);
            return true;
        case Token::END_OF_FILE:
            openAtEnd((int)n, "End of file seen and there were open elements.");
            return true;
        case Token::START:
            return foreignContext ? foreignStart(t) : bodyStart(t);
        case Token::END:
            return cur->foreign ? foreignEnd(t) : bodyEnd(t);
        default:
            return true;
        }
    }

    bool foreignStart(Token &t)
    {
        bool out = breakout().count(t.name) > 0;
        if (t.name == "font")
            for (const Attr &a : t.attrs)
                if (a.name == "color" || a.name == "face" || a.name == "size")
                    out = true;
        if (out)
        {
            report(t.pos, tagWidth(t), true, "HTML start tag \"" + t.name + "\" in a foreign namespace context.");
            while (!open.empty() && open.back()->foreign && !integrationPoint(open.back()))
                open.pop_back();
            return false;
        }
        Node *e = insert(t, true);
        if (!t.selfClosing)
            open.push_back(e);
        return true;
    }

    bool foreignEnd(Token &t)
    {
        for (size_t k = open.size(); k-- > 0;)
        {
            Node *e = open[k];
            if (!e->foreign)
                return bodyEnd(t);
            if (lower(e->name) == t.name)
            {
                closeAt(k, t, false);
                return true;
            }
        }
        return true;
    }

    int tableIndex() const
    {
        for (size_t k = open.size(); k-- > 0;)
        {
            const Node *x = open[k];
            if (!x->foreign && x->name == "table")
                return (int)k;
            if (!x->foreign && (x->name == "html" || x->name == "template"))
                return -1;
        }
        return -1;
    }

    // pops what is above the table back to an element named in `stop`
    void popInTable(int table, const std::set<std::string> &stop)
    {
        while ((int)open.size() - 1 > table)
        {
            Node *x = open.back();
            if (!x->foreign && stop.count(x->name))
                return;
            if (!x->implied && (x->foreign || !(tableParts().count(x->name) || impliedEnd().count(x->name))))
                unclosed(x);
            open.pop_back();
        }
    }

    bool tableStart(const Token &t)
    {
        const std::string &nm = t.name;
        int table = tableIndex();
        if (table < 0)
        {
            strayStart(t);
            return true;
        }
        static const std::set<std::string> none;
        static const std::set<std::string> colgroup = words("colgroup");
        static const std::set<std::string> sections = words("tbody thead tfoot");
        static const std::set<std::string> rows = words("tr tbody thead tfoot");
        if (nm == "caption" || nm == "colgroup" || nm == "tbody" || nm == "thead" || nm == "tfoot")
        {
            popInTable(table, none);
            open.push_back(insert(t, false));
            return true;
        }
        if (nm == "col")
        {
            popInTable(table, colgroup);
            if (current()->name != "colgroup")
                insertImplied("colgroup", t.pos);
            insert(t, false);
            return true;
        }
        if (nm == "tr")
        {
            popInTable(table, sections);
            if (current()->name == "table")
                insertImplied("tbody", t.pos);
            open.push_back(insert(t, false));
            return true;
        }
        // td, th
        popInTable(table, rows);
        if (current()->name == "table")
            insertImplied("tbody", t.pos);
        if (current()->name != "tr")
            insertImplied("tr", t.pos);
        open.push_back(insert(t, false));
        return true;
    }

    bool bodyStart(Token &t)
    {
        std::string nm = t.name;
        if (nm == "html")
        {
            strayStart(t);
            mergeAttrs(htmlEl, t);
            return true;
        }
        if (nm == "body")
        {
            report(t.pos, tagWidth(t), true, "Start tag \"body\" seen but an element of the same type was already open.");
            mergeAttrs(bodyEl, t);
            return true;
        }
        if (nm == "head" || nm == "frameset")
        {
            strayStart(t);
            return true;
        }
        if (nm == "title" || nm == "base")
            report(t.pos, tagWidth(t), true, "Element \"" + nm + "\" not allowed as child of element \"body\" in this context.");
        if (tableParts().count(nm))
            return tableStart(t);
        if (nm == "table" && !current()->foreign && current()->name == "table")
        {
            report(t.pos, tagWidth(t), true, "Start tag \"table\" seen but the previous \"table\" is still open.");
            open.pop_back();
        }
        if (nm == "li" || nm == "dd" || nm == "dt")
            closeListItem(t);
        if (closesP().count(nm))
            closeP(t);
        if (heading(nm) && !current()->foreign && heading(current()->name))
        {
            report(t.pos, tagWidth(t), true, "Heading cannot be a child of another heading.");
            open.pop_back();
        }
        if (nm == "a" || nm == "nobr")
            for (size_t k = open.size(); k-- > 0;)
            {
                Node *x = open[k];
                if (!x->foreign && x->name == nm)
                {
                    report(t.pos, tagWidth(t), true, "An \"" + nm + "\" start tag seen but an element of the same type was already open.");
                    open.resize(k);
                    break;
                }
                if (!x->foreign && (x->name == "table" || x->name == "td" || x->name == "th" ||
                                    x->name == "caption" || x->name == "html" || x->name == "template"))
                    break;
            }
        if (nm == "form")
            for (const Node *x : open)
                if (!x->foreign && x->name == "form")
                {
                    report(t.pos, tagWidth(t), true,
                           "Saw a \"form\" start tag, but there was already an active \"form\" element. Nested forms "
                           "are not allowed. Ignoring the tag.");
                    return true;
                }
        if (nm == "button")
        {
            int k = inScope("button", S_DEFAULT);
            if (k >= 0)
            {
                report(t.pos, tagWidth(t), true, "Start tag \"button\" seen but an element of the same type was already open.");
                open.resize((size_t)k);
            }
        }
        if (nm == "option" && current()->name == "option")
            open.pop_back();
        if (nm == "optgroup")
        {
            if (current()->name == "option")
                open.pop_back();
            if (current()->name == "optgroup")
                open.pop_back();
        }
        if (nm == "rb" || nm == "rtc" || nm == "rp" || nm == "rt")
            while (!current()->foreign && impliedEnd().count(current()->name) &&
                   !((nm == "rp" || nm == "rt") && current()->name == "rtc"))
                open.pop_back();
        if (nm == "image")
        {
            obsoleteCheck(t);
            t.name = nm = "img";
        }
        if (nm == "svg" || nm == "math")
        {
            Node *e = insert(t, true);
            if (!t.selfClosing)
                open.push_back(e);
            return true;
        }
        if (!knownElements().count(nm) && nm.find('-') == std::string::npos)
            report(t.pos, tagWidth(t), true,
                   "Unknown element \"" + nm + "\". (A custom element's name must contain a hyphen, like \"my-" + nm + "\".)");
        else
            obsoleteCheck(t);
        if (tableContext(current()) && nm != "script" && nm != "style" && nm != "template" && nm != "form" &&
            nm != "input")
            report(t.pos, tagWidth(t), true, "Start tag \"" + nm + "\" seen in \"" + current()->name + "\".");
        bool isVoid = voidElements().count(nm) > 0;
        if (t.selfClosing && !isVoid)
            report(t.pos, tagWidth(t), true,
                   "Self-closing syntax (\"/>\") used on a non-void HTML element. Ignoring the slash and treating as a "
                   "start tag.");
        Node *e = insert(t, false);
        if (isVoid)
            return true;
        open.push_back(e);
        if (rawText().count(nm))
            startRaw(e, false);
        if (nm == "plaintext")
            plaintext = true;
        if (nm == "title" || nm == "textarea")
            startRaw(e, true);
        if (nm == "pre" || nm == "listing" || nm == "textarea")
            skipNewline = true;
        return true;
    }

    // <li> ends an open li; <dd> and <dt> end an open dd or dt
    void closeListItem(const Token &t)
    {
        for (size_t k = open.size(); k-- > 0;)
        {
            Node *x = open[k];
            bool match = !x->foreign && (t.name == "li" ? x->name == "li" : (x->name == "dd" || x->name == "dt"));
            if (match)
            {
                for (size_t m = open.size(); m-- > k + 1;)
                    if (!open[m]->implied && !(!open[m]->foreign && impliedEnd().count(open[m]->name)))
                    {
                        report(t.pos, tagWidth(t), true, "Start tag \"" + t.name + "\" implied the end of \"" + x->name +
                                                             "\", but there were open elements.");
                        unclosed(open[m]);
                    }
                open.resize(k);
                return;
            }
            if (!x->foreign && specialElements().count(x->name) && x->name != "address" && x->name != "div" &&
                x->name != "p")
                return;
        }
    }

    bool bodyEnd(Token &t)
    {
        const std::string &nm = t.name;
        if (nm == "body" || nm == "html")
        {
            if (inScope("body", S_DEFAULT) < 0)
            {
                strayEnd(t);
                return true;
            }
            openAtEnd(t.pos, "End tag for \"body\" seen, but there were unclosed elements.");
            mode = AFTER_BODY;
            return nm == "body";
        }
        if (nm == "p")
        {
            int k = inScope("p", S_BUTTON);
            if (k < 0)
            {
                report(t.pos, tagWidth(t) + 1, true, "No \"p\" element in scope but a \"p\" end tag seen.");
                insertImplied("p", t.pos);
                k = (int)open.size() - 1;
            }
            closeAt((size_t)k, t, false);
            return true;
        }
        if (nm == "li" || nm == "dd" || nm == "dt")
        {
            int k = inScope(nm, nm == "li" ? S_LIST : S_DEFAULT);
            if (k < 0)
            {
                report(t.pos, tagWidth(t) + 1, true,
                       "No \"" + nm + "\" element in " + (nm == "li" ? "list " : "") + "scope but a \"" + nm + "\" end tag seen.");
                return true;
            }
            closeAt((size_t)k, t, false);
            return true;
        }
        if (heading(nm))
        {
            for (size_t k = open.size(); k-- > 0;)
            {
                Node *x = open[k];
                if (!x->foreign && heading(x->name))
                {
                    closeAt(k, t, false);
                    return true;
                }
                if (boundary(x, S_DEFAULT))
                    break;
            }
            strayEnd(t);
            return true;
        }
        if (nm == "br")
        {
            report(t.pos, 4, true, "End tag \"br\".");
            Token br = t;
            br.type = Token::START;
            br.attrs.clear();
            insert(br, false);
            return true;
        }
        if (voidElements().count(nm))
        {
            strayEnd(t);
            return true;
        }
        if (nm == "table" || tableParts().count(nm))
        {
            int k = inScope(nm, S_TABLE);
            if (k < 0)
                strayEnd(t);
            else
                closeAt((size_t)k, t, true);
            return true;
        }
        if (blockEnds().count(nm) || nm == "form" || nm == "applet" || nm == "marquee" || nm == "object")
        {
            int k = inScope(nm, S_DEFAULT);
            if (k < 0)
                strayEnd(t);
            else
                closeAt((size_t)k, t, false);
            return true;
        }
        for (size_t k = open.size(); k-- > 0;)
        {
            Node *x = open[k];
            if (!x->foreign && x->name == nm)
            {
                closeAt(k, t, false);
                return true;
            }
            if (!x->foreign && specialElements().count(x->name))
                break;
        }
        strayEnd(t);
        return true;
    }

    // html, head and body exist even when the page left their tags out
    void finish()
    {
        if (!htmlEl)
        {
            htmlEl = new Node();
            htmlEl->name = "html";
            htmlEl->implied = true;
            htmlEl->pos = (int)n;
            append(doc, htmlEl);
        }
        if (!headEl)
        {
            headEl = new Node();
            headEl->name = "head";
            headEl->implied = true;
            headEl->pos = (int)n;
            headEl->parent = htmlEl;
            htmlEl->kids.insert(htmlEl->kids.begin(), headEl);
        }
        if (!bodyEl)
        {
            bodyEl = new Node();
            bodyEl->name = "body";
            bodyEl->implied = true;
            bodyEl->pos = (int)n;
            append(htmlEl, bodyEl);
        }
    }
};

// ── the page: checks, stylesheets, output ────────────────────────────────

void escape(std::string &out, const std::string &text, bool attr)
{
    for (size_t k = 0; k < text.size(); ++k)
    {
        unsigned char c = (unsigned char)text[k];
        if (c == '&')
            out += "&amp;";
        else if (c == 0xC2 && k + 1 < text.size() && (unsigned char)text[k + 1] == 0xA0)
        {
            out += "&nbsp;";
            ++k;
        }
        else if (c == '<')
            out += "&lt;";
        else if (c == '>')
            out += "&gt;";
        else if (attr && c == '"')
            out += "&quot;";
        else
            out += (char)c;
    }
}

void serialize(std::string &out, const Node *x)
{
    if (x->comment)
    {
        out += "<!--" + x->text + "-->";
        return;
    }
    if (!x->element)
    {
        const Node *p = x->parent;
        if (p && !p->foreign && rawText().count(p->name))
            out += x->text;
        else
            escape(out, x->text, false);
        return;
    }
    out += "<" + x->name;
    for (const Attr &a : x->attrs)
    {
        out += " " + a.name + "=\"";
        escape(out, a.value, true);
        out += "\"";
    }
    out += ">";
    if (!x->foreign && voidElements().count(x->name))
        return;
    if (!x->foreign && (x->name == "pre" || x->name == "textarea" || x->name == "listing") && !x->kids.empty() &&
        !x->kids[0]->element && !x->kids[0]->comment && !x->kids[0]->text.empty() && x->kids[0]->text[0] == '\n')
        out += "\n";
    for (const Node *k : x->kids)
        serialize(out, k);
    out += "</" + x->name + ">";
}

bool readFile(const fs::path &file, std::string &text)
{
    std::ifstream in(file, std::ios::binary);
    if (!in)
        return false;
    std::ostringstream ss;
    ss << in.rdbuf();
    text = ss.str();
    if (text.size() >= 3 && (unsigned char)text[0] == 0xEF && (unsigned char)text[1] == 0xBB &&
        (unsigned char)text[2] == 0xBF)
        text.erase(0, 3);
    return true;
}

std::string newlines(const std::string &text)
{
    std::string out;
    for (size_t k = 0; k < text.size(); ++k)
        if (text[k] == '\r')
        {
            out += '\n';
            if (k + 1 < text.size() && text[k + 1] == '\n')
                ++k;
        }
        else
            out += text[k];
    return out;
}

std::string pathKey(const fs::path &p) { return lower(p.lexically_normal().generic_string()); }

class Page
{
public:
    Page(const std::string &source, const std::string &path) : source(source), path(path), parser(source) {}

    Result run(const std::vector<std::string> &extraSheets)
    {
        Node *doc = parser.parse();
        if (parser.explicitHtml && !findAttr(parser.htmlEl, "lang"))
            parser.report(parser.htmlEl->pos, 5, false,
                          "Consider adding a \"lang\" attribute to the \"html\" start tag to declare the language of "
                          "this document.");
        if ((parser.hasDoctype || parser.explicitHead) && !hasChild(parser.headEl, "title"))
            parser.report(parser.headEl->pos, parser.headEl->implied ? 1 : 5, false,
                          "Element \"head\" is missing a required instance of child element \"title\".");
        visit(doc);
        for (const std::string &sheet : extraSheets)
        {
            fs::path file(sheet);
            if (linked.count(pathKey(file)))
                continue;
            std::string text;
            if (!readFile(file, text))
            {
                sheetReports += sheet + ": error: cannot read the stylesheet.\n";
                failed = true;
                continue;
            }
            std::vector<css::Problem> problems;
            css::compileStylesheet(text, problems);
            sheetReport(file.generic_string(), text, problems);
            Node *style = new Node();
            style->name = "style";
            style->parent = parser.headEl;
            Node *t = new Node();
            t->element = false;
            t->text = newlines(text);
            t->parent = style;
            style->kids.push_back(t);
            parser.headEl->kids.push_back(style);
        }

        Result r;
        std::vector<Diag> diags = parser.diags;
        std::stable_sort(diags.begin(), diags.end(), [](const Diag &a, const Diag &b) {
            return a.line != b.line ? a.line < b.line : a.col < b.col;
        });
        for (const Diag &d : diags)
        {
            r.report += diag::gcc(path, source, d.line, d.col, d.message, d.width, d.error ? "error" : "warning");
            if (d.error)
                failed = true;
        }
        r.report += sheetReports;
        r.failed = failed;
        if (parser.hasDoctype)
            r.output = "<!DOCTYPE " + (parser.doctypeName.empty() ? std::string("html") : parser.doctypeName) + ">\n";
        for (size_t k = 0; k < doc->kids.size(); ++k)
        {
            if (k)
                r.output += "\n";
            serialize(r.output, doc->kids[k]);
        }
        return r;
    }

private:
    const std::string &source;
    std::string path;
    Parser parser;
    std::set<std::string> ids;
    std::set<std::string> linked; // stylesheets inlined so far
    std::string sheetReports;
    bool failed = false;

    static bool hasChild(const Node *e, const std::string &name)
    {
        for (const Node *k : e->kids)
            if (k->element && !k->foreign && k->name == name)
                return true;
        return false;
    }

    // a stylesheet's problems, at their place in the page (`base`: where the CSS text starts)
    void cssInPage(const std::vector<css::Problem> &problems, int base)
    {
        int line, col;
        parser.lineCol(base, line, col);
        for (const css::Problem &p : problems)
        {
            Diag d;
            d.line = line + p.line - 1;
            d.col = p.line == 1 ? col + p.col - 1 : p.col;
            d.width = p.width;
            d.error = p.error;
            d.message = p.message;
            parser.diags.push_back(d);
        }
    }

    void sheetReport(const std::string &file, const std::string &text, const std::vector<css::Problem> &problems)
    {
        for (const css::Problem &p : problems)
        {
            sheetReports += diag::gcc(file, text, p.line, p.col, p.message, p.width, p.error ? "error" : "warning");
            if (p.error)
                failed = true;
        }
    }

    static std::string textOf(const Node *e)
    {
        std::string out;
        for (const Node *k : e->kids)
            if (!k->element && !k->comment)
                out += k->text;
        return out;
    }

    void visit(Node *x)
    {
        if (!x->element)
            return;
        if (x->name != "#document")
        {
            for (const Attr &a : x->attrs)
            {
                if (a.name == "id" && !a.value.empty() && !x->foreign)
                {
                    if (ids.count(a.value))
                        parser.report(a.pos, 2, true, "Duplicate ID \"" + a.value + "\".");
                    ids.insert(a.value);
                }
                if (a.name == "style" && a.valuePos >= 0)
                {
                    std::vector<css::Problem> problems;
                    css::checkDeclarations(a.value, problems);
                    cssInPage(problems, a.valuePos);
                }
            }
            if (!x->foreign && x->name == "img" && !findAttr(x, "alt"))
                parser.report(x->pos, 4, false, "An \"img\" element must have an \"alt\" attribute, except under certain conditions.");
            if (lower(x->name) == "style")
            {
                std::vector<css::Problem> problems;
                css::compileStylesheet(textOf(x), problems);
                cssInPage(problems, x->contentPos >= 0 ? x->contentPos : x->pos);
            }
            if (!x->foreign && x->name == "link")
                inlineStylesheet(x);
        }
        for (size_t k = 0; k < x->kids.size(); ++k)
            visit(x->kids[k]);
    }

    // <link rel="stylesheet" href="local.css"> becomes <style> with the file in it
    void inlineStylesheet(Node *x)
    {
        const Attr *rel = findAttr(x, "rel");
        const Attr *href = findAttr(x, "href");
        if (!rel || !href || href->value.empty())
            return;
        std::istringstream in(lower(rel->value));
        std::string token;
        bool sheet = false;
        while (in >> token)
            if (token == "stylesheet")
                sheet = true;
        const std::string &url = href->value;
        if (!sheet || url.find("://") != std::string::npos || url.compare(0, 2, "//") == 0 ||
            url.compare(0, 5, "data:") == 0)
            return;
        fs::path file = fs::path(path).parent_path() / url.substr(0, url.find_first_of("?#"));
        std::string text;
        if (!readFile(file, text))
        {
            parser.report(x->pos, 5, true, "Stylesheet \"" + url + "\" not found.");
            return;
        }
        linked.insert(pathKey(file));
        std::vector<css::Problem> problems;
        css::compileStylesheet(text, problems);
        sheetReport(file.generic_string(), text, problems);
        std::vector<Attr> keep;
        for (const Attr &a : x->attrs)
            if (a.name == "media")
                keep.push_back(a);
        x->name = "style";
        x->attrs = keep;
        Node *t = new Node();
        t->element = false;
        t->text = newlines(text);
        t->parent = x;
        x->kids.clear();
        x->kids.push_back(t);
    }
};

} // namespace

Result compile(const std::string &source, const std::string &path, const std::vector<std::string> &extraSheets)
{
    Page page(source, path);
    return page.run(extraSheets);
}

bool looksLikePage(const std::string &source)
{
    size_t k = 0;
    if (source.size() >= 3 && (unsigned char)source[0] == 0xEF && (unsigned char)source[1] == 0xBB &&
        (unsigned char)source[2] == 0xBF)
        k = 3;
    while (k < source.size() && isWs(source[k]))
        ++k;
    if (k >= source.size() || source[k] != '<')
        return false;
    if (source.compare(k, 4, "<!--") == 0)
        return true;
    if (lower(source.substr(k, 9)) == "<!doctype")
        return true;
    size_t j = k + 1;
    while (j < source.size() && std::isalnum((unsigned char)source[j]))
        ++j;
    std::string name = lower(source.substr(k + 1, j - k - 1));
    return !name.empty() && std::isalpha((unsigned char)name[0]) && knownElements().count(name) > 0;
}

} // namespace html
