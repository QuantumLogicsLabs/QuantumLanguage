// quantum: cpp
// HTML front-end: reads a page the way a browser does (the WHATWG tokenizer;
// tree construction with implied and optional tags, raw-text elements,
// tables and SVG/MathML, simplified from the standard), checks it the way a
// validator does (messages worded as the W3C checker words them), checks its
// CSS (src/css), and writes the document back out as a browser holds it,
// with the local stylesheets it links inlined.
#include "HtmlMain.h.sa"
#include "HtmlEntities.h.sa"
#include "../css/CssMain.h.sa"
#include "Diagnostics.h.sa"

#include <algorithm>
#include <cctype>
#include <filesystem>
#include <fstream>
#include <map>
#include <set>
#include <sstream>

namespace fs = std::filesystem;

namespace html
{

namespace
{

std::set<std::string> words(const char *text)
{
    std::set<std::string> out;
    std::istringstream in(text);
    std::string w;
    while (in >> w)
        out.insert(w);
    return out;
}

bool isWs(char c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f'; }

std::string lower(const std::string &s)
{
    std::string out = s;
    for (char &c : out)
        c = (char)std::tolower((unsigned char)c);
    return out;
}

const std::set<std::string> &voidElements()
{
    static const std::set<std::string> s =
        words("area base br col embed hr img input link meta source track wbr param keygen basefont bgsound frame");
    return s;
}

const std::set<std::string> &knownElements()
{
    static const std::set<std::string> s = words(
        "a abbr address area article aside audio b base bdi bdo blockquote body br button canvas caption cite "
        "code col colgroup data datalist dd del details dfn dialog div dl dt em embed fencedframe fieldset "
        "figcaption figure footer form h1 h2 h3 h4 h5 h6 head header hgroup hr html i iframe img input ins kbd "
        "label legend li link main map mark menu meta meter nav noscript object ol optgroup option output p "
        "param picture pre progress q rp rt ruby s samp script search section select selectedcontent slot small "
        "source span strong style sub summary sup table tbody td template textarea tfoot th thead time title tr "
        "track u ul var video wbr svg math "
        // obsolete, but still parsed
        "acronym applet basefont bgsound big blink center dir font frame frameset image isindex keygen listing "
        "marquee menuitem multicol nextid nobr noembed noframes plaintext rb rtc spacer strike tt xmp");
    return s;
}

// obsolete elements: what to use instead
const std::map<std::string, std::string> &obsoleteElements()
{
    static std::map<std::string, std::string> m;
    if (m.empty())
    {
        for (const std::string &e : words("basefont big blink center font marquee multicol nobr spacer tt"))
            m[e] = "Use CSS instead.";
        m["acronym"] = "Use the \"abbr\" element instead.";
        m["applet"] = "Use the \"embed\" or \"object\" element instead.";
        m["bgsound"] = "Use the \"audio\" element instead.";
        m["dir"] = "Use the \"ul\" element instead.";
        m["frame"] = m["frameset"] = m["noframes"] = "Use the \"iframe\" element and CSS instead.";
        m["isindex"] = "Use an explicit \"form\" and text field instead.";
        m["keygen"] = "Generate keys in JavaScript (the Web Crypto API) instead.";
        m["listing"] = m["plaintext"] = m["xmp"] = "Use the \"pre\" or \"code\" element instead.";
        m["menuitem"] = "Use script to handle a context menu instead.";
        m["nextid"] = "Use GUIDs instead.";
        m["noembed"] = "Use the \"object\" element instead.";
        m["rb"] = m["rtc"] = "Mark up the base text directly in the \"ruby\" element.";
        m["strike"] = "Use the \"del\" or \"s\" element instead.";
        m["image"] = "Use the \"img\" element instead.";
    }
    return m;
}

