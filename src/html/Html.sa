// quantum: cpp
// HTML front-end: compiles a page. HtmlTokenizer.sa and HtmlTree.sa parse it
// exactly as the WHATWG HTML standard says, so the document is the tree a
// browser builds; this file checks that document the way a validator does
// (messages worded as the W3C checker words them), checks its CSS (src/css),
// inlines the local stylesheets it links, and writes the document back out
// with the standard's serialization algorithm (13.3). It also runs the
// web-platform-tests tree construction tests and the html5lib tokenizer
// tests (hidden qrun flags), which is how the parser is held to the standard.
#include "HtmlMain.h.sa"
#include "HtmlDom.h.sa"
#include "../css/CssMain.h.sa"
#include "Diagnostics.h.sa"

#include <algorithm>
#include <cctype>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <map>
#include <set>
#include <sstream>

namespace fs = std::filesystem;

namespace html
{

namespace
{

std::set<std::string> words(const char *text)
{
    std::set<std::string> out;
    std::istringstream in(text);
    std::string w;
    while (in >> w)
        out.insert(w);
    return out;
}

bool isWs(char c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f'; }

std::string lower(const std::string &s)
{
    std::string out = s;
    for (char &c : out)
        c = (char)std::tolower((unsigned char)c);
    return out;
}

// elements that serialize as void (13.3)
const std::set<std::string> &voidElements()
{
    static const std::set<std::string> s =
        words("area base br col embed hr img input link meta source track wbr basefont bgsound frame keygen param");
    return s;
}

const std::set<std::string> &knownElements()
{
    static const std::set<std::string> s = words(
        "a abbr address area article aside audio b base bdi bdo blockquote body br button canvas caption cite "
        "code col colgroup data datalist dd del details dfn dialog div dl dt em embed fencedframe fieldset "
        "figcaption figure footer form h1 h2 h3 h4 h5 h6 head header hgroup hr html i iframe img input ins kbd "
        "label legend li link main map mark menu meta meter nav noscript object ol optgroup option output p "
        "param picture pre progress q rp rt ruby s samp script search section select selectedcontent slot small "
        "source span strong style sub summary sup table tbody td template textarea tfoot th thead time title tr "
        "track u ul var video wbr svg math "
        // obsolete, but still parsed
        "acronym applet basefont bgsound big blink center dir font frame frameset image isindex keygen listing "
        "marquee menuitem multicol nextid nobr noembed noframes plaintext rb rtc spacer strike tt xmp");
    return s;
}

// obsolete elements: what to use instead
const std::map<std::string, std::string> &obsoleteElements()
{
    static std::map<std::string, std::string> m;
    if (m.empty())
    {
        for (const std::string &e : words("basefont big blink center font marquee multicol nobr spacer tt"))
            m[e] = "Use CSS instead.";
        m["acronym"] = "Use the \"abbr\" element instead.";
        m["applet"] = "Use the \"embed\" or \"object\" element instead.";
        m["bgsound"] = "Use the \"audio\" element instead.";
        m["dir"] = "Use the \"ul\" element instead.";
        m["frame"] = m["frameset"] = m["noframes"] = "Use the \"iframe\" element and CSS instead.";
        m["isindex"] = "Use an explicit \"form\" and text field instead.";
        m["keygen"] = "Generate keys in JavaScript (the Web Crypto API) instead.";
        m["listing"] = m["plaintext"] = m["xmp"] = "Use the \"pre\" or \"code\" element instead.";
        m["menuitem"] = "Use script to handle a context menu instead.";
        m["nextid"] = "Use GUIDs instead.";
        m["noembed"] = "Use the \"object\" element instead.";
        m["rb"] = m["rtc"] = "Mark up the base text directly in the \"ruby\" element.";
        m["strike"] = "Use the \"del\" or \"s\" element instead.";
    }
    return m;
}

// ── serialization (13.3) ─────────────────────────────────────────────────

void escape(std::string &out, const std::string &text, bool attr)
{
    for (size_t k = 0; k < text.size(); ++k)
    {
        unsigned char c = (unsigned char)text[k];
        if (c == '&')
            out += "&amp;";
        else if (c == 0xC2 && k + 1 < text.size() && (unsigned char)text[k + 1] == 0xA0)
        {
            out += "&nbsp;";
            ++k;
        }
        else if (c == '<')
            out += "&lt;";
        else if (c == '>')
            out += "&gt;";
        else if (attr && c == '"')
            out += "&quot;";
        else
            out += (char)c;
    }
}

std::string attrName(const Attr &a)
{
    if (a.ns == AN_XML)
        return "xml:" + a.name;
    if (a.ns == AN_XMLNS)
        return a.name == "xmlns" ? a.name : "xmlns:" + a.name;
    if (a.ns == AN_XLINK)
        return "xlink:" + a.name;
    return a.name;
}

bool servesVoid(const Node *x) { return x->ns == NS_HTML && voidElements().count(x->name) > 0; }

void serializeChildren(std::string &out, const Node *x, bool scripting);

void serializeNode(std::string &out, const Node *x, bool scripting)
{
    switch (x->type)
    {
    case N_ELEMENT:
        out += "<" + x->name;
        for (const Attr &a : x->attrs)
        {
            out += " " + attrName(a) + "=\"";
            escape(out, a.value, true);
            out += "\"";
        }
        out += ">";
        if (servesVoid(x))
            return;
        serializeChildren(out, x, scripting);
        out += "</" + x->name + ">";
        return;
    case N_TEXT:
    {
        const Node *p = x->parent;
        bool literal = p && p->type == N_ELEMENT && p->ns == NS_HTML &&
                       (p->name == "style" || p->name == "script" || p->name == "xmp" || p->name == "iframe" ||
                        p->name == "noembed" || p->name == "noframes" || p->name == "plaintext" ||
                        (p->name == "noscript" && scripting));
        if (literal)
            out += x->data;
        else
            escape(out, x->data, false);
        return;
    }
    case N_COMMENT:
        out += "<!--" + x->data + "-->";
        return;
    case N_PI:
        out += "<?" + x->name + " " + x->data + "?>";
        return;
    case N_DOCTYPE:
        out += "<!DOCTYPE " + x->name + ">";
        return;
    default:
        serializeChildren(out, x, scripting);
    }
}

void serializeChildren(std::string &out, const Node *x, bool scripting)
{
    if (x->type == N_ELEMENT && servesVoid(x))
        return;
    const Node *from = x->content ? x->content : x;
    for (const Node *k : from->kids)
        serializeNode(out, k, scripting);
}

// ── the html5lib / web-platform-tests tree format ────────────────────────

void dumpNode(std::string &out, const Node *x, int depth)
{
    std::string pad = "| " + std::string((size_t)depth * 2, ' ');
    switch (x->type)
    {
    case N_DOCTYPE:
        out += pad + "<!DOCTYPE " + x->name;
        if (!x->data.empty() || !x->systemId.empty())
            out += " \"" + x->data + "\" \"" + x->systemId + "\"";
        out += ">\n";
        return;
    case N_TEXT:
        out += pad + "\"" + x->data + "\"\n";
        return;
    case N_COMMENT:
        out += pad + "<!-- " + x->data + " -->\n";
        return;
    case N_PI:
        out += pad + "<?" + x->name + " " + x->data + "?>\n";
        return;
    case N_ELEMENT:
    {
        std::string prefix = x->ns == NS_SVG ? "svg " : x->ns == NS_MATHML ? "math " : "";
        out += pad + "<" + prefix + x->name + ">\n";
        std::vector<std::pair<std::string, std::string>> attrs;
        for (const Attr &a : x->attrs)
        {
            std::string name = a.name;
            if (a.ns == AN_XLINK)
                name = "xlink " + a.name;
            else if (a.ns == AN_XML)
                name = "xml " + a.name;
            else if (a.ns == AN_XMLNS)
                name = "xmlns " + a.name;
            attrs.push_back(std::make_pair(name, a.value));
        }
        std::sort(attrs.begin(), attrs.end());
        std::string apad = "| " + std::string((size_t)depth * 2 + 2, ' ');
        for (size_t k = 0; k < attrs.size(); ++k)
            out += apad + attrs[k].first + "=\"" + attrs[k].second + "\"\n";
        if (x->content)
        {
            out += apad + "content\n";
            for (const Node *k : x->content->kids)
                dumpNode(out, k, depth + 2);
        }
        for (const Node *k : x->kids)
            dumpNode(out, k, depth + 1);
        return;
    }
    default:
        for (const Node *k : x->kids)
            dumpNode(out, k, depth);
    }
}

std::string dumpTree(const Node *root)
{
    std::string out;
    for (const Node *k : root->kids)
        dumpNode(out, k, 0);
    if (!out.empty())
        out.pop_back();
    return out;
}

// ── files ────────────────────────────────────────────────────────────────

bool readFile(const fs::path &file, std::string &text)
{
    std::ifstream in(file, std::ios::binary);
    if (!in)
        return false;
    std::ostringstream ss;
    ss << in.rdbuf();
    text = ss.str();
    return true;
}

void dropBom(std::string &text)
{
    if (text.size() >= 3 && (unsigned char)text[0] == 0xEF && (unsigned char)text[1] == 0xBB &&
        (unsigned char)text[2] == 0xBF)
        text.erase(0, 3);
}

std::string newlines(const std::string &text)
{
    std::string out;
    for (size_t k = 0; k < text.size(); ++k)
        if (text[k] == '\r')
        {
            out += '\n';
            if (k + 1 < text.size() && text[k + 1] == '\n')
                ++k;
        }
        else
            out += text[k];
    return out;
}

std::string pathKey(const fs::path &p) { return lower(p.lexically_normal().generic_string()); }

// ── the page: checks, stylesheets, output ────────────────────────────────

struct Diag
{
    int line = 1, col = 1, width = 1;
    bool error = true;
    std::string message;
};

bool diagBefore(const Diag &a, const Diag &b) { return a.line != b.line ? a.line < b.line : a.col < b.col; }

class Page
{
public:
    Page(const std::string &source, const std::string &path) : source(source), path(path), parser(source, true) {}

    Result run(const std::vector<std::string> &extraSheets)
    {
        Node *doc = parser.parse();
        Node *htmlEl = parser.htmlEl;
        Node *headEl = parser.headEl;
        if (htmlEl && parser.explicitHtml && !findAttr(htmlEl, "lang"))
            warn(htmlEl->pos, 5,
                 "Consider adding a \"lang\" attribute to the \"html\" start tag to declare the language of this "
                 "document.");
        if (headEl && (parser.hasDoctype || parser.explicitHead) && !hasChild(headEl, "title"))
            warn(headEl->pos, headEl->implied ? 1 : 5,
                 "Element \"head\" is missing a required instance of child element \"title\".");
        visit(doc);
        for (const std::string &sheet : extraSheets)
        {
            fs::path file(sheet);
            if (linked.count(pathKey(file)))
                continue;
            std::string text;
            if (!readFile(file, text))
            {
                sheetReports += sheet + ": error: cannot read the stylesheet.\n";
                failed = true;
                continue;
            }
            dropBom(text);
            std::vector<css::Problem> problems;
            css::compileStylesheet(text, problems);
            sheetReport(file.generic_string(), text, problems);
            if (!headEl)
                continue;
            Node *style = new Node();
            style->name = "style";
            style->parent = headEl;
            Node *t = new Node();
            t->type = N_TEXT;
            t->data = newlines(text);
            t->parent = style;
            style->kids.push_back(t);
            headEl->kids.push_back(style);
        }

        for (const ParseProblem &p : parser.problems)
        {
            Diag d;
            parser.lineCol(p.pos, d.line, d.col);
            d.width = p.width;
            d.error = p.error;
            d.message = p.message;
            diags.push_back(d);
        }
        std::stable_sort(diags.begin(), diags.end(), diagBefore);
        Result r;
        for (const Diag &d : diags)
        {
            r.report += diag::gcc(path, source, d.line, d.col, d.message, d.width, d.error ? "error" : "warning");
            if (d.error)
                failed = true;
        }
        r.report += sheetReports;
        r.failed = failed;
        for (size_t k = 0; k < doc->kids.size(); ++k)
        {
            if (k)
                r.output += "\n";
            serializeNode(r.output, doc->kids[k], true);
        }
        return r;
    }

private:
    const std::string &source;
    std::string path;
    Parser parser;
    std::vector<Diag> diags;
    std::set<std::string> ids;
    std::set<std::string> linked; // stylesheets inlined so far
    std::string sheetReports;
    bool failed = false;

    void add(int pos, int width, bool error, const std::string &message) { parser.report(pos, width, error, message); }
    void warn(int pos, int width, const std::string &message) { add(pos, width, false, message); }

    static bool hasChild(const Node *e, const std::string &name)
    {
        for (const Node *k : e->kids)
            if (isHtml(k, name.c_str()))
                return true;
        return false;
    }

    // a stylesheet's problems, at their place in the page (`base`: where the CSS text starts)
    void cssInPage(const std::vector<css::Problem> &problems, int base)
    {
        int line, col;
        parser.lineCol(base, line, col);
        for (const css::Problem &p : problems)
        {
            Diag d;
            d.line = line + p.line - 1;
            d.col = p.line == 1 ? col + p.col - 1 : p.col;
            d.width = p.width;
            d.error = p.error;
            d.message = p.message;
            diags.push_back(d);
        }
    }

    void sheetReport(const std::string &file, const std::string &text, const std::vector<css::Problem> &problems)
    {
        for (const css::Problem &p : problems)
        {
            sheetReports += diag::gcc(file, text, p.line, p.col, p.message, p.width, p.error ? "error" : "warning");
            if (p.error)
                failed = true;
        }
    }

    static std::string textOf(const Node *e)
    {
        std::string out;
        for (const Node *k : e->kids)
            if (k->type == N_TEXT)
                out += k->data;
        return out;
    }

    void checkElement(Node *x)
    {
        // elements the parser made (implied tags, reconstructed formatting
        // elements, copies) were checked as the tags they came from
        if (x->implied)
            return;
        int width = (int)x->name.size() + 1;
        for (const Attr &a : x->attrs)
        {
            if (a.name == "id" && a.ns == AN_NONE && !a.value.empty() && x->ns == NS_HTML)
            {
                if (ids.count(a.value))
                    add(a.pos, 2, true, "Duplicate ID \"" + a.value + "\".");
                ids.insert(a.value);
            }
            if (a.name == "style" && a.ns == AN_NONE && a.valuePos >= 0)
            {
                std::vector<css::Problem> problems;
                css::checkDeclarations(a.value, problems);
                cssInPage(problems, a.valuePos);
            }
        }
        if (x->name == "style" && x->ns != NS_MATHML)
        {
            std::vector<css::Problem> problems;
            css::compileStylesheet(textOf(x), problems);
            cssInPage(problems, x->contentPos >= 0 ? x->contentPos : x->pos);
        }
        // the rest concerns HTML elements
        if (x->ns != NS_HTML)
            return;
        const std::string &nm = x->name;
        if (!knownElements().count(nm) && nm.find('-') == std::string::npos)
            add(x->pos, width, true,
                "Unknown element \"" + nm + "\". (A custom element's name must contain a hyphen, like \"my-" + nm + "\".)");
        auto o = obsoleteElements().find(nm);
        if (o != obsoleteElements().end())
            warn(x->pos, width, "The \"" + nm + "\" element is obsolete. " + o->second);
        if ((nm == "title" || nm == "base") && x->parent && x->parent->type == N_ELEMENT && !isHtml(x->parent, "head"))
            add(x->pos, width, true,
                "Element \"" + nm + "\" not allowed as child of element \"" + x->parent->name + "\" in this context.");
        if (nm == "img" && !findAttr(x, "alt"))
            warn(x->pos, 4, "An \"img\" element must have an \"alt\" attribute, except under certain conditions.");
        if (nm == "link")
            inlineStylesheet(x);
    }

    void visit(Node *x)
    {
        if (x->type == N_ELEMENT)
            checkElement(x);
        if (x->content)
            visit(x->content);
        for (size_t k = 0; k < x->kids.size(); ++k)
            visit(x->kids[k]);
    }

    // <link rel="stylesheet" href="local.css"> becomes <style> with the file in it
    void inlineStylesheet(Node *x)
    {
        const Attr *rel = findAttr(x, "rel");
        const Attr *href = findAttr(x, "href");
        if (!rel || !href || href->value.empty())
            return;
        std::istringstream in(lower(rel->value));
        std::string token;
        bool sheet = false;
        while (in >> token)
            if (token == "stylesheet")
                sheet = true;
        const std::string url = href->value;
        if (!sheet || url.find("://") != std::string::npos || url.compare(0, 2, "//") == 0 ||
            url.compare(0, 5, "data:") == 0)
            return;
        fs::path file = fs::path(path).parent_path() / url.substr(0, url.find_first_of("?#"));
        std::string text;
        if (!readFile(file, text))
        {
            add(x->pos, 5, true, "Stylesheet \"" + url + "\" not found.");
            return;
        }
        dropBom(text);
        linked.insert(pathKey(file));
        std::vector<css::Problem> problems;
        css::compileStylesheet(text, problems);
        sheetReport(file.generic_string(), text, problems);
        std::vector<Attr> keep;
        for (const Attr &a : x->attrs)
            if (a.name == "media")
                keep.push_back(a);
        x->name = "style";
        x->attrs = keep;
        Node *t = new Node();
        t->type = N_TEXT;
        t->data = newlines(text);
        t->parent = x;
        x->kids.clear();
        x->kids.push_back(t);
    }
};

// ── the tree construction tests ──────────────────────────────────────────

struct TreeTest
{
    std::string data, context, expected;
    int line = 0;             // where the test starts in its file
    int scripting = -1;       // -1 either, 0 off, 1 on
};

std::vector<TreeTest> readTreeTests(const std::string &text)
{
    std::vector<std::string> lines;
    size_t at = 0;
    while (at <= text.size())
    {
        size_t nl = text.find('\n', at);
        if (nl == std::string::npos)
        {
            if (at < text.size())
                lines.push_back(text.substr(at));
            break;
        }
        lines.push_back(text.substr(at, nl - at));
        at = nl + 1;
    }
    std::vector<TreeTest> tests;
    size_t k = 0;
    while (k < lines.size())
    {
        if (lines[k] != "#data")
        {
            ++k;
            continue;
        }
        TreeTest t;
        t.line = (int)k + 1;
        ++k;
        std::string data;
        bool first = true;
        while (k < lines.size() && lines[k] != "#errors")
        {
            if (!first)
                data += "\n";
            data += lines[k++];
            first = false;
        }
        t.data = data;
        while (k < lines.size() && lines[k] != "#document")
        {
            if (lines[k] == "#document-fragment" && k + 1 < lines.size())
            {
                t.context = lines[k + 1];
                ++k;
            }
            else if (lines[k] == "#script-on")
                t.scripting = 1;
            else if (lines[k] == "#script-off")
                t.scripting = 0;
            ++k;
        }
        ++k;
        std::vector<std::string> doc;
        while (k < lines.size() && lines[k] != "#data" && lines[k] != "#description")
            doc.push_back(lines[k++]);
        // the blank line between tests (a blank line inside a text node is
        // followed by more of it, never by the next "#data")
        if (!doc.empty() && doc.back().empty())
            doc.pop_back();
        for (size_t m = 0; m < doc.size(); ++m)
        {
            if (m)
                t.expected += "\n";
            t.expected += doc[m];
        }
        tests.push_back(t);
    }
    return tests;
}

std::string parseForTest(const TreeTest &t, bool scripting)
{
    Parser p(t.data, scripting);
    if (!t.context.empty())
    {
        std::string name = t.context;
        int ns = NS_HTML;
        if (name.compare(0, 4, "svg ") == 0)
        {
            ns = NS_SVG;
            name = name.substr(4);
        }
        else if (name.compare(0, 5, "math ") == 0)
        {
            ns = NS_MATHML;
            name = name.substr(5);
        }
        p.setFragmentContext(name, ns);
    }
    return dumpTree(p.parse());
}

// ── the tokenizer tests ──────────────────────────────────────────────────

void jsonString(std::string &out, const std::string &s)
{
    out += '"';
    for (char ch : s)
    {
        unsigned char c = (unsigned char)ch;
        if (c == '"' || c == '\\')
        {
            out += '\\';
            out += (char)c;
        }
        else if (c < 0x20 || c == 0x7F)
        {
            static const char *const hex = "0123456789abcdef";
            out += "\\u00";
            out += hex[c >> 4];
            out += hex[c & 15];
        }
        else
            out += (char)c;
    }
    out += '"';
}

std::string tokenJson(const Token &t)
{
    std::string out = "[";
    switch (t.type)
    {
    case Token::DOCTYPE:
        out += "\"DOCTYPE\",";
        if (t.hasName)
            jsonString(out, t.name);
        else
            out += "null";
        out += ",";
        if (t.hasPublic)
            jsonString(out, t.publicId);
        else
            out += "null";
        out += ",";
        if (t.hasSystem)
            jsonString(out, t.systemId);
        else
            out += "null";
        out += t.forceQuirks ? ",false" : ",true";
        break;
    case Token::START:
        out += "\"StartTag\",";
        jsonString(out, t.name);
        out += ",{";
        for (size_t k = 0; k < t.attrs.size(); ++k)
        {
            if (k)
                out += ",";
            jsonString(out, t.attrs[k].name);
            out += ":";
            jsonString(out, t.attrs[k].value);
        }
        out += "}";
        if (t.selfClosing)
            out += ",true";
        break;
    case Token::END:
        out += "\"EndTag\",";
        jsonString(out, t.name);
        break;
    case Token::COMMENT:
        out += "\"Comment\",";
        jsonString(out, t.data);
        break;
    case Token::PI:
        out += "\"ProcessingInstruction\",";
        jsonString(out, t.name);
        out += ",";
        jsonString(out, t.data);
        break;
    default:
        out += "\"Character\",";
        jsonString(out, t.data);
    }
    return out + "]";
}

int hexValue(char c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'f')
        return c - 'a' + 10;
    if (c >= 'A' && c <= 'F')
        return c - 'A' + 10;
    return 0;
}

} // namespace

// ── public ───────────────────────────────────────────────────────────────

Result compile(const std::string &source, const std::string &path, const std::vector<std::string> &extraSheets)
{
    std::string text = source;
    dropBom(text);
    Page page(text, path);
    return page.run(extraSheets);
}

bool looksLikePage(const std::string &source)
{
    size_t k = 0;
    if (source.size() >= 3 && (unsigned char)source[0] == 0xEF && (unsigned char)source[1] == 0xBB &&
        (unsigned char)source[2] == 0xBF)
        k = 3;
    while (k < source.size() && isWs(source[k]))
        ++k;
    if (k >= source.size() || source[k] != '<')
        return false;
    if (source.compare(k, 4, "<!--") == 0)
        return true;
    if (lower(source.substr(k, 9)) == "<!doctype")
        return true;
    size_t j = k + 1;
    while (j < source.size() && std::isalnum((unsigned char)source[j]))
        ++j;
    std::string name = lower(source.substr(k + 1, j - k - 1));
    return !name.empty() && std::isalpha((unsigned char)name[0]) && knownElements().count(name) > 0;
}

int runTreeTests(const std::vector<std::string> &files, bool verbose)
{
    int passed = 0, failed = 0;
    for (const std::string &file : files)
    {
        std::string text;
        if (!readFile(file, text))
        {
            std::cerr << file << ": cannot read the file\n";
            return 2;
        }
        // tests that run scripts (document.write) need a script engine
        if (file.find("scripted_") != std::string::npos)
        {
            std::cout << file << ": skipped (the tests run scripts)\n";
            continue;
        }
        std::vector<TreeTest> tests = readTreeTests(text);
        int filePassed = 0, fileFailed = 0;
        for (const TreeTest &t : tests)
        {
            for (int mode = 0; mode < 2; ++mode)
            {
                if (t.scripting >= 0 && t.scripting != mode)
                    continue;
                std::string got = parseForTest(t, mode == 1);
                if (got == t.expected)
                {
                    ++filePassed;
                    continue;
                }
                ++fileFailed;
                std::cout << "FAIL " << file << ":" << t.line << " (scripting " << (mode ? "on" : "off") << ")\n";
                if (verbose)
                {
                    std::cout << "#data\n" << t.data << "\n";
                    if (!t.context.empty())
                        std::cout << "#document-fragment\n" << t.context << "\n";
                    std::cout << "#expected\n" << t.expected << "\n#got\n" << got << "\n\n";
                }
            }
        }
        std::cout << file << ": " << filePassed << " passed, " << fileFailed << " failed\n";
        passed += filePassed;
        failed += fileFailed;
    }
    std::cout << "tree construction: " << passed << " passed, " << failed << " failed\n";
    return failed ? 1 : 0;
}

int dumpTreeFile(const std::string &path, bool scripting)
{
    std::string text;
    if (!readFile(path, text))
    {
        std::cerr << path << ": cannot read the file\n";
        return 2;
    }
    Parser p(text, scripting);
    std::cout << dumpTree(p.parse()) << "\n";
    for (const ParseProblem &e : p.problems)
    {
        int line, col;
        p.lineCol(e.pos, line, col);
        std::cout << "# " << line << ":" << col << (e.error ? " error: " : " warning: ") << e.message << "\n";
    }
    return 0;
}

// Each line of the batch: the initial state's number, the last start tag
// ("-" for none), and the input in hex (UTF-8). Each line of the output:
// {"tokens": [...], "errors": [[code, line, column], ...]}, columns counted
// in characters
int runTokenizerBatch(const std::string &path)
{
    std::string text;
    if (!readFile(path, text))
    {
        std::cerr << path << ": cannot read the file\n";
        return 2;
    }
    std::istringstream in(text);
    std::string line;
    while (std::getline(in, line))
    {
        if (!line.empty() && line.back() == '\r')
            line.pop_back();
        if (line.empty())
            continue;
        std::istringstream fields(line);
        int state = 0;
        std::string last, hex;
        fields >> state >> last >> hex;
        if (last == "-")
            last.clear();
        if (hex == "-")
            hex.clear();
        std::string input;
        for (size_t k = 0; k + 1 < hex.size(); k += 2)
            input += (char)(hexValue(hex[k]) * 16 + hexValue(hex[k + 1]));
        Parser p(input, false);
        std::vector<Token> tokens = p.tokenizeAll(state, last);
        std::string out = "{\"tokens\":[";
        bool first = true;
        for (const Token &t : tokens)
        {
            if (t.type == Token::END_OF_FILE)
                continue;
            if (!first)
                out += ",";
            out += tokenJson(t);
            first = false;
        }
        out += "],\"errors\":[";
        first = true;
        for (const ParseProblem &e : p.problems)
        {
            if (e.code.empty())
                continue;
            int line = 1, col = 1;
            p.cpLineCol(e.at, line, col);
            if (!first)
                out += ",";
            out += "[";
            jsonString(out, e.code);
            out += "," + std::to_string(line) + "," + std::to_string(col) + "]";
            first = false;
        }
        out += "]}";
        std::cout << out << "\n";
    }
    return 0;
}

} // namespace html
