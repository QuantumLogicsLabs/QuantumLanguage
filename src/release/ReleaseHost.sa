// quantum: cpp
// What `quantum version.sa` and `quantum update` share: the host's address,
// latest.json, file helpers and SHA-256.
#include "Release.h.sa"
#include "../qpm/QpmHttp.h.sa"
#include "../qpm/QpmJson.h.sa"
#include "../qpm/QpmSemver.h.sa"

#include <cstdlib>
#include <fstream>
#include <sstream>
#include <string>
#include <vector>

const std::vector<std::string> &releaseProgramNames()
{
    static const std::vector<std::string> names = {"quantum.exe", "qrun.exe", "quantum_stub.exe", "qpm.exe"};
    return names;
}

std::string releaseHostUrl()
{
    const char *env = getenv("QUANTUM_HOST_URL");
    std::string url = (env && *env) ? std::string(env) : std::string("https://quantum-compiler.quantumlogicslimited.com");
    while (!url.empty() && url[url.size() - 1] == '/')
        url.resize(url.size() - 1);
    return url;
}

bool releaseHostAllowed(const std::string &host)
{
    if (host.compare(0, 8, "https://") == 0)
        return true;
    if (host.compare(0, 7, "http://") != 0)
        return false;
    std::string rest = host.substr(7);
    return rest.compare(0, 9, "localhost") == 0 || rest.compare(0, 9, "127.0.0.1") == 0;
}

const ReleaseEntry *findReleaseEntry(const ReleaseInfo &info, const std::string &name)
{
    for (const ReleaseEntry &e : info.files)
        if (e.name == name)
            return &e;
    return nullptr;
}

bool fetchLatestRelease(const std::string &host, ReleaseInfo &out, bool &found, std::string &error)
{
    found = false;
    qpm::HttpResponse r = qpm::httpRequest("GET", host + "/latest.json");
    if (!r.error.empty())
    {
        error = "cannot reach " + host + " (" + r.error + ")";
        return false;
    }
    if (r.status == 404)
        return true;
    if (!r.ok())
    {
        error = host + " answered " + qpm::describeFailure(r);
        return false;
    }
    try
    {
        qpm::JsonValue j = qpm::JsonValue::parse(r.body);
        out.version = j.get("version").asString();
        out.files.clear();
        const qpm::JsonValue *files = j.find("files");
        if (files && files->isObject())
            for (const auto &m : files->object())
            {
                ReleaseEntry e;
                e.name = m.first;
                e.path = m.second.get("path").asString();
                e.sha256 = m.second.get("sha256").asString();
                out.files.push_back(e);
            }
    }
    catch (const std::exception &e)
    {
        error = std::string("latest.json from ") + host + " is not valid: " + e.what();
        return false;
    }
    if (compareVersions(out.version, out.version) < 0)
    {
        error = "latest.json from " + host + " has a bad version \"" + out.version + "\"";
        return false;
    }
    found = true;
    return true;
}

int compareVersions(const std::string &a, const std::string &b)
{
    qpm::SemVer x, y;
    if (!qpm::SemVer::tryParse(a, x) || !qpm::SemVer::tryParse(b, y))
        return -1;
    int c = qpm::compareSemVer(x, y);
    return c < 0 ? 0 : (c == 0 ? 1 : 2);
}

bool releaseReadFile(const std::string &path, std::string &out)
{
    std::ifstream in(path, std::ios::binary);
    if (!in.is_open())
        return false;
    std::ostringstream ss;
    ss << in.rdbuf();
    out = ss.str();
    return true;
}

bool releaseWriteFile(const std::string &path, const std::string &data)
{
    std::ofstream out(path, std::ios::binary);
    if (!out.is_open())
        return false;
    out.write(data.data(), static_cast<long long>(data.size()));
    out.close();
    return true;
}

// ─── SHA-256 ──────────────────────────────────────────────────────────────────

namespace
{
    const unsigned SHA_K[64] = {
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};

    unsigned rotr(unsigned x, unsigned n) { return (x >> n) | (x << (32 - n)); }

    void shaBlock(unsigned h[8], const unsigned char *p)
    {
        unsigned w[64];
        for (int i = 0; i < 16; ++i)
            w[i] = (static_cast<unsigned>(p[i * 4]) << 24) | (static_cast<unsigned>(p[i * 4 + 1]) << 16) |
                   (static_cast<unsigned>(p[i * 4 + 2]) << 8) | static_cast<unsigned>(p[i * 4 + 3]);
        for (int i = 16; i < 64; ++i)
        {
            unsigned s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
            unsigned s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
        }
        unsigned a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], k = h[7];
        for (int i = 0; i < 64; ++i)
        {
            unsigned S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            unsigned ch = (e & f) ^ (~e & g);
            unsigned t1 = k + S1 + ch + SHA_K[i] + w[i];
            unsigned S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            unsigned maj = (a & b) ^ (a & c) ^ (b & c);
            unsigned t2 = S0 + maj;
            k = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
        }
        h[0] += a;
        h[1] += b;
        h[2] += c;
        h[3] += d;
        h[4] += e;
        h[5] += f;
        h[6] += g;
        h[7] += k;
    }
} // namespace

std::string sha256Hex(const std::string &data)
{
    unsigned h[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
    const unsigned char *p = reinterpret_cast<const unsigned char *>(data.data());
    size_t full = data.size() / 64;
    for (size_t i = 0; i < full; ++i)
        shaBlock(h, p + i * 64);

    // the rest, then 0x80, zeros, and the length in bits (big-endian, 64 bits)
    unsigned char tail[128];
    size_t rest = data.size() - full * 64;
    for (size_t i = 0; i < rest; ++i)
        tail[i] = p[full * 64 + i];
    tail[rest] = 0x80;
    size_t tailLen = rest < 56 ? 64 : 128;
    for (size_t i = rest + 1; i < tailLen; ++i)
        tail[i] = 0;
    unsigned long long bits = static_cast<unsigned long long>(data.size()) * 8ULL;
    for (int i = 0; i < 8; ++i)
        tail[tailLen - 1 - i] = static_cast<unsigned char>((bits >> (8 * i)) & 0xFF);
    shaBlock(h, tail);
    if (tailLen == 128)
        shaBlock(h, tail + 64);

    static const char *hex = "0123456789abcdef";
    std::string out;
    for (int i = 0; i < 8; ++i)
        for (int s = 28; s >= 0; s -= 4)
            out += hex[(h[i] >> s) & 0xF];
    return out;
}
