// quantum: cpp
// Library natives of the Java runtime: java.lang.String / StringBuilder /
// Character / Integer / Long / Double / Math, java.util.Arrays / Random,
// regular expressions, and java.util.Formatter (String.format / printf).
// A prelude method declared `native` in class C is the global __jn_C_<name>
// (receiver first); see src/java/JavaPrelude.cpp.
#include "Vm.h.sa"
#include "VmJava.h.sa"
#include "JavaOps.h.sa"

#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdio>
