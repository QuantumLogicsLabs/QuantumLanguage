        std::copy(v.begin(), v.end(), arr.begin() + from);
        return QV(); });
    // Object.clone(): a shallow copy
    reg("__jn_Object_$clone", [](std::vector<QV> a) -> QV
        {
        const QV &v = arg(a, 0);
        if (v.isInstance())
            return QV(std::make_shared<QuantumInstance>(*v.asInstance()));
        if (v.isArray())
            return QV(std::make_shared<Array>(*v.asArray()));
        return v; });
    // PrintStream.write(int) on the console: one raw byte
    reg("__jn_$Console_write", [](std::vector<QV> a) -> QV
        {
        if (arg(a, 0).isTruthy())
        {
            std::cout.flush();
            std::cerr.put((char)jint(arg(a, 1)));
        }
        else
            std::cout.put((char)jint(arg(a, 1)));
        return QV(); });

    reg("__jn_Arrays_binarySearchPrim", [](std::vector<QV> a) -> QV
        {
        const Array &arr = *arg(a, 0).asArray();
        const QV &key = arg(a, 1);
        int64_t lo = 0, hi = (int64_t)arr.size() - 1;
        bool dbl = key.isNumber();
        while (lo <= hi)
        {
            int64_t mid = (lo + hi) >> 1;
            int c = dbl ? compareJavaDoubles(jdouble(arr[(size_t)mid]), key.asNumber())
                        : (jint(arr[(size_t)mid]) < jint(key) ? -1 : jint(arr[(size_t)mid]) > jint(key) ? 1 : 0);
            if (c < 0)
                lo = mid + 1;
            else if (c > 0)
                hi = mid - 1;
            else
                return I(mid);
        }
        return I(-(lo + 1)); });
}
