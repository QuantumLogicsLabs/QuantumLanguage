#include <regex>
#include <sstream>

using QV = QuantumValue;

std::string javaLongToString(int64_t v, int radix)
{
    if (radix < 2 || radix > 36)
        radix = 10;
    if (v == 0)
        return "0";
    bool neg = v < 0;
    uint64_t u = neg ? (uint64_t)0 - (uint64_t)v : (uint64_t)v;
    std::string s;
    while (u)
    {
        int dgt = (int)(u % radix);
        s += (char)(dgt < 10 ? '0' + dgt : 'a' + dgt - 10);
        u /= radix;
    }
    if (neg)
        s += '-';
    std::reverse(s.begin(), s.end());
    return s;
}

namespace
{
std::string unsignedToString(uint64_t u, int shift)
{
    // radix 2^shift, unsigned (Integer.toHexString / toBinaryString)
    if (u == 0)
        return "0";
    std::string s;
    uint64_t mask = (1u << shift) - 1;
    while (u)
    {
        int dgt = (int)(u & mask);
        s += (char)(dgt < 10 ? '0' + dgt : 'a' + dgt - 10);
        u >>= shift;
    }
    std::reverse(s.begin(), s.end());
    return s;
}

// HALF_UP rounding of the decimal digits/exp10 pair to `frac` digits after
// the decimal point; returns the plain-notation string (no sign).
std::string fixedFromDigits(std::string digits, int e, int frac)
{
    // value = 0.d1d2... × 10^(e+1); position of the decimal point in digits
    int point = e + 1;
    // Build the full digit sequence with explicit integer / fraction parts.
    std::string intPart, fracPart;
    if (point <= 0)
    {
        intPart = "0";
        fracPart = std::string(-point, '0') + digits;
    }
    else if (point >= (int)digits.size())
    {
        intPart = digits + std::string(point - digits.size(), '0');
        fracPart = "";
    }
    else
    {
        intPart = digits.substr(0, point);
        fracPart = digits.substr(point);
    }
    if ((int)fracPart.size() > frac)
    {
        bool roundUp = fracPart[frac] >= '5';
        fracPart = fracPart.substr(0, frac);
        if (roundUp)
        {
            std::string all = intPart + fracPart;
            int i = (int)all.size() - 1;
            while (i >= 0)
            {
                if (all[i] == '9')
                {
                    all[i] = '0';
                    --i;
                }
                else
                {
                    ++all[i];
                    break;
                }
            }
            if (i < 0)
                all = "1" + all;
            intPart = all.substr(0, all.size() - frac);
            fracPart = all.substr(all.size() - frac);
        }
    }
    else
        fracPart += std::string(frac - fracPart.size(), '0');
    size_t nz = intPart.find_first_not_of('0');
    intPart = nz == std::string::npos ? "0" : intPart.substr(nz);
    return frac > 0 ? intPart + "." + fracPart : intPart;
}

std::string groupThousands(const std::string &intDigits)
{
    std::string out;
    int n = (int)intDigits.size();
    for (int i = 0; i < n; ++i)
    {
        out += intDigits[i];
        if ((n - i - 1) % 3 == 0 && i != n - 1)
            out += ',';
    }
    return out;
}

// HALF_UP to `sig` significant digits: returns digits (exactly sig) and the new exponent.
void roundSignificant(std::string digits, int e, int sig, std::string &out, int &outE)
{
    if ((int)digits.size() <= sig)
    {
        out = digits + std::string(sig - digits.size(), '0');
        outE = e;
        return;
    }
    bool up = digits[sig] >= '5';
    out = digits.substr(0, sig);
    outE = e;
    if (up)
    {
        int i = sig - 1;
        while (i >= 0)
        {
            if (out[i] == '9')
            {
                out[i] = '0';
                --i;
            }
            else
            {
                ++out[i];
                break;
            }
        }
        if (i < 0)
        {
            out = "1" + out.substr(0, sig - 1);
            ++outE;
        }
    }
}
} // namespace

std::string javaFormat(const std::string &fmt, const std::vector<QV> &args, const std::string &kinds,
                       const std::function<std::string(const QV &)> &str)
{
    std::string out;
    size_t ordinary = 0; // next argument for an unnumbered specifier
    int last = -1;       // for %<s
    for (size_t i = 0; i < fmt.size(); ++i)
    {
        char c = fmt[i];
        if (c != '%')
        {
            out += c;
            continue;
        }
        size_t start = i;
        ++i;
        // %[index$][flags][width][.precision]conversion
        int index = -1;
        size_t j = i;
        while (j < fmt.size() && std::isdigit((unsigned char)fmt[j]))
            ++j;
        if (j < fmt.size() && fmt[j] == '$' && j > i)
        {
            index = std::atoi(fmt.substr(i, j - i).c_str()) - 1;
            i = j + 1;
        }
        std::string flags;
        bool prevArg = false;
        while (i < fmt.size() && std::strchr("-#+ 0,(<", fmt[i]))
        {
            if (fmt[i] == '<')
                prevArg = true;
            else
                flags += fmt[i];
            ++i;
        }
        int width = -1, prec = -1;
        if (i < fmt.size() && std::isdigit((unsigned char)fmt[i]))
        {
            width = 0;
            while (i < fmt.size() && std::isdigit((unsigned char)fmt[i]))
                width = width * 10 + (fmt[i++] - '0');
        }
        if (i < fmt.size() && fmt[i] == '.')
        {
            ++i;
            prec = 0;
            while (i < fmt.size() && std::isdigit((unsigned char)fmt[i]))
                prec = prec * 10 + (fmt[i++] - '0');
        }
        if (i >= fmt.size())
            jthrow("java.util.UnknownFormatConversionException", "Conversion = '%'");
        char conv = fmt[i];
        auto has = [&](char f) { return flags.find(f) != std::string::npos; };
        auto pad = [&](std::string s)
        {
            if (width > 0 && (int)s.size() < width)
            {
                if (has('-'))
                    s += std::string(width - s.size(), ' ');
                else
                    s = std::string(width - s.size(), ' ') + s;
            }
            return s;
        };
        if (conv == 'n')
        {
            out += '\n';
            continue;
        }
        if (conv == '%')
        {
            out += pad("%");
            continue;
        }
        int argIdx;
        if (prevArg)
            argIdx = last;
        else if (index >= 0)
            argIdx = index;
        else
            argIdx = (int)ordinary++;
        if (argIdx < 0 || argIdx >= (int)args.size())
            jthrow("java.util.MissingFormatArgumentException", "Format specifier '" + fmt.substr(start, i - start + 1) + "'");
        last = argIdx;
        QV a = args[argIdx];
        if (a.isInstance())
        {
            // a Long / Short / Byte box: its value
            const std::string &cn = a.asInstance()->klass->name;
            if (cn == "java.lang.Long" || cn == "java.lang.Short" || cn == "java.lang.Byte")
            {
                auto it = a.asInstance()->fields.find("value");
                if (it != a.asInstance()->fields.end())
                    a = it->second;
            }
            else if (cn == "java.lang.Character")
            {
                auto it = a.asInstance()->fields.find("value");
                if (it != a.asInstance()->fields.end())
                    a = QV(unitToUtf8((uint32_t)(jint(it->second) & 0xFFFF)));
            }
        }
        char kind = argIdx < (int)kinds.size() ? kinds[argIdx] : 'O';
        bool upper = std::isupper((unsigned char)conv) != 0;
        char lc = (char)std::tolower((unsigned char)conv);
        std::string piece;
        auto typeName = [&]() -> std::string
        {
            if (a.isString())
                return kind == 'C' ? "java.lang.Character" : "java.lang.String";
            if (a.isLong())
                return kind == 'J' ? "java.lang.Long" : "java.lang.Integer";
            if (a.isNumber())
                return kind == 'F' ? "java.lang.Float" : "java.lang.Double";
            if (a.isBool())
                return "java.lang.Boolean";
            return "java.lang.Object";
        };
        auto mismatch = [&]()
        {
            jthrow("java.util.IllegalFormatConversionException",
                   std::string(1, conv) + " != " + typeName());
        };
        switch (lc)
        {
        case 'b':
            piece = a.isNil() ? "false" : a.isBool() ? (a.asBool() ? "true" : "false") : "true";
            if (prec >= 0 && (int)piece.size() > prec)
                piece = piece.substr(0, prec);
            break;
        case 'h':
        {
            // Integer.toHexString(arg.hashCode())
            int64_t h = 0;
            if (a.isString())
                for (char16_t ch : toU16(a.asString()))
                    h = (int32_t)((uint32_t)h * 31u + (uint32_t)ch);
            else if (a.isLong())
                h = a.asLong() == wrap32(a.asLong()) ? a.asLong() : (int32_t)((uint64_t)a.asLong() ^ ((uint64_t)a.asLong() >> 32));
            else if (a.isBool())
                h = a.asBool() ? 1231 : 1237;
            piece = a.isNil() ? "null" : unsignedToString((uint32_t)h, 4);
            break;
        }
        case 's':
        {
            if (a.isNil())
                piece = "null";
            else if (a.isString())
                piece = kind == 'C' && a.asString().empty() ? "" : a.asString();
            else if (a.isLong())
                piece = kind == 'C' ? unitToUtf8((uint32_t)a.asLong()) : std::to_string(a.asLong());
            else if (a.isNumber())
                piece = kind == 'F' ? javaFloatToString(a.asNumber()) : javaDoubleToString(a.asNumber());
            else if (a.isBool())
                piece = a.asBool() ? "true" : "false";
            else
                piece = str(a);
            if (prec >= 0 && (int)u16Length(piece) > prec)
                piece = u16Substr(piece, 0, prec);
            break;
        }
        case 'c':
        {
            if (a.isNil())
                piece = "null";
            else if (a.isString())
                piece = a.asString();
            else if (a.isLong())
            {
                int64_t cp = a.asLong();
                if (cp < 0 || cp > 0x10FFFF)
                    jthrow("java.util.IllegalFormatCodePointException", "Code point = 0x" + unsignedToString((uint64_t)cp, 4));
                if (cp >= 0x10000)
                {
                    std::u16string u;
                    u += (char16_t)(0xD800 + ((cp - 0x10000) >> 10));
                    u += (char16_t)(0xDC00 + ((cp - 0x10000) & 0x3FF));
                    piece = fromU16(u);
                }
                else
                    piece = unitToUtf8((uint32_t)cp);
            }
            else
                mismatch();
            break;
        }
        case 'd':
        {
            if (a.isNil())
            {
                piece = "null";
                break;
            }
            if (!a.isLong() || kind == 'C')
                mismatch();
            int64_t v = a.asLong();
            uint64_t mag = v < 0 ? (uint64_t)0 - (uint64_t)v : (uint64_t)v;
            std::string digits = std::to_string(mag);
            if (has(','))
                digits = groupThousands(digits);
            std::string sign = v < 0 ? (has('(') ? "(" : "-") : has('+') ? "+" : has(' ') ? " " : "";
            std::string tail = v < 0 && has('(') ? ")" : "";
            if (has('0') && width > 0)
            {
                int need = width - (int)(sign.size() + digits.size() + tail.size());
                if (need > 0)
                    digits = std::string(need, '0') + digits;
            }
            piece = sign + digits + tail;
            break;
        }
        case 'x':
        case 'o':
        {
            if (a.isNil())
            {
                piece = "null";
                break;
            }
            if (!a.isLong() || kind == 'C')
                mismatch();
            int64_t v = a.asLong();
            bool isLong = kind == 'J' || v != wrap32(v);
            uint64_t u = isLong ? (uint64_t)v : (uint64_t)(uint32_t)(int32_t)v;
            piece = unsignedToString(u, lc == 'x' ? 4 : 3);
            if (has('#'))
                piece = (lc == 'x' ? "0x" : "0") + piece;
            if (has('0') && width > 0 && (int)piece.size() < width)
                piece = std::string(width - piece.size(), '0') + piece;
            break;
        }
        case 'f':
        case 'e':
        case 'g':
        {
            if (a.isNil())
            {
                piece = "null";
                break;
            }
            if (!a.isNumber())
                mismatch();
            double v = a.asNumber();
            bool neg = std::signbit(v) && !std::isnan(v);
            double av = std::fabs(v);
            std::string body;
            if (std::isnan(v) || std::isinf(v))
                body = std::isnan(v) ? "NaN" : "Infinity";
            else
            {
                if (prec < 0)
                    prec = 6;
                std::string digits;
                int e = 0;
                if (av == 0)
                {
                    digits = "0";
                    e = 0;
                }
                else
                    shortestDigits(av, kind == 'F', digits, e);
                char mode = lc;
                if (mode == 'g')
                {
                    int p = prec == 0 ? 1 : prec;
                    std::string r;
                    int re;
                    roundSignificant(digits, e, p, r, re);
                    if (av != 0 && (av < 1e-4 || re >= p))
                    {
                        mode = 'e';
                        prec = p - 1;
                    }
                    else
                    {
                        mode = 'f';
                        prec = std::max(0, p - (av == 0 ? 1 : re + 1));
                    }
                }
                if (mode == 'f')
                {
                    body = av == 0 ? (prec > 0 ? "0." + std::string(prec, '0') : "0") : fixedFromDigits(digits, e, prec);
                    if (has(','))
                    {
                        size_t dot = body.find('.');
                        std::string ip = body.substr(0, dot);
                        body = groupThousands(ip) + (dot == std::string::npos ? "" : body.substr(dot));
                    }
                }
                else
                {
                    std::string r;
                    int re;
                    if (av == 0)
                    {
                        r = std::string(prec + 1, '0');
                        re = 0;
                    }
                    else
                        roundSignificant(digits, e, prec + 1, r, re);
                    body = r.substr(0, 1) + (prec > 0 ? "." + r.substr(1) : "") + "e" + (re < 0 ? "-" : "+") +
                           (std::abs(re) < 10 ? "0" : "") + std::to_string(std::abs(re));
                }
            }
            std::string sign = neg ? (has('(') ? "(" : "-") : has('+') ? "+" : has(' ') ? " " : "";
            std::string tail = neg && has('(') ? ")" : "";
            if (has('0') && width > 0 && !std::isnan(v) && !std::isinf(v))
            {
                int need = width - (int)(sign.size() + body.size() + tail.size());
                if (need > 0)
                    body = std::string(need, '0') + body;
            }
            piece = sign + body + tail;
            break;
        }
        default:
            jthrow("java.util.UnknownFormatConversionException", std::string("Conversion = '") + conv + "'");
        }
        if (upper)
        {
            std::string u;
            for (char ch : piece)
                u += (char)std::toupper((unsigned char)ch);
            piece = u;
        }
        out += pad(piece);
    }
    return out;
}

// ─── Natives ─────────────────────────────────────────────────────────────────

namespace
{
const QV &arg(const std::vector<QV> &a, size_t i)
{
    static const QV nil;
    return i < a.size() ? a[i] : nil;
}

[[noreturn]] void npe() { jthrow("java.lang.NullPointerException", ""); }

const std::string &S(const QV &v)
{
    if (!v.isString())
    {
        if (v.isNil())
            npe();
        static std::string tmp;
        tmp = javaUn(jop::VSTR, v).asString();
        return tmp;
    }
    return v.asString();
}

QV I(int64_t v) { return jlong(v); }
QV B(bool b) { return QV(b); }
QV Str(std::string s) { return QV(std::move(s)); }

std::string lower(const std::string &s)
{
    if (isAscii(s))
    {
        std::string r = s;
        for (char &c : r)
            c = (char)std::tolower((unsigned char)c);
        return r;
    }
    std::u16string u = toU16(s);
    for (auto &c : u)
    {
        if (c < 128)
            c = (char16_t)std::tolower(c);
        else if ((c >= 0xC0 && c <= 0xDE && c != 0xD7) || (c >= 0x391 && c <= 0x3A9) || (c >= 0x410 && c <= 0x42F))
            c = (char16_t)(c + 32); // Latin-1, Greek and Cyrillic capitals
    }
    return fromU16(u);
}

std::string upper(const std::string &s)
{
    if (isAscii(s))
    {
        std::string r = s;
        for (char &c : r)
            c = (char)std::toupper((unsigned char)c);
        return r;
    }
    std::u16string u = toU16(s);
    std::u16string out;
    for (auto c : u)
    {
        if (c < 128)
            out += (char16_t)std::toupper(c);
        else if (c == 0xDF)
            out += u"SS";
        else if ((c >= 0xE0 && c <= 0xFE && c != 0xF7) || (c >= 0x3B1 && c <= 0x3C9 && c != 0x3C2) ||
                 (c >= 0x430 && c <= 0x44F))
            out += (char16_t)(c - 32);
        else
            out += c;
    }
    return fromU16(out);
}

bool jisWhitespace(uint32_t c)
{
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == 0x0B || (c >= 0x1C && c <= 0x1F) ||
           c == 0x2028 || c == 0x2029 || c == 0x1680 || (c >= 0x2000 && c <= 0x2006) || (c >= 0x2008 && c <= 0x200A) ||
           c == 0x205F || c == 0x3000;
}
bool jisLetter(uint32_t c)
{
    if (c < 128)
        return std::isalpha((int)c) != 0;
    return (c >= 0xC0 && c <= 0x24F && c != 0xD7 && c != 0xF7) || (c >= 0x370 && c <= 0x3FF) ||
           (c >= 0x400 && c <= 0x4FF) || (c >= 0x4E00 && c <= 0x9FFF) || (c >= 0x3040 && c <= 0x30FF) ||
           (c >= 0xAC00 && c <= 0xD7AF) || (c >= 0x5D0 && c <= 0x5EA) || (c >= 0x620 && c <= 0x64A);
}
bool jisDigit(uint32_t c)
{
    return (c >= '0' && c <= '9') || (c >= 0x660 && c <= 0x669) || (c >= 0x966 && c <= 0x96F) ||
           (c >= 0xFF10 && c <= 0xFF19);
}
bool jisUpper(uint32_t c)
{
    if (c < 128)
        return std::isupper((int)c) != 0;
    return (c >= 0xC0 && c <= 0xDE && c != 0xD7) || (c >= 0x391 && c <= 0x3A9) || (c >= 0x410 && c <= 0x42F);
}
bool jisLower(uint32_t c)
{
    if (c < 128)
        return std::islower((int)c) != 0;
    return (c >= 0xDF && c <= 0xFF && c != 0xF7) || (c >= 0x3B1 && c <= 0x3C9) || (c >= 0x430 && c <= 0x44F);
}

// Java regex -> ECMAScript (std::regex): the common subset is shared; the
// POSIX classes \p{Alpha} etc. are rewritten. Pattern flags: 0x02
// CASE_INSENSITIVE (also a leading (?i)), 0x08 MULTILINE, 0x20 DOTALL.
std::regex makeRegex(const std::string &javaRe, int64_t flags = 0)
{
    std::string src = javaRe;
    if (src.rfind("(?i)", 0) == 0)
    {
        src = src.substr(4);
        flags |= 0x02;
    }
    std::string r;
    bool inClass = false;
    for (size_t i = 0; i < src.size(); ++i)
    {
        const std::string &javaRe = src;
        if (javaRe[i] == '\\' && i + 1 < javaRe.size() && !(javaRe[i + 1] == 'p' || javaRe[i + 1] == 'P' || javaRe[i + 1] == 'h'))
        {
            r += javaRe[i];
            r += javaRe[++i];
            continue;
        }
        if (javaRe[i] == '[')
            inClass = true;
        else if (javaRe[i] == ']')
            inClass = false;
        else if (javaRe[i] == '.' && !inClass && (flags & 0x20))
        {
            r += "[\\s\\S]";
            continue;
        }
        if (javaRe[i] == '\\' && i + 1 < javaRe.size() && (javaRe[i + 1] == 'p' || javaRe[i + 1] == 'P') &&
            i + 2 < javaRe.size() && javaRe[i + 2] == '{')
        {
            size_t close = javaRe.find('}', i);
            std::string name = javaRe.substr(i + 3, close - i - 3);
            bool neg = javaRe[i + 1] == 'P';
            std::string cls;
            if (name == "Alpha" || name == "L" || name == "IsAlphabetic") cls = "a-zA-Z";
            else if (name == "Digit" || name == "Nd" || name == "IsDigit") cls = "0-9";
            else if (name == "Alnum") cls = "a-zA-Z0-9";
            else if (name == "Upper" || name == "Lu" || name == "IsUppercase") cls = "A-Z";
            else if (name == "Lower" || name == "Ll" || name == "IsLowercase") cls = "a-z";
            else if (name == "Punct" || name == "P") cls = "!-\\/:-@\\[-`{-~";
            else if (name == "Space" || name == "IsWhite_Space") cls = " \\t\\n\\r\\f\\v";
            else cls = "a-zA-Z";
            r += neg ? "[^" + cls + "]" : "[" + cls + "]";
            i = close;
            continue;
        }
        if (javaRe[i] == '\\' && i + 1 < javaRe.size() && javaRe[i + 1] == 'h')
        {
            r += "[ \\t]";
            ++i;
            continue;
        }
        r += javaRe[i];
    }
    auto opts = std::regex::ECMAScript;
    if (flags & 0x02)
        opts |= std::regex::icase;
    if (flags & 0x08)
        opts |= std::regex::multiline;
    try
    {
        return std::regex(r, opts);
    }
    catch (const std::regex_error &e)
    {
        jthrow("java.util.regex.PatternSyntaxException", std::string(e.what()) + " near index 0\n" + javaRe);
    }
}

// UTF-16 index <-> UTF-8 byte offset in a VM string
size_t u16IndexToByte(const std::string &s, int64_t idx)
{
    if (isAscii(s))
        return (size_t)std::max<int64_t>(0, std::min<int64_t>(idx, (int64_t)s.size()));
    size_t b = 0;
    int64_t u = 0;
    while (b < s.size() && u < idx)
    {
        unsigned char c = (unsigned char)s[b];
        size_t n = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
        u += n == 4 ? 2 : 1;
        b += n;
    }
    return std::min(b, s.size());
}

int64_t byteToU16Index(const std::string &s, size_t byte)
{
    if (isAscii(s))
        return (int64_t)byte;
    int64_t u = 0;
    for (size_t b = 0; b < byte && b < s.size();)
    {
        unsigned char c = (unsigned char)s[b];
        size_t n = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
        u += n == 4 ? 2 : 1;
        b += n;
    }
    return u;
}

// Java replacement string ($1, \$) -> ECMAScript format ($1, $$)
std::string replacementFormat(const std::string &rep)
{
    std::string out;
    for (size_t i = 0; i < rep.size(); ++i)
    {
        if (rep[i] == '\\' && i + 1 < rep.size())
        {
            ++i;
            out += rep[i] == '$' ? "$$" : std::string(1, rep[i]);
        }
        else
            out += rep[i];
    }
    return out;
}

bool isRegexMeta(char c) { return std::strchr(".$|()[{^?*+\\", c) != nullptr; }

std::vector<std::string> javaSplit(const std::string &s, const std::string &re, int64_t limit)
{
    std::vector<std::string> parts;
    // fast path: a single literal character (or an escaped one)
    std::string lit;
    if (re.size() == 1 && !isRegexMeta(re[0]))
        lit = re;
    else if (re.size() == 2 && re[0] == '\\' && !std::isalnum((unsigned char)re[1]))
        lit = re.substr(1);
    if (!lit.empty())
    {
        size_t from = 0;
        while (true)
        {
            if (limit > 0 && (int64_t)parts.size() == limit - 1)
            {
                parts.push_back(s.substr(from));
                break;
            }
            size_t at = s.find(lit, from);
            if (at == std::string::npos)
            {
                parts.push_back(s.substr(from));
                break;
            }
            parts.push_back(s.substr(from, at - from));
            from = at + lit.size();
        }
    }
    else
    {
        std::regex rx = makeRegex(re);
        size_t from = 0;
        auto begin = std::sregex_iterator(s.begin(), s.end(), rx);
        for (auto it = begin; it != std::sregex_iterator(); ++it)
        {
            size_t at = (size_t)it->position(0), len = (size_t)it->length(0);
            if (len == 0 && at == 0)
                continue; // a zero-width match at the start makes no leading empty piece
            if (len == 0 && at >= s.size())
                break;
            if (limit > 0 && (int64_t)parts.size() == limit - 1)
                break;
            parts.push_back(s.substr(from, at - from));
            from = at + len;
        }
        parts.push_back(s.substr(from));
    }
    if (limit == 0)
        while (parts.size() > 1 && parts.back().empty())
            parts.pop_back();
    if (s.empty())
        return {""};
    return parts;
}

std::string javaTrim(const std::string &s)
{
    size_t a = 0, b = s.size();
    while (a < b && (unsigned char)s[a] <= ' ')
        ++a;
    while (b > a && (unsigned char)s[b - 1] <= ' ')
        --b;
    return s.substr(a, b - a);
}

int64_t indexOfUnits(const std::string &s, const std::string &needle, int64_t from)
{
    if (isAscii(s) && isAscii(needle))
    {
        if (from < 0)
            from = 0;
        if (from > (int64_t)s.size())
            return -1;
        size_t at = s.find(needle, (size_t)from);
        return at == std::string::npos ? -1 : (int64_t)at;
    }
    std::u16string u = toU16(s), n = toU16(needle);
    if (from < 0)
        from = 0;
    if (from > (int64_t)u.size())
        return -1;
    size_t at = u.find(n, (size_t)from);
    return at == std::u16string::npos ? -1 : (int64_t)at;
}

int64_t lastIndexOfUnits(const std::string &s, const std::string &needle, int64_t from)
{
    std::u16string u = toU16(s), n = toU16(needle);
    if (from < 0)
        return -1;
    size_t at = u.rfind(n, (size_t)std::min<int64_t>(from, (int64_t)u.size()));
    return at == std::u16string::npos ? -1 : (int64_t)at;
}

std::string needleOf(const QV &v)
{
    // indexOf(int ch) vs indexOf(String)
    if (v.isLong())
    {
        int64_t cp = v.asLong();
        if (cp >= 0x10000)
        {
            std::u16string u;
            u += (char16_t)(0xD800 + ((cp - 0x10000) >> 10));
            u += (char16_t)(0xDC00 + ((cp - 0x10000) & 0x3FF));
            return fromU16(u);
        }
        return unitToUtf8((uint32_t)cp);
    }
    return S(v);
}

int compareStrings(const std::string &a, const std::string &b)
{
    if (isAscii(a) && isAscii(b))
    {
        size_t n = std::min(a.size(), b.size());
        for (size_t i = 0; i < n; ++i)
            if (a[i] != b[i])
                return (unsigned char)a[i] - (unsigned char)b[i];
        return (int)a.size() - (int)b.size();
    }
    std::u16string x = toU16(a), y = toU16(b);
    size_t n = std::min(x.size(), y.size());
    for (size_t i = 0; i < n; ++i)
        if (x[i] != y[i])
            return (int)x[i] - (int)y[i];
    return (int)x.size() - (int)y.size();
}

// Integer.parseInt / Long.parseLong
int64_t parseJavaLong(const QV &v, int radix, bool isInt)
{
    if (v.isNil())
        jthrow("java.lang.NumberFormatException", "Cannot parse null string: null");
    const std::string &s = S(v);
    auto bad = [&]() -> int64_t
    {
        jthrow("java.lang.NumberFormatException",
               "For input string: \"" + s + "\"" + (radix != 10 ? " under radix " + std::to_string(radix) : ""));
    };
    if (s.empty())
        bad();
    size_t i = 0;
    bool neg = false;
    if (s[0] == '-' || s[0] == '+')
    {
        neg = s[0] == '-';
        i = 1;
        if (s.size() == 1)
            bad();
    }
    // past 64 bits is past every limit: an overflow is a bad number
    uint64_t acc = 0;
    for (; i < s.size(); ++i)
    {
        char c = s[i];
        int d = std::isdigit((unsigned char)c) ? c - '0' : std::isalpha((unsigned char)c) ? std::tolower(c) - 'a' + 10 : 99;
        if (d >= radix)
            bad();
        if (acc > (UINT64_MAX - (uint64_t)d) / (uint64_t)radix)
            bad();
        acc = acc * (uint64_t)radix + (uint64_t)d;
    }
    uint64_t lim = isInt ? (neg ? ((uint64_t)1 << 31) : (((uint64_t)1 << 31) - 1))
                         : (neg ? ((uint64_t)1 << 63) : (((uint64_t)1 << 63) - 1));
    if (acc > lim)
        bad();
    return neg ? (int64_t)(0 - acc) : (int64_t)acc;
}

double parseJavaDouble(const QV &v)
{
    if (v.isNil())
        npe();
    std::string s = javaTrim(S(v));
    auto bad = [&]() -> double { jthrow("java.lang.NumberFormatException", s.empty() ? "empty String" : "For input string: \"" + S(v) + "\""); };
    if (s.empty())
        bad();
    if (s == "NaN")
        return NAN;
    if (s == "Infinity" || s == "+Infinity")
        return INFINITY;
    if (s == "-Infinity")
        return -INFINITY;
    std::string t = s;
    if (!t.empty() && (t.back() == 'd' || t.back() == 'D' || t.back() == 'f' || t.back() == 'F'))
        t.pop_back();
    for (char c : t)
        if (!(std::isdigit((unsigned char)c) || c == '.' || c == 'e' || c == 'E' || c == '+' || c == '-' || c == 'x' ||
              c == 'X' || c == 'p' || c == 'P' || std::isxdigit((unsigned char)c)))
            bad();
    char *end = nullptr;
    double d = std::strtod(t.c_str(), &end);
    if (!end || *end != '\0')
        bad();
    return d;
}

std::string primToString(const QV &v, char kind)
{
    switch (kind)
    {
    case 'C': return unitToUtf8((uint32_t)jint(v));
    case 'D': return javaDoubleToString(jdouble(v));
    case 'F': return javaFloatToString(jdouble(v));
    case 'Z': return v.isTruthy() ? "true" : "false";
    default: return v.isLong() ? std::to_string(v.asLong()) : javaUn(jop::VSTR, v).asString();
    }
}

int compareJavaDoubles(double a, double b)
{
    if (a < b)
        return -1;
    if (a > b)
        return 1;
    bool an = std::isnan(a), bn = std::isnan(b);
    if (an || bn)
        return an == bn ? 0 : (an ? 1 : -1);
    bool as = std::signbit(a), bs = std::signbit(b);
    return as == bs ? 0 : (as ? -1 : 1);
}
} // namespace

void registerJavaLibNatives(const std::function<void(const std::string &, QuantumNativeFunc)> &reg, VM *vm)
{
    (void)vm;
    // ── java.lang.String (receiver first) ──
    reg("__jn_String_new", [](std::vector<QV> a) -> QV
        {
        if (a.empty())
            return Str("");
        if (a[0].isString())
            return a[0];
        if (a[0].isArray())
        {
            // String(char[]) / String(char[], offset, count)
            const Array &arr = *a[0].asArray();
            int64_t off = a.size() > 1 ? jint(a[1]) : 0, cnt = a.size() > 2 ? jint(a[2]) : (int64_t)arr.size() - off;
            if (off < 0 || cnt < 0 || off + cnt > (int64_t)arr.size())
                jthrow("java.lang.StringIndexOutOfBoundsException",
                       "offset " + std::to_string(off) + ", count " + std::to_string(cnt) + ", length " + std::to_string(arr.size()));
            std::u16string u;
            for (int64_t i = off; i < off + cnt; ++i)
                u += (char16_t)jint(arr[(size_t)i]);
            return Str(fromU16(u));
        }
        if (a[0].isNil())
            npe();
        return Str(javaUn(jop::VSTR, a[0]).asString()); });
    reg("__jn_String_length", [](std::vector<QV> a) -> QV { return javaUn(jop::SLEN, arg(a, 0)); });
    reg("__jn_String_charAt", [](std::vector<QV> a) -> QV { return javaBin(jop::CHARAT, arg(a, 0), arg(a, 1)); });
    reg("__jn_String_isEmpty", [](std::vector<QV> a) -> QV { return B(S(arg(a, 0)).empty()); });
    reg("__jn_String_substring", [](std::vector<QV> a) -> QV
        {
        const std::string &s = S(arg(a, 0));
        int64_t b = jint(arg(a, 1));
        int64_t e = a.size() > 2 ? jint(a[2]) : (isAscii(s) ? (int64_t)s.size() : u16Length(s));
        return Str(u16Substr(s, b, e)); });
    reg("__jn_String_subSequence", [](std::vector<QV> a) -> QV
        { return Str(u16Substr(S(arg(a, 0)), jint(arg(a, 1)), jint(arg(a, 2)))); });
    reg("__jn_String_indexOf", [](std::vector<QV> a) -> QV
        { return I(indexOfUnits(S(arg(a, 0)), needleOf(arg(a, 1)), a.size() > 2 ? jint(a[2]) : 0)); });
    reg("__jn_String_lastIndexOf", [](std::vector<QV> a) -> QV
        {
        const std::string &s = S(arg(a, 0));
        return I(lastIndexOfUnits(s, needleOf(arg(a, 1)), a.size() > 2 ? jint(a[2]) : u16Length(s))); });
    reg("__jn_String_contains", [](std::vector<QV> a) -> QV
        { return B(S(arg(a, 0)).find(S(arg(a, 1))) != std::string::npos); });
    reg("__jn_String_startsWith", [](std::vector<QV> a) -> QV
        {
        const std::string &s = S(arg(a, 0));
        const std::string &p = S(arg(a, 1));
        if (a.size() > 2)
        {
            int64_t off = jint(a[2]);
            std::u16string u = toU16(s), pu = toU16(p);
            if (off < 0 || off > (int64_t)u.size())
                return B(false);
            return B(u.compare((size_t)off, pu.size(), pu) == 0 && (size_t)off + pu.size() <= u.size());
        }
        return B(s.compare(0, p.size(), p) == 0 && p.size() <= s.size()); });
    reg("__jn_String_endsWith", [](std::vector<QV> a) -> QV
        {
        const std::string &s = S(arg(a, 0));
        const std::string &p = S(arg(a, 1));
        return B(p.size() <= s.size() && s.compare(s.size() - p.size(), p.size(), p) == 0); });
    reg("__jn_String_equals", [](std::vector<QV> a) -> QV
        {
        if (arg(a, 0).isNil())
            npe();
        return B(arg(a, 1).isString() && arg(a, 0).asString() == arg(a, 1).asString()); });
    reg("__jn_String_equalsIgnoreCase", [](std::vector<QV> a) -> QV
        {
        if (!arg(a, 1).isString())
            return B(false);
        return B(lower(S(arg(a, 0))) == lower(arg(a, 1).asString())); });
    reg("__jn_String_compareTo", [](std::vector<QV> a) -> QV
        {
        if (arg(a, 1).isNil())
            npe();
        return I(compareStrings(S(arg(a, 0)), S(arg(a, 1)))); });
    reg("__jn_String_compareToIgnoreCase", [](std::vector<QV> a) -> QV
        { return I(compareStrings(lower(S(arg(a, 0))), lower(S(arg(a, 1))))); });
    reg("__jn_String_toUpperCase", [](std::vector<QV> a) -> QV { return Str(upper(S(arg(a, 0)))); });
    reg("__jn_String_toLowerCase", [](std::vector<QV> a) -> QV { return Str(lower(S(arg(a, 0)))); });
    reg("__jn_String_trim", [](std::vector<QV> a) -> QV { return Str(javaTrim(S(arg(a, 0)))); });
    auto strip = [](const std::string &s, bool lead, bool trail)
    {
        std::u16string u = toU16(s);
        size_t b = 0, e = u.size();
        if (lead)
            while (b < e && jisWhitespace(u[b]))
                ++b;
        if (trail)
            while (e > b && jisWhitespace(u[e - 1]))
                --e;
        return fromU16(u.substr(b, e - b));
    };
    reg("__jn_String_strip", [strip](std::vector<QV> a) -> QV { return Str(strip(S(arg(a, 0)), true, true)); });
    reg("__jn_String_stripLeading", [strip](std::vector<QV> a) -> QV { return Str(strip(S(arg(a, 0)), true, false)); });
    reg("__jn_String_stripTrailing", [strip](std::vector<QV> a) -> QV { return Str(strip(S(arg(a, 0)), false, true)); });
    reg("__jn_String_isBlank", [strip](std::vector<QV> a) -> QV { return B(strip(S(arg(a, 0)), true, true).empty()); });
    reg("__jn_String_replace", [](std::vector<QV> a) -> QV
        {
        const std::string &s = S(arg(a, 0));
        std::string from = needleOf(arg(a, 1)), to = needleOf(arg(a, 2));
        if (from.empty())
        {
            // "" matches between every character
            std::u16string u = toU16(s);
            std::string out = to;
            for (char16_t c : u)
                out += fromU16(std::u16string(1, c)) + to;
            return Str(out);
        }
        std::string out;
        size_t pos = 0;
        while (true)
        {
            size_t at = s.find(from, pos);
            if (at == std::string::npos)
                break;
            out += s.substr(pos, at - pos) + to;
            pos = at + from.size();
        }
        out += s.substr(pos);
        return Str(out); });
    reg("__jn_String_replaceAll", [](std::vector<QV> a) -> QV
        { return Str(std::regex_replace(S(arg(a, 0)), makeRegex(S(arg(a, 1))), replacementFormat(S(arg(a, 2))))); });
    reg("__jn_String_replaceFirst", [](std::vector<QV> a) -> QV
        {
        return Str(std::regex_replace(S(arg(a, 0)), makeRegex(S(arg(a, 1))), replacementFormat(S(arg(a, 2))),
