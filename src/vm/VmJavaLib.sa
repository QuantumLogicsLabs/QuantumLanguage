    reg("__jn_String_matches", [](std::vector<QV> a) -> QV
        { return B(std::regex_match(S(arg(a, 0)), makeRegex(S(arg(a, 1))))); });
    // java.util.regex.Pattern: (regex, flags, input, from, mode 0 find / 1 matches / 2 lookingAt)
    // -> [start0, end0, start1, end1, ...] (-1 for a group that did not take part), or null
    reg("__jn_Pattern_$match", [](std::vector<QV> a) -> QV
        {
        const std::string &s = S(arg(a, 2));
        std::regex rx = makeRegex(S(arg(a, 0)), jint(arg(a, 1)));
        int mode = (int)jint(arg(a, 4));
        size_t fromByte = mode == 0 ? u16IndexToByte(s, jint(arg(a, 3))) : 0;
        std::smatch m;
        auto begin = s.cbegin() + (std::ptrdiff_t)fromByte;
        bool ok;
        if (mode == 1)
            ok = std::regex_match(s.cbegin(), s.cend(), m, rx);
        else if (mode == 2)
            ok = std::regex_search(s.cbegin(), s.cend(), m, rx, std::regex_constants::match_continuous);
        else
            ok = std::regex_search(begin, s.cend(), m, rx,
                                   fromByte > 0 ? std::regex_constants::match_prev_avail : std::regex_constants::match_default);
        if (!ok)
            return QV();
        auto arr = std::make_shared<Array>();
        for (size_t g = 0; g < m.size(); ++g)
        {
            if (!m[g].matched)
            {
                arr->push_back(I(-1));
                arr->push_back(I(-1));
                continue;
            }
            arr->push_back(I(byteToU16Index(s, (size_t)(m[g].first - s.cbegin()))));
            arr->push_back(I(byteToU16Index(s, (size_t)(m[g].second - s.cbegin()))));
        }
        return QV(arr); });
    reg("__jn_Pattern_$check", [](std::vector<QV> a) -> QV
        {
        makeRegex(S(arg(a, 0)), jint(arg(a, 1)));
        return QV(); });
    reg("__jn_Pattern_$groupCount", [](std::vector<QV> a) -> QV
        { return I((int64_t)makeRegex(S(arg(a, 0))).mark_count()); });
    reg("__jn_String_split", [](std::vector<QV> a) -> QV
        {
        auto parts = javaSplit(S(arg(a, 0)), S(arg(a, 1)), a.size() > 2 ? jint(a[2]) : 0);
        auto arr = std::make_shared<Array>();
        for (auto &p : parts)
            arr->push_back(QV(p));
        return QV(arr); });
    reg("__jn_String_toCharArray", [](std::vector<QV> a) -> QV
        {
        const std::string &s = S(arg(a, 0));
        auto arr = std::make_shared<Array>();
        if (isAscii(s))
        {
            arr->reserve(s.size());
            for (unsigned char c : s)
                arr->push_back(jlong(c));
        }
        else
            for (char16_t c : toU16(s))
                arr->push_back(jlong(c));
        return QV(arr); });
    reg("__jn_String_hashCode", [](std::vector<QV> a) -> QV
        {
        const std::string &s = S(arg(a, 0));
        int32_t h = 0;
        if (isAscii(s))
            for (unsigned char c : s)
                h = (int32_t)((uint32_t)h * 31u + c);
        else
            for (char16_t c : toU16(s))
                h = (int32_t)((uint32_t)h * 31u + (uint32_t)c);
        return I(h); });
    reg("__jn_String_repeat", [](std::vector<QV> a) -> QV
        {
        int64_t n = jint(arg(a, 1));
        if (n < 0)
            jthrow("java.lang.IllegalArgumentException", "count is negative: " + std::to_string(n));
        std::string out;
        const std::string &s = S(arg(a, 0));
        out.reserve(s.size() * (size_t)n);
        for (int64_t i = 0; i < n; ++i)
            out += s;
        return Str(out); });
    reg("__jn_String_concat", [](std::vector<QV> a) -> QV { return Str(S(arg(a, 0)) + S(arg(a, 1))); });
    reg("__jn_String_codePointAt", [](std::vector<QV> a) -> QV
        {
        std::u16string u = toU16(S(arg(a, 0)));
        int64_t i = jint(arg(a, 1));
        if (i < 0 || i >= (int64_t)u.size())
            jthrow("java.lang.StringIndexOutOfBoundsException", "Index " + std::to_string(i) + " out of bounds for length " + std::to_string(u.size()));
        uint32_t c = u[(size_t)i];
        if (c >= 0xD800 && c <= 0xDBFF && (size_t)i + 1 < u.size() && u[(size_t)i + 1] >= 0xDC00 && u[(size_t)i + 1] <= 0xDFFF)
            return I(0x10000 + ((c - 0xD800) << 10) + (u[(size_t)i + 1] - 0xDC00));
        return I(c); });
    reg("__jn_String_valueOfChars", [](std::vector<QV> a) -> QV
        {
        if (!arg(a, 0).isArray())
            npe();
        const Array &arr = *arg(a, 0).asArray();
        int64_t off = a.size() > 1 ? jint(a[1]) : 0, cnt = a.size() > 2 ? jint(a[2]) : (int64_t)arr.size() - off;
        if (off < 0 || cnt < 0 || off + cnt > (int64_t)arr.size())
            jthrow("java.lang.StringIndexOutOfBoundsException", "offset " + std::to_string(off) + ", count " + std::to_string(cnt) + ", length " + std::to_string(arr.size()));
        std::u16string u;
        for (int64_t i = off; i < off + cnt; ++i)
            u += (char16_t)jint(arr[(size_t)i]);
        return Str(fromU16(u)); });

    // ── java.lang.StringBuilder: the text is the instance field "$s" ──
    auto sbText = [](const QV &self) -> std::string &
    {
        if (!self.isInstance())
            npe();
        QV &f = self.asInstance()->fields["$s"];
        if (!f.isString())
            f = QV(std::string());
        return f.mutString();
    };
    // Whether the text is all ASCII (one char per byte). The field "$k" holds
    // the length of a prefix already checked: append only adds bytes, so a
    // loop of length() / charAt() checks each byte once rather than the whole
    // text on every call. Any other edit starts the check over.
    auto sbAscii = [sbText](const QV &self) -> bool
    {
        std::string &s = sbText(self);
        QV &k = self.asInstance()->fields["$k"];
        size_t from = k.isNil() ? 0 : (size_t)jint(k);
        if (from > s.size())
            from = 0;
        for (size_t i = from; i < s.size(); ++i)
            if ((unsigned char)s[i] >= 0x80)
