void Interp::initMath()
{
    RClass *m = mMath;
    setConst(m, intern("PI"), flo(3.141592653589793));
    setConst(m, intern("E"), flo(2.718281828459045));
    auto mf = [&](const char *name, NativeFn fn, int mn, int mx)
    {
        defs(m, name, fn, mn, mx);
        defnPriv(m, name, fn, mn, mx);
    };
    mf("sqrt", m_sqrt, 1, 1);
    mf("cbrt", m_cbrt, 1, 1);
    mf("sin", m_sin, 1, 1);
    mf("cos", m_cos, 1, 1);
    mf("tan", m_tan, 1, 1);
    mf("asin", m_asin, 1, 1);
    mf("acos", m_acos, 1, 1);
    mf("atan", m_atan, 1, 1);
    mf("atan2", m_atan2, 2, 2);
    mf("sinh", m_sinh, 1, 1);
    mf("cosh", m_cosh, 1, 1);
    mf("tanh", m_tanh, 1, 1);
    mf("exp", m_exp, 1, 1);
    mf("log", m_log, 1, 2);
    mf("log2", m_log2, 1, 1);
    mf("log10", m_log10, 1, 1);
    mf("hypot", m_hypot, 2, 2);
    mf("pow", m_pow, 2, 2);
    mf("gamma", m_gamma, 1, 1);
    mf("acosh", m_acosh, 1, 1);
    mf("asinh", m_asinh, 1, 1);
    mf("atanh", m_atanh, 1, 1);
    mf("erf", m_erf, 1, 1);
    mf("erfc", m_erfc, 1, 1);
    mf("frexp", m_frexp, 1, 1);
    mf("ldexp", m_ldexp, 2, 2);
    mf("lgamma", m_lgamma, 1, 1);
}

// float stepping for Range#step (RubyEnum.sa)
void rubyFloatStep(Interp &I, double beg, double end, double unit, bool excl, Blk *blk, V *collect)
{
    floatStep(I, beg, end, unit, excl, blk, collect);
}

