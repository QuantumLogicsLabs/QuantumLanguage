    defn(c, "replace", str_replace, 1, 1);
    defn(c, "clear", str_clear, 0, 0);
    defn(c, "succ", str_succ, 0, 0);
    defn(c, "next", str_succ, 0, 0);
    defn(c, "upto", str_upto, 1, 2);
    defn(c, "casecmp", str_casecmp, 1, 1);
    defn(c, "casecmp?", str_casecmp_p, 1, 1);
    defn(c, "partition", str_partition, 1, 1);
    defn(c, "rpartition", str_rpartition, 1, 1);
    defn(c, "encoding", str_encoding, 0, 0);
    defn(c, "force_encoding", str_force_encoding, 1, 1);
    defn(c, "encode", str_encode, 0, -1);
    defn(c, "encode!", str_force_encoding, 0, -1);
    defn(c, "valid_encoding?", str_valid_encoding, 0, 0);
    defn(c, "ascii_only?", str_ascii_only, 0, 0);
    defn(c, "b", str_b, 0, 0);
    defn(c, "scrub", str_scrub, 0, 1);
    defn(c, "unicode_normalize", str_unicode_normalize, 0, 1);
    defn(c, "sum", str_sum, 0, 1);
    defn(c, "between?", str_between, 2, 2);
    defn(c, "unpack1", str_unpack1, 1, 1);
    defn(c, "unpack", str_unpack, 1, 1);
    RClass *enc = cEncoding;
    auto encoding = [&](const char *name, const char *display)
    {
        V e = newObject(enc);
        ivarSet(e, intern("__name"), strFrozen(name));
        ivarSet(e, intern("__display"), strFrozen(display));
        return e;
    };
    V bin = encoding("ASCII-8BIT", "BINARY (ASCII-8BIT)");
    setConst(enc, intern("UTF_8"), encoding("UTF-8", "UTF-8"));
    setConst(enc, intern("ASCII_8BIT"), bin);
    setConst(enc, intern("BINARY"), bin);
    setConst(enc, intern("US_ASCII"), encoding("US-ASCII", "US-ASCII"));
}

static V enc_to_s(Interp &I, V self, Args &a)
{
    (void)a;
    return I.ivarGet(self, intern("__name"));
}

static V enc_inspect(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str("#<Encoding:" + I.sref(I.ivarGet(self, intern("__display"))) + ">");
}

void Interp::initSymbol()
{
    RClass *c = cSymbol;
    defn(c, "to_s", sym_to_s, 0, 0);
    defn(c, "id2name", sym_to_s, 0, 0);
    defn(c, "name", sym_name, 0, 0);
    defn(c, "to_sym", sym_to_sym, 0, 0);
    defn(c, "inspect", sym_inspect, 0, 0);
    defn(c, "to_proc", sym_to_proc, 0, 0);
    defn(c, "length", sym_length, 0, 0);
    defn(c, "size", sym_length, 0, 0);
    defn(c, "<=>", sym_cmp, 1, 1);
    defn(c, "==", sym_eq, 1, 1);
    defn(c, "===", sym_eq, 1, 1);
    defn(c, "upcase", sym_upcase, 0, 0);
    defn(c, "downcase", sym_downcase, 0, 0);
    defn(c, "capitalize", sym_capitalize, 0, 0);
    defn(c, "succ", sym_succ, 0, 0);
    defn(c, "next", sym_succ, 0, 0);
    defn(c, "[]", sym_aref, 1, 2);
    defn(c, "start_with?", sym_start_with, 0, -1);
    defn(c, "end_with?", sym_end_with, 0, -1);
    defn(c, "empty?", sym_empty, 0, 0);
    defs(c, "all_symbols", sym_all, 0, 0);
    defn(cEncoding, "to_s", enc_to_s, 0, 0);
    defn(cEncoding, "name", enc_to_s, 0, 0);
    defn(cEncoding, "inspect", enc_inspect, 0, 0);
}

