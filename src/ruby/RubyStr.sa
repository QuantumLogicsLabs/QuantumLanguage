    defn(c, "*", str_mul, 1, 1);
    defn(c, "%", str_format, 1, 1);
    defn(c, "==", str_eq, 1, 1);
    defn(c, "===", str_eq, 1, 1);
    defn(c, "eql?", str_eql, 1, 1);
    defn(c, "<=>", str_cmp, 1, 1);
    defn(c, "hash", str_hash, 0, 0);
    defn(c, "to_s", str_to_s, 0, 0);
    defn(c, "to_str", str_to_s, 0, 0);
    defn(c, "inspect", str_inspect, 0, 0);
    defn(c, "dump", str_dump, 0, 0);
    defn(c, "to_sym", str_to_sym, 0, 0);
    defn(c, "intern", str_to_sym, 0, 0);
    defn(c, "to_i", str_to_i, 0, 1);
    defn(c, "to_f", str_to_f, 0, 0);
    defn(c, "to_r", str_to_r, 0, 0);
    defn(c, "to_c", str_to_c, 0, 0);
    defn(c, "hex", str_hex, 0, 0);
    defn(c, "oct", str_oct, 0, 0);
    defn(c, "[]", str_aref, 1, 2);
    defn(c, "slice", str_aref, 1, 2);
    defn(c, "[]=", str_aset, 2, 3);
    defn(c, "slice!", str_slice_bang, 1, 2);
    defn(c, "upcase", str_upcase, 0, -1);
    defn(c, "downcase", str_downcase, 0, -1);
    defn(c, "capitalize", str_capitalize, 0, -1);
    defn(c, "swapcase", str_swapcase, 0, -1);
    defn(c, "upcase!", str_upcase_bang, 0, -1);
    defn(c, "downcase!", str_downcase_bang, 0, -1);
