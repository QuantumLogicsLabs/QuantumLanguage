}

std::string reverseStr(const std::string &s)
{
    if (asciiOnly(s))
        return std::string(s.rbegin(), s.rend());
    std::vector<std::string> cs = utf8Chars(s);
    std::string out;
    for (size_t i = cs.size(); i-- > 0;)
        out += cs[i];
    return out;
}

V str_reverse(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str(reverseStr(S(I, self)));
}

V str_reverse_bang(Interp &I, V self, Args &a)
{
    (void)a;
    modify(I, self);
    S(I, self) = reverseStr(S(I, self));
    return self;
}

V str_include(Interp &I, V self, Args &a) { return boolv(S(I, self).find(argStr(I, a.argv[0])) != std::string::npos); }

V str_start_with(Interp &I, V self, Args &a)
{
    const std::string &s = S(I, self);
    for (int i = 0; i < a.argc; ++i)
    {
        V p = a.argv[i];
        if (isType(p, T::Regexp))
        {
            std::vector<int> caps;
            if (regexMatchAt(static_cast<RRegexp *>(op(p))->re, s, 0, caps))
            {
                I.lastMatch = matchData(I, self, static_cast<RRegexp *>(op(p)), caps);
                return Qtrue;
            }
            continue;
        }
        const std::string &t = argStr(I, p);
        if (s.compare(0, t.size(), t) == 0 && s.size() >= t.size())
            return Qtrue;
    }
    return Qfalse;
}

V str_end_with(Interp &I, V self, Args &a)
{
    const std::string &s = S(I, self);
    for (int i = 0; i < a.argc; ++i)
    {
        std::string t = argStr(I, a.argv[i]);
        if (s.size() >= t.size() && s.compare(s.size() - t.size(), t.size(), t) == 0)
            return Qtrue;
    }
    return Qfalse;
}

V str_delete_prefix(Interp &I, V self, Args &a)
{
    const std::string &s = S(I, self);
    std::string t = argStr(I, a.argv[0]);
    if (s.size() >= t.size() && s.compare(0, t.size(), t) == 0)
        return I.str(s.substr(t.size()));
    return I.str(s);
}

V str_delete_suffix(Interp &I, V self, Args &a)
{
    const std::string &s = S(I, self);
    std::string t = argStr(I, a.argv[0]);
    if (s.size() >= t.size() && s.compare(s.size() - t.size(), t.size(), t) == 0)
        return I.str(s.substr(0, s.size() - t.size()));
    return I.str(s);
}

V str_delete_prefix_bang(Interp &I, V self, Args &a) { return bangResult(I, self, S(I, str_delete_prefix(I, self, a))); }
V str_delete_suffix_bang(Interp &I, V self, Args &a) { return bangResult(I, self, S(I, str_delete_suffix(I, self, a))); }

int64_t charIndexOf(const std::string &s, size_t byte)
{
    if (asciiOnly(s))
        return (int64_t)byte;
    return (int64_t)utf8Len(s.substr(0, byte));
}

V str_index(Interp &I, V self, Args &a)
{
    const std::string &s = S(I, self);
    bool ascii = strBytewise(self);
    int64_t n = strChars(self);
    int64_t start = a.argc > 1 ? I.intOf(a.argv[1]) : 0;
    if (start < 0)
        start += n;
    if (start < 0 || start > n)
        return Qnil;
    size_t from = byteOf(s, (size_t)start, ascii);
    V p = a.argv[0];
    if (isType(p, T::Regexp))
    {
        std::vector<int> caps;
        if (!regexSearch(static_cast<RRegexp *>(op(p))->re, s, from, caps))
        {
            I.lastMatch = Qnil;
            return Qnil;
        }
        I.lastMatch = matchData(I, self, static_cast<RRegexp *>(op(p)), caps);
        return fix(ascii ? (int64_t)caps[0] : charIndexOf(s, caps[0]));
    }
    size_t pos = s.find(argStr(I, p), from);
    if (pos == std::string::npos)
        return Qnil;
    return fix(ascii ? (int64_t)pos : charIndexOf(s, pos));
}

V str_rindex(Interp &I, V self, Args &a)
{
    const std::string &s = S(I, self);
    bool ascii = strBytewise(self);
    int64_t n = strChars(self);
    int64_t start = a.argc > 1 ? I.intOf(a.argv[1]) : n;
    if (start < 0)
        start += n;
    if (start < 0)
        return Qnil;
    if (start > n)
        start = n;
    size_t from = byteOf(s, (size_t)start, ascii);
    V p = a.argv[0];
    if (isType(p, T::Regexp))
    {
        Regex *re = static_cast<RRegexp *>(op(p))->re;
        std::vector<int> caps;
        for (size_t pos = from + 1; pos-- > 0;)
        {
            if (pos < s.size() && ((unsigned char)s[pos] & 0xC0) == 0x80)
                continue;
            if (regexMatchAt(re, s, pos, caps))
            {
                I.lastMatch = matchData(I, self, static_cast<RRegexp *>(op(p)), caps);
                return fix(charIndexOf(s, pos));
            }
        }
        return Qnil;
    }
    size_t pos = s.rfind(argStr(I, p), from);
    if (pos == std::string::npos)
        return Qnil;
    return fix(ascii ? (int64_t)pos : charIndexOf(s, pos));
}

V str_count(Interp &I, V self, Args &a)
{
    std::vector<CharSet> sets = setsFrom(I, a);
    const std::string &s = S(I, self);
    int64_t n = 0;
    size_t i = 0;
    while (i < s.size())
    {
        size_t len;
        uint32_t c = decodeAt(s, i, &len);
        if (inAllSets(sets, c))
            ++n;
        i += len;
    }
    return fix(n);
}

std::string deleteChars(const std::string &s, const std::vector<CharSet> &sets)
{
    std::string out;
    size_t i = 0;
    while (i < s.size())
    {
        size_t len;
        uint32_t c = decodeAt(s, i, &len);
        if (!inAllSets(sets, c))
            out += s.substr(i, len);
        i += len;
    }
    return out;
}

V str_delete(Interp &I, V self, Args &a) { return I.str(deleteChars(S(I, self), setsFrom(I, a))); }
V str_delete_bang(Interp &I, V self, Args &a) { return bangResult(I, self, deleteChars(S(I, self), setsFrom(I, a))); }

std::string squeezeStr(Interp &I, const std::string &s, Args &a)
{
    std::vector<CharSet> sets;
    if (a.argc > 0)
        sets = setsFrom(I, a);
    std::string out;
    size_t i = 0;
    uint32_t last = 0xFFFFFFFF;
    while (i < s.size())
    {
        size_t len;
        uint32_t c = decodeAt(s, i, &len);
        if (!(c == last && (sets.empty() || inAllSets(sets, c))))
            out += s.substr(i, len);
        last = c;
        i += len;
    }
    return out;
}

V str_squeeze(Interp &I, V self, Args &a) { return I.str(squeezeStr(I, S(I, self), a)); }
V str_squeeze_bang(Interp &I, V self, Args &a) { return bangResult(I, self, squeezeStr(I, S(I, self), a)); }

V str_tr(Interp &I, V self, Args &a) { return I.str(trString(S(I, self), argStr(I, a.argv[0]), argStr(I, a.argv[1]), false)); }
V str_tr_s(Interp &I, V self, Args &a) { return I.str(trString(S(I, self), argStr(I, a.argv[0]), argStr(I, a.argv[1]), true)); }
V str_tr_bang(Interp &I, V self, Args &a) { return bangResult(I, self, trString(S(I, self), argStr(I, a.argv[0]), argStr(I, a.argv[1]), false)); }

bool isSpaceC(char c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v' || c == 0; }

std::string stripStr(const std::string &s, bool left, bool right)
{
    size_t b = 0, e = s.size();
    if (left)
        while (b < e && isSpaceC(s[b]))
            ++b;
    if (right)
        while (e > b && isSpaceC(s[e - 1]))
            --e;
    return s.substr(b, e - b);
}

V str_strip(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str(stripStr(S(I, self), true, true));
}
V str_lstrip(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str(stripStr(S(I, self), true, false));
}
V str_rstrip(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str(stripStr(S(I, self), false, true));
}
V str_strip_bang(Interp &I, V self, Args &a)
{
    (void)a;
    return bangResult(I, self, stripStr(S(I, self), true, true));
}
V str_lstrip_bang(Interp &I, V self, Args &a)
{
    (void)a;
    return bangResult(I, self, stripStr(S(I, self), true, false));
}
V str_rstrip_bang(Interp &I, V self, Args &a)
{
    (void)a;
    return bangResult(I, self, stripStr(S(I, self), false, true));
}

std::string chompStr(Interp &I, const std::string &s, Args &a)
{
    if (a.argc > 0)
    {
        if (a.argv[0] == Qnil)
            return s;
        std::string t = argStr(I, a.argv[0]);
        if (t.empty())
        {
            std::string r = s;
            while (!r.empty() && r.back() == '\n')
            {
                r.pop_back();
                if (!r.empty() && r.back() == '\r')
                    r.pop_back();
            }
            return r;
        }
        if (s.size() >= t.size() && s.compare(s.size() - t.size(), t.size(), t) == 0)
            return s.substr(0, s.size() - t.size());
        return s;
    }
    if (!s.empty() && s.back() == '\n')
    {
        if (s.size() >= 2 && s[s.size() - 2] == '\r')
            return s.substr(0, s.size() - 2);
        return s.substr(0, s.size() - 1);
    }
    if (!s.empty() && s.back() == '\r')
        return s.substr(0, s.size() - 1);
    return s;
}

V str_chomp(Interp &I, V self, Args &a) { return I.str(chompStr(I, S(I, self), a)); }
V str_chomp_bang(Interp &I, V self, Args &a) { return bangResult(I, self, chompStr(I, S(I, self), a)); }

std::string chopStr(const std::string &s)
{
    if (s.empty())
        return s;
    if (s.size() >= 2 && s[s.size() - 2] == '\r' && s.back() == '\n')
        return s.substr(0, s.size() - 2);
    size_t i = s.size() - 1;
    while (i > 0 && ((unsigned char)s[i] & 0xC0) == 0x80)
        --i;
    return s.substr(0, i);
}

V str_chop(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str(chopStr(S(I, self)));
}
V str_chop_bang(Interp &I, V self, Args &a)
{
    (void)a;
    return bangResult(I, self, chopStr(S(I, self)));
}

V str_chars(Interp &I, V self, Args &a)
{
    (void)a;
    V out = I.ary();
    const std::string &s = S(I, self);
    std::vector<V> &v = I.aref(out);
    if (strBinary(self) || asciiOnly(s))
    {
        v.reserve(s.size());
        for (char c : s)
        {
            V one = I.str(std::string(1, c));
            static_cast<RString *>(op(one))->binary = strBinary(self);
            v.push_back(one);
        }
    }
    else
        for (auto &c : utf8Chars(s))
            v.push_back(I.str(c));
    return out;
}

V str_each_char(Interp &I, V self, Args &a)
{
    if (!a.blk)
    {
        V av = I.sym("each_char");
        return I.call(self, I.s.to_enum, 1, &av);
    }
    V chars = str_chars(I, self, a);
    for (V c : I.aref(chars))
        I.yield(a.blk, c);
    return self;
}

V str_bytes(Interp &I, V self, Args &a)
{
    (void)a;
    V out = I.ary();
    for (char c : S(I, self))
        I.aref(out).push_back(fix((unsigned char)c));
    return out;
}

V str_each_byte(Interp &I, V self, Args &a)
{
    V bytes = str_bytes(I, self, a);
    if (!a.blk)
        return I.call0(bytes, I.s.each);
    for (V b : I.aref(bytes))
        I.yield(a.blk, b);
    return self;
}

V str_codepoints(Interp &I, V self, Args &a)
{
    (void)a;
    V out = I.ary();
    for (uint32_t c : codepoints(S(I, self)))
        I.aref(out).push_back(fix(c));
    return out;
}

V str_getbyte(Interp &I, V self, Args &a)
{
    const std::string &s = S(I, self);
    int64_t i = I.intOf(a.argv[0]);
    if (i < 0)
        i += (int64_t)s.size();
    if (i < 0 || i >= (int64_t)s.size())
        return Qnil;
    return fix((unsigned char)s[i]);
}

std::vector<std::string> linesOf(const std::string &s, const std::string &sep, bool chomp)
{
    std::vector<std::string> out;
    size_t i = 0;
    while (i < s.size())
    {
        size_t p = s.find(sep, i);
        if (p == std::string::npos)
        {
            out.push_back(s.substr(i));
            break;
        }
        out.push_back(s.substr(i, chomp ? p - i : p + sep.size() - i));
        i = p + sep.size();
    }
    return out;
}

V str_lines(Interp &I, V self, Args &a)
{
    RHash *kw = kwArg(a);
    int argc = kw ? a.argc - 1 : a.argc;
    bool chomp = false;
    if (kw)
    {
        bool found = false;
        V c = I.hget(kw, I.sym("chomp"), &found);
        chomp = found && truthy(c);
    }
    std::string sep = argc > 0 ? argStr(I, a.argv[0]) : "\n";
    V out = I.ary();
    for (auto &l : linesOf(S(I, self), sep, chomp))
        I.aref(out).push_back(I.str(l));
    return out;
}

V str_each_line(Interp &I, V self, Args &a)
{
    V lines = str_lines(I, self, a);
    if (!a.blk)
        return I.call0(lines, I.s.each);
    for (V l : I.aref(lines))
        I.yield(a.blk, l);
    return self;
}

V str_split(Interp &I, V self, Args &a)
{
    const std::string &s = S(I, self);
    V pat = a.argc > 0 ? a.argv[0] : Qnil;
    int64_t limit = a.argc > 1 ? I.intOf(a.argv[1]) : 0;
    std::vector<std::string> parts;
    bool awk = pat == Qnil || (I.isStr(pat) && S(I, pat) == " ");
    if (awk)
    {
        size_t i = 0;
        while (i < s.size() && isSpaceC(s[i]))
            ++i;
        while (i < s.size())
        {
            if (limit > 0 && (int64_t)parts.size() == limit - 1)
            {
                parts.push_back(s.substr(i));
                i = s.size();
                break;
            }
            size_t j = i;
            while (j < s.size() && !isSpaceC(s[j]))
                ++j;
            parts.push_back(s.substr(i, j - i));
            i = j;
            while (i < s.size() && isSpaceC(s[i]))
                ++i;
            if (i == s.size() && j < s.size() && limit < 0)
                parts.push_back("");
        }
    }
    else if (I.isStr(pat))
    {
        const std::string &sep = S(I, pat);
        if (sep.empty())
        {
            std::vector<std::string> cs = utf8Chars(s);
            for (size_t k = 0; k < cs.size(); ++k)
            {
                if (limit > 0 && (int64_t)parts.size() == limit - 1)
                {
                    std::string rest;
                    for (size_t m = k; m < cs.size(); ++m)
                        rest += cs[m];
                    parts.push_back(rest);
                    break;
                }
                parts.push_back(cs[k]);
            }
        }
        else
        {
            size_t i = 0;
            for (;;)
            {
                if (limit > 0 && (int64_t)parts.size() == limit - 1)
                {
                    parts.push_back(s.substr(i));
                    break;
                }
                size_t p = s.find(sep, i);
                if (p == std::string::npos)
                {
                    parts.push_back(s.substr(i));
                    break;
                }
                parts.push_back(s.substr(i, p - i));
                i = p + sep.size();
            }
        }
    }
    else if (isType(pat, T::Regexp))
    {
        RRegexp *re = static_cast<RRegexp *>(op(pat));
        std::vector<int> caps;
        size_t start = 0, searchFrom = 0;
        while (searchFrom <= s.size())
        {
            if (limit > 0 && (int64_t)parts.size() >= limit - 1)
                break;
            if (!regexSearch(re->re, s, searchFrom, caps))
                break;
            size_t mb = caps[0], me = caps[1];
            if (me == mb)
            {
                // an empty match splits between characters
                if (mb >= s.size())
                    break;
                if (mb == start)
                {
                    searchFrom = mb + u8len((unsigned char)s[mb]);
                    if (mb == 0 && start == 0)
                    {
                        // nothing before the first character
                    }
                    parts.push_back(s.substr(start, searchFrom - start));
                    start = searchFrom;
                    continue;
                }
            }
            parts.push_back(s.substr(start, mb - start));
            for (size_t g = 1; g * 2 + 1 < caps.size(); ++g)
                if (caps[g * 2] >= 0)
                    parts.push_back(s.substr(caps[g * 2], caps[g * 2 + 1] - caps[g * 2]));
            start = me;
            searchFrom = me == mb ? me + u8len((unsigned char)s[me]) : me;
        }
        parts.push_back(s.substr(start < s.size() ? start : s.size()));
    }
    else
        I.typeError(pat, "String");
    if (limit == 0)
        while (!parts.empty() && parts.back().empty())
            parts.pop_back();
    V out = I.ary();
    for (auto &p : parts)
        I.aref(out).push_back(I.str(p));
    if (a.blk)
    {
        for (V x : I.aref(out))
            I.yield(a.blk, x);
        return self;
    }
    return out;
}

std::string padStr(Interp &I, const std::string &s, int64_t width, const std::string &pad, int where)
{
    if (pad.empty())
        I.raise(I.cArgumentError, "zero width padding");
    int64_t n = (int64_t)utf8Len(s);
    if (width <= n)
        return s;
    int64_t total = width - n;
    std::vector<std::string> pc = utf8Chars(pad);
    auto make = [&](int64_t count) -> std::string
    {
        std::string out;
        for (int64_t i = 0; i < count; ++i)
            out += pc[i % pc.size()];
        return out;
    };
    if (where < 0)
        return s + make(total);
    if (where > 0)
        return make(total) + s;
    int64_t left = total / 2, right = total - left;
    return make(left) + s + make(right);
}

V str_ljust(Interp &I, V self, Args &a)
{
    return I.str(padStr(I, S(I, self), I.intOf(a.argv[0]), a.argc > 1 ? argStr(I, a.argv[1]) : " ", -1));
}
V str_rjust(Interp &I, V self, Args &a)
{
    return I.str(padStr(I, S(I, self), I.intOf(a.argv[0]), a.argc > 1 ? argStr(I, a.argv[1]) : " ", 1));
}
V str_center(Interp &I, V self, Args &a)
{
    return I.str(padStr(I, S(I, self), I.intOf(a.argv[0]), a.argc > 1 ? argStr(I, a.argv[1]) : " ", 0));
}

V str_ord(Interp &I, V self, Args &a)
{
    (void)a;
    const std::string &s = S(I, self);
    if (s.empty())
        I.raise(I.cArgumentError, "empty string");
    if (strBinary(self))
        return fix((unsigned char)s[0]);
    return fix(decodeAt(s, 0, nullptr));
}

V str_chr(Interp &I, V self, Args &a)
{
    (void)a;
    const std::string &s = S(I, self);
    if (s.empty())
        return I.str("");
    return I.str(s.substr(0, u8len((unsigned char)s[0])));
}

V str_empty(Interp &I, V self, Args &a)
{
    (void)a;
    return boolv(S(I, self).empty());
}

V str_freeze(Interp &I, V self, Args &a)
{
    (void)I;
    (void)a;
    op(self)->frozen = true;
    return self;
}

V str_uminus(Interp &I, V self, Args &a)
{
    (void)a;
    if (op(self)->frozen)
        return self;
    return I.strFrozen(S(I, self));
}

V str_uplus(Interp &I, V self, Args &a)
{
    (void)a;
    if (op(self)->frozen)
        return I.str(S(I, self));
    return self;
}

V str_append(Interp &I, V self, Args &a)
{
    modify(I, self);
    V o = a.argv[0];
    if (isFix(o))
    {
        if (strBinary(self) && fixv(o) < 256)
            S(I, self) += (char)fixv(o);
        else
            appendUtf8(S(I, self), (uint32_t)fixv(o));
    }
    else
    {
        S(I, self) += argStr(I, o);
        if (I.isStr(o) && binaryJoin(I, o))
            static_cast<RString *>(op(self))->binary = true;
    }
    return self;
}

V str_concat(Interp &I, V self, Args &a)
{
    modify(I, self);
    std::string add;
    for (int i = 0; i < a.argc; ++i)
    {
        if (isFix(a.argv[i]))
            appendUtf8(add, (uint32_t)fixv(a.argv[i]));
        else
            add += argStr(I, a.argv[i]);
    }
    S(I, self) += add;
    return self;
}

V str_prepend(Interp &I, V self, Args &a)
{
    modify(I, self);
    std::string add;
    for (int i = 0; i < a.argc; ++i)
        add += argStr(I, a.argv[i]);
    S(I, self) = add + S(I, self);
    return self;
}

V str_insert(Interp &I, V self, Args &a)
{
    modify(I, self);
    std::string &s = S(I, self);
    int64_t idx = I.intOf(a.argv[0]);
    std::string t = argStr(I, a.argv[1]);
    bool ascii = asciiOnly(s);
    int64_t n = ascii ? (int64_t)s.size() : (int64_t)utf8Len(s);
    if (idx < 0)
        idx += n + 1;
    if (idx < 0 || idx > n)
        I.raise(I.cIndexError, "index " + std::to_string(I.intOf(a.argv[0])) + " out of string");
    size_t b = byteOf(s, (size_t)idx, ascii);
    s.insert(b, t);
    return self;
}

V str_replace(Interp &I, V self, Args &a)
{
    modify(I, self);
    S(I, self) = argStr(I, a.argv[0]);
    return self;
}

V str_clear(Interp &I, V self, Args &a)
{
    (void)a;
    modify(I, self);
    S(I, self).clear();
    return self;
}

std::string succStr(const std::string &src)
{
    std::string s = src;
    if (s.empty())
        return s;
    int i = (int)s.size() - 1;
    bool anyAlnum = false;
    for (char c : s)
        if (std::isalnum((unsigned char)c))
            anyAlnum = true;
    if (!anyAlnum)
    {
        for (int k = (int)s.size() - 1; k >= 0; --k)
        {
            unsigned char c = (unsigned char)s[k];
            if (c < 255)
            {
                s[k] = (char)(c + 1);
                return s;
            }
            s[k] = 0;
        }
        return std::string(1, '\x01') + s;
    }
    while (i >= 0 && !std::isalnum((unsigned char)s[i]))
        --i;
    for (;;)
    {
        char c = s[i];
        char carry = 0;
        if (c >= '0' && c <= '9')
        {
            if (c < '9')
            {
                s[i] = (char)(c + 1);
                return s;
            }
            s[i] = '0';
            carry = '1';
        }
        else if (c >= 'a' && c <= 'z')
        {
            if (c < 'z')
            {
                s[i] = (char)(c + 1);
                return s;
            }
            s[i] = 'a';
            carry = 'a';
        }
        else if (c >= 'A' && c <= 'Z')
        {
            if (c < 'Z')
            {
                s[i] = (char)(c + 1);
                return s;
            }
            s[i] = 'A';
            carry = 'A';
        }
        int j = i - 1;
        while (j >= 0 && !std::isalnum((unsigned char)s[j]))
            --j;
        if (j < 0)
        {
            s.insert(s.begin() + i, carry);
            return s;
        }
        i = j;
    }
}

V str_succ(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str(succStr(S(I, self)));
}

V str_upto(Interp &I, V self, Args &a)
{
    std::string cur = S(I, self);
    std::string last = argStr(I, a.argv[0]);
    bool excl = a.argc > 1 && truthy(a.argv[1]);
    if (!a.blk)
    {
        V av[3] = {I.sym("upto"), a.argv[0], boolv(excl)};
        return I.call(self, I.s.to_enum, 3, av);
    }
    if (cur.size() > last.size())
        return self;
    for (;;)
    {
        if (cur == last)
        {
            if (!excl)
                I.yield(a.blk, I.str(cur));
            break;
        }
        I.yield(a.blk, I.str(cur));
        cur = succStr(cur);
        if (cur.size() > last.size())
            break;
    }
    return self;
}

V str_casecmp(Interp &I, V self, Args &a)
{
    if (!I.isStr(a.argv[0]))
        return Qnil;
    return fix(rbByteCompare(downcaseStr(S(I, self)), downcaseStr(S(I, a.argv[0]))));
}

V str_casecmp_p(Interp &I, V self, Args &a)
{
    if (!I.isStr(a.argv[0]))
        return Qnil;
    return boolv(downcaseStr(S(I, self)) == downcaseStr(S(I, a.argv[0])));
}

V str_partition(Interp &I, V self, Args &a)
{
    const std::string &s = S(I, self);
    V p = a.argv[0];
    size_t pos, len;
    if (isType(p, T::Regexp))
    {
        std::vector<int> caps;
        if (!regexSearch(static_cast<RRegexp *>(op(p))->re, s, 0, caps))
            return I.ary(std::vector<V>{I.str(s), I.str(""), I.str("")});
        pos = caps[0];
        len = caps[1] - caps[0];
    }
    else
    {
        std::string t = argStr(I, p);
        pos = s.find(t);
        len = t.size();
        if (pos == std::string::npos)
            return I.ary(std::vector<V>{I.str(s), I.str(""), I.str("")});
    }
    return I.ary(std::vector<V>{I.str(s.substr(0, pos)), I.str(s.substr(pos, len)), I.str(s.substr(pos + len))});
}

V str_rpartition(Interp &I, V self, Args &a)
{
    const std::string &s = S(I, self);
    std::string t = argStr(I, a.argv[0]);
    size_t pos = s.rfind(t);
    if (pos == std::string::npos)
        return I.ary(std::vector<V>{I.str(""), I.str(""), I.str(s)});
    return I.ary(std::vector<V>{I.str(s.substr(0, pos)), I.str(t), I.str(s.substr(pos + t.size()))});
}

V str_encoding(Interp &I, V self, Args &a)
{
    (void)a;
    return I.constIn(I.cEncoding, intern(strBinary(self) ? "BINARY" : "UTF_8"), false);
}

V str_force_encoding(Interp &I, V self, Args &a)
{
    if (a.argc > 0)
    {
        std::string n = I.toS(a.argv[0]);
        static_cast<RString *>(op(self))->binary = n == "BINARY" || n == "ASCII-8BIT" || n == "binary";
    }
    return self;
}

V str_encode(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str(S(I, self));
}

V str_valid_encoding(Interp &I, V self, Args &a)
{
    (void)a;
    return boolv(validUtf8(S(I, self)));
}

V str_ascii_only(Interp &I, V self, Args &a)
{
    (void)a;
    return boolv(asciiOnly(S(I, self)));
}

V str_b(Interp &I, V self, Args &a)
{
    (void)a;
    V r = I.str(S(I, self));
    static_cast<RString *>(op(r))->binary = true;
    return r;
}

V str_scrub(Interp &I, V self, Args &a)
{
    (void)a;
    const std::string &s = S(I, self);
    if (validUtf8(s))
        return I.str(s);
    std::string rep = a.argc > 0 ? argStr(I, a.argv[0]) : "\xEF\xBF\xBD";
    std::string out;
    size_t i = 0;
    while (i < s.size())
    {
        unsigned char c = (unsigned char)s[i];
        size_t n = c < 0x80 ? 1 : (c >= 0xC2 && c < 0xE0) ? 2 : (c >= 0xE0 && c < 0xF0) ? 3 : (c >= 0xF0 && c < 0xF5) ? 4 : 0;
        bool ok = n > 0 && i + n <= s.size();
        for (size_t k = 1; ok && k < n; ++k)
            if (((unsigned char)s[i + k] & 0xC0) != 0x80)
                ok = false;
        if (ok)
        {
            out += s.substr(i, n);
            i += n;
        }
        else
        {
            out += rep;
            ++i;
        }
    }
    return I.str(out);
}

V str_unicode_normalize(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str(S(I, self));
}

V str_sum(Interp &I, V self, Args &a)
{
    (void)a;
    int64_t t = 0;
    for (char c : S(I, self))
        t += (unsigned char)c;
    return fix(t & 0xFFFF);
}

V str_between(Interp &I, V self, Args &a)
{
    return boolv(rbByteCompare(S(I, self), argStr(I, a.argv[0])) >= 0 && rbByteCompare(S(I, self), argStr(I, a.argv[1])) <= 0);
}

V str_unpack1(Interp &I, V self, Args &a)
{
    std::string fmt = argStr(I, a.argv[0]);
    const std::string &s = S(I, self);
    if (fmt == "U*" || fmt == "U")
    {
        std::vector<uint32_t> cps = codepoints(s);
        return cps.empty() ? Qnil : fix(cps[0]);
    }
    if (fmt == "C*" || fmt == "C" || fmt == "c")
        return s.empty() ? Qnil : fix((unsigned char)s[0]);
    if (fmt == "B*" || fmt == "b*")
    {
        std::string out;
        for (char c : s)
            for (int b = 7; b >= 0; --b)
                out += fmt[0] == 'B' ? (((unsigned char)c >> b) & 1 ? '1' : '0') : (((unsigned char)c >> (7 - b)) & 1 ? '1' : '0');
        return I.str(out);
    }
    if (fmt == "H*")
    {
        std::string out;
        const char *hex = "0123456789abcdef";
        for (char c : s)
        {
            out += hex[((unsigned char)c) >> 4];
            out += hex[((unsigned char)c) & 15];
        }
        return I.str(out);
    }
    I.raise(I.cNotImplementedError, "unpack format " + fmt + " is not supported");
}

V str_unpack(Interp &I, V self, Args &a)
{
    std::string fmt = argStr(I, a.argv[0]);
    const std::string &s = S(I, self);
    V out = I.ary();
    if (fmt == "U*")
    {
        for (uint32_t c : codepoints(s))
            I.aref(out).push_back(fix(c));
        return out;
    }
    if (fmt == "C*" || fmt == "c*")
    {
        for (char c : s)
            I.aref(out).push_back(fix(fmt[0] == 'C' ? (unsigned char)c : (signed char)c));
        return out;
    }
    I.aref(out).push_back(str_unpack1(I, self, a));
    return out;
}

