    defn(c, "rjust", str_rjust, 1, 2);
    defn(c, "center", str_center, 1, 2);
    defn(c, "ord", str_ord, 0, 0);
    defn(c, "chr", str_chr, 0, 0);
    defn(c, "empty?", str_empty, 0, 0);
    defn(c, "freeze", str_freeze, 0, 0);
    defn(c, "-@", str_uminus, 0, 0);
    defn(c, "dedup", str_uminus, 0, 0);
    defn(c, "+@", str_uplus, 0, 0);
    defn(c, "<<", str_append, 1, 1);
    defn(c, "concat", str_concat, 0, -1);
    defn(c, "prepend", str_prepend, 0, -1);
