// quantum: cpp
// Ruby front-end: String, Symbol and format. Strings are UTF-8 bytes;
// character positions count code points.
#include "RubyRt.h.sa"

#include <cctype>
#include <cmath>
#include <cstdio>
#include <cstdlib>

namespace ruby
{

// ── UTF-8 ─────────────────────────────────────────────────────────────────

static size_t u8len(unsigned char c) { return c < 0xC0 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4; }

bool asciiOnly(const std::string &s)
{
    for (size_t i = 0; i < s.size(); ++i)
        if ((unsigned char)s[i] >= 0x80)
            return false;
    return true;
}

size_t utf8Len(const std::string &s)
{
    size_t n = 0;
    for (size_t i = 0; i < s.size(); ++i)
        if (((unsigned char)s[i] & 0xC0) != 0x80)
            ++n;
    return n;
}

std::vector<std::string> utf8Chars(const std::string &s)
{
    std::vector<std::string> out;
    size_t i = 0;
    while (i < s.size())
    {
        size_t n = u8len((unsigned char)s[i]);
        if (i + n > s.size())
            n = s.size() - i;
        out.push_back(s.substr(i, n));
        i += n;
    }
    return out;
}

int64_t strChars(V v)
{
    auto *r = static_cast<RString *>(op(v));
    size_t n = r->s.size();
    if (r->charLen >= 0 && r->byteLen == n)
        return r->charLen;
    r->byteLen = n;
    r->charLen = r->binary ? (int64_t)n : (int64_t)utf8Len(r->s);
    return r->charLen;
}

static uint32_t decodeAt(const std::string &s, size_t i, size_t *len)
{
    unsigned char c = (unsigned char)s[i];
    size_t n = u8len(c);
    if (i + n > s.size())
        n = 1;
    if (len)
        *len = n;
    if (n == 1)
        return c;
    uint32_t cp = c & (n == 2 ? 0x1F : n == 3 ? 0x0F : 0x07);
    for (size_t k = 1; k < n; ++k)
        cp = (cp << 6) | ((unsigned char)s[i + k] & 0x3F);
    return cp;
}

static bool validUtf8(const std::string &s)
{
    size_t i = 0;
    while (i < s.size())
    {
        unsigned char c = (unsigned char)s[i];
        size_t n = c < 0x80 ? 1 : (c >= 0xC2 && c < 0xE0) ? 2 : (c >= 0xE0 && c < 0xF0) ? 3 : (c >= 0xF0 && c < 0xF5) ? 4 : 0;
        if (n == 0 || i + n > s.size())
            return false;
        for (size_t k = 1; k < n; ++k)
            if (((unsigned char)s[i + k] & 0xC0) != 0x80)
                return false;
        i += n;
    }
    return true;
}

// byte offset of character `ci` (0 <= ci <= length)
static size_t byteOf(const std::string &s, size_t ci, bool ascii)
{
    if (ascii)
        return ci < s.size() ? ci : s.size();
    size_t i = 0, c = 0;
    while (i < s.size() && c < ci)
    {
        i += u8len((unsigned char)s[i]);
        ++c;
    }
    return i < s.size() ? i : s.size();
}

std::string strInspect(const std::string &s, bool binary)
{
    std::string out = "\"";
    size_t i = 0;
    bool valid = !binary && validUtf8(s);
    while (i < s.size())
    {
        unsigned char c = (unsigned char)s[i];
        if (c >= 0x80)
        {
            size_t n = u8len(c);
            if (valid && i + n <= s.size())
            {
                out += s.substr(i, n);
                i += n;
                continue;
            }
            char buf[8];
            std::snprintf(buf, sizeof buf, "\\x%02X", c);
            out += buf;
            ++i;
            continue;
        }
        switch (c)
        {
        case '"': out += "\\\""; break;
        case '\\': out += "\\\\"; break;
        case '\n': out += "\\n"; break;
        case '\t': out += "\\t"; break;
        case '\r': out += "\\r"; break;
        case 27: out += "\\e"; break;
        case 7: out += "\\a"; break;
        case 8: out += "\\b"; break;
        case 11: out += "\\v"; break;
        case 12: out += "\\f"; break;
        case '#':
            if (i + 1 < s.size() && (s[i + 1] == '{' || s[i + 1] == '$' || s[i + 1] == '@'))
                out += "\\#";
            else
                out += '#';
            break;
        default:
            if (c < 0x20 || c == 0x7f)
            {
                char buf[10];
                if (c == 0x7f)
                    std::snprintf(buf, sizeof buf, "\\x7F");
                else
                    std::snprintf(buf, sizeof buf, "\\u%04X", c);
                out += buf;
            }
            else
                out += (char)c;
        }
        ++i;
    }
    return out + "\"";
}

static bool identStartC(unsigned char c) { return c == '_' || std::isalpha(c) || c >= 0x80; }
static bool identC(unsigned char c) { return c == '_' || std::isalnum(c) || c >= 0x80; }

std::string symInspect(const std::string &s)
{
    static const char *ops[] = {"[]", "[]=", "<=>", "===", "==", "=~", "!=", "!~", "**", "+@", "-@", "<<", ">>",
                                "<=", ">=", "+", "-", "*", "/", "%", "<", ">", "!", "&", "|", "^", "~", "call"};
    for (const char *o : ops)
        if (s == o)
            return ":" + s;
    if (s.empty())
        return ":\"\"";
    size_t i = 0;
    if (s[0] == '@')
    {
        i = s.size() > 1 && s[1] == '@' ? 2 : 1;
    }
    else if (s[0] == '$')
        i = 1;
    bool ok = i < s.size() && identStartC((unsigned char)s[i]);
    size_t j = i;
    while (ok && j < s.size() && identC((unsigned char)s[j]))
        ++j;
    if (ok && j < s.size())
    {
        // a trailing ? ! or = on a method name
        if (i == 0 && j + 1 == s.size() && (s[j] == '?' || s[j] == '!' || s[j] == '='))
            j = s.size();
    }
    if (ok && j == s.size())
        return ":" + s;
    return ":" + strInspect(s);
}

namespace
{

std::string &S(Interp &I, V v) { return I.sref(v); }

V newStr(Interp &I, V self, const std::string &s)
{
    (void)self;
    return I.str(s);
}

void modify(Interp &I, V self)
{
    if (op(self)->frozen)
        I.frozenError(self);
    static_cast<RString *>(op(self))->charLen = -1;
}

std::string argStr(Interp &I, V v) { return I.strOf(v); }

// ── character sets (tr, count, delete, squeeze) ───────────────────────────

struct CharSet
{
    bool neg = false;
    std::vector<uint32_t> lo, hi;
    bool has(uint32_t c) const
    {
        bool in = false;
        for (size_t i = 0; i < lo.size(); ++i)
            if (c >= lo[i] && c <= hi[i])
            {
                in = true;
                break;
            }
        return in != neg;
    }
};

std::vector<uint32_t> codepoints(const std::string &s)
{
    std::vector<uint32_t> out;
    size_t i = 0;
    while (i < s.size())
    {
        size_t n;
        out.push_back(decodeAt(s, i, &n));
        i += n;
    }
    return out;
}

// expands a tr-style spec into a list of code points (ranges a-z, escapes)
std::vector<uint32_t> expandSpec(const std::string &spec, bool &neg)
{
    std::vector<uint32_t> cps = codepoints(spec);
    neg = false;
    size_t i = 0;
    if (cps.size() > 1 && cps[0] == '^')
    {
        neg = true;
        i = 1;
    }
    std::vector<uint32_t> out;
    for (; i < cps.size(); ++i)
    {
        uint32_t c = cps[i];
        if (c == '\\' && i + 1 < cps.size())
        {
            out.push_back(cps[++i]);
            continue;
        }
        if (i + 2 < cps.size() && cps[i + 1] == '-')
        {
            uint32_t e = cps[i + 2];
            if (e >= c)
                for (uint32_t x = c; x <= e; ++x)
                    out.push_back(x);
            i += 2;
            continue;
        }
        out.push_back(c);
    }
    return out;
}

CharSet makeSet(const std::string &spec)
{
    CharSet cs;
    bool neg;
    std::vector<uint32_t> list = expandSpec(spec, neg);
    cs.neg = neg;
    for (uint32_t c : list)
    {
        cs.lo.push_back(c);
        cs.hi.push_back(c);
    }
    return cs;
}

bool inAllSets(const std::vector<CharSet> &sets, uint32_t c)
{
    for (const CharSet &s : sets)
        if (!s.has(c))
            return false;
    return true;
}

std::vector<CharSet> setsFrom(Interp &I, Args &a)
{
    if (a.argc == 0)
        I.raise(I.cArgumentError, "wrong number of arguments (given 0, expected 1+)");
    std::vector<CharSet> sets;
    for (int i = 0; i < a.argc; ++i)
        sets.push_back(makeSet(argStr(I, a.argv[i])));
    return sets;
}

std::string trString(const std::string &src, const std::string &from, const std::string &to, bool squeeze)
{
    bool neg;
    std::vector<uint32_t> f = expandSpec(from, neg);
    bool dummy;
    std::vector<uint32_t> t = expandSpec(to, dummy);
    std::string out;
    size_t i = 0;
    bool lastWasTr = false;
    uint32_t lastOut = 0;
    while (i < src.size())
    {
        size_t n;
        uint32_t c = decodeAt(src, i, &n);
        i += n;
        int idx = -1;
        for (size_t k = 0; k < f.size(); ++k)
            if (f[k] == c)
            {
                idx = (int)k;
                break;
            }
        bool match = neg ? idx < 0 : idx >= 0;
        if (!match)
        {
            appendUtf8(out, c);
            lastWasTr = false;
            continue;
        }
        if (t.empty())
            continue; // tr with empty replacement deletes
        uint32_t r = neg ? t.back() : (idx < (int)t.size() ? t[idx] : t.back());
        if (squeeze && lastWasTr && lastOut == r)
            continue;
        appendUtf8(out, r);
        lastWasTr = true;
        lastOut = r;
    }
    return out;
}

// ── String methods ────────────────────────────────────────────────────────

V str_new(Interp &I, V self, Args &a)
{
    V s = I.allocate(static_cast<RClass *>(op(self)));
    int argc = a.kw ? a.argc - 1 : a.argc;
    if (argc > 0)
        S(I, s) = argStr(I, a.argv[0]);
    if (static_cast<RClass *>(op(self)) != I.cString)
    {
        Method *init = I.findMethod(op(s)->klass, I.s.initialize);
        if (init && init->kind != M_NATIVE)
            I.invoke(init, s, a, nullptr, I.frame);
    }
    return s;
}

V str_initialize(Interp &I, V self, Args &a)
{
    int argc = a.kw ? a.argc - 1 : a.argc;
    if (argc > 0)
        S(I, self) = argStr(I, a.argv[0]);
    return Qnil;
}

V str_length(Interp &I, V self, Args &a)
{
    (void)I;
    (void)a;
    return fix(strChars(self));
}

V str_bytesize(Interp &I, V self, Args &a)
{
    (void)a;
    return fix((int64_t)S(I, self).size());
}

// a binary string with bytes above ASCII makes what it joins binary
bool binaryJoin(Interp &I, V x)
{
    return strBinary(x) && !asciiOnly(I.sref(x));
}

V str_plus(Interp &I, V self, Args &a)
{
    V o = a.argv[0];
    if (!I.isStr(o))
        I.typeError(o, "String");
    V r = I.str(S(I, self) + S(I, o));
    static_cast<RString *>(op(r))->binary = binaryJoin(I, self) || binaryJoin(I, o);
    return r;
}

V str_mul(Interp &I, V self, Args &a)
{
    int64_t n = I.intOf(a.argv[0]);
    if (n < 0)
        I.raise(I.cArgumentError, "negative argument");
    const std::string &s = S(I, self);
    std::string out;
    out.reserve(s.size() * (size_t)n);
    for (int64_t i = 0; i < n; ++i)
        out += s;
    return I.str(out);
}

V str_format(Interp &I, V self, Args &a)
{
    V arg = a.argv[0];
    if (I.isAry(arg))
    {
        std::vector<V> &v = I.aref(arg);
        return I.str(formatStr(I, S(I, self), (int)v.size(), v.data()));
    }
    return I.str(formatStr(I, S(I, self), 1, &arg));
}

V str_eq(Interp &I, V self, Args &a)
{
    V o = a.argv[0];
    if (I.isStr(o))
        return boolv(S(I, self) == S(I, o));
    if (isObj(o) && op(o)->type == T::Object && I.respondTo(o, I.s.to_str))
        return boolv(truthy(I.call1(o, I.s.eq, self)));
    return Qfalse;
}

V str_eql(Interp &I, V self, Args &a) { return boolv(I.isStr(a.argv[0]) && S(I, self) == S(I, a.argv[0])); }

V str_cmp(Interp &I, V self, Args &a)
{
    V o = a.argv[0];
    if (!I.isStr(o))
        return Qnil;
    return fix(rbByteCompare(S(I, self), S(I, o)));
}

V str_hash(Interp &I, V self, Args &a)
{
    (void)a;
    return fix((int64_t)(I.hashOf(self) >> 2));
}

V str_to_s(Interp &I, V self, Args &a)
{
    (void)a;
    if (I.realClassOf(self) != I.cString)
        return I.str(S(I, self));
    return self;
}

V str_inspect(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str(strInspect(S(I, self), strBinary(self)));
}

V str_dump(Interp &I, V self, Args &a)
{
    (void)a;
    const std::string &s = S(I, self);
    std::string out = "\"";
    size_t i = 0;
    while (i < s.size())
    {
        unsigned char c = (unsigned char)s[i];
        if (c >= 0x80)
        {
            size_t n;
            uint32_t cp = decodeAt(s, i, &n);
            char buf[16];
            if (cp > 0xFFFF)
                std::snprintf(buf, sizeof buf, "\\u{%X}", cp);
            else
                std::snprintf(buf, sizeof buf, "\\u%04X", cp);
            out += buf;
            i += n;
            continue;
        }
        std::string one = strInspect(std::string(1, (char)c));
        out += one.substr(1, one.size() - 2);
        ++i;
    }
    return I.str(out + "\"");
}

V str_to_sym(Interp &I, V self, Args &a)
{
    (void)a;
    return symv(intern(S(I, self)));
}

V str_to_i(Interp &I, V self, Args &a)
{
    int base = a.argc > 0 ? (int)I.intOf(a.argv[0]) : 10;
    const std::string &s = S(I, self);
    size_t i = 0;
    while (i < s.size() && std::isspace((unsigned char)s[i]))
        ++i;
    bool neg = false;
    if (i < s.size() && (s[i] == '-' || s[i] == '+'))
    {
        neg = s[i] == '-';
        ++i;
    }
    if (i + 1 < s.size() && s[i] == '0')
    {
        char p = (char)(s[i + 1] | 32);
        if ((p == 'x' && base == 16) || (p == 'b' && base == 2) || (p == 'o' && base == 8))
            i += 2;
    }
    std::string digits;
    for (; i < s.size(); ++i)
    {
        char c = s[i];
        if (c == '_' && !digits.empty() && i + 1 < s.size() && s[i + 1] != '_')
            continue;
        int d = c >= '0' && c <= '9' ? c - '0' : (c | 32) >= 'a' && (c | 32) <= 'z' ? (c | 32) - 'a' + 10 : 99;
        if (d >= base)
            break;
        digits += c;
    }
    if (digits.empty())
        return fix(0);
    V r = bigFromString(I, digits, base);
    return neg ? intNeg(I, r) : r;
}

double parseLeadingFloat(const std::string &s, bool *any)
{
    size_t i = 0;
    while (i < s.size() && std::isspace((unsigned char)s[i]))
        ++i;
    std::string t;
    if (i < s.size() && (s[i] == '-' || s[i] == '+'))
        t += s[i++];
    bool digits = false;
    while (i < s.size() && (std::isdigit((unsigned char)s[i]) || (s[i] == '_' && digits && i + 1 < s.size() && std::isdigit((unsigned char)s[i + 1]))))
    {
        if (s[i] != '_')
            t += s[i];
        digits = true;
        ++i;
    }
    if (i + 1 < s.size() && s[i] == '.' && std::isdigit((unsigned char)s[i + 1]) && digits)
    {
        t += '.';
        ++i;
        while (i < s.size() && (std::isdigit((unsigned char)s[i]) || (s[i] == '_' && i + 1 < s.size() && std::isdigit((unsigned char)s[i + 1]))))
        {
            if (s[i] != '_')
                t += s[i];
            ++i;
        }
    }
    if (digits && i < s.size() && (s[i] == 'e' || s[i] == 'E'))
    {
        size_t j = i + 1;
        std::string e = "e";
        if (j < s.size() && (s[j] == '-' || s[j] == '+'))
            e += s[j++];
        if (j < s.size() && std::isdigit((unsigned char)s[j]))
        {
            while (j < s.size() && std::isdigit((unsigned char)s[j]))
                e += s[j++];
            t += e;
        }
    }
    if (any)
        *any = digits;
    if (!digits)
        return 0.0;
    return std::strtod(t.c_str(), nullptr);
}

V str_to_f(Interp &I, V self, Args &a)
{
    (void)a;
    return I.flo(parseLeadingFloat(S(I, self), nullptr));
}

V str_to_r(Interp &I, V self, Args &a)
{
    (void)a;
    V av = self;
    Args b;
    b.argv = &av;
    b.argc = 1;
    return I.call(ov(I.mKernel), intern("Rational"), 1, &av);
}

V str_to_c(Interp &I, V self, Args &a)
{
    (void)a;
    return makeComplex(I, I.flo(parseLeadingFloat(S(I, self), nullptr)), fix(0));
}

V str_hex(Interp &I, V self, Args &a)
{
    (void)a;
    V av = fix(16);
    Args b;
    b.argv = &av;
    b.argc = 1;
    return str_to_i(I, self, b);
}

V str_oct(Interp &I, V self, Args &a)
{
    (void)a;
    V av = fix(8);
    Args b;
    b.argv = &av;
    b.argc = 1;
    return str_to_i(I, self, b);
}

// str[...] indexing: returns Qundef for an unsupported key
V substrChars(Interp &I, V self, int64_t start, int64_t len)
{
    const std::string &s = I.sref(self);
    bool ascii = strBytewise(self);
    int64_t n = strChars(self);
    if (start < 0)
        start += n;
    if (start < 0 || start > n || len < 0)
        return Qnil;
    if (start + len > n)
        len = n - start;
    size_t b = byteOf(s, (size_t)start, ascii), e = byteOf(s, (size_t)(start + len), ascii);
    return I.str(s.substr(b, e - b));
}

bool rangeBounds(Interp &I, V range, int64_t n, int64_t &start, int64_t &len)
{
    auto *r = static_cast<RRange *>(op(range));
    int64_t b = r->lo == Qnil ? 0 : I.intOf(r->lo);
    int64_t e = r->hi == Qnil ? n : I.intOf(r->hi);
    if (b < 0)
        b += n;
    if (e < 0)
        e += n;
    if (b < 0 || b > n)
        return false;
    if (!r->excl && r->hi != Qnil)
        ++e;
    if (e > n)
        e = n;
    start = b;
    len = e - b < 0 ? 0 : e - b;
    return true;
}

V str_aref(Interp &I, V self, Args &a)
{
    const std::string &s = S(I, self);
    V k = a.argv[0];
    if (a.argc == 2)
    {
        if (isType(k, T::Regexp))
        {
            std::vector<int> caps;
            RRegexp *re = static_cast<RRegexp *>(op(k));
            if (!regexSearch(re->re, s, 0, caps))
            {
                I.lastMatch = Qnil;
                return Qnil;
            }
            I.lastMatch = matchData(I, self, re, caps);
            int g;
            if (isSymV(a.argv[1]) || I.isStr(a.argv[1]))
            {
                std::string nm = isSymV(a.argv[1]) ? symName(vsym(a.argv[1])) : S(I, a.argv[1]);
                g = -1;
                const std::vector<std::string> &names = regexNames(re->re);
                for (size_t i = 0; i < names.size(); ++i)
                    if (names[i] == nm)
                        g = (int)i;
                if (g < 0)
                    I.raise(I.cIndexError, "undefined group name reference: " + nm);
            }
            else
                g = (int)I.intOf(a.argv[1]);
            if (g < 0 || g * 2 + 1 >= (int)caps.size() || caps[g * 2] < 0)
                return Qnil;
            return I.str(s.substr(caps[g * 2], caps[g * 2 + 1] - caps[g * 2]));
        }
        return substrChars(I, self, I.intOf(k), I.intOf(a.argv[1]));
    }
    if (isFix(k))
    {
        int64_t i = fixv(k);
        if (strBytewise(self))
        {
            int64_t n = (int64_t)s.size();
            if (i < 0)
                i += n;
            if (i < 0 || i >= n)
                return Qnil;
            V one = I.str(std::string(1, s[i]));
            static_cast<RString *>(op(one))->binary = strBinary(self);
            return one;
        }
        int64_t n = strChars(self);
        if (i < 0)
            i += n;
        if (i < 0 || i >= n)
            return Qnil;
        return substrChars(I, self, i, 1);
    }
    if (isType(k, T::Range))
    {
        int64_t n = strChars(self);
        int64_t st, len;
        if (!rangeBounds(I, k, n, st, len))
            return Qnil;
        return substrChars(I, self, st, len);
    }
    if (I.isStr(k))
        return s.find(S(I, k)) == std::string::npos ? Qnil : I.str(S(I, k));
    if (isType(k, T::Regexp))
    {
        std::vector<int> caps;
        RRegexp *re = static_cast<RRegexp *>(op(k));
        if (!regexSearch(re->re, s, 0, caps))
        {
            I.lastMatch = Qnil;
            return Qnil;
        }
        I.lastMatch = matchData(I, self, re, caps);
        return I.str(s.substr(caps[0], caps[1] - caps[0]));
    }
    if (I.isFloat(k))
    {
        V iv = fix(I.intOf(k));
        Args b;
        b.argv = &iv;
        b.argc = 1;
        return str_aref(I, self, b);
    }
    I.typeError(k, "Integer");
}

V str_aset(Interp &I, V self, Args &a)
{
    modify(I, self);
    std::string &s = S(I, self);
    V k = a.argv[0];
    V val = a.argv[a.argc - 1];
    std::string rep = argStr(I, val);
    bool ascii = strBytewise(self);
    int64_t n = strChars(self);
    static_cast<RString *>(op(self))->charLen = -1;
    int64_t st, len;
    if (a.argc == 3)
    {
        st = I.intOf(k);
        len = I.intOf(a.argv[1]);
        if (st < 0)
            st += n;
        if (st < 0 || st > n)
            I.raise(I.cIndexError, "index " + std::to_string(I.intOf(k)) + " out of string");
        if (st + len > n)
            len = n - st;
    }
    else if (isFix(k))
    {
        st = fixv(k);
        if (st < 0)
            st += n;
        if (st < 0 || st >= n)
            I.raise(I.cIndexError, "index " + std::to_string(fixv(k)) + " out of string");
        len = 1;
    }
    else if (isType(k, T::Range))
    {
        if (!rangeBounds(I, k, n, st, len))
            I.raise(I.cRangeError, I.inspect(k) + " out of range");
    }
    else if (I.isStr(k))
    {
        size_t pos = s.find(S(I, k));
        if (pos == std::string::npos)
            I.raise(I.cIndexError, "string not matched");
        s = s.substr(0, pos) + rep + s.substr(pos + S(I, k).size());
        return val;
    }
    else if (isType(k, T::Regexp))
    {
        std::vector<int> caps;
        if (!regexSearch(static_cast<RRegexp *>(op(k))->re, s, 0, caps))
            I.raise(I.cIndexError, "regexp not matched");
        s = s.substr(0, caps[0]) + rep + s.substr(caps[1]);
        return val;
    }
    else
        I.typeError(k, "Integer");
    size_t b = byteOf(s, (size_t)st, ascii), e = byteOf(s, (size_t)(st + len), ascii);
    s = s.substr(0, b) + rep + s.substr(e);
    return val;
}

V str_slice_bang(Interp &I, V self, Args &a)
{
    V r = str_aref(I, self, a);
    if (r == Qnil)
        return Qnil;
    modify(I, self);
    std::string &s = S(I, self);
    V k = a.argv[0];
    if (I.isStr(k) || isType(k, T::Regexp))
    {
        size_t pos = s.find(S(I, r));
        if (pos != std::string::npos)
            s.erase(pos, S(I, r).size());
        return r;
    }
    bool ascii = asciiOnly(s);
    int64_t n = ascii ? (int64_t)s.size() : (int64_t)utf8Len(s);
    int64_t st, len;
    if (a.argc == 2)
    {
        st = I.intOf(k);
        len = I.intOf(a.argv[1]);
        if (st < 0)
            st += n;
        if (st + len > n)
            len = n - st;
    }
    else if (isType(k, T::Range))
        rangeBounds(I, k, n, st, len);
    else
    {
        st = I.intOf(k);
        if (st < 0)
            st += n;
        len = 1;
    }
    size_t b = byteOf(s, (size_t)st, ascii), e = byteOf(s, (size_t)(st + len), ascii);
    s.erase(b, e - b);
    return r;
}

std::string upcaseStr(const std::string &s)
{
    std::string out = s;
    for (size_t i = 0; i < out.size(); ++i)
    {
        unsigned char c = (unsigned char)out[i];
        if (c >= 'a' && c <= 'z')
            out[i] = (char)(c - 32);
        else if (c == 0xC3 && i + 1 < out.size())
        {
            unsigned char d = (unsigned char)out[i + 1];
            if (d >= 0xA0 && d <= 0xBE && d != 0xB7)
                out[i + 1] = (char)(d - 0x20);
            ++i;
        }
    }
    return out;
}

std::string downcaseStr(const std::string &s)
{
    std::string out = s;
    for (size_t i = 0; i < out.size(); ++i)
    {
        unsigned char c = (unsigned char)out[i];
        if (c >= 'A' && c <= 'Z')
            out[i] = (char)(c + 32);
        else if (c == 0xC3 && i + 1 < out.size())
        {
            unsigned char d = (unsigned char)out[i + 1];
            if (d >= 0x80 && d <= 0x9E && d != 0x97)
                out[i + 1] = (char)(d + 0x20);
            ++i;
        }
    }
    return out;
}

std::string capitalizeStr(const std::string &s)
{
    if (s.empty())
        return s;
    size_t n = u8len((unsigned char)s[0]);
    return upcaseStr(s.substr(0, n)) + downcaseStr(s.substr(n));
}

std::string swapcaseStr(const std::string &s)
{
    std::string out = s;
    for (size_t i = 0; i < out.size(); ++i)
    {
        unsigned char c = (unsigned char)out[i];
        if (c >= 'a' && c <= 'z')
            out[i] = (char)(c - 32);
        else if (c >= 'A' && c <= 'Z')
            out[i] = (char)(c + 32);
    }
    return out;
}

V str_upcase(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str(upcaseStr(S(I, self)));
}
V str_downcase(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str(downcaseStr(S(I, self)));
}
V str_capitalize(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str(capitalizeStr(S(I, self)));
}
V str_swapcase(Interp &I, V self, Args &a)
{
    (void)a;
    return I.str(swapcaseStr(S(I, self)));
}

V bangResult(Interp &I, V self, const std::string &next)
{
    modify(I, self);
    if (S(I, self) == next)
        return Qnil;
    S(I, self) = next;
    return self;
}

V str_upcase_bang(Interp &I, V self, Args &a)
{
    (void)a;
    return bangResult(I, self, upcaseStr(S(I, self)));
}
V str_downcase_bang(Interp &I, V self, Args &a)
