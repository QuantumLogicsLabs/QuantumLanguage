} // namespace

// ── format ────────────────────────────────────────────────────────────────

std::string formatStr(Interp &I, const std::string &fmt, int argc, V *argv)
{
    std::string out;
    int argi = 0;
    V hash = argc > 0 && I.isHash(argv[argc - 1]) ? argv[argc - 1] : Qnil;
    auto nextArg = [&]() -> V
    {
        if (argi >= argc)
            I.raise(I.cArgumentError, "too few arguments");
        return argv[argi++];
    };
    size_t i = 0;
    while (i < fmt.size())
    {
        char c = fmt[i];
        if (c != '%')
        {
            out += c;
            ++i;
            continue;
        }
        ++i;
        if (i >= fmt.size())
        {
            out += '%';
            break;
        }
        if (fmt[i] == '%')
        {
            out += '%';
            ++i;
            continue;
        }
        bool minus = false, plus = false, space = false, zero = false, alt = false;
        int width = -1, prec = -1;
        V named = Qundef;
        for (;;)
        {
            char f = fmt[i];
            if (f == '-')
                minus = true;
            else if (f == '+')
                plus = true;
            else if (f == ' ')
                space = true;
            else if (f == '0')
                zero = true;
            else if (f == '#')
                alt = true;
            else if (f == '<' || f == '{')
            {
                char close = f == '<' ? '>' : '}';
                size_t e = fmt.find(close, i);
                std::string name = fmt.substr(i + 1, e - i - 1);
                if (hash == Qnil)
                    I.raise(I.cArgumentError, "one hash required");
                bool found = false;
                V v = I.hget(I.href(hash), I.sym(name), &found);
                if (!found)
                {
                    V exc = I.makeExc(I.cKeyError, "key<" + name + "> not found");
                    I.raiseExc(exc);
                }
                i = e + 1;
                if (f == '{')
                {
                    std::string t = I.toS(v);
                    out += t;
                    named = Qnil;
                    break;
                }
                named = v;
                continue;
            }
            else
                break;
            ++i;
        }
        if (named == Qnil)
            continue;
        if (fmt[i] == '*')
        {
            width = (int)I.intOf(nextArg());
            if (width < 0)
            {
                minus = true;
                width = -width;
            }
            ++i;
        }
        else
            while (i < fmt.size() && std::isdigit((unsigned char)fmt[i]))
            {
                width = (width < 0 ? 0 : width) * 10 + (fmt[i] - '0');
                ++i;
            }
        if (i < fmt.size() && fmt[i] == '.')
        {
            ++i;
            prec = 0;
            if (fmt[i] == '*')
            {
                prec = (int)I.intOf(nextArg());
                ++i;
            }
            else
                while (i < fmt.size() && std::isdigit((unsigned char)fmt[i]))
                {
                    prec = prec * 10 + (fmt[i] - '0');
                    ++i;
                }
        }
        if (i < fmt.size() && (fmt[i] == '<' || fmt[i] == '{') && named == Qundef)
        {
            char close = fmt[i] == '<' ? '>' : '}';
            size_t e = fmt.find(close, i);
            std::string name = fmt.substr(i + 1, e - i - 1);
            bool found = false;
            named = hash == Qnil ? Qnil : I.hget(I.href(hash), I.sym(name), &found);
            i = e + 1;
        }
        if (i >= fmt.size())
            I.raise(I.cArgumentError, "malformed format string - %" + fmt.substr(i - 1));
        char conv = fmt[i++];
        V arg = Qnil;
        if (conv != '%')
            arg = named != Qundef ? named : nextArg();
        std::string body, sign;
        bool numeric = false;
        switch (conv)
        {
        case 'd':
        case 'i':
        case 'u':
        {
            numeric = true;
            V iv = arg;
            if (I.isFloat(iv))
                iv = intFromDouble(I, std::floor(I.fltv(iv)) == I.fltv(iv) ? I.fltv(iv) : (I.fltv(iv) < 0 ? std::ceil(I.fltv(iv)) : std::floor(I.fltv(iv))));
            else if (!I.isInt(iv))
            {
                V av = iv;
                iv = I.call(ov(I.mKernel), intern("Integer"), 1, &av);
            }
            std::string digits = intToS(I, iv);
            if (digits[0] == '-')
            {
                sign = "-";
                digits = digits.substr(1);
            }
            else if (plus)
                sign = "+";
            else if (space)
                sign = " ";
            if (prec >= 0 && (int)digits.size() < prec)
                digits = std::string(prec - digits.size(), '0') + digits;
            body = digits;
            if (prec >= 0)
                zero = false;
            break;
        }
        case 'x':
        case 'X':
        case 'o':
        case 'b':
        case 'B':
        {
            numeric = true;
            V iv = arg;
            if (I.isFloat(iv))
                iv = intFromDouble(I, I.fltv(iv));
            else if (!I.isInt(iv))
            {
                V av = iv;
                iv = I.call(ov(I.mKernel), intern("Integer"), 1, &av);
            }
            int base = conv == 'o' ? 8 : (conv == 'b' || conv == 'B') ? 2 : 16;
            std::string digits = intToS(I, iv, base);
            if (digits[0] == '-')
            {
                sign = "-";
                digits = digits.substr(1);
            }
            else if (plus)
                sign = "+";
            else if (space)
                sign = " ";
            if (conv == 'X')
                for (auto &ch : digits)
                    ch = (char)std::toupper((unsigned char)ch);
            if (prec >= 0 && (int)digits.size() < prec)
                digits = std::string(prec - digits.size(), '0') + digits;
            if (alt)
            {
                if (conv == 'o')
                    digits = "0" + digits;
                else if (conv == 'x')
                    sign += "0x";
                else if (conv == 'X')
                    sign += "0X";
                else if (conv == 'b')
                    sign += "0b";
                else
                    sign += "0B";
            }
            body = digits;
            break;
        }
        case 'f':
        case 'e':
        case 'E':
        case 'g':
        case 'G':
        case 'a':
        case 'A':
        {
            numeric = true;
            double d;
            if (I.isFloat(arg))
                d = I.fltv(arg);
            else if (I.isNum(arg))
                d = I.numToF(arg);
            else
            {
                V av = arg;
                d = I.fltv(I.call(ov(I.mKernel), intern("Float"), 1, &av));
            }
            if (std::signbit(d) && !(d != d))
            {
                sign = "-";
                d = -d;
            }
            else if (plus)
                sign = "+";
            else if (space)
                sign = " ";
            if (d != d)
            {
                body = "NaN";
                zero = false;
            }
            else if (d == 1.0 / 0.0)
            {
                body = "Inf";
                zero = false;
            }
            else
                body = fmtDouble(d, conv, prec, alt);
            break;
        }
        case 's':
        case 'p':
        {
            body = conv == 's' ? I.toS(arg) : I.inspect(arg);
            if (prec >= 0)
            {
                std::vector<std::string> cs = utf8Chars(body);
                if ((int)cs.size() > prec)
                {
                    std::string t;
                    for (int k = 0; k < prec; ++k)
                        t += cs[k];
                    body = t;
                }
            }
            zero = false;
            break;
        }
        case 'c':
        {
            if (isFix(arg))
            {
                body.clear();
                appendUtf8(body, (uint32_t)fixv(arg));
            }
            else
            {
                std::string t = I.toS(arg);
                body = t.empty() ? "" : t.substr(0, u8len((unsigned char)t[0]));
            }
            zero = false;
            break;
        }
        default: I.raise(I.cArgumentError, std::string("malformed format string - %") + conv);
        }
        int len = (int)(utf8Len(body) + sign.size());
        if (width > len)
        {
            int padn = width - len;
            if (minus)
                out += sign + body + std::string(padn, ' ');
            else if (zero && numeric)
                out += sign + std::string(padn, '0') + body;
            else
                out += std::string(padn, ' ') + sign + body;
        }
        else
            out += sign + body;
    }
    return out;
}

void Interp::initString()
{
    RClass *c = cString;
    defs(c, "new", str_new, 0, -1);
    defnPriv(c, "initialize", str_initialize, 0, -1);
    defn(c, "length", str_length, 0, 0);
    defn(c, "size", str_length, 0, 0);
    defn(c, "bytesize", str_bytesize, 0, 0);
