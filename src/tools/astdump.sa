# Prints the self-hosted parser's tree in the format of `qrun --dump-ast`:
#   qrun src/tools/astdump.sa <file>
# @use "../parser_stmt2.sa"
# @use "../parser_expr.sa"
# @use "../parser_lit.sa"

let HEX_DIGITS = "0123456789ABCDEF"
let OUT = []

fn dumpEscaped(s) {
    let out = ""
    let i = 0
    let n = len(s)
    while i < n {
        let c = s[i]
        let code = ord(c)
        if c == "\\" {
            out = out + "\\\\"
        } else if c == "\n" {
            out = out + "\\n"
        } else if c == "\t" {
            out = out + "\\t"
        } else if c == "\r" {
            out = out + "\\r"
        } else if code < 32 or code == 127 {
            out = out + "\\x" + HEX_DIGITS[floor(code / 16)] + HEX_DIGITS[code % 16]
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

fn qs(s) {
    return "\"" + dumpEscaped(s) + "\""
}

fn fl(b) {
    if b {
        return "true"
    }
    return "false"
}

fn qsList(v) {
    let parts = []
    for s in v {
        parts.push(qs(s))
    }
    return "[" + parts.join(", ") + "]"
}

fn flList(v) {
    let parts = []
    for b in v {
        parts.push(fl(b))
    }
    return "[" + parts.join(", ") + "]"
}

fn ind(depth) {
    return "  ".repeat(depth)
}

fn emit(depth, text) {
    OUT.push(ind(depth) + text)
}

fn head(n, kind) {
    return kind + " L" + str(n["line"])
}

fn child(field, n, depth) {
    emit(depth + 1, "." + field)
    dumpNode(n, depth + 2)
}

fn nodeList(field, v, depth) {
    emit(depth + 1, "." + field + "[" + str(len(v)) + "]")
    # an index loop: for-in stops at a nil element (defaultArgs hold nils)
    let i = 0
    while i < len(v) {
        dumpNode(v[i], depth + 2)
        i = i + 1
    }
}

fn dumpNode(n, depth) {
    if n == nil {
        emit(depth, "nil")
        return nil
    }
    let k = n["k"]
    if k == "Number" {
        emit(depth, head(n, k) + " value=" + str(n["value"]))
    } else if k == "String" {
        emit(depth, head(n, k) + " value=" + qs(n["value"]))
    } else if k == "Bool" {
        emit(depth, head(n, k) + " value=" + fl(n["value"]))
    } else if k == "Nil" or k == "Break" or k == "Continue" {
        emit(depth, head(n, k))
    } else if k == "Ident" {
        emit(depth, head(n, k) + " name=" + qs(n["name"]))
    } else if k == "Binary" {
        emit(depth, head(n, k) + " op=" + qs(n["op"]))
        child("left", n["left"], depth)
        child("right", n["right"], depth)
    } else if k == "Unary" {
        emit(depth, head(n, k) + " op=" + qs(n["op"]))
        child("operand", n["operand"], depth)
    } else if k == "Assign" {
        emit(depth, head(n, k) + " op=" + qs(n["op"]))
        child("target", n["target"], depth)
        child("value", n["value"], depth)
    } else if k == "Call" {
        emit(depth, head(n, k))
        child("callee", n["callee"], depth)
        nodeList("args", n["args"], depth)
    } else if k == "Index" {
        emit(depth, head(n, k))
        child("object", n["object"], depth)
        child("index", n["index"], depth)
    } else if k == "Slice" {
        emit(depth, head(n, k))
        child("object", n["object"], depth)
        child("start", n["start"], depth)
        child("stop", n["stop"], depth)
        child("step", n["step"], depth)
    } else if k == "Member" or k == "Arrow" {
        emit(depth, head(n, k) + " member=" + qs(n["member"]))
        child("object", n["object"], depth)
    } else if k == "Array" or k == "Tuple" {
        emit(depth, head(n, k))
        nodeList("elements", n["elements"], depth)
    } else if k == "Dict" {
        emit(depth, head(n, k))
        emit(depth + 1, ".pairs[" + str(len(n["pairs"])) + "]")
        for p in n["pairs"] {
            child("key", p[0], depth + 1)
            child("value", p[1], depth + 1)
        }
    } else if k == "Lambda" {
        emit(depth, head(n, k) + " params=" + qsList(n["params"]) + " paramTypes=" + qsList(n["paramTypes"]) +
             " returnType=" + qs(n["returnType"]))
        nodeList("defaultArgs", n["defaultArgs"], depth)
        child("body", n["body"], depth)
    } else if k == "ListComp" {
        emit(depth, head(n, k) + " vars=" + qsList(n["vars"]))
        child("expr", n["expr"], depth)
        child("iterable", n["iterable"], depth)
        child("condition", n["condition"], depth)
    } else if k == "VarDecl" {
        emit(depth, head(n, k) + " name=" + qs(n["name"]) + " isConst=" + fl(n["isConst"]) +
             " typeHint=" + qs(n["typeHint"]) + " isPointer=" + fl(n["isPointer"]) +
             " isExported=" + fl(n["isExported"]) + " cTyped=" + fl(n["cTyped"]) +
             " perInstance=" + fl(n["perInstance"]) + " isStatic=" + fl(n["isStatic"]))
        child("initializer", n["initializer"], depth)
    } else if k == "FunctionDecl" {
        emit(depth, head(n, k) + " name=" + qs(n["name"]) + " params=" + qsList(n["params"]) +
             " paramTypes=" + qsList(n["paramTypes"]) + " paramIsRef=" + flList(n["paramIsRef"]) +
             " returnType=" + qs(n["returnType"]) + " isExported=" + fl(n["isExported"]) +
             " cppParamTypes=" + qsList(n["cppParamTypes"]) + " cReturnType=" + qs(n["cReturnType"]) +
             " pythonScope=" + fl(n["pythonScope"]))
        nodeList("defaultArgs", n["defaultArgs"], depth)
        child("body", n["body"], depth)
    } else if k == "Global" {
        emit(depth, head(n, k) + " names=" + qsList(n["names"]) + " isNonlocal=" + fl(n["isNonlocal"]))
    } else if k == "Return" or k == "Raise" {
        emit(depth, head(n, k))
        child("value", n["value"], depth)
    } else if k == "If" {
        emit(depth, head(n, k))
        child("condition", n["condition"], depth)
        child("thenBranch", n["thenBranch"], depth)
        child("elseBranch", n["elseBranch"], depth)
    } else if k == "While" {
        emit(depth, head(n, k))
        child("condition", n["condition"], depth)
        child("body", n["body"], depth)
        child("post", n["post"], depth)
    } else if k == "For" {
        emit(depth, head(n, k) + " var=" + qs(n["var"]) + " var2=" + qs(n["var2"]))
        child("iterable", n["iterable"], depth)
        child("body", n["body"], depth)
    } else if k == "Block" {
        emit(depth, head(n, k))
        nodeList("statements", n["statements"], depth)
    } else if k == "ExprStmt" {
        emit(depth, head(n, k))
        child("expr", n["expr"], depth)
    } else if k == "Print" {
        emit(depth, head(n, k) + " newline=" + fl(n["newline"]) + " sep=" + qs(n["sep"]) + " end=" + qs(n["end"]))
        nodeList("args", n["args"], depth)
    } else if k == "Input" {
        emit(depth, head(n, k) + " target=" + qs(n["target"]))
        child("prompt", n["prompt"], depth)
        child("lvalueTarget", n["lvalueTarget"], depth)
    } else if k == "Super" {
        emit(depth, head(n, k) + " method=" + qs(n["method"]))
    } else if k == "Try" {
        emit(depth, head(n, k))
        child("body", n["body"], depth)
        emit(depth + 1, ".handlers[" + str(len(n["handlers"])) + "]")
        for h in n["handlers"] {
            emit(depth + 2, "Handler errorType=" + qs(h["errorType"]) + " alias=" + qs(h["alias"]))
            child("body", h["body"], depth + 2)
        }
        child("finallyBody", n["finallyBody"], depth)
    } else if k == "Import" {
        let parts = []
        for it in n["imports"] {
            parts.push(qs(it["name"]) + " as " + qs(it["alias"]))
        }
        emit(depth, head(n, k) + " module=" + qs(n["module"]) + " imports=[" + parts.join(", ") + "]")
    } else if k == "Class" {
        emit(depth, head(n, k) + " name=" + qs(n["name"]) + " base=" + qs(n["base"]))
        nodeList("methods", n["methods"], depth)
        nodeList("staticMethods", n["staticMethods"], depth)
        nodeList("fields", n["fields"], depth)
    } else if k == "Ternary" {
        emit(depth, head(n, k))
        child("condition", n["condition"], depth)
        child("thenExpr", n["thenExpr"], depth)
        child("elseExpr", n["elseExpr"], depth)
    } else if k == "AddressOf" or k == "Deref" {
        emit(depth, head(n, k))
        child("operand", n["operand"], depth)
    } else if k == "New" {
        emit(depth, head(n, k) + " typeName=" + qs(n["typeName"]) + " isArray=" + fl(n["isArray"]))
        nodeList("args", n["args"], depth)
        child("sizeExpr", n["sizeExpr"], depth)
    } else {
        emit(depth, "UNKNOWN " + str(k))
    }
    return nil
}

let path = sys.argv[1]
let source = read_file(path)
if source == nil {
    print("ERROR\tcannot read " + path)
} else {
    # text mode, as the C++ runner reads a program
    source = source.split("\r\n").join("\n")
    let lower = path.lower()
    let isPy = lower.endswith(".py")
    try {
        let ast = parseProgram(lexTokenize(source), isPy)
        dumpNode(ast, 0)
        print(OUT.join("\n"))
    } catch (e) {
        print("ERROR\t" + str(e))
    }
}
