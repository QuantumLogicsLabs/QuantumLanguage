# Prints the self-hosted lexer's tokens in the format of `qrun --dump-tokens`:
#   qrun src/tools/lexdump.sa <file>
# @use "../lexer.sa"

let HEX_DIGITS = "0123456789ABCDEF"

fn dumpEscaped(s) {
    let out = ""
    let i = 0
    let n = len(s)
    while i < n {
        let c = s[i]
        let code = ord(c)
        if c == "\\" {
            out = out + "\\\\"
        } else if c == "\n" {
            out = out + "\\n"
        } else if c == "\t" {
            out = out + "\\t"
        } else if c == "\r" {
            out = out + "\\r"
        } else if code < 32 or code == 127 {
            out = out + "\\x" + HEX_DIGITS[floor(code / 16)] + HEX_DIGITS[code % 16]
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

let path = sys.argv[1]
let source = read_file(path)
if source == nil {
    print("ERROR\tcannot read " + path)
} else {
    # text mode, as the C++ runner reads a program
    source = source.split("\r\n").join("\n")
    let toks = lexTokenize(source)
    let i = 0
    while i < len(toks) {
        let t = toks[i]
        print(str(t[0]) + "\t" + str(t[2]) + "\t" + str(t[3]) + "\t" + dumpEscaped(t[1]))
        i = i + 1
    }
}
