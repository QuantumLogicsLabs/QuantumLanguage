// quantum: cpp
// Writes src/generated/: the text files the compiler carries inside itself,
// as source files defining functions that return them.
//   lib/cpp/*                -> CppLibData.sa        cpp::libraryHeaders()
//   lib/native/*             -> NativeLibData.sa     native::libraryHeaders()
//   src/java/<package>/**.sa -> JavaPreludeData.sa java::preludeSources()
//     (the Java library: the .sa files in src/java's folders, not the
//     front-end's own files directly in src/java)
//   src/dialect/javastyle/*.sa -> JavaStyleData.sa  javastyle::librarySources()
// Run from compiler/:  quantum src/tools/embed.sa   (or qrun)
// A file is rewritten only when its text changes.
#include <algorithm>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <sstream>
#include <string>
#include <vector>

namespace fs = std::filesystem;

namespace
{

std::string readText(const std::string &path)
{
    std::ifstream in(path);
    std::ostringstream ss;
    ss << in.rdbuf();
    return ss.str();
}

// The files under dir (recursively) whose name ends with `ext` ("" = any),
// as paths relative to dir with / separators, sorted
std::vector<std::string> listFiles(const std::string &dir, const std::string &ext)
{
    std::vector<std::string> out;
    for (const auto &entry : fs::recursive_directory_iterator(dir))
    {
        if (!entry.is_regular_file())
            continue;
        std::string rel = fs::path(entry.path()).lexically_relative(dir).generic_string();
        if (!ext.empty() && (rel.size() < ext.size() || rel.compare(rel.size() - ext.size(), ext.size(), ext) != 0))
            continue;
        out.push_back(rel);
    }
    std::sort(out.begin(), out.end());
    return out;
}

// key -> text pairs as the body of a function returning them
std::string generate(const std::string &from, const std::string &ns, const std::string &fn,
                     const std::vector<std::pair<std::string, std::string>> &items, const std::string &delim)
{
    std::string out = "// quantum: cpp\n";
    out += "// Generated from " + from + " by src/tools/embed.sa. Do not edit.\n";
    out += "#include <string>\n#include <utility>\n#include <vector>\n\nnamespace " + ns + "\n{\n";
    out += "const std::vector<std::pair<std::string, std::string>> &" + fn + "()\n{\n";
    out += "    static const std::vector<std::pair<std::string, std::string>> items = {\n";
    for (const auto &it : items)
        out += "        {\"" + it.first + "\", R\"" + delim + "(" + it.second + ")" + delim + "\"},\n";
    out += "    };\n    return items;\n}\n} // namespace " + ns + "\n";
    return out;
}

bool writeIfChanged(const std::string &path, const std::string &text)
{
    if (fs::exists(path) && readText(path) == text)
        return false;
    std::ofstream out(path);
    out << text;
    return true;
}

} // namespace

int main()
{
    if (!fs::exists("src/java/lang") || !fs::exists("src/dialect/javastyle"))
    {
        std::cerr << "embed: run from the compiler/ directory\n";
        return 1;
    }
    fs::create_directories("src/generated");
    int changed = 0;

    std::vector<std::pair<std::string, std::string>> items;
    // The C++ and native library headers (lib/) are regenerated only where the
    // folder exists: without it the checked-in CppLibData.sa / NativeLibData.sa
    // stay as they are.
    if (fs::exists("lib/cpp"))
    {
        for (const std::string &f : listFiles("lib/cpp", ""))
            items.push_back({f, readText("lib/cpp/" + f)});
        changed += writeIfChanged("src/generated/CppLibData.sa",
                                  generate("lib/cpp", "cpp", "libraryHeaders", items, "QCPPLIB"));
        items.clear();
    }
    if (fs::exists("lib/native"))
    {
        for (const std::string &f : listFiles("lib/native", ""))
            items.push_back({f, readText("lib/native/" + f)});
        changed += writeIfChanged("src/generated/NativeLibData.sa",
                                  generate("lib/native", "native", "libraryHeaders", items, "QNATIVELIB"));
        items.clear();
    }

    for (const std::string &f : listFiles("src/java", ".sa"))
    {
        if (f.find('/') == std::string::npos)
            continue; // a file of the front-end itself
        std::string name = fs::path(f).stem().string() + ".java";
        items.push_back({name, readText("src/java/" + f)});
    }
    changed += writeIfChanged("src/generated/JavaPreludeData.sa",
                              generate("src/java", "java", "preludeSources", items, "JAVA"));

    items.clear();
    for (const std::string &f : listFiles("src/dialect/javastyle", ".sa"))
        items.push_back({f, readText("src/dialect/javastyle/" + f)});
    changed += writeIfChanged("src/generated/JavaStyleData.sa",
                              generate("src/dialect/javastyle", "javastyle", "librarySources", items, "QJAVASTYLE"));

    std::cout << "embed: " << changed << " file(s) updated in src/generated\n";
    return 0;
}
