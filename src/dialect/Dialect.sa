// quantum: cpp
#include "../js/JsMain.h.sa"
#include "../ruby/RubyMain.h.sa"
#include "../python/PyMain.h.sa"
#include "../html/HtmlMain.h.sa"
#include "../css/CssMain.h.sa"
#include "Dialect.h.sa"
#include "Error.h.sa"

#include <algorithm>
#include <cstdlib>
#include <filesystem>
#include <iostream>
#include <regex>
#include <string>
#include <vector>

namespace fs = std::filesystem;

extern bool g_strictMode; // Pipeline.sa: qrun --strict
extern bool g_testMode;   // Pipeline.sa: the test runner is running
extern bool g_printPages; // Pipeline.sa: qrun --print
extern bool g_stageMarker; // Cli.sa: a caller captures the output (the execution API)
extern std::vector<std::string> g_scriptArgv; // Pipeline.sa: the script, then its arguments

// multi-syntax front-end — no node/python/gcc/g++ required.

std::string fileExtLower(const std::string &path)
{
    std::string ext = fs::path(path).extension().string();
    std::transform(ext.begin(), ext.end(), ext.begin(), ::tolower);
    return ext;
}

bool hasSupportedExt(const std::string &path)
{
    std::string ext = fileExtLower(path);
    return ext == ".sa" || ext == ".js" || ext == ".py" || ext == ".rb" || ext == ".c" || ext == ".cpp" ||
           ext == ".java" || ext == ".html" || ext == ".htm" || ext == ".css";
}

bool isMarkedCppSource(const std::string &source)
{
    size_t i = 0;
    if (source.size() >= 3 && (unsigned char)source[0] == 0xEF && (unsigned char)source[1] == 0xBB &&
        (unsigned char)source[2] == 0xBF)
        i = 3;
    return source.compare(i, 15, "// quantum: cpp") == 0;
}

// `int main(int argc, char** argv)` gets the command line: sys.argv holds the
// program followed by its arguments, the same layout as C's argv.
static std::string mainCall(const std::string &source)
{
    static const std::regex withParams(
        R"((^|\n)[ \t]*(static[ \t]+)?(int|auto)[ \t]+main[ \t]*\([ \t]*(int|const|unsigned)\b)");
    return std::regex_search(source, withParams) ? "main(len(sys.argv), sys.argv)" : "main()";
}

// C/C++ programs only define main() — append a call so the program executes
// after its top-level declarations load (for .sa, only in a multi-file C++
// project: a C-style `int main(` in a file that splices in local headers).
// Ruby files are first normalized into the common Quantum syntax and then use
// the normal compiler/VM pipeline.
// text as a string literal of the Quantum language
static std::string quantumStringLiteral(const std::string &text)
{
    std::string out = "\"";
    for (char c : text)
    {
        switch (c)
        {
        case '\\': out += "\\\\"; break;
        case '"': out += "\\\""; break;
        case '\n': out += "\\n"; break;
        case '\r': out += "\\r"; break;
        case '\0': out += "\\0"; break;
        default: out += c;
        }
    }
    return out + "\"";
}

// A page or stylesheet the web front-ends compiled. Its errors are compile
// errors under --strict and in the test runner; otherwise they are reported
// and the page is shown anyway, the way a browser shows a page with mistakes
// in it.
static void reportWebProblems(const std::string &report, bool failed)
{
    if (failed && (g_strictMode || g_testMode))
        throw CompileError(report);
    std::cerr << report;
    std::cerr.flush();
}

// The name of a page's file in the browser's folder: the source file's name
// and a hash of its full path, so that two folders' index.html stay apart
static std::string pageName(const std::string &path)
{
    std::error_code ec;
    fs::path full = fs::absolute(fs::path(path), ec);
    if (ec || full.empty())
        full = fs::path(path);
    std::string key = full.lexically_normal().generic_string();
    std::transform(key.begin(), key.end(), key.begin(), ::tolower);
    unsigned long long h = 2166136261ULL; // FNV-1a
    for (char c : key)
        h = ((h ^ (unsigned long long)(unsigned char)c) * 16777619ULL) & 0xFFFFFFFFULL;
    static const char *const hex = "0123456789abcdef";
    std::string tag;
    for (int shift = 28; shift >= 0; shift -= 4)
        tag += hex[(h >> shift) & 15];
    return fs::path(path).stem().string() + "-" + tag;
}

// A page: the program opens it in the default browser (__html_open__,
// src/html/HtmlBrowser.sa). It prints the page instead under --print, in the
// test runner, and for a caller that captures the output (--stage-marker).
static std::string pageProgram(const html::Result &r, const std::string &path)
{
    reportWebProblems(r.report, r.failed);
    if (g_printPages || g_testMode || g_stageMarker)
        return "print(" + quantumStringLiteral(r.output) + ")\n";
    return "__html_open__(" + quantumStringLiteral(r.browser) + ", " + quantumStringLiteral(pageName(path)) + ")\n";
}

std::string applyDialect(std::string source, const std::string &path)
{
    std::string ext = fileExtLower(path);
    if (ext == ".sa" && isMarkedCppSource(source))
        return source; // the typed C++ front-end reads it as it is

    // A UTF-8 byte-order mark (common from Windows editors) would otherwise
    // sit in front of the first line's code.
    if (source.size() >= 3 && (unsigned char)source[0] == 0xEF &&
        (unsigned char)source[1] == 0xBB && (unsigned char)source[2] == 0xBF)
        source.erase(0, 3);

    // HTML and CSS (src/html, src/css): a .html / .css file, or a .sa file
    // that holds a page or a stylesheet
    if (ext == ".html" || ext == ".htm" || (ext == ".sa" && html::looksLikePage(source)))
    {
        std::vector<std::string> sheets; // qrun page.html extra.css: applied as well
        if (!g_scriptArgv.empty() && g_scriptArgv[0] == path)
            sheets.assign(g_scriptArgv.begin() + 1, g_scriptArgv.end());
        html::Result r = html::compile(source, path, sheets);
        return pageProgram(r, path);
    }
    if (ext == ".css" || (ext == ".sa" && css::looksLikeStylesheet(source)))
    {
        css::Result r = css::compile(source, path);
        reportWebProblems(r.report, r.failed);
        return "print(" + quantumStringLiteral(r.output) + ")\n";
    }

    // C++ project structure first (local #includes, namespaces, out-of-class
    // member definitions), so the spliced-in files see every later pass.
    bool cppProject = false;
    if (ext == ".c" || ext == ".cpp" || ext == ".sa")
    {
        source = applyCppDialect(source, path, &cppProject);
        if (std::getenv("QUANTUM_DEBUG_CPP"))
            std::cerr << "----- C++ structure pass -----\n" << source << "----- end -----\n";
    }

    // Java-style code before the Ruby pass, which would read `@Override` as
    // an instance variable
    if (ext == ".sa")
    {
        source = applyJavaDialect(source);
        if (std::getenv("QUANTUM_DEBUG_JAVA"))
            std::cerr << "----- Java-style pass -----\n" << source << "----- end -----\n";
    }

    // Under --strict a .py/.js/.rb file is that language and nothing else: a
    // program its front-end cannot parse is a compile error, reported the way
    // python / node / ruby report it, instead of going to the mixed-syntax
    // pipeline below.
    if (g_strictMode && (ext == ".py" || ext == ".js" || ext == ".rb"))
    {
        std::string report = ext == ".py"   ? py::syntaxReport(source, path)
                             : ext == ".js" ? js::syntaxReport(source, path)
                                            : ruby::syntaxReport(source, path);
        if (!report.empty())
            throw CompileError(report);
    }

    if (ext == ".py")
    {
        // A .py file runs on the Python front-end (src/python) when it can
        // parse it; the program travels inside the chunk as a string
        std::string why;
        if (g_strictMode || py::canRun(source, path, why))
            return "__py_run__(" + quantumStringLiteral(source) + ", " + quantumStringLiteral(path) + ")\n";
    }

    if (ext == ".js")
    {
        // A .js file runs on the JavaScript front-end (src/js) when it can
        // parse it; the program travels inside the chunk as a string
        std::string why;
        if (g_strictMode || js::canRun(source, path, why))
            return "__js_run__(" + quantumStringLiteral(source) + ", " + quantumStringLiteral(path) + ")\n";
    }

    if (ext == ".rb")
    {
        // A .rb file runs on the Ruby front-end (src/ruby) when it can parse
        // it; the program travels inside the chunk as a string
        std::string why;
        if (g_strictMode || ruby::canRun(source, path, why))
            return "__ruby_run__(" + quantumStringLiteral(source) + ", " + quantumStringLiteral(path) + ")\n";
        source = applyRubyDialect(source, /*strict=*/true);
    }
    else if (ext == ".sa")
        source = applyRubyDialect(source, /*strict=*/false);
    if ((ext == ".rb" || ext == ".sa") && std::getenv("QUANTUM_DEBUG_RUBY"))
        std::cerr << "----- translated -----\n" << source << "----- end -----\n";

    // __cpp_runtime__() switches the VM to C/C++ arithmetic rules first.
    if ((ext == ".c" || ext == ".cpp") && definesMainFunction(source))
        source += "\n__cpp_runtime__()\n" + mainCall(source) + "\n";
    else if (ext == ".sa" && cppProject && definesCStyleMain(source))
        source += "\n__cpp_runtime__()\n" + mainCall(source) + "\n";

    return source;
}
