}

V dSetTimeImpl(V thisV, V *args, int argc);
V dSetFullYear(V thisV, V *args, int argc);

V dSetYear(V thisV, V *args, int argc)
{
    double y = toNumber(argOr(args, argc, 0));
    if (y != y)
    {
        V nan = num(y);
        return dSetTimeImpl(thisV, &nan, 1);
    }
    double t = std::trunc(y);
    if (t >= 0 && t <= 99)
        t += 1900;
    V a = num(t);
    return dSetFullYear(thisV, &a, 1);
}

V dGetYear(V thisV, V *, int)
{
    V y = getField(thisV, F_YEAR, true);
    return num(numOf(y) - 1900);
}

V dGetTimezoneOffset(V thisV, V *, int)
{
    double t = thisDate(thisV)->num;
    if (t != t)
        return num(t);
    loadTz();
    return num((double)-g_tzMinutes);
}

// setX(v...): the first field is `field`, later arguments the ones after it
V setField(V thisV, V *args, int argc, int field, bool local)
{
    JPrim *d = thisDate(thisV);
    double t = d->num;
    double vals[4];
    int n = 0;
    for (int i = 0; i < argc && i < 4; ++i)
        vals[n++] = toNumber(args[i]);
    if (argc == 0)
    {
        d->num = 0.0 / 0.0;
        return num(d->num);
    }
    if (t != t)
    {
        if (field != F_YEAR)
            return num(t);
        t = 0;
    }
    else if (local)
        t = toLocal(t);
    Parts p;
    partsOf(t, p);
    double f[7] = {p.year, (double)p.mon, (double)p.day, (double)p.hour, (double)p.min, (double)p.sec, (double)p.ms};
    int at = field == F_YEAR ? 0 : field == F_MONTH ? 1 : field == F_DATE ? 2 : field == F_HOURS ? 3 : field == F_MINUTES ? 4 : field == F_SECONDS ? 5 : 6;
    int maxAt = at <= 2 ? 2 : 6;
    for (int i = 0; i < n && at + i <= maxAt; ++i)
        f[at + i] = vals[i];
    double nt = makeTime(f[0], f[1], f[2], f[3], f[4], f[5], f[6]);
    if (local && nt == nt)
        nt = toUtc(nt);
    d->num = timeClip(nt);
    return num(d->num);
}

V dSetFullYear(V thisV, V *args, int argc)
{
    return setField(thisV, args, argc, F_YEAR, true);
}

V dSetUTCFullYear(V thisV, V *args, int argc)
