    ta->flags |= OF_CTOR;
    materializeFn(ta);
    defineOwn(ta, A.prototype, objv(PR.typedarray), 0);
    defineOwn(PR.typedarray, A.constructor, objv(ta), PF_W | PF_C);
    defGetter(PR.typedarray, "length", taLength);
    defGetter(PR.typedarray, "byteLength", taByteLength);
