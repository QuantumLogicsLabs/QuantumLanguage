        defineOwn(c, A.prototype, objv(proto), 0);
        defineOwn(proto, A.constructor, objv(c), PF_W | PF_C);
        defineOwn(g_taHolder, atomOf(TA_NAMES[i]), objv(c), PF_DEFAULT);
        c->data = num((double)i);
        c->proto = ta;
        g_taCtors[i] = objv(c);
        defVal(c, "BYTES_PER_ELEMENT", num((double)TA_SIZE[i]), 0);
        defVal(proto, "BYTES_PER_ELEMENT", num((double)TA_SIZE[i]), 0);
    }
}

