V dSetTimeImpl(V thisV, V *args, int argc)
{
    JPrim *d = thisDate(thisV);
    d->num = timeClip(toNumber(argOr(args, argc, 0)));
    return num(d->num);
}

V dToISOString(V thisV, V *, int)
{
    double t = thisDate(thisV)->num;
    if (t != t)
        throwRange("Invalid time value");
    return str(isoString(t));
}

V dToJSON(V thisV, V *, int)
{
    V ov = toObject(thisV);
    V tv = toPrimitive(ov, 1);
    if (isNum(tv) && numOf(tv) - numOf(tv) != 0)
        return Null;
    return invoke(ov, atomOf("toISOString"), nullptr, 0);
}

V dToString(V thisV, V *, int)
{
    double t = thisDate(thisV)->num;
    if (t != t)
        return strA("Invalid Date");
    double l = toLocal(t);
    return str(datePart(l) + " " + timePart(l));
}

V dToDateString(V thisV, V *, int)
{
    double t = thisDate(thisV)->num;
    if (t != t)
        return strA("Invalid Date");
    return str(datePart(toLocal(t)));
}

V dToTimeString(V thisV, V *, int)
{
    double t = thisDate(thisV)->num;
    if (t != t)
        return strA("Invalid Date");
    return str(timePart(toLocal(t)));
}

V dToUTCString(V thisV, V *, int)
{
    double t = thisDate(thisV)->num;
    if (t != t)
        return strA("Invalid Date");
    Parts p;
    partsOf(t, p);
    char buf[64];
    snprintf(buf, sizeof buf, "%s, %02d %s ", DAY_NAMES[p.wday], p.day, MON_NAMES[p.mon]);
    char tail[32];
    snprintf(tail, sizeof tail, " %02d:%02d:%02d GMT", p.hour, p.min, p.sec);
    std::string y = p.year >= 0 ? (p.year <= 9999 ? yearText(p.year) : std::to_string((long long)p.year)) : "-" + std::to_string((long long)-p.year);
    return str(buf + y + tail);
}

V dToPrimitive(V thisV, V *args, int argc)
{
    if (!isObj(thisV))
        throwType("Date.prototype[Symbol.toPrimitive] called on non-object");
    V hint = argOr(args, argc, 0);
    std::string h = isStr(hint) ? toUtf8(sp_(hint)) : "";
    if (h != "string" && h != "default" && h != "number")
        throwType("Invalid hint: " + inspectBrief(hint));
    bool wantStr = h != "number";
    V order[2] = {wantStr ? A.toString : A.valueOf, wantStr ? A.valueOf : A.toString};
    for (int i = 0; i < 2; ++i)
    {
        V m = getProp(thisV, order[i]);
        if (isCallable(m))
        {
            V r = call(m, thisV, nullptr, 0);
            if (!isObj(r))
                return r;
        }
    }
    throwType("Cannot convert object to primitive value");
}

// the locale forms go through Intl, loaded when somebody first wants them
V localeVia(V thisV, V *args, int argc, const char *fn)
{
    thisDate(thisV);
    V intlHelper = getProp(requireModule("intl"), atomOf(fn));
    V a[3] = {thisV, argOr(args, argc, 0), argOr(args, argc, 1)};
    return call(intlHelper, Undefined, a, 3);
}

V dToLocaleString(V thisV, V *args, int argc) { return localeVia(thisV, args, argc, "dateToLocaleString"); }
V dToLocaleDateString(V thisV, V *args, int argc) { return localeVia(thisV, args, argc, "dateToLocaleDateString"); }
V dToLocaleTimeString(V thisV, V *args, int argc) { return localeVia(thisV, args, argc, "dateToLocaleTimeString"); }

// ── typed array storage ──────────────────────────────────────────────────

struct JBuffer : Obj
{
    uint8_t *data;
    int64_t size;
};

enum TAType : uint8_t
{
    TA_INT8, TA_UINT8, TA_CLAMPED, TA_INT16, TA_UINT16, TA_INT32, TA_UINT32, TA_FLOAT32, TA_FLOAT64, TA_BIGINT64, TA_BIGUINT64
};

const int TA_SIZE[] = {1, 1, 1, 2, 2, 4, 4, 4, 8, 8, 8};
const char *const TA_NAMES[] = {"Int8Array", "Uint8Array", "Uint8ClampedArray", "Int16Array", "Uint16Array", "Int32Array", "Uint32Array", "Float32Array", "Float64Array", "BigInt64Array", "BigUint64Array"};

struct JTyped : Obj
{
    JBuffer *buf;
    int64_t offset;
    int64_t length;
    uint8_t type;
};

Obj *g_taProtos[11];
V g_taCtors[11];
Obj *g_taHolder = nullptr;

V bufferNew(int64_t size, Obj *proto)
{
    JBuffer *b = static_cast<JBuffer *>(allocObj(sizeof(JBuffer), C_ARRAYBUFFER, proto));
    b->data = static_cast<uint8_t *>(bump((size_t)size + 8));
    b->size = size;
    return objv(b);
}

V bufCtor(V, V *args, int argc)
{
    if (g_nativeNewTarget == Undefined)
        throwType("Constructor ArrayBuffer requires 'new'");
    double d = toIntegerOrInf(argOr(args, argc, 0));
    if (d < 0 || d > 2147483647.0)
        throwRange("Invalid array buffer length");
    return bufferNew((int64_t)d, protoFromCtor(g_nativeNewTarget, PR.arraybuffer));
}

JBuffer *thisBuf(V v, const char *name)
{
    if (!isObj(v) || op(v)->cls != C_ARRAYBUFFER)
        throwType(std::string("Method ArrayBuffer.prototype.") + name + " called on incompatible receiver " + inspectBrief(v));
    return static_cast<JBuffer *>(op(v));
}

V bufByteLength(V thisV, V *, int)
{
    return num((double)thisBuf(thisV, "byteLength")->size);
}

V bufSlice(V thisV, V *args, int argc)
{
    JBuffer *b = thisBuf(thisV, "slice");
    double s = toIntegerOrInf(argOr(args, argc, 0));
    V ev = argOr(args, argc, 1);
    double e = ev == Undefined ? (double)b->size : toIntegerOrInf(ev);
    double n = (double)b->size;
    s = s < 0 ? std::fmax(n + s, 0.0) : std::fmin(s, n);
    e = e < 0 ? std::fmax(n + e, 0.0) : std::fmin(e, n);
    int64_t size = e > s ? (int64_t)(e - s) : 0;
    V r = bufferNew(size, PR.arraybuffer);
    if (size)
        std::memcpy(static_cast<JBuffer *>(op(r))->data, b->data + (int64_t)s, (size_t)size);
    return r;
}

V bufIsView(V, V *args, int argc)
{
    V v = argOr(args, argc, 0);
    if (!isObj(v))
        return False;
    if (op(v)->cls == C_TYPEDARRAY || op(v)->cls == C_DATAVIEW)
        return True;
    return False;
}

V typedRead(JTyped *t, int64_t i)
{
    uint8_t *p = t->buf->data + t->offset + i * TA_SIZE[t->type];
    switch (t->type)
    {
    case TA_INT8: return num((double)*reinterpret_cast<int8_t *>(p));
    case TA_UINT8:
    case TA_CLAMPED: return num((double)*p);
    case TA_INT16:
    {
        int16_t x;
        std::memcpy(&x, p, 2);
        return num((double)x);
    }
    case TA_UINT16:
    {
        uint16_t x;
        std::memcpy(&x, p, 2);
        return num((double)x);
    }
    case TA_INT32:
    {
        int32_t x;
        std::memcpy(&x, p, 4);
        return num((double)x);
    }
    case TA_UINT32:
    {
        uint32_t x;
        std::memcpy(&x, p, 4);
        return num((double)x);
    }
    case TA_FLOAT32:
    {
        float x;
        std::memcpy(&x, p, 4);
        return num((double)x);
    }
    case TA_FLOAT64:
    {
        double x;
        std::memcpy(&x, p, 8);
        if (x != x)
            x = 0.0 / 0.0;
        return num(x);
    }
    case TA_BIGINT64:
    {
        int64_t x;
        std::memcpy(&x, p, 8);
        return x < 0 ? bigFromU64((uint64_t)0 - (uint64_t)x, true) : bigFromU64((uint64_t)x, false);
    }
    default:
    {
        uint64_t x;
        std::memcpy(&x, p, 8);
        return bigFromU64(x, false);
    }
    }
}

void typedWrite(JTyped *t, int64_t i, V v)
{
    uint8_t *p = t->buf->data + t->offset + i * TA_SIZE[t->type];
    switch (t->type)
    {
    case TA_INT8:
    case TA_UINT8:
        *p = (uint8_t)toInt32(v);
        return;
    case TA_CLAMPED:
    {
        double d = toNumber(v);
        if (!(d > 0))
            *p = 0;
        else if (d >= 255)
            *p = 255;
        else
        {
            double f = std::floor(d);
            double diff = d - f;
            int r = (int)f;
            if (diff > 0.5 || (diff == 0.5 && (r & 1)))
                ++r;
            *p = (uint8_t)r;
        }
        return;
    }
    case TA_INT16:
    case TA_UINT16:
    {
        uint16_t x = (uint16_t)toInt32(v);
        std::memcpy(p, &x, 2);
        return;
    }
    case TA_INT32:
    case TA_UINT32:
    {
        uint32_t x = (uint32_t)toInt32(v);
        std::memcpy(p, &x, 4);
        return;
    }
    case TA_FLOAT32:
    {
        float x = (float)toNumber(v);
        std::memcpy(p, &x, 4);
        return;
    }
    case TA_FLOAT64:
    {
        double x = toNumber(v);
        std::memcpy(p, &x, 8);
        return;
    }
    default:
    {
        V b = v;
        if (!isBig(b))
        {
            b = toPrimitive(v, 1);
            if (isBool(b))
                b = bigFromU64(b == True ? 1 : 0, false);
            else if (isStr(b))
            {
                bool ok = true;
                JBig *x = bigFromStr(sp_(b), &ok);
                if (!ok)
                    throwError(E_SYNTAX, "Cannot convert " + toUtf8(sp_(b)) + " to a BigInt");
                b = bigv(x);
            }
            else if (!isBig(b))
                throwType("Cannot convert " + inspectBrief(b) + " to a BigInt");
        }
        uint64_t x = bigToU64(bigp(b));
        std::memcpy(p, &x, 8);
    }
    }
}

V typedCtor(V, V *args, int argc)
{
    int type = (int)numOf(g_nativeCallee->data);
    if (g_nativeNewTarget == Undefined)
        throwType(std::string("Constructor ") + TA_NAMES[type] + " requires 'new'");
    Obj *proto = protoFromCtor(g_nativeNewTarget, g_taProtos[type]);
    JTyped *t = static_cast<JTyped *>(allocObj(sizeof(JTyped), C_TYPEDARRAY, proto));
    t->type = (uint8_t)type;
    int esz = TA_SIZE[type];
    V a0 = argOr(args, argc, 0);
    if (!isObj(a0))
    {
        double n = toIntegerOrInf(a0);
        if (n < 0 || n * esz > 2147483647.0)
            throwRange("Invalid typed array length: " + numberToStd(n));
        V b = bufferNew((int64_t)n * esz, PR.arraybuffer);
        t->buf = static_cast<JBuffer *>(op(b));
        t->length = (int64_t)n;
        return objv(t);
    }
    if (op(a0)->cls == C_ARRAYBUFFER)
    {
        JBuffer *b = static_cast<JBuffer *>(op(a0));
        double off = toIntegerOrInf(argOr(args, argc, 1));
        if (std::fmod(off, esz) != 0)
            throwRange(std::string("start offset of ") + TA_NAMES[type] + " should be a multiple of " + std::to_string(esz));
        if (off < 0 || off > (double)b->size)
            throwRange("Start offset " + numberToStd(off) + " is outside the bounds of the buffer");
        V lv = argOr(args, argc, 2);
        int64_t len;
        if (lv == Undefined)
        {
            if ((b->size - (int64_t)off) % esz)
                throwRange(std::string("byte length of ") + TA_NAMES[type] + " should be a multiple of " + std::to_string(esz));
            len = (b->size - (int64_t)off) / esz;
        }
        else
        {
            len = (int64_t)toIntegerOrInf(lv);
            if (len < 0 || (int64_t)off + len * esz > b->size)
                throwRange("Invalid typed array length: " + std::to_string(len));
        }
        t->buf = b;
        t->offset = (int64_t)off;
        t->length = len;
        return objv(t);
    }
    // from a list of values
    std::vector<V> vals;
    if (op(a0)->cls == C_TYPEDARRAY)
    {
        JTyped *src = static_cast<JTyped *>(op(a0));
        for (int64_t i = 0; i < src->length; ++i)
            vals.push_back(typedRead(src, i));
    }
    else
    {
        V m = getProp(a0, WK.iterator);
        if (!isNullish(m))
            iterableToVec(a0, vals);
        else
        {
            int64_t n = toLength(getProp(a0, A.length));
            for (int64_t i = 0; i < n; ++i)
                vals.push_back(getIdx(a0, (double)i));
        }
    }
    V b = bufferNew((int64_t)vals.size() * esz, PR.arraybuffer);
    t->buf = static_cast<JBuffer *>(op(b));
    t->length = (int64_t)vals.size();
    for (size_t i = 0; i < vals.size(); ++i)
        typedWrite(t, (int64_t)i, vals[i]);
    return objv(t);
}

JTyped *thisTyped(V v)
{
    if (!isObj(v) || op(v)->cls != C_TYPEDARRAY)
        throwType("this is not a typed array.");
    return static_cast<JTyped *>(op(v));
}

V taLength(V thisV, V *, int)
{
    return num((double)thisTyped(thisV)->length);
}

V taByteLength(V thisV, V *, int)
{
    JTyped *t = thisTyped(thisV);
    return num((double)(t->length * TA_SIZE[t->type]));
}

V taByteOffset(V thisV, V *, int)
{
    return num((double)thisTyped(thisV)->offset);
}

V taBuffer(V thisV, V *, int)
{
    return objv(thisTyped(thisV)->buf);
}

V taTag(V thisV, V *, int)
{
    if (!isObj(thisV) || op(thisV)->cls != C_TYPEDARRAY)
        return Undefined;
    return atomOf(TA_NAMES[static_cast<JTyped *>(op(thisV))->type]);
}

V taAbstractCtor(V, V *, int)
{
    throwType("Abstract class TypedArray not directly constructable");
}

V speciesThis(V thisV, V *, int)
{
    return thisV;
}

} // namespace

int typedGetKey(Obj *o, V key, V *out)
{
    if (!isStr(key))
        return -1;
    JStr *k = sp_(key);
    if (!k->isIdx)
        return -1;
    JTyped *t = static_cast<JTyped *>(o);
    if ((int64_t)k->idx >= t->length)
        return 0;
    *out = typedRead(t, k->idx);
    return 1;
}

// by number, without making a key of it; -1 when it is no valid index
int typedGetIndex(Obj *o, double d, V *out)
{
    JTyped *t = static_cast<JTyped *>(o);
    int64_t i = (int64_t)d;
    if ((double)i != d || i < 0 || (i == 0 && 1 / d < 0))
        return -1;
    if (i >= t->length)
        return 0;
    *out = typedRead(t, i);
    return 1;
}

int typedSetIndex(Obj *o, double d, V val)
{
    JTyped *t = static_cast<JTyped *>(o);
    int64_t i = (int64_t)d;
    if ((double)i != d || i < 0 || i >= t->length || (i == 0 && 1 / d < 0))
        return -1;
    typedWrite(t, i, val);
    return 1;
}

int typedSetKey(Obj *o, V key, V val)
{
    if (!isStr(key))
        return -1;
    JStr *k = sp_(key);
    if (!k->isIdx)
        return -1;
    JTyped *t = static_cast<JTyped *>(o);
    // converted even when out of range: the conversion can have effects
    if ((int64_t)k->idx >= t->length)
    {
        if (t->type >= TA_BIGINT64)
            return 0;
        toNumber(val);
        return 0;
    }
    typedWrite(t, k->idx, val);
    return 1;
}

int64_t typedLength(Obj *o)
{
    return static_cast<JTyped *>(o)->length;
}

Obj *typedArrayHolder()
{
    return g_taHolder;
}

// the buffer's bytes, for the JavaScript library
uint8_t *bufferBytes(V buffer, int64_t *size)
{
    JBuffer *b = static_cast<JBuffer *>(op(buffer));
    *size = b->size;
    return b->data;
}

void initDateBuiltins()
{
    JFunc *c = defCtor("Date", dateCtor, 7, PR.date);
    defFn(c, "now", dNow, 0);
    defFn(c, "parse", dParse, 1);
    defFn(c, "UTC", dUTC, 7);
    Obj *p = PR.date;
    defFn(p, "getFullYear", dGetFullYear, 0);
    defFn(p, "getUTCFullYear", dGetUTCFullYear, 0);
    defFn(p, "getMonth", dGetMonth, 0);
    defFn(p, "getUTCMonth", dGetUTCMonth, 0);
    defFn(p, "getDate", dGetDate, 0);
    defFn(p, "getUTCDate", dGetUTCDate, 0);
    defFn(p, "getDay", dGetDay, 0);
    defFn(p, "getUTCDay", dGetUTCDay, 0);
    defFn(p, "getHours", dGetHours, 0);
    defFn(p, "getUTCHours", dGetUTCHours, 0);
    defFn(p, "getMinutes", dGetMinutes, 0);
    defFn(p, "getUTCMinutes", dGetUTCMinutes, 0);
    defFn(p, "getSeconds", dGetSeconds, 0);
    defFn(p, "getUTCSeconds", dGetUTCSeconds, 0);
    defFn(p, "getMilliseconds", dGetMilliseconds, 0);
    defFn(p, "getUTCMilliseconds", dGetUTCMilliseconds, 0);
    defFn(p, "setFullYear", dSetFullYear, 3);
    defFn(p, "setUTCFullYear", dSetUTCFullYear, 3);
    defFn(p, "setMonth", dSetMonth, 2);
    defFn(p, "setUTCMonth", dSetUTCMonth, 2);
    defFn(p, "setDate", dSetDate, 1);
    defFn(p, "setUTCDate", dSetUTCDate, 1);
    defFn(p, "setHours", dSetHours, 4);
    defFn(p, "setUTCHours", dSetUTCHours, 4);
    defFn(p, "setMinutes", dSetMinutes, 3);
    defFn(p, "setUTCMinutes", dSetUTCMinutes, 3);
    defFn(p, "setSeconds", dSetSeconds, 2);
    defFn(p, "setUTCSeconds", dSetUTCSeconds, 2);
    defFn(p, "setMilliseconds", dSetMilliseconds, 1);
