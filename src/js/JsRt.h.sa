// what a catch must put back: the throw left the stacks where it happened
struct JsState
{
    V *sp;
    Frame *frame;
    JFunc *callee;
    V newTarget;
    JsState() : sp(g_sp), frame(g_frame), callee(g_nativeCallee), newTarget(g_nativeNewTarget) {}
    void restore()
    {
        g_sp = sp;
        g_frame = frame;
        g_nativeCallee = callee;
        g_nativeNewTarget = newTarget;
    }
};
std::string stackTraceText(V header, V skipUntil);

