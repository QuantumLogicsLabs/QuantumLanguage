// quantum: cpp
#pragma once
// JavaScript front-end: the runtime. A value is a 64-bit word: a double, or a
// NaN whose top bits say what the rest points at. Memory comes from a bump
// allocator and is never freed: the programs this runs are short.
#include "JsAst.h.sa"
#include "JsUnicode.h.sa"

#include <cstdint>
#include <cstring>
#include <string>
#include <vector>

namespace js
{

// Macros, not functions: the native backend does not inline, and these are
// the interpreter's hottest operations. Arguments must have no side effects.
#define JTAG_MIN ((V)0xFFF9000000000000ULL)
#define JTAG_STR ((V)0xFFFA000000000000ULL)
#define JTAG_OBJ ((V)0xFFFB000000000000ULL)
#define JTAG_SYM ((V)0xFFFC000000000000ULL)
#define JTAG_BIG ((V)0xFFFD000000000000ULL)
#define JPTR_MASK ((V)0x0000FFFFFFFFFFFFULL)
#define Undefined ((V)0xFFF9000000000001ULL)
#define Null ((V)0xFFF9000000000002ULL)
#define False ((V)0xFFF9000000000003ULL)
#define True ((V)0xFFF9000000000004ULL)
#define Hole ((V)0xFFF9000000000005ULL)    // an array hole; a binding in its dead zone
#define OptShort ((V)0xFFF9000000000006ULL) // an optional chain stopped here
#define isNum(v) ((V)(v) < JTAG_MIN)
#define isStr(v) (((V)(v) >> 48) == 0xFFFA)
#define isObj(v) (((V)(v) >> 48) == 0xFFFB)
#define isSym(v) (((V)(v) >> 48) == 0xFFFC)
#define isBig(v) (((V)(v) >> 48) == 0xFFFD)
#define isBool(v) ((V)(v) == True || (V)(v) == False)
#define isNullish(v) ((V)(v) == Undefined || (V)(v) == Null)
#define boolv(b) ((b) ? True : False)
#define strv(p) ((V)(uintptr_t)(p) | JTAG_STR)
#define objv(p) ((V)(uintptr_t)(p) | JTAG_OBJ)
#define symv(p) ((V)(uintptr_t)(p) | JTAG_SYM)
#define bigv(p) ((V)(uintptr_t)(p) | JTAG_BIG)
#define sp_(v) (reinterpret_cast<JStr *>((V)(v) & JPTR_MASK))
#define op(v) (reinterpret_cast<Obj *>((V)(v) & JPTR_MASK))
#define symp(v) (reinterpret_cast<JSym *>((V)(v) & JPTR_MASK))
#define bigp(v) (reinterpret_cast<JBig *>((V)(v) & JPTR_MASK))
// D needs an lvalue; BITS needs a double lvalue
#define D(x) (*reinterpret_cast<double *>(&(x)))
#define BITS(d) (*reinterpret_cast<V *>(&(d)))

struct Obj;
struct JFunc;
struct Frame;
struct Env;

// ── strings: UTF-16 semantics; bytes when every unit fits; ropes until read ──

struct JStr
{
    int32_t len;
    uint8_t wide;
    uint8_t flat;
    uint8_t isAtom;
    uint8_t isIdx;   // an atom spelling an array index
    uint32_t hash;   // 0: not computed
    uint32_t idx;
    const uint8_t *a;
    const uint16_t *w;
    JStr *left, *right; // not flat
    JStr *atom;      // this string's atom, once known
};

struct JSym
{
    V desc;      // string or Undefined
    bool isPrivate;
    bool registered;
    uint32_t hash;
};

struct JBig
{
    bool neg;
    int n;
    uint32_t *d; // little-endian limbs, n > 0 except for zero
};

#define unitAt(s, i) ((s)->wide ? (int)(s)->w[i] : (int)(s)->a[i])

JStr *flatten(JStr *s);
#define flat_(s) ((s)->flat ? (s) : flatten(s))

// ── objects ──────────────────────────────────────────────────────────────

enum PF : uint8_t
{
    PF_W = 1,        // writable
    PF_E = 2,        // enumerable
    PF_C = 4,        // configurable
    PF_ACCESSOR = 8, // the slot holds an Accessor
    PF_DEFAULT = 7
};

struct KeyTable; // key -> index, open addressing

struct Shape
{
    Shape *parent;
    V key;
    int32_t index;   // of the last property added; slots used = index + 1
    int32_t count;
    uint8_t flags;
    bool isDict;     // owned by one object; `dkeys` below is its truth
    bool hasIndexKeys;
    Shape *t1;       // first transition
    KeyTable *trans; // the rest (key+flags -> Shape*)
    KeyTable *table; // key -> index+flags, built on demand
    // a dictionary's properties in order (deleted: key 0)
    V *dkeys;
    uint8_t *dflags;
    int32_t dused, dcap;
    V *keysCache;    // own keys in order, for walking
};

enum Cls : uint8_t
{
    C_OBJECT,
    C_ARRAY,
    C_FUNCTION,
    C_ERROR,
    C_BOOLEAN,
    C_NUMBER,
    C_STRING,
    C_SYMBOL,
    C_BIGINT,
    C_DATE,
    C_REGEXP,
    C_MAP,
    C_SET,
    C_WEAKMAP,
    C_WEAKSET,
    C_WEAKREF,
    C_ARGUMENTS,
    C_PROMISE,
    C_GENERATOR,
    C_ASYNCGENERATOR,
    C_PROXY,
    C_ARRAYBUFFER,
    C_TYPEDARRAY,
    C_DATAVIEW,
    C_ARRAYITER,
    C_STRINGITER,
    C_MAPITER,
    C_SETITER,
    C_REGEXPITER,
    C_ACCESSOR,       // internal: a getter and a setter
    C_MODULENS
};

enum ObjFlags : uint8_t
{
    OF_NONEXT = 1,    // not extensible
    OF_FROZEN = 2,    // an array's elements are frozen
    OF_SEALED = 4,    // an array's elements are sealed
    OF_LAZYFN = 8,    // a function that has not made name/length/prototype yet
    OF_CALLABLE = 16,
    OF_CTOR = 32,
    OF_NOINDEXFLAGS = 64
};

struct Obj
{
    Shape *shape;
    V *slots;
    Obj *proto;
    int32_t cap;
    uint8_t cls;
    uint8_t flags;
    uint16_t pad;
};

struct Accessor : Obj
{
    V get, set;
};

struct JArray : Obj
{
    V *el;
    uint32_t len;   // the array's length
    uint32_t used;  // elements stored; those above are holes
    uint32_t elCap;
};

// wraps a primitive; a Date's time (num); an error
struct JPrim : Obj
{
    V val;
    double num;
};

typedef V (*NativeFn)(V thisV, V *args, int argc);

enum FnKind : uint8_t
{
    FK_NATIVE,
    FK_NORMAL,
    FK_ARROW,
    FK_GENERATOR,
    FK_ASYNC,
    FK_ASYNCGEN,
    FK_CLASS,
    FK_BOUND,
    FK_PROXY
};

struct JFunc : Obj
{
    uint8_t kind;
    bool isCtorNative;
    NativeFn nat;
    FuncNode *node;
    Env *env;
    V thisV;       // an arrow's this; a bound function's this
    V newTarget;   // an arrow's new.target
    V home;        // a method's home object
    V fnName;      // a native's name
    int natLen;
    V target;      // bound: the target
    V *boundArgs;
    int nBound;
    V *fieldsInit; // a class: instance fields [key, kindflag, valueFunc]...
    int nFields;
    Env *fieldEnv;
    V data;        // a native closure's data
    V data2;
    V classHeritageProto;
};

// an environment: captured variables of one scope instance
struct Env
{
    Env *parent;
    Scope *scope;
    V *slots;
    V withObj;     // `with`
    Obj *dyn;      // variables a sloppy eval added
};

struct Frame
{
    V receiver;      // an arrow's: only for naming it in stack traces
    V *locals;
    Env *env;
    V thisV;
    JFunc *fn;
    FuncNode *node;
    V newTarget;
    V *args;
    int argc;
    Frame *prev;
    Node *cur;      // the call in progress, for stack traces
    void *co;       // this frame's coroutine
    bool thisInit;  // false in a derived constructor before super()
    bool isNative;
};

struct JsThrow
{
    V val;
};

// Generator.prototype.return unwinding a suspended frame: runs finally blocks
struct GenReturn
{
    V val;
};

// process.exit
struct JsExit
{
    int code;
};

enum Comp : uint8_t
{
    CO_NONE,
    CO_BREAK,
    CO_CONTINUE,
    CO_RETURN
};

// ── the runtime's state ──────────────────────────────────────────────────

struct Atoms
{
    V length, prototype, constructor, name, message, stack, cause, errors, value, done, next, ret, throw_, get, set, writable, enumerable,
        configurable, toString, valueOf, toJSON, callee, caller, arguments_, index, input, groups, indices, lastIndex, source, flags, raw, then,
        empty, undefined, null_, true_, false_, object, function, number, string, boolean, symbol, bigint, default_, join, proto, global, deref,
        size, has, add, keys, exec, code, anonymous;
};

struct WellKnown
{
    V iterator, asyncIterator, hasInstance, toPrimitive, toStringTag, species, isConcatSpreadable, unscopables, match, matchAll, replace, search,
        split;
};

struct Protos
{
    Obj *object, *function, *array, *string, *number, *boolean, *symbol, *bigint, *error, *iterator, *arrayIter, *stringIter, *mapIter, *setIter,
        *regexpIter, *generator, *asyncGenerator, *generatorFunction, *asyncFunction, *asyncGenFunction, *asyncIterator, *regexp, *date, *map, *set,
        *weakmap, *weakset, *weakref, *promise, *arraybuffer, *typedarray, *dataview;
    Obj *errorTypes[8]; // by ErrorType
    V ctorArray, ctorObject, ctorPromise, ctorFunction, ctorRegExp, ctorMap, ctorSet;
};

enum ErrorType
{
    E_ERROR,
    E_TYPE,
    E_RANGE,
    E_SYNTAX,
    E_REFERENCE,
    E_EVAL,
    E_URI,
    E_AGGREGATE
};

extern V *g_sp;
extern V *g_spBase, *g_spEnd;
extern Frame *g_frame;
extern uint8_t g_comp;
extern V g_compLabel;
extern V g_retVal;
extern char *g_stackLimit;
extern Atoms A;
extern WellKnown WK;
extern Protos PR;
extern Obj *g_global;
extern Shape *g_rootShape;
extern std::string g_out;
extern std::string g_scriptPath;

