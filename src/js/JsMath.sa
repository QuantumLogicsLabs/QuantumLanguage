#include "JsRt.h.sa"
#include <cmath>

namespace js
{

namespace
{

int32_t hiWord(double x)
{
    uint64_t b = *reinterpret_cast<uint64_t *>(&x);
    return (int32_t)(uint32_t)(b >> 32);
}

uint32_t loWord(double x)
{
    uint64_t b = *reinterpret_cast<uint64_t *>(&x);
    return (uint32_t)b;
}

double fromWords(int32_t hi, uint32_t lo)
{
    uint64_t b = ((uint64_t)(uint32_t)hi << 32) | (uint64_t)lo;
    return *reinterpret_cast<double *>(&b);
}

double withHi(double x, int32_t hi)
{
    return fromWords(hi, loWord(x));
}

double withLo(double x, uint32_t lo)
{
    return fromWords(hiWord(x), lo);
}

double nanValue()
{
    double zero = 0.0;
    return zero / zero;
}

double infinity()
{
    double zero = 0.0;
    return 1.0 / zero;
}

double scaleBy(double x, int n)
{
    const double two54 = 1.80143985094819840000e+16, twom54 = 5.55111512312578270212e-17, huge = 1.0e+300, tiny = 1.0e-300;
    int32_t hx = hiWord(x);
    uint32_t lx = loWord(x);
    int32_t k = (hx & 0x7ff00000) >> 20;
    if (k == 0)
    {
        if ((lx | (uint32_t)(hx & 0x7fffffff)) == 0)
            return x;
        x *= two54;
        hx = hiWord(x);
        k = ((hx & 0x7ff00000) >> 20) - 54;
        if (n < -50000)
            return tiny * x;
    }
    if (k == 0x7ff)
        return x + x;
    k = k + n;
    double signedHuge = x < 0 ? -huge : huge, signedTiny = x < 0 ? -tiny : tiny;
    if (k > 0x7fe)
        return huge * signedHuge;
    if (k > 0)
        return withHi(x, (hx & (int32_t)0x800fffff) | (k << 20));
    if (k <= -54)
    {
        if (n > 50000)
            return huge * signedHuge;
        return tiny * signedTiny;
    }
    k += 54;
    x = withHi(x, (hx & (int32_t)0x800fffff) | (k << 20));
    return x * twom54;
}

double kSin(double x, double y, int iy)
{
    const double half = 5.00000000000000000000e-01;
    const double S1 = -1.66666666666666324348e-01, S2 = 8.33333333332248946124e-03, S3 = -1.98412698298579493134e-04,
                 S4 = 2.75573137070700676789e-06, S5 = -2.50507602534068634195e-08, S6 = 1.58969099521155010221e-10;
    int32_t ix = hiWord(x) & 0x7fffffff;
    if (ix < 0x3e400000)
    {
        if ((int)x == 0)
            return x;
    }
    double z = x * x;
    double v = z * x;
    double r = S2 + z * (S3 + z * (S4 + z * (S5 + z * S6)));
    if (iy == 0)
        return x + v * (S1 + z * r);
    return x - ((z * (half * y - v * r) - y) - v * S1);
}

double kCos(double x, double y)
{
    const double one = 1.0;
    const double C1 = 4.16666666666666019037e-02, C2 = -1.38888888888741095749e-03, C3 = 2.48015872894767294178e-05,
                 C4 = -2.75573143513906633035e-07, C5 = 2.08757232129817482790e-09, C6 = -1.13596475577881948265e-11;
    int32_t ix = hiWord(x) & 0x7fffffff;
    if (ix < 0x3e400000)
    {
        if ((int)x == 0)
            return one;
    }
    double iz = x * x;
    double r = iz * (C1 + iz * (C2 + iz * (C3 + iz * (C4 + iz * (C5 + iz * C6)))));
    if (ix < 0x3FD33333)
        return one - (0.5 * iz - (iz * r - x * y));
    double qx;
    if (ix > 0x3fe90000)
        qx = 0.28125;
    else
        qx = fromWords(ix - 0x00200000, 0);
    double hz = 0.5 * iz - qx;
    double a = one - qx;
    return a - (hz - (iz * r - x * y));
}

double kTan(double x, double y, int iy)
{
    static const double T[] = {
        3.33333333333334091986e-01, 1.33333333333201242699e-01, 5.39682539762260521377e-02, 2.18694882948595424599e-02,
        8.86323982359930005737e-03, 3.59207910759131235356e-03, 1.45620945432529025516e-03, 5.88041240820264096874e-04,
        2.46463134818469906812e-04, 7.81794442939557092300e-05, 7.14072491382608190305e-05, -1.85586374855275456654e-05,
        2.59073051863633712884e-05};
    const double one = 1.0;
    const double pio4 = 7.85398163397448278999e-01, pio4lo = 3.06161699786838301793e-17;
    int32_t hx = hiWord(x);
    int32_t ix = hx & 0x7fffffff;
    if (ix < 0x3e300000)
    {
        if ((int)x == 0)
        {
            uint32_t low = loWord(x);
            if (((uint32_t)ix | low | (uint32_t)(iy + 1)) == 0)
                return one / std::fabs(x);
            if (iy == 1)
                return x;
            double w = x + y;
            double z = withLo(w, 0);
            double v = y - (z - x);
            double a = -1.0 / w;
            double t = withLo(a, 0);
            double s = 1.0 + t * z;
            return t + a * (s + t * v);
        }
    }
    if (ix >= 0x3FE59428)
    {
        if (hx < 0)
        {
            x = -x;
            y = -y;
        }
        double z = pio4 - x;
        double w = pio4lo - y;
        x = z + w;
        y = 0.0;
    }
    double z = x * x;
    double w = z * z;
    double r = T[1] + w * (T[3] + w * (T[5] + w * (T[7] + w * (T[9] + w * T[11]))));
    double v = z * (T[2] + w * (T[4] + w * (T[6] + w * (T[8] + w * (T[10] + w * T[12])))));
    double s = z * x;
    r = y + z * (s * (r + v) + y);
    r += T[0] * s;
    w = x + r;
    if (ix >= 0x3FE59428)
    {
        v = (double)iy;
        return (double)(1 - ((hx >> 30) & 2)) * (v - 2.0 * (x - (w * w / (w + v) - r)));
    }
    if (iy == 1)
        return w;
    z = withLo(w, 0);
    v = r - (z - x);
    double a = -1.0 / w;
    double t = withLo(a, 0);
    s = 1.0 + t * z;
    return t + a * (s + t * v);
}

int kRemPio2(double *x, double *y, int e0, int nx, int prec)
{
    static const int32_t twoOverPi[] = {
        0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62, 0x95993C, 0x439041, 0xFE5163, 0xABDEBB, 0xC561B7,
        0x246E3A, 0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129, 0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C,
        0x7026B4, 0x5F7E41, 0x3991D6, 0x398353, 0x39F49C, 0x845F8B, 0xBDF928, 0x3B1FF8, 0x97FFDE, 0x05980F, 0xEF2F11,
        0x8B5A0A, 0x6D1F6D, 0x367ECF, 0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5, 0xF17B3D, 0x0739F7,
        0x8A5292, 0xEA6BFB, 0x5FB11F, 0x8D5D08, 0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3, 0x91615E,
        0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880, 0x4D7327, 0x310606, 0x1556CA, 0x73A8C9, 0x60E27B, 0xC08C6B};
    static const double PIo2[] = {1.57079625129699707031e+00, 7.54978941586159635335e-08, 5.39030252995776476554e-15,
                                  3.28200341200236520481e-22, 1.27065575308067607349e-29, 1.22933308981111328932e-36,
                                  2.73370053816464559624e-44, 2.16741683877804819444e-51};
    static const int initJk[] = {2, 3, 4, 6};
    const double zero = 0.0, one = 1.0, two24 = 1.67772160000000000000e+07, twon24 = 5.96046447753906250000e-08;
    int32_t jz, jx, jv, jp, jk, carry, n, iq[20], i, j, k, m, q0, ih;
    double z, fw, f[20], fq[20], q[20];

    jk = initJk[prec];
    jp = jk;
    jx = nx - 1;
    jv = (e0 - 3) / 24;
    if (jv < 0)
        jv = 0;
    q0 = e0 - 24 * (jv + 1);
    j = jv - jx;
    m = jx + jk;
    for (i = 0; i <= m; i++, j++)
        f[i] = j < 0 ? zero : (double)twoOverPi[j];
    for (i = 0; i <= jk; i++)
    {
        for (j = 0, fw = 0.0; j <= jx; j++)
            fw += x[j] * f[jx + i - j];
        q[i] = fw;
    }
    jz = jk;
    for (;;)
    {
        for (i = 0, j = jz, z = q[jz]; j > 0; i++, j--)
        {
            fw = (double)((int32_t)(twon24 * z));
            iq[i] = (int32_t)(z - two24 * fw);
            z = q[j - 1] + fw;
        }
        z = scaleBy(z, q0);
        z -= 8.0 * std::floor(z * 0.125);
        n = (int32_t)z;
        z -= (double)n;
        ih = 0;
        if (q0 > 0)
        {
            i = (iq[jz - 1] >> (24 - q0));
            n += i;
            iq[jz - 1] -= i << (24 - q0);
            ih = iq[jz - 1] >> (23 - q0);
        }
        else if (q0 == 0)
            ih = iq[jz - 1] >> 23;
        else if (z >= 0.5)
            ih = 2;
        if (ih > 0)
        {
            n += 1;
            carry = 0;
            for (i = 0; i < jz; i++)
            {
                j = iq[i];
                if (carry == 0)
                {
                    if (j != 0)
                    {
                        carry = 1;
                        iq[i] = 0x1000000 - j;
                    }
                }
                else
                    iq[i] = 0xffffff - j;
            }
            if (q0 > 0)
            {
                if (q0 == 1)
                    iq[jz - 1] &= 0x7fffff;
                else if (q0 == 2)
                    iq[jz - 1] &= 0x3fffff;
            }
            if (ih == 2)
            {
                z = one - z;
                if (carry != 0)
                    z -= scaleBy(one, q0);
            }
        }
        if (z == zero)
        {
            j = 0;
            for (i = jz - 1; i >= jk; i--)
                j |= iq[i];
            if (j == 0)
            {
                for (k = 1; jk - k >= 0 && iq[jk - k] == 0; k++)
                {
                }
                for (i = jz + 1; i <= jz + k; i++)
                {
                    f[jx + i] = (double)twoOverPi[jv + i];
                    for (j = 0, fw = 0.0; j <= jx; j++)
                        fw += x[j] * f[jx + i - j];
                    q[i] = fw;
                }
                jz += k;
                continue;
            }
        }
        break;
    }
    if (z == 0.0)
    {
        jz -= 1;
        q0 -= 24;
        while (iq[jz] == 0)
        {
            jz--;
            q0 -= 24;
        }
    }
    else
    {
        z = scaleBy(z, -q0);
        if (z >= two24)
        {
            fw = (double)((int32_t)(twon24 * z));
            iq[jz] = (int32_t)(z - two24 * fw);
            jz += 1;
            q0 += 24;
            iq[jz] = (int32_t)fw;
        }
        else
            iq[jz] = (int32_t)z;
    }
    fw = scaleBy(one, q0);
    for (i = jz; i >= 0; i--)
    {
        q[i] = fw * (double)iq[i];
        fw *= twon24;
    }
    for (i = jz; i >= 0; i--)
    {
        for (fw = 0.0, k = 0; k <= jp && k <= jz - i; k++)
            fw += PIo2[k] * q[i + k];
        fq[jz - i] = fw;
    }
    // prec 2: the only precision used here
    fw = 0.0;
    for (i = jz; i >= 0; i--)
        fw += fq[i];
    y[0] = ih == 0 ? fw : -fw;
    fw = fq[0] - fw;
    for (i = 1; i <= jz; i++)
        fw += fq[i];
    y[1] = ih == 0 ? fw : -fw;
    return n & 7;
}

int remPio2(double x, double *y)
{
    static const int32_t npio2hw[] = {
        0x3FF921FB, 0x400921FB, 0x4012D97C, 0x401921FB, 0x401F6A7A, 0x4022D97C, 0x4025FDBB, 0x402921FB,
        0x402C463A, 0x402F6A7A, 0x4031475C, 0x4032D97C, 0x40346B9C, 0x4035FDBB, 0x40378FDB, 0x403921FB,
        0x403AB41B, 0x403C463A, 0x403DD85A, 0x403F6A7A, 0x40407E4C, 0x4041475C, 0x4042106C, 0x4042D97C,
        0x4043A28C, 0x40446B9C, 0x404534AC, 0x4045FDBB, 0x4046C6CB, 0x40478FDB, 0x404858EB, 0x404921FB};
    const double zero = 0.0, half = 5.00000000000000000000e-01, two24 = 1.67772160000000000000e+07,
                 invpio2 = 6.36619772367581382433e-01, pio2_1 = 1.57079632673412561417e+00,
                 pio2_1t = 6.07710050650619224932e-11, pio2_2 = 6.07710050630396597660e-11,
                 pio2_2t = 2.02226624879595063154e-21, pio2_3 = 2.02226624871116645580e-21,
                 pio2_3t = 8.47842766036889956997e-32;
    double z, w, t, r, fn;
    double tx[3];
    int32_t e0, i, j, nx, n, ix, hx;
    uint32_t low;

    z = 0;
    hx = hiWord(x);
    ix = hx & 0x7fffffff;
    if (ix <= 0x3fe921fb)
    {
        y[0] = x;
        y[1] = 0;
        return 0;
    }
    if (ix < 0x4002d97c)
    {
        if (hx > 0)
        {
            z = x - pio2_1;
            if (ix != 0x3ff921fb)
            {
                y[0] = z - pio2_1t;
                y[1] = (z - y[0]) - pio2_1t;
            }
            else
            {
                z -= pio2_2;
                y[0] = z - pio2_2t;
                y[1] = (z - y[0]) - pio2_2t;
            }
            return 1;
        }
        z = x + pio2_1;
        if (ix != 0x3ff921fb)
        {
            y[0] = z + pio2_1t;
            y[1] = (z - y[0]) + pio2_1t;
        }
        else
        {
            z += pio2_2;
            y[0] = z + pio2_2t;
            y[1] = (z - y[0]) + pio2_2t;
        }
        return -1;
    }
    if (ix <= 0x413921fb)
    {
        t = std::fabs(x);
        n = (int32_t)(t * invpio2 + half);
        fn = (double)n;
        r = t - fn * pio2_1;
        w = fn * pio2_1t;
        if (n < 32 && ix != npio2hw[n - 1])
            y[0] = r - w;
        else
        {
            j = ix >> 20;
            y[0] = r - w;
            i = j - ((hiWord(y[0]) >> 20) & 0x7ff);
            if (i > 16)
            {
                t = r;
                w = fn * pio2_2;
                r = t - w;
                w = fn * pio2_2t - ((t - r) - w);
                y[0] = r - w;
                i = j - ((hiWord(y[0]) >> 20) & 0x7ff);
                if (i > 49)
                {
                    t = r;
                    w = fn * pio2_3;
                    r = t - w;
                    w = fn * pio2_3t - ((t - r) - w);
                    y[0] = r - w;
                }
            }
        }
        y[1] = (r - y[0]) - w;
        if (hx < 0)
        {
            y[0] = -y[0];
            y[1] = -y[1];
            return -n;
        }
        return n;
    }
    if (ix >= 0x7ff00000)
    {
        y[0] = y[1] = x - x;
        return 0;
    }
    low = loWord(x);
    e0 = (ix >> 20) - 1046;
    z = fromWords(ix - (e0 << 20), low);
    for (i = 0; i < 2; i++)
    {
        tx[i] = (double)((int32_t)z);
        z = (z - tx[i]) * two24;
    }
    tx[2] = z;
    nx = 3;
    while (tx[nx - 1] == zero)
        nx--;
    n = kRemPio2(tx, y, e0, nx, 2);
    if (hx < 0)
    {
        y[0] = -y[0];
        y[1] = -y[1];
        return -n;
    }
    return n;
}

const double kLg1 = 6.666666666666735130e-01, kLg2 = 3.999999999940941908e-01, kLg3 = 2.857142874366239149e-01,
             kLg4 = 2.222219843214978396e-01, kLg5 = 1.818357216161805012e-01, kLg6 = 1.531383769920937332e-01,
             kLg7 = 1.479819860511658591e-01;
const double kLn2Hi = 6.93147180369123816490e-01, kLn2Lo = 1.90821492927058770002e-10;

double kLog1p(double f)
{
    double s = f / (2.0 + f);
    double z = s * s;
    double w = z * z;
    double t1 = w * (kLg2 + w * (kLg4 + w * kLg6));
    double t2 = z * (kLg1 + w * (kLg3 + w * (kLg5 + w * kLg7)));
    double R = t2 + t1;
    double hfsq = 0.5 * f * f;
    return s * (hfsq + R);
}

} // namespace

double mathSin(double x)
{
    double y[2];
    int32_t ix = hiWord(x) & 0x7fffffff;
    if (ix <= 0x3fe921fb)
        return kSin(x, 0.0, 0);
    if (ix >= 0x7ff00000)
        return x - x;
    int n = remPio2(x, y);
    switch (n & 3)
    {
    case 0:
        return kSin(y[0], y[1], 1);
    case 1:
        return kCos(y[0], y[1]);
    case 2:
        return -kSin(y[0], y[1], 1);
    default:
        return -kCos(y[0], y[1]);
    }
}

double mathCos(double x)
{
    double y[2];
    int32_t ix = hiWord(x) & 0x7fffffff;
    if (ix <= 0x3fe921fb)
        return kCos(x, 0.0);
    if (ix >= 0x7ff00000)
        return x - x;
    int n = remPio2(x, y);
    switch (n & 3)
    {
    case 0:
        return kCos(y[0], y[1]);
    case 1:
        return -kSin(y[0], y[1], 1);
    case 2:
        return -kCos(y[0], y[1]);
    default:
        return kSin(y[0], y[1], 1);
    }
}

double mathTan(double x)
{
    double y[2];
    int32_t ix = hiWord(x) & 0x7fffffff;
    if (ix <= 0x3fe921fb)
        return kTan(x, 0.0, 1);
    if (ix >= 0x7ff00000)
        return x - x;
    int n = remPio2(x, y);
    return kTan(y[0], y[1], 1 - ((n & 1) << 1));
}

double mathExp(double x)
{
    const double one = 1.0, halF0 = 0.5, huge = 1.0e+300, oThreshold = 7.09782712893383973096e+02,
                 uThreshold = -7.45133219101941108420e+02, invln2 = 1.44269504088896338700e+00,
                 P1 = 1.66666666666666019037e-01, P2 = -2.77777777770155933842e-03, P3 = 6.61375632143793436117e-05,
                 P4 = -1.65339022054652515390e-06, P5 = 4.13813679705723846039e-08, E = 2.718281828459045,
                 twom1000 = 9.33263618503218878990e-302, two1023 = 8.988465674311579539e307;
    double y, hi = 0.0, lo = 0.0, c, t, twopk;
    int32_t k = 0, xsb;
    uint32_t hx = (uint32_t)hiWord(x);
    xsb = (int32_t)((hx >> 31) & 1);
    hx &= 0x7fffffff;
    if (hx >= 0x40862E42)
    {
        if (hx >= 0x7ff00000)
        {
            uint32_t lx = loWord(x);
            if (((hx & 0xfffff) | lx) != 0)
                return x + x;
            return xsb == 0 ? x : 0.0;
        }
        if (x > oThreshold)
            return huge * huge;
        if (x < uThreshold)
            return 0.0;
    }
    if (hx > 0x3fd62e42)
    {
        if (hx < 0x3FF0A2B2)
        {
            if (x == 1.0)
                return E;
            hi = x - (xsb ? -kLn2Hi : kLn2Hi);
            lo = xsb ? -kLn2Lo : kLn2Lo;
            k = 1 - xsb - xsb;
        }
        else
        {
            k = (int32_t)(invln2 * x + (xsb ? -halF0 : halF0));
            t = k;
            hi = x - t * kLn2Hi;
            lo = t * kLn2Lo;
        }
        x = hi - lo;
    }
    else if (hx < 0x3e300000)
    {
        if (huge + x > one)
            return one + x;
    }
    else
