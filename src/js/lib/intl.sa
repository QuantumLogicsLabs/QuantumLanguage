}

internal.installGlobal('Intl', Intl);

module.exports = {
  Intl,
  dateToLocaleString: localeHelper('all'),
  dateToLocaleDateString: localeHelper('date'),
  dateToLocaleTimeString: localeHelper('time'),
};
