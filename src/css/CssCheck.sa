// quantum: cpp
// CSS front-end: what a validator checks. Property names against the CSS
// properties browsers know, the values of the common properties (keywords,
// colors, lengths, numbers), and selectors (syntax, pseudo-classes and
// pseudo-elements). A typo gets a "Did you mean" from the same lists.
#include "CssInternal.h.sa"

#include <algorithm>
#include <cctype>
#include <map>
#include <set>
#include <sstream>

namespace css
{

namespace
{

std::set<std::string> words(const char *text)
{
    std::set<std::string> out;
    std::istringstream in(text);
    std::string w;
    while (in >> w)
        out.insert(w);
    return out;
}

