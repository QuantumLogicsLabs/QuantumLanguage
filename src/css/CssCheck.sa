// quantum: cpp
// CSS front-end: what a validator checks. Property names, and every value,
// against MDN's CSS data (the grammars of CssGrammar.sa); descriptors and
// at-rule preludes the same way; selectors (syntax, the pseudo-classes and
// pseudo-elements MDN lists, and their arguments). A typo gets a "Did you
// mean" from the same data.
#include "CssInternal.h.sa"

#include <algorithm>
#include <cctype>
#include <fstream>
#include <iostream>
#include <map>
#include <set>
#include <sstream>

namespace css
{

namespace
{

bool prefixed(const std::string &name)
{
    return name.compare(0, 8, "-webkit-") == 0 || name.compare(0, 5, "-moz-") == 0 ||
           name.compare(0, 4, "-ms-") == 0 || name.compare(0, 3, "-o-") == 0;
}

bool globalKeyword(const std::string &v)
{
    return v == "inherit" || v == "initial" || v == "unset" || v == "revert" || v == "revert-layer";
}

// Damerau-Levenshtein (optimal string alignment): a swapped pair costs one
int distance(const std::string &a, const std::string &b)
{
    size_t n = a.size(), m = b.size();
    std::vector<std::vector<int>> d(n + 1, std::vector<int>(m + 1, 0));
    for (size_t x = 0; x <= n; ++x)
        d[x][0] = (int)x;
    for (size_t y = 0; y <= m; ++y)
        d[0][y] = (int)y;
    for (size_t x = 1; x <= n; ++x)
        for (size_t y = 1; y <= m; ++y)
        {
            int cost = a[x - 1] == b[y - 1] ? 0 : 1;
            int v = std::min(std::min(d[x - 1][y] + 1, d[x][y - 1] + 1), d[x - 1][y - 1] + cost);
            if (x > 1 && y > 1 && a[x - 1] == b[y - 2] && a[x - 2] == b[y - 1])
                v = std::min(v, d[x - 2][y - 2] + 1);
            d[x][y] = v;
        }
    return d[n][m];
}

// the text of a value item for a message: "10px", "#ff0", "bleu"
std::string itemText(const Tok &t)
{
    std::ostringstream os;
    switch (t.type)
    {
    case T_IDENT: return t.value;
    case T_HASH: return "#" + t.value;
    case T_STR: return "\"" + t.value + "\"";
    case T_FUNC: return t.value + "()";
    case T_AT: return "@" + t.value;
    case T_NUM:
    case T_PCT:
    case T_DIM:
        if (t.integer)
            os << (long long)t.number;
        else
            os << t.number;
        if (t.type == T_PCT)
            os << "%";
        if (t.type == T_DIM)
            os << t.value;
        return os.str();
    case T_COMMA: return ",";
    case T_COLON: return ":";
    case T_SEMI: return ";";
    case T_LPAREN: return "(";
    case T_RPAREN: return ")";
    case T_LBRACK: return "[";
    case T_RBRACK: return "]";
    case T_LBRACE: return "{";
    case T_RBRACE: return "}";
    default: return t.value;
    }
}

// one keyframe selector: "from", "to", "50%", "entry 10%"
bool keyframeSelector(const std::vector<Tok> &toks, const std::vector<size_t> &part, const Tok &end,
                      std::vector<Problem> &problems)
{
    bool good = false;
    if (!part.empty())
    {
        Mismatch why;
        good = matchGrammar("<keyframe-selector>", toks, part.front(), part.back() + 1, why);
    }
    if (!good)
    {
        const Tok &t = part.empty() ? end : toks[part[0]];
        syntaxAt(problems, t, "\"" + (part.empty() ? std::string("") : itemText(t)) +
                                  "\" is not a valid keyframe selector: use from, to or a percentage.");
    }
    return good;
}

size_t indexOf(const std::vector<Tok> &toks, const Tok *t)
{
    for (size_t k = 0; k < toks.size(); ++k)
        if (&toks[k] == t)
            return k;
    return toks.size();
}

// Whether the value would match with token `k` changed: given a unit
// ("10" -> "10px") or made positive ("-5px" -> "5px")
bool matchesIf(const std::string &grammar, const std::vector<Tok> &toks, size_t from, size_t to, size_t k,
               bool unit, bool positive)
{
    std::vector<Tok> copy = toks;
    if (unit)
    {
        copy[k].type = T_DIM;
        copy[k].value = "px";
    }
    if (positive)
        copy[k].number = -copy[k].number;
    Mismatch why;
    return matchGrammar(grammar, copy, from, to, why);
}

// Checks a value against `grammar`; `what` names it in messages ("color",
// "@font-face's src"). False when it does not match.
bool checkValue(const std::vector<Tok> &toks, const Tok &nameTok, const std::string &what, const std::string &grammar,
                size_t from, size_t to, std::vector<Problem> &problems)
{
    // var(), env() and attr() are known only when the page runs
    for (size_t k = from; k < to; ++k)
        if (toks[k].type == T_FUNC)
        {
            std::string f = lower(toks[k].value);
            if (f == "var" || f == "env" || f == "attr" || f == "if" || f == "inherit")
                return true;
        }
    std::vector<size_t> items;
    for (size_t k = from; k < to;)
    {
        int t = toks[k].type;
        if (t != T_WS)
            items.push_back(k);
        k = (t == T_FUNC || t == T_LPAREN || t == T_LBRACK || t == T_LBRACE) ? blockEnd(toks, k) : k + 1;
    }
    if (items.size() == 1 && toks[items[0]].type == T_IDENT && globalKeyword(lower(toks[items[0]].value)))
        return true;
    for (size_t k : items)
        if (toks[k].type == T_IDENT && globalKeyword(lower(toks[k].value)))
        {
            problemAt(problems, toks[k], "\"" + toks[k].value + "\" must be the only value of \"" + what + "\".");
            return false;
        }
    Mismatch why;
    if (matchGrammar(grammar, toks, from, to, why))
        return true;
    // a browser's own extensions (-webkit-box, -moz-linear-gradient()) are not in the standard grammars
    for (size_t k = from; k < to; ++k)
        if ((toks[k].type == T_IDENT || toks[k].type == T_FUNC) && prefixed(lower(toks[k].value)))
            return true;

    const Tok *t = why.at;
    if (!t)
    {
        problemAt(problems, nameTok, "The value of \"" + what + "\" is incomplete.");
        return false;
    }
    size_t k = indexOf(toks, t);
    if (why.complete)
    {
        problemAt(problems, *t, "Too many values for \"" + what + "\": \"" + itemText(*t) + "\" is not expected.");
        return false;
    }
    if (t->type == T_DIM && unitOf(t->value).empty())
    {
        std::string hint = suggest(lower(t->value), unitNames("length"));
        if (hint.empty())
            hint = suggest(lower(t->value), unitNames(""));
        problemAt(problems, *t, "Unknown unit \"" + t->value + "\" in \"" + itemText(*t) + "\"." + hint);
        return false;
    }
    if (t->type == T_NUM && t->number != 0 && k < toks.size() && matchesIf(grammar, toks, from, to, k, true, false))
    {
        problemAt(problems, *t, "\"" + itemText(*t) + "\" needs a unit, like \"" + itemText(*t) + "px\".");
        return false;
    }
    if ((t->type == T_NUM || t->type == T_DIM || t->type == T_PCT) && t->number < 0 && k < toks.size() &&
        matchesIf(grammar, toks, from, to, k, false, true))
    {
        problemAt(problems, *t, "Negative values are not allowed for \"" + what + "\".");
        return false;
    }
    std::string hint = t->type == T_IDENT ? suggest(lower(t->value), grammarKeywords(grammar)) : "";
    if (grammar == "<color>")
        problemAt(problems, *t, "\"" + itemText(*t) + "\" is not a valid color." + hint);
    else
        problemAt(problems, *t, "\"" + itemText(*t) + "\" is not a valid value for \"" + what + "\"." + hint);
    return false;
}

} // namespace

std::string suggest(const std::string &word, const std::set<std::string> &names)
{
    std::string best;
    int bestD = word.size() < 5 ? 2 : 3;
    for (const std::string &name : names)
    {
        if (name.size() + 3 < word.size() || word.size() + 3 < name.size())
            continue;
        int dd = distance(word, name);
        if (dd < bestD)
        {
            bestD = dd;
            best = name;
        }
    }
    return best.empty() ? "" : " Did you mean \"" + best + "\"?";
}

bool checkDeclaration(const std::vector<Tok> &toks, const Tok &nameTok, const std::string &name, size_t from,
                      size_t to, std::vector<Problem> &problems)
{
    if (name.compare(0, 2, "--") == 0)
        return true;
    const std::string *grammar = propertyGrammar(name);
    if (!grammar)
    {
        if (prefixed(name))
            return true; // a browser's own property
        problemAt(problems, nameTok, "Unknown property \"" + name + "\"." + suggest(name, propertyNames()));
        return false;
    }
    return checkValue(toks, nameTok, name, *grammar, from, to, problems);
}

bool checkDescriptor(const std::vector<Tok> &toks, const Tok &nameTok, const std::string &atRule,
                     const std::string &name, size_t from, size_t to, std::vector<Problem> &problems)
{
    const std::string *grammar = descriptorGrammar(atRule, name);
    if (!grammar)
    {
        if (prefixed(name))
            return true;
        problemAt(problems, nameTok, "Unknown descriptor \"" + name + "\" in \"@" + atRule + "\"." +
                                         suggest(name, descriptorNames(atRule)));
        return false;
    }
    return checkValue(toks, nameTok, name, *grammar, from, to, problems);
}

bool checkPrelude(const std::vector<Tok> &toks, const Tok &at, const std::string &name, const std::string &grammar,
                  size_t from, size_t to, std::vector<Problem> &problems)
{
    for (size_t k = from; k < to; ++k)
        if (toks[k].type == T_FUNC && lower(toks[k].value) == "var")
            return true;
    Mismatch why;
    if (matchGrammar(grammar, toks, from, to, why))
        return true;
    if (!why.at)
        problemAt(problems, at, "Incomplete \"@" + name + "\" rule: something is missing after \"@" + at.value + "\".");
    else
        problemAt(problems, *why.at, "\"" + itemText(*why.at) + "\" is not valid in \"@" + name + "\" here.");
    return false;
}

// a functional pseudo-class's or pseudo-element's arguments
bool checkPseudoArgs(const std::vector<Tok> &toks, size_t fn, const std::string &args, bool element,
                     std::vector<Problem> &problems)
{
    size_t end = blockEnd(toks, fn);
    size_t inner = end;
    if (inner > fn + 1 && toks[inner - 1].type == T_RPAREN)
        --inner;
    const Tok &close = toks[inner < toks.size() ? inner : toks.size() - 1];
    // a selector list (:is(), :not(), :has(), ::slotted() ...): checked as selectors
    bool selectors = args.find("selector") != std::string::npos && args.find("an+b") == std::string::npos;
    if (selectors)
    {
        bool ok = checkSelector(toks, fn + 1, inner, close, problems);
        return ok || args.find("forgiving") != std::string::npos;
    }
    Mismatch why;
    if (matchGrammar(args, toks, fn + 1, inner, why))
        return true;
    std::string name = std::string(element ? "::" : ":") + toks[fn].value + "()";
    const Tok &t = why.at ? *why.at : close;
    problemAt(problems, t, "\"" + itemText(t) + "\" is not a valid argument of \"" + name + "\".");
    return false;
}

bool checkSelector(const std::vector<Tok> &toks, size_t from, size_t to, const Tok &brace,
                   std::vector<Problem> &problems)
{
    bool any = false, empty = true, ok = true;
    for (size_t k = from; k < to;)
    {
        const Tok &t = toks[k];
        switch (t.type)
        {
        case T_WS:
            ++k;
            continue;
        case T_COMMA:
            if (empty)
            {
                syntaxAt(problems, t, "Empty selector in the selector list.");
                return false;
            }
            empty = true;
            ++k;
            continue;
        case T_IDENT:
        case T_HASH:
            break;
        case T_DELIM:
            if (t.value == ".")
            {
                if (k + 1 >= to || toks[k + 1].type != T_IDENT)
                {
                    syntaxAt(problems, t, "Expected a class name after \".\".");
                    return false;
                }
                ++k;
            }
            else if (t.value != "*" && t.value != ">" && t.value != "+" && t.value != "~" && t.value != "&" &&
                     t.value != "|")
            {
                syntaxAt(problems, t, "Invalid selector: unexpected \"" + t.value + "\".");
                return false;
            }
            break;
        case T_LBRACK:
            k = blockEnd(toks, k);
            any = true;
            empty = false;
            continue;
        case T_COLON:
        {
            bool element = k + 1 < to && toks[k + 1].type == T_COLON;
            size_t nk = element ? k + 2 : k + 1;
            if (nk >= to || (toks[nk].type != T_IDENT && toks[nk].type != T_FUNC))
            {
                syntaxAt(problems, t, element ? "Expected a pseudo-element name after \"::\"."
                                              : "Expected a pseudo-class name after \":\".");
                return false;
            }
            const Tok &nt = toks[nk];
            std::string nm = lower(nt.value);
            bool function = nt.type == T_FUNC;
            std::string args;
            // the CSS 2 pseudo-elements also take one colon
            bool legacy = !element && !function &&
                          (nm == "before" || nm == "after" || nm == "first-line" || nm == "first-letter");
            if (!prefixed(nm) && !legacy)
            {
                std::string prefix = element ? "::" : ":";
                if (knownPseudo(element, nm, function, args))
                {
                    if (function && !checkPseudoArgs(toks, nk, args, element, problems))
                        ok = false;
                }
                else if (knownPseudo(element, nm, !function, args))
                {
                    if (function)
                        problemAt(problems, nt, "\"" + prefix + nm + "\" takes no arguments.");
                    else
                        problemAt(problems, nt, "\"" + prefix + nm + "\" needs arguments, like \"" + prefix + nm +
                                                    "(...)\".");
                    ok = false;
                }
                else
                {
                    std::string kind = element ? "pseudo-element" : "pseudo-class";
                    std::string hint = suggest(nm, pseudoNames(element));
                    if (!element && (knownPseudo(true, nm, function, args) || knownPseudo(true, nm, !function, args)))
                        hint = " It is a pseudo-element: write \"::" + nm + "\".";
                    problemAt(problems, nt, "Unknown " + kind + " \"" + prefix + nt.value + "\"." + hint);
                    ok = false;
                }
            }
            k = function ? blockEnd(toks, nk) : nk + 1;
            any = true;
            empty = false;
            continue;
        }
        default:
        {
            std::string text = t.type == T_FUNC ? t.value + "(" : itemText(t);
            syntaxAt(problems, t, "Invalid selector: unexpected \"" + text + "\".");
            return false;
        }
        }
        any = true;
        empty = false;
        ++k;
    }
    if (!any)
    {
        syntaxAt(problems, brace, "Missing selector before \"{\".");
        return false;
    }
    if (empty)
    {
        syntaxAt(problems, brace, "Empty selector in the selector list.");
        return false;
    }
    return ok;
}

bool checkKeyframeSelector(const std::vector<Tok> &toks, size_t from, size_t to, const Tok &brace,
                           std::vector<Problem> &problems)
{
    // the selectors between commas, as token indexes; `ends` is where each stops
    std::vector<std::vector<size_t>> parts(1);
    std::vector<const Tok *> ends;
    for (size_t k = from; k < to; ++k)
    {
        if (toks[k].type == T_WS)
            continue;
        if (toks[k].type == T_COMMA)
        {
            ends.push_back(&toks[k]);
            parts.push_back(std::vector<size_t>());
            continue;
        }
        parts.back().push_back(k);
    }
    ends.push_back(&brace);
    for (size_t p = 0; p < parts.size(); ++p)
        if (!keyframeSelector(toks, parts[p], *ends[p], problems))
            return false;
    return true;
}

int runValueBatch(const std::string &path)
{
    std::ifstream in(path, std::ios::binary);
    if (!in)
    {
        std::cerr << path << ": cannot read the file" << std::endl;
        return 2;
    }
    std::string line;
    while (std::getline(in, line))
    {
        if (!line.empty() && line.back() == '\r')
            line.pop_back();
        size_t tab = line.find('\t');
        if (tab == std::string::npos)
            continue;
        std::string name = lower(line.substr(0, tab));
        std::string value = line.substr(tab + 1);
        std::vector<Problem> problems;
        std::vector<Tok> toks = tokenize(value, problems);
        Tok nameTok;
        nameTok.type = T_IDENT;
        nameTok.value = name;
        bool ok = problems.empty() && checkDeclaration(toks, nameTok, name, 0, toks.size() - 1, problems);
        if (ok)
            std::cout << "ok" << std::endl;
        else
            std::cout << "error\t" << (problems.empty() ? std::string("?") : problems[0].message) << std::endl;
    }
    return 0;
}

} // namespace css
