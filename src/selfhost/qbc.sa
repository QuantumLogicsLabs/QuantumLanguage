// quantum: cpp
// The bootstrap C++ lexer, parser, bytecode compiler and serializer,
// compiled by Quantum's own C/C++ front-end:
//   qrun src/selfhost/qbc.cpp <file> <out.qbc>
// writes the same bytes as `qrun --emit-qbc-core <file> <out.qbc>`.
#include "../include/Error.h.sa"
#include "../include/QbcCore.h.sa"
#include "../Token.sa"
#include "../lexer/LexerCore.sa"
#include "../lexer/LexerReaders.sa"
#include "../lexer/LexerTokenize.sa"
#include "../parser/ParserCore.sa"
#include "../parser/ParserExpressions.sa"
#include "../parser/ParserLiterals.sa"
#include "../parser/ParserStatements.sa"
#include "../compiler/CompilerCore.sa"
#include "../compiler/CompilerExpressions.sa"
#include "../compiler/CompilerFunctions.sa"
#include "../compiler/CompilerStatements.sa"
#include "../Serializer.sa"
#include "../Value.sa"
#include "../cli/QbcCore.sa"

#include <fstream>
#include <iostream>
#include <sstream>
#include <string>

// Value.cpp / Vm.h refer to these VM functions, which compiling never calls.
std::string jsDisplayString(const std::shared_ptr<Dict> &, bool &handled)
{
    handled = false;
    return "";
}
QuantumValue VM::javaCallFunctional(const QuantumValue &, const std::string &, const std::vector<QuantumValue> &)
{
    return QuantumValue();
}

int main(int argc, char **argv)
{
    if (argc < 3)
    {
        std::cerr << "usage: qbc.cpp <file> <out.qbc>\n";
        return 1;
    }
    const std::string path = argv[1];
    std::ifstream in(path);
    if (!in)
    {
        std::cerr << "[Error] Cannot open file: " << path << "\n";
        return 1;
    }
    std::ostringstream ss;
    ss << in.rdbuf();
    try
    {
        const std::string ext = path.size() >= 3 ? path.substr(path.size() - 3) : "";
        std::vector<uint8_t> bytes = coreBytecode(ss.str(), ext == ".py" || ext == ".PY");
        std::ofstream out(argv[2], std::ios::binary);
        out.write(reinterpret_cast<const char *>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
        return out ? 0 : 1;
    }
    catch (const ParseError &e)
    {
        std::cout << "ERROR\tParseError: " << e.what() << " (line " << e.line << ")\n";
        return 1;
    }
    catch (const QuantumError &e)
    {
        std::cout << "ERROR\t" << e.kind << ": " << e.what() << " (line " << e.line << ")\n";
        return 1;
    }
}
