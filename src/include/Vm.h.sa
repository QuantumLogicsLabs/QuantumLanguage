// quantum: cpp
#pragma once
#include "Opcode.h.sa"
#include "Value.h.sa"
#include "Error.h.sa"
#include <vector>
#include <deque>
#include <memory>
#include <unordered_map>
#include <unordered_set>
#include <functional>
#include <string>

// A C++ `throw` from code compiled by the typed C/C++ front-end: carries the
// thrown value to the handler (VM::runFrame pushes it instead of a message).
struct CppThrow : public QuantumError
{
    QuantumValue value;
    explicit CppThrow(QuantumValue v)
        : QuantumError("CppThrow", v.isString() ? v.asString() : std::string("C++ exception")), value(std::move(v)) {}
};

// ─── Upvalue (heap cell for captured variables) ───────────────────────────────
// While the captured variable is still live, the upvalue refers to its stack
// slot by index — never by address: the stack is a std::deque, and inserting
// into its middle (a bound method call slots `self` in under the arguments)
// invalidates every element reference. Once the variable leaves the stack
// the upvalue is closed and owns the value.
struct Upvalue
{
    std::deque<QuantumValue> *stack = nullptr; // non-null while open
    size_t index = 0;                           // stack slot while open
    QuantumValue closed;                        // the value once closed

    Upvalue(std::deque<QuantumValue> *s, size_t i) : stack(s), index(i) {}

    QuantumValue get() const
    {
        if (!stack)
            return closed;
        return index < stack->size() ? (*stack)[index] : QuantumValue();
    }
    void set(QuantumValue v)
    {
        if (!stack)
            closed = std::move(v);
        else if (index < stack->size())
            (*stack)[index] = std::move(v);
    }
    void close()
    {
        if (!stack)
            return;
        if (index < stack->size())
            closed = (*stack)[index];
        stack = nullptr;
    }
};

// ─── Closure ──────────────────────────────────────────────────────────────────
struct Closure
{
    std::shared_ptr<Chunk> chunk;
    std::vector<std::shared_ptr<Upvalue>> upvalues;
    std::string name;

    explicit Closure(std::shared_ptr<Chunk> c)
        : chunk(std::move(c)), name(chunk->name) {}
};

// ─── CallFrame ────────────────────────────────────────────────────────────────
struct CallFrame
{
    std::shared_ptr<Closure> closure;
    size_t ip;        // instruction pointer
    size_t stackBase; // where locals start on the value stack
    int argCount = 0; // arguments the caller actually supplied (incl. self)
    // Per parameter slot, whether the caller supplied it — set when keyword
    // arguments leave gaps (`f(a, c=3)` skips `b`); empty means "the first
    // argCount slots".
    std::vector<bool> passed;
};

// ─── ExceptionHandler ─────────────────────────────────────────────────────────
struct ExceptionHandler
{
    int32_t catchIp;   // IP to jump to on exception
    size_t frameDepth; // call-frame depth to unwind to
    size_t stackDepth; // value stack depth to restore
};

// ─── STL-style iterators (VmStl.cpp) ──────────────────────────────────────────
// `v.begin() + n` into an array is a Dict {"__it_arr": array, "__it_pos": n};
// iterator arithmetic, comparison and `*it` are handled in the VM, and the
// <algorithm> natives (sort, find, max_element, ...) take such ranges.
bool isStlIterator(const QuantumValue &v);
QuantumValue makeStlIterator(std::shared_ptr<Array> arr, long pos);
std::shared_ptr<Array> stlIteratorArray(const QuantumValue &v);
long stlIteratorPos(const QuantumValue &v);
QuantumValue stlIteratorDeref(const QuantumValue &v);

// Keyword arguments reach a keyword-aware native (print, sorted, list.sort,
// min, max) as a trailing dict tagged "__kwargs__" (see Op::CALL). Removes
// and returns it, or nullptr when the call had none.
std::shared_ptr<Dict> takeKwargs(std::vector<QuantumValue> &args);

// ─── JavaScript runtime objects (VmJsRuntime.cpp) ─────────────────────────────
// Date / URL / URLSearchParams are dicts tagged by a hidden key; their methods
// dispatch through callJsObjectMethod (from VM::callDictMethod).
bool isJsDate(const QuantumValue &v);
double jsDateMs(const QuantumValue &v);
QuantumValue makeJsDateModule(std::shared_ptr<double> simulatedMs);
bool callJsObjectMethod(const std::shared_ptr<Dict> &d, const std::string &method,
                        const std::vector<QuantumValue> &args, QuantumValue &out);

// ─── VM ───────────────────────────────────────────────────────────────────────
class VM
{
public:
    VM();

    // Execute a compiled chunk (top-level script).
    void run(std::shared_ptr<Chunk> chunk);

    // Expose globals so the REPL can persist state across calls.
    std::shared_ptr<Environment> globals;

    // Java library natives (VmJavaLib.cpp) calling back into Java code: a
    // functional-interface value (lambda or implementing object), and a
    // virtual method of any Java value by dispatch key ("compareTo(Object)").
    QuantumValue javaCallback(const QuantumValue &fn, const std::string &key, const std::vector<QuantumValue> &args)
    {
        return javaCallFunctional(fn, key, args);
    }
    QuantumValue javaInvokeKey(const QuantumValue &recv, const std::string &key, std::vector<QuantumValue> args);

private:
    // Value stack
    std::deque<QuantumValue> stack_;
    std::vector<CallFrame> frames_;
    std::vector<ExceptionHandler> handlers_;

    // Open upvalues linked list (for closing)
    std::vector<std::shared_ptr<Upvalue>> openUpvalues_;

    // Keyword-argument binding (Op::KW_NAMES → the next CALL).
    std::vector<std::string> pendingKwNames_;
    // Set by bindKeywordArgs: the args on the stack are already laid out one
    // per parameter, so callClosure must not re-collect varargs.
    bool kwArranged_ = false;
    std::vector<bool> kwPassed_;
    // Set by __cpp_runtime__() at the start of a C/C++ program: `/` follows
    // IEEE arithmetic (x / 0.0 → inf) instead of raising, as in C/C++.
    bool cppNumerics_ = false;
    // Set once a global named __op__* (a lowered C++ free operator function)
    // is defined, so operators on instances only look those up when they exist.
    bool freeOperators_ = false;
    // Set once a class binds a C++ static data member (QuantumClass::staticNames).
    bool staticDataMembers_ = false;
    // Reorders the `argCount` values on top of the stack, named by `names`,
    // into `closure`'s parameter order: keywords bind by name, unmatched
    // ones fill a **kwargs dict (or remaining slots), extras a *args array.
    // `hasSelf`: the closure's first parameter is a receiver not yet on the
    // stack. Returns the new argument count.
    int bindKeywordArgs(const std::shared_ptr<Closure> &closure, int argCount,
                        const std::vector<std::string> &names, bool hasSelf);

    long long stepCount_ = 0;
    static constexpr long long MAX_STEPS = 200'000'000;
    // The instruction budget: MAX_STEPS guards the playground against
    // runaway scripts; a compiled language's program (C/C++, Java) runs
    // unbounded, under its runner's wall-clock timeout instead.
    long long maxSteps_ = MAX_STEPS;
    std::vector<std::pair<QuantumValue, size_t>> pendingInstances_;

    // ── Native registration ───────────────────────────────────────────────────
    void registerNatives();
    void registerStlNatives(); // <algorithm>-style free functions (VmStl.cpp)
    void registerCppNatives(); // runtime of the typed C/C++ front-end (VmCpp.cpp)
    void registerCppLibNatives(); // the __q_* natives behind lib/cpp headers (VmCppLib.cpp)
    void registerJsRuntimeNatives(); // URL, window, encodeURIComponent (VmJsRuntime.cpp)
    void registerJavaNatives();      // runtime of the Java front-end (VmJava*.cpp)
    void registerJavaStyleNatives(); // Java-style code in .sa files (VmJavaStyle.cpp)

    // ── Java-style .sa code (VmJavaStyle.cpp) ─────────────────────────────────
    // Set by __java_style__(), which the Java-style library calls first: Java
    // method names on strings / arrays / numbers, functional-interface calls
    // on functions, and Java's string conversion in `+`.
    bool javaStyle_ = false;
    // The kind of the error a catch block last received (RuntimeError, ...)
    std::string lastErrorKind_;
    // The method `m` of a Java-style value; `handled` false when it has none.
    QuantumValue javaStyleMethod(QuantumValue &obj, const std::string &m, std::vector<QuantumValue> &args,
                                 bool &handled);
    // java.lang.Object's getClass / equals / hashCode / toString for an
    // instance whose class has none (nil for another name)
    QuantumValue javaObjectMember(const QuantumValue &obj, const std::string &name);
    // An instance's toString() / __str__(), or the value's own text
    std::string displayString(const QuantumValue &v);
    // String.valueOf: null, [a, b], {k=v}, toString() of an instance
    std::string javaString(const QuantumValue &v);

    // ── Java (VmJava.cpp) ─────────────────────────────────────────────────────
    // Set by __j_runtime() at the start of a Java program: errors raised by
    // the VM reach catch blocks as Java exception descriptors, and recursion
    // past kJavaMaxFrames is a StackOverflowError.
    bool javaMode_ = false;
    static constexpr size_t kJavaMaxFrames = 9000;
    // Op::J_INVOKE: virtual / interface dispatch on the receiver at stack_[recvIdx].
    void javaInvoke(const QuantumValue &desc, size_t recvIdx, int argc, int line, Chunk::InvokeCache *cache = nullptr);
    // A method call on a receiver that is not an object: a String, a boxed
    // number / Character / Boolean, an array, or a lambda.
    QuantumValue javaValueInvoke(const QuantumValue &recv, const std::string &key,
                                 std::vector<QuantumValue> &args, int line);
    // Removes stack_[pos], keeping open upvalues on later slots attached.
    void eraseFromStack(size_t pos);
    // The Java call stack as "Class.method(File.java:line)" frames, innermost first.
    std::vector<std::string> javaStackTrace() const;
    // Calls a functional-interface value (a lambda, or an object implementing
    // the interface's method `key`) from native code.
    QuantumValue javaCallFunctional(const QuantumValue &fn, const std::string &key,
                                    const std::vector<QuantumValue> &args);
    // obj.toString() for any Java value, from native code.
    std::string javaToString(const QuantumValue &v);
    // jop::BOXJ / BOXS / BOXB: the java.lang.Long / Short / Byte box of an
    // integer, from the valueOf cache for -128..127.
    QuantumValue javaBox(int op, const QuantumValue &v);
    std::shared_ptr<QuantumClass> javaBoxClass_[4];
    std::vector<QuantumValue> javaBoxCache_[4];
    // Globals that yield to a same-named member inside a method: common
    // identifiers like `next`/`count`/`find` registered as STL algorithms
    // must not shadow a C++ class's own `next` field or `find()` method under
    // implicit `this`. A user definition of the name removes it from the set.
    std::unordered_set<std::string> weakGlobals_;
    // The VM's own native functions (print, max, log, ...), until a program
    // defines a global of the same name. Inside a method, a field the class
    // declares (`int max = 7;`, `List log;`) wins over one of them.
    std::unordered_set<std::string> builtinNames_;
    // The field `name` of the method's `this`, when its class (or a base)
    // declares it; false outside a method or for an undeclared name.
    bool declaredSelfField(const CallFrame &frame, const std::string &name, QuantumValue &out);
    // Ordering used by sort/max_element/... without a comparator: numbers,
    // strings, arrays (pairs) lexicographically, instances via __lt__.
    bool stlLess(const QuantumValue &a, const QuantumValue &b);
    // Stable sort shared by sorted() and list.sort(): `key` (Python key=)
    // maps each element to its sort key; otherwise `cmp` is a JS/C++/Ruby
    // comparator (a number < 0 or `true` means a sorts first). `reverse`
    // keeps equal elements in order, as Python's does.
    void sortValues(Array &arr, const QuantumValue &key, const QuantumValue &cmp, bool reverse);

    // ── Execution ────────────────────────────────────────────────────────────
    void runFrame(size_t stopDepth = 0);

    // ── Stack helpers ─────────────────────────────────────────────────────────
    void push(QuantumValue v) { stack_.push_back(std::move(v)); }
    QuantumValue pop()
    {
        if (stack_.empty())
            throw RuntimeError("VM stack underflow");
        QuantumValue v = std::move(stack_.back());
        stack_.pop_back();
        return v;
    }
    QuantumValue &peek(int offset = 0) { return stack_[stack_.size() - 1 - offset]; }

    // ── Call helpers ──────────────────────────────────────────────────────────
    void callValue(QuantumValue callee, int argCount, int line);
    void callClosure(std::shared_ptr<Closure> closure, int argCount, int line);
    void callNativeFn(std::shared_ptr<QuantumNative> fn, int argCount, int line);
    void callClass(std::shared_ptr<QuantumClass> klass, int argCount, int line);
    // Gives a new instance its own C++ member objects (QuantumClass::fieldInits,
    // base classes first) before the constructor runs.
    void initInstanceFields(const QuantumValue &instVal);
    // Static member `name` of a class or its bases: a static method (bound with
    // the class as `self`) or a class-level value. False when there is none.
    bool findStaticMember(const QuantumValue &classVal, const std::string &name, QuantumValue &out);
    // `Cls::member` with no global of that literal name (enum constants are
    // globals): the class's static member, or — inside a method of that class
    // (or a subclass) — its instance method bound to `self`.
    bool findScopedMember(const std::string &name, const QuantumValue &self, QuantumValue &out);
    // `cout << obj` for a class with a C++ `operator<<` (lowered to the
    // global __op__lshift__<Class>): the text that operator writes.
    bool userStreamText(const QuantumValue &v, std::string &out);
    // C++ member resolution for the run loop's LOAD_GLOBAL / STORE_GLOBAL /
    // GET_MEMBER / BIND_METHOD / GET_SUPER, kept out of VM::run so its hot
    // paths (and the cost of the NameError an implicit field read throws
    // through it) stay as they were. The push* helpers push what they find.
    const QuantumValue *frameSelf(const CallFrame &frame) const; // slot 0 of a method, or null
    bool implicitStaticMember(const CallFrame &frame, const std::string &name, QuantumValue &out);
    bool pushImplicitStaticMember(const CallFrame &frame, const std::string &name);
    bool pushCppMember(const std::string &name, const CallFrame &frame);
    bool pushStaticMember(const std::shared_ptr<QuantumClass> &klass, const std::string &name);
    bool storeCppStaticMember(const std::string &name, const CallFrame &frame, const QuantumValue &value);
    bool bindCppMember(QuantumValue &classVal, const std::string &name, const QuantumValue &fn);
    void getSuper(const std::string &operand, int line);
    bool callFreeOperator(Op op, const QuantumValue &L, const QuantumValue &R, QuantumValue &out);
    // Calls any callable (closure, bound method, native) to completion from
    // native code — e.g. a JS replace() callback — and returns its result.
    QuantumValue invokeCallable(const QuantumValue &fn, const std::vector<QuantumValue> &args);
    // Calls instance method `name` (e.g. __getitem__) if the instance's
    // class defines it; returns false otherwise.
    bool invokeMagic(const QuantumValue &inst, const char *name,
                     const std::vector<QuantumValue> &args, QuantumValue &out);
    QuantumValue callBuiltinMethod(QuantumValue &obj,
                                   const std::string &method,
                                   std::vector<QuantumValue> args,
                                   int line);
    QuantumValue callArrayMethod(std::shared_ptr<Array> arr,
                                 const std::string &method,
                                 std::vector<QuantumValue> args);
    QuantumValue callStringMethod(const std::string &s,
                                  const std::string &method,
                                  std::vector<QuantumValue> args);
    QuantumValue callDictMethod(std::shared_ptr<Dict> d,
                                const std::string &method,
                                std::vector<QuantumValue> args);

    // ── Upvalue helpers ───────────────────────────────────────────────────────
    std::shared_ptr<Upvalue> captureUpvalue(size_t stackIdx);
    void closeUpvalues(size_t fromIdx);
    // Inserts below the top of the stack, keeping open upvalues on the
    // shifted slots attached to their variables.
    void insertOnStack(size_t pos, QuantumValue v);

    // ── Binary / unary ops ────────────────────────────────────────────────────
    QuantumValue execBinary(Op op, const QuantumValue &left, const QuantumValue &right, int line);
    QuantumValue execUnary(Op op, const QuantumValue &val, int line);

    // Iterator state is stored inside each iterator native's fn closure

    // ── Misc helpers ──────────────────────────────────────────────────────────
    static std::string valueEq(const QuantumValue &a, const QuantumValue &b);
    static bool valuesEqual(const QuantumValue &a, const QuantumValue &b);
    double toNumber(const QuantumValue &v, const std::string &ctx, int line);
    void runtimeError(const std::string &msg, int line);
};