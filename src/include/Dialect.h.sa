// quantum: cpp
#pragma once
// Dialect layer — the source-to-source front-end that lets Quantum accept
// several languages' syntax before the ordinary lexer/parser/compiler run.
//
//   .rb/.py/.js/.c/.cpp → strict single-dialect: the whole file is that
//                         language, so its rewrites apply unconditionally.
//   .sa                 → multi-dialect: Ruby, Python, JavaScript, C, C++ and
//                         Java syntax may be mixed in one file, so every Ruby-only
//                         rewrite is gated behind an ambiguity check and only
//                         fires on lines that are not already valid in one of
//                         the other styles.
//
// Set the QUANTUM_DEBUG_RUBY environment variable to dump the translated
// source to stderr before it is compiled — the primary debugging tool for
// this layer. QUANTUM_DEBUG_CPP dumps the output of the C++ structure pass
// (spliced includes, lowered namespaces, merged member definitions).

#include <filesystem>
#include <string>
#include <utility>
#include <vector>

// ─── Router ───────────────────────────────────────────────────────────────
// Applies whichever dialect passes the file extension calls for, returning
// source the normal Quantum pipeline can compile.
std::string applyDialect(std::string source, const std::string &path);

// Lower-cased file extension including the leading dot (".rb", ".sa", ...).
std::string fileExtLower(const std::string &path);

// True for a file type this compiler runs natively: .sa .js .py .rb .c .cpp
bool hasSupportedExt(const std::string &path);

// A .sa file written in Quantum's C++ syntax: its first line is the marker
// `// quantum: cpp`. It goes to the typed C++ front-end, like a .cpp file.
bool isMarkedCppSource(const std::string &source);

// ─── Ruby dialect ─────────────────────────────────────────────────────────
// `strict` = true for real `.rb` files (convert unconditionally);
// false for `.sa`, where a construct only converts when it cannot be valid
// syntax in one of the other dialects sharing the file.
std::string applyRubyDialect(const std::string &source, bool strict);

// The synthesized Ruby `Enumerable` mixin, as Ruby source lines. Spliced in
// wherever a class does `include Enumerable`; every method is defined purely
// in terms of the including class's own `each`.
const std::vector<std::string> &rubyEnumerableModuleSource();

// ─── Java dialect ─────────────────────────────────────────────────────────
// Java-style code in a .sa file (src/dialect/JavaDialect.sa): rewritten into
// the common syntax, with the file's line numbers kept. A file showing no
// Java (System.out.print..., import java..., access modifiers on members,
// implements, @Override, String[]) comes back unchanged. A rewritten file
// ends with the marker line `// quantum: java-style`, which makes
// compileSource() load the Java-style library (src/dialect/javastyle/).
std::string applyJavaDialect(const std::string &source);
bool isJavaStyleSource(const std::string &source);
namespace javastyle
{
// The library's source files (src/generated/JavaStyleData.sa)
const std::vector<std::pair<std::string, std::string>> &librarySources();
} // namespace javastyle

// ─── C/C++ dialect ────────────────────────────────────────────────────────
// True if the source defines a function named main ("main" followed by "(",
// not part of a longer identifier).
bool definesMainFunction(const std::string &src);

// True if the source defines a C-style `int main(` (or void/auto) and never
// calls main() itself.
bool definesCStyleMain(const std::string &src);

// C++ project structure (src/dialect/CppDialect.cpp): splices in local
// `#include "x.h"` headers plus their x.sa/x.cpp implementation files, lowers
// namespaces, and moves out-of-class member definitions (`T Cls::f() {}`)
// into their class. `path` locates the included files; `*multiFile` is set
// when at least one local file was spliced in.
std::string applyCppDialect(const std::string &source, const std::string &path,
                            bool *multiFile = nullptr);

// Include lookup shared by the typed C/C++ front-end: `#include "name"` from
// `from` (next to it, then include/ folders up to the project root), and the
// implementation file of a header (x.h -> x.cpp, include/l/x.hpp -> src/x.cpp),
// or an empty path.
std::filesystem::path cppResolveInclude(const std::string &name, const std::filesystem::path &from);
std::filesystem::path cppImplementationOf(const std::filesystem::path &header);
