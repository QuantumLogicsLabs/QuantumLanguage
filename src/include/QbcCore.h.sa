// quantum: cpp
#pragma once
// The bytecode of one source text through lexer, parser and compiler only
// (no dialect pass, no module resolution): `qrun --emit-qbc-core`, and the
// self-hosting driver src/selfhost/qbc.cpp that runs this same code
// under Quantum's own C/C++ front-end.
#include <cstdint>
#include <string>
#include <vector>

std::vector<uint8_t> coreBytecode(const std::string &source, bool pythonSource);
