// quantum: cpp
#pragma once
// The shared compile path: source text -> Chunk, running the full
// lexer -> parser -> type-checker (warnings only) -> bytecode compiler.
// Callers are expected to have already run the source through applyDialect().

#include "Opcode.h.sa"
#include <memory>
#include <string>
#include <vector>

std::shared_ptr<Chunk> compileSource(const std::string &source,
                                     const std::string &sourcePath = "<input>",
                                     bool debug = false);

// Set while the batch test runner is active: makes input() return canned
// values instead of blocking on stdin. Read by src/vm/VmNatives.cpp.
extern bool g_testMode;

// --strict. A .c/.cpp/.py/.js/.rb/.java file needs no flag: it is always
// strict (strictSource, Dialect.h.sa) — it must be valid in its language, a
// program that language's front-end rejects is a compile error (reported the
// way gcc / python / node / ruby / javac report it), and Python and Ruby
// runtime errors are reported the real interpreter's way. A .sa file, where
// the syntaxes mix, is never strict. What the flag still adds: a web page's
// or stylesheet's errors become compile errors (otherwise they are reported
// and the page is shown anyway), and a .sa file written in C++ syntax
// (`// quantum: cpp`) may not name a type C++ does not know.
extern bool g_strictMode;

// --print: a web page (.html, or a .sa file holding one) is printed, as the
// compiled document, instead of being opened in the default browser.
extern bool g_printPages;

// The running script's path followed by its command-line arguments
// (`qrun tool.sa --json` -> {"tool.sa", "--json"}). Set by main() before the
// VM is constructed; exposed to scripts as sys.argv by src/vm/VmNatives.cpp.
extern std::vector<std::string> g_scriptArgv;
